/target
# Generated by `wip-bench`; up to tens of megabytes.
/tests/bench/
*.snap.new
*.pending-snap
# What `wip build main.wip` writes when run at the root, named after the file,
# and on a Mac the debug information beside it.
/main
*.dSYM/
# What `wip doc` writes when run at the root.
/doc/
# Built by editors/nvim/build.sh.
/editors/nvim/parser/
# What Zed, or cargo, builds of the Zed extension.
/editors/zed/target/
/editors/zed/*.wasm
