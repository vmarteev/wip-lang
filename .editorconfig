# How files in this repository are written, for editors that read
# EditorConfig (https://editorconfig.org).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Wip is laid out by `wip fmt`: tabs, counted as four columns, and lines of
# at most 120.
[*.wip]
indent_style = tab
indent_size = tab
tab_width = 4
max_line_length = 120

# The language's test cases are not formatted: their layout is what they
# test.
[tests/**.wip]
indent_style = space
indent_size = 4

# Some cases, and the files they read, end without a line break on
# purpose: `ok/25_comments_and_empty` is a file that stops mid-line.
[tests/cases/**]
insert_final_newline = unset

# rustfmt's defaults: there is no rustfmt.toml.
[*.rs]
max_line_length = 100

[*.md]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

# Snapshots are compared byte for byte, and a diagnostic's frame ends some
# lines in spaces.
[*.snap]
trim_trailing_whitespace = false
insert_final_newline = unset
