// Variadic calls that pass more than they declare, of every scalar type C
// promotes and some it does not, after named arguments of each kind and
// after enough of them that the registers are gone.

/// One extra argument: its Wip expression, and what C reads it back as once
/// promoted — a letter for `va_arg`'s type and the value, as the C below
/// parses them.
fn extra(kind: i64, k: i64, n: i64): (String, String) = {
	val v = (k * 11 + n * 7) % 90 - 30
	val small = if v < 0 then v + 100 else v
	val f = quarters((k * 3 + n * 5) % 40 - 8)
	return match kind {
		0 => ("(\(v) as i8)", "i\(v)")
		1 => ("(\(small) as u8)", "i\(small)")
		2 => ("(\(v * 100) as i16)", "i\(v * 100)")
		3 => ("(\(small) as u16)", "i\(small)")
		4 => ("(\(v * 1000) as i32)", "i\(v * 1000)")
		5 => ("(\(small * 1000) as u32)", "u\(small * 1000)")
		6 => ("(\(v * 100000000) as i64)", "l\(v * 100000000)")
		7 => ("(\(small * 1000000000) as u64)", "L\(small * 1000000000)")
		8 => {
			val b = (k + n) % 2 == 0
			("\(b)", if b then "i1" else "i0")
		}
		9 => ("(\(f) as f32)", "d\(f)")
		10 => (f.clone(), "d\(f)")
		_ => ("\"s\(k)x\(n)\"", "ss\(k)x\(n)")
	}
}

/// The program: 250 calls, 25 to a function.
fn variadicProgram(): String = {
	var wip = String::of(
		"import std::io\n\nextern \"C\" {\n    fn v0(spec: cstring, ...): i32\n    fn v1(a: i64, spec: cstring, ...): i32\n    fn v2(a: f64, spec: cstring, ...): i32\n    fn v3(a: i8, b: f32, spec: cstring, ...): i32\n    fn vmany(i0: i64, i1: i64, i2: i64, i3: i64, i4: i64, i5: i64, i6: i64, i7: i64, d0: f64, d1: f64, d2: f64, d3: f64, d4: f64, d5: f64, d6: f64, d7: f64, spec: cstring, ...): i32\n}\n\n",
	)
	var seeded = Seeded::of(0x0da7a5e7)
	val calls = 250
	val perFn = 25
	for chunk in 0..calls / perFn {
		wip.push("fn calls\(chunk)(): i64 = {\n    var failed = 0\n")
		for k in chunk * perFn..(chunk + 1) * perFn {
			val count = seeded.next(13)
			var exprs: Vec<String> = Vec()
			var spec = String()
			for n in 0..count {
				val (expr, read) = extra(seeded.next(12), k, n)
				exprs.push(move expr)
				spec.push(read)
				spec.push(";")
			}
			val named = NAMED[k % 5]
			val callee = CALLEES[k % 5]
			val extras = if exprs.isEmpty() then String() else ", \(exprs.join(", "))"
			wip.push("    if \(callee)(\(named)\"\(spec)\"\(extras)) != 1 { io::println(\"call \(k): \(callee)(\(spec))\"); failed += 1 }\n")
		}
		wip.push("    failed\n}\n\n")
	}
	wip.push("fn main(): i64 = {\n    var failed = 0\n")
	for chunk in 0..calls / perFn {
		wip.push("    failed += calls\(chunk)()\n")
	}
	wip.push("    io::println(\"\\(failed) failed\")\n    failed\n}\n")
	return move wip
}

/// The named arguments before the specification, for each callee.
val NAMED = [
	"",
	"11, ",
	"1.5, ",
	"(-3 as i8), (0.25 as f32), ",
	"1, 2, 3, 4, 5, 6, 7, 8, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, ",
]

val CALLEES = ["v0", "v1", "v2", "v3", "vmany"]

/// The C that checks a call: it reads the extra arguments as the
/// specification says and compares each with what it should be, so that a
/// wrong register or a wrong promotion is a wrong answer.
val VARIADIC_C = """
	#include <stdarg.h>
	#include <stdint.h>
	#include <stdlib.h>
	#include <string.h>

	static int check(const char *spec, va_list ap) {
	    const char *p = spec;
	    while (*p) {
	        char type = *p++;
	        const char *end = strchr(p, ';');
	        char text[64];
	        size_t n = (size_t)(end - p);
	        memcpy(text, p, n);
	        text[n] = 0;
	        switch (type) {
	            case 'i': if (va_arg(ap, int) != (int)strtoll(text, 0, 10)) return 0; break;
	            case 'u': if (va_arg(ap, unsigned) != (unsigned)strtoull(text, 0, 10)) return 0; break;
	            case 'l': if (va_arg(ap, long long) != strtoll(text, 0, 10)) return 0; break;
	            case 'L': if (va_arg(ap, unsigned long long) != strtoull(text, 0, 10)) return 0; break;
	            case 'd': if (va_arg(ap, double) != strtod(text, 0)) return 0; break;
	            case 's': if (strcmp(va_arg(ap, const char *), text) != 0) return 0; break;
	            default: return 0;
	        }
	        p = end + 1;
	    }
	    return 1;
	}

	int32_t v0(const char *spec, ...) {
	    va_list ap; va_start(ap, spec); int r = check(spec, ap); va_end(ap);
	    return r;
	}

	int32_t v1(int64_t a, const char *spec, ...) {
	    va_list ap; va_start(ap, spec); int r = check(spec, ap); va_end(ap);
	    return r && a == 11;
	}

	int32_t v2(double a, const char *spec, ...) {
	    va_list ap; va_start(ap, spec); int r = check(spec, ap); va_end(ap);
	    return r && a == 1.5;
	}

	int32_t v3(int8_t a, float b, const char *spec, ...) {
	    va_list ap; va_start(ap, spec); int r = check(spec, ap); va_end(ap);
	    return r && a == -3 && b == 0.25f;
	}

	int32_t vmany(int64_t i0, int64_t i1, int64_t i2, int64_t i3, int64_t i4, int64_t i5,
	              int64_t i6, int64_t i7, double d0, double d1, double d2, double d3, double d4,
	              double d5, double d6, double d7, const char *spec, ...) {
	    va_list ap; va_start(ap, spec); int r = check(spec, ap); va_end(ap);
	    return r && i0 == 1 && i1 == 2 && i2 == 3 && i3 == 4 && i4 == 5 && i5 == 6 && i6 == 7
	        && i7 == 8 && d0 == 1.5 && d1 == 2.5 && d2 == 3.5 && d3 == 4.5 && d4 == 5.5
	        && d5 == 6.5 && d6 == 7.5 && d7 == 8.5;
	}
	"""
