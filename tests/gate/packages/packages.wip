// Packages that depend on each other: a monorepo of a library and two
// programs, and each way a `package.wip` or an import across packages can
// be wrong; and how a package says it is laid out.

import std::fs
import std::path
import check::{Checked, Gate, across, isFile, read, write, wrong}

/// What is checked, each by what it shows.
val ITEMS = [
	"programs build the packages they depend on",
	"a package is built as itself",
	"a package tests itself",
	"every module of a package is checked and tested",
	"another package's internal module is refused",
	"a package reached but not depended on is refused",
	"a dependency is named as it names itself",
	"what a package.wip may say",
	"a package.wip holds only the package",
	"packages that depend on each other are refused",
	"a module named like a dependency is refused",
	"a name or version that was never given",
	"a package says how it is formatted",
	"standard input is formatted as its package says",
	"a file that says so is left as written",
	"a format it does not know is refused",
]

pub fn check(gate: &Gate): Checked = {
	var items: Vec<i64> = Vec()
	for index in 0..ITEMS.len() {
		if gate.takes(ITEMS[index]) then items.push(index)
	}
	val failed = across(
		items.len(),
		(at) => {
			val index = items[at]
			val dir = gate.work.join("packages-\(index)")
			fs::makeDirs(dir)
			return match one(&gate, index, dir) {
				.Some(why) => .Some("\(ITEMS[index]): \(why)")
				.None => .None
			}
		},
	)
	return Checked::of(items.len(), move failed)
}

fn one(gate: &Gate, index: i64, root: str): Option<String> = match index {
	0 => buildsWhatItDependsOn(gate, root)
	1 => builtAsItself(gate, root)
	2 => testsItself(gate, root)
	3 => everyModule(gate, root)
	4 => refusedFor(gate, root, "@depends(\"engine\", path = \"../engine\")\npackage bad\n", "import engine::internal::pool\n\nfn main() = {}\n", [
		"[E0215]",
		"is internal to package `engine`",
	])
	5 => refusedFor(gate, root, "@depends(\"game\", path = \"../game\")\npackage bad\n", "import engine::render\n\nfn main() = {}\n", [
		"this package does not depend on `engine`",
	])
	6 => refusedFor(gate, root, "@depends(\"eng\", path = \"../engine\")\npackage bad\n", "fn main() = {}\n", [
		"is package `engine`, not `eng`",
		"it says this",
	])
	7 => refusedFor(gate, root, "@version(\"1.4\")\n@license(\"MIT\")\n@depends(\"net\", git = \"https://example.com/net\", rev = \"v1.0.0\")\n@depends(\"nothing\", path = \"../nowhere\")\npackage bad\n", "fn main() = {}\n", [
		"`1.4` is not a semantic version",
		"`@license` is not something a package says",
		"which is not built yet",
		"has no `package.wip`",
	])
	8 => refusedFor(gate, root, "package bad\nfn main() = {}\n", "fn main() = {}\n", [
		"holds nothing after its `package`",
	])
	9 => dependOnEachOther(gate, root)
	10 => moduleLikeADependency(gate, root)
	11 => neverGiven(gate, root)
	12 => formatted(gate, root)
	13 => standardInput(gate, root)
	14 => leftAsWritten(gate, root)
	15 => refusedFor(gate, root, "@format(indent = \"both\")\npackage bad\n", "fn main() = {}\n", [
		"neither `\"tabs\"` nor `\"spaces\"`",
	])
	_ => .Some("there is no such item")
}

/// `engine`, a library with a public module and an internal one; `game`, a
/// program that depends on it; and `editor`, a program that depends on
/// both.
fn monorepo(root: str) = {
	write(root, "engine/package.wip", "@version(\"0.3.0\")\npackage engine\n")
	write(root, "engine/engine.wip", "import render\n\npub fn frames(): i64 = render::frame(3)\n")
	write(
		root,
		"engine/render/render.wip",
		"import internal::pool\n\npub fn frame(n: i64): i64 = n * pool::size()\n\npub fn engineVersion(): str = package::VERSION\n",
	)
	write(
		root,
		"engine/render/render.test.wip",
		"@test\nfn framesScale() = assert(frame(2) == 20)\n",
	)
	write(root, "engine/internal/pool/pool.wip", "pub fn size(): i64 = 10\n")
	write(
		root,
		"game/package.wip",
		"@version(\"1.4.0\")\n@depends(\"engine\", path = \"../engine\")\npackage game\n",
	)
	write(
		root,
		"game/main.wip",
		"import std::io\nimport engine\nimport engine::render\nimport board\n\nfn main() = {\n    io::println(\"\\(package::NAME) \\(package::VERSION)\")\n    io::println(render::engineVersion())\n    io::printInt(engine::frames() + board::cells())\n}\n",
	)
	write(root, "game/board/board.wip", "pub fn cells(): i64 = 81\n")
	write(
		root,
		"game/main.test.wip",
		"import std::fs\nimport board\n\n@test\nfn boardHasCells() = assert(board::cells() == 81)\n\n@test\nfn levelsAreBesideIt() = assert(fs::exists(\"levels/first.txt\"))\n",
	)
	write(root, "game/levels/first.txt", "#########\n")
	write(
		root,
		"editor/package.wip",
		"@version(\"0.1.0\")\n@depends(\"engine\", path = \"../engine\")\n@depends(\"game\", path = \"../game\")\npackage editor\n",
	)
	write(
		root,
		"editor/main.wip",
		"import std::io\nimport game::board\nimport engine::render\n\nfn main() = {\n    io::println(\"\\(package::NAME) \\(package::VERSION)\")\n    io::printInt(board::cells() + render::frame(1))\n}\n",
	)
}

/// Each program builds its dependencies from source, and `package::` in a
/// module means that module's package: `engine`'s version from `engine`'s
/// code, called by `game`; and `editor` reaches `engine` directly and
/// through `game`, and has one `engine`.
fn buildsWhatItDependsOn(gate: &Gate, root: str): Option<String> = {
	monorepo(root)
	val game = gate.wip(root, ["run", "game"])
	if game.stdout != "game 1.4.0\n0.3.0\n111\n" then return wrong("`wip run game`", &game)
	val editor = gate.wip(root, ["run", "editor"])
	if editor.stdout != "editor 0.1.0\n91\n" then return wrong("`wip run editor`", &editor)
	return .None
}

/// A package is built by its directory or its `package.wip`, and the
/// program is named as the package names itself, in the package's root:
/// from above, where a directory of that name is the package itself, the
/// program is written into it.
fn builtAsItself(gate: &Gate, root: str): Option<String> = {
	monorepo(root)
	val game = path::join(root, "game")
	val built = gate.wip(game, ["build", "package.wip"])
	if !built.exit.success() || !isFile(root, "game/game") then
		return wrong("`wip build package.wip`", &built)
	val above = gate.wip(root, ["build", "editor"])
	if !above.exit.success() || !isFile(root, "editor/editor") then
		return wrong("`wip build editor`", &above)
	val named = gate.wip(root, ["build", "editor", "-o", "editor-bin"])
	if !named.exit.success() || !isFile(root, "editor-bin") then
		return wrong("`wip build editor -o editor-bin`", &named)
	return .None
}

/// `wip test game` runs `game`'s tests, in its root, so that the path a
/// test names is the package's wherever the command was typed; `engine`'s
/// are run by testing it, library as it is; and a filter is matched against
/// the name as it is printed, module and all.
fn testsItself(gate: &Gate, root: str): Option<String> = {
	monorepo(root)
	val game = gate.wip(root, ["test", "game"])
	if !game.stdout.contains("boardHasCells") ||
		!game.stdout.contains("levelsAreBesideIt ... ok") ||
		game.stdout.contains("framesScale") {
		return wrong("`wip test game`", &game)
	}
	val engine = gate.wip(root, ["test", "engine"])
	if !engine.stdout.contains("render::framesScale ... ok") then
		return wrong("`wip test engine`", &engine)
	val byModule = gate.wip(root, ["test", "engine", "render::"])
	if !byModule.stdout.contains("running 1 test") then
		return wrong("`wip test engine render::`", &byModule)
	return .None
}

/// A module of the package that nothing imports yet is still checked, and
/// its tests run; a hidden directory, `target`, and a package inside the
/// package are not modules of it; and an error in a module nobody imports
/// is found by `check`, and is nothing to `build`, which compiles what the
/// program reaches.
fn everyModule(gate: &Gate, root: str): Option<String> = {
	write(root, "package.wip", "package tool\n")
	write(root, "main.wip", "import used\n\nfn main() = used::hello()\n")
	write(root, "used/used.wip", "pub fn hello() = {}\n")
	write(root, "lonely/lonely.wip", "fn half(n: i64): i64 = n / 2\n")
	write(root, "lonely/lonely.test.wip", "@test\nfn halves() = assert(half(8) == 4)\n")
	write(root, "lonely/deeper/deeper.wip", "fn one(): i64 = 1\n")
	for skipped in [".hidden/h.wip", "target/t.wip", "inner/package.wip", "inner/i.wip"] {
		write(root, skipped, "fn wrong(): i64 = \"not a number\"\n")
	}
	val tested = gate.wip(root, ["test", "."])
	if !tested.stdout.contains("lonely::halves ... ok") then return wrong("`wip test .`", &tested)
	val checked = gate.wip(root, ["check", "."])
	if !checked.exit.success() then return wrong("`wip check .`", &checked)
	write(root, "lonely/lonely.wip", "fn half(n: i64): i64 = \"half\"\n")
	val refused = gate.wip(root, ["check", "."])
	if refused.exit.success() || !refused.stderr.contains("lonely.wip") then
		return wrong("`wip check .`, with an error in `lonely`", &refused)
	val built = gate.wip(root, ["build", "main.wip", "-o", "tool"])
	if !built.exit.success() then return wrong("`wip build main.wip`", &built)
	return .None
}

/// One wrong package: the monorepo, and a program beside it that says
/// `package` and `main`, checked; it is refused, saying each of `says`.
fn refusedFor(gate: &Gate, root: str, package: str, main: str, says: &[str]): Option<String> = {
	monorepo(root)
	write(root, "bad/package.wip", package)
	write(root, "bad/main.wip", main)
	val checked = gate.wip(root, ["check", "--color", "never", "bad/main.wip"])
	if checked.exit.success() then return wrong("it was accepted", &checked)
	for text in says {
		if !checked.stderr.contains(text) then return wrong("it does not say \"\(text)\"", &checked)
	}
	return .None
}

fn dependOnEachOther(gate: &Gate, root: str): Option<String> = {
	monorepo(root)
	write(root, "c1/package.wip", "@depends(\"c2\", path = \"../c2\")\npackage c1\n")
	write(root, "c1/main.wip", "fn main() = {}\n")
	write(root, "c2/package.wip", "@depends(\"c1\", path = \"../c1\")\npackage c2\n")
	write(root, "c2/c2.wip", "pub fn x(): i64 = 1\n")
	val checked = gate.wip(root, ["check", "c1/main.wip"])
	if !checked.stderr.contains("depend on each other") then
		return wrong("`wip check c1/main.wip`", &checked)
	return .None
}

fn moduleLikeADependency(gate: &Gate, root: str): Option<String> = {
	monorepo(root)
	write(root, "bad/package.wip", "@depends(\"engine\", path = \"../engine\")\npackage bad\n")
	write(root, "bad/main.wip", "import engine::render\n\nfn main() = {}\n")
	write(root, "bad/engine/mine.wip", "pub fn x(): i64 = 1\n")
	val checked = gate.wip(root, ["check", "bad/main.wip"])
	if !checked.stderr.contains("is both a package this one depends on and a module of its own") {
		return wrong("`wip check bad/main.wip`", &checked)
	}
	return .None
}

/// `package::VERSION` without an `@version`, and `package::NAME` without a
/// `package.wip`: each says what to write, and where. A directory is built
/// as a package only if it is one.
fn neverGiven(gate: &Gate, root: str): Option<String> = {
	if refusedFor(gate, root, "package bad\n", "import std::io\n\nfn main() = io::println(package::VERSION)\n", [
		"this package says no version",
	]) is .Some(why) {
		return .Some(why.clone())
	}
	val alone = path::join(root, "alone")
	write(alone, "main.wip", "import std::io\n\nfn main() = io::println(package::NAME)\n")
	val checked = gate.wip(alone, ["check", "main.wip"])
	if !checked.stderr.contains("this program is not a package") then
		return wrong("`wip check main.wip`", &checked)
	val built = gate.wip(root, ["build", alone.toStr()])
	if !built.stderr.contains("with no `package.wip`") then
		return wrong("`wip build` of a directory", &built)
	return .None
}

/// `wip fmt` lays a package out as its `@format` says, the command line
/// overrides it, and `--check` writes nothing and says which files would
/// change.
fn formatted(gate: &Gate, root: str): Option<String> = {
	write(
		root,
		"package.wip",
		"@format(width = 100, indent = \"spaces\", size = 2)\npackage laid\n",
	)
	val messy = "fn main() = {\nval x = 1\n}\n"
	write(root, "main.wip", messy)
	val check = gate.wip(root, ["fmt", "--check", "."])
	if check.exit != .Code(1) ||
		!check.stdout.contains("main.wip") ||
		read(root, "main.wip") != messy {
		return wrong("`wip fmt --check .`", &check)
	}
	val laid = gate.wip(root, ["fmt", "."])
	if !laid.exit.success() || read(root, "main.wip") != "fn main() = {\n  val x = 1\n}\n" then
		return wrong("`wip fmt .`", &laid)
	val again = gate.wip(root, ["fmt", "--check", "."])
	if !again.exit.success() then return wrong("`wip fmt --check .`, laid out", &again)
	val tabs = gate.wip(root, ["fmt", "--tabs", "main.wip"])
	if !tabs.exit.success() || read(root, "main.wip") != "fn main() = {\n\tval x = 1\n}\n" then
		return wrong("`wip fmt --tabs main.wip`", &tabs)
	return .None
}

/// `wip fmt -` lays out standard input, as the package of the file
/// `--stdin-path` names says, and writes nothing when it does not parse, so
/// that an editor keeps its buffer.
fn standardInput(gate: &Gate, root: str): Option<String> = {
	write(root, "package.wip", "@format(indent = \"spaces\", size = 2)\npackage laid\n")
	val laid = gate.wipReading("fn main() = {\nval x = 1\n}\n", root, [
		"fmt",
		"-",
		"--stdin-path",
		"main.wip",
	])
	if !laid.exit.success() || laid.stdout != "fn main() = {\n  val x = 1\n}\n" then
		return wrong("`wip fmt -`", &laid)
	val broken = gate.wipReading("fn main( = {\n", root, ["fmt", "-", "--stdin-path", "main.wip"])
	if broken.exit != .Code(1) || !broken.stdout.isEmpty() || !broken.stderr.contains("main.wip") {
		return wrong("`wip fmt -`, of what does not parse", &broken)
	}
	return .None
}

/// A file whose leading comments say `// wip fmt: off` is left as written:
/// a directory formatted or checked around it changes and lists nothing of
/// it and says how many it left, a file named says so too, and standard
/// input comes back as it went in, even where it does not parse.
fn leftAsWritten(gate: &Gate, root: str): Option<String> = {
	val kept = "// Written by a tool.\n// wip fmt: off\n\nfn  kept( ) : i64 = 1\n"
	val table = "// wip fmt: off\nval  TABLE = [1,2,  3]\n"
	write(root, "kept.wip", kept)
	write(root, "table.wip", table)
	write(root, "main.wip", "fn main() = {\nval x = 1\n}\n")
	val check = gate.wip(root, ["fmt", "--check", "."])
	if check.exit != .Code(1) ||
		check.stdout.trim() != "./main.wip" ||
		!check.stderr.contains("2 files are left as written: each says `// wip fmt: off`") {
		return wrong("`wip fmt --check .`", &check)
	}
	val laid = gate.wip(root, ["fmt", "."])
	if !laid.exit.success() ||
		read(root, "main.wip") != "fn main() = {\n\tval x = 1\n}\n" ||
		read(root, "kept.wip") != kept ||
		read(root, "table.wip") != table {
		return wrong("`wip fmt .`", &laid)
	}
	val named = gate.wip(root, ["fmt", "kept.wip"])
	if !named.exit.success() || !named.stderr.contains("`kept.wip` is left as written") then
		return wrong("`wip fmt kept.wip`", &named)
	val unparsed = "// wip fmt: off\nfn main( = {\n"
	val echoed = gate.wipReading(unparsed, root, ["fmt", "-", "--stdin-path", "main.wip"])
	if !echoed.exit.success() || echoed.stdout != unparsed then return wrong("`wip fmt -`", &echoed)
	return .None
}
