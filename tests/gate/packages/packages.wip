// Packages that depend on each other: a monorepo of a library and two
// programs, and each way a `package.wip` or an import across packages can
// be wrong; and how a package says it is laid out.

import std::fs
import std::path
import std::process::{Command}
import check::{Checked, Gate, across, isFile, read, run, write, wrong}

/// What is checked, each by what it shows.
val ITEMS = [
	"programs build the packages they depend on",
	"a package is built as itself",
	"a package tests itself",
	"every module of a package is checked and tested",
	"another package's internal module is refused",
	"a package reached but not depended on is refused",
	"a dependency is named as it names itself",
	"what a package.wip may say",
	"a package.wip holds only the package",
	"packages that depend on each other are refused",
	"a module named like a dependency is refused",
	"a name or version that was never given",
	"a package says how it is formatted",
	"standard input is formatted as its package says",
	"a file that says so is left as written",
	"a format it does not know is refused",
	"the files a package names are beside its program",
	"files a package may not name are refused",
	"what an app may say",
	"a library's files are beside every program that uses it",
	"files a library's program may not take are refused",
	"wip fix applies the fixes that change no meaning",
	"wip fix takes away what is never used, for each target it is given, and writes the `&` a reference is passed on with",
	"wip fix says a loop as the list or the search it is",
	"wip fix writes `indexed()`, and takes away a `String::of` or a `Vec::of` the type expected says",
]

pub fn check(gate: &Gate): Checked = {
	val items: Vec<i64> = [
		for index in 0..ITEMS.len() do
			if gate.takes(ITEMS[index]) then
				yield index
	]
	val failed = across(
		items.len(),
		(at) => {
			val index = items[at]
			val dir = gate.work.join("packages-\(index)")
			fs::makeDirs(dir)
			return match one(&gate, index, dir) {
				.Some(why) => .Some("\(ITEMS[index]): \(why)")
				.None => .None
			}
		},
	)
	return Checked::of(items.len(), failed)
}

fn one(gate: &Gate, index: i64, root: str): Option<String> = match index {
	0 => buildsWhatItDependsOn(&gate, root)
	1 => builtAsItself(&gate, root)
	2 => testsItself(&gate, root)
	3 => everyModule(&gate, root)
	4 => refusedFor(&gate, root, "@depends(\"engine\", path = \"../engine\")\npackage bad\n", "import engine::internal::pool\n\nfn main() = {}\n", [
		"[E0215]",
		"is internal to package `engine`",
	])
	5 => refusedFor(&gate, root, "@depends(\"game\", path = \"../game\")\npackage bad\n", "import engine::render\n\nfn main() = {}\n", [
		"this package does not depend on `engine`",
	])
	6 => refusedFor(&gate, root, "@depends(\"eng\", path = \"../engine\")\npackage bad\n", "fn main() = {}\n", [
		"is package `engine`, not `eng`",
		"it says this",
	])
	7 => refusedFor(&gate, root, "@version(\"1.4\")\n@license(\"MIT\")\n@depends(\"net\", git = \"https://example.com/net\", rev = \"v1.0.0\")\n@depends(\"nothing\", path = \"../nowhere\")\npackage bad\n", "fn main() = {}\n", [
		"`1.4` is not a semantic version",
		"`@license` is not something a package says",
		"which is not built yet",
		"has no `package.wip`",
	])
	8 => refusedFor(&gate, root, "package bad\nfn main() = {}\n", "fn main() = {}\n", [
		"holds nothing after its `package`",
	])
	9 => dependOnEachOther(&gate, root)
	10 => moduleLikeADependency(&gate, root)
	11 => neverGiven(&gate, root)
	12 => formatted(&gate, root)
	13 => standardInput(&gate, root)
	14 => leftAsWritten(&gate, root)
	15 => refusedFor(&gate, root, "@format(indent = \"both\")\npackage bad\n", "fn main() = {}\n", [
		"neither `\"tabs\"` nor `\"spaces\"`",
	])
	16 => filesBesideTheProgram(&gate, root)
	17 => refusedFor(&gate, root, "@files(\"../game\", \"/etc\", \"nothere\", 3)\n@files(\"main.wip\")\npackage bad\n", "fn main() = {}\n", [
		"`../game` is outside the package",
		"`/etc` is a whole path",
		"there is no `nothere` in the package",
		"`@files` takes paths, each a string",
		"a package names its files once",
	])
	18 => refusedFor(&gate, root, "@app(id = \"game\", devices = \"tv\", orientation = \"sideways\", icon = \"main.wip\", minimum = \"seventeen\", colour = \"red\", \"loose\")\n@app(name = \"No id\")\npackage bad\n", "fn main() = {}\n", [
		"`game` is not an app's identifier",
		"`devices` is `ipad`, `iphone` or `both`",
		"`orientation` is `landscape`, `portrait` or `any`",
		"an app's icon is a PNG",
		"`minimum` is an iOS version",
		"`@app` knows no `colour`",
		"`@app` takes `key = \"value\"`",
		"a package is one app",
	])
	19 => libraryFiles(&gate, root)
	20 => libraryFilesRefused(&gate, root)
	21 => fixed(&gate, root)
	22 => fixedUnused(&gate, root)
	23 => fixedLoops(&gate, root)
	24 => fixedSaid(&gate, root)
	_ => .Some("there is no such item")
}

/// `engine`, a library with a public module and an internal one; `game`, a
/// program that depends on it; and `editor`, a program that depends on
/// both.
fn monorepo(root: str) = {
	write(root, "engine/package.wip", "@version(\"0.3.0\")\npackage engine\n")
	write(root, "engine/engine.wip", "import render\n\npub fn frames(): i64 = render::frame(3)\n")
	write(
		root,
		"engine/render/render.wip",
		"import internal::pool\n\npub fn frame(n: i64): i64 = n * pool::size()\n\npub fn engineVersion(): str = package::VERSION\n",
	)
	write(
		root,
		"engine/render/render.test.wip",
		"@test\nfn framesScale() = assert(frame(2) == 20)\n",
	)
	write(root, "engine/internal/pool/pool.wip", "pub fn size(): i64 = 10\n")
	write(
		root,
		"game/package.wip",
		"@version(\"1.4.0\")\n@depends(\"engine\", path = \"../engine\")\npackage game\n",
	)
	write(
		root,
		"game/main.wip",
		"import std::io\nimport engine\nimport engine::render\nimport board\n\nfn main() = {\n    io::println(\"\\(package::NAME) \\(package::VERSION)\")\n    io::println(render::engineVersion())\n    io::printInt(engine::frames() + board::cells())\n}\n",
	)
	write(root, "game/board/board.wip", "pub fn cells(): i64 = 81\n")
	write(
		root,
		"game/main.test.wip",
		"import std::fs\nimport board\n\n@test\nfn boardHasCells() = assert(board::cells() == 81)\n\n@test\nfn levelsAreBesideIt() = assert(fs::exists(\"levels/first.txt\"))\n",
	)
	write(root, "game/levels/first.txt", "#########\n")
	write(
		root,
		"editor/package.wip",
		"@version(\"0.1.0\")\n@depends(\"engine\", path = \"../engine\")\n@depends(\"game\", path = \"../game\")\npackage editor\n",
	)
	write(
		root,
		"editor/main.wip",
		"import std::io\nimport game::board\nimport engine::render\n\nfn main() = {\n    io::println(\"\\(package::NAME) \\(package::VERSION)\")\n    io::printInt(board::cells() + render::frame(1))\n}\n",
	)
}

/// Each program builds its dependencies from source, and `package::` in a
/// module means that module's package: `engine`'s version from `engine`'s
/// code, called by `game`; and `editor` reaches `engine` directly and
/// through `game`, and has one `engine`.
fn buildsWhatItDependsOn(gate: &Gate, root: str): Option<String> = {
	monorepo(root)
	val game = gate.wip(root, ["run", "game"])
	if game.stdout != "game 1.4.0\n0.3.0\n111\n" then
		return wrong("`wip run game`", &game)

	val editor = gate.wip(root, ["run", "editor"])
	if editor.stdout != "editor 0.1.0\n91\n" then
		return wrong("`wip run editor`", &editor)

	return .None
}

/// A package is built by its directory or its `package.wip`, and the
/// program is named as the package names itself, in the package's root:
/// from above, where a directory of that name is the package itself, the
/// program is written into it.
fn builtAsItself(gate: &Gate, root: str): Option<String> = {
	monorepo(root)
	val game = path::join(root, "game")
	val built = gate.wip(game, ["build", "package.wip"])
	if !built.exit.success() || !isFile(root, "game/game") then
		return wrong("`wip build package.wip`", &built)

	val above = gate.wip(root, ["build", "editor"])
	if !above.exit.success() || !isFile(root, "editor/editor") then
		return wrong("`wip build editor`", &above)

	val named = gate.wip(root, ["build", "editor", "-o", "editor-bin"])
	if !named.exit.success() || !isFile(root, "editor-bin") then
		return wrong("`wip build editor -o editor-bin`", &named)

	return .None
}

/// `wip test game` runs `game`'s tests, in its root, so that the path a
/// test names is the package's wherever the command was typed; `engine`'s
/// are run by testing it, library as it is; and a filter is matched against
/// the name as it is printed, module and all.
fn testsItself(gate: &Gate, root: str): Option<String> = {
	monorepo(root)
	val game = gate.wip(root, ["test", "game"])
	if !game.stdout.contains("boardHasCells") ||
		!game.stdout.contains("levelsAreBesideIt ... ok") ||
		game.stdout.contains("framesScale") {
		return wrong("`wip test game`", &game)
	}
	val engine = gate.wip(root, ["test", "engine"])
	if !engine.stdout.contains("render::framesScale ... ok") then
		return wrong("`wip test engine`", &engine)

	val byModule = gate.wip(root, ["test", "engine", "render::"])
	if !byModule.stdout.contains("running 1 test") then
		return wrong("`wip test engine render::`", &byModule)

	return .None
}

/// A module of the package that nothing imports yet is still checked, and
/// its tests run; a hidden directory, `target`, and a package inside the
/// package are not modules of it; and an error in a module nobody imports
/// is found by `check`, and is nothing to `build`, which compiles what the
/// program reaches.
fn everyModule(gate: &Gate, root: str): Option<String> = {
	write(root, "package.wip", "package tool\n")
	write(root, "main.wip", "import used\n\nfn main() = used::hello()\n")
	write(root, "used/used.wip", "pub fn hello() = {}\n")
	write(root, "lonely/lonely.wip", "fn half(n: i64): i64 = n / 2\n")
	write(root, "lonely/lonely.test.wip", "@test\nfn halves() = assert(half(8) == 4)\n")
	write(root, "lonely/deeper/deeper.wip", "fn one(): i64 = 1\n")
	for skipped in [".hidden/h.wip", "target/t.wip", "inner/package.wip", "inner/i.wip"] do
		write(root, skipped, "fn wrong(): i64 = \"not a number\"\n")

	val tested = gate.wip(root, ["test", "."])
	if !tested.stdout.contains("lonely::halves ... ok") then
		return wrong("`wip test .`", &tested)

	val checked = gate.wip(root, ["check", "."])
	if !checked.exit.success() then
		return wrong("`wip check .`", &checked)

	write(root, "lonely/lonely.wip", "fn half(n: i64): i64 = \"half\"\n")
	val refused = gate.wip(root, ["check", "."])
	if refused.exit.success() || !refused.stderr.contains("lonely.wip") then
		return wrong("`wip check .`, with an error in `lonely`", &refused)

	val built = gate.wip(root, ["build", "main.wip", "-o", "tool"])
	if !built.exit.success() then
		return wrong("`wip build main.wip`", &built)

	return .None
}

/// One wrong package: the monorepo, and a program beside it that says
/// `package` and `main`, checked; it is refused, saying each of `says`.
fn refusedFor(gate: &Gate, root: str, package: str, main: str, says: &[str]): Option<String> = {
	monorepo(root)
	write(root, "bad/package.wip", package)
	write(root, "bad/main.wip", main)
	val checked = gate.wip(root, ["check", "--color", "never", "bad/main.wip"])
	if checked.exit.success() then
		return wrong("it was accepted", &checked)

	for text in says do
		if !checked.stderr.contains(text) then
			return wrong("it does not say \"\(text)\"", &checked)

	return .None
}

fn dependOnEachOther(gate: &Gate, root: str): Option<String> = {
	monorepo(root)
	write(root, "c1/package.wip", "@depends(\"c2\", path = \"../c2\")\npackage c1\n")
	write(root, "c1/main.wip", "fn main() = {}\n")
	write(root, "c2/package.wip", "@depends(\"c1\", path = \"../c1\")\npackage c2\n")
	write(root, "c2/c2.wip", "pub fn x(): i64 = 1\n")
	val checked = gate.wip(root, ["check", "c1/main.wip"])
	if !checked.stderr.contains("depend on each other") then
		return wrong("`wip check c1/main.wip`", &checked)

	return .None
}

fn moduleLikeADependency(gate: &Gate, root: str): Option<String> = {
	monorepo(root)
	write(root, "bad/package.wip", "@depends(\"engine\", path = \"../engine\")\npackage bad\n")
	write(root, "bad/main.wip", "import engine::render\n\nfn main() = {}\n")
	write(root, "bad/engine/mine.wip", "pub fn x(): i64 = 1\n")
	val checked = gate.wip(root, ["check", "bad/main.wip"])
	if !checked.stderr.contains("is both a package this one depends on and a module of its own") {
		return wrong("`wip check bad/main.wip`", &checked)
	}
	return .None
}

/// `package::VERSION` without an `@version`, and `package::NAME` without a
/// `package.wip`: each says what to write, and where. A directory is built
/// as a package only if it is one.
fn neverGiven(gate: &Gate, root: str): Option<String> = {
	if refusedFor(&gate, root, "package bad\n", "import std::io\n\nfn main() = io::println(package::VERSION)\n", [
		"this package says no version",
	]) is .Some(why) {
		return why.clone()
	}
	val alone = path::join(root, "alone")
	write(alone, "main.wip", "import std::io\n\nfn main() = io::println(package::NAME)\n")
	val checked = gate.wip(alone, ["check", "main.wip"])
	if !checked.stderr.contains("this program is not a package") then
		return wrong("`wip check main.wip`", &checked)

	val built = gate.wip(root, ["build", alone.toStr()])
	if !built.stderr.contains("with no `package.wip`") then
		return wrong("`wip build` of a directory", &built)

	return .None
}

/// `wip fmt` lays a package out as its `@format` says, the command line
/// overrides it, and `--check` writes nothing and says which files would
/// change.
fn formatted(gate: &Gate, root: str): Option<String> = {
	write(
		root,
		"package.wip",
		"@format(width = 100, indent = \"spaces\", size = 2)\npackage laid\n",
	)
	val messy = "fn main() = {\nval x = 1\n}\n"
	write(root, "main.wip", messy)
	val check = gate.wip(root, ["fmt", "--check", "."])
	if check.exit != .Code(1) ||
		!check.stdout.contains("main.wip") ||
		read(root, "main.wip") != messy {
		return wrong("`wip fmt --check .`", &check)
	}
	val laid = gate.wip(root, ["fmt", "."])
	if !laid.exit.success() || read(root, "main.wip") != "fn main() = {\n  val x = 1\n}\n" then
		return wrong("`wip fmt .`", &laid)

	val again = gate.wip(root, ["fmt", "--check", "."])
	if !again.exit.success() then
		return wrong("`wip fmt --check .`, laid out", &again)

	val tabs = gate.wip(root, ["fmt", "--tabs", "main.wip"])
	if !tabs.exit.success() || read(root, "main.wip") != "fn main() = {\n\tval x = 1\n}\n" then
		return wrong("`wip fmt --tabs main.wip`", &tabs)

	return .None
}

/// `wip fix` applies the fixes of the warnings that change no meaning, in a
/// program and its tests, until none is left; `--check` writes nothing and
/// says which files would change, and how; and a program with an error is
/// left as it is.
fn fixed(gate: &Gate, root: str): Option<String> = {
	write(root, "package.wip", "package fixed\n")
	val program =
		"@derive(Eq)\nenum Kind {\n\tSand\n\tRock\n}\n\nfn kept(names: &var Vec<String>, line: String) = {\n\tnames.push(line.clone())\n}\n\nfn main() = {\n\tval kind = Kind::Rock\n\tval same = kind.clone()\n\tvar names: Vec<String> = Vec()\n\tkept(&var names, \"a\")\n\tassert(same == kind && names.len() == 1)\n}\n"
	val tests =
		"@test\nfn aLineIsKept() = {\n\tval line = String::of(\"b\")\n\tvar names: Vec<String> = Vec()\n\tnames.push(line.clone())\n\tassert(names.len() == 1)\n}\n"
	write(root, "main.wip", program)
	write(root, "main.test.wip", tests)
	val check = gate.wip(root, ["fix", "--check", "."])
	if check.exit != .Code(1) ||
		!check.stdout.contains("main.wip: E0448, E0464") ||
		!check.stdout.contains("main.test.wip: E0448") ||
		read(root, "main.wip") != program {
		return wrong("`wip fix --check .`", &check)
	}
	val fixing = gate.wip(root, ["fix", "."])
	if !fixing.exit.success() ||
		read(root, "main.wip").contains(".clone()") ||
		read(root, "main.test.wip").contains(".clone()") {
		return wrong("`wip fix .`", &fixing)
	}
	val again = gate.wip(root, ["fix", "--check", "."])
	if !again.exit.success() || !again.stdout.isEmpty() then
		return wrong("`wip fix --check .`, fixed", &again)

	val tested = gate.wip(root, ["test", "."])
	if !tested.exit.success() then
		return wrong("`wip test .`, fixed", &tested)

	val broken =
		"fn main() = {\n\tval line = String::of(\"c\")\n\tval copy = line.clone()\n\tnothing()\n}\n"
	write(root, "main.wip", broken)
	val refused = gate.wip(root, ["fix", "."])
	if refused.exit != .Code(1) || read(root, "main.wip") != broken then
		return wrong("`wip fix .` of a program with an error", &refused)

	return .None
}

/// `wip fix` makes a `var` that nothing writes a `val`, removes a local that
/// nothing reads and an import that nothing names, with the line each was
/// on, and writes `_` for a binding and a parameter that nothing reads; and
/// code for another target, which this one does not compile, where that
/// target is given. It writes the `&` a reference passed on by its name is
/// lent with, the one error whose fix it makes.
fn fixedUnused(gate: &Gate, root: str): Option<String> = {
	write(root, "package.wip", "package unused\n")
	val program =
		"import std::collections::{Map, Set}\nimport std::path\n\nfn add(a: i64, unused: i64): i64 = a\n\n@target(os = \"ios\")\nfn onIos(unread: i64): i64 = 0\n\nfn main() = {\n\tvar total = add(1, 2)\n\tval unread = 3\n\tvar seen: Set<i64> = Set()\n\tseen.add(total)\n\tfor (i, n) in [4].copies().enumerate() {\n\t\tseen.add(n)\n\t}\n\tassert(seen.len() == 2)\n}\n"
	write(root, "main.wip", program)
	val fixing = gate.wip(root, ["fix", "."])
	val here =
		"import std::collections::{Set}\n\nfn add(a: i64, _: i64): i64 = a\n\n@target(os = \"ios\")\nfn onIos(unread: i64): i64 = 0\n\nfn main() = {\n\tval total = add(1, 2)\n\tvar seen: Set<i64> = Set()\n\tseen.add(total)\n\tfor (_, n) in [4].copies().enumerate() do\n\t\tseen.add(n)\n\n\tassert(seen.len() == 2)\n}\n"
	if !fixing.exit.success() || read(root, "main.wip") != here then
		return wrong("`wip fix .`", &fixing)

	val ios = gate.wip(root, ["fix", "--target", "ios", "."])
	if !ios.exit.success() ||
		read(root, "main.wip") != here.replace("onIos(unread: i64)", "onIos(_: i64)") {
		return wrong("`wip fix --target ios .`", &ios)
	}
	// A reference passed on by its name, which a call now lends with `&`:
	// an error, whose fix `wip fix` makes.
	val passed =
		"fn size(values: &Vec<i64>): i64 = values.len()\n\nfn twice(values: &Vec<i64>): i64 = size(values) * 2\n\nfn main() = {\n\tval numbers: Vec<i64> = [1, 2]\n\tassert(twice(&numbers) == 4)\n}\n"
	write(root, "main.wip", passed)
	val migrated = gate.wip(root, ["fix", "."])
	if !migrated.exit.success() ||
		read(root, "main.wip") != passed.replace("size(values) * 2", "size(&values) * 2") ||
		!migrated.stdout.contains("main.wip: E0476") {
		return wrong("`wip fix .` of a reference passed on without `&`", &migrated)
	}
	return .None
}

/// `wip fix` says a loop that fills a `Vec` as the list that yields, which
/// is a `val` once nothing pushes to it, a list walked once as the
/// generator, and a loop that only searches as the search; a comment between
/// the vector and its loop goes into the list, and a loop the fix would
/// take a comment out of stays as written. The program runs as it did.
fn fixedLoops(gate: &Gate, root: str): Option<String> = {
	write(root, "package.wip", "package loops\n")
	val program =
		"fn shown(names: &[str]): Vec<String> = {\n\tvar kept: Vec<String> = Vec()\n\t// Only those with a name.\n\tfor name in names {\n\t\tif !name.isEmpty() then kept.push(String::of(name))\n\t}\n\treturn kept\n}\n\nfn long(sizes: &[i64]): bool = {\n\tfor size in sizes {\n\t\tif size > 3 then return true\n\t}\n\treturn false\n}\n\nfn blank(names: &[str]): bool = {\n\tfor name in names {\n\t\t// An empty one is blank.\n\t\tif name.isEmpty() then return true\n\t}\n\treturn false\n}\n\nfn main() = {\n\tval names = [\"ann\", \"\", \"bartholomew\"]\n\tval total = [for name in names { yield name.len() }].sum()\n\tassert(shown(&names).len() == 2 && long([1, 5]) && blank(&names) && total == 14)\n}\n"
	write(root, "main.wip", program)
	val fixing = gate.wip(root, ["fix", "."])
	val expected =
		"fn shown(names: &[str]): Vec<String> = {\n\tval kept: Vec<String> = [\n\t\t// Only those with a name.\n\t\tfor name in names do\n\t\t\tif !name.isEmpty() then\n\t\t\t\tyield name\n\t]\n\treturn kept\n}\n\nfn long(sizes: &[i64]): bool = {\n\treturn sizes.any((size) => size > 3)\n}\n\nfn blank(names: &[str]): bool = {\n\tfor name in names {\n\t\t// An empty one is blank.\n\t\tif name.isEmpty() then\n\t\t\treturn true\n\t}\n\treturn false\n}\n\nfn main() = {\n\tval names = [\"ann\", \"\", \"bartholomew\"]\n\tval total = (\n\t\tfor name in names do\n\t\t\tyield name.len()\n\t).sum()\n\tassert(shown(&names).len() == 2 && long([1, 5]) && blank(&names) && total == 14)\n}\n"
	if !fixing.exit.success() || read(root, "main.wip") != expected then
		return wrong("`wip fix .`", &fixing)

	if !fixing.stdout.contains("main.wip: E0470, E0479, E0480, E0481, E0483") then
		return wrong("`wip fix .`, what it says it fixed", &fixing)

	val ran = gate.wip(root, ["run", "."])
	if !ran.exit.success() then
		return wrong("`wip run .`, fixed", &ran)

	return .None
}

/// `wip fix` writes a list's `indexed()` for `forwards().enumerate()`, and
/// takes away a `String::of` and a `Vec::of` where the type expected says
/// them, keeping the `.Some` around one, and in a loop that it then says as
/// the list, where the field given the name is then written once; one whose
/// value is a `val` with no type stays. The program runs as it did.
fn fixedSaid(gate: &Gate, root: str): Option<String> = {
	write(root, "package.wip", "package said\n")
	val program =
		"struct Entry {\n\tname: String\n\tsizes: Vec<i64>\n}\n\nfn listed(names: &[str]): Vec<Entry> = {\n\tvar entries: Vec<Entry> = Vec()\n\tfor (i, name) in names.forwards().enumerate() {\n\t\tentries.push(Entry(name: String::of(name), sizes: Vec::of([i, name.len()])))\n\t}\n\treturn entries\n}\n\nfn main() = {\n\tval first = String::of(\"ann\")\n\tval maybe: Option<String> = .Some(String::of(\"bo\"))\n\tval entries = listed([\"ann\", \"bo\"])\n\tassert(entries[1].sizes[1] == 2 && entries[0].name == first && maybe.isSome())\n}\n"
	write(root, "main.wip", program)
	val fixing = gate.wip(root, ["fix", "."])
	val expected =
		"struct Entry {\n\tname: String\n\tsizes: Vec<i64>\n}\n\nfn listed(names: &[str]): Vec<Entry> = {\n\tval entries: Vec<Entry> = [\n\t\tfor (i, name) in names.indexed() do\n\t\t\tyield Entry(name:, sizes: [i, name.len()])\n\t]\n\treturn entries\n}\n\nfn main() = {\n\tval first = String::of(\"ann\")\n\tval maybe: Option<String> = .Some(\"bo\")\n\tval entries = listed([\"ann\", \"bo\"])\n\tassert(entries[1].sizes[1] == 2 && entries[0].name == first && maybe.isSome())\n}\n"
	if !fixing.exit.success() || read(root, "main.wip") != expected then
		return wrong("`wip fix .`", &fixing)

	if !fixing.stdout.contains("main.wip: E0470, E0479, E0482, E0483 ×2, E0484, E0485") then
		return wrong("`wip fix .`, what it says it fixed", &fixing)

	val ran = gate.wip(root, ["run", "."])
	if !ran.exit.success() then
		return wrong("`wip run .`, fixed", &ran)

	return .None
}

/// `wip fmt -` lays out standard input, as the package of the file
/// `--stdin-path` names says, and writes nothing when it does not parse, so
/// that an editor keeps its buffer.
fn standardInput(gate: &Gate, root: str): Option<String> = {
	write(root, "package.wip", "@format(indent = \"spaces\", size = 2)\npackage laid\n")
	val laid = gate.wipReading("fn main() = {\nval x = 1\n}\n", root, [
		"fmt",
		"-",
		"--stdin-path",
		"main.wip",
	])
	if !laid.exit.success() || laid.stdout != "fn main() = {\n  val x = 1\n}\n" then
		return wrong("`wip fmt -`", &laid)

	val broken = gate.wipReading("fn main( = {\n", root, ["fmt", "-", "--stdin-path", "main.wip"])
	if broken.exit != .Code(1) || !broken.stdout.isEmpty() || !broken.stderr.contains("main.wip") {
		return wrong("`wip fmt -`, of what does not parse", &broken)
	}
	return .None
}

/// A file whose leading comments say `// wip fmt: off` is left as written:
/// a directory formatted or checked around it changes and lists nothing of
/// it and says how many it left, a file named says so too, and standard
/// input comes back as it went in, even where it does not parse.
fn leftAsWritten(gate: &Gate, root: str): Option<String> = {
	val kept = "// Written by a tool.\n// wip fmt: off\n\nfn  kept( ) : i64 = 1\n"
	val table = "// wip fmt: off\nval  TABLE = [1,2,  3]\n"
	write(root, "kept.wip", kept)
	write(root, "table.wip", table)
	write(root, "main.wip", "fn main() = {\nval x = 1\n}\n")
	val check = gate.wip(root, ["fmt", "--check", "."])
	if check.exit != .Code(1) ||
		check.stdout.trim() != "./main.wip" ||
		!check.stderr.contains("2 files are left as written: each says `// wip fmt: off`") {
		return wrong("`wip fmt --check .`", &check)
	}
	val laid = gate.wip(root, ["fmt", "."])
	if !laid.exit.success() ||
		read(root, "main.wip") != "fn main() = {\n\tval x = 1\n}\n" ||
		read(root, "kept.wip") != kept ||
		read(root, "table.wip") != table {
		return wrong("`wip fmt .`", &laid)
	}
	val named = gate.wip(root, ["fmt", "kept.wip"])
	if !named.exit.success() || !named.stderr.contains("`kept.wip` is left as written") then
		return wrong("`wip fmt kept.wip`", &named)

	val unparsed = "// wip fmt: off\nfn main( = {\n"
	val echoed = gate.wipReading(unparsed, root, ["fmt", "-", "--stdin-path", "main.wip"])
	if !echoed.exit.success() || echoed.stdout != unparsed then
		return wrong("`wip fmt -`", &echoed)

	return .None
}

/// What `@files` names is beside the program wherever it is built: copied
/// beside it by `wip build -o`, again where it changed, and found from
/// another directory; linked beside it by `wip run` and `wip test`, so
/// that what the program reads is the package's own; and nothing copied
/// where the program is built into the package.
fn filesBesideTheProgram(gate: &Gate, root: str): Option<String> = {
	write(root, "game/package.wip", "@files(\"levels\", \"help.txt\")\npackage game\n")
	write(root, "game/levels/first.txt", "first\n")
	write(root, "game/help.txt", "help\n")
	write(
		root,
		"game/main.wip",
		"import std::fs\nimport std::io\nimport std::process\n\nfn main() = io::print(fs::readFile(process::besideProgram(\"levels/first.txt\")).unwrap())\n",
	)
	write(
		root,
		"game/main.test.wip",
		"import std::fs\nimport std::process\n\n@test\nfn levelsAreLinkedBesideTheTests() = assert(fs::linkMeta(process::besideProgram(\"levels\")) is .Ok(about) && about.kind == .Link)\n",
	)
	val ran = gate.wip(root, ["run", "game"])
	if ran.stdout != "first\n" then
		return wrong("`wip run game`", &ran)

	val built = gate.wip(root, ["build", "game", "-o", "out/game"])
	if !built.exit.success() ||
		!isFile(root, "out/levels/first.txt") ||
		!isFile(root, "out/help.txt") {
		return wrong("`wip build game -o out/game`", &built)
	}
	val elsewhere = run(
		Command::of(path::join(root, "out/game")).directory(path::join(root, "game/levels")),
	)
	if elsewhere.stdout != "first\n" then
		return wrong("`out/game`, run from elsewhere", &elsewhere)

	write(root, "game/levels/first.txt", "second\n")
	val again = gate.wip(root, ["build", "game", "-o", "out/game"])
	if !again.exit.success() || read(root, "out/levels/first.txt") != "second\n" then
		return wrong("`wip build game -o out/game`, after a level changed", &again)

	val tested = gate.wip(root, ["test", "game"])
	if !tested.stdout.contains("levelsAreLinkedBesideTheTests ... ok") then
		return wrong("`wip test game`", &tested)

	if read(root, "game/levels/first.txt") != "second\n" then
		return .Some("the package's own level is gone after `wip run` and `wip test`")

	val inPlace = gate.wip(root, ["build", "game"])
	if !inPlace.exit.success() || !isFile(root, "game/game") then
		return wrong("`wip build game`", &inPlace)

	return .None
}

/// A library's `@files` are put beside every program that uses it, under a
/// directory of its name, and its code finds them with
/// `package::besideProgram`, which knows which it is: through `ui`, which
/// depends on `engine` too, as `engine` is placed once, beside `ui`;
/// copied by `wip build -o`, linked by `wip run`, by `wip test` and where a
/// program is built in its root, which builds again; and found by the
/// library's own tests, where it is the program.
fn libraryFiles(gate: &Gate, root: str): Option<String> = {
	write(root, "engine/package.wip", "@files(\"shaders/metal\")\npackage engine\n")
	write(root, "engine/shaders/metal/lit.txt", "lit\n")
	// The directory above the one it names, which is beside the program
	// where that is.
	write(
		root,
		"engine/engine.wip",
		"import std::fs\nimport std::path\n\npub fn shader(): String = fs::readFile(path::join(package::besideProgram(\"shaders\"), \"metal/lit.txt\")).unwrapOr(String::of(\"missing\\n\"))\n",
	)
	write(
		root,
		"engine/engine.test.wip",
		"@test\nfn theShaderIsFoundInTheLibrarysOwnTests() = assert(shader() == \"lit\\n\")\n",
	)
	write(
		root,
		"ui/package.wip",
		"@depends(\"engine\", path = \"../engine\")\n@files(\"fonts\")\npackage ui\n",
	)
	write(root, "ui/fonts/small.txt", "small\n")
	write(
		root,
		"ui/ui.wip",
		"import std::fs\n\npub fn font(): String = fs::readFile(package::besideProgram(\"fonts/small.txt\")).unwrapOr(String::of(\"missing\\n\"))\n",
	)
	write(
		root,
		"game/package.wip",
		"@depends(\"engine\", path = \"../engine\")\n@depends(\"ui\", path = \"../ui\")\n@files(\"levels\")\npackage game\n",
	)
	write(root, "game/levels/one.txt", "one\n")
	write(
		root,
		"game/main.wip",
		"import std::fs\nimport std::io\nimport engine\nimport ui\n\nfn main() = io::print(\"\\(engine::shader())\\(ui::font())\\(fs::readFile(package::besideProgram(\"levels/one.txt\")).unwrap())\")\n",
	)
	val all = "lit\nsmall\none\n"
	val ran = gate.wip(root, ["run", "game"])
	if ran.stdout != all then
		return wrong("`wip run game`", &ran)

	val built = gate.wip(root, ["build", "game", "-o", "out/game"])
	if !built.exit.success() ||
		!isFile(root, "out/engine/shaders/metal/lit.txt") ||
		!isFile(root, "out/ui/fonts/small.txt") ||
		!isFile(root, "out/levels/one.txt") ||
		isFile(root, "out/ui/engine/shaders/metal/lit.txt") {
		return wrong("`wip build game -o out/game`", &built)
	}
	val elsewhere = run(Command::of(path::join(root, "out/game")).directory(root))
	if elsewhere.stdout != all then
		return wrong("`out/game`, run from elsewhere", &elsewhere)

	for time in ["first", "second"] {
		val inRoot = gate.wip(root, ["build", "game"])
		if !inRoot.exit.success() then
			return wrong("`wip build game`, the \(time) time", &inRoot)

		if !(fs::linkMeta(path::join(root, "game/engine/shaders/metal")) is .Ok(about) &&
			about.kind == .Link) {
			return .Some("the engine's shaders are not linked beside the program built in its root")
		}
	}
	val there = run(Command::of(path::join(root, "game/game")).directory(root))
	if there.stdout != all then
		return wrong("`game/game`, built in its root", &there)

	val tested = gate.wip(root, ["test", "engine"])
	if !tested.stdout.contains("theShaderIsFoundInTheLibrarysOwnTests ... ok") then
		return wrong("`wip test engine`", &tested)

	return .None
}

/// What a library's files make the program refuse: a `.wip` file named, a
/// path of the program's own begun as a dependency's name, a literal path
/// given to `package::besideProgram` that `@files` does not name, and the
/// program's file where a dependency's files go.
fn libraryFilesRefused(gate: &Gate, root: str): Option<String> = {
	write(root, "engine/package.wip", "@files(\"shaders\")\npackage engine\n")
	write(root, "engine/shaders/lit.txt", "lit\n")
	write(
		root,
		"engine/engine.wip",
		"pub fn shader(): String = package::besideProgram(\"meshes/cube.obj\")\n",
	)
	write(
		root,
		"bad/package.wip",
		"@depends(\"engine\", path = \"../engine\")\n@files(\"engine\", \"main.wip\")\npackage bad\n",
	)
	write(root, "bad/engine/notes.txt", "mine\n")
	write(root, "bad/main.wip", "import engine\n\nfn main() = {\n    engine::shader()\n}\n")
	val checked = gate.wip(root, ["check", "--color", "never", "bad/main.wip"])
	for said in [
		"`engine` is where `engine`'s files go",
		"`main.wip` holds Wip's code",
		"`meshes/cube.obj` is not a file the package names",
	] do
		if checked.exit.success() || !checked.stderr.contains(said) then
			return wrong("it does not say \"\(said)\"", &checked)

	write(
		root,
		"engine/engine.wip",
		"pub fn shader(): String = package::besideProgram(\"shaders/lit.txt\")\n",
	)
	write(root, "good/package.wip", "@depends(\"engine\", path = \"../engine\")\npackage good\n")
	write(root, "good/main.wip", "import engine\n\nfn main() = {\n    engine::shader()\n}\n")
	val named = gate.wip(root, ["build", "good", "-o", "out/engine"])
	if named.exit.success() || !named.stderr.contains("where `engine`'s files go beside it") then
		return wrong("`wip build good -o out/engine`", &named)

	return .None
}
