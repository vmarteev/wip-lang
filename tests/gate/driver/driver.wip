// The `wip` command as people type it: building, running and testing
// programs, the C they carry and the C they are linked into, the targets
// and processors they are built for, what the build keeps, what `wip mir`
// and `wip check` dump, and what LLVM is told. Each item writes a program
// into a directory of its own and runs `wip` there.

import std::fs
import check::{Checked, Gate, across}

/// What is checked, each by what it shows, and the function that checks
/// it in a directory of its own.
struct Item {
	name: String
	checks: (gate: &Gate, root: str) => Option<String>
}

fn items(): Vec<Item> = {
	var items: Vec<Item> = Vec()
	items.push(Item(
		name: String::of("a program of Wip alone compiles no C"),
		checks: wipAloneCompilesNoC,
	))
	items.push(Item(
		name: String::of("a release build optimises, and does the same"),
		checks: releaseOptimizes,
	))
	items.push(Item(
		name: String::of("a bare file name means the current directory"),
		checks: bareFileName,
	))
	items.push(Item(name: String::of("diagnostics name files as typed"), checks: namesAsTyped))
	items.push(Item(name: String::of("the entry must be a .wip file"), checks: entryIsWip))
	items.push(Item(name: String::of("run passes a separator to main"), checks: runPassesSeparator))
	items.push(Item(name: String::of("run passes arguments to main"), checks: runPassesArguments))
	items.push(Item(name: String::of("main takes nothing or its arguments"), checks: mainTakes))
	items.push(Item(
		name: String::of("main returning a Result needs a text error"),
		checks: mainTextError,
	))
	items.push(Item(
		name: String::of("main returning a Result of something else"),
		checks: mainOtherResult,
	))
	items.push(Item(
		name: String::of("main takes arguments and returns a Result"),
		checks: mainArgumentsAndResult,
	))
	items.push(Item(
		name: String::of("a program reads its standard input"),
		checks: readsStandardInput,
	))
	items.push(Item(
		name: String::of("a program reads and writes files"),
		checks: readsAndWritesFiles,
	))
	items.push(Item(name: String::of("a program reads its environment"), checks: readsEnvironment))
	items.push(Item(
		name: String::of("a negative buffer length stops the program"),
		checks: negativeBuffer,
	))
	items.push(Item(
		name: String::of("allocations are counted only where asked"),
		checks: allocationsCounted,
	))
	items.push(Item(
		name: String::of("a release build does what a debug build does"),
		checks: releaseDoesTheSame,
	))
	items.push(Item(
		name: String::of("a panic in a release build lists the calls a debug build does"),
		checks: releasePanicCalls,
	))
	items.push(Item(
		name: String::of("the most negative i128 by minus one aborts"),
		checks: i128Aborts,
	))
	items.push(Item(
		name: String::of("nothing is built without clang"),
		checks: nothingWithoutClang,
	))
	items.push(Item(
		name: String::of("include and library paths are given on the command line"),
		checks: includeAndLibraryPaths,
	))
	items.push(Item(name: String::of("a library C links against"), checks: libraryForC))
	items.push(Item(
		name: String::of("a program holds only what it reaches"),
		checks: holdsWhatItReaches,
	))
	items.push(Item(
		name: String::of("a program is built for the processor named"),
		checks: builtForProcessor,
	))
	items.push(Item(name: String::of("a shared library"), checks: sharedLibrary))
	items.push(Item(name: String::of("Objective-C and frameworks on a Mac"), checks: objectiveC))
	items.push(Item(name: String::of("an include that is not there"), checks: includeNotThere))
	items.push(Item(name: String::of("targets choose what is compiled"), checks: targetsChoose))
	items.push(Item(
		name: String::of("a program is checked for another target"),
		checks: checkedForAnotherTarget,
	))
	items.push(Item(
		name: String::of("a mistake every target finds is said once"),
		checks: mistakeSaidOnce,
	))
	items.push(Item(
		name: String::of("the cache is cleaned of what wip keeps alone"),
		checks: cacheCleaned,
	))
	items.push(Item(name: String::of("the IR is written without clang"), checks: irWithoutClang))
	items.push(Item(
		name: String::of("a build without debug information"),
		checks: withoutDebugInfo,
	))
	items.push(Item(
		name: String::of("wip test runs the tests of every module"),
		checks: testsEveryModule,
	))
	items.push(Item(
		name: String::of("a failing test names itself and stops the run"),
		checks: failingTest,
	))
	items.push(Item(name: String::of("wip test without tests says so"), checks: noTests))
	items.push(Item(name: String::of("mir prints every function"), checks: mirEveryFunction))
	items.push(Item(
		name: String::of("mir prints what a build compiles"),
		checks: mirWhatABuildCompiles,
	))
	items.push(Item(
		name: String::of("diagnostics are dumped one fact a line"),
		checks: diagnosticsDumped,
	))
	items.push(Item(
		name: String::of("alternatives are numbered in each body"),
		checks: alternativesNumbered,
	))
	items.push(Item(
		name: String::of("the library is dumped where it is asked for"),
		checks: libraryDumped,
	))
	items.push(Item(
		name: String::of("the checked program is dumped one fact a line"),
		checks: programDumped,
	))
	items.push(Item(
		name: String::of("a shared reference is read-only to LLVM"),
		checks: sharedReadOnly,
	))
	items.push(Item(
		name: String::of("a reference read from memory promises only what holds everywhere"),
		checks: referenceFromMemory,
	))
	items.push(Item(
		name: String::of("checked arithmetic says it does not wrap"),
		checks: arithmeticDoesNotWrap,
	))
	items.push(Item(
		name: String::of("a table of methods is read as invariant"),
		checks: tableInvariant,
	))
	return move items
}

pub fn check(gate: &Gate): Checked = {
	val all = items()
	var chosen: Vec<i64> = Vec()
	for index in 0..all.len() {
		if gate.takes(all[index].name.toStr()) then chosen.push(index)
	}
	val failed = across(
		chosen.len(),
		(at) => {
			val item = &all[chosen[at]]
			val root = gate.work.join("driver-\(chosen[at])")
			fs::makeDirs(root.toStr())
			return match item.checks(&gate, root.toStr()) {
				.Some(why) => .Some("\(item.name): \(why)")
				.None => .None
			}
		},
	)
	return Checked::of(chosen.len(), move failed)
}

/// How many times `needle` is in `text`, none overlapping.
fn countOf(text: str, needle: str): i64 = {
	var count = 0
	var rest = text
	while rest.find(needle) is .Some(at) {
		count += 1
		rest = rest[at + needle.len()..]
	}
	return count
}

/// The lines of a text, each as a `String`.
fn linesOf(text: str): Vec<String> = {
	var lines: Vec<String> = Vec()
	for line in text.lines() {
		lines.push(String::of(line))
	}
	return move lines
}

/// Whether the lines of `text` are `expected`, in order.
fn linesAre(text: str, expected: &[str]): bool = {
	val lines = linesOf(text)
	if lines.len() != expected.len() then return false
	for i in 0..lines.len() {
		if lines[i] != expected[i] then return false
	}
	return true
}
