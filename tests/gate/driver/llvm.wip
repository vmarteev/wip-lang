// What a release build tells LLVM, read in the IR `--emit llvm-ir` writes:
// each program first runs as it should, and then its IR says what may be
// assumed, and no more.

import std::io
import std::process::{Command}
import check::{Gate, read, run, wrong, write}

/// The release build's IR of the program in `root`, or why there is none.
fn irOf(gate: &Gate, root: str): Result<String, String> = {
	val written = gate.wip(root, [
		"build",
		"--release",
		"--emit",
		"llvm-ir",
		"main.wip",
		"-o",
		"program.ll",
	])
	if !written.exit.success() then
		return .Err(wrong("`wip build --emit llvm-ir`", &written).unwrapOr(String()))
	return .Ok(read(root, "program.ll"))
}

/// The line that defines the program's function `name`.
fn defined(ir: str, name: str): String = {
	val head = "@\"wip.\(name)."
	for line in ir.lines() {
		if line.startsWith("define") && line.contains(head) then return line
	}
	return String()
}

/// The attributes of the group `line`, a function's definition, names.
fn attributesOf(ir: str, line: str): String = {
	val .Some(at) = line.lastIndexOf(" #") else return String()
	val rest = line[at + 2..line.len()]
	var end = 0
	while end < rest.len() && rest[end] >= b'0' && rest[end] <= b'9' {
		end += 1
	}
	val head = "attributes #\(rest[0..end]) = "
	for candidate in ir.lines() {
		if candidate.startsWith(head) then return String::of(candidate)
	}
	return String()
}

/// In a release build, a function in a cycle of calls is `noinline`: the
/// method of a walk of an enum's tree, and the container's function that
/// calls it again, each keep a frame of their own; so does a function that
/// calls itself. The leaf's function and `main`, in no cycle, are inlined
/// where LLVM finds it pays.
fn cyclesNotInlined(gate: &Gate, root: str): Option<String> = {
	write(
		root,
		"main.wip",
		"import std::io\n\nenum Node {\n    Leaf(value: i64)\n    Pair(left: own<Node>, right: own<Node>)\n}\n\nextend Node {\n    fn total(): i64 = match self {\n        .Leaf(value) => leafValue(value)\n        .Pair(left, right) => pairTotal(&left, &right)\n    }\n}\n\nfn pairTotal(left: &Node, right: &Node): i64 = left.total() + right.total()\n\nfn leafValue(value: i64): i64 = value * 2\n\nfn countDown(n: i64): i64 = if n == 0 then 0 else 1 + countDown(n - 1)\n\nfn main() = {\n    val tree = Node::Pair(\n        left: own .Leaf(value: 1),\n        right: own .Pair(left: own .Leaf(value: 2), right: own .Leaf(value: 3)),\n    )\n    io::println(\"\\(tree.total()) \\(countDown(5))\")\n}\n",
	)
	val ran = gate.wip(root, ["run", "--release", "main.wip"])
	if !ran.exit.success() || ran.stdout != "12 5\n" then
		return wrong("`wip run --release main.wip`", &ran)
	val ir = match irOf(gate, root) {
		.Ok(ir) => ir
		.Err(why) => return .Some(why)
	}
	for (name, inCycle) in [
		("Node.total", true),
		("pairTotal", true),
		("countDown", true),
		("leafValue", false),
		("main", false),
	] {
		val line = defined(ir, name)
		val attributes = attributesOf(ir, line)
		if line.isEmpty() || attributes.isEmpty() || attributes.contains("noinline") != inCycle then
			return .Some("`\(name)` is defined as\n  \(line)\nwith\n  \(attributes)")
	}
	return .None
}

/// A `&` parameter is `noalias readonly` to LLVM where nothing changes its
/// place while the call runs: not where the place holds an `Atomic` by
/// value, which changes through a `&`, but where one is only reached
/// through an `own`, which is other memory. An aggregate taken by value is
/// `noalias`, and `readonly` where the function does not write it, which is
/// every function but a `@tailrec` one; a closure given one place both by
/// value and by `&` still reads it right. A reference is `nonnull`, and
/// reaches its whole value, aligned.
fn sharedReadOnly(gate: &Gate, root: str): Option<String> = {
	write(
		root,
		"main.wip",
		"import std::io\nimport std::sync::{Atomic}\n\nstruct Plain {\n    a: i64\n    b: i64\n}\n\nstruct Counted {\n    hits: Atomic<i64>\n}\n\nenum Maybe {\n    Counting(counted: Counted)\n    Not\n}\n\nstruct Boxed {\n    counted: own<Counted>\n}\n\nstruct Wide {\n    a: i64\n    b: i64\n    c: i64\n    d: i64\n}\n\nfn spanOf(w: Wide): i64 = w.d - w.a\n\n@tailrec\nfn spanAfter(w: Wide, steps: i64): i64 = if steps == 0 then w.d - w.a else spanAfter(Wide(a: w.a, b: w.b, c: w.c, d: w.d + 1), steps - 1)\n\nfn sumOf(p: &Plain): i64 = p.a + p.b\n\nfn hitsOf(c: &Counted): i64 = {\n    c.hits.add(1)\n    return c.hits.load()\n}\n\nfn hitsIn(m: &Maybe): i64 = match m {\n    .Counting(counted) => hitsOf(&counted)\n    .Not => 0\n}\n\nfn boxedHits(b: &Boxed): i64 = hitsOf(&b.counted)\n\nfn main() = {\n    val plain = Plain(a: 2, b: 3)\n    val counted = Counted(hits: Atomic::of(0))\n    val maybe = Maybe::Counting(counted: Counted(hits: Atomic::of(10)))\n    val boxed = Boxed(counted: own Counted(hits: Atomic::of(20)))\n    val wide = Wide(a: 1, b: 2, c: 3, d: 7)\n    val both = (w: Wide, at: &Wide) => w.c + at.d\n    io::println(\"\\(sumOf(&plain)) \\(hitsOf(&counted)) \\(hitsOf(&counted)) \\(hitsIn(&maybe)) \\(boxedHits(&boxed)) \\(spanOf(wide)) \\(both(wide, &wide)) \\(spanAfter(wide, 3))\")\n}\n",
	)
	val ran = gate.wip(root, ["run", "--release", "main.wip"])
	if !ran.exit.success() || ran.stdout != "5 1 2 11 21 6 10 9\n" then
		return wrong("`wip run --release main.wip`", &ran)
	val ir = match irOf(gate, root) {
		.Ok(ir) => ir
		.Err(why) => return .Some(why)
	}
	for name in ["sumOf", "boxedHits"] {
		val line = defined(ir, name)
		if !line.contains("ptr noalias readonly nonnull") then
			return .Some("`\(name)` is defined as\n  \(line)")
	}
	val sum = defined(ir, "sumOf")
	if !sum.contains("nonnull dereferenceable(16) align 8 %p0") then
		return .Some("`sumOf` is defined as\n  \(sum)")
	for name in ["hitsOf", "hitsIn"] {
		val line = defined(ir, name)
		if line.isEmpty() || line.contains("readonly") then
			return .Some("`\(name)` is defined as\n  \(line)")
	}
	// A struct taken by value is only read, which lets LLVM pass the caller's
	// own place; but a `@tailrec` function's calls to itself are written into
	// its parameters.
	val span = defined(ir, "spanOf")
	if !span.contains("ptr noalias readonly nocapture nonnull dereferenceable(32) align 8 %p0") then
		return .Some("`spanOf` is defined as\n  \(span)")
	val after = defined(ir, "spanAfter")
	if after.isEmpty() || after.contains("readonly") then
		return .Some("`spanAfter` is defined as\n  \(after)")
	return .None
}

/// A reference read out of memory is not null to LLVM, and aligned, but not
/// promised to reach its value: where the place is an enum's payload, LLVM
/// takes the promise as true even where the enum holds another variant, and
/// reads through the reference before the branch that loads it — through
/// whatever the payload's bytes were, a null pointer on Linux, where an
/// optimised compiler crashed so. A parameter still promises it.
fn referenceFromMemory(gate: &Gate, root: str): Option<String> = {
	write(
		root,
		"main.wip",
		"import std::collections::{Map}\nimport std::io\n\nstruct Pair {\n    a: i64\n    b: i64\n}\n\nfn first(seen: &Map<i64, Pair>, key: i64): i64 = match seen.get(&key) {\n    .Some(pair) => pair.a + pair.b\n    .None => 0\n}\n\nfn main() = {\n    var seen: Map<i64, Pair> = Map()\n    seen.put(1, Pair(a: 2, b: 3))\n    io::println(\"\\(first(&seen, 1)) \\(first(&seen, 5))\")\n}\n",
	)
	val ran = gate.wip(root, ["run", "--release", "main.wip"])
	if !ran.exit.success() || ran.stdout != "5 0\n" then
		return wrong("`wip run --release main.wip`", &ran)
	val ir = match irOf(gate, root) {
		.Ok(ir) => ir
		.Err(why) => return .Some(why)
	}
	var loads = 0
	for line in ir.lines() {
		if !line.contains("load ptr") || !line.contains("!nonnull") then continue
		loads += 1
		if line.contains("!dereferenceable") then
			return .Some("a reference loaded promises too much:\n  \(line)")
	}
	if loads == 0 then return .Some("no reference is loaded")
	if !ir.contains("nonnull dereferenceable(") then return .Some("no parameter promises it")
	return .None
}

/// Checked arithmetic is computed again past its check with LLVM's flags
/// that say it does not wrap — `nsw` signed, `nuw` unsigned — and still
/// panics where the answer does not fit.
fn arithmeticDoesNotWrap(gate: &Gate, root: str): Option<String> = {
	write(
		root,
		"main.wip",
		"import std::io\n\nfn plus(a: i64, b: i64): i64 = a + b\n\nfn less(a: u32, b: u32): u32 = a - b\n\nfn main(args: &[cstring]) = {\n    io::printInt(plus(40, 2))\n    io::printInt(less(5, 3) as i64)\n    io::printInt(less(1, args.len() as u32 + 1) as i64)\n}\n",
	)
	val ran = gate.wip(root, ["run", "--release", "main.wip"])
	if ran.exit != .Code(101) || ran.stdout != "42\n2\n" || !ran.stderr.contains("panicked") then
		return wrong("`wip run --release main.wip`", &ran)
	val ir = match irOf(gate, root) {
		.Ok(ir) => ir
		.Err(why) => return .Some(why)
	}
	if !ir.contains(" = add nsw i64 ") then return .Some("no `add nsw`")
	if !ir.contains(" = sub nuw i32 ") then return .Some("no `sub nuw`")
	return .None
}

/// What a call through a `&dyn` reads from its table of methods is read as
/// LLVM's invariant, since the table is a constant never freed; what an
/// owned closure's drop reads from its environment's header is not, since
/// that memory is freed and used again.
fn tableInvariant(gate: &Gate, root: str): Option<String> = {
	write(
		root,
		"main.wip",
		"import std::io\n\ninterface Step {\n    fn size(): i64\n}\n\nstruct Stride {\n    by: i64\n}\n\nextend Stride: Step {\n    fn size(): i64 = self.by\n}\n\nfn walk(step: &dyn Step, times: i64): i64 = {\n    var total = 0\n    var i = 0\n    while i < times {\n        total += step.size()\n        i += 1\n    }\n    return total\n}\n\nfn main() = {\n    val stride = Stride(by: 3)\n    val extra = 4\n    val add = own (x: i64) => x + extra\n    io::printInt(add(walk(&stride, 5)))\n}\n",
	)
	val ran = run(gate.command(root, ["run", "--release", "main.wip"]).env("WIP_CHECK_LEAKS", "1"))
	if !ran.exit.success() || ran.stdout != "19\n" then
		return wrong("`wip run --release main.wip`", &ran)
	val ir = match irOf(gate, root) {
		.Ok(ir) => ir
		.Err(why) => return .Some(why)
	}
	val walk = body(ir, "walk")
	if !walk.contains("!invariant.load") then
		return .Some("`walk` reads no table as invariant:\n\(walk)")
	val main = body(ir, "main")
	if main.contains("!invariant.load") then
		return .Some("`main` reads memory freed as invariant:\n\(main)")
	return .None
}

/// The whole definition of the program's function `name`.
fn body(ir: str, name: str): String = {
	val head = "@\"wip.\(name)."
	var rest = ir
	while rest.indexOf("\ndefine ") is .Some(at) {
		rest = rest[at + 1..]
		val line = rest.lines().next().unwrapOr("")
		if !line.contains(head) then continue
		val end = rest.indexOf("\n}\n").unwrapOr(rest.len())
		return rest[0..end]
	}
	return String()
}

/// An atomic's order is the instruction's: on x86-64, which orders every
/// store by itself, a release store is a plain `mov`, and a sequentially
/// consistent one the locked exchange it needs. Asked of the IR as `clang`
/// compiles it for x86-64, which any `clang` can, whatever this machine is.
fn atomicOrdersOnX86(gate: &Gate, root: str): Option<String> = {
	write(
		root,
		"main.wip",
		"import std::future\nimport std::io\nimport std::sync::{Atomic}\n\nfn main() = {\n    val published = Atomic::of(0)\n    val strongly = Atomic::of(0)\n    future::together(\n        () => {\n            published.store(7, order: .Release)\n            strongly.store(9)\n        },\n        () => {},\n    )\n    io::println(\"\\(published.load(order: .Acquire)) \\(strongly.load())\")\n}\n",
	)
	val ran = gate.wip(root, ["run", "--release", "main.wip"])
	if !ran.exit.success() || ran.stdout != "7 9\n" then
		return wrong("`wip run --release main.wip`", &ran)
	val ir = match irOf(gate, root) {
		.Ok(ir) => ir
		.Err(why) => return .Some(why)
	}
	if !ir.contains(" release, align 8") then return .Some("the IR has no release store:\n\(ir)")
	val clang = io::env("WIP_CLANG").unwrapOr("clang")
	val compiled = run(
		Command::of(clang).directory(root).args([
			"--target=x86_64-unknown-linux-gnu",
			"-O2",
			"-S",
			"-Wno-override-module",
			"program.ll",
			"-o",
			"program.s",
		]),
	)
	if !compiled.exit.success() then return wrong("`clang` for x86-64", &compiled)
	val assembly = read(root, "program.s")
	if !assembly.contains("movq\t$7, (") || assembly.contains("movq\t$9, (") then
		return .Some("on x86-64 the release store is not a plain `mov`, or the other is:\n\(assembly)")
	return .None
}
