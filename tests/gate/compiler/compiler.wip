// The compiler's own tests, `compiler/`, run by `wip test` from the
// repository's root: what the compiler holds of itself — its phases tested
// one by one, the cases cut short and cut up, the examples checked while a
// line is typed, and every case checked the same on any number of threads.
// What runs them is a program built from the compiler's source, not a
// compiler installed with its library beside it, so it is told that the
// repository is its home, where the library is.

import std::fs
import check::{Checked, Gate, run, wrong}

pub fn check(gate: &Gate): Checked = {
	if !gate.takes("its own tests") then return Checked::of(0, Vec())
	val home = fs::realPath(".").unwrapOr(String::of("."))
	val tested = run(
		gate.command(".", ["test", "--color", "never", "compiler/main.wip"]).env(
			"WIP_HOME",
			home.toStr(),
		),
	)
	var failed: Vec<String> = Vec()
	// A run that compiled no tests would pass with nothing checked.
	if !tested.exit.success() || tested.stdout.contains("running 0 tests") then
		failed.push(
			wrong("its own tests: `wip test compiler/main.wip`", &tested).unwrapOr(String()),
		)
	return Checked::of(1, move failed)
}
