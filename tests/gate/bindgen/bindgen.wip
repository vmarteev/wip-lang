// `wip bindgen`, the binding generator, which is written in Wip: its own
// tests, run by `wip test` as the library's are; what it writes for a header
// with one of everything in it, `tests/bindgen/shapes.h`, which is a
// snapshot, since the file it writes is committed and read by people; a
// library's own vectors declared as `std::math`'s, `tests/bindgen/vectors.h`,
// and refused where they are laid out otherwise; and its command line. It
// asks clang for a header's syntax tree, which only clang writes, so where
// there is no clang what it would write is not asked. The clang is the one
// bindgen asks: `$CC`, or `$WIP_CLANG`, which the Linux guest names, or
// `clang`.

import std::io
import std::process::{Command}
import check::{Checked, Gate, across, read, run, said, wrong}
import snapshot

val ITEMS = [
	"it passes its own tests",
	"what it writes for shapes.h",
	"a header read with a setting",
	"it renames around every keyword",
	"it reads its command line",
	"a C struct declared as a Wip type laid out as it",
	"a Wip type laid out otherwise is refused",
]

pub fn check(gate: &Gate): Checked = {
	var chosen: Vec<i64> = Vec()
	for index in 0..ITEMS.len() {
		if gate.takes(ITEMS[index]) then chosen.push(index)
	}
	val failed = across(
		chosen.len(),
		(at) => {
			val index = chosen[at]
			val found = match index {
				0 => ownTests(&gate)
				1 => shapes(&gate)
				2 => configured(&gate)
				3 => everyKeyword()
				4 => commandLine(&gate)
				5 => declaredAsWip(&gate)
				_ => laidOutOtherwise(&gate)
			}
			return match found {
				.Some(why) => .Some("\(ITEMS[index]): \(why)")
				.None => .None
			}
		},
	)
	return Checked::of(chosen.len(), failed)
}

fn clangIsInstalled(): bool = {
	val clang = match io::env("CC") {
		.Some(cc) => cc
		.None => io::env("WIP_CLANG").unwrapOr("clang")
	}
	return run(Command::of(clang).arg("--version")).exit.success()
}

/// Its tests pass, and there are some: a run that compiled none would pass
/// with nothing checked.
fn ownTests(gate: &Gate): Option<String> = {
	val tested = gate.wip(".", ["test", "tools/bindgen/main.wip"])
	if !tested.exit.success() || tested.stdout.contains("running 0 tests") then
		return wrong("`wip test tools/bindgen/main.wip`", &tested)
	return .None
}

/// What `wip bindgen` writes for `tests/bindgen/shapes.h` with
/// `arguments`, or why it wrote nothing.
fn writtenFor(gate: &Gate, arguments: &[str]): Result<String, String> = {
	var all: Vec<str> = ["bindgen", "tests/bindgen/shapes.h"].toVec()
	for argument in arguments {
		all.push(argument)
	}
	val ran = gate.wip(".", &all)
	if !ran.exit.success() then return .Err("`wip \(all.join(" "))` failed\(said(&ran))")
	return .Ok(ran.stdout.clone())
}

fn shapes(gate: &Gate): Option<String> = {
	if !clangIsInstalled() then return .None
	return match writtenFor(gate, ["--link", "shapes", "--module", "shapes", "--pointer", "hint"]) {
		.Ok(written) => snapshot::compare("tests/bindgen/shapes.snap", written, gate.writes)
		.Err(why) => .Some(why)
	}
}

/// A header read with a setting declares what that setting makes it
/// declare, and the file says the setting, so that the C compiled with the
/// program is configured the same way.
fn configured(gate: &Gate): Option<String> = {
	if !clangIsInstalled() then return .None
	val wide = match writtenFor(gate, ["-D", "SHAPES_WIDE", "--module", "shapes"]) {
		.Ok(written) => written
		.Err(why) => return .Some(why)
	}
	if !wide.contains("pub val SHAPES_WIDTH: i64 = 64") ||
		!wide.contains("@define(\"SHAPES_WIDE\")\n@header(\"shapes.h\")") {
		return .Some("with `-D SHAPES_WIDE` it writes\n\(wide)")
	}
	val plain = match writtenFor(gate, ["--module", "shapes"]) {
		.Ok(written) => written
		.Err(why) => return .Some(why)
	}
	if !plain.contains("pub val SHAPES_WIDTH: i64 = 32") || plain.contains("@define") then
		return .Some("with no setting it writes\n\(plain)")
	return .None
}

/// The words a C name is renamed around are the language's keywords, every
/// one: bindgen keeps its own list, which the compiler's lexer's is read
/// against here, so that a keyword added to the language is not a name
/// bindgen writes as it is.
fn everyKeyword(): Option<String> = {
	val lexer = read(".", "compiler/syntax/token.wip")
	val .Some(start) = lexer.indexOf("pub static fn keyword(") else {
		return .Some("the lexer reads no keywords")
	}
	val .Some(length) = lexer[start..].indexOf("_ => return .None") else {
		return .Some("the lexer's keywords do not end")
	}
	var keywords: Vec<String> = Vec()
	for line in lexer[start..start + length].lines() {
		if line.trim().stripPrefix("\"") is .Some(rest) && rest.indexOf("\" =>") is .Some(at) then
			keywords.push(rest[0..at])
	}
	keywords.sort()
	val types = read(".", "tools/bindgen/types/types.wip")
	val .Some(listed) = types.indexOf("val KEYWORDS") else return .Some("bindgen lists no keywords")
	val list = types[listed..]
	val end = list.indexOf("\n]").unwrapOr(list.len())
	var renamed: Vec<String> = Vec()
	for line in list[0..end].lines() {
		if line.trim().stripPrefix("\"") is .Some(rest) && rest.stripSuffix("\",") is .Some(word) {
			renamed.push(word)
		}
	}
	renamed.sort()
	if renamed != keywords then
		return .Some("bindgen's KEYWORDS are \(renamed.join(", "))\n  and the lexer's \(keywords.join(", "))")
	return .None
}

/// Its own command line, read with `std::args`: what is wrong with it is
/// said, with the usage, before clang is asked anything.
fn commandLine(gate: &Gate): Option<String> = {
	val help = gate.wip(".", ["bindgen", "--help"])
	if !help.exit.success() || !help.stdout.contains("usage: wip bindgen <header>") then
		return wrong("`wip bindgen --help`", &help)
	if refused(
		gate,
		["bindgen", "--frobnicate"],
		"error: `--frobnicate` is not an option",
	) is .Some(why) {
		return .Some(why.clone())
	}
	if refused(gate, ["bindgen", "a.h", "b.h"], "error: unexpected argument `b.h`") is .Some(why) {
		return .Some(why.clone())
	}
	if refused(gate, ["bindgen", "a.h", "-o"], "error: `-o` needs a value") is .Some(why) then
		return .Some(why.clone())
	if refused(gate, ["bindgen"], "usage: wip bindgen <header>") is .Some(why) then
		return .Some(why.clone())
	return .None
}

/// `--type Vector3=std::math::Vec3`: the header's vectors are the library's,
/// which the module imports, and every function and struct that takes one
/// takes the library's; a pointer to one is a reference, as to a struct the
/// header declares.
fn declaredAsWip(gate: &Gate): Option<String> = {
	if !clangIsInstalled() then return .None
	val ran = gate.wip(".", [
		"bindgen",
		"tests/bindgen/vectors.h",
		"--type",
		"Vector3=std::math::Vec3",
		"--type",
		"Vector2=std::math::Vec2",
		"--module",
		"vectors",
	])
	if !ran.exit.success() then return wrong("`wip bindgen tests/bindgen/vectors.h --type …`", &ran)
	return snapshot::compare("tests/bindgen/vectors.snap", ran.stdout.clone(), gate.writes)
}

/// A C struct is not declared as a Wip type laid out otherwise: one aligned
/// to 16 where C's is aligned to 4, one without a field C's has, and a name
/// the header does not declare.
fn laidOutOtherwise(gate: &Gate): Option<String> = {
	if !clangIsInstalled() then return .None
	for (mapping, says) in [
		("Vector4=std::math::Vec4", "it is aligned to 4 in C and 16 in Wip"),
		("Vector4=std::math::Vec3", "its field `w` is a `f32`, and `Vec3` has no such field"),
		("Vector5=std::math::Vec4", "the header declares no struct `Vector5`"),
		("Vector4=Vec4", "`Vec4` is not a path"),
	] {
		if refused(gate, ["bindgen", "tests/bindgen/vectors.h", "--type", mapping], says) is .Some(
			why,
		) {
			return .Some(why.clone())
		}
	}
	return .None
}

/// `wip` with `arguments` ends with 1, saying `says`.
fn refused(gate: &Gate, arguments: &[str], says: str): Option<String> = {
	val ran = gate.wip(".", arguments)
	if ran.exit != .Code(1) || !ran.stderr.contains(says) then
		return wrong("`wip \(arguments.join(" "))`", &ran)
	return .None
}
