// The programs in `examples/`, each a directory with a `main.wip`: every
// one is checked, its tests are run where it has any, and so are those of
// a package inside it; and a few are run as a reader would run them, so
// that an example cannot quietly stop working.

import std::fs
import std::path
import check::{Checked, Gate, across, listed, said}

val EXAMPLES = "examples"

/// The examples run as a reader would, each by what it shows.
val RUNS = [
	"hello says hello",
	"wordcount counts as its options say",
	"shapes-package says what it depends on",
]

pub fn check(gate: &Gate): Checked = {
	var items: Vec<String> = Vec()
	for name in listed(EXAMPLES) {
		val dir = "\(EXAMPLES)/\(name)"
		if fs::meta(dir) is .Ok(meta) && meta.isDirectory() && gate.takes(dir) then
			items.push(move dir)
	}
	for run in RUNS {
		if gate.takes(run) then items.push(run)
	}
	val failed = across(
		items.len(),
		(index) => {
			val item = items[index].toStr()
			return if item.startsWith("\(EXAMPLES)/") then example(&gate, item)
			else ran(&gate, item)
		},
	)
	return Checked::of(items.len(), move failed)
}

/// One example: it checks, and its tests pass, and those of each package
/// inside it.
fn example(gate: &Gate, dir: str): Option<String> = {
	val main = "\(dir)/main.wip"
	if !fs::exists(main) then return .Some("\(dir) has no main.wip")
	val checked = gate.wip(".", ["check", "--color", "never", main.toStr()])
	if !checked.exit.success() then return .Some("\(dir) does not check\(said(&checked))")
	if hasTests(dir) {
		val tested = gate.wip(".", ["test", "--color", "never", main.toStr()])
		if !tested.exit.success() then return .Some("\(dir)'s tests fail\(said(&tested))")
	}
	var inside: Vec<String> = Vec()
	packagesInside(dir, &var inside)
	for package in inside {
		val tested = gate.wip(".", ["test", "--color", "never", package.toStr()])
		if !tested.exit.success() then return .Some("\(package)'s tests fail\(said(&tested))")
	}
	return .None
}

/// One example run as a reader would: what it prints is what it shows.
fn ran(gate: &Gate, what: str): Option<String> = match what {
	"hello says hello" => {
		val run = gate.wip(".", ["run", "examples/hello/main.wip"])
		if run.exit.success() && run.stdout == "hello, world\n" then return .None
		return .Some("\(what): it did not\(said(&run))")
	}
	"wordcount counts as its options say" => {
		// A cluster with a value in it, a file, and a mistake.
		val file = gate.work.join("wordcount.txt")
		fs::writeFile(file, "The cat saw the dog, and the dog saw the cat.\n")
		val run = gate.wip(".", ["run", "examples/wordcount/main.wip", "-in2", file.toStr()])
		if !run.exit.success() || run.stdout != "      4  the\n      2  cat\n" then
			return .Some("\(what): it did not\(said(&run))")
		val wrong = gate.wip(".", ["run", "examples/wordcount/main.wip", "--top", "two"])
		if wrong.exit != .Code(1) ||
			!wrong.stderr.contains("error: `--top` takes a number, and `two` is not one") {
			return .Some("\(what): it did not refuse `--top two`\(said(&wrong))")
		}
		return .None
	}
	"shapes-package says what it depends on" => {
		val run = gate.wip(".", ["run", "examples/shapes-package/main.wip"])
		if run.exit.success() && run.stdout.endsWith("shapes 1.0.0, with geometry 0.2.0\n") then
			return .None
		return .Some("\(what): it did not\(said(&run))")
	}
	_ => .Some("\(what): no such run")
}

/// Whether a directory holds tests of its own module, `.test.wip` files.
fn hasTests(dir: str): bool = {
	for name in listed(dir) {
		if name.endsWith(".test.wip") then return true
	}
	return false
}

/// The packages inside an example other than the example itself: a library
/// it depends on, whose tests are its own.
fn packagesInside(dir: str, found: &var Vec<String>) = {
	for name in listed(dir) {
		val inner = path::join(dir, name)
		if fs::meta(inner) is .Ok(meta) && meta.isDirectory() {
			if fs::exists(path::join(inner, "package.wip")) then found.push(inner.clone())
			packagesInside(inner, &var found)
		}
	}
}
