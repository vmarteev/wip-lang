// The standard library: its own tests, `tests/std`, run by `wip test` from
// the repository's root, as they are by hand — the tests of `std::fs` read
// the repository they are in — built for debugging and for use, which must
// do the same; and every module of it checked for every target it is
// written for, whatever machine runs this, since a build reads a Mac's code
// only on a Mac and Linux's only on Linux.

import std::fs
import check::{Checked, Gate, across, listed, said}

/// What is checked, by name.
val ITEMS = ["its tests", "its tests, built for use", "every module, for every target"]

pub fn check(gate: &Gate): Checked = {
	var items: Vec<str> = Vec()
	for item in ITEMS {
		if gate.takes(item) then items.push(item)
	}
	val failed = across(items.len(), (index) => one(&gate, items[index]))
	return Checked::of(items.len(), move failed)
}

fn one(gate: &Gate, item: str): Option<String> = match item {
	"its tests" => tested(gate, item, ["test", "--color", "never", "tests/std/main.wip"])
	"its tests, built for use" => tested(gate, item, [
		"test",
		"--color",
		"never",
		"--release",
		"tests/std/main.wip",
	])
	"every module, for every target" => everyTarget(gate, item)
	_ => .Some("\(item): there is no such item")
}

/// `wip test` with `arguments`: it passes, and ran enough tests that a
/// run which compiled none, and so passed, is not taken for one that
/// checked anything.
fn tested(gate: &Gate, item: str, arguments: &[str]): Option<String> = {
	val ran = gate.wip(".", arguments)
	if !ran.exit.success() then return .Some("\(item) fail\(said(&ran))")
	val first = ran.stdout.lines().next().unwrapOr("")
	val count = first.stripPrefix("running ").unwrapOr("").split(" ").next().unwrapOr("")
	val enough = match count.toInt() {
		.Ok(number) => number >= 20
		.Err(_) => false
	}
	if !enough then return .Some("\(item): too few tests ran\(said(&ran))")
	return .None
}

/// A program that imports every module of the library, checked for every
/// target.
fn everyTarget(gate: &Gate, item: str): Option<String> = {
	var program = String()
	for name in listed("std") {
		if name != "prelude" && fs::meta("std/\(name)") is .Ok(meta) && meta.isDirectory() then
			program.push("import std::\(name)\n")
	}
	program.push("\nfn main() = {}\n")
	val dir = gate.work.join("library")
	fs::makeDirs(dir)
	val main = gate.work.join("library/main.wip")
	if fs::writeFile(main, program) is .Err(error) then
		return .Some("\(item): cannot write `\(main)`: \(error)")
	val checked = gate.wip(dir, ["check", "--color", "never", "--target", "all", "main.wip"])
	if !checked.exit.success() then return .Some("\(item): it does not check\(said(&checked))")
	return .None
}
