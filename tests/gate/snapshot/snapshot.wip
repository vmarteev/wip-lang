// Snapshots: a file that holds what a check found the last time someone
// read it and kept it, after a header that says which check writes it. A
// check compares what it finds with the file, and where they differ writes
// what it found beside it, `<name>.snap.new`, which `scripts/snapshots.sh`
// puts in its place once the difference is meant.
//
// Two texts are the same where they are after trailing white space is cut
// from their ends and `\r\n` is read as `\n`, so that an editor that adds
// a last line or a checkout that turns line ends changes nothing.

import std::fs

/// The header every snapshot starts with.
val HEADER = "---\nsource: tests/gate\n---\n"

/// Nothing where the snapshot at `path` holds `found`, and otherwise where
/// the two part, with `found` written beside it as `<path>.new` where it
/// `writes`.
pub fn compare(path: str, found: str, writes: bool): Option<String> = {
	val found = normalized(found)
	val held = match fs::readFile(path) {
		.Ok(text) => .Some(normalized(body(text)))
		.Err(_) => .None
	}
	val why = match held {
		.Some(held) if held == found => return .None
		.Some(held) => difference(held, found)
		.None => "  there is no snapshot yet"
	}
	if !writes then return .Some(move why)
	val new = "\(path).new"
	if fs::writeFile(new, "\(HEADER)\(found)\n") is .Err(error) then
		return .Some("\(why)\n  and `\(new)` cannot be written: \(error)")
	return .Some("\(why)\n  what was found is in `\(new)`")
}

/// What follows a snapshot's header: the lines between the first two `---`
/// lines are about it, not of it. A file with no header is all body.
fn body(text: str): str = {
	val .Some(rest) = text.stripPrefix("---\n") else {
		return text
	}
	if rest.find("\n---\n") is .Some(at) then return rest[at + 5..]
	return text
}

fn normalized(text: str): String = text.trimEnd().replace("\r\n", "\n")

/// Where two texts part: the first line that differs, as each has it.
pub fn difference(held: str, found: str): String = {
	var heldLines = held.lines()
	var foundLines = found.lines()
	var line = 1
	var a = heldLines.next()
	var b = foundLines.next()
	while a == b && a.isSome() {
		line += 1
		a = heldLines.next()
		b = foundLines.next()
	}
	return "  line \(line):\n    snapshot: \(shown(a))\n    found:    \(shown(b))"
}

fn shown(line: Option<str>): String = match line {
	.Some(text) => "`\(text)`"
	.None => "(the end)"
}
