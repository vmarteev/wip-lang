// Values written to JSON and read back: every shape a format sees, a field
// the input lacks taking its default, a field the type lacks passed over, an
// `Option` left out, and what decoding refuses, with the format's error.

import std::bytes
import std::collections::{Map, Set}
import std::json

@derive(Encode, Decode, Eq)
struct Settings {
	volume: f32 = 0.8
	fullscreen: bool = false
	name: String
	bindings: Map<String, Key>
	scores: Vec<i64>
	nickname: Option<String>
}

@derive(Encode, Decode, Eq)
enum Key {
	Letter(char: char)
	Mouse(button: i64)
	Escape
}

@derive(Encode, Decode)
enum Tree {
	Leaf(value: i64)
	Node(left: own<Tree>, right: own<Tree>, weight: f64 = 1.5)
}

@derive(Encode, Decode, Eq)
struct Pair<T> {
	first: T
	second: T
}

fn settings(): Settings = {
	var bindings: Map<String, Key> = Map()
	bindings.put("jump", .Letter(char: 'w'))
	bindings.put("fire", .Mouse(button: 1))
	bindings.put("menu", .Escape)
	return Settings(name: "ann", bindings:, scores: [3, 1, 4], nickname: .None)
}

@test
fn aRecordIsAnObjectOfItsFields() = {
	val written = json::encode(settings())
	assert(
		written ==
			"{\"volume\":0.8,\"fullscreen\":false,\"name\":\"ann\",\"bindings\":{\"jump\":{\"Letter\":{\"char\":\"w\"}},\"fire\":{\"Mouse\":{\"button\":1}},\"menu\":\"Escape\"},\"scores\":[3,1,4]}",
	)
	assert(json::decode<Settings>(written).unwrap() == settings(), "and it reads back")
}

@test
fn whatTheInputLacksTakesItsDefault() = {
	val read = json::decode<Settings>(
		"{\"name\": \"bo\", \"bindings\": {}, \"scores\": [], \"extra\": [1, 2]}",
	).unwrap()
	assert(read.volume == 0.8 && !read.fullscreen && read.nickname.isNone() && read.name == "bo")
	val named = json::decode<Settings>(
		"{\"name\": \"bo\", \"bindings\": {}, \"scores\": [], \"nickname\": \"b\"}",
	).unwrap()
	assert(named.nickname == String::of("b"))
}

@test
fn whatCannotBeReadSaysWhy() = {
	val missing = json::decode<Settings>("{\"bindings\": {}, \"scores\": []}")
	assert(missing is .Err(error) && error.message == "the object has no `name`")
	val unknown = json::decode<Key>("{\"Kick\": {}}")
	assert(unknown is .Err(error) && error.message == "`Kick` is no variant of `Key`")
	val wrong = json::decode<Settings>("{\"name\": 5, \"bindings\": {}, \"scores\": []}")
	assert(
		wrong is .Err(error) &&
			error.message == "at `name`: text is wanted, and the JSON has a number",
	)
	val large = json::decode<Vec<u8>>("[1, 256]")
	assert(large is .Err(error) && error.message.contains("not a u8"))
	assert(json::decode<i64>("{").isErr(), "text that is not JSON")
}

@test
fn everyShapeReadsBack() = {
	val numbers = Pair(first: -7 as i8, second: 120 as i8)
	assert(json::decode<Pair<i8>>(json::encode(&numbers)).unwrap() == numbers)
	val big: u64 = 18000000000000000000
	assert(json::decode<u64>(json::encode(&big)).unwrap() == big)
	val chars = Vec::of(['a', 'é', '😀'])
	assert(json::decode<Vec<char>>(json::encode(&chars)).unwrap() == chars)
	var counts: Map<i64, String> = Map()
	counts.put(3, "three")
	counts.put(-1, "minus one")
	val read = json::decode<Map<i64, String>>(json::encode(&counts)).unwrap()
	assert(read.len() == 2 && read.get(-1) == .Some(&String::of("minus one")))
	var seen: Set<String> = Set()
	seen.add("a")
	seen.add("b")
	assert(json::decode<Set<String>>(json::encode(&seen)).unwrap().contains("b"))
	val triple = (1, true, String::of("x"))
	val back = json::decode<(i64, bool, String)>(json::encode(&triple)).unwrap()
	assert(back.0 == 1 && back.1 && back.2 == "x")
	val four = (2, 'w', -1.5, String::of("four"))
	assert(json::encode(&four) == "[2,\"w\",-1.5,\"four\"]")
	val read4 = json::decode<(i64, char, f64, String)>(json::encode(&four)).unwrap()
	assert(read4 == four)
	assert(json::decode<(i64, i64, i64, i64)>("[1,2,3]").isErr())
	val maybe: Vec<Option<i64>> = [1, .None]
	assert(
		json::encode(&maybe) == "[1,null]" &&
			json::decode<Vec<Option<i64>>>("[1,null]").unwrap() == maybe,
	)
}

@test
fn aTreeOfOwnsReadsBack() = {
	val tree = Tree::Node(
		left: own .Leaf(value: 1),
		right: own .Node(left: own .Leaf(value: 2), right: own .Leaf(value: 3)),
	)
	val written = json::encode(&tree)
	val again = json::decode<Tree>(written).unwrap()
	assert(json::encode(&again) == written)
	val light = json::decode<Tree>(
		"{\"Node\": {\"left\": {\"Leaf\": {\"value\": 4}}, \"right\": {\"Leaf\": {\"value\": 5}}}}",
	).unwrap()
	assert(light is .Node(weight, ..) && weight == 1.5, "a variant's field takes its default too")
}

@test
fn aTreeOfJsonIsTheSameValue() = {
	val tree = json::toJson(Key::Mouse(button: 2))
	assert("\(tree)" == "{\"Mouse\":{\"button\":2}}")
	assert(json::fromJson<Key>(tree).unwrap() == .Mouse(button: 2))
}

@test
fn theBinaryFormatReadsBackWhatJsonDoes() = {
	val written = bytes::encode(settings())
	assert(bytes::decode<Settings>(&written.items()).unwrap() == settings())
	assert(written.len() < json::encode(settings()).len(), "in less room than its text")
	val tree = Tree::Node(left: own .Leaf(value: 1), right: own .Leaf(value: 2))
	val again = bytes::decode<Tree>(&bytes::encode(&tree).items()).unwrap()
	assert(json::encode(&again) == json::encode(&tree))
}

/// What a save looked like before a field was added and one taken away.
@derive(Encode)
struct OldSave {
	name: String
	gone: i64
}

@derive(Decode)
struct NewSave {
	name: String
	level: i64 = 1
}

@test
fn aSaveOfAnotherVersionLoads() = {
	val old = bytes::encode(OldSave(name: "ann", gone: 5))
	val loaded = bytes::decode<NewSave>(&old.items()).unwrap()
	assert(loaded.name == "ann" && loaded.level == 1, "a field passed over, and one its default")
	val cut = bytes::decode<NewSave>(&old.items()[0..old.len() - 3])
	assert(cut is .Err(error) && error.message.contains("the bytes end"))
}

/// A record whose field's value holds a variant, and one of its fields.
@derive(Encode)
struct Wider {
	first: Key
	second: Key
}

@derive(Decode)
struct Narrower {
	second: Key
}

@test
fn aNameIsWrittenOnce() = {
	val keys: Vec<Key> = [
		for n in 0..100 do
			yield Key::Mouse(button: n)
	]
	val written = bytes::encode(&keys)
	// `Mouse` and `button` spelled once each, and a byte or two where each
	// comes again.
	val text = str::fromBytes(&written.items())
	assert(text.split("Mouse").count() == 2 && text.split("button").count() == 2)
	assert(written.len() < 100 * 10, "\(written.len()) bytes")
	assert(bytes::decode<Vec<Key>>(&written.items()).unwrap() == keys)
}

@test
fn aNameMetInAValuePassedOverIsRead() = {
	// `Letter` and `char` are written in `first`, which `Narrower` passes
	// over, and `second` says where they were.
	val written = bytes::encode(Wider(first: .Letter(char: 'a'), second: .Letter(char: 'b')))
	val read = bytes::decode<Narrower>(&written.items()).unwrap()
	assert(read.second == .Letter(char: 'b'))
}

@test
fn bytesWrittenBeforeNamesWereWrittenOnceAreRead() = {
	// A record of `name: "ann"` and `level: 2`, each name in full, as the
	// format wrote it before: no first byte of its own.
	val before: Vec<u8> = [
		10,
		2,
		4,
		b'n',
		b'a',
		b'm',
		b'e',
		7,
		3,
		b'a',
		b'n',
		b'n',
		5,
		b'l',
		b'e',
		b'v',
		b'e',
		b'l',
		3,
		4,
	]
	val read = bytes::decode<NewSave>(&before.items()).unwrap()
	assert(read.name == "ann" && read.level == 2)
}

@test
fn aNameThatSaysItWasWhereNothingWasIsRefused() = {
	// The format's byte, a record of one field whose name says it was at
	// byte 9, after itself.
	val wrong: Vec<u8> = [12, 10, 1, 19, 7, 0]
	assert(
		bytes::decode<NewSave>(&wrong.items()) is .Err(error) &&
			error.message.contains("a name says"),
	)
}
