// What a slice and a vector make from their elements:
// Scala's vocabulary, eager, lent its function for the call; what keeps
// elements cloning them, values that own memory as plain data.

@test
fn aSliceMapsFiltersAndFolds() = {
	val numbers = [3, 1, 4, 1, 5, 9, 2, 6]
	assert(numbers.map((n) => n * 10) == [30, 10, 40, 10, 50, 90, 20, 60])
	assert(numbers.filter((n) => n % 2 == 0) == [4, 2, 6])
	assert(numbers.fold(0, (sum, n) => sum + n) == 31)
	assert(numbers.flatMap((n) => Vec::of([n, n])).len() == 16)
	val (evens, odds) = numbers.partition((n) => n % 2 == 0)
	assert(evens == [4, 2, 6] && odds == [3, 1, 1, 5, 9])
}

@test
fn aSliceFindsAndAnswersItsEnds() = {
	val numbers = [3, 1, 4, 1, 5]
	assert(numbers.find((n) => n > 3) == .Some(&4))
	assert(numbers.find((n) => n > 9).isNone())
	assert(numbers.indexWhere((n) => n > 3) == .Some(2))
	assert(numbers.lastIndexWhere((n) => n < 4) == .Some(3), "from the end")
	assert(numbers.lastIndexWhere((n) => n > 9).isNone())
	assert(numbers.lastIndexOf(1) == .Some(3) && numbers.indexOf(1) == .Some(1))
	assert(numbers.lastIndexOf(9).isNone())
	assert(numbers.first() == .Some(&3) && numbers.last() == .Some(&5))
	assert(numbers.min() == .Some(1) && numbers.max() == .Some(5))
	val empty: Vec<i64> = Vec()
	assert(empty.first().isNone() && empty.last().isNone() && empty.min().isNone())
}

@test
fn aLookupAnswersAnyElementByReference() = {
	var words: Vec<String> = Vec()
	words.push("one")
	words.push("three")
	val .Some(long) = words.find((w) => w.len() > 3) else {
		assert(false, "a long word")
		return
	}
	assert(long == "three", "the element itself, not a copy")
	val one = String::of("one")
	val three = String::of("three")
	assert(words.first() == .Some(&one) && words.last() == .Some(&three))
}

@test
fn takeAndSkipAreViewsOfTheSlice() = {
	val numbers = [1, 2, 3, 4, 5]
	assert(numbers.take(2).len() == 2 && numbers.skip(2).len() == 3)
	assert(numbers.take(9).len() == 5, "all of them, where there are fewer")
	assert(numbers.skip(9).len() == 0 && numbers.skip(-1).len() == 5)
	var total = 0
	for n in numbers.skip(3) {
		total += n
	}
	assert(total == 9)
}

@test
fn aSliceOfTextJoins() = {
	val words = ["a", "b", "c"]
	assert(words.join(", ") == "a, b, c")
	val none: Vec<str> = Vec()
	assert(none.join(", ") == "")
	assert([1, 2, 3].join("+") == "1+2+3")
}

@test
fn aVectorOfValuesThatOwnMemoryMapsAndFolds() = {
	var names: Vec<String> = Vec()
	names.push("one")
	names.push("three")
	assert(names.map((name) => name.len()) == [3, 5])
	assert(names.fold(0, (sum, name) => sum + name.len()) == 8)
	assert(names.indexWhere((name) => name.len() > 3) == .Some(1))
	assert(names.lastIndexWhere((name) => name.len() == 3) == .Some(0))
	assert(names.lastIndexOf(String::of("three")) == .Some(1))
	assert(names.join(" ") == "one three")
	assert(names.flatMap((name) => name.chars().toVec()).len() == 8)
}

@test
fn aSequenceIsJoinedOntoTextThereIs() = {
	var out = String::of("[")
	[1, 2, 3].joinTo(&var out, ", ")
	out.push("]")
	assert(out == "[1, 2, 3]", "written onto what was there")
	var words = String()
	Vec::of(["a", "b"]).joinTo(&var words, "-")
	assert(words == "a-b")
	var pairs = String()
	[(1, 2), (3, 4)].joinToBy(&var pairs, ";", (pair, out) => out.push("\(pair.0)=\(pair.1)"))
	assert(pairs == "1=2;3=4", "each written as it is told")
	var none = String()
	val empty: Vec<i64> = Vec()
	empty.joinTo(&var none, ", ")
	assert(none.isEmpty())
}

/// Counts what a closure that writes is given.
struct Tally {
	calls: i64 = 0
}

extend Tally {
	var fn seen(n: i64): i64 = {
		self.calls += 1
		return n
	}
}

@test
fn aSlicesFunctionsTakeAClosureThatWrites() = {
	val numbers = [3, 1, 4]
	var tally = Tally()
	assert(numbers.map((n) => tally.seen(n) * 2) == [6, 2, 8])
	assert(numbers.flatMap((n) => Vec::of([tally.seen(n)])).len() == 3)
	assert(numbers.fold(0, (sum, n) => sum + tally.seen(n)) == 8)
	assert(numbers.filter((n) => tally.seen(n) > 1) == [3, 4])
	val (big, small) = numbers.partition((n) => tally.seen(n) > 2)
	assert(big == [3, 4] && small == [1])
	assert(numbers.find((n) => tally.seen(n) == 4) == .Some(&4))
	assert(numbers.indexWhere((n) => tally.seen(n) == 1) == .Some(1))
	assert(numbers.any((n) => tally.seen(n) == 4) && numbers.all((n) => tally.seen(n) > 0))
	assert(numbers.countWhere((n) => tally.seen(n) > 1) == 2)
	assert(numbers.minBy((n) => tally.seen(n)) == .Some(&1))
	assert(numbers.maxBy((n) => tally.seen(n)) == .Some(&4))
	assert(tally.calls == 35)
	val listed: Vec<i64> = [3, 1, 4]
	assert(listed.map((n) => tally.seen(n)) == [3, 1, 4] && tally.calls == 38)
}

@derive(Eq, Clone)
struct Said {
	who: String
	loud: bool
}

@test
fn whatKeepsElementsClonesThemWhateverTheyOwn() = {
	val said = Vec::of([
		Said(who: String::of("Pebble"), loud: true),
		Said(who: String::of("Glint"), loud: false),
		Said(who: String::of("Bolt"), loud: true),
	])
	val loud = said.filter((s) => s.loud)
	assert(loud.len() == 2 && loud[0].who == "Pebble" && loud[1].who == "Bolt")
	val (yes, no) = said.partition((s) => s.who.len() > 4)
	assert(yes.len() == 2 && no.len() == 1 && no[0].who == "Bolt")
	// What was filtered is as it was, its own.
	assert(said.len() == 3 && said[1].who == "Glint")
	val names = said.map((s) => s.who.clone())
	assert(names.min() == .Some(String::of("Bolt")) && names.max() == .Some(String::of("Pebble")))
}

@test
fn anArrayMapsToAnArrayOfItsLength() = {
	val tens: [i64; 3] = [1, 2, 3].map((n) => n * 10)
	assert(tens == [10, 20, 30])
	val named = [1, 2].map((n) => "n\(n)")
	assert(named.len() == 2 && named[0] == "n1" && named[1] == "n2", "what owns memory too")
	val numbers = [1, 2, 3]
	val part = numbers[0..2].map((n) => n + 1)
	val walked = numbers.copies().map((n) => n + 1).toVec()
	assert(part.len() == 2 && walked[2] == 4, "a slice's map answers a vector, as before")
}
