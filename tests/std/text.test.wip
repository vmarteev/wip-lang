// `str` and `String`: what a text says about itself, what a `String` built at
// run time holds, and what reading a number out of a text answers when the text
// is not one.

@test
fn textAnswersAboutItself() = {
	val text = "hello, world"
	assert(text.len() == 12, "a length in bytes")
	assert(!text.isEmpty())
	assert("".isEmpty())
	assert(text.startsWith("hello"))
	assert(!text.startsWith("world"))
	assert(text.endsWith("world"))
	assert(text.contains("o, w"))
	assert(!text.contains("xyz"))
	assert(text.find("world") == .Some(7), "where a piece begins")
	assert(text.find("nowhere").isNone())
	assert(text.find("") == .Some(0), "the empty text is at the start")
}

@test
fn textTrims() = {
	assert("  padded  ".trim() == "padded")
	assert("  padded  ".trimStart() == "padded  ")
	assert("  padded  ".trimEnd() == "  padded")
	assert("\t\n mixed \r\n".trim() == "mixed", "every kind of space")
	assert("\u{b}\u{c}form\u{c}".trim() == "form", "and the vertical tab and the form feed")
	assert("   ".trim() == "", "a text of spaces trims to nothing")
	assert("none".trim() == "none")
}

@test
fn textSplits() = {
	var pieces: Vec<str> = Vec()
	for piece in "a,b,,c".split(",") {
		pieces.push(piece)
	}
	assert(pieces == Vec::of(own ["a", "b", "", "c"]), "the pieces between each separator")

	var whole: Vec<str> = Vec()
	for piece in "abc".split(",") {
		whole.push(piece)
	}
	assert(whole == Vec::of(own ["abc"]), "a text with no separator is one piece")

	var lines: Vec<str> = Vec()
	for line in "first\nsecond\r\nthird\n".lines() {
		lines.push(line)
	}
	assert(lines == Vec::of(own ["first", "second", "third"]), "each line without its break")

	var none: Vec<str> = Vec()
	for line in "".lines() {
		none.push(line)
	}
	assert(none.isEmpty(), "the empty text has no lines")
}

@test
fn stringGrowsAsItIsPushedInto() = {
	var built = String()
	assert(built.isEmpty() && built.len() == 0)
	built.push("one")
	built.push(" ")
	built.push("two")
	assert(built == "one two")
	assert(built.len() == 7)
	built.pushInt(-42)
	built.pushBool(true)
	built.pushChar('!')
	assert(built == "one two-42true!", "numbers, answers and characters, as text")
	built.clear()
	assert(built.isEmpty(), "and it is usable after clearing")
	built.push("again")
	assert(built == "again")
}

// The text built so far taken, and the next begun in the same `String`.
@test
fn stringTakenLeavesItEmpty() = {
	var line = String::of("first")
	val done = line.takeAll()
	assert(done == "first" && line.isEmpty())
	line.push("second")
	assert(line == "second")
}

@test
fn stringHoldsWhatIsPushedManyTimes() = {
	var built = String()
	for n in 0..1000 {
		built.push("ab")
	}
	assert(built.len() == 2000, "every push survives the growing")
	assert(built.toStr().startsWith("abab") && built.toStr().endsWith("abab"))
}

@test
fn stringIsBuiltByInterpolation() = {
	val count = 3
	val name = "balls"
	val built = "\(count) \(name), \(count * 2) halves"
	assert(built == "3 balls, 6 halves", "the pieces and the values between them")
	val nested = "outer \("inner \(count)") end"
	assert(nested == "outer inner 3 end")
}

@test
fn textReadsNumbers() = {
	assert("42".toInt() == .Ok(42))
	assert("-42".toInt() == .Ok(-42))
	assert("+7".toInt() == .Ok(7))
	assert("ff".toInt(radix: 16) == .Ok(255))
	assert("1010".toInt(radix: 2) == .Ok(10))
	assert(
		"-9223372036854775808".toInt() == .Ok(-9223372036854775807 - 1),
		"the most negative number",
	)
	assert("3.5".toFloat() == .Ok(3.5))
	assert("-0.25".toFloat() == .Ok(-0.25))
}

@test
fn textRefusesWhatIsNotANumber() = {
	// Each answers which way the text was not a number.
	assert("".toInt() == .Err(.Empty), "the empty text is no number")
	assert("abc".toInt() == .Err(.BadDigit(0)))
	assert("12a".toInt() == .Err(.BadDigit(2)), "nor a number with something after it")
	assert(" 12".toInt() == .Err(.BadDigit(0)), "spaces are not read: trim first")
	assert("9223372036854775808".toInt() == .Err(.TooLarge), "a number too large to hold")
	assert("2".toInt(radix: 2) == .Err(.BadDigit(0)), "a digit the radix does not have")
	assert("12".toInt(radix: 99) == .Err(.BadRadix(99)), "a radix there is no such thing as")
	assert("abc".toFloat().isErr())
}

@test
fn textWalksItsCharacters() = {
	var seen: Vec<char> = Vec()
	for c in "añ🙂".chars() {
		seen.push(c)
	}
	assert(seen.len() == 3, "a character is a scalar value, not a byte")
	assert(seen[0] == 'a' && seen[1] == 'ñ' && seen[2] == '🙂')
	assert("añ🙂".len() == 7, "while the length is in bytes")
}

@test
fn aPrefixOrASuffixIsTakenOffWhereItIs() = {
	assert("#define X".stripPrefix("#define ") == .Some("X"))
	assert("#undef X".stripPrefix("#define ").isNone())
	assert("abc".stripPrefix("") == .Some("abc"))
	assert("abc".stripPrefix("abcd").isNone())
	assert("shapes.h".stripSuffix(".h") == .Some("shapes"))
	assert("shapes.c".stripSuffix(".h").isNone())
	assert("abc".stripSuffix("abc") == .Some(""))
}

@test
fn aTextIsSplitAtItsFirstSeparator() = {
	assert("NAME=a=b".splitOnce("=") == .Some(("NAME", "a=b")))
	assert("a, b, c".splitOnce(", ") == .Some(("a", "b, c")))
	assert("abc".splitOnce(",").isNone())
	assert("abc".splitOnce("") == .Some(("", "abc")))
	assert("=".splitOnce("=") == .Some(("", "")))
	// A `String` lends its text for them.
	val owned = "key: value"
	assert(owned.splitOnce(": ") == .Some(("key", "value")))
	assert(owned.stripPrefix("key") == .Some(": value"))
}

// From the end, a character taken off, and any case.
@test
fn textIsSearchedFromTheEnd() = {
	val path = "a/b/c.tar.gz"
	assert(path.findLast("/") == .Some(3))
	assert(path.findLast(".") == .Some(9))
	assert(path.findLast("a") == .Some(7))
	assert(path.findLast("x").isNone())
	assert(path.findLast("") == .Some(12), "the empty text is at the end")
	assert("ab".findLast("abc").isNone(), "a needle longer than the text")
	assert("aaa".findLast("aa") == .Some(1))
	assert(String::of("a.b.c").findLast(".") == .Some(3), "a String lends its text")
}

@test
fn aCharacterIsTakenOffTheEnd() = {
	var text = String::of("añ🦀")
	assert(text.popChar() == .Some('🦀'), "a character of four bytes")
	assert(text == "añ")
	assert(text.popChar() == .Some('ñ'))
	assert(text.popChar() == .Some('a'))
	assert(text.popChar().isNone() && text.isEmpty())
	// Bytes that are no character's are taken one at a time, as U+FFFD,
	// as reading the text finds them.
	var broken = String::of("a")
	broken.pushByte(0x80)
	broken.pushByte(0x80)
	assert(broken.popChar() == .Some('\u{FFFD}') && broken.len() == 2)
	assert(broken.popChar() == .Some('\u{FFFD}') && broken == "a")
	assert(broken.popChar() == .Some('a') && broken.isEmpty())
}

@test
fn textIsComparedInAnyCase() = {
	assert("Content-Length".equalsAnyCase("content-length"))
	assert("ΣΊΣΥΦΟΣ".equalsAnyCase("σίσυφος"), "folding, not lowering: σ and ς")
	assert("Straẞe".equalsAnyCase("straße"), "lengths in bytes may differ")
	assert(!"abc".equalsAnyCase("abd"))
	assert(!"abc".equalsAnyCase("ab"))
	assert("".equalsAnyCase(""))
	assert("HOST".equalsAnyCase("host"))
}

// A prefix in any case, folded as `equalsAnyCase` folds; a text's ASCII
// letters in the other case, and every other byte as it was.
@test
fn aPrefixInAnyCaseAndAsciiCase() = {
	assert("Content-Type: text".startsWithAnyCase("content-type"))
	assert("ΣΊΣΥΦΟΣ".startsWithAnyCase("σί"), "folding, as for the whole")
	assert("abc".startsWithAnyCase(""), "every text begins with nothing")
	assert(!"Con".startsWithAnyCase("content"), "a prefix longer than the text")
	assert(!"Accept".startsWithAnyCase("accent"))
	assert("Héllo, World".toAsciiUpper() == "HéLLO, WORLD", "`é` is not ASCII")
	assert("HÉLLO, World".toAsciiLower() == "hÉllo, world")
	assert("".toAsciiLower() == "")
}

// The prelude's enums compare, hash and print.
@test
fn anOrderingComparesHashesAndPrints() = {
	assert(1.compare(2) == .Less)
	assert(2.compare(1) != .Less)
	assert("\(2.compare(2))" == ".Same")
	var seen: std::collections::Set<Ordering> = std::collections::Set()
	seen.add(1.compare(2))
	seen.add(3.compare(4))
	seen.add(5.compare(5))
	assert(seen.len() == 2)
	assert(Align::Center == .Center && Align::Left != .Right)
	assert("\(Align::Right)" == ".Right")
}

// A character's class, answered without the table for ASCII: each of the
// 128 as it should be, the ASCII-only classes beside them, and the table
// still asked past ASCII.
@test
fn asciiClassesAreAnsweredAsTheTableWould() = {
	for code in 0..128 {
		val c = code as u8 as char
		val small = code >= 97 && code <= 122
		val capital = code >= 65 && code <= 90
		val digit = code >= 48 && code <= 57
		assert(c.isLetter() == (small || capital), "\(code) a letter")
		assert(c.isNumeric() == digit, "\(code) a number")
		assert(c.isAlphanumeric() == (small || capital || digit), "\(code) either")
		assert(c.isAsciiAlphanumeric() == c.isAlphanumeric())
		assert(c.isAsciiUppercase() == capital && c.isAsciiLowercase() == small)
		val hex = digit || (code >= 97 && code <= 102) || (code >= 65 && code <= 70)
		assert(c.isHexDigit() == hex, "\(code) a hex digit")
	}
	assert('é'.isLetter() && 'é'.isAlphanumeric() && !'é'.isAsciiAlphanumeric())
	assert('٣'.isNumeric() && '٣'.isAlphanumeric() && !'٣'.isHexDigit())
	assert(!'—'.isAlphanumeric() && 'Ж'.isUppercase() && !'Ж'.isAsciiUppercase())
}

// A byte read as ASCII: each of the 256 as C's `<ctype.h>` answers in the C
// locale, the first 128 as `char` answers them, and none past 127.
@test
fn aByteIsAskedWhatItIsAsAsciiIs() = {
	for code in 0..256 {
		val b = code as u8
		val small = code >= 97 && code <= 122
		val capital = code >= 65 && code <= 90
		val digit = code >= 48 && code <= 57
		val printable = code >= 32 && code <= 126
		assert(b.isAscii() == (code < 128), "\(code) ASCII")
		assert(b.isDigit() == digit, "\(code) a digit")
		assert(b.isAsciiLetter() == (small || capital), "\(code) a letter")
		assert(b.isAsciiAlphanumeric() == (small || capital || digit), "\(code) either")
		assert(b.isAsciiUppercase() == capital && b.isAsciiLowercase() == small)
		assert(
			b.isAsciiWhitespace() == (code == 32 || (code >= 9 && code <= 13)),
			"\(code) a space",
		)
		assert(b.isAsciiPrintable() == printable, "\(code) printable")
		assert(
			b.isAsciiPunctuation() == (printable && code != 32 && !(small || capital || digit)),
			"\(code) punctuation",
		)
		if code < 128 {
			val c = b as char
			assert(b.isHexDigit() == c.isHexDigit(), "\(code) a hex digit")
			assert(b.isAsciiWhitespace() == c.isWhitespace(), "\(code) as `char` says")
			assert(
				b.toAsciiUpper() as char == c.toAsciiUpper() &&
					b.toAsciiLower() as char == c.toAsciiLower(),
			)
			assert(b.digitValue(36) == c.digitValue(36), "\(code) a digit's worth")
		} else {
			assert(!b.isHexDigit() && b.toAsciiUpper() == b && b.digitValue(36).isNone())
		}
	}
	assert(b'7'.digitValue() == .Some(7) && b'f'.digitValue(16) == .Some(15))
	assert(b'Z'.digitValue(36) == .Some(35) && b'8'.digitValue(8).isNone())
	assert('é'.digitValue().isNone() && 'B'.digitValue(16) == .Some(11))
}

// A pattern trimmed from either end as often as it is there; pieces from
// the end, at most so many, and the words; the last separator.
@test
fn textIsTrimmedAndTakenApartFromEitherEnd() = {
	assert("==title==".trimMatches("=") == "title" && "ab".trimMatches("ab") == "")
	assert("--name".trimStartMatches("-") == "name" && "a//".trimEndMatches("/") == "a")
	assert("xx".trimStartMatches("") == "xx", "an empty pattern takes nothing off")
	assert("abab-ab".trimStartMatches("ab") == "-ab")
	assert("a/b/c".rsplit("/").toVec() == Vec::of(own ["c", "b", "a"]))
	assert("abc".rsplit(",").toVec() == Vec::of(own ["abc"]) && ",".rsplit(",").count() == 2)
	assert("k=v=w".splitn(2, "=").toVec() == Vec::of(own ["k", "v=w"]))
	assert("k=v=w".splitn(5, "=").count() == 3 && "k=v".splitn(0, "=").count() == 0)
	assert("k=v".splitn(1, "=").toVec() == Vec::of(own ["k=v"]))
	assert("  a b\t\nc  ".splitWhitespace().toVec() == Vec::of(own ["a", "b", "c"]))
	assert("   ".splitWhitespace().count() == 0 && "a\u{3000}b".splitWhitespace().count() == 2)
	assert("a.tar.gz".rsplitOnce(".") == .Some(("a.tar", "gz")) && "none".rsplitOnce(".").isNone())
}

// A number of every width read from text, at its edges, and an integer
// written with its digits above 9 in upper case.
@test
fn widerNumbersAreReadAndDigitsWrittenInUpperCase() = {
	assert("18446744073709551615".toU64() == .Ok(18446744073709551615))
	assert("18446744073709551616".toU64() == .Err(.TooLarge))
	assert(
		"-1".toU64() == .Err(.BadDigit(0)) && "+7".toU64() == .Ok(7) && "".toU64() == .Err(.Empty),
	)
	assert("FFFFFFFFFFFFFFFF".toU64(radix: 16) == .Ok(18446744073709551615))
	val least: i128 = -170141183460469231731687303715884105727 - 1
	assert("-170141183460469231731687303715884105728".toI128() == .Ok(least))
	assert("170141183460469231731687303715884105728".toI128() == .Err(.TooLarge))
	val top: u128 = 340282366920938463463374607431768211455
	assert("340282366920938463463374607431768211455".toU128() == .Ok(top))
	assert("340282366920938463463374607431768211456".toU128() == .Err(.TooLarge))
	val text = String::of("99")
	assert(text.toU64() == .Ok(99) && text.toI128() == .Ok(99) && text.toU128() == .Ok(99))
	val byte: u8 = 0xAB
	assert("\(byte, radix: 16)" == "ab" && "\(byte, radix: 16, upper: true)" == "AB")
	assert("\(-255, radix: 16, upper: true, width: 5)" == "  -FF")
	assert("\(48879.inRadix(16, upper: true))" == "BEEF")
}
