// `str` and `String`: what a text says about itself, what a `String` built at
// run time holds, and what reading a number out of a text answers when the text
// is not one.

@test
fn textAnswersAboutItself() = {
    val text = "hello, world"
    assert(text.len() == 12, "a length in bytes")
    assert(!text.isEmpty())
    assert("".isEmpty())
    assert(text.startsWith("hello"))
    assert(!text.startsWith("world"))
    assert(text.endsWith("world"))
    assert(text.contains("o, w"))
    assert(!text.contains("xyz"))
    assert(text.find("world") == .Some(7), "where a piece begins")
    assert(text.find("nowhere").isNone())
    assert(text.find("") == .Some(0), "the empty text is at the start")
}

@test
fn textTrims() = {
    assert("  padded  ".trim() == "padded")
    assert("  padded  ".trimStart() == "padded  ")
    assert("  padded  ".trimEnd() == "  padded")
    assert("\t\n mixed \r\n".trim() == "mixed", "every kind of space")
    assert("   ".trim() == "", "a text of spaces trims to nothing")
    assert("none".trim() == "none")
}

@test
fn textSplits() = {
    var pieces: Vec<str> = Vec()
    for piece in "a,b,,c".split(",") {
        pieces.push(piece)
    }
    assert(pieces == Vec::of(own ["a", "b", "", "c"]), "the pieces between each separator")

    var whole: Vec<str> = Vec()
    for piece in "abc".split(",") {
        whole.push(piece)
    }
    assert(whole == Vec::of(own ["abc"]), "a text with no separator is one piece")

    var lines: Vec<str> = Vec()
    for line in "first\nsecond\r\nthird\n".lines() {
        lines.push(line)
    }
    assert(lines == Vec::of(own ["first", "second", "third"]), "each line without its break")

    var none: Vec<str> = Vec()
    for line in "".lines() {
        none.push(line)
    }
    assert(none.isEmpty(), "the empty text has no lines")
}

@test
fn stringGrowsAsItIsPushedInto() = {
    var built = String()
    assert(built.isEmpty() && built.len() == 0)
    built.push("one")
    built.push(" ")
    built.push("two")
    assert(built == "one two")
    assert(built.len() == 7)
    built.pushInt(-42)
    built.pushBool(true)
    built.pushChar('!')
    assert(built == "one two-42true!", "numbers, answers and characters, as text")
    built.clear()
    assert(built.isEmpty(), "and it is usable after clearing")
    built.push("again")
    assert(built == "again")
}

@test
fn stringHoldsWhatIsPushedManyTimes() = {
    var built = String()
    for n in 0..1000 {
        built.push("ab")
    }
    assert(built.len() == 2000, "every push survives the growing")
    assert(built.toStr().startsWith("abab") && built.toStr().endsWith("abab"))
}

@test
fn stringIsBuiltByInterpolation() = {
    val count = 3
    val name = "balls"
    val built = "\(count) \(name), \(count * 2) halves"
    assert(built == "3 balls, 6 halves", "the pieces and the values between them")
    val nested = "outer \("inner \(count)") end"
    assert(nested == "outer inner 3 end")
}

@test
fn textReadsNumbers() = {
    assert("42".toInt() == .Ok(42))
    assert("-42".toInt() == .Ok(-42))
    assert("+7".toInt() == .Ok(7))
    assert("ff".toInt(radix: 16) == .Ok(255))
    assert("1010".toInt(radix: 2) == .Ok(10))
    assert("-9223372036854775808".toInt() == .Ok(-9223372036854775807 - 1), "the most negative number")
    assert("3.5".toFloat() == .Ok(3.5))
    assert("-0.25".toFloat() == .Ok(-0.25))
}

@test
fn textRefusesWhatIsNotANumber() = {
    // Each answers which way the text was not a number.
    assert("".toInt() == .Err(.Empty), "the empty text is no number")
    assert("abc".toInt() == .Err(.BadDigit(at: 0)))
    assert("12a".toInt() == .Err(.BadDigit(at: 2)), "nor a number with something after it")
    assert(" 12".toInt() == .Err(.BadDigit(at: 0)), "spaces are not read: trim first")
    assert("9223372036854775808".toInt() == .Err(.TooLarge), "a number too large to hold")
    assert("2".toInt(radix: 2) == .Err(.BadDigit(at: 0)), "a digit the radix does not have")
    assert("12".toInt(radix: 99) == .Err(.BadRadix(radix: 99)), "a radix there is no such thing as")
    assert("abc".toFloat().isErr())
}

@test
fn textWalksItsCharacters() = {
    var seen: Vec<char> = Vec()
    for c in "añ🙂".chars() {
        seen.push(c)
    }
    assert(seen.len() == 3, "a character is a scalar value, not a byte")
    assert(seen[0] == 'a' && seen[1] == 'ñ' && seen[2] == '🙂')
    assert("añ🙂".len() == 7, "while the length is in bytes")
}

@test
fn aPrefixOrASuffixIsTakenOffWhereItIs() = {
	assert("#define X".stripPrefix("#define ") == .Some("X"))
	assert("#undef X".stripPrefix("#define ").isNone())
	assert("abc".stripPrefix("") == .Some("abc"))
	assert("abc".stripPrefix("abcd").isNone())
	assert("shapes.h".stripSuffix(".h") == .Some("shapes"))
	assert("shapes.c".stripSuffix(".h").isNone())
	assert("abc".stripSuffix("abc") == .Some(""))
}

@test
fn aTextIsSplitAtItsFirstSeparator() = {
	assert("NAME=a=b".splitOnce("=") == .Some(("NAME", "a=b")))
	assert("a, b, c".splitOnce(", ") == .Some(("a", "b, c")))
	assert("abc".splitOnce(",").isNone())
	assert("abc".splitOnce("") == .Some(("", "abc")))
	assert("=".splitOnce("=") == .Some(("", "")))
	// A `String` lends its text for them.
	val owned = String::of("key: value")
	assert(owned.splitOnce(": ") == .Some(("key", "value")))
	assert(owned.stripPrefix("key") == .Some(": value"))
}

// From the end, a character taken off, and any case.
@test
fn textIsSearchedFromTheEnd() = {
	val path = "a/b/c.tar.gz"
	assert(path.findLast("/") == .Some(3))
	assert(path.findLast(".") == .Some(9))
	assert(path.findLast("a") == .Some(7))
	assert(path.findLast("x").isNone())
	assert(path.findLast("") == .Some(12), "the empty text is at the end")
	assert("ab".findLast("abc").isNone(), "a needle longer than the text")
	assert("aaa".findLast("aa") == .Some(1))
	assert(String::of("a.b.c").findLast(".") == .Some(3), "a String lends its text")
}

@test
fn aCharacterIsTakenOffTheEnd() = {
	var text = String::of("añ🦀")
	assert(text.popChar() == .Some('🦀'), "a character of four bytes")
	assert(text == "añ")
	assert(text.popChar() == .Some('ñ'))
	assert(text.popChar() == .Some('a'))
	assert(text.popChar().isNone() && text.isEmpty())
	// Bytes that are no character's are taken one at a time, as U+FFFD,
	// as reading the text finds them.
	var broken = String::of("a")
	broken.pushByte(0x80)
	broken.pushByte(0x80)
	assert(broken.popChar() == .Some('\u{FFFD}') && broken.len() == 2)
	assert(broken.popChar() == .Some('\u{FFFD}') && broken == "a")
	assert(broken.popChar() == .Some('a') && broken.isEmpty())
}

@test
fn textIsComparedInAnyCase() = {
	assert("Content-Length".equalsAnyCase("content-length"))
	assert("ΣΊΣΥΦΟΣ".equalsAnyCase("σίσυφος"), "folding, not lowering: σ and ς")
	assert("Straẞe".equalsAnyCase("straße"), "lengths in bytes may differ")
	assert(!"abc".equalsAnyCase("abd"))
	assert(!"abc".equalsAnyCase("ab"))
	assert("".equalsAnyCase(""))
	assert(String::of("HOST").equalsAnyCase("host"))
}

// The prelude's enums compare, hash and print.
@test
fn anOrderingComparesHashesAndPrints() = {
	assert(1.compare(2) == .Less)
	assert(2.compare(1) != .Less)
	assert("\(2.compare(2))" == ".Same")
	var seen: std::collections::Set<Ordering> = std::collections::Set()
	seen.add(1.compare(2))
	seen.add(3.compare(4))
	seen.add(5.compare(5))
	assert(seen.len() == 2)
	assert(Align::Center == .Center && Align::Left != .Right)
	assert("\(Align::Right)" == ".Right")
}
