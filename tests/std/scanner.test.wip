// `std::text::Scanner`: a text read from the front by byte position; what
// each operation does at the end and past it, a token kept while reading
// goes on, a position set back, characters read, looked ahead at and taken
// as bytes are, and a line and a column worked out over line breaks and
// characters of more than one byte.

import std::text::{Scanner}

@test
fn aScannerReadsBytesAndSaysWhereTheEndIs() = {
	var s = Scanner::of("ab")
	assert(!s.isAtEnd() && s.peek() == b'a' && s.peekAt(1) == b'b')
	assert(
		s.peekAt(2).isNone() && s.peekAt(-1).isNone(),
		"nothing before the start or past the end",
	)
	assert(s.next() == b'a' && s.at == 1)
	assert(s.next() == b'b' && s.isAtEnd())
	assert(
		s.peek().isNone() && s.next().isNone() && s.at == 2,
		"the end is nothing, and reading stays there",
	)
	val empty = Scanner::of("")
	assert(empty.isAtEnd() && empty.peek().isNone() && empty.rest() == "")
}

@test
fn aScannerTakesOnlyWhatIsExpected() = {
	var s = Scanner::of("==>")
	assert(!s.take(b'>') && s.at == 0, "what is not next is not taken")
	assert(s.takeText("==") && s.at == 2)
	assert(!s.takeText(">>") && s.at == 2, "nor is text that is only begun")
	assert(s.take(b'>') && s.isAtEnd())
	assert(!s.take(b'>') && !s.takeText("x") && s.takeText(""), "at the end only nothing is there")
}

@test
fn aScannerTakesTextInAnyCase() = {
	var s = Scanner::of("NEWLINE Space")
	assert(s.takeTextAnyCase("newline") && s.at == 7)
	assert(!s.takeTextAnyCase("space") && s.at == 7, "what is not next is not taken")
	s.next()
	assert(!s.takeTextAnyCase("spaces") && s.at == 8, "nor is text that is only begun")
	assert(s.takeTextAnyCase("SPACE") && s.isAtEnd())
	assert(s.takeTextAnyCase("") && !s.takeTextAnyCase("x"), "at the end only nothing is there")
	var kelvin = Scanner::of("\u{212A}m!")
	assert(
		kelvin.takeTextAnyCase("km") && kelvin.at == 4,
		"the Kelvin sign folds as `k`, and is three bytes",
	)
	var other = Scanner::of("km")
	assert(other.takeTextAnyCase("\u{212A}M") && other.isAtEnd(), "and the other way round")
}

@test
fn aScannerSkipsAndTakesWhileATestHolds() = {
	var s = Scanner::of("  width2 = 640;")
	s.skipWhile((b) => b == b' ')
	val name = s.takeWhile((b) => b.isAsciiAlphanumeric())
	assert(name == "width2")
	assert(s.takeWhile((b) => b.isDigit()) == "", "nothing passed over is an empty text")
	s.skipWhile((b) => b == b' ' || b == b'=')
	val start = s.at
	s.skipWhile((b) => b.isDigit())
	assert(s.since(start).toInt() == 640 && s.rest() == ";")
	s.skipWhile((_) => true)
	assert(s.isAtEnd() && s.takeWhile((_) => true) == "")
}

@test
fn aTokenIsKeptWhileReadingGoesOn() = {
	var s = Scanner::of("let x")
	val keyword = s.takeWhile((b) => b.isAsciiLetter())
	s.skipWhile((b) => b == b' ')
	val name = s.takeWhile((b) => b.isAsciiLetter())
	assert(keyword == "let" && name == "x", "what was taken borrows the text, not the scanner")
}

@test
fn aScannerSetBackReadsAgain() = {
	var s = Scanner::of("12.x")
	val start = s.at
	s.skipWhile((b) => b.isDigit())
	// `12.` with no digit after the point is not a number with a fraction:
	// read again from the start, as a whole number.
	val whole = s.at
	assert(s.take(b'.') && !(s.peek() is .Some(b'0'..=b'9')))
	s.at = start
	s.skipWhile((b) => b.isDigit())
	assert(s.at == whole && s.since(start) == "12" && s.rest() == ".x")
}

@test
fn aScannerReadsCharactersWhereAsked() = {
	var s = Scanner::of("né!")
	assert(s.nextChar() == 'n' && s.peekChar() == 'é')
	assert(s.nextChar() == 'é' && s.at == 3, "a character of two bytes moves on by two")
	assert(s.nextChar() == '!' && s.nextChar().isNone() && s.peekChar().isNone())
	val broken: [u8; 2] = [0xFF, b'a']
	var bytes = Scanner::of(str::fromBytes(&broken))
	assert(
		bytes.nextChar() == '\u{FFFD}' && bytes.at == 1,
		"a byte that is not UTF-8 is U+FFFD, and one byte",
	)
	assert(bytes.nextChar() == 'a')
}

@test
fn aScannerLooksAheadByCharacters() = {
	var s = Scanner::of("né.!")
	assert(s.peekCharAt(0) == 'n' && s.peekCharAt(1) == 'é' && s.peekCharAt(2) == '.')
	assert(s.peekCharAt(3) == '!' && s.at == 0, "looking ahead moves nothing")
	assert(
		s.peekCharAt(4).isNone() && s.peekCharAt(-1).isNone(),
		"nothing past the end, nor before",
	)
	s.nextChar()
	assert(s.peekCharAt(1) == '.', "`é` is two bytes and one character")
	s.at = 4
	assert(s.peekCharAt(-1).isNone(), "nor behind, in characters")
	val broken: [u8; 3] = [0xC3, b'a', b'b']
	val bytes = Scanner::of(str::fromBytes(&broken))
	assert(bytes.peekCharAt(1) == 'a', "a byte that is not UTF-8 is a character of one byte")
}

@test
fn aScannerTakesOnlyTheCharacterExpected() = {
	var s = Scanner::of("é@")
	assert(!s.takeChar('e') && s.at == 0, "what is not next is not taken")
	assert(s.takeChar('é') && s.at == 2)
	assert(s.takeChar('@') && s.isAtEnd())
	assert(!s.takeChar('@') && s.at == 3, "at the end nothing is taken")
}

@test
fn aScannerSkipsAndTakesCharactersWhileATestHolds() = {
	var s = Scanner::of("  añob-2 → x")
	s.skipWhileChar((c) => c.isWhitespace())
	val name = s.takeWhileChar((c) => c.isLetter())
	assert(name == "añob" && s.at == 7)
	assert(s.takeWhileChar((c) => c.isLetter()) == "", "nothing passed over is an empty text")
	s.skipWhileChar((c) => c != '→')
	assert(s.takeChar('→') && s.rest() == " x")
	s.skipWhileChar((_) => true)
	assert(s.isAtEnd() && s.takeWhileChar((_) => true) == "")
}

@test
fn aPositionIsALineAndAColumnInCharacters() = {
	val s = Scanner::of("ab\nné x\n\nz")
	val first = s.positionAt(0)
	assert(first.line == 1 && first.column == 1)
	val second = s.positionAt(4)
	assert(second.line == 2 && second.column == 2)
	val space = s.positionAt(6)
	assert(space.line == 2 && space.column == 3, "`é` is two bytes and one column")
	val last = s.positionAt(10)
	assert(last.line == 4 && last.column == 1)
	val past = s.positionAt(99)
	assert(past.line == 4 && past.column == 2, "past the end is the end")
	assert("\(first)" == "Position(line: 1, column: 1)")
}

@test
fn aPositionWithNoByteIsWhatIsReadNext() = {
	var s = Scanner::of("ab\nné x")
	assert(s.position() == s.positionAt(0))
	s.skipWhileChar((c) => c != ' ')
	assert(s.position() == s.positionAt(6) && s.position().column == 3)
}
