// `std::time`: lengths of time, a clock that only goes
// forward, and waiting on it; the date it is, and a calendar's moments, in
// UTC and in the zone the program runs in.

import std::io
import std::time
import std::time::{Duration, Instant, Local, Utc, sleep}

extern "C" {
	fn setenv(name: cstring, value: cstring, overwrite: c_int): c_int
	fn unsetenv(name: cstring): c_int
}

@test
fn lengthsAreMadeInEachUnitAndReadBackInAny() = {
	assert(Duration::seconds(2) == Duration::millis(2000))
	assert(Duration::millis(3) == Duration::micros(3000))
	assert(Duration::micros(4) == Duration::nanos(4000))
	assert(Duration::millis(1500).asSeconds() == 1.5)
	assert(Duration::micros(2500).asMillis() == 2, "the rest left out")
	assert(Duration::seconds(1).asNanos() == 1000000000)
}

@test
fn lengthsAddSubtractAndCompare() = {
	val sum = Duration::millis(1) + Duration::micros(500)
	assert(sum.asMicros() == 1500)
	assert(Duration::seconds(1) - Duration::millis(250) == Duration::millis(750))
	assert(Duration::millis(1) < Duration::seconds(1))
	assert(
		Duration::nanos(0).isZero() &&
			Duration::millis(-1).isZero() &&
			!Duration::nanos(1).isZero(),
	)
}

@test
fn aLengthIsWrittenInTheLargestUnitItFills() = {
	assert("\(Duration::millis(250))" == "250ms")
	assert("\(Duration::millis(1500))" == "1.5s")
	assert("\(Duration::micros(1250))" == "1.25ms")
	assert("\(Duration::micros(1005))" == "1.005ms")
	assert("\(Duration::nanos(12))" == "12ns")
	assert("\(Duration::micros(3))" == "3µs")
	assert("\(Duration::seconds(2))" == "2s")
	assert("\(Duration::millis(-5))" == "-5ms")
}

@test
fn theClockGoesForwardAndASleepWaitsAtLeastItsLength() = {
	val start = Instant::now()
	sleep(Duration::millis(20))
	val later = Instant::now()
	assert(later > start)
	assert(later.since(&start) >= Duration::millis(20))
	assert(start.elapsed() >= Duration::millis(20))
	assert(start.since(&later) < Duration::nanos(0), "the other way is negative")
	assert(start.after(Duration::seconds(1)).since(&start) == Duration::seconds(1))
	val earlier = start.before(Duration::millis(3))
	assert(start.since(&earlier) == Duration::millis(3))
}

@test
fn noTimeAtAllIsNoWait() = {
	val start = Instant::now()
	sleep(Duration::nanos(0))
	sleep(Duration::millis(-3))
	assert(start.elapsed() < Duration::millis(20))
}

@test
fn theClockIsAfterThisWasWritten() = {
	assert(time::now() > 1780000000, "after this was written, in 2026")
}

@test
fn aMomentIsItsSecondsAsACalendarHasThem() = {
	val epoch = Utc::of(0)
	assert(epoch.year() == 1970 && epoch.month() == 1 && epoch.day() == 1)
	assert(epoch.hour() == 0 && epoch.minute() == 0 && epoch.second() == 0)
	assert(epoch.weekday() == 4, "a Thursday")
	// RFC 9110's example.
	val example = Utc::of(784111777)
	assert(example.year() == 1994 && example.month() == 11 && example.day() == 6)
	assert(example.hour() == 8 && example.minute() == 49 && example.second() == 37)
	assert(example.weekday() == 0, "a Sunday")
	// The second before 1970.
	val before = Utc::of(-1)
	assert(before.year() == 1969 && before.month() == 12 && before.day() == 31)
	assert(before.hour() == 23 && before.minute() == 59 && before.second() == 59)
	assert(before.weekday() == 3)
}

@test
fn leapYearsAndCenturiesAreCounted() = {
	// 2000 was a leap year, a century divisible by 400; 1900 and 2100 are not.
	assert(Utc::of(951782400).day() == 29, "the 29th of February 2000")
	assert(Utc::of(951782400).month() == 2)
	assert(
		Utc::of(4107542400).month() == 3 && Utc::of(4107542400).day() == 1,
		"the 1st of March 2100",
	)
	assert(Utc::of(4107542400 - 1).month() == 2 && Utc::of(4107542400 - 1).day() == 28)
	assert(Utc::of(-2203891200).year() == 1900 && Utc::of(-2203891200).month() == 3)
	assert(Utc::of(-2203891200 - 1).day() == 28)
	assert(Utc::of(946684800 - 1).year() == 1999 && Utc::of(946684800).year() == 2000)
}

@test
fn secondsComeBackFromTheCalendar() = {
	var seconds = -5000000000
	while seconds < 5000000000 {
		assert(Utc::of(seconds).seconds() == seconds)
		seconds += 86399 * 37
	}
	for seconds in [0, -1, 1, 784111777, 951782400, 4107542399, -2203891201] {
		assert(Utc::of(seconds).seconds() == seconds)
	}
}

@test
fn aMomentIsWrittenAsHttpAndIsoWriteIt() = {
	val example = Utc::of(784111777)
	assert(example.httpDate() == "Sun, 06 Nov 1994 08:49:37 GMT")
	assert(example.iso() == "1994-11-06T08:49:37Z")
	assert("\(Utc::of(0))" == "1970-01-01T00:00:00Z")
	assert(Utc::of(951782400).httpDate() == "Tue, 29 Feb 2000 00:00:00 GMT")
}

@test
fn anHttpDateIsReadBack() = {
	val .Some(read) = Utc::parseHttpDate("Sun, 06 Nov 1994 08:49:37 GMT") else {
		assert(false, "RFC 9110's example is read")
		return
	}
	assert(read.seconds() == 784111777)
	assert(read == Utc::of(784111777))
	assert(Utc::parseHttpDate(Utc::of(951782400).httpDate().toStr()) == .Some(Utc::of(951782400)))
	// The other forms HTTP once sent, and what is not a date.
	assert(Utc::parseHttpDate("Sunday, 06-Nov-94 08:49:37 GMT").isNone())
	assert(Utc::parseHttpDate("Sun Nov  6 08:49:37 1994").isNone())
	assert(Utc::parseHttpDate("Sun, 06 Nov 1994 08:49:37 UTC").isNone())
	assert(Utc::parseHttpDate("Sun, 06 Nov 1994 08:49:3 GMT").isNone())
	assert(Utc::parseHttpDate("Sun, 31 Nov 1994 08:49:37 GMT").isNone(), "November has 30 days")
	assert(Utc::parseHttpDate("Sun, 29 Feb 1900 08:49:37 GMT").isNone(), "1900 was not a leap year")
	assert(Utc::parseHttpDate("Sun, 06 Nov 1994 24:49:37 GMT").isNone())
	assert(Utc::parseHttpDate("Xyz, 06 Nov 1994 08:49:37 GMT").isNone())
	assert(Utc::parseHttpDate("Sun, 06 Nom 1994 08:49:37 GMT").isNone())
	assert(Utc::parseHttpDate("").isNone())
}

@test
fn momentsCompareInTheOrderTheyHappen() = {
	assert(Utc::of(0) < Utc::of(1))
	assert(Utc::of(-86400) < Utc::of(0))
	assert(Utc::of(784111777) > Utc::of(784111776))
}

/// `TZ` set to `zone`, a POSIX zone that needs no database: its name, how
/// far it is behind UTC, and when it keeps summer time.
fn setZone(zone: str) = {
	var value = String::of(zone)
	setenv("TZ", value.toCstring(), 1)
}

/// `TZ` as it was before a test set it.
fn restoreZone(before: Option<String>) = match before {
	.Some(zone) => setZone(zone.toStr())
	.None => { unsetenv("TZ") }
}

@test
fn aLocalMomentIsWhatTheZonesClocksRead() = {
	val before = io::env("TZ")
	// India's: five and a half hours ahead, all year.
	setZone("IST-5:30")
	val start = Local::of(0)
	assert(start.offset() == 19800 && start.zone() == "IST")
	assert(start.year() == 1970 && start.month() == 1 && start.day() == 1)
	assert(start.hour() == 5 && start.minute() == 30 && start.second() == 0)
	assert(start.iso() == "1970-01-01T05:30:00+05:30" && "\(start)" == start.iso())
	assert(start.utc() == Utc::of(0) && start.seconds() == 0)
	// An evening in UTC is the next morning there, a day further in the week.
	val evening = Local::of(1768507200)
	assert(evening.day() == 16 && evening.hour() == 1 && evening.minute() == 30)
	assert(evening.weekday() == 5 && Utc::of(1768507200).weekday() == 4)
	// California's, with summer time from March's second Sunday to
	// November's first: eight hours behind in winter, seven in summer.
	setZone("PST8PDT,M3.2.0,M11.1.0")
	val winter = Local::of(1768478400)
	assert(winter.offset() == -28800 && winter.zone() == "PST" && winter.hour() == 4)
	assert(winter.iso() == "2026-01-15T04:00:00-08:00")
	val summer = Local::of(1784116800)
	assert(summer.offset() == -25200 && summer.zone() == "PDT" && summer.hour() == 5)
	assert(summer.iso() == "2026-07-15T05:00:00-07:00")
	assert(winter < summer)
	restoreZone(move before)
}

@test
fn theMachinesZoneReadsAsUtcOfItsOffset() = {
	val now = time::now()
	val here = Local::of(now)
	val clock = Utc::of(now + here.offset())
	assert(here.utc() == Utc::of(now))
	assert(here.offset() >= -12 * 3600 && here.offset() <= 14 * 3600)
	assert(
		here.year() == clock.year() && here.month() == clock.month() && here.day() == clock.day(),
	)
	assert(here.hour() == clock.hour() && here.minute() == clock.minute())
	assert(here.weekday() == clock.weekday() && !here.zone().isEmpty())
}
