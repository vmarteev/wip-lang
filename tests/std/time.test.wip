// `std::time`: lengths of time, a clock that only goes
// forward, and waiting on it; the date it is, and a calendar's moments, in
// UTC and in the zone the program runs in.

import std::io
import std::time
import std::time::{Duration, Instant, Local, Utc, sleep}

@test
fn lengthsAreMadeInEachUnitAndReadBackInAny() = {
	assert(Duration::seconds(2) == Duration::millis(2000))
	assert(Duration::millis(3) == Duration::micros(3000))
	assert(Duration::micros(4) == Duration::nanos(4000))
	assert(Duration::millis(1500).asSeconds() == 1.5)
	assert(Duration::micros(2500).asMillis() == 2, "the rest left out")
	assert(Duration::seconds(1).asNanos() == 1000000000)
}

@test
fn lengthsAddSubtractAndCompare() = {
	val sum = Duration::millis(1) + Duration::micros(500)
	assert(sum.asMicros() == 1500)
	assert(Duration::seconds(1) - Duration::millis(250) == Duration::millis(750))
	assert(Duration::millis(1) < Duration::seconds(1))
	assert(
		Duration::nanos(0).isZero() &&
			Duration::millis(-1).isZero() &&
			!Duration::nanos(1).isZero(),
	)
}

@test
fn aLengthIsWrittenInTheLargestUnitItFills() = {
	assert("\(Duration::millis(250))" == "250ms")
	assert("\(Duration::millis(1500))" == "1.5s")
	assert("\(Duration::micros(1250))" == "1.25ms")
	assert("\(Duration::micros(1005))" == "1.005ms")
	assert("\(Duration::nanos(12))" == "12ns")
	assert("\(Duration::micros(3))" == "3µs")
	assert("\(Duration::seconds(2))" == "2s")
	assert("\(Duration::millis(-5))" == "-5ms")
}

@test
fn theClockGoesForwardAndASleepWaitsAtLeastItsLength() = {
	val start = Instant::now()
	sleep(Duration::millis(20))
	val later = Instant::now()
	assert(later > start)
	assert(later.since(&start) >= Duration::millis(20))
	assert(start.elapsed() >= Duration::millis(20))
	assert(start.since(&later) < Duration::nanos(0), "the other way is negative")
	assert(start.after(Duration::seconds(1)).since(&start) == Duration::seconds(1))
	val earlier = start.before(Duration::millis(3))
	assert(start.since(&earlier) == Duration::millis(3))
}

@test
fn noTimeAtAllIsNoWait() = {
	val start = Instant::now()
	sleep(Duration::nanos(0))
	sleep(Duration::millis(-3))
	assert(start.elapsed() < Duration::millis(20))
}

@test
fn theClockIsAfterThisWasWritten() = {
	assert(time::now() > 1780000000, "after this was written, in 2026")
}

@test
fn aMomentIsItsSecondsAsACalendarHasThem() = {
	val epoch = Utc::of(0)
	assert(epoch.year() == 1970 && epoch.month() == 1 && epoch.day() == 1)
	assert(epoch.hour() == 0 && epoch.minute() == 0 && epoch.second() == 0)
	assert(epoch.weekday() == 4, "a Thursday")
	// RFC 9110's example.
	val example = Utc::of(784111777)
	assert(example.year() == 1994 && example.month() == 11 && example.day() == 6)
	assert(example.hour() == 8 && example.minute() == 49 && example.second() == 37)
	assert(example.weekday() == 0, "a Sunday")
	// The second before 1970.
	val before = Utc::of(-1)
	assert(before.year() == 1969 && before.month() == 12 && before.day() == 31)
	assert(before.hour() == 23 && before.minute() == 59 && before.second() == 59)
	assert(before.weekday() == 3)
}

@test
fn leapYearsAndCenturiesAreCounted() = {
	// 2000 was a leap year, a century divisible by 400; 1900 and 2100 are not.
	val leap = Utc::at(year: 2000, month: 2, day: 29)
	assert(leap is .Some(day) && day.weekday() == 2, "a Tuesday")
	assert(leap == Utc::of(951782400))
	assert(Utc::at(year: 2100, month: 2, day: 29).isNone())
	assert(Utc::at(year: 1900, month: 2, day: 29).isNone())
	val end = Utc::at(year: 2100, month: 2, day: 28).unwrap()
	assert(end.addDays(1).month() == 3 && end.addDays(1).day() == 1, "the 1st of March 2100")
	val march = Utc::at(year: 1900, month: 3, day: 1).unwrap()
	assert(march.addDays(-1).day() == 28)
	val newYear = Utc::at(year: 2000, month: 1, day: 1).unwrap()
	assert(newYear.before(Duration::seconds(1)).year() == 1999)
}

@test
fn aMomentIsMadeFromItsDate() = {
	val example = Utc::at(year: 1994, month: 11, day: 6, hour: 8, minute: 49, second: 37)
	assert(example == Utc::of(784111777), "RFC 9110's example")
	assert(Utc::at(year: 1970, month: 1, day: 1) == Utc::of(0))
	assert(Utc::at(year: 1969, month: 12, day: 31, hour: 23, minute: 59, second: 59) == Utc::of(-1))
	val ancient = Utc::at(year: -44, month: 3, day: 15).unwrap()
	assert(ancient.year() == -44 && ancient.month() == 3 && ancient.day() == 15)
	assert(Utc::at(year: 12026, month: 1, day: 1).unwrap().year() == 12026)
	// What a calendar does not have.
	assert(Utc::at(year: 2026, month: 4, day: 31).isNone(), "April has 30 days")
	assert(Utc::at(year: 2026, month: 13, day: 1).isNone())
	assert(Utc::at(year: 2026, month: 0, day: 1).isNone())
	assert(Utc::at(year: 2026, month: 1, day: 0).isNone())
	assert(Utc::at(year: 2026, month: 1, day: 1, hour: 24).isNone())
	assert(Utc::at(year: 2026, month: 1, day: 1, minute: 60).isNone())
	assert(Utc::at(year: 2026, month: 1, day: 1, second: 60).isNone(), "no leap second")
	assert(Utc::at(year: 2026, month: 1, day: 1, hour: -1).isNone())
}

@test
fn secondsComeBackFromTheCalendar() = {
	var seconds = -5000000000
	while seconds < 5000000000 {
		assert(Utc::of(seconds).seconds() == seconds)
		seconds += 86399 * 37
	}
	for seconds in [0, -1, 1, 784111777, 951782400, 4107542399, -2203891201] do
		assert(Utc::of(seconds).seconds() == seconds)
}

@test
fn aMomentIsWrittenAsHttpAndIsoWriteIt() = {
	val example = Utc::of(784111777)
	assert(example.httpDate() == "Sun, 06 Nov 1994 08:49:37 GMT")
	assert(example.iso() == "1994-11-06T08:49:37Z")
	assert("\(Utc::of(0))" == "1970-01-01T00:00:00Z")
	assert(Utc::of(951782400).httpDate() == "Tue, 29 Feb 2000 00:00:00 GMT")
}

@test
fn anHttpDateIsReadBack() = {
	val .Some(read) = Utc::parseHttpDate("Sun, 06 Nov 1994 08:49:37 GMT") else {
		assert(false, "RFC 9110's example is read")
		return
	}
	assert(read.seconds() == 784111777)
	assert(read == Utc::of(784111777))
	assert(Utc::parseHttpDate(Utc::of(951782400).httpDate().toStr()) == Utc::of(951782400))
	// The other forms HTTP once sent, and what is not a date.
	assert(Utc::parseHttpDate("Sunday, 06-Nov-94 08:49:37 GMT").isNone())
	assert(Utc::parseHttpDate("Sun Nov  6 08:49:37 1994").isNone())
	assert(Utc::parseHttpDate("Sun, 06 Nov 1994 08:49:37 UTC").isNone())
	assert(Utc::parseHttpDate("Sun, 06 Nov 1994 08:49:3 GMT").isNone())
	assert(Utc::parseHttpDate("Sun, 31 Nov 1994 08:49:37 GMT").isNone(), "November has 30 days")
	assert(Utc::parseHttpDate("Sun, 29 Feb 1900 08:49:37 GMT").isNone(), "1900 was not a leap year")
	assert(Utc::parseHttpDate("Sun, 06 Nov 1994 24:49:37 GMT").isNone())
	assert(Utc::parseHttpDate("Xyz, 06 Nov 1994 08:49:37 GMT").isNone())
	assert(Utc::parseHttpDate("Sun, 06 Nom 1994 08:49:37 GMT").isNone())
	assert(Utc::parseHttpDate("").isNone())
}

@test
fn momentsCompareInTheOrderTheyHappen() = {
	assert(Utc::of(0) < Utc::of(1))
	assert(Utc::of(-86400) < Utc::of(0))
	assert(Utc::of(784111777) > Utc::of(784111776))
}

/// `TZ` set to `zone`, a POSIX zone that needs no database: its name, how
/// far it is behind UTC, and when it keeps summer time.
fn setZone(zone: str) = io::setEnv("TZ", zone)

/// `TZ` as it was before a test set it.
fn restoreZone(before: Option<String>) = match before {
	.Some(zone) => setZone(zone.toStr())
	.None => io::unsetEnv("TZ")
}

@test
fn aLocalMomentIsWhatTheZonesClocksRead() = {
	val before = io::env("TZ")
	// India's: five and a half hours ahead, all year.
	setZone("IST-5:30")
	val start = Local::of(0)
	assert(start.offset() == 19800 && start.zone() == "IST")
	assert(start.year() == 1970 && start.month() == 1 && start.day() == 1)
	assert(start.hour() == 5 && start.minute() == 30 && start.second() == 0)
	assert(start.iso() == "1970-01-01T05:30:00+05:30" && "\(start)" == start.iso())
	assert(start.utc() == Utc::of(0) && start.seconds() == 0)
	// An evening in UTC is the next morning there, a day further in the week.
	val evening = Local::of(1768507200)
	assert(evening.day() == 16 && evening.hour() == 1 && evening.minute() == 30)
	assert(evening.weekday() == 5 && Utc::of(1768507200).weekday() == 4)
	// California's, with summer time from March's second Sunday to
	// November's first: eight hours behind in winter, seven in summer.
	setZone("PST8PDT,M3.2.0,M11.1.0")
	val winter = Local::of(1768478400)
	assert(winter.offset() == -28800 && winter.zone() == "PST" && winter.hour() == 4)
	assert(winter.iso() == "2026-01-15T04:00:00-08:00")
	val summer = Local::of(1784116800)
	assert(summer.offset() == -25200 && summer.zone() == "PDT" && summer.hour() == 5)
	assert(summer.iso() == "2026-07-15T05:00:00-07:00")
	assert(winter < summer)
	restoreZone(before)
}

@test
fn theMachinesZoneReadsAsUtcOfItsOffset() = {
	val now = time::now()
	val here = Local::of(now)
	val clock = Utc::of(now + here.offset())
	assert(here.utc() == Utc::of(now))
	assert(here.offset() >= -12 * 3600 && here.offset() <= 14 * 3600)
	assert(
		here.year() == clock.year() && here.month() == clock.month() && here.day() == clock.day(),
	)
	assert(here.hour() == clock.hour() && here.minute() == clock.minute())
	assert(here.weekday() == clock.weekday() && !here.zone().isEmpty())
}

@test
fn anIsoMomentIsReadBack() = {
	val example = Utc::of(784111777)
	assert(Utc::parseIso("1994-11-06T08:49:37Z") == example)
	assert(Utc::parseIso("1994-11-06t08:49:37z") == example, "lower case")
	assert(Utc::parseIso("1994-11-06 08:49:37Z") == example, "a space for the T")
	assert(Utc::parseIso("1994-11-06T08:49:37.250Z") == example, "a fraction left out")
	assert(Utc::parseIso("1994-11-06T08:49:37.999999999Z") == example)
	assert(Utc::parseIso("1994-11-06T10:49:37+02:00") == example)
	assert(Utc::parseIso("1994-11-06T01:49:37-07:00") == example)
	assert(Utc::parseIso("1994-11-06T14:19:37.5+05:30") == example)
	assert(Utc::parseIso("1994-11-06T08:49:37-00:00") == example)
	// A date and an offset that cross a day, a month and a year.
	val turned = Utc::parseIso("2026-01-01T01:00:00+02:00").unwrap()
	assert(
		turned.year() == 2025 && turned.month() == 12 && turned.day() == 31 && turned.hour() == 23,
	)
	// What RFC 3339 does not write.
	for text in [
		"",
		"1994-11-06",
		"1994-11-06T08:49:37",
		"1994-11-06T08:49Z",
		"1994-W45-7T08:49:37Z",
		"94-11-06T08:49:37Z",
		"1994-11-06T08:49:60Z",
		"1994-11-06T24:49:37Z",
		"1994-11-31T08:49:37Z",
		"1900-02-29T08:49:37Z",
		"1994-13-06T08:49:37Z",
		"1994-11-06T08:49:37.Z",
		"1994-11-06T08:49:37Zjunk",
		"1994-11-06T08:49:37+0200",
		"1994-11-06T08:49:37+24:00",
		"1994-11-06T08:49:37+02:60",
		"1994-11-06T08:49:37+02:00 ",
		"1994-11-06X08:49:37Z",
		"1994/11/06T08:49:37Z",
		"1994-11-06T08:4a:37Z",
	] do
		assert(Utc::parseIso(text).isNone(), text)
}

@test
fn whatIsoWritesIsReadBack() = {
	var seconds = -5000000000
	while seconds < 5000000000 {
		val moment = Utc::of(seconds)
		assert(Utc::parseIso(moment.iso().toStr()) == moment)
		seconds += 86399 * 37
	}
	val now = time::now()
	assert(Utc::parseIso(Local::of(now).iso().toStr()) == Utc::of(now), "with the zone's offset")
}

@test
fn aMomentIsMovedAndMeasuredByALength() = {
	val start = Utc::of(784111777)
	assert(start.after(Duration::seconds(60)) == Utc::of(784111837))
	assert(start.before(Duration::seconds(60)) == Utc::of(784111717))
	assert(start.after(Duration::millis(1999)) == Utc::of(784111778), "the rest left out")
	assert(start.after(Duration::seconds(90)).since(&start) == Duration::seconds(90))
	assert(start.since(start.after(Duration::seconds(5))) == Duration::seconds(-5))
}

@test
fn aCalendarAddsDaysAndMonths() = {
	val january = Utc::at(year: 2026, month: 1, day: 31, hour: 9, minute: 30).unwrap()
	val february = january.addMonths(1)
	assert(february.month() == 2 && february.day() == 28, "the end of a month kept")
	assert(february.hour() == 9 && february.minute() == 30, "the time of day kept")
	assert(Utc::at(year: 2024, month: 1, day: 31).unwrap().addMonths(1).day() == 29)
	assert(january.addMonths(2).month() == 3 && january.addMonths(2).day() == 31)
	assert(january.addMonths(-1).year() == 2025 && january.addMonths(-1).month() == 12)
	assert(january.addMonths(11).year() == 2026 && january.addMonths(11).month() == 12)
	assert(january.addMonths(12).year() == 2027 && january.addMonths(12).day() == 31)
	assert(january.addMonths(-13).year() == 2024 && january.addMonths(-13).month() == 12)
	val leap = Utc::at(year: 2024, month: 2, day: 29).unwrap()
	assert(leap.addMonths(12) == Utc::at(year: 2025, month: 2, day: 28), "a year from a leap day")
	assert(leap.addMonths(48) == Utc::at(year: 2028, month: 2, day: 29))
	// A month before 1970.
	val old = Utc::at(year: 1969, month: 3, day: 31, hour: 12).unwrap()
	assert(old.addMonths(-1) == Utc::at(year: 1969, month: 2, day: 28, hour: 12))
	assert(january.addDays(1) == Utc::at(year: 2026, month: 2, day: 1, hour: 9, minute: 30))
	assert(january.addDays(-31) == Utc::at(year: 2025, month: 12, day: 31, hour: 9, minute: 30))
}

@test
fn daysAreCountedByTheCalendar() = {
	val late = Utc::at(year: 2026, month: 3, day: 1, hour: 23, minute: 59).unwrap()
	val early = Utc::at(year: 2026, month: 3, day: 2, minute: 1).unwrap()
	assert(early.daysSince(&late) == 1, "two minutes apart, a day apart")
	assert(late.daysSince(&early) == -1)
	val morning = Utc::at(year: 2026, month: 3, day: 1, minute: 1).unwrap()
	assert(late.daysSince(&morning) == 0, "the same day")
	val before = Utc::at(year: 1969, month: 12, day: 31, hour: 23).unwrap()
	assert(Utc::of(0).daysSince(&before) == 1)
	val leap = Utc::at(year: 2024, month: 1, day: 1).unwrap()
	assert(Utc::at(year: 2025, month: 1, day: 1).unwrap().daysSince(&leap) == 366)
}
