// SHA-256 against the vectors FIPS 180-4's examples and NIST give: the
// empty input, `abc`, the two-block message and a million `a`s; and bytes
// written in pieces of every size, which digest as written at once.
// CRC-32 and Adler-32 against their known values, against a byte at a
// time worked out the slow way, and in pieces.

import std::digest::{Adler32, Crc32, Sha256}
import std::digest
import std::hex

@test
fn sha256AnswersTheStandardVectors() = {
	val empty = ""
	assert(
		hex::encode(digest::sha256(&empty)) ==
			"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
	)
	val abc = "abc"
	assert(
		hex::encode(digest::sha256(&abc)) ==
			"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
	)
	val two = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
	assert(
		hex::encode(digest::sha256(&two)) ==
			"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
	)
	var many = Sha256()
	val thousand = "a".repeat(1000)
	for _ in 0..1000 {
		many.write(&thousand)
	}
	assert(
		hex::encode(many.finish()) ==
			"cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0",
	)
}

@test
fn sha256OfPiecesIsTheDigestOfTheWhole() = {
	var text = String()
	for i in 0..300 {
		text.push("\(i * 7919 % 251) ")
	}
	val whole = digest::sha256(&text)
	for size in 1..130 {
		var running = Sha256()
		var at = 0
		while at < text.len() {
			val end = (at + size).min(text.len())
			running.write(text.toStr()[at..end])
			at = end
		}
		assert(running.finish() == whole, "pieces of \(size)")
	}
	// Every length about a block's end, where the padding needs one more.
	for length in 50..70 {
		val bytes = "x".repeat(length)
		var running = Sha256()
		running.write(&bytes)
		assert(running.finish() == digest::sha256(&bytes))
	}
}

@test
fn crc32AnswersTheKnownValues() = {
	val nothing = ""
	val nine = "123456789"
	val fox = "The quick brown fox jumps over the lazy dog"
	assert(digest::crc32(&nothing) == 0)
	assert(digest::crc32(&nine) == 0xCBF43926)
	assert(digest::crc32(&fox) == 0x414FA339)
	assert(digest::crc32([0 as u8; 32]) == 0x190A55AD)
	assert(digest::crc32([0xFF as u8; 32]) == 0xFF6CAB0B)
}

@test
fn adler32AnswersTheKnownValues() = {
	val nothing = ""
	val wikipedia = "Wikipedia"
	val nine = "123456789"
	assert(digest::adler32(&nothing) == 1)
	assert(digest::adler32(&wikipedia) == 0x11E60398)
	assert(digest::adler32(&nine) == 0x091E01DE)
}

/// The CRC-32 of `bytes` a bit at a time, as the polynomial defines it.
fn crc32ByBits(bytes: &[u8]): u32 = {
	var c: u32 = 0xFFFFFFFF
	for byte in bytes {
		c = c ^ byte
		for _ in 0..8 {
			c = if c & 1 != 0 then 0xEDB88320 ^ (c >> 1) else c >> 1
		}
	}
	return c ^ 0xFFFFFFFF
}

/// The Adler-32 of `bytes` with both sums taken modulo after every byte.
fn adler32ByBytes(bytes: &[u8]): u32 = {
	var a: u32 = 1
	var b: u32 = 0
	for byte in bytes {
		a = (a + byte) % 65521
		b = (b + a) % 65521
	}
	return (b << 16) | a
}

@test
fn checksumsAreWhatTheSlowWayAnswers() = {
	// Every length about the eight bytes CRC-32 takes at once, and past
	// the 5552 after which Adler-32 takes its modulo, of bytes that are
	// all 0xFF, the most each sum can grow by.
	var high: Vec<u8> = Vec()
	var mixed: Vec<u8> = Vec()
	for i in 0..12000 {
		high.push(0xFF)
		mixed.push((i * 7919 % 251) as u8)
	}
	for length in [0, 1, 7, 8, 9, 15, 16, 17, 5551, 5552, 5553, 11104, 11105, 12000] {
		assert(digest::crc32(&mixed[0..length]) == crc32ByBits(&mixed[0..length]), "\(length)")
		assert(digest::adler32(&high[0..length]) == adler32ByBytes(&high[0..length]), "\(length)")
		assert(digest::adler32(&mixed[0..length]) == adler32ByBytes(&mixed[0..length]))
	}
}

@test
fn checksumsOfPiecesAreTheChecksumsOfTheWhole() = {
	var bytes: Vec<u8> = Vec()
	for i in 0..20000 {
		bytes.push((i * 7919 % 251) as u8)
	}
	val crc = digest::crc32(&bytes)
	val adler = digest::adler32(&bytes)
	for size in [1, 3, 7, 8, 13, 64, 5552, 7000] {
		var crcRunning = Crc32()
		var adlerRunning = Adler32()
		var at = 0
		while at < bytes.len() {
			val end = (at + size).min(bytes.len())
			crcRunning.write(&bytes[at..end])
			adlerRunning.write(&bytes[at..end])
			at = end
		}
		assert(crcRunning.value() == crc && adlerRunning.value() == adler, "pieces of \(size)")
	}
}

/// A checksum worked out while the program is compiled is the one it
/// works out as it runs.
@comptime
val NINE_CRC: u32 = crcOfNine()

fn crcOfNine(): u32 = {
	val nine = "123456789"
	return digest::crc32(&nine)
}

@test
fn aChecksumWorkedOutWhileCompilingIsTheSame() = {
	assert(NINE_CRC == 0xCBF43926)
}
