// SHA-256, SHA-1 and SHA-512 against the vectors FIPS 180-4's examples and
// NIST give: the empty input, `abc`, the two-block message and a million
// `a`s; bytes written in pieces of every size, which digest as written at
// once; and every length about a block's end. HMAC against the vectors of
// RFC 2202 and RFC 4231, among them keys longer than a block.
// CRC-32 and Adler-32 against their known values, against a byte at a
// time worked out the slow way, and in pieces.

import std::base64
import std::digest::{Adler32, Crc32, Sha1, Sha256, Sha512}
import std::digest
import std::hex

@test
fn sha256AnswersTheStandardVectors() = {
	val empty = ""
	assert(
		hex::encode(digest::sha256(&empty)) ==
			"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
	)
	val abc = "abc"
	assert(
		hex::encode(digest::sha256(&abc)) ==
			"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
	)
	val two = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
	assert(
		hex::encode(digest::sha256(&two)) ==
			"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
	)
	var many = Sha256()
	val thousand = "a".repeat(1000)
	for _ in 0..1000 do
		many.write(&thousand)

	assert(
		hex::encode(many.finish()) ==
			"cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0",
	)
}

@test
fn sha256OfPiecesIsTheDigestOfTheWhole() = {
	var text = String()
	for i in 0..300 do
		text.push("\(i * 7919 % 251) ")

	val whole = digest::sha256(&text)
	for size in 1..130 {
		var running = Sha256()
		var at = 0
		while at < text.len() {
			val end = (at + size).min(text.len())
			running.write(text.toStr()[at..end])
			at = end
		}
		assert(running.finish() == whole, "pieces of \(size)")
	}
	// Every length about a block's end, where the padding needs one more.
	for length in 50..70 {
		val bytes = "x".repeat(length)
		var running = Sha256()
		running.write(&bytes)
		assert(running.finish() == digest::sha256(&bytes))
	}
}

@test
fn crc32AnswersTheKnownValues() = {
	val nothing = ""
	val nine = "123456789"
	val fox = "The quick brown fox jumps over the lazy dog"
	assert(digest::crc32(&nothing) == 0)
	assert(digest::crc32(&nine) == 0xCBF43926)
	assert(digest::crc32(&fox) == 0x414FA339)
	assert(digest::crc32([0 as u8; 32]) == 0x190A55AD)
	assert(digest::crc32([0xFF as u8; 32]) == 0xFF6CAB0B)
}

@test
fn adler32AnswersTheKnownValues() = {
	val nothing = ""
	val wikipedia = "Wikipedia"
	val nine = "123456789"
	assert(digest::adler32(&nothing) == 1)
	assert(digest::adler32(&wikipedia) == 0x11E60398)
	assert(digest::adler32(&nine) == 0x091E01DE)
}

/// The CRC-32 of `bytes` a bit at a time, as the polynomial defines it.
fn crc32ByBits(bytes: &[u8]): u32 = {
	var c: u32 = 0xFFFFFFFF
	for byte in bytes {
		c = c ^ byte
		for _ in 0..8 do
			c = if c & 1 != 0 then 0xEDB88320 ^ (c >> 1) else c >> 1
	}
	return c ^ 0xFFFFFFFF
}

/// The Adler-32 of `bytes` with both sums taken modulo after every byte.
fn adler32ByBytes(bytes: &[u8]): u32 = {
	var a: u32 = 1
	var b: u32 = 0
	for byte in bytes {
		a = (a + byte) % 65521
		b = (b + a) % 65521
	}
	return (b << 16) | a
}

@test
fn checksumsAreWhatTheSlowWayAnswers() = {
	// Every length about the eight bytes CRC-32 takes at once, and past
	// the 5552 after which Adler-32 takes its modulo, of bytes that are
	// all 0xFF, the most each sum can grow by.
	var high: Vec<u8> = Vec()
	var mixed: Vec<u8> = Vec()
	for i in 0..12000 {
		high.push(0xFF)
		mixed.push((i * 7919 % 251) as u8)
	}
	for length in [0, 1, 7, 8, 9, 15, 16, 17, 5551, 5552, 5553, 11104, 11105, 12000] {
		assert(digest::crc32(&mixed[0..length]) == crc32ByBits(&mixed[0..length]), "\(length)")
		assert(digest::adler32(&high[0..length]) == adler32ByBytes(&high[0..length]), "\(length)")
		assert(digest::adler32(&mixed[0..length]) == adler32ByBytes(&mixed[0..length]))
	}
}

@test
fn checksumsOfPiecesAreTheChecksumsOfTheWhole() = {
	val bytes: Vec<u8> = [
		for i in 0..20000 do
			yield (i * 7919 % 251) as u8
	]
	val crc = digest::crc32(&bytes)
	val adler = digest::adler32(&bytes)
	for size in [1, 3, 7, 8, 13, 64, 5552, 7000] {
		var crcRunning = Crc32()
		var adlerRunning = Adler32()
		var at = 0
		while at < bytes.len() {
			val end = (at + size).min(bytes.len())
			crcRunning.write(&bytes[at..end])
			adlerRunning.write(&bytes[at..end])
			at = end
		}
		assert(crcRunning.value() == crc && adlerRunning.value() == adler, "pieces of \(size)")
	}
}

/// A checksum worked out while the program is compiled is the one it
/// works out as it runs.
@comptime
val NINE_CRC: u32 = crcOfNine()

fn crcOfNine(): u32 = {
	val nine = "123456789"
	return digest::crc32(&nine)
}

@test
fn aChecksumWorkedOutWhileCompilingIsTheSame() = {
	assert(NINE_CRC == 0xCBF43926)
}

@test
fn sha1AnswersTheStandardVectors() = {
	val empty = ""
	assert(hex::encode(digest::sha1(&empty)) == "da39a3ee5e6b4b0d3255bfef95601890afd80709")
	val abc = "abc"
	assert(hex::encode(digest::sha1(&abc)) == "a9993e364706816aba3e25717850c26c9cd0d89d")
	val two = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
	assert(hex::encode(digest::sha1(&two)) == "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
	var many = Sha1()
	val thousand = "a".repeat(1000)
	for _ in 0..1000 do
		many.write(&thousand)

	assert(hex::encode(many.finish()) == "34aa973cd4c4daa4f61eeb2bdbad27316534016f")
	// RFC 6455's handshake: the accept key for its example's key.
	val key = "dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
	assert(base64::encode(digest::sha1(&key), .Standard) == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")
}

@test
fn sha512AnswersTheStandardVectors() = {
	val empty = ""
	assert(
		hex::encode(digest::sha512(&empty)) ==
			"cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",
	)
	val abc = "abc"
	assert(
		hex::encode(digest::sha512(&abc)) ==
			"ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
	)
	val two =
		"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
	assert(
		hex::encode(digest::sha512(&two)) ==
			"8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909",
	)
	var many = Sha512()
	val thousand = "a".repeat(1000)
	for _ in 0..1000 do
		many.write(&thousand)

	assert(
		hex::encode(many.finish()) ==
			"e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b",
	)
}

/// Every length from `from` to `to` of `x`s, each digested by `digest`,
/// the digests one after another, and their SHA-256: one value that says
/// every padding about a block's end is right.
fn lengthsDigested(from: i64, to: i64, digest: &(bytes: &[u8]) => Vec<u8>): String = {
	var all: Vec<u8> = Vec()
	for length in from..to {
		val bytes = "x".repeat(length)
		all.append(digest(&bytes))
	}
	return hex::encode(digest::sha256(&all))
}

@test
fn everyLengthAboutABlocksEndIsPadded() = {
	val sha1 = lengthsDigested(40, 140, (bytes) => digest::sha1(&bytes).toVec())
	assert(sha1 == "61ec161f730426fc46d9f543ff5851e7be2ace0c4e60a439fab7689fb538b157")
	val sha512 = lengthsDigested(90, 270, (bytes) => digest::sha512(&bytes).toVec())
	assert(sha512 == "760f83660fe83d3619544d03d244f2f99666b72ea280b3a12371e37455fdd0d3")
}

@test
fn digestsOfPiecesAreTheDigestsOfTheWhole() = {
	var text = String()
	for i in 0..300 do
		text.push("\(i * 7919 % 251) ")

	val one = digest::sha1(&text)
	val five = digest::sha512(&text)
	for size in 1..260 {
		var first = Sha1()
		var second = Sha512()
		var at = 0
		while at < text.len() {
			val end = (at + size).min(text.len())
			first.write(text.toStr()[at..end])
			second.write(text.toStr()[at..end])
			at = end
		}
		assert(first.finish() == one && second.finish() == five, "pieces of \(size)")
	}
}

@test
fn hmacAnswersTheVectorsOfItsRfcs() = {
	// RFC 2202's and RFC 4231's first: a key of twenty `0x0b`.
	val key = [0x0b as u8; 20]
	val hi = "Hi There"
	assert(hex::encode(digest::hmacSha1(&key, &hi)) == "b617318655057264e28bc0b6fb378c8ef146be00")
	assert(
		hex::encode(digest::hmacSha256(&key, &hi)) ==
			"b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
	)
	assert(
		hex::encode(digest::hmacSha512(&key, &hi)) ==
			"87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854",
	)
	// A key shorter than its digest.
	val jefe = "Jefe"
	val what = "what do ya want for nothing?"
	assert(
		hex::encode(digest::hmacSha1(&jefe, &what)) == "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79",
	)
	assert(
		hex::encode(digest::hmacSha256(&jefe, &what)) ==
			"5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
	)
	assert(
		hex::encode(digest::hmacSha512(&jefe, &what)) ==
			"164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737",
	)
}

@test
fn hmacTakesTheDigestOfAKeyLongerThanABlock() = {
	val first = "Test Using Larger Than Block-Size Key - Hash Key First"
	// RFC 2202's: eighty bytes, past SHA-1's block of 64.
	val eighty = [0xaa as u8; 80]
	assert(
		hex::encode(digest::hmacSha1(&eighty, &first)) ==
			"aa4ae5e15272d00e95705637ce8a3b55ed402112",
	)
	// RFC 4231's: 131 bytes, past SHA-512's block of 128 too.
	val long = [0xaa as u8; 131]
	assert(
		hex::encode(digest::hmacSha256(&long, &first)) ==
			"60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",
	)
	assert(
		hex::encode(digest::hmacSha512(&long, &first)) ==
			"80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598",
	)
	val both =
		"This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."
	assert(
		hex::encode(digest::hmacSha256(&long, &both)) ==
			"9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2",
	)
	assert(
		hex::encode(digest::hmacSha512(&long, &both)) ==
			"e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58",
	)
	assert(
		hex::encode(digest::hmacSha1(&long, &both)) == "217e44bb08b6e06a2d6c30f3cb9f537f97c63356",
	)
}
