// `std::process`: what a program started is given — its standard streams,
// the environment its command says, and none of the files, sockets and
// pipes this program has open — and a program talked to as it runs. Each
// that starts one starts a program of the system's — `sh`, `cat`, `true` —
// which a Mac and Linux have and iOS does not.

import std::fs
import std::future
import std::net::{Listener}
import std::io
import std::libc
import std::path
import std::process
import std::process::{Command}
import std::time::{Duration, Instant, sleep}

/// The descriptors past the standard streams that a program started now
/// is given, as a shell finds them: each it can read from, by number.
fn given(): String = {
	val listed = Command::of("sh").arg("-c").arg(LIST).output().unwrap()
	return listed.stdout.clone()
}

val LIST =
	"n=3; while [ $n -lt 64 ]; do (: <&$n) 2>/dev/null && printf '%s ' $n; n=$((n + 1)); done"

@test
@target(os = "macos")
@target(os = "linux")
fn processGivesAProgramNothingThisOneOpened() = {
	val before = given()
	val file = fs::File::open("tests/std/main.wip").unwrap()
	val listener = Listener::tcp(.Some("127.0.0.1"), 0).unwrap()
	val after = given()
	assert(after == before, "given \(after)where it was given \(before)before they were open")
}

/// What a shell started by `command` says `$name` is, or `-` where it has
/// no such variable.
fn variable(command: Command, name: str): String = {
	val said = command.arg("-c").arg("echo \"${\(name)-unset}\"").output().unwrap()
	return String::of(said.stdout.trim())
}

@test
@target(os = "macos")
@target(os = "linux")
fn processSetsAndLeavesOutWhatTheCommandSays() = {
	assert(variable(Command::of("sh").env("WIP_PROBE", "one"), "WIP_PROBE") == "one")
	assert(
		variable(Command::of("sh").env("WIP_PROBE", "one").unset("WIP_PROBE"), "WIP_PROBE") ==
			"unset",
	)
	// Each change in turn: set again after it is left out.
	val again = Command::of("sh").env("WIP_PROBE", "one").unset("WIP_PROBE").env("WIP_PROBE", "two")
	assert(variable(again, "WIP_PROBE") == "two")
	// One this program has, and what comes after it in the list.
	assert(variable(Command::of("sh").unset("HOME"), "HOME") == "unset")
	assert(variable(Command::of("sh").unset("HOME"), "PATH") != "unset")
	// One that is not there is nothing to leave out.
	assert(variable(Command::of("sh").unset("WIP_NOT_SET_ANYWHERE"), "HOME") != "unset")
}

/// A conversation: each line written is read back before the next is
/// written, and the next is made from what came back.
@test
@target(os = "macos")
@target(os = "linux")
fn processTalksToAProgramAsItRuns() = {
	var echo = Command::of("sh").args(["-c", "while read line; do echo \"got $line\"; done"])
		.connect()
		.unwrap()
	var answer = String()
	echo.writeText("one\n").unwrap()
	assert(echo.output().readLine(&var answer).unwrap())
	assert(answer == "got one", answer.toStr())
	echo.writeText("\(answer), again\n").unwrap()
	answer.clear()
	assert(echo.output().readLine(&var answer).unwrap())
	assert(answer == "got got one, again", answer.toStr())
	echo.closeInput()
	answer.clear()
	assert(!echo.output().readLine(&var answer).unwrap(), "its output ends with it")
	assert(echo.wait().success())
}

/// What a command says of the environment holds for a program talked to,
/// and its output is read as any `Reader`'s is: by length too.
@test
@target(os = "macos")
@target(os = "linux")
fn processTalksWithTheEnvironmentItsCommandSays() = {
	var shell = Command::of("sh").env("WIP_PROBE", "here").connect().unwrap()
	shell.writeText("printf '%s' \"$WIP_PROBE\"\n").unwrap()
	var said = String()
	assert(shell.output().readExact(4, &var said).unwrap() == 4)
	assert(said == "here", said.toStr())
	assert(shell.wait().success())
}

/// A read waits no longer than its timeout, answering `.WouldBlock`, and
/// reads on afterwards; what a program writes before it ends is read to
/// its end.
@test
@target(os = "macos")
@target(os = "linux")
fn processGivesUpOnAnAnswerThatDoesNotCome() = {
	var quiet = Command::of("cat").connect().unwrap()
	quiet.output().setTimeout(.Some(Duration::millis(100)))
	val started = Instant::now()
	var line = String()
	assert(quiet.output().readLine(&var line) == .Err(io::IoError::WouldBlock))
	assert(started.elapsed().asMillis() < 2000)
	quiet.writeText("late\n").unwrap()
	quiet.output().setTimeout(.None)
	assert(quiet.output().readLine(&var line).unwrap())
	assert(line == "late", line.toStr())
}

/// A program that has ended reads nothing more: writing to it answers
/// `.BrokenPipe`, and does not end this program. It has ended once it is
/// waited for, not once its output ends: a program may close its output
/// before it ends, and its input with it.
@test
@target(os = "macos")
@target(os = "linux")
fn processSaysAProgramThatEndedReadsNoMore() = {
	var ended = Command::of("true").connect().unwrap()
	while ended.tryWait().isNone() {
		sleep(Duration::millis(1))
	}
	assert(ended.writeText("anyone?\n") == .Err(io::IoError::BrokenPipe))
	ended.closeInput()
	assert(ended.writeText("now?\n") == .Err(io::IoError::BrokenPipe))
}

/// Writing to a program that has ended answers `.BrokenPipe` while
/// another thread runs too: no thread of this program is ended by the
/// write, not only the one that wrote.
@test
@target(os = "macos")
@target(os = "linux")
fn processSaysAProgramThatEndedReadsNoMoreWhileAnotherThreadRuns() = {
	var ended = Command::of("true").connect().unwrap()
	while ended.tryWait().isNone() {
		sleep(Duration::millis(1))
	}
	val (_, written) = future::both(
		() => sleep(Duration::millis(200)),
		() => ended.writeText("anyone?\n"),
	)
	assert(written == .Err(io::IoError::BrokenPipe))
}

/// A program talked to that is dropped while it reads has its input
/// closed, which ends it, and is waited for.
@test
@target(os = "macos")
@target(os = "linux")
fn processEndsAProgramTalkedToWhereItIsDropped() = {
	val started = Instant::now()
	{
		var reading = Command::of("cat").connect().unwrap()
		reading.writeText("left unread\n").unwrap()
	}
	assert(started.elapsed().asMillis() < 5000)
}

/// What is beside the program is beside the file it was started from.
@test
fn processFindsWhatIsBesideTheProgram() = {
	val .Ok(program) = process::executable() else panic("a program has a file")
	assert(process::besideProgram("levels") == "\(path::parent(program))/levels")
}

/// What `signals` received within five seconds, until it has `count`.
fn receivedWithin(signals: &var process::Signals, count: i64): Vec<process::Signal> = {
	var got: Vec<process::Signal> = Vec()
	val began = Instant::now()
	while got.len() < count && began.elapsed() < Duration::seconds(5) {
		for signal in signals.received() {
			if !got.contains(&signal) then got.push(signal)
		}
		sleep(Duration::millis(5))
	}
	return got
}

/// A signal caught ends nothing, and is told of when asked.
@test
fn aSignalCaughtIsToldOfAndEndsNothing() = {
	var signals = process::Signals::catch([process::Signal::Interrupt, .Terminate]).unwrap()
	assert(signals.received().isEmpty(), "none yet")
	libc::kill(process::id() as c_int, libc::SIGINT)
	libc::kill(process::id() as c_int, libc::SIGTERM)
	val got = receivedWithin(&var signals, 2)
	assert(
		got.contains(process::Signal::Interrupt) && got.contains(process::Signal::Terminate),
		"both told of",
	)
}

/// A signal is waited for, and waits in an event queue.
@test
fn aSignalIsWaitedForAndWaitsInAQueue() = {
	var signals = process::Signals::catch([process::Signal::Hangup]).unwrap()
	libc::kill(process::id() as c_int, libc::SIGHUP)
	assert(signals.wait() == .Hangup)
	var queue = io::EventQueue::new().unwrap()
	assert(queue.add(signals.descriptor(), .Read, 9).isOk())
	var events: Vec<io::Event> = Vec()
	libc::kill(process::id() as c_int, libc::SIGHUP)
	assert(queue.wait(.Some(Duration::seconds(5)), &var events).isOk())
	assert(events.len() == 1 && events[0].token == 9, "ready")
	assert(receivedWithin(&var signals, 1) == [process::Signal::Hangup].toVec())
}

/// Where the `Signals` ends, a signal is as it was: neither ignored nor
/// held back.
@test
fn aSignalLetGoIsAsItWas() = {
	{
		val signals = process::Signals::catch([process::Signal::Quit]).unwrap()
	}
	assert(libc::signal(libc::SIGQUIT, libc::SIG_DFL) == libc::SIG_DFL, "not ignored")
	var none = libc::hidden()
	libc::sigemptyset(&var none)
	var held = libc::hidden()
	libc::pthread_sigmask(libc::SIG_BLOCK, &none, &var held)
	assert(libc::sigismember(&held, libc::SIGQUIT) == 0, "not held back")
}

/// A program started while a signal is caught handles it as it would: a
/// Ctrl-C ends it.
@target(os = "macos")
@target(os = "linux")
@test
fn aProgramStartedHandlesACaughtSignalAsItWould() = {
	val signals = process::Signals::catch([process::Signal::Interrupt]).unwrap()
	val child = Command::of("sleep").arg("10").start().unwrap()
	sleep(Duration::millis(100))
	libc::kill(child.id() as c_int, libc::SIGINT)
	assert(child.wait() == .Signal(libc::SIGINT as i64), "ended by it")
}

/// A child's end is told of, and the child is still waited for, its code
/// kept.
@target(os = "macos")
@target(os = "linux")
@test
fn aChildsEndIsToldOfAndItsCodeKept() = {
	var signals = process::Signals::catch([process::Signal::Child]).unwrap()
	val child = Command::of("sh").args(["-c", "exit 3"]).start().unwrap()
	assert(receivedWithin(&var signals, 1) == [process::Signal::Child].toVec(), "told of")
	assert(child.wait() == .Code(3), "waited for, its code kept")
}
