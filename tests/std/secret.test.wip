// `std::secret`: bytes from the system's generator for secrets, of any
// length, past the most it gives in one call; and two secrets compared, the
// same, a byte apart at either end, and of lengths apart.

import std::secret

@test
fn secretBytesAreAsManyAsAskedAndNeverTheSame() = {
	for count in [0, 1, 16, 255, 256, 257, 1000] do
		assert(secret::bytes(count).len() == count, "\(count)")

	val first = secret::bytes(32)
	val second = secret::bytes(32)
	assert(first != second, "two calls give two secrets")
	// Bytes past the first 256 are filled too: 744 zeros are one chance in
	// 2^5952.
	val many = secret::bytes(1000)
	var zeros = 0
	for byte in many[256..1000] do
		if byte == 0 then
			zeros += 1

	assert(zeros < 744)
}

@test
fn anArrayIsFilledFromTheGenerator() = {
	var key = [0 as u8; 600]
	secret::fill(&var key)
	var last = [0 as u8; 600]
	secret::fill(&var last)
	assert(key != last)
	var nothing: [u8; 0] = []
	secret::fill(&var nothing)
}

@test
fn secretsAreComparedWhole() = {
	val signature = secret::bytes(32)
	val same = signature.clone()
	assert(secret::equal(&signature, &same))
	var first = same.clone()
	first[0] = first[0] ^ 1
	assert(!secret::equal(&signature, &first), "a byte apart at the start")
	var last = same
	last[31] = last[31] ^ 0x80
	assert(!secret::equal(&signature, &last), "a byte apart at the end")
	assert(!secret::equal(&signature, &signature[0..31]), "lengths apart")
	val empty: [u8; 0] = []
	assert(secret::equal(&empty, &empty))
	val text = "sha256=abc"
	assert(secret::equal(&text, "sha256=abc"))
}

/// Two secrets compared while the program is compiled: what hides a value
/// from the optimiser hides nothing from the evaluator.
@comptime
val COMPARED: (bool, bool) = comparedWhileCompiling()

fn comparedWhileCompiling(): (bool, bool) = {
	val word = "abc"
	return (secret::equal(&word, "abc"), secret::equal(&word, "abd"))
}

@test
fn secretsAreComparedWhileCompiling() = {
	assert(COMPARED == (true, false))
}
