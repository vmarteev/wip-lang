// What a game loop takes from the library: a fixed time step, a pool of
// threads that stays between calls, and numbers read from and written to
// bytes in a known order.

import std::bytes::{Reader, Writer}
import std::future
import std::future::{Pool}
import std::time::{Duration, FixedStep}

@test
fn aFixedStepRunsTheUpdatesTheTimeHolds() = {
	var step = FixedStep::of(perSecond: 60)
	var updates = 0
	// Two frames of 25 ms: 50 ms, three updates of a sixtieth, and some left.
	for _ in 0..2 {
		step.advanceBy(Duration::millis(25))
		while step.due() {
			updates += 1
		}
	}
	assert(updates == 3 && step.alpha() > 0.0 && step.alpha() < 1.0)
	assert((step.seconds() - 1.0 / 60.0).abs() < 0.000001)
	// A frame that stalled for a second runs a quarter of one.
	step.advanceBy(Duration::seconds(1))
	var caught = 0
	while step.due() {
		caught += 1
	}
	assert(caught == 15, "\(caught) updates")
}

@test
fn aPoolDoesWhatEachAndMapDo() = {
	val pool = Pool::of(3)
	assert(pool.threads() == 3)
	var values: Vec<i64> = Vec()
	for i in 0..1000 {
		values.push(i)
	}
	for round in 0..50 {
		pool.each(&var values.items(), (value) => { value = value + 1 })
	}
	for i in 0..1000 {
		assert(values[i] == i + 50)
	}
	val lengths = pool.map(&values.items(), (value) => value * 2)
	assert(lengths.len() == 1000 && lengths[0] == 100 && lengths[999] == 2098)
	var few = [1]
	pool.each(&var few, (value) => { value = 9 })
	assert(few[0] == 9)
	val none: [i64; 0] = []
	assert(pool.map(&none, (n) => n).isEmpty())
}

@test
fn aPoolOfNoThreadsWorksHere() = {
	val alone = Pool::of(0)
	var values = [1, 2, 3]
	alone.each(&var values, (value) => { value = value * 10 })
	assert(values[2] == 30)
}

@test
fn numbersReadBackAsTheyWereWritten() = {
	var out = Writer()
	out.u8(0xAB)
	out.u16le(0x1234)
	out.u16be(0x1234)
	out.i32le(-2)
	out.u64be(0x0102030405060708)
	out.f32le(1.5)
	out.f64be(-0.25)
	out.bytes([7, 8, 9])
	val written = out.take()
	assert(written[1] == 0x34 && written[2] == 0x12 && written[3] == 0x12 && written[4] == 0x34)
	var read = Reader::of(&written.items())
	assert(
		read.u8() == .Some(0xAB) && read.u16le() == .Some(0x1234) && read.u16be() == .Some(0x1234),
	)
	assert(read.i32le() == .Some(-2) && read.u64be() == .Some(0x0102030405060708))
	assert(read.f32le() == .Some(1.5) && read.f64be() == .Some(-0.25))
	assert(read.bytes(3) == .Some(Vec::of(own [7 as u8, 8, 9])) && read.remaining() == 0)
	assert(read.u8().isNone(), "nothing past the end")
	assert(read.seek(1) == .Some() && read.u16le() == .Some(0x1234))
}
