// What a game loop takes from the library: a fixed time step, a pool of
// threads that stays between calls, and numbers read from and written to
// bytes in a known order.

import std::bytes
import std::bytes::{Reader, Writer}
import std::future
import std::future::{Pool}
import std::time::{Duration, FixedStep}

@test
fn aFixedStepRunsTheUpdatesTheTimeHolds() = {
	var step = FixedStep::of(perSecond: 60)
	var updates = 0
	// Two frames of 25 ms: 50 ms, three updates of a sixtieth, and some left.
	for _ in 0..2 {
		step.advanceBy(Duration::millis(25))
		while step.due() {
			updates += 1
		}
	}
	assert(updates == 3 && step.alpha() > 0.0 && step.alpha() < 1.0)
	assert((step.seconds() - 1.0 / 60.0).abs() < 0.000001)
	// A frame that stalled for a second runs a quarter of one.
	step.advanceBy(Duration::seconds(1))
	var caught = 0
	while step.due() {
		caught += 1
	}
	assert(caught == 15, "\(caught) updates")
}

@test
fn aPoolDoesWhatEachAndMapDo() = {
	val pool = Pool::of(3)
	assert(pool.threads() == 3)
	var values: Vec<i64> = Vec()
	for i in 0..1000 {
		values.push(i)
	}
	for round in 0..50 {
		pool.each(&var values.items(), (value) => { value = value + 1 })
	}
	for i in 0..1000 {
		assert(values[i] == i + 50)
	}
	val lengths = pool.map(&values.items(), (value) => value * 2)
	assert(lengths.len() == 1000 && lengths[0] == 100 && lengths[999] == 2098)
	var few = [1]
	pool.each(&var few, (value) => { value = 9 })
	assert(few[0] == 9)
	val none: [i64; 0] = []
	assert(pool.map(&none, (n) => n).isEmpty())
}

@test
fn aPoolOfNoThreadsWorksHere() = {
	val alone = Pool::of(0)
	var values = [1, 2, 3]
	alone.each(&var values, (value) => { value = value * 10 })
	assert(values[2] == 30)
}

@test
fn numbersReadBackAsTheyWereWritten() = {
	var out = Writer()
	out.u8(0xAB)
	out.u16le(0x1234)
	out.u16be(0x1234)
	out.i32le(-2)
	out.u64be(0x0102030405060708)
	out.f32le(1.5)
	out.f64be(-0.25)
	out.bytes([7, 8, 9])
	val written = out.take()
	assert(written[1] == 0x34 && written[2] == 0x12 && written[3] == 0x12 && written[4] == 0x34)
	var read = Reader::of(&written.items())
	assert(
		read.u8() == .Some(0xAB) && read.u16le() == .Some(0x1234) && read.u16be() == .Some(0x1234),
	)
	assert(read.i32le() == .Some(-2) && read.u64be() == .Some(0x0102030405060708))
	assert(read.f32le() == .Some(1.5) && read.f64be() == .Some(-0.25))
	assert(read.bytes(3) == .Some([7 as u8, 8, 9]) && read.remaining() == 0)
	assert(read.u8().isNone(), "nothing past the end")
	assert(read.seek(1) == .Some() && read.u16le() == .Some(0x1234))
}

@test
fn numbersAtAPlaceReadBackAsTheyWereWritten() = {
	var header = [0 as u8; 33]
	bytes::putU16le(&var header, 1, 0x1234)
	bytes::putU16be(&var header, 3, 0x1234)
	bytes::putI32le(&var header, 5, -2)
	bytes::putU32be(&var header, 9, 0xDEADBEEF)
	bytes::putI64be(&var header, 13, -3)
	bytes::putF32le(&var header, 21, 1.5)
	bytes::putF64be(&var header, 25, -0.25)
	assert(header[0] == 0 && header[1] == 0x34 && header[2] == 0x12)
	assert(header[3] == 0x12 && header[4] == 0x34 && header[9] == 0xDE && header[12] == 0xEF)
	assert(bytes::u16le(&header, 1) == 0x1234 && bytes::u16be(&header, 3) == 0x1234)
	assert(bytes::i16le(&header, 5) == -2 && bytes::i32le(&header, 5) == -2)
	assert(bytes::u32be(&header, 9) == 0xDEADBEEF && bytes::u32le(&header, 9) == 0xEFBEADDE)
	assert(bytes::i64be(&header, 13) == -3 && bytes::u64be(&header, 13) == 0xFFFFFFFFFFFFFFFD)
	assert(bytes::f32le(&header, 21) == 1.5 && bytes::f64be(&header, 25) == -0.25)
	assert(bytes::f32be(&header, 21) != 1.5, "the other order is another number")
	bytes::putU64le(&var header, 24, 0x0102030405060708)
	assert(header[24] == 8 && header[31] == 1 && bytes::u64le(&header, 24) == 0x0102030405060708)
	bytes::putI16be(&var header, 0, -1)
	bytes::putI64le(&var header, 8, -1)
	bytes::putF32be(&var header, 16, 2.0)
	bytes::putF64le(&var header, 24, 3.0)
	assert(bytes::i16be(&header, 0) == -1 && bytes::i64le(&header, 8) == -1)
	assert(bytes::f32be(&header, 16) == 2.0 && bytes::f64le(&header, 24) == 3.0)
	bytes::putI16le(&var header, 0, -300)
	bytes::putU16le(&var header, 30, 7)
	assert(bytes::i16le(&header, 0) == -300 && bytes::u16le(&header, 30) == 7)
	val made = bytes::encode(0.5)
	assert(bytes::f64le(&made, 1) == 0.5, "a Vec is read as its bytes")
}

@test
fn aNumberAtAPlaceIsWhatTheWriterWrote() = {
	var out = Writer()
	out.u32be(0x01020304)
	out.i32be(-5)
	out.u64le(9)
	val written = out.take()
	assert(bytes::u32be(&written, 0) == 0x01020304 && bytes::i32be(&written, 4) == -5)
	assert(bytes::u64le(&written, 8) == 9)
}

@test(panics = "4 bytes at 7 are out of bounds for length 10")
fn aWordPastTheEndPanics() = {
	val data = [0 as u8; 10]
	bytes::u32le(&data, 7)
}

@test(panics = "2 bytes at -1 are out of bounds for length 10")
fn aWordBeforeTheStartPanics() = {
	var data = [0 as u8; 10]
	bytes::putU16be(&var data, -1, 5)
}

@test(panics = "8 bytes at 0 are out of bounds for length 4")
fn aWordLongerThanTheBytesPanics() = {
	val data = [0 as u8; 4]
	bytes::u64le(&data, 0)
}
