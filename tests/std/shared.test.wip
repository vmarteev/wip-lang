// `Shared<T>` and `Weak<T>`: a value several owners hold
// and read, dropped once with the last of them; a link back that does not
// keep it; a copy only where an owner edits what others hold; and owners
// on threads at once, whose counts are atomic.

import std::future
import std::shared::{Shared, Weak}
import std::sync::{Atomic}

/// A value that counts how many times it has been dropped.
struct Counted {
    drops: Shared<Atomic<i64>>
    name: String
}

extend Counted: Destroy {
    var fn destroy() = {
        self.drops.value().add(1)
    }
}

fn counted(drops: &Shared<Atomic<i64>>, name: str): Counted = Counted(
    drops: drops.share(),
    name: String::of(name),
)

@test
fn sharedValueEndsWithItsLastOwner() = {
    val drops = Shared::of(Atomic::of(0))
    val first = Shared::of(counted(&drops, "one"))
    val second = first.share()
    val third = second.share()
    assert(first.owners() == 3 && first.same(&third))
    assert(third.value().name == "one", "every owner reads the one value")
    destroy(move first)
    destroy(move second)
    assert(drops.value().load() == 0, "an owner remains")
    destroy(move third)
    assert(drops.value().load() == 1, "dropped once, with the last")
}

@test
fn weakLinksDoNotKeepTheValue() = {
    val drops = Shared::of(Atomic::of(0))
    val owner = Shared::of(counted(&drops, "parent"))
    val link: Weak<Counted> = owner.downgrade()
    val again = link.upgrade()
    assert(again.isSome() && owner.owners() == 2, "upgraded while held")
    destroy(move again)
    destroy(move owner)
    assert(drops.value().load() == 1, "the value went with the last owner")
    assert(link.upgrade().isNone(), "and the link upgrades to nothing")
}

@test
fn editingCopiesWhatOthersHold() = {
    var mine = Shared::of(Vec::of(own [1, 2, 3]))
    val theirs = mine.share()
    mine.edit().push(4)
    assert(mine.value().len() == 4 && theirs.value().len() == 3, "theirs is what it was")
    assert(!mine.same(&theirs) && mine.owners() == 1 && theirs.owners() == 1)
    val before = mine.share()
    destroy(move before)
    mine.edit().push(5)
    assert(mine.value().len() == 5, "written in place once alone")
    val link = mine.downgrade()
    mine.edit().push(6)
    assert(link.upgrade().isNone(), "a link makes an edit copy, and keeps the old value")
}

@test
fn ownersOnThreadsAtOnce() = {
    val text = Shared::of(String::of("shared between threads"))
    var lengths: Vec<i64> = Vec()
    for i in 0..8 {
        lengths.push(0)
    }
    future::each(&var lengths.items(), (length) => {
        // Each thread shares it, and lets go, many times over.
        for round in 0..1000 {
            val mine = text.share()
            length = mine.value().len()
        }
    })
    for length in lengths {
        assert(length == 22)
    }
    assert(text.owners() == 1, "every share let go")
}
