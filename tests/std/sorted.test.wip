// `SortedMap<K, V>` and `SortedSet<K>`: what they hold, kept in the order of
// their keys whatever order the keys went in, and what only an order
// answers: the first and last, and the positions from a key and between
// two.

import std::collections::{SortedMap, SortedSet}
import std::random::{Random}

/// The keys of `map`, in the order it holds them.
fn keysOf(map: &SortedMap<str, i64>): Vec<str> = [
	for entry in map do
		yield entry.key
]

@test
fn aSortedMapPutsAndReadsBack() = {
	var counts = SortedMap<str, i64>()
	assert(counts.isEmpty() && counts.len() == 0, "a new map holds nothing")
	counts.put("b", 2)
	counts.put("a", 1)
	assert(counts.len() == 2 && counts.at("a") == 1 && counts.at("b") == 2)
	assert(counts.get("a") is .Some(one) && one == 1)
	assert(counts.get("c").isNone() && !counts.contains("c"))
	counts.put("a", 7)
	assert(counts.len() == 2 && counts.at("a") == 7, "the second value wins")
	counts.at("a") += 1
	assert(counts.at("a") == 8, "a value is a place")
}

@test
fn aSortedMapKeepsItsKeysInOrder() = {
	var counts = SortedMap<str, i64>()
	for word in ["pear", "apple", "fig", "apple", "kiwi"] do
		counts.atOrPut(word, 0) += 1

	assert(keysOf(&counts) == ["apple", "fig", "kiwi", "pear"].toVec())
	assert(counts.at("apple") == 2)
	assert(counts.keyAt(0) == "apple" && counts.valueAt(0) == 2)
	assert(counts.indexOf("kiwi") == 2 && counts.indexOf("plum").isNone())
	val values: Vec<i64> = [
		for value in counts.values() do
			yield value
	]
	assert(values == [2, 1, 1, 1])
}

@test
fn aSortedMapsValuesAreWrittenInPlace() = {
	var counts: SortedMap<str, i64> = [("b", 1), ("a", 2)]
	for value in counts.values() do
		value *= 10

	assert(counts.at("a") == 20 && counts.at("b") == 10)
	var made = 0
	counts.atOrPutWith("a", () => {
		made += 1
		return 0
	}) += 1
	counts.atOrPutWith("c", () => {
		made += 1
		return 5
	}) += 1
	assert(made == 1, "made only where nothing was")
	assert(counts.at("a") == 21 && counts.at("c") == 6)
}

@test
fn aSortedMapIsCollectedAndSortedOnce() = {
	val counts: SortedMap<str, i64> = [("pear", 1), ("apple", 2), ("pear", 3), ("fig", 4)]
	assert(keysOf(&counts) == ["apple", "fig", "pear"].toVec())
	assert(counts.at("pear") == 3, "the later value for a key, as `put` keeps it")
	val empty: SortedMap<str, i64> = []
	assert(empty.isEmpty() && empty.first().isNone() && empty.last().isNone())
}

@test
fn aSortedMapAnswersWhatOnlyAnOrderDoes() = {
	val ages: SortedMap<str, i64> = [("cy", 3), ("ada", 1), ("bob", 2), ("dee", 4)]
	assert(ages.first() is .Some(least) && least.key == "ada")
	assert(ages.last() is .Some(most) && most.key == "dee")
	assert(ages.positionOf("ada") == 0 && ages.positionOf("b") == 1 && ages.positionOf("bob") == 1)
	assert(ages.positionOf("a") == 0 && ages.positionOf("z") == 4, "past either end")
	val between: Vec<str> = [
		for at in ages.within("b", "d") do
			yield ages.keyAt(at)
	]
	assert(between == ["bob", "cy"].toVec())
	val all = ages.within("ada", "zed")
	assert(all.start == 0 && all.end == 4, "all of it")
	val none = ages.within("c", "c")
	val backwards = ages.within("d", "a")
	assert(none.start == none.end && backwards.start == backwards.end)
}

@test
fn aSortedMapRemovesAndKeeps() = {
	var tens: SortedMap<i64, i64> = SortedMap()
	for key in 0..6 do
		tens.put(5 - key, (5 - key) * 10)

	assert(tens.remove(2) == 20 && tens.remove(2).isNone())
	tens.retain((key, _) => key % 2 == 1)
	assert(tens.len() == 3 && tens.keyAt(0) == 1 && tens.keyAt(2) == 5)
	val taken = tens.takeAll()
	assert(tens.isEmpty() && taken.len() == 3)
	var again = taken.clone()
	again.clear()
	assert(again.isEmpty() && taken.len() == 3)
}

@test
fn twoSortedMapsAreEqualWhereTheirEntriesAre() = {
	val first: SortedMap<str, i64> = [("a", 1), ("b", 2)]
	val second: SortedMap<str, i64> = [("b", 2), ("a", 1)]
	val third: SortedMap<str, i64> = [("a", 1), ("b", 3)]
	assert(first == second && first != third)
	assert(first.clone() == first)
	val pairs: Vec<(str, i64)> = [
		for (key, value) in move first do
			yield (key, value)
	]

	assert(pairs == [("a", 1), ("b", 2)].toVec())
}

/// A thousand puts and removes, in no order, agree with a sorted `Vec` of
/// the keys after each.
@test
fn aSortedMapAgreesWithASortedVec() = {
	var dice = Random::seeded(7)
	var map: SortedMap<i64, i64> = SortedMap()
	var keys: Vec<i64> = Vec()
	for step in 0..1000 {
		val key = dice.below(200) as i64
		if dice.below(3) == 0 {
			val there = keys.binarySearch(&key)
			assert(map.remove(&key).isSome() == there.isOk())
			if there is .Ok(at) then
				keys.remove(at)
		} else {
			map.put(key, step)
			if keys.binarySearch(&key) is .Err(at) then
				keys.insert(at, key)
		}
		assert(map.len() == keys.len())
	}
	for (at, key) in keys.indexed() do
		assert(map.keyAt(at) == key && map.contains(&key))
}

@test
fn aSortedSetHoldsEachKeyOnceInOrder() = {
	var set: SortedSet<i64> = SortedSet()
	assert(set.add(3) && set.add(1) && !set.add(3))
	assert(set.items() == [1, 3] && set[0] == 1 && set.len() == 2)
	assert(set.contains(1) && !set.contains(2))
	assert(set.indexOf(3) == 1 && set.indexOf(2).isNone())
	assert(set.remove(1) && !set.remove(1) && set.items() == [3])
	val collected: SortedSet<str> = ["pear", "apple", "pear", "fig"]
	assert(collected.items() == ["apple", "fig", "pear"])
	assert(collected.first() is .Some(least) && least == "apple")
	assert(collected.last() is .Some(most) && most == "pear")
	assert(collected.positionOf("b") == 1)
	val from = collected.within("b", "q")
	assert(from.start == 1 && from.end == 3)
	val same: SortedSet<str> = ["fig", "pear", "apple"]
	assert(collected == same)
	var some = collected.clone()
	some.retain((name) => name.len() > 3)
	assert(some.items() == ["apple", "pear"])
	val names: Vec<str> = [
		for name in move some do
			yield name
	]

	assert(names == ["apple", "pear"].toVec())
}
