// `PriorityQueue<T, P>`: values taken the smallest priority first, those
// of equal priority in the order they went in, whatever the priority's
// type, and whatever the values own.

import std::collections::{PriorityQueue}
import std::random::{Random}

@test
fn theSmallestPriorityComesFirst() = {
	var queue: PriorityQueue<str, i64> = PriorityQueue()
	assert(queue.isEmpty() && queue.pop().isNone() && queue.first().isNone())
	queue.push("c", 30)
	queue.push("a", 10)
	queue.push("d", 40)
	queue.push("b", 20)
	assert(queue.len() == 4)
	assert(queue.first() == .Some(&"a") && queue.firstPriority() == .Some(&10))
	assert(queue.pop() == .Some(("a", 10)))
	assert(queue.pop() == .Some(("b", 20)))
	queue.push("e", 5)
	assert(queue.pop() == .Some(("e", 5)), "a smaller one pushed later comes first")
	assert(queue.pop() == .Some(("c", 30)) && queue.pop() == .Some(("d", 40)))
	assert(queue.pop().isNone() && queue.isEmpty())
}

/// Equal priorities come out in the order they were pushed, however the
/// heap has moved them about.
@test
fn equalPrioritiesComeOutInTheOrderPushed() = {
	var queue: PriorityQueue<i64, i64> = PriorityQueue()
	for i in 0..50 {
		queue.push(i, i % 3)
	}
	var last = (-1, -1)
	while queue.pop() is .Some((value, priority)) {
		if priority == last.1 then assert(value > last.0, "in the order pushed")
		else assert(priority > last.1, "the smallest first")
		last = (value, priority)
	}
}

/// A float is a priority as an integer is: a distance, a time.
@test
fn aFloatIsAPriority() = {
	val distances = [("far", 9.5), ("near", 0.25), ("middle", 3.0)]
	var queue = PriorityQueue::fromPairs(distances.copies())
	assert(queue.pop() == .Some(("near", 0.25)))
	assert(queue.pop() == .Some(("middle", 3.0)))
	assert(queue.pop() == .Some(("far", 9.5)))
}

/// Values that own memory move through, and those left end with the
/// queue, or with `clear`.
@test
fn valuesThatOwnMemoryMoveThrough() = {
	var queue: PriorityQueue<String, i64> = PriorityQueue()
	for word in ["three", "one", "two"] {
		queue.push(String::of(word), word.len())
	}
	assert(queue.pop() == .Some((String::of("one"), 3)), "of length 3, pushed before two")
	assert(queue.pop() == .Some((String::of("two"), 3)))
	queue.push(String::of("four"), 4)
	queue.clear()
	assert(queue.isEmpty())
	queue.push(String::of("left"), 1)
}

/// A thousand random priorities come out sorted.
@test
fn manyPrioritiesComeOutSorted() = {
	var random = Random::seeded(7)
	var queue: PriorityQueue<i64, i64> = PriorityQueue()
	var pushed: Vec<i64> = Vec()
	for i in 0..1000 {
		val priority = random.below(500)
		queue.push(i, priority)
		pushed.push(priority)
	}
	pushed.sort()
	for expected in pushed {
		assert(queue.pop() is .Some((_, priority)) && priority == expected)
	}
	assert(queue.isEmpty())
}
