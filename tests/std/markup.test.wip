// `std::markup`: HTML and XML built by interpolated literals, each value
// escaped as its place in the page needs: between tags, in a quoted
// attribute's value, in a link, in `<title>`; a link's scheme kept from
// running a script, in any case and across holes; the raw text of a
// `<script>`, which ends at its end tag in any case; joins between tags,
// and nowhere else; and a hole refused wherever a value cannot be written
// safely.

import std::markup::{Html, Xml}

/// A link to `href`, as a page writes it.
fn link(href: str): Html = "<a href=\"\(href)\">x</a>"

@test
fn aValueIsEscapedBetweenTagsAndInAttributes() = {
	val name = "<b>\"Ada\" & 'Bob'</b>"
	val page: Html = "<p title=\"\(name)\" data-x='\(name)'>\(name)</p>"
	assert(
		page.toStr() ==
			"<p title=\"&lt;b&gt;&quot;Ada&quot; &amp; &#39;Bob&#39;&lt;/b&gt;\" data-x='&lt;b&gt;&quot;Ada&quot; &amp; &#39;Bob&#39;&lt;/b&gt;'>&lt;b&gt;&quot;Ada&quot; &amp; &#39;Bob&#39;&lt;/b&gt;</p>",
		page.toStr(),
	)
	val count = 3
	val numbers: Html = "<td>\(count)</td><td>\(2.5, precision: 2)</td>"
	assert(numbers.toStr() == "<td>3</td><td>2.50</td>")
	val title: Html = "<TITLE>\("a<b")</TITLE><textarea>\("</textarea>")</textarea>"
	assert(title.toStr() == "<TITLE>a&lt;b</TITLE><textarea>&lt;/textarea&gt;</textarea>")
}

@test
fn aLiteralWithNoHolesIsHtml() = {
	val br: Html = "<br>"
	assert(br.toStr() == "<br>" && !br.isEmpty() && Html().isEmpty())
	var list = Html()
	list.push("<ul>")
	list.push("</ul>")
	assert(list.toStr() == "<ul></ul>")
}

@test
fn aLinksSchemeRunsNothing() = {
	assert(link("/users/1").toStr() == "<a href=\"/users/1\">x</a>")
	assert(link("https://example.com/a:b").toStr() == "<a href=\"https://example.com/a:b\">x</a>")
	assert(link("HTTP://example.com").toStr() == "<a href=\"HTTP://example.com\">x</a>")
	assert(link("mailto:ada@example.com").toStr() == "<a href=\"mailto:ada@example.com\">x</a>")
	assert(link("javascript:alert(1)").toStr() == "<a href=\"javascript%3Aalert(1)\">x</a>")
	assert(link("JavaScript:alert(1)").toStr() == "<a href=\"JavaScript%3Aalert(1)\">x</a>")
	assert(link(" javascript:x").toStr() == "<a href=\" javascript%3Ax\">x</a>", "a space before")
	assert(link("java\tscript:x").toStr() == "<a href=\"java\tscript%3Ax\">x</a>", "a tab inside")
	assert(link("data:text/html,x").toStr() == "<a href=\"data%3Atext/html,x\">x</a>")
	// A `:` after a `/`, `?` or `#` is a path's, a query's or a fragment's.
	assert(link("a/b:c").toStr() == "<a href=\"a/b:c\">x</a>")
	assert(link("?q=a:b").toStr() == "<a href=\"?q=a:b\">x</a>")
	// A scheme made by two holes, or by the literal and a hole.
	val (first, second) = ("java", "script:alert(1)")
	val split: Html = "<a href=\"\(first)\(second)\">x</a>"
	assert(split.toStr() == "<a href=\"javascript%3Aalert(1)\">x</a>")
	val prefixed: Html = "<img src=\"java\(second)\">"
	assert(prefixed.toStr() == "<img src=\"javascript%3Aalert(1)\">")
	// The literal's own `:` is the program's.
	val ours: Html = "<a href=\"https://\(first):\(second)\">x</a>"
	assert(ours.toStr() == "<a href=\"https://java:script:alert(1)\">x</a>")
	// Any case of the attribute's name, and the others that are links.
	val upper: Html = "<form ACTION=\"\(second)\"><a HREF='\(second)'></a></form>"
	assert(
		upper.toStr() ==
			"<form ACTION=\"script%3Aalert(1)\"><a HREF='script%3Aalert(1)'></a></form>",
	)
	val escaped = link("/a?x=1&y=\"2\"")
	assert(escaped.toStr() == "<a href=\"/a?x=1&amp;y=&quot;2&quot;\">x</a>")
}

@test
fn aScriptsTextEndsAtItsEndTagInAnyCase() = {
	val name = "Ada"
	val page: Html = "<script>if (a < b) { x = '</scr' }</SCRIPT ><p>\(name)</p><style>p > a {}</style>\(name)"
	assert(
		page.toStr() ==
			"<script>if (a < b) { x = '</scr' }</SCRIPT ><p>Ada</p><style>p > a {}</style>Ada",
	)
	val comment: Html = "<!-- a <p> -- in it -->\(name)<!doctype html>\(name)"
	assert(comment.toStr() == "<!-- a <p> -- in it -->Ada<!doctype html>Ada")
	val loose: Html = "a < b \(name)"
	assert(loose.toStr() == "a < b Ada", "a `<` that begins no tag is text")
}

@test
fn htmlIsJoinedBetweenTags() = {
	val inner: Html = "<b>\("x")</b>"
	val outer: Html = "<p>\(inner)</p>"
	assert(outer.toStr() == "<p><b>x</b></p>")
	val pieces: Vec<Html> = [link("/a"), link("/b"), link("/c")]
	val list = Html::joined(&pieces, ", ")
	assert(list.toStr() == "<a href=\"/a\">x</a>, <a href=\"/b\">x</a>, <a href=\"/c\">x</a>")
	assert(Html::joined([], ", ").isEmpty())
	val rendered = Html::trusted("<em>done</em>")
	val wrapped: Html = "<div>\(rendered)</div>"
	assert(wrapped.toStr() == "<div><em>done</em></div>")
	val text = "\(outer)"
	assert(text == "<p><b>x</b></p>", "written out as it is")
	val again: Html = "<p>\(text)</p>"
	assert(again.toStr() == "<p>&lt;p&gt;&lt;b&gt;x&lt;/b&gt;&lt;/p&gt;</p>", "a `String` is text")
}

@test
fn xmlIsEscapedAndHasNoScripts() = {
	val key = "a&b"
	val plist: Xml = "<key>\(key)</key><string attr=\"\(key)\">\("<x>")</string>"
	assert(plist.toStr() == "<key>a&amp;b</key><string attr=\"a&amp;b\">&lt;x&gt;</string>")
	val script: Xml = "<script>\("<x>")</script><a href=\"\("javascript:x")\"/>"
	assert(
		script.toStr() == "<script>&lt;x&gt;</script><a href=\"javascript:x\"/>",
		"XML's are elements",
	)
	val declared: Xml = "<?xml version=\"1.0\"?><!DOCTYPE plist><dict>\(key)</dict>"
	assert(declared.toStr() == "<?xml version=\"1.0\"?><!DOCTYPE plist><dict>a&amp;b</dict>")
	var built = Xml()
	built.push("<array>")
	built.push("<true/>")
	built.push("</array>")
	assert(built.toStr() == "<array><true/></array>")
}

@test(panics = "a hole inside `<script>`")
fn aHoleInAScriptIsRefused() = {
	val page: Html = "<script>var a = \"\("x")\";</script>"
}

@test(panics = "a hole inside `<style>`")
fn aHoleInAStyleIsRefused() = {
	val page: Html = "<STYLE>p { color: \("red") }</STYLE>"
}

@test(panics = "a hole in an `on…` attribute")
fn aHoleInAnEventAttributeIsRefused() = {
	val page: Html = "<a onClick=\"go('\("x")')\">x</a>"
}

@test(panics = "a hole in `style`")
fn aHoleInAStyleAttributeIsRefused() = {
	val page: Html = "<p style=\"color: \("red")\">x</p>"
}

@test(panics = "a hole in `srcset`")
fn aHoleInASourceSetIsRefused() = {
	val page: Html = "<img srcset=\"\("a.png 2x")\">"
}

@test(panics = "a hole in an attribute's value with no quotes")
fn aHoleInAnUnquotedValueIsRefused() = {
	val page: Html = "<p class=\("x")>x</p>"
}

@test(panics = "a hole between a tag's attributes")
fn aHoleBetweenAttributesIsRefused() = {
	val page: Html = "<input \("checked")>"
}

@test(panics = "a hole in a tag's name")
fn aHoleInATagsNameIsRefused() = {
	val page: Html = "<h\(2)>x</h2>"
}

@test(panics = "a hole inside a comment")
fn aHoleInACommentIsRefused() = {
	val page: Html = "<!-- \("x") -->"
}

@test(panics = "HTML joined in `style`")
fn htmlJoinedInAnAttributeIsRefused() = {
	val inner: Html = "<b>x</b>"
	val page: Html = "<p style=\"\(inner)\">x</p>"
}

@test(panics = "HTML joined where its tags would be read as text")
fn htmlJoinedInATitleIsRefused() = {
	val inner: Html = "<b>x</b>"
	val page: Html = "<title>\(inner)</title>"
}

@test(panics = "HTML joined that ends inside a tag")
fn htmlThatEndsInATagIsRefused() = {
	val open: Html = "<a href=\"x\""
	val page: Html = "<p>\(open)</p>"
}

@test(panics = "HTML joined that ends inside a tag, a comment or a script")
fn trustedTextThatEndsInACommentIsRefused() = {
	val rendered = Html::trusted("<p>a</p><!-- left open")
	var page = Html()
	page.push(rendered)
}

@test(panics = "a hole between a tag's attributes")
fn anXmlHoleInATagIsRefused() = {
	val plist: Xml = "<key \("x")/>"
}

@test(panics = "a hole inside `<![CDATA[`")
fn anXmlHoleInCdataIsRefused() = {
	val plist: Xml = "<![CDATA[\("x")]]>"
}
