// `Vec<T>`: what it holds, how it grows, what it does when a value is taken out
// of the middle, and that what it holds ends when it does.

@test
fn vecPushesAndPops() = {
	var numbers: Vec<i64> = Vec()
	assert(numbers.isEmpty(), "a new vector holds nothing")
	assert(numbers.len() == 0)
	numbers.push(1)
	numbers.push(2)
	numbers.push(3)
	assert(numbers.len() == 3)
	assert(!numbers.isEmpty())
	assert(numbers[0] == 1 && numbers[2] == 3, "read by index")
	assert(numbers.at(1) == 2, "or by position")
	assert(numbers.pop() == .Some(3), "the last value comes back out")
	assert(numbers.len() == 2)
	assert(numbers.pop() == .Some(2))
	assert(numbers.pop() == .Some(1))
	assert(numbers.pop().isNone(), "an empty vector pops nothing")
}

@test
fn vecGrowsBeyondItsFirstBlock() = {
	var numbers: Vec<i64> = Vec()
	for n in 0..1000 {
		numbers.push(n)
	}
	assert(numbers.len() == 1000)
	var sum = 0
	for n in numbers {
		sum += n
	}
	assert(sum == 499500, "every value survives the growing, in order")
	assert(numbers[0] == 0 && numbers[999] == 999)
}

@test
fn vecIsMadeFromWhatIsThere() = {
	val numbers = Vec::of(own [3, 1, 2])
	assert(numbers.len() == 3 && numbers[0] == 3 && numbers[2] == 2)
	val filled: Vec<i64> = Vec::filled(4, 7)
	assert(filled.len() == 4)
	for value in filled {
		assert(value == 7, "filled with copies of one value")
	}
	var reserved: Vec<i64> = Vec::withCapacity(100)
	assert(reserved.isEmpty(), "capacity is not length")
	reserved.push(1)
	assert(reserved.len() == 1)
}

@test
fn vecWritesThroughAt() = {
	var numbers = Vec::of(own [1, 2, 3])
	numbers[0] = 10
	numbers.at(1) += 20
	assert(numbers == Vec::of(own [10, 22, 3]), "an element is a place")
	for value in numbers {
		value *= 2
	}
	assert(numbers == Vec::of(own [20, 44, 6]), "and so is each one a walk lends")
}

@test
fn vecRemovesFromTheMiddle() = {
	var numbers = Vec::of(own [1, 2, 3, 4])
	assert(numbers.remove(1) == 2, "removal hands the value over")
	assert(numbers == Vec::of(own [1, 3, 4]), "and what followed moved forward")
	assert(numbers.swapRemove(0) == 1)
	assert(numbers == Vec::of(own [4, 3]), "swapping brings the last value forward")
	numbers.insert(1, 9)
	assert(numbers == Vec::of(own [4, 9, 3]), "and insertion pushes the rest back")
	numbers.insert(0, 8)
	numbers.insert(numbers.len(), 7)
	assert(numbers == Vec::of(own [8, 4, 9, 3, 7]), "at either end too")
}

@test
fn vecTruncatesAndClears() = {
	var numbers = Vec::of(own [1, 2, 3, 4, 5])
	numbers.truncate(2)
	assert(numbers == Vec::of(own [1, 2]), "truncating drops the tail")
	numbers.truncate(5)
	assert(numbers.len() == 2, "truncating to more than it holds does nothing")
	numbers.clear()
	assert(numbers.isEmpty())
	numbers.push(1)
	assert(numbers.len() == 1, "a cleared vector takes values again")
}

@test
fn vecKeepsWhatItIsTold() = {
	var numbers = Vec::of(own [1, 2, 3, 4, 5, 6])
	numbers.retain((n) => n % 2 == 0)
	assert(numbers == Vec::of(own [2, 4, 6]), "the even ones, in their order")
	numbers.retain((n) => false)
	assert(numbers.isEmpty(), "and none of them")
}

@test
fn vecHoldsValuesThatOwnMemory() = {
	var words: Vec<String> = Vec()
	words.push("first")
	words.push("second")
	assert(words.len() == 2)
	assert(words[0] == "first")
	val .Some(taken) = words.pop() else {
		assert(false, "a value to pop")
		return
	}
	assert(taken == "second", "popping hands the memory over")
	words.clear()
	assert(words.isEmpty(), "and clearing ends the rest")
}
