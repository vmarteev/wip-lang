// `Set<K>`: the keys it holds, the order it holds them in, and reading them by
// position.

import std::collections::{Set}

/// The keys of `set`, in the order it holds them.
fn setKeys(set: &Set<str>): Vec<str> = {
	var keys: Vec<str> = Vec()
	for key in set {
		keys.push(key)
	}
	move keys
}

@test
fn setAddsAndFindsKeys() = {
	var seen = Set<str>()
	assert(seen.isEmpty(), "a new set holds nothing")
	assert(seen.len() == 0)
	assert(seen.add("a"), "a key that was not there is new")
	assert(seen.add("b"))
	assert(!seen.add("a"), "a key already there is not")
	assert(seen.len() == 2, "and is not added twice")
	assert(seen.contains("a") && seen.contains("b"))
	assert(!seen.contains("c"))
	assert(!seen.isEmpty())
}

@test
fn setKeepsTheOrderKeysWentIn() = {
	var seen = Set<str>()
	seen.add("c")
	seen.add("a")
	seen.add("b")
	seen.add("a")
	assert(setKeys(&seen) == Vec::of(own ["c", "a", "b"]), "walked in the order they went in")
	assert(seen.at(0) == "c", "read by position")
	assert(seen[1] == "a", "or by index")
	assert(seen.len() == 3)
}

@test
fn setRemovalKeepsTheOrder() = {
	var seen = Set<str>()
	for key in ["a", "b", "c", "d"] {
		seen.add(key)
	}
	assert(seen.remove("b"), "removal says the key was there")
	assert(!seen.remove("b"), "and says a second time that it was not")
	assert(seen.len() == 3)
	assert(!seen.contains("b"))
	assert(setKeys(&seen) == Vec::of(own ["a", "c", "d"]), "what followed moved forward")
	assert(seen.contains("d"), "the keys after it are still found")
}

@test
fn setSwapRemovalTradesTheOrder() = {
	var seen = Set<str>()
	for key in ["a", "b", "c", "d"] {
		seen.add(key)
	}
	assert(seen.swapRemove("b"))
	assert(setKeys(&seen) == Vec::of(own ["a", "d", "c"]), "the last key moved into the gap")
	assert(seen.contains("d") && seen.contains("c"), "both are still found")
	assert(seen.swapRemove("c"), "removing the last key moves nothing")
	assert(setKeys(&seen) == Vec::of(own ["a", "d"]))
}

@test
fn setFindAnswersAPosition() = {
	var seen = Set<str>()
	seen.add("a")
	seen.add("b")
	assert(seen.find("a") == .Some(0))
	assert(seen.find("b") == .Some(1))
	assert(seen.find("c").isNone(), "a key that is not there has no position")
	val .Some(at) = seen.find("b") else {
		assert(false, "the key is there")
		return
	}
	assert(seen.at(at) == "b", "the position reads the key")
}

@test
fn setGrowsBeyondItsFirstTable() = {
	var seen = Set<i64>()
	for n in 0..1000 {
		assert(seen.add(n), "every key is new")
	}
	assert(seen.len() == 1000)
	var found = 0
	for n in 0..1000 {
		if seen.contains(&n) then found += 1
	}
	assert(found == 1000, "every key survives the growing")
	assert(seen[0] == 0 && seen[999] == 999, "in the order they went in")
	for n in 0..500 {
		assert(seen.remove(n * 2))
	}
	assert(seen.len() == 500)
	assert(seen.contains(999), "what is left is still found")
}

@test
fn setClearingKeepsItUsable() = {
	var seen = Set<str>()
	seen.add("a")
	seen.add("b")
	seen.clear()
	assert(seen.isEmpty())
	assert(!seen.contains("a"))
	assert(seen.find("a").isNone())
	assert(seen.add("c"), "a cleared set takes keys again")
	assert(seen.len() == 1 && seen[0] == "c")
}

@test
fn setHoldsKeysThatOwnMemory() = {
	var seen = Set<String>()
	assert(seen.add(String::of("first")))
	assert(seen.add(String::of("second")))
	assert(!seen.add(String::of("first")), "equal keys are one key, whoever owns the bytes")
	assert(seen.len() == 2)
	assert(seen.contains(String::of("second")))
	assert(seen.remove(String::of("first")), "removal ends the key it took out")
	assert(seen.len() == 1)
	seen.clear()
	assert(seen.isEmpty(), "clearing ends every key")
}

/// A key whose hash says nothing: every one of them lands in the same slot,
/// so the set finds them by probing, and a removal leaves a slot that a
/// later probe must still see through.
struct SameKey {
	id: i64
}

extend SameKey: Eq {
	fn equals(other: &SameKey): bool = self.id == other.id
}

extend SameKey: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(0)
}

@test
fn setFindsKeysThatAllCollide() = {
	var seen = Set<SameKey>()
	for n in 0..64 {
		assert(seen.add(SameKey(id: n)), "each key is new")
	}
	assert(seen.len() == 64, "64 keys in one slot are 64 keys")
	for n in 0..64 {
		assert(seen.contains(SameKey(id: n)), "each is found by probing")
		assert(!seen.add(SameKey(id: n)), "and is not added twice")
	}
	for n in 0..32 {
		assert(seen.remove(SameKey(id: n * 2)))
	}
	assert(seen.len() == 32)
	for n in 0..32 {
		assert(seen.contains(SameKey(id: n * 2 + 1)), "the keys that are left are still found")
	}
}

@test
fn setSwapRemovesUnderCollisions() = {
	var seen = Set<SameKey>()
	for n in 0..16 {
		seen.add(SameKey(id: n))
	}
	for n in 0..8 {
		assert(seen.swapRemove(SameKey(id: n)))
	}
	assert(seen.len() == 8)
	for n in 8..16 {
		assert(seen.contains(SameKey(id: n)), "the keys that moved are found where they went")
	}
}

@test
fn setSurvivesChurn() = {
	var seen = Set<i64>()
	for round in 0..40 {
		for n in 0..20 {
			assert(seen.add(round * 100 + n))
		}
		for n in 0..20 {
			assert(seen.remove(round * 100 + n))
		}
		assert(seen.isEmpty(), "each round leaves the set empty")
	}
	assert(seen.add(7), "and it is usable at the end")
	assert(seen.len() == 1)
}

@test
fn setAnswersOnAnEmptyTable() = {
	val seen = Set<str>()
	assert(seen.find("a").isNone(), "a set that never grew holds no key")
	assert(!seen.contains("a"))
	var walked = 0
	for key in seen {
		walked += 1
	}
	assert(walked == 0, "and walks nothing")
}
