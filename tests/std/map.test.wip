// `Map<K, V>`: what it holds, the order it holds it in, and what a lookup that
// may miss answers.

import std::collections::{Map}

@derive(Eq, Hash)
struct Point {
	x: i64
	y: i64
}

/// The keys of `map`, in the order it holds them.
fn mapKeys(map: &Map<str, i64>): Vec<str> = {
	var keys: Vec<str> = Vec()
	for entry in map {
		keys.push(entry.key)
	}
	move keys
}

@test
fn mapPutsAndReadsBack() = {
	var counts = Map<str, i64>()
	assert(counts.isEmpty(), "a new map holds nothing")
	assert(counts.len() == 0)
	counts.put("a", 1)
	counts.put("b", 2)
	assert(!counts.isEmpty())
	assert(counts.len() == 2)
	assert(counts.at("a") == 1)
	assert(counts.at("b") == 2)
	assert(counts.contains("a"))
	assert(!counts.contains("c"), "a key never put is not there")
}

@test
fn mapPuttingAgainReplacesTheValue() = {
	var counts = Map<str, i64>()
	counts.put("a", 1)
	counts.put("a", 7)
	assert(counts.len() == 1, "the same key twice is one entry")
	assert(counts.at("a") == 7, "the second value wins")
}

@test
fn mapWritesThroughAt() = {
	var counts = Map<str, i64>()
	counts.put("a", 1)
	counts.at("a") = 5
	assert(counts.at("a") == 5)
	counts.at("a") += 2
	assert(counts.at("a") == 7, "a map's value is a place")
}

@test
fn mapCountsWithAtOrPut() = {
	var counts = Map<str, i64>()
	val words = ["a", "b", "a", "a", "c", "b"]
	for word in words {
		counts.atOrPut(word, 0) += 1
	}
	assert(counts.len() == 3, "three words, three keys")
	assert(counts.at("a") == 3)
	assert(counts.at("b") == 2)
	assert(counts.at("c") == 1)
}

@test
fn mapKeepsTheOrderKeysWentIn() = {
	var counts = Map<str, i64>()
	counts.put("c", 3)
	counts.put("a", 1)
	counts.put("b", 2)
	assert(mapKeys(&counts) == Vec::of(own ["c", "a", "b"]), "walked in the order they went in")
	assert(counts.keyAt(0) == "c")
	assert(counts.valueAt(2) == 2)
	// Putting a key again leaves it where it was.
	counts.put("c", 30)
	assert(mapKeys(&counts) == Vec::of(own ["c", "a", "b"]))
	assert(counts.valueAt(0) == 30)
}

@test
fn mapRemovalKeepsTheOrder() = {
	var counts = Map<str, i64>()
	for (key, value) in [("a", 1), ("b", 2), ("c", 3), ("d", 4)] {
		counts.put(key, value)
	}
	assert(counts.remove("b") == .Some(2), "removal answers the value it held")
	assert(counts.len() == 3)
	assert(!counts.contains("b"))
	assert(mapKeys(&counts) == Vec::of(own ["a", "c", "d"]), "what followed moved forward")
	assert(counts.at("c") == 3, "the keys after it are still found")
	assert(counts.at("d") == 4)
	assert(counts.remove("b").isNone(), "removing a key twice answers nothing")
}

@test
fn mapSwapRemovalTradesTheOrder() = {
	var counts = Map<str, i64>()
	for (key, value) in [("a", 1), ("b", 2), ("c", 3), ("d", 4)] {
		counts.put(key, value)
	}
	assert(counts.swapRemove("b") == .Some(2))
	assert(counts.len() == 3)
	assert(mapKeys(&counts) == Vec::of(own ["a", "d", "c"]), "the last key moved into the gap")
	assert(counts.at("d") == 4, "the key that moved is still found")
	assert(counts.at("c") == 3)
	// Removing the last entry moves nothing.
	assert(counts.swapRemove("c") == .Some(3))
	assert(mapKeys(&counts) == Vec::of(own ["a", "d"]))
}

@test
fn mapFindAnswersAPosition() = {
	var counts = Map<str, i64>()
	counts.put("a", 1)
	counts.put("b", 2)
	assert(counts.find("a") == .Some(0))
	assert(counts.find("b") == .Some(1))
	assert(counts.find("c").isNone(), "a key that is not there has no position")
	val .Some(at) = counts.find("b") else {
		assert(false, "the key is there")
		return
	}
	assert(counts.keyAt(at) == "b")
	assert(counts.valueAt(at) == 2)
	counts.valueAt(at) = 20
	assert(counts.at("b") == 20, "a position is a place to write through")
}

@test
fn mapWalksAndWritesValues() = {
	var counts = Map<str, i64>()
	counts.put("a", 1)
	counts.put("b", 2)
	counts.put("c", 3)
	assert(counts.values().len() == 3)
	var total = 0
	for value in counts.values() {
		total += value
	}
	assert(total == 6, "the values, walked")
	for value in counts.values() {
		value *= 10
	}
	assert(
		counts.at("a") == 10 && counts.at("b") == 20 && counts.at("c") == 30,
		"walked in a var, written",
	)
}

@test
fn mapGrowsBeyondItsFirstTable() = {
	var squares = Map<i64, i64>()
	for n in 0..1000 {
		squares.put(n, n * n)
	}
	assert(squares.len() == 1000)
	var found = 0
	for n in 0..1000 {
		if squares.at(&n) == n * n then found += 1
	}
	assert(found == 1000, "every key survives the growing")
	assert(squares.keyAt(0) == 0 && squares.keyAt(999) == 999, "in the order they went in")
	for n in 0..500 {
		assert(squares.remove(n * 2) == .Some(n * 2 * n * 2))
	}
	assert(squares.len() == 500)
	assert(squares.at(999) == 999 * 999, "what is left is still found")
}

@test
fn mapClearingKeepsItUsable() = {
	var counts = Map<str, i64>()
	counts.put("a", 1)
	counts.put("b", 2)
	counts.clear()
	assert(counts.isEmpty())
	assert(counts.len() == 0)
	assert(!counts.contains("a"))
	assert(counts.find("a").isNone())
	counts.put("c", 3)
	assert(counts.len() == 1 && counts.at("c") == 3, "a cleared map takes keys again")
}

@test
fn mapHoldsKeysAndValuesThatOwnMemory() = {
	var names = Map<String, String>()
	names.put("first", "Ada")
	names.put("second", "Grace")
	assert(names.at("first") == "Ada")
	val .Some(taken) = names.remove("second") else {
		assert(false, "the key is there")
		return
	}
	assert(taken == "Grace", "removal hands the value over")
	assert(names.len() == 1)
	names.clear()
	assert(names.isEmpty(), "clearing ends every key and value")
}

@test
fn mapTakesAKeyOfItsOwnMaking() = {
	var seen = Map<Point, i64>()
	seen.put(Point(x: 1, y: 2), 12)
	seen.put(Point(x: 2, y: 1), 21)
	assert(seen.at(Point(x: 1, y: 2)) == 12, "a derived hash and equality are enough")
	assert(seen.at(Point(x: 2, y: 1)) == 21)
	assert(!seen.contains(Point(x: 3, y: 3)))
}

/// A key whose hash says nothing: every one of them lands in the same slot,
/// so the map finds them by probing, and a removal leaves a slot that a
/// later probe must still see through.
struct Same {
	id: i64
}

extend Same: Eq {
	fn equals(other: &Same): bool = self.id == other.id
}

extend Same: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(0)
}

@test
fn mapFindsKeysThatAllCollide() = {
	var ids = Map<Same, i64>()
	for n in 0..64 {
		ids.put(Same(id: n), n * 3)
	}
	assert(ids.len() == 64, "64 keys in one slot are 64 entries")
	for n in 0..64 {
		assert(ids.contains(Same(id: n)), "each is found by probing")
		assert(ids.at(Same(id: n)) == n * 3)
	}
	// Removing every other key leaves slots a probe must see through.
	for n in 0..32 {
		assert(ids.remove(Same(id: n * 2)) == .Some(n * 2 * 3))
	}
	assert(ids.len() == 32)
	for n in 0..32 {
		assert(
			ids.at(Same(id: n * 2 + 1)) == (n * 2 + 1) * 3,
			"the keys that are left are still found",
		)
	}
}

@test
fn mapSurvivesChurn() = {
	var counts = Map<i64, i64>()
	// Put and take out the same keys many times over: the table fills with
	// slots marked removed, and must be rebuilt rather than grow forever.
	for round in 0..40 {
		for n in 0..20 {
			counts.put(round * 100 + n, n)
		}
		for n in 0..20 {
			assert(counts.at(round * 100 + n) == n)
			assert(counts.remove(round * 100 + n) == .Some(n))
		}
		assert(counts.isEmpty(), "each round leaves the map empty")
	}
	counts.put(7, 7)
	assert(counts.len() == 1 && counts.at(7) == 7, "and usable at the end")
}

@test
fn mapAnswersOnAnEmptyTable() = {
	val counts = Map<str, i64>()
	assert(counts.find("a").isNone(), "a map that never grew holds no key")
	assert(!counts.contains("a"))
	var walked = 0
	for entry in counts {
		walked += 1
	}
	assert(walked == 0, "and walks nothing")
}

@test
fn mapSwapRemovesUnderCollisions() = {
	var ids = Map<Same, i64>()
	for n in 0..16 {
		ids.put(Same(id: n), n)
	}
	// The entry that moves into the gap is found by its own key, through
	// the slot the removed key left behind.
	for n in 0..8 {
		assert(ids.swapRemove(Same(id: n)) == .Some(n))
	}
	assert(ids.len() == 8)
	for n in 8..16 {
		assert(ids.at(Same(id: n)) == n, "the keys that moved are found where they went")
	}
	for n in 0..8 {
		assert(!ids.contains(Same(id: n)), "and the ones taken out are gone")
	}
}

@test
fn mapGroupsIntoValuesThatOwnMemory() = {
	// What grouping is written with: the vector is made where the key is
	// new, and the one already there is pushed into.
	var byLength = Map<i64, Vec<str>>()
	for word in ["a", "bb", "cc", "ddd", "e"] {
		byLength.atOrPut(word.len(), Vec<str>()).push(word)
	}
	assert(byLength.len() == 3, "three lengths")
	assert(byLength.at(1) == Vec::of(own ["a", "e"]))
	assert(byLength.at(2) == Vec::of(own ["bb", "cc"]))
	assert(byLength.at(3).len() == 1)
	val .Some(taken) = byLength.remove(2) else {
		assert(false, "the key is there")
		return
	}
	assert(taken.len() == 2, "removal hands the vector over, memory and all")
}

@test
fn mapGetAnswersTheValueByReference() = {
	var ages = Map<String, i64>()
	ages.put(String::of("ann"), 31)
	var key = String::of("ann")
	val found = ages.get(&key)
	key.clear()
	assert(found == .Some(&31), "what was found does not borrow the key")
	assert(ages.get(&key).isNone())
}

// A move analysis's state, kept in maps, compared to find its fixed point.
@derive(Eq)
struct State {
	moved: Map<String, i64>
}

// Two maps are equal with the same keys and equal values under them,
// whatever order the keys went in; a struct holding one derives `Eq`.
@test
fn mapsAreEqualByWhatTheyHoldNotTheOrder() = {
	var a: Map<String, i64> = Map()
	a.put("x", 1)
	a.put("y", 2)
	var b: Map<String, i64> = Map()
	b.put("y", 2)
	b.put("x", 1)
	assert(a == b, "the same entries, in another order")
	b.put("x", 3)
	assert(a != b, "a value differs")
	b.put("x", 1)
	b.put("z", 0)
	assert(a != b, "one has a key more")
	b.remove("z")
	assert(a == b)
	val empty: Map<String, i64> = Map()
	assert(empty == Map<String, i64>() && empty != a)
	val first = State(moved: a.clone())
	val second = State(moved: move b)
	assert(first == second)
}

// Keys that differ only in their high bits, and keys counted out, each
// found again: the hash turns what it mixed into the high bits down to
// the low ones a map finds its slot by.
@test
fn keysThatDifferHighUpAreFoundApart() = {
	var spaced: Map<u64, i64> = Map()
	for i in 0..5000 {
		spaced.put((i as u64) << 40, i)
	}
	var counted: Map<i64, i64> = Map()
	for i in 0..5000 {
		counted.put(i * 4096, i)
	}
	for i in 0..5000 {
		assert(spaced.at((i as u64) << 40) == i && counted.at(i * 4096) == i)
	}
	assert(spaced.len() == 5000 && !spaced.contains((1 as u64) << 39))
	var words: Map<String, i64> = Map()
	for i in 0..2000 {
		words.put("a key long enough for two words \(i)", i)
	}
	assert(words.at("a key long enough for two words 1999") == 1999)
	assert(!words.contains("a key long enough for two words "))
}
