// `Option::get`: the value lent where it lies, to read or
// to write, where `unwrap` takes it out; `asRef`, the
// value lent as a view; `unwrap` of nothing, which panics; and
// `Option::collect` and `Result::collect`, every value or the first that
// fails.

@test
fn anOptionLendsWhatItHolds() = {
	var held: Option<String> = .Some("kept")
	assert(held.get().len() == 4, "read where it lies")
	held.get().push("!")
	assert(held == .Some("kept!"), "and written there")
}

@test
fn anOptionLendsItsValueAsAView() = {
	// `asRef` lends the value, and `map` makes what it looks at:
	// an `Option<String>` seen as an `Option<str>`.
	val host: Option<String> = .Some("example.com")
	val name = host.asRef().map((h) => h.toStr())
	assert(name == .Some("example.com"))
	val none: Option<String> = .None
	assert(none.asRef().map((h) => h.toStr()).isNone())
	assert(host.isSome(), "and the option still holds its value")
}

@test(panics = "unwrap of an Option that holds nothing")
fn nothingIsNotUnwrapped() = {
	val nothing: Option<i64> = .None
	nothing.unwrap()
}

@test
fn everyValueOrTheFirstFailure() = {
	val numbers = ["1", "2", "3"]
	assert(Result::collect(numbers.copies().map((n) => n.toInt())).unwrap() == [1, 2, 3].toVec())
	val mixed = ["1", "x", "3"]
	assert(Result::collect(mixed.copies().map((n) => n.toInt())).isErr())
	val present: [Option<i64>; 2] = [.Some(1), .Some(2)]
	assert(Option::collect(present.copies()) == .Some([1, 2].toVec()))
	val gap: [Option<i64>; 2] = [.Some(1), .None]
	assert(Option::collect(gap.copies()).isNone())
}

/// Counts what a closure that writes is given.
struct Tally {
	count: i64 = 0
}

extend Tally {
	var fn seen(n: i64): i64 = {
		self.count += 1
		return n
	}
}

@test
fn anOptionsAndAResultsFunctionsTakeAClosureThatWrites() = {
	var calls = Tally()
	val some: Option<i64> = .Some(2)
	assert(some.map((n) => calls.seen(n) + 1) == .Some(3))
	assert(some.flatMap((n) => Option::Some(calls.seen(n))) == .Some(2))
	assert(some.filter((n) => calls.seen(n) > 1) == .Some(2))
	assert(some.fold(() => 0, (n) => calls.seen(n)) == 2)
	assert(some.any((n) => calls.seen(n) == 2) && some.all((n) => calls.seen(n) == 2))
	some.forEach((n) => { calls.seen(n) })
	assert(calls.count == 7)
	val ok: Result<i64, i64> = .Ok(5)
	val failed: Result<i64, i64> = .Err(1)
	assert(ok.map((n) => calls.seen(n)) == .Ok(5))
	assert(failed.mapErr((e) => calls.seen(e) + 1) == .Err(2))
	assert(ok.flatMap((n) => Result<i64, i64>::Ok(calls.seen(n))) == .Ok(5))
	assert(failed.fold((e) => calls.seen(e), (n) => n) == 1)
	assert(ok.any((n) => calls.seen(n) == 5) && ok.all((n) => calls.seen(n) == 5))
	ok.forEach((n) => { calls.seen(n) })
	assert(calls.count == 14)
}
