// How many columns a character takes on a terminal: what
// a combining mark, a control, a wide character and an emoji take, and a
// text as the sum of its characters.

@test
fn aCharacterTakesTheColumnsATerminalGivesIt() = {
	assert('a'.width() == 1)
	assert('é'.width() == 1, "a letter with its accent built in")
	assert('\u{301}'.width() == 0, "a combining accent draws on the one before")
	assert('\t'.width() == 0, "a control is not shown")
	assert('\u{7F}'.width() == 0)
	assert('中'.width() == 2)
	assert('😀'.width() == 2)
	assert('\u{200D}'.width() == 0, "a joiner draws nothing")
	assert('\u{AD}'.width() == 1, "a soft hyphen shows a mark, as termbox2 draws it")
	assert('ｱ'.width() == 1, "halfwidth katakana are narrow")
	assert('\u{1160}'.width() == 0, "a medial jamo joins the syllable before")
	assert('\u{E000}'.width() == 1, "a private use character, as a Nerd Font's icon")
}

@test
fn aTextTakesItsCharactersColumns() = {
	assert("".width() == 0)
	assert("héllo".width() == 5)
	assert("中文名".width() == 6)
	assert("e\u{301}".width() == 1, "a letter and a combining accent")
	assert("😀 ok".width() == 5)
	assert("한국어".width() == 6)
}
