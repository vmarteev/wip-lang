// Walking, and what a walk can be made to do:
// the adapters, which answer another iterator, and the consumers, which
// walk one to its end. And what a slice answers about itself: where a value
// is, which is smallest, and whether it is in order.

import std::collections::{Map}
import std::iter::{Walk}
import std::random::{Random}

/// Counts down to one: an iterator that is not a view.
struct Countdown {
	left: i64
}

extend Countdown: Iterator<i64> {
	var fn next(): Option<i64> = {
		if self.left == 0 then return .None
		self.left -= 1
		.Some(self.left + 1)
	}
}

@test
fn iterWalksToTheEnd() = {
	var seen: Vec<i64> = Vec()
	for n in (Countdown(left: 3)) {
		seen.push(n)
	}
	assert(seen == Vec::of(own [3, 2, 1]), "every element, in order")
	assert(Countdown(left: 5).count() == 5, "counted by walking")
	assert(Countdown(left: 0).count() == 0, "an iterator that is done at once")
	assert(Countdown(left: 3).toVec() == Vec::of(own [3, 2, 1]), "collected")
}

@test
fn iterWalksASlice() = {
	val numbers = [1, 2, 3, 4]
	assert(Walk::of(&numbers).count() == 4)
	assert(numbers.walk().toVec() == Vec::of(own [1, 2, 3, 4]), "a slice goes through the adapters")
	var total = 0
	for n in numbers.walk().skip(1) {
		total += n
	}
	assert(total == 9)
}

@test
fn iterMapsAndFilters() = {
	val doubled = Countdown(left: 4).map(own (n) => n * 2).toVec()
	assert(doubled == Vec::of(own [8, 6, 4, 2]))
	val even = Countdown(left: 6).filter(own (n) => n % 2 == 0).toVec()
	assert(even == Vec::of(own [6, 4, 2]), "the ones kept, in their order")
	val none = Countdown(left: 3).filter(own (n) => false).toVec()
	assert(none.isEmpty(), "filtering everything out leaves nothing")
}

@test
fn iterTakesSkipsAndEnumerates() = {
	assert(Countdown(left: 5).take(2).toVec() == Vec::of(own [5, 4]))
	assert(Countdown(left: 5).skip(3).toVec() == Vec::of(own [2, 1]))
	assert(Countdown(left: 2).take(9).toVec() == Vec::of(own [2, 1]), "taking more than there is")
	assert(Countdown(left: 2).skip(9).toVec().isEmpty(), "skipping more than there is")
	var pairs: Vec<i64> = Vec()
	for (i, n) in (Countdown(left: 3)).enumerate() {
		pairs.push(i * 10 + n)
	}
	assert(pairs == Vec::of(own [3, 12, 21]), "each element with its place, counted from 0")
}

@test
fn iterZipsToTheShorter() = {
	var seen: Vec<i64> = Vec()
	for (a, b) in (Countdown(left: 3)).zip(Countdown(left: 5)) {
		seen.push(a * 10 + b)
	}
	assert(seen == Vec::of(own [35, 24, 13]), "pairs until the shorter one is done")
	assert(Countdown(left: 3).zip(Countdown(left: 0)).count() == 0)
}

@test
fn iterAnswersAboutItsElements() = {
	assert(Countdown(left: 5).find((n) => n % 2 == 0) == .Some(4), "the first that fits")
	assert(Countdown(left: 5).find((n) => n > 9).isNone())
	assert(Countdown(left: 5).any((n) => n == 3))
	assert(!Countdown(left: 5).any((n) => n == 9))
	assert(Countdown(left: 5).all((n) => n > 0))
	assert(!Countdown(left: 5).all((n) => n > 1))
	assert(Countdown(left: 0).all((n) => false), "everything holds of nothing")
	assert(!Countdown(left: 0).any((n) => true), "and nothing holds of it")
}

@test
fn iterChainsAdapters() = {
	val text = "the quick brown fox jumps"
	val long = text.split(" ").filter(own (w) => w.len() > 3).map(own (w) => w.len()).toVec()
	assert(long == Vec::of(own [5, 5, 5]), "quick, brown and jumps")
	var built = String()
	for c in "abc".chars().map(own (c) => c.toAsciiUpper()) {
		built.pushChar(c)
	}
	assert(built == "ABC")
}

@test
fn sliceFindsWhatItHolds() = {
	val numbers = [3, 1, 4, 1, 5]
	assert(numbers.indexOf(1) == .Some(1), "the first one")
	assert(numbers.indexOf(9).isNone())
	assert(numbers.contains(4))
	assert(!numbers.contains(9))
	assert(numbers.minIndex() == .Some(1), "the first smallest")
	assert(numbers.maxIndex() == .Some(4))
	val empty: [i64; 0] = []
	assert(empty.minIndex().isNone(), "nothing is smallest in nothing")
	assert(numbers.countWhere((n) => n == 1) == 2)
}

@test
fn sliceSortsInPlace() = {
	var numbers = Vec::of(own [3, 1, 4, 1, 5, 9, 2, 6])
	assert(!numbers.isSorted())
	numbers.sort()
	assert(numbers == Vec::of(own [1, 1, 2, 3, 4, 5, 6, 9]), "in order")
	assert(numbers.isSorted())
	numbers.sortBy((a, b) => a > b)
	assert(numbers == Vec::of(own [9, 6, 5, 4, 3, 2, 1, 1]), "or in the order it is given")
	var one = Vec::of(own [7])
	one.sort()
	assert(one == Vec::of(own [7]) && one.isSorted(), "one value is in order")
	var none: Vec<i64> = Vec()
	none.sort()
	assert(none.isSorted(), "and so is none")
}

@test
fn sortsTextsAndKeepsThemSorted() = {
	var words = Vec::of(own ["pear", "apple", "fig"])
	words.sort()
	assert(words == Vec::of(own ["apple", "fig", "pear"]), "texts in their own order")
	assert(words.isSorted())
	var many: Vec<i64> = Vec()
	for n in 0..500 {
		many.push((n * 7919) % 1000)
	}
	many.sort()
	assert(many.isSorted(), "500 values, sorted")
	assert(many.len() == 500, "and none lost")
}

struct Person {
	name: String
	age: i64
}

// Equals keep the order they came in, by key and by a given order, over
// elements that own memory: sorted by name and then by age, the people of
// one age are in the order of their names.
@test
fn aSortKeepsEqualsInTheOrderTheyCame() = {
	var people: Vec<Person> = Vec()
	for (name, age) in [("dan", 30), ("ann", 40), ("cy", 30), ("bo", 40), ("eve", 30)] {
		people.push(Person(name: name, age: age))
	}
	people.sortByKey((p) => p.name.toString())
	people.sortByKey((p) => p.age)
	val names = people.forwards().map(own (p) => p.name.toString()).toVec()
	assert(
		names == Vec::of(own ["cy", "dan", "eve", "ann", "bo"]),
		"by age, and by name among equals",
	)
	people.sortBy((a, b) => a.age > b.age)
	assert(people[0].name == "ann" && people[2].name == "cy", "the order given, equals kept")
}

// Every length about where insertion gives way to merging, and a large
// input of many equal values, sorted as the unstable sort sorts them.
@test
fn aSortOfAnyLengthAgreesWithTheUnstableOne() = {
	var random = Random::seeded(7)
	for count in 0..70 {
		var values: Vec<i64> = Vec()
		for _ in 0..count {
			values.push(random.below(10))
		}
		var unstable = values.clone()
		values.sort()
		unstable.sortUnstable()
		assert(values == unstable, "\(count) values")
	}
	var many: Vec<String> = Vec()
	for _ in 0..5000 {
		many.push("\(random.below(300))")
	}
	var unstable = many.clone()
	many.sort()
	unstable.sortUnstable()
	assert(many == unstable && many.isSorted(), "5000 texts that own memory")
	var tagged: Vec<(i64, i64)> = Vec()
	for i in 0..3000 {
		tagged.push((random.below(20), i))
	}
	tagged.sortByKey((pair) => pair.0)
	for i in 1..tagged.len() {
		if tagged[i - 1].0 == tagged[i].0 then
			assert(tagged[i - 1].1 < tagged[i].1, "equals in order")
	}
}

// Runs of equal neighbours, each kept once, by the value and by a key.
@test
fn dedupKeepsTheFirstOfEachRun() = {
	var words: Vec<String> = Vec::of(own ["a", "a", "b", "a", "c", "c", "c"])
	words.dedup()
	assert(words == Vec::of(own ["a", "b", "a", "c"]), "neighbours only")
	var numbers = Vec::of(own [3, 1, 3, 2, 1])
	numbers.sort()
	numbers.dedup()
	assert(numbers == Vec::of(own [1, 2, 3]), "sorted, each once")
	var sized: Vec<String> = Vec::of(own ["ab", "cd", "e", "fg", "hi"])
	sized.dedupBy((w) => w.len())
	assert(sized == Vec::of(own ["ab", "e", "fg"]), "the first of each length run")
	var none: Vec<i64> = Vec()
	none.dedup()
	assert(none.isEmpty())
}

@test
fn aPeekableLooksAtTheNextElementBeforeItIsTaken() = {
	var it = "12ab".chars().peekable()
	var digits = 0
	while it.peek() is .Some(c) && c.isDigit() {
		digits += 1
		it.next()
	}
	assert(digits == 2, "the letters were looked at, not taken")
	assert(it.peek() == .Some(&'a') && it.peek() == .Some(&'a'), "looking twice takes nothing")
	assert(it.next() == .Some('a') && it.next() == .Some('b'))
	assert(it.peek().isNone() && it.next().isNone())
}

@test
fn aPeekableLooksAtElementsThatOwnMemory() = {
	var words: Vec<String> = Vec()
	words.push("one")
	words.push("two")
	var it = (move words).intoIterator().peekable()
	val one = String::of("one")
	assert(it.peek() == .Some(&one), "the element itself, not a copy")
	assert(it.next() == .Some("one"))
	assert(it.count() == 1)
}

// A list walked from the first to the last, each element lent where it
// lies: with its index, in step with another, searched and mapped, over
// elements that own memory.
@test
fn aListIsWalkedForwards() = {
	val names: Vec<String> = Vec::of(own ["ann", "bo", "cy"])
	var seen = String()
	for (index, name) in names.forwards().enumerate() {
		seen.push("\(index)\(name)")
	}
	assert(seen == "0ann1bo2cy", "elements that own memory, lent rather than copied")
	val sizes = [3, 2, 2]
	var matched = 0
	for (name, size) in names.forwards().zip(sizes.forwards()) {
		if name.len() == size then matched += 1
	}
	assert(matched == 3, "two lists in step")
	assert(names.forwards().find((name) => name.startsWith("b")).isSome(), "the first that holds")
	assert(names.forwards().map(own (name) => name.len()).toVec() == Vec::of(own [3, 2, 2]))
	val numbers = [1, 2, 3]
	assert(numbers.forwards().find((n) => n > 1) == .Some(&2))
	val none: Vec<String> = Vec()
	assert(none.forwards().count() == 0)
}

// A list walked from the last to the first, each element lent where it
// lies.
@test
fn aListIsWalkedBackwards() = {
	val names = Vec::of(own ["a", "b", "c"])
	var seen = String()
	for name in names.backwards() {
		seen.push(name)
	}
	assert(seen == "cba", "elements that own memory, lent rather than copied")
	val numbers = [1, 2, 3]
	assert(numbers.backwards().map(own (n) => n * 10).toVec() == Vec::of(own [30, 20, 10]))
	assert(numbers.backwards().enumerate().find((pair) => pair.1 == 1).isSome())
	assert(numbers.backwards().find((n) => n < 3) == .Some(&2), "the last that holds")
	val none: Vec<i64> = Vec()
	assert(none.backwards().count() == 0)
}

// An adapter that keeps what its closure makes of an element, where it
// makes something: numbers read from words, the others passed over.
@test
fn filterMapKeepsWhatItMakesSomethingOf() = {
	val numbers = "1 x 22 y 333".split(" ").filterMap(own (word) => word.toInt().toOption()).toVec()
	assert(numbers == Vec::of(own [1, 22, 333]))
	val none = "a b".split(" ").filterMap(own (word) => word.toInt().toOption()).toVec()
	assert(none.isEmpty())
}

// One iterator after another, and an iterator made of each element walked
// in turn, over elements that own memory.
@test
fn chainAndFlatMapWalkOneAfterAnother() = {
	val words: Vec<String> = "a b".split(" ").
		chain("c".split(" ")).
		map(own (w) => w.toString()).
		toVec()
	assert(words.len() == 3 && words[2] == "c")
	val letters = "ab cd".split(" ").flatMap(own (word) => word.chars()).toVec()
	assert(letters == Vec::of(own ['a', 'b', 'c', 'd']))
	val empty = "".split(" ").filter(own (w) => !w.isEmpty()).flatMap(own (w) => w.chars()).count()
	assert(empty == 0)
	val owned: Vec<String> = Vec::of(own ["x y", "z"])
	val pieces = owned.intoIterator().
		flatMap(own (line) => line.toStr().
			split(" ").
			map(own (w) => w.toString()).
			toVec().
			intoIterator()).
		toVec()
	assert(pieces.len() == 3 && pieces[1] == "y")
}

// Iterators of iterators walked as one, over elements that own memory, and
// an empty one among them.
@test
fn flattenWalksEachElementInTurn() = {
	val rows: Vec<Vec<String>> = Vec::of(own [
		Vec::of(own ["a".toString(), "b".toString()]),
		Vec(),
		Vec::of(own ["c".toString()]),
	])
	val all = rows.intoIterator().map(own (row) => row.intoIterator()).flatten().toVec()
	assert(all.len() == 3 && all[0] == "a" && all[2] == "c")
	val letters = "ab cd".split(" ").map(own (word) => word.chars()).flatten().count()
	assert(letters == 4)
}

// The elements up to the first that fails, and none after it, though a
// later one would pass.
@test
fn takeWhileStopsAtTheFirstThatFails() = {
	val digits = "12a34".chars().takeWhile(own (c) => c.isDigit()).toVec()
	assert(digits == Vec::of(own ['1', '2']))
	assert("abc".chars().takeWhile(own (c) => c.isDigit()).count() == 0)
}

// An element by where it is, the last, and where the first that holds is.
@test
fn nthLastAndPositionFindAnElement() = {
	var it = "a b c d".split(" ")
	assert(it.nth(1) == .Some("b"), "those before it passed over")
	assert(it.next() == .Some("c"), "and the iterator goes on after it")
	assert("a b".split(" ").nth(5).isNone())
	assert("a b c".split(" ").last() == .Some("c"))
	assert("".split(",").filter(own (w) => !w.isEmpty()).last().isNone())
	assert("a b c".split(" ").position((w) => w == "c") == .Some(2))
	assert("a b".split(" ").position((w) => w == "z").isNone())
}

// What a closure makes of the first element it makes something of, and a
// closure run on each element.
@test
fn findMapAndForEachGiveEachElement() = {
	assert("x 7 8".split(" ").findMap((w) => w.toInt().toOption()) == .Some(7))
	assert("x y".split(" ").findMap((w) => w.toInt().toOption()).isNone())
	var total = 0
	"1 2 3".split(" ").forEach((w) => { total += w.toInt().unwrap() })
	assert(total == 6)
}

// The elements in a set, each once, and pairs in a map, a later value for
// a key in the place of an earlier.
@test
fn toSetAndFromPairsCollect() = {
	val seen = "b a b c a".split(" ").map(own (w) => w.toString()).toSet()
	assert(seen.len() == 3 && seen.contains("a"))
	val names: Vec<String> = Vec::of(own ["ann", "bo", "ann"])
	val ages = [30, 40, 31]
	val byName: Map<String, i64> = Map::fromPairs(names.intoIterator().zip(ages.walk()))
	assert(byName.len() == 2 && byName.at("ann") == 31 && byName.at("bo") == 40)
}
