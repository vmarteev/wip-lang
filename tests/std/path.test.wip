// `std::path` takes a path apart and puts one together as text, and
// `fs::realPath` asks the disk where one is.

import std::fs
import std::path

@test
fn aPathIsJoined() = {
	assert(path::join("/a", "b") == "/a/b")
	assert(path::join("/a/", "b") == "/a/b")
	assert(path::join("/", "b") == "/b")
	assert(path::join("a", "b/c") == "a/b/c")
	assert(path::join("", "b") == "b")
	assert(path::join("/a", "/etc") == "/etc")
}

@test
fn aPathIsTakenApartAtItsSlashes() = {
	assert(path::name("/a/b/c.txt") == "c.txt")
	assert(path::name("/a/b/") == "b")
	assert(path::name("c") == "c")
	assert(path::name("/") == "")
	assert(path::parent("/a/b/c.txt") == "/a/b")
	assert(path::parent("/a/b/") == "/a")
	assert(path::parent("/a") == "/")
	assert(path::parent("/") == "/")
	assert(path::parent("c") == ".")
	assert(path::parent("a/b") == "a")
}

@test
fn anExtensionFollowsTheLastDotOfTheName() = {
	assert(path::extension("/a/c.tar.gz") == .Some("gz"))
	assert(path::extension("notes.") == .Some(""))
	assert(path::extension("/a.d/README").isNone())
	assert(path::extension(".bashrc").isNone())
	assert(path::extension("..").isNone())
	assert(path::stem("/a/c.tar.gz") == "c.tar")
	assert(path::stem(".bashrc") == ".bashrc")
	assert(path::stem("README") == "README")
}

@test
fn withinIsNameByName() = {
	assert(path::isWithin("/a/b", "/a"))
	assert(path::isWithin("/a", "/a/"))
	assert(!path::isWithin("/ab", "/a"))
	assert(!path::isWithin("/a", "/a/b"))
	assert(path::isWithin("/anything", "/"))
	assert(path::isWithin("a/b", "a"))
}

@test
fn aRealPathIsAbsoluteAndPlain() = {
	val .Ok(here) = fs::realPath(".") else {
		assert(false, "the directory the tests run in is there")
		return
	}
	assert(here.toStr().startsWith("/"))
	val .Ok(again) = fs::realPath("./tests/../tests/std") else {
		assert(false, "and so is this one")
		return
	}
	assert(again.toStr().endsWith("/tests/std"))
	assert(fs::realPath("./no such thing").isErr())
}
