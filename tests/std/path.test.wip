// `std::path` takes a path apart, cleans it, matches it with a glob and
// puts one together, as text, and `fs::realPath` asks the disk where one
// is.

import std::fs
import std::path

@test
fn aPathIsJoined() = {
	assert(path::join("/a", "b") == "/a/b")
	assert(path::join("/a/", "b") == "/a/b")
	assert(path::join("/", "b") == "/b")
	assert(path::join("a", "b/c") == "a/b/c")
	assert(path::join("", "b") == "b")
	assert(path::join("/a", "/etc") == "/etc")
}

@test
fn aPathIsTakenApartAtItsSlashes() = {
	assert(path::name("/a/b/c.txt") == "c.txt")
	assert(path::name("/a/b/") == "b")
	assert(path::name("c") == "c")
	assert(path::name("/") == "")
	assert(path::parent("/a/b/c.txt") == "/a/b")
	assert(path::parent("/a/b/") == "/a")
	assert(path::parent("/a") == "/")
	assert(path::parent("/") == "/")
	assert(path::parent("c") == ".")
	assert(path::parent("a/b") == "a")
}

@test
fn anExtensionFollowsTheLastDotOfTheName() = {
	assert(path::extension("/a/c.tar.gz") == "gz")
	assert(path::extension("notes.") == "")
	assert(path::extension("/a.d/README").isNone())
	assert(path::extension(".bashrc").isNone())
	assert(path::extension("..").isNone())
	assert(path::stem("/a/c.tar.gz") == "c.tar")
	assert(path::stem(".bashrc") == ".bashrc")
	assert(path::stem("README") == "README")
}

@test
fn withinIsNameByName() = {
	assert(path::isWithin("/a/b", "/a"))
	assert(path::isWithin("/a", "/a/"))
	assert(!path::isWithin("/ab", "/a"))
	assert(!path::isWithin("/a", "/a/b"))
	assert(path::isWithin("/anything", "/"))
	assert(path::isWithin("a/b", "a"))
}

@test
fn aRealPathIsAbsoluteAndPlain() = {
	val .Ok(here) = fs::realPath(".") else {
		assert(false, "the directory the tests run in is there")
		return
	}
	assert(here.toStr().startsWith("/"))
	val .Ok(again) = fs::realPath("./tests/../tests/std") else {
		assert(false, "and so is this one")
		return
	}
	assert(again.toStr().endsWith("/tests/std"))
	assert(fs::realPath("./no such thing").isErr())
}

@test
fn aPathIsWrittenPlainly() = {
	assert(path::clean("/a/./b//c/../d/") == "/a/b/d")
	assert(path::clean("a/b/..") == "a")
	assert(path::clean("a/..") == ".")
	assert(path::clean("../a/../../b") == "../../b")
	assert(path::clean("/..") == "/")
	assert(path::clean("/../a") == "/a")
	assert(path::clean("//") == "/")
	assert(path::clean("") == ".")
	assert(path::clean("./") == ".")
	assert(path::clean("a") == "a")
}

@test
fn aPathIsTakenFromADirectory() = {
	assert(path::relative("/a/b/c.txt", "/a") == "b/c.txt")
	assert(path::relative("/a/b/c.txt", "/a/") == "b/c.txt")
	assert(path::relative("/a", "/a") == "")
	assert(path::relative("/a/", "/a") == "")
	assert(path::relative("/x/y", "/") == "x/y")
	assert(path::relative("a/b", "a") == "b")
	assert(path::relative("/ab/c", "/a").isNone())
	assert(path::relative("/a", "/a/b").isNone())
}

@test
fn anExtensionIsReplacedOrAdded() = {
	assert(path::withExtension("a/b.wip", "o") == "a/b.o")
	assert(path::withExtension("a/c.tar.gz", "zst") == "a/c.tar.zst")
	assert(path::withExtension("a/.bashrc", "bak") == "a/.bashrc.bak")
	assert(path::withExtension("README", "md") == "README.md")
	assert(path::withExtension("a.d/b", "c") == "a.d/b.c")
	assert(path::withExtension("b.wip/", "o") == "b.o")
}

@test
fn aGlobMatchesAsGitMatchesOne() = {
	assert(path::matches("*.wip", "main.wip"))
	assert(!path::matches("*.wip", "lang/main.wip"), "a star stays within a name")
	assert(!path::matches("*.wip", "main.wip.bak"), "the whole path")
	assert(path::matches("**/*.wip", "lang/main.wip"))
	assert(path::matches("**/*.wip", "main.wip"), "no directories are some")
	assert(path::matches("**/target", "a/b/target") && !path::matches("**/target", "a/targets"))
	assert(path::matches("src/**/test_?.c", "src/a/b/test_1.c"))
	assert(!path::matches("docs/**/*.pdf", "other/docs/a.pdf"))
	assert(path::matches("logs/**", "logs/a/b"))
	assert(path::matches("a**b", "axyb") && !path::matches("a**b", "ax/yb"), "not alone, a star")
	assert(path::matches("a?c", "abc") && !path::matches("a?c", "a/c"))
	assert(path::matches("caf?", "café"), "a character, not a byte")
	assert(path::matches("*é", "café"))
	assert(path::matches("[abc].txt", "b.txt") && !path::matches("[!abc].txt", "b.txt"))
	assert(path::matches("[^abc].txt", "d.txt"))
	assert(path::matches("[a-c]x", "bx") && !path::matches("[a-c]x", "dx"))
	assert(path::matches("[]]", "]"), "a `]` first is in the set")
	assert(!path::matches("[!.]*", ".hidden") && path::matches("[!.]*", "shown"))
	assert(path::matches("\\*.txt", "*.txt") && !path::matches("\\*.txt", "a.txt"))
	assert(path::matches("a[b", "a[b") && !path::matches("a[b", "ab"), "no `]`: a `[`")
	assert(path::matches("", "") && !path::matches("", "a"))
}
