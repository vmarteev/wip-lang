// `std::random`: the same seed answers the same numbers, which are
// xoshiro256**'s seeded through SplitMix64 as its authors give them; a
// number below a count or in a range stays in it, and each is as likely;
// a shuffle keeps every element; and the system seeds two generators apart.

import std::math::{Vec3}
import std::random::{Random}

@test
fn aSeedAnswersTheReferenceSequence() = {
	// xoshiro256** from its state seeded by SplitMix64, as the reference
	// implementations write them.
	var zero = Random::seeded(0)
	assert(zero.next() == 11091344671253066420)
	assert(zero.next() == 13793997310169335082)
	assert(zero.next() == 1900383378846508768)
	assert(zero.next() == 7684712102626143532)
	var other = Random::seeded(42)
	assert(other.next() == 1546998764402558742)
	assert(other.next() == 6990951692964543102)
}

@test
fn theSameSeedAnswersTheSameNumbers() = {
	var a = Random::seeded(7)
	var b = Random::seeded(7)
	for _ in 0..100 {
		assert(a.below(1000) == b.below(1000))
	}
}

@test
fn aNumberBelowACountStaysBelowItAndEachIsAsLikely() = {
	var dice = Random::seeded(1)
	var counts = [0; 6]
	for _ in 0..60000 {
		counts[dice.below(6)] += 1
	}
	// Each of six faces about 10,000 times: within 3% of it.
	for count in counts {
		assert(count > 9700 && count < 10300, "a fair die: \(count)")
	}
	assert(dice.below(1) == 0)
}

@test
fn aNumberInARangeLeavesOutItsTop() = {
	var rng = Random::seeded(2)
	var low = 100
	var high = -100
	for _ in 0..10000 {
		val n = rng.inRange(-10, 10)
		low = low.min(n)
		high = high.max(n)
	}
	assert(low == -10 && high == 9)
	// A range wider than an `i64` holds.
	val wide = rng.inRange(-9223372036854775807 - 1, 9223372036854775807)
	assert(wide < 9223372036854775807)
}

@test
fn aFloatIsFromZeroUpToOne() = {
	var rng = Random::seeded(3)
	var trues = 0
	for _ in 0..1000 {
		val f = rng.float()
		assert(f >= 0.0 && f < 1.0)
		if rng.bool() then trues += 1
	}
	assert(trues > 400 && trues < 600, "a fair coin: \(trues)")
}

@test
fn aShuffleKeepsEveryElement() = {
	var rng = Random::seeded(4)
	var deck = [1, 2, 3, 4, 5, 6, 7, 8]
	rng.shuffle(&var deck)
	assert(deck != [1, 2, 3, 4, 5, 6, 7, 8], "this seed moves them")
	deck.sort()
	assert(deck == [1, 2, 3, 4, 5, 6, 7, 8])
	var none: [i64; 0] = []
	rng.shuffle(&var none)
}

@test
fn theSystemSeedsTwoGeneratorsApart() = {
	var a = Random::fromEntropy()
	var b = Random::fromEntropy()
	assert(a.next() != b.next())
}

@test
fn floatsInARangeStayInIt() = {
	var random = Random::seeded(11)
	var sum = 0.0
	for _ in 0..10000 {
		val wide = random.floatIn(-3.0, 5.0)
		val narrow = random.f32In(0.25, 0.5)
		assert(wide >= -3.0 && wide < 5.0 && narrow >= 0.25 && narrow < 0.5)
		val unit = random.f32()
		assert(unit >= 0.0 && unit < 1.0)
		sum += wide
	}
	assert((sum / 10000.0 - 1.0).abs() < 0.1, "their mean is the middle")
}

@test(panics = "a float in 1..1 is chosen from nothing")
fn anEmptyRangeOfFloatsPanics() = {
	var random = Random::seeded(1)
	random.floatIn(1.0, 1.0)
}

@test
fn directionsAreOfLengthOneAndPointsInside() = {
	var random = Random::seeded(5)
	var sum = Vec3::zero()
	for _ in 0..20000 {
		val direction = random.onSphere()
		assert((direction.length() - 1.0).abs() < 0.0001)
		sum += direction
		assert(random.inSphere().length() <= 1.0)
		assert((random.onCircle().length() - 1.0).abs() < 0.0001 && random.inDisk().length() <= 1.0)
	}
	assert((sum / 20000.0).length() < 0.02, "no direction is favoured")
}

@test
fn aPointInADiskIsAsLikelyAnywhere() = {
	// Half the disk's area lies within the radius `1 / √2`: so do half its
	// points.
	var random = Random::seeded(9)
	var inner = 0
	for _ in 0..20000 {
		if random.inDisk().length() < 0.70710677 then inner += 1
	}
	assert((inner as f64 / 20000.0 - 0.5).abs() < 0.02)
}

@test
fn itemsArePickedAndWeightsAreHeeded() = {
	var random = Random::seeded(3)
	val names = ["ann", "bob", "cy"]
	var seen = [0, 0, 0]
	for _ in 0..3000 {
		val .Some(name) = random.pick(&names) else panic("there are names")
		seen[names.indexOf(&name).unwrap()] += 1
	}
	assert(seen[0] > 900 && seen[1] > 900 && seen[2] > 900)
	val none: [str; 0] = []
	assert(random.pick(&none).isNone())
	var drawn = [0, 0, 0, 0]
	for _ in 0..10000 {
		drawn[random.weighted([1.0, 0.0, 3.0, -2.0]).unwrap()] += 1
	}
	assert(drawn[1] == 0 && drawn[3] == 0, "a weight of nothing is never chosen")
	assert((drawn[2] as f64 / drawn[0] as f64 - 3.0).abs() < 0.3, "three times as often")
	assert(random.weighted([0.0, -1.0]).isNone())
}

@test
fn aGaussianIsABellCurve() = {
	var random = Random::seeded(21)
	var sum = 0.0
	var squares = 0.0
	var withinOne = 0
	val count = 20000
	for _ in 0..count {
		val x = random.gaussian(mean: 10.0, deviation: 2.0)
		sum += x
		squares += x * x
		if (x - 10.0).abs() < 2.0 then withinOne += 1
	}
	val mean = sum / count as f64
	val deviation = (squares / count as f64 - mean * mean).sqrt()
	assert((mean - 10.0).abs() < 0.05 && (deviation - 2.0).abs() < 0.05)
	assert((withinOne as f64 / count as f64 - 0.6827).abs() < 0.015, "68% within one deviation")
}
