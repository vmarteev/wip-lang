// Arithmetic that answers where `+` would panic: every pair of `i8`s and of
// `u8`s against the answer worked out wider; the 64-bit types at their
// edges against `i128`; the 128-bit types, whose overflow is worked out in
// the library, at theirs; division, negation and shifts; and the same
// answers in a `@comptime` constant as when the program runs.

/// What `checked` should answer for a true answer `wide` of a type from
/// `least` to `greatest`.
fn fitting(wide: i64, least: i64, greatest: i64): Option<i64> =
	if wide < least || wide > greatest then .None else .Some(wide)

/// What `saturating` should answer for a true answer `wide`.
fn clamped(wide: i64, least: i64, greatest: i64): i64 =
	if wide < least then least else if wide > greatest then greatest else wide

@test
fn everyPairOfI8sAgreesWithTheWiderAnswer() = {
	for a in -128..128 {
		for b in -128..128 {
			val (x, y) = (a as i8, b as i8)
			assert(x.checkedAdd(y).map((v) => v as i64) == fitting(a + b, -128, 127), "\(a) + \(b)")
			assert(x.checkedSub(y).map((v) => v as i64) == fitting(a - b, -128, 127), "\(a) - \(b)")
			assert(x.checkedMul(y).map((v) => v as i64) == fitting(a * b, -128, 127), "\(a) * \(b)")
			assert(x.saturatingAdd(y) as i64 == clamped(a + b, -128, 127), "\(a) +| \(b)")
			assert(x.saturatingSub(y) as i64 == clamped(a - b, -128, 127), "\(a) -| \(b)")
			assert(x.saturatingMul(y) as i64 == clamped(a * b, -128, 127), "\(a) *| \(b)")
		}
	}
}

@test
fn everyPairOfU8sAgreesWithTheWiderAnswer() = {
	for a in 0..256 {
		for b in 0..256 {
			val (x, y) = (a as u8, b as u8)
			assert(x.checkedAdd(y).map((v) => v as i64) == fitting(a + b, 0, 255), "\(a) + \(b)")
			assert(x.checkedSub(y).map((v) => v as i64) == fitting(a - b, 0, 255), "\(a) - \(b)")
			assert(x.checkedMul(y).map((v) => v as i64) == fitting(a * b, 0, 255), "\(a) * \(b)")
			assert(x.saturatingAdd(y) as i64 == clamped(a + b, 0, 255), "\(a) +| \(b)")
			assert(x.saturatingSub(y) as i64 == clamped(a - b, 0, 255), "\(a) -| \(b)")
			assert(x.saturatingMul(y) as i64 == clamped(a * b, 0, 255), "\(a) *| \(b)")
		}
	}
}

@test
fn theSixtyFourBitTypesAgreeAtTheirEdges() = {
	val signed: [i64; 9] = [
		-9223372036854775807 - 1,
		-9223372036854775807,
		-4611686018427387904,
		-1,
		0,
		1,
		3037000499,
		4611686018427387904,
		9223372036854775807,
	]
	for a in signed {
		for b in signed {
			val (wa, wb) = (a as i128, b as i128)
			val fits = (wide: i128) =>
				wide >= (-9223372036854775807 - 1) as i128 && wide <= 9223372036854775807
			assert(a.checkedAdd(b).isSome() == fits(wa + wb), "\(a) + \(b)")
			assert(a.checkedSub(b).isSome() == fits(wa - wb), "\(a) - \(b)")
			assert(a.checkedMul(b).isSome() == fits(wa * wb), "\(a) * \(b)")
			if a.checkedMul(b) is .Some(product) then assert(product as i128 == wa * wb)
		}
	}
	val unsigned: [u64; 6] = [
		0, 1, 4294967296, 9223372036854775808, 18446744073709551614, 18446744073709551615,
	]
	for a in unsigned {
		for b in unsigned {
			val (wa, wb) = (a as u128, b as u128)
			val fits = (wide: u128) => wide <= 18446744073709551615
			assert(a.checkedAdd(b).isSome() == fits(wa + wb), "\(a) + \(b)")
			assert(a.checkedSub(b).isSome() == (wa >= wb), "\(a) - \(b)")
			assert(a.checkedMul(b).isSome() == fits(wa * wb), "\(a) * \(b)")
		}
	}
	val top: u64 = 18446744073709551615
	assert((9223372036854775807 as i64).saturatingAdd(1) == 9223372036854775807)
	assert((-9223372036854775807 as i64).saturatingSub(5) == -9223372036854775807 - 1)
	assert(top.saturatingMul(2) == top)
	assert((3 as usize).saturatingSub(5) == 0 && (1 as isize).checkedAdd(2) == .Some(3))
}

@test
fn theOneTwentyEightBitTypesWorkItOutThemselves() = {
	val most: i128 = 170141183460469231731687303715884105727
	val least: i128 = -170141183460469231731687303715884105727 - 1
	assert(most.checkedAdd(1).isNone() && most.checkedAdd(0) == .Some(most))
	assert(least.checkedSub(1).isNone() && least.checkedAdd(most) == .Some(-1))
	assert((-1 as i128).checkedMul(least).isNone() && least.checkedMul(-1).isNone())
	assert(least.checkedMul(1) == .Some(least) && (2 as i128).checkedMul(most).isNone())
	assert(most.saturatingAdd(most) == most && least.saturatingAdd(least) == least)
	assert(least.saturatingSub(1) == least && most.saturatingSub(-1) == most)
	assert(least.saturatingMul(2) == least && least.saturatingMul(-2) == most)
	val top: u128 = 340282366920938463463374607431768211455
	assert(top.checkedAdd(1).isNone() && top.checkedAdd(0) == .Some(top))
	assert((0 as u128).checkedSub(1).isNone() && (5 as u128).checkedSub(5) == .Some(0))
	assert(top.checkedMul(2).isNone() && (top / 3).checkedMul(3) == .Some(top))
	assert((0 as u128).checkedMul(top) == .Some(0) && top.saturatingMul(3) == top)
}

@test
fn divisionNegationAndShiftsAnswerWhereTheyWouldPanic() = {
	assert((7 as i32).checkedDiv(0).isNone() && (7 as u32).checkedRem(0).isNone())
	assert((-2147483647 as i32 - 1).checkedDiv(-1).isNone(), "the smallest divided by -1")
	assert((-2147483647 as i32 - 1).checkedRem(-1).isNone())
	assert((-7 as i32).checkedDiv(2) == .Some(-3) && (-7 as i32).checkedRem(2) == .Some(-1))
	assert((-128 as i16).checkedNeg() == .Some(128) && (-32767 as i16 - 1).checkedNeg().isNone())
	assert((0 as u8).checkedNeg() == .Some(0) && (1 as u8).checkedNeg().isNone())
	assert((1 as u8).checkedShl(7) == .Some(128) && (1 as u8).checkedShl(8).isNone())
	assert(
		(3 as i64).checkedShl(63) == .Some(-9223372036854775807 - 1),
		"the bits shifted out are gone",
	)
	assert((1 as i64).checkedShl(-1).isNone() && (1 as i64).checkedShl(64).isNone())
}

@comptime
val FOLDED: [i64; 6] = [
	(9223372036854775807 as i64).checkedAdd(1).unwrapOr(-1),
	(100 as i64).checkedMul(3).unwrapOr(-1),
	(9223372036854775807 as i64).saturatingAdd(9),
	(-9223372036854775807 as i64).saturatingMul(2),
	(5 as i64).checkedSub(7).unwrapOr(-1),
	(120 as i8).saturatingAdd(100) as i64,
]

@test
fn theCompilerAnswersAsTheProgramDoes() = {
	val big: i64 = 9223372036854775807
	val small: i64 = -9223372036854775807
	val counted = [
		big.checkedAdd(1).unwrapOr(-1),
		(100 as i64).checkedMul(3).unwrapOr(-1),
		big.saturatingAdd(9),
		small.saturatingMul(2),
		(5 as i64).checkedSub(7).unwrapOr(-1),
		(120 as i8).saturatingAdd(100) as i64,
	]
	assert(FOLDED == counted)
	assert(FOLDED[0] == -1 && FOLDED[2] == big && FOLDED[3] == small - 1 && FOLDED[5] == 127)
}
