// `Arena<T>`: values named by handle, a handle to a value
// removed caught however the slot is used after, walked as its values lie,
// and cloned under the same handles.

import std::collections::{Arena, Handle, Leased, Map, Set}

@test
fn arenaNamesWhatItHolds() = {
	var a: Arena<i64> = Arena()
	assert(a.isEmpty(), "a new arena holds nothing")
	val one = a.add(1)
	val two = a.add(2)
	assert(a.len() == 2 && a[one] == 1 && a[two] == 2)
	a[one] = 10
	a[two] += 5
	assert(a.get(one) == .Some(&10) && a[two] == 7, "written through a handle")
	assert(one != two && one < two)
	assert("\(one)" == "Handle(slot: 0, generation: 1)")
}

@test
fn arenaCatchesStaleHandles() = {
	var a: Arena<i64> = Arena()
	val first = a.add(1)
	assert(a.remove(first) == 1)
	assert(a.remove(first).isNone(), "removed once")
	val second = a.add(2)
	assert(!a.contains(first) && a.get(first).isNone(), "the slot is reused, the handle is not")
	assert(a.contains(second) && a[second] == 2)
	assert(first != second, "a handle to the reused slot is another handle")
	assert("\(second)" == "Handle(slot: 0, generation: 3)")
	a.clear()
	assert(a.isEmpty() && !a.contains(second), "clear makes every handle stale")
	val third = a.add(3)
	assert(!a.contains(second) && a[third] == 3)
}

@test
fn arenaHandlesAreKeys() = {
	var a: Arena<str> = Arena()
	val north = a.add("north")
	val south = a.add("south")
	var distance: Map<Handle<str>, i64> = Map()
	distance.put(north, 1)
	distance.put(south, 2)
	var seen: Set<Handle<str>> = Set()
	seen.add(north)
	seen.add(north)
	assert(distance.at(&south) == 2 && seen.len() == 1 && seen.contains(&north))
}

/// A value that does not compare, clone or hash.
struct Room {
	doors: Vec<i64>
}

@test
fn arenaHandlesOfWhatDoesNotCompareAreKeys() = {
	var a: Arena<Room> = Arena()
	val hall = a.add(Room(doors: [1, 2]))
	val cellar = a.add(Room(doors: Vec()))
	var lit: Map<Handle<Room>, bool> = Map()
	lit.put(hall, true)
	lit.put(cellar, false)
	assert(lit.at(&hall) && !lit.at(&cellar) && hall < cellar)
	assert("\(cellar)" == "Handle(slot: 1, generation: 1)")
}

@test
fn arenaWalksWhatItHolds() = {
	var a: Arena<i64> = Arena()
	val handles: Vec<Handle<i64>> = [
		for i in 0..10 do
			yield a.add(i)
	]
	for i in 0..10 do
		if i % 3 == 0 then
			a.remove(handles[i])

	var total = 0
	for entry in a {
		assert(a[entry.handle] == entry.value, "each value beside its handle")
		total += entry.value
	}
	assert(a.len() == 6 && total == 1 + 2 + 4 + 5 + 7 + 8)
	for value in a.values() do
		value *= 10

	for i in 0..10 do
		assert(a.get(handles[i]) == if i % 3 == 0 then .None else .Some(&(i * 10)))
}

@test
fn arenaLendsTwoAtOnce() = {
	var a: Arena<i64> = Arena()
	val low = a.add(1)
	val middle = a.add(2)
	val high = a.add(3)
	val sum = a.pair(low, high, (x, y) => {
		x += 10
		y += 20
		return x + y
	})
	assert(sum == 34 && a[low] == 11 && a[high] == 23)
	a.pair(high, middle, (x, y) => {
		val moved = x
		x = y
		y = moved
	})
	assert(a[high] == 2 && a[middle] == 23, "either way round")
}

@test
fn arenaHoldsValuesThatOwnMemory() = {
	var a: Arena<String> = Arena()
	val handles: Vec<Handle<String>> = [
		for i in 0..20 do
			yield a.add("value \(i)")
	]
	assert(a.remove(handles[3]) == .Some("value 3"))
	a[handles[4]].push("!")
	val copy = a.clone()
	a[handles[5]].push("?")
	assert(copy[handles[4]] == "value 4!" && copy[handles[5]] == "value 5", "the clone is its own")
	assert(!copy.contains(handles[3]) && copy.len() == 19, "under the same handles")
	var count = 0
	for (handle, value) in move copy {
		assert(value == a[handle].toStr() || handle == handles[5])
		count += 1
	}
	assert(count == 19)
	a.clear()
	assert(a.isEmpty())
}

// What the handles of an arena with a second type name: that type, which
// code that cannot name the values' type can.
struct Words {
	unused: i64
}

fn countOf(handles: &Vec<Handle<Words>>): i64 = handles.len()

@test
fn arenaHandlesNameItsSecondType() = {
	var a: Arena<String, Words> = Arena()
	var handles: Vec<Handle<Words>> = Vec()
	handles.push(a.add("one"))
	handles.push(a.add("two"))
	assert(countOf(&handles) == 2 && a[handles[1]] == "two")
	assert(a.remove(handles[0]) == .Some("one"))
	assert(!a.contains(handles[0]) && a.len() == 1)
	for entry in a do
		assert(entry.handle == handles[1])
}

@test
fn arenaKeepsWhatItIsTold() = {
	var a: Arena<String> = Arena()
	val handles: Vec<Handle<String>> = [
		for i in 0..10 do
			yield a.add("value \(i)")
	]
	var dropped = 0
	a.retain((_, value) => {
		if value.len() == 7 && value.toStr() != "value 4" {
			value.push("!")
			return true
		}
		dropped += 1
		return false
	})
	assert(dropped == 1 && a.len() == 9, "one removed")
	assert(!a.contains(handles[4]), "the removed one's handle is stale")
	assert(a[handles[9]] == "value 9!", "the kept ones written")
	a.retain((handle, _) => handle == handles[0])
	assert(a.len() == 1 && a[handles[0]] == "value 0!", "all but one removed")
}

/// What holds an arena, and what its values ask of it while one changes.
struct World {
	rooms: Arena<Room> = Arena()
	visits: i64 = 0
}

extend World {
	/// `body` changes the room `handle` names, with the world at hand, as a
	/// lease lends the two at once.
	var fn update(handle: Handle<Room>, body: &var (room: &var Room, world: &var World) => void) = {
		var leased = self.rooms.lease(handle)
		body(&var leased.value, &var self)
		self.rooms.giveBack(leased)
	}
}

@test
fn aLeasedValueIsGivenBackUnderItsHandle() = {
	var world = World()
	val hall = world.rooms.add(Room(doors: [1]))
	val yard = world.rooms.add(Room(doors: [2, 3]))
	world.update(
		hall,
		(room, world) => {
			room.doors.push(4)
			// The world is lent beside the room, and the other rooms with it.
			world.visits += world.rooms[yard].doors.len()
			assert(!world.rooms.contains(hall) && world.rooms.get(hall).isNone(), "the room is out")
			assert(world.rooms.len() == 1, "a lease is not counted")
			var walked = 0
			for _ in world.rooms do
				walked += 1

			assert(walked == 1, "a walk leaves the lease out")
		},
	)
	assert(world.visits == 2)
	assert(world.rooms.contains(hall) && world.rooms[hall].doors == [1, 4], "given back, written")
	assert(world.rooms[yard].doors == [2, 3] && world.rooms.len() == 2)
	val leased = world.rooms.lease(yard)
	assert(leased.handle() == yard)
	world.rooms.giveBack(leased)
	assert(
		world.rooms.remove(yard) is .Some(room) && room.doors == [2, 3],
		"removed once given back",
	)
}

@test
fn aLeasedValueIsGivenBackToAnArenaCloned() = {
	var a: Arena<i64> = Arena()
	val one = a.add(1)
	var leased = a.lease(one)
	var copy = a.clone()
	leased.value = 2
	copy.giveBack(leased)
	assert(copy[one] == 2, "the copy's slot was out too")
	assert(!a.contains(one), "and the original's still is")
}

@test(panics = "is out on lease")
fn aValueOutOnLeaseIsNotIndexed() = {
	var a: Arena<i64> = Arena()
	val one = a.add(1)
	val leased = a.lease(one)
	assert(a[one] == 1)
	a.giveBack(leased)
}

@test(panics = "is out on lease")
fn aValueIsLeasedOnceAtATime() = {
	var a: Arena<i64> = Arena()
	val one = a.add(1)
	val first = a.lease(one)
	val second = a.lease(one)
	a.giveBack(first)
	a.giveBack(second)
}

@test(panics = "is given back before it is removed")
fn aValueOutOnLeaseIsNotRemoved() = {
	var a: Arena<i64> = Arena()
	val one = a.add(1)
	val leased = a.lease(one)
	a.remove(one)
	a.giveBack(leased)
}

@test(panics = "is not out on lease from this arena")
fn aLeaseIsGivenBackToItsOwnArena() = {
	var a: Arena<i64> = Arena()
	var other: Arena<i64> = Arena()
	val leased = a.lease(a.add(1))
	other.giveBack(leased)
}

@test(panics = "names a value removed")
fn aValueRemovedIsNotLeased() = {
	var a: Arena<i64> = Arena()
	val one = a.add(1)
	a.remove(one)
	val leased = a.lease(one)
	a.giveBack(leased)
}

@test(panics = "was leased and never given back")
fn aLeaseDroppedPanics() = {
	var a: Arena<i64> = Arena()
	val one = a.add(1)
	val leased: Leased<i64> = a.lease(one)
}
