// `std::hex`: RFC 4648's base 16 vectors, either case read, every byte
// there and back, and a digit that is not one, or half a byte, refused.

import std::hex
import std::hex::{HexError}

@test
fn hexWritesTwoDigitsAByte() = {
	assert(hex::encode("foobar") == "666f6f626172")
	assert(hex::encode("foobar", upper: true) == "666F6F626172")
	assert(hex::encode("") == "")
	val ends = [0 as u8, 15, 16, 255]
	assert(hex::encode(&ends) == "000f10ff")
}

@test
fn hexReadsEitherCaseAndEveryByte() = {
	val decoded = hex::decode("666F6f626172").unwrap()
	assert(str::fromBytes(&decoded) == "foobar")
	var every: Vec<u8> = Vec()
	for byte in 0..256 {
		every.push(byte as u8)
	}
	assert(hex::decode(hex::encode(&every)) == .Ok(every.clone()))
	assert(hex::decode(hex::encode(&every, upper: true)) == .Ok(every.clone()))
}

@test
fn hexRefusesWhatIsNotADigitOrHalfAByte() = {
	assert(hex::decode("0g") == .Err(.NotADigit(1)))
	assert(hex::decode("x0") == .Err(.NotADigit(0)))
	assert(hex::decode("abc") == .Err(.OddLength))
	assert(hex::decode("abx") == .Err(.NotADigit(2)))
	assert(hex::decode("0x10") == .Err(.NotADigit(1)), "no prefix is read")
	assert("\(HexError::OddLength)".contains("half a byte"))
}
