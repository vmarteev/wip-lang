// `get(i)`: the element at a position, or nothing where `x[i]` would
// panic — past the end, before the start, in what is empty — on a slice, an
// array and a vector.

@test
fn anElementIsFoundByItsPosition() = {
	val numbers: Vec<i64> = [10, 20, 30]
	assert(numbers.get(0) == .Some(&10) && numbers.get(1) == .Some(&20))
	assert(numbers.get(2) == .Some(&30))
	val array = [1, 2, 3]
	assert(array.get(1) == .Some(&2))
	assert(numbers.items()[1..].get(0) == .Some(&20))
}

@test
fn whereThereIsNoElementThereIsNothing() = {
	val numbers: Vec<i64> = [10, 20, 30]
	assert(numbers.get(3).isNone() && numbers.get(100).isNone())
	// A negative position is nothing, never counted from the end.
	assert(numbers.get(-1).isNone())
	val empty: Vec<i64> = Vec()
	assert(empty.get(0).isNone())
}

@test
fn anElementThatOwnsMemoryIsLent() = {
	val words: Vec<String> = ["one", "two"]
	assert(words.get(1) is .Some(word) && word == "two")
	assert(words.len() == 2)
}

@test
fn aNarrowIndexWidensToAPosition() = {
	val numbers = [10, 20, 30]
	val small: u8 = 2
	val half: u32 = 1
	assert(numbers.get(small) == .Some(&30) && numbers.get(half) == .Some(&20))
}

enum Mark {
	Dot
	Close
}

enum Token {
	Word(text: String)
	Punct(mark: Mark)
}

// What a reader of tokens asks at each step: what is next, or the end.
fn next(tokens: &[Token], at: i64): str = match tokens.get(at) {
	.None => "end"
	.Some(.Punct(.Dot)) => "dot"
	.Some(.Punct(.Close)) => "close"
	.Some(.Word(text)) => text.toStr()
}

@test
fn whatIsAtAPositionIsMatched() = {
	val tokens: Vec<Token> = [.Word("a"), .Punct(.Dot), .Punct(.Close)]
	assert(next(&tokens, 0) == "a" && next(&tokens, 1) == "dot")
	assert(next(&tokens, 2) == "close" && next(&tokens, 3) == "end")
	val line = [b' ', b'\t', b'x']
	var at = 0
	while line.get(at) is .Some(b' ' | b'\t') do
		at += 1

	assert(at == 2)
}
