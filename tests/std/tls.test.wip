// `std::tls`: a connection nobody listens for refused; one whose server
// never answers the handshake given up in time; a server the test
// starts with `openssl` and a certificate it makes, which the system does
// not trust, refused for its certificate; and, where the network is there,
// a public server read from, and one whose certificate has expired
// refused. A test that needs the network says so and passes without it.

import std::fs
import std::io
import std::net::{Listener}
import std::time::{Duration, Instant}
import std::tls::{TlsError, TlsStream}

@test
fn aConnectionNobodyListensForIsRefused() = {
	assert(TlsStream::connect("127.0.0.1", 9) is .Err(.Io(..)))
}

@test
fn aServerThatNeverAnswersTheHandshakeTimesOut() = {
	// The system accepts the connection for the listener, which never
	// reads what the handshake sends.
	val listener = Listener::tcp(.Some("127.0.0.1"), 0).unwrap()
	val .Ok(.V4(port: port, ..)) = listener.localAddress() else panic("an IPv4 address")
	val started = Instant::now()
	val answer = TlsStream::connectWithin("127.0.0.1", port, Duration::millis(300))
	assert(answer is .Err(.Io(.TimedOut)), "\(answer.isOk())")
	assert(started.elapsed().asMillis() < 5000)
}

/// Its server is a program the test starts, which iOS does not.
@target(os = "macos")
@target(os = "linux")
@test
fn aCertificateTheSystemDoesNotTrustIsRefused() = {
	val dir = fs::TempDir::new().unwrap()
	val port = freePort()
	val server = untrustedServer(&dir, port)
	val answer = TlsStream::connectWithin("localhost", port, Duration::seconds(10))
	server.kill()
	assert(answer is .Err(.Certificate(..)), "\(answer.isOk())")
}

@test
fn aPublicServerIsReadFromWhereTheNetworkIsThere() = {
	if !reachable("example.com") {
		io::println("skipped: no network")
		return
	}
	var stream = TlsStream::connectWithin("example.com", 443, Duration::seconds(10)).unwrap()
	stream.setTimeout(.Some(Duration::seconds(10)))
	val request = "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"
	assert(stream.writeAll(&request).isOk())
	var answer: Vec<u8> = Vec()
	var room = [0 as u8; 4096]
	while true {
		val got = stream.read(&var room).unwrap()
		if got == 0 then break
		answer.pushAll(&room[0..got])
	}
	assert(str::fromBytes(&answer).startsWith("HTTP/1.1 200"))
}

@test
fn anExpiredCertificateIsRefusedWhereTheNetworkIsThere() = {
	if !reachable("expired.badssl.com") {
		io::println("skipped: no network")
		return
	}
	val answer = TlsStream::connectWithin("expired.badssl.com", 443, Duration::seconds(10))
	assert(answer is .Err(.Certificate(..)))
}
