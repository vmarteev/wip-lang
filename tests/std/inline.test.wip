// `InlineVec<T, N>`: at most `N` values, held where it is; what it does
// when full, when a value is taken out of the middle, that it is plain data
// where its element is, that what it holds ends when it does, and that it
// clones.

import std::shared::{Shared}
import std::sync::{Atomic}

/// A value that writes its digit into a shared number when it ends, so
/// that the number says which ended, in what order.
struct Ending {
	log: Shared<Atomic<i64>>
	digit: i64
}

extend Ending: Destroy {
	var fn destroy() = {
		val before = self.log.value().load()
		self.log.value().store(before * 10 + self.digit)
	}
}

@test
fn anInlineVecTruncatesAndClearsLastFirst() = {
	val log = Shared::of(Atomic::of(0))
	var values: InlineVec<Ending, 4> = InlineVec()
	for digit in 1..=4 do
		values.push(Ending(log: log.share(), digit:))

	values.truncate(2)
	assert(log.value().load() == 43, "the tail ends, the last first")
	values.truncate(9)
	assert(values.len() == 2, "truncating to more than it holds does nothing")
	values.clear()
	assert(values.isEmpty() && log.value().load() == 4321, "clearing ends the rest")
	var numbers: InlineVec<i64, 8> = InlineVec()
	numbers.push(1)
	numbers.push(2)
	numbers.truncate(1)
	assert(numbers.len() == 1 && numbers[0] == 1)
}

@test
fn anInlineVecPushesAndPopsUpToItsCapacity() = {
	var numbers: InlineVec<i64, 3> = InlineVec()
	assert(numbers.isEmpty() && numbers.capacity() == 3, "a new one holds nothing")
	numbers.push(1)
	numbers.push(2)
	assert(numbers.tryPush(3), "room for a third")
	assert(!numbers.tryPush(4) && numbers.isFull(), "and no more")
	assert(numbers.len() == 3 && numbers[0] == 1 && numbers.at(2) == 3)
	numbers[1] = 20
	assert(numbers[1] == 20, "written by index")
	assert(numbers.pop() == 3)
	assert(numbers.pop() == 20)
	assert(numbers.pop() == 1)
	assert(numbers.pop().isNone(), "an empty one pops nothing")
}

@test
fn anInlineVecKeepsOrderWhereAValueIsTakenFromTheMiddle() = {
	var words: InlineVec<String, 4> = InlineVec::of(["a", "b", "c"])
	words.insert(1, "between")
	assert(words.items() == ["a", "between", "b", "c"])
	assert(words.remove(0) == "a")
	assert(words.swapRemove(0) == "between", "the last one takes its place")
	assert(words.items() == ["c", "b"])
	words.retain((w) => w == "b")
	assert(words.items() == ["b"])
	words.clear()
	assert(words.isEmpty())
}

/// What a draw's constants are: plain data, copied with what holds it.
struct Constants {
	bytes: InlineVec<u8, 8>
}

@test
fn anInlineVecOfPlainDataIsPlainData() = {
	val first = Constants(bytes: InlineVec::of([1, 2, 3]))
	val second = first
	assert(first.bytes.items() == second.bytes.items(), "copied, both still there")
	var sum = 0
	for b in second.bytes do
		sum += b as i64

	assert(sum == 6)
}

@test
fn whatAnInlineVecHoldsEndsWhenItDoesAndClones() = {
	{
		var held: InlineVec<own<i64>, 4> = InlineVec()
		held.push(own (1))
		held.push(own (2))
		held.push(own (3))
		val .Some(taken) = held.pop() else panic("three were pushed")
		assert(taken == 3 && held.len() == 2)
	}
	var names: InlineVec<String, 2> = InlineVec()
	names.push("kept")
	val cloned = names.clone()
	names.clear()
	assert(names.isEmpty() && cloned[0] == "kept", "a clone holds clones")
}

@test(panics = "4 values for an InlineVec of 3")
fn anInlineVecGivenMoreThanItHoldsPanics() = {
	val words: InlineVec<str, 3> = InlineVec::of(["a", "b", "c", "d"])
	assert(words.len() == 4)
}

@test
fn anInlineVecIsReadIntoAsFarAsTheReadSays() = {
	var bytes: InlineVec<u8, 6> = InlineVec()
	bytes.push(b'a')
	val filled: Result<i64, str> = bytes.readInto(10, 0, (room) => {
		assert(room.len() == 5 && room[4] == 0, "the room, each slot a blank")
		room[0] = b'b'
		room[1] = b'c'
		return 2
	})
	assert(filled == 2 && str::fromBytes(&bytes.items()) == "abc", "two more held")
	val failed: Result<i64, str> = bytes.readInto(3, 0, (_) => .Err("gone"))
	assert(failed == .Err("gone") && bytes.len() == 3, "a read that fails holds nothing more")
	val capped: Result<i64, str> = bytes.readInto(2, 0, (room) => room.len())
	assert(capped == 2 && bytes.len() == 5, "no more than `most`")
	val full: Result<i64, str> = bytes.readInto(9, 0, (room) => room.len())
	assert(full == 1 && bytes.isFull(), "no more than there is room for")
}

@test(panics = "2 slots read into, and 3 said to be filled")
fn aReadThatSaysItFilledMoreThanItWasLentPanics() = {
	var bytes: InlineVec<u8, 2> = InlineVec()
	val said: Result<i64, str> = bytes.readInto(2, 0, (_) => 3)
	assert(said.isOk())
}
