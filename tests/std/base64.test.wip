// `std::base64` against RFC 4648's vectors and what Python's `base64`
// writes; both alphabets, with padding and without; every length, there
// and back; and what is not base64 refused where it is wrong.

import std::base64
import std::base64::{Base64Error}

/// Bytes that are not text, the same each run.
fn mixed(count: i64): Vec<u8> = {
	var out: Vec<u8> = Vec()
	for i in 0..count {
		out.push((i * 37 + 11) as u8)
	}
	return out
}

@test
fn base64WritesTheVectorsOfItsStandard() = {
	val vectors = [
		("", ""),
		("f", "Zg=="),
		("fo", "Zm8="),
		("foo", "Zm9v"),
		("foob", "Zm9vYg=="),
		("fooba", "Zm9vYmE="),
		("foobar", "Zm9vYmFy"),
	]
	for (text, written) in vectors {
		assert(base64::encode(&text) == written, written)
		val decoded = base64::decode(written).unwrap()
		assert(str::fromBytes(&decoded) == text, written)
	}
}

@test
fn base64WritesWhatPythonWrites() = {
	val bytes = mixed(64)
	val standard =
		"CzBVep/E6Q4zWH2ix+wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW+yBFao+02f4jSG2St9wBJg=="
	val url =
		"CzBVep_E6Q4zWH2ix-wRNluApcrvFDleg6jN8hc8YYar0PUaP2SJrtP4HUJnjLHW-yBFao-02f4jSG2St9wBJg=="
	assert(base64::encode(&bytes) == standard)
	assert(base64::encode(&bytes, alphabet: .Url) == url)
	assert(base64::encode(&bytes, alphabet: .Url, padded: false) == url[0..url.len() - 2])
	assert(base64::encode("héllo wörld") == "aMOpbGxvIHfDtnJsZA==")
}

@test
fn base64GoesThereAndBackAtEveryLength() = {
	for count in 0..70 {
		val bytes = mixed(count)
		for padded in [true, false] {
			val standard = base64::encode(&bytes, padded: padded)
			assert(base64::decode(&standard) == .Ok(bytes.clone()), "\(count)")
			val url = base64::encode(&bytes, alphabet: .Url, padded: padded)
			assert(base64::decode(&url, alphabet: .Url) == .Ok(bytes.clone()), "\(count)")
		}
	}
}

@test
fn base64RefusesWhatIsNotOfItsAlphabet() = {
	assert(base64::decode("Zm9v YmFy") == .Err(.NotInAlphabet(4)), "a space")
	assert(base64::decode("Zm9v\nYmFy") == .Err(.NotInAlphabet(4)), "a line break")
	assert(base64::decode("Zm-v") == .Err(.NotInAlphabet(2)), "the other alphabet")
	assert(base64::decode("Zm/v", alphabet: .Url) == .Err(.NotInAlphabet(2)), "the other alphabet")
	assert(base64::decode("Zg==Zg==") == .Err(.NotInAlphabet(2)), "padding inside")
	assert(base64::decode("Zg=") == .Err(.NotInAlphabet(2)), "padding short of a four")
	assert(base64::decode("Zm9vY") == .Err(.CutShort))
	assert("\(Base64Error::CutShort)".contains("part way"))
}
