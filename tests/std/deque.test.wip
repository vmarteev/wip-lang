// `Deque<T>`: pushed and taken at both ends, read and
// written by position, walked from front to back, and grown without
// losing its order however its ring has wrapped.

import std::collections::{Deque}

@test
fn dequeTakesFromBothEnds() = {
    var d: Deque<i64> = Deque()
    assert(d.isEmpty(), "a new deque holds nothing")
    assert(d.popFront().isNone() && d.popBack().isNone(), "and gives nothing")
    d.pushBack(2)
    d.pushFront(1)
    d.pushBack(3)
    assert(d.len() == 3)
    assert(d.first() == .Some(1) && d.last() == .Some(3))
    assert(d.popFront() == .Some(1), "the front is what was pushed there")
    assert(d.popBack() == .Some(3), "the back is what was pushed there")
    assert(d.popBack() == .Some(2) && d.isEmpty())
}

@test
fn dequeIsASequence() = {
    var d = Deque::of([10, 20, 30])
    assert(d[0] == 10 && d[2] == 30)
    d[1] = 25
    for x in d {
        x += 1
    }
    assert(d == Deque::of([11, 26, 31]), "written by position and by a loop")
    assert("\(d)" == "[11, 26, 31]")
}

@test
fn dequeKeepsItsOrderAsItGrows() = {
    // Pushed at the front and the back, and taken from the front, so that
    // the ring wraps before it grows, and grows more than once.
    var d: Deque<i64> = Deque()
    for i in 0..100 {
        d.pushBack(i)
        d.pushFront(-i - 1)
        if i % 3 == 0 {
            d.popFront()
        }
    }
    for i in 1..d.len() {
        assert(d[i - 1] < d[i], "front to back, in order")
    }
    assert(d.last() == .Some(99))
}

@test
fn dequeHoldsValuesThatOwnMemory() = {
    var d: Deque<String> = Deque()
    for i in 0..20 {
        d.pushBack("value \(i)")
    }
    assert(d.popFront() == .Some(String::of("value 0")))
    assert(d[0] == "value 1")
    d.clear()
    assert(d.isEmpty(), "cleared, which ends what it held")
    d.pushFront("again")
    assert(d.len() == 1 && d[0] == "again")
}
