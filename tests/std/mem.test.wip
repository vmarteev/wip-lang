// Places: a value taken out of one with another left in its place, two
// exchanged, over values that own memory and fields of a struct; and a
// map's value made only where there was none.

import std::collections::{Map}
import std::mem

enum Activity {
	Idle
	Reading(path: String)
}

struct Machine {
	state: Activity
	front: Vec<String>
	back: Vec<String>
}

extend Machine {
	/// What it was doing, and idle now.
	var fn stop(): Activity = mem::replace(&var self.state, .Idle)

	var fn turn() = mem::swap(&var self.front, &var self.back)
}

@test
fn replaceTakesTheValueAndLeavesAnother() = {
	var machine = Machine(state: .Reading(path: "a.txt"), front: Vec::of(own ["x"]), back: Vec())
	val was = machine.stop()
	assert(was is .Reading("a.txt") && machine.state is .Idle)
	var text = String::of("old")
	assert(mem::replace(&var text, "new") == "old" && text == "new")
}

@test
fn swapExchangesTwoPlaces() = {
	var machine = Machine(state: .Idle, front: Vec::of(own ["x", "y"]), back: Vec::of(own ["z"]))
	machine.turn()
	assert(machine.front.len() == 1 && machine.back[1] == "y")
	var a = 1
	var b = 2
	mem::swap(&var a, &var b)
	assert(a == 2 && b == 1)
}

@test
fn atOrPutWithMakesAValueOnlyWhereThereIsNone() = {
	var groups: Map<String, Vec<String>> = Map()
	var made = 0
	for word in "ant bee ape bat cow".split(" ") {
		val first = word[0..1]
		groups.atOrPutWith(first, () => {
			made += 1
			return Vec()
		}).push(word)
	}
	assert(made == 3, "one list for each first letter")
	assert(groups.at("a").len() == 2 && groups.at("b")[1] == "bat")
}
