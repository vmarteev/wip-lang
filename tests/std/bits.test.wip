// An integer's bits: each method against a plain loop over
// the bits, at every width; a signed type against the unsigned one of its
// width; the edges; and the same bits in a `@comptime` constant as when
// the program runs.

/// The low `width` bits of `value`.
fn low(value: u128, width: u128): u128 = if width == 128 then value else value & ((1 << width) - 1)

fn slowCountOnes(value: u128, width: u128): u128 = {
	var count: u128 = 0
	var i: u128 = 0
	while i < width {
		count += (value >> i) & 1
		i += 1
	}
	return count
}

fn slowLeadingZeros(value: u128, width: u128): u128 = {
	var count: u128 = 0
	while count < width && (value >> (width - 1 - count)) & 1 == 0 {
		count += 1
	}
	return count
}

fn slowTrailingZeros(value: u128, width: u128): u128 = {
	var count: u128 = 0
	while count < width && (value >> count) & 1 == 0 {
		count += 1
	}
	return count
}

fn slowRotateLeft(value: u128, amount: u128, width: u128): u128 = {
	var turned = value
	var i: u128 = 0
	while i < amount % width {
		turned = low(turned << 1, width) | (turned >> (width - 1))
		i += 1
	}
	return turned
}

fn slowReverseBits(value: u128, width: u128): u128 = {
	var reversed: u128 = 0
	var i: u128 = 0
	while i < width {
		reversed = reversed | (((value >> i) & 1) << (width - 1 - i))
		i += 1
	}
	return reversed
}

fn slowSwapBytes(value: u128, width: u128): u128 = {
	var swapped: u128 = 0
	var i: u128 = 0
	while i < width {
		swapped = swapped | (((value >> i) & 0xFF) << (width - 8 - i))
		i += 8
	}
	return swapped
}

/// Numbers of 128 bits with every byte busy, and, every fourth one, a few
/// bits only, so that long runs of zeros are met too; after the edges.
fn bitSamples(): Vec<u128> = {
	var all: Vec<u128> = Vec()
	all.push(0)
	all.push(1)
	all.push(0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
	all.push(0x80000000000000000000000000000000)
	all.push(0x80808080808080808080808080808080)
	var state: u64 = 2024
	for i in 0..400 {
		state = state *% 6364136223846793005 +% 1442695040888963407
		val high = state
		state = state *% 6364136223846793005 +% 1442695040888963407
		var value = ((high as u128) << 64) | (state as u128)
		if i % 4 == 0 then value = value >> ((state >> 57) as u128) & (value >> 3)
		all.push(value)
	}
	return move all
}

@test
fn the8BitMethodsAreTheBitsCountedAndTurned() = {
	val values = bitSamples()
	for k in 0..values.len() {
		val wide = low(values[k], 8)
		val x = wide as u8
		val amount = (values[(k * 7 + 1) % values.len()] % 300) as u8
		assert(x.countOnes() as u128 == slowCountOnes(wide, 8), "countOnes of \(x)")
		assert(x.leadingZeros() as u128 == slowLeadingZeros(wide, 8), "leadingZeros of \(x)")
		assert(x.trailingZeros() as u128 == slowTrailingZeros(wide, 8), "trailingZeros of \(x)")
		assert(x.reverseBits() as u128 == slowReverseBits(wide, 8), "reverseBits of \(x)")
		assert(x.swapBytes() as u128 == slowSwapBytes(wide, 8), "swapBytes of \(x)")
		val left = slowRotateLeft(wide, amount as u128, 8)
		assert(x.rotateLeft(amount) as u128 == left, "\(x) turned left by \(amount)")
		assert(
			x.rotateRight(amount).rotateLeft(amount) == x,
			"\(x) turned right by \(amount), and back",
		)
		// The signed type of the width has the same bits.
		val s = x as i8
		assert(s.countOnes() as u8 == x.countOnes() && s.leadingZeros() as u8 == x.leadingZeros())
		assert(
			s.trailingZeros() as u8 == x.trailingZeros() &&
				s.reverseBits() as u8 == x.reverseBits(),
		)
		assert(s.swapBytes() as u8 == x.swapBytes())
		assert(s.rotateLeft(amount as i8) as u8 == x.rotateLeft(amount))
		assert(s.rotateRight(amount as i8) as u8 == x.rotateRight(amount))
	}
}

@test
fn the16BitMethodsAreTheBitsCountedAndTurned() = {
	val values = bitSamples()
	for k in 0..values.len() {
		val wide = low(values[k], 16)
		val x = wide as u16
		val amount = (values[(k * 7 + 1) % values.len()] % 300) as u16
		assert(x.countOnes() as u128 == slowCountOnes(wide, 16), "countOnes of \(x)")
		assert(x.leadingZeros() as u128 == slowLeadingZeros(wide, 16), "leadingZeros of \(x)")
		assert(x.trailingZeros() as u128 == slowTrailingZeros(wide, 16), "trailingZeros of \(x)")
		assert(x.reverseBits() as u128 == slowReverseBits(wide, 16), "reverseBits of \(x)")
		assert(x.swapBytes() as u128 == slowSwapBytes(wide, 16), "swapBytes of \(x)")
		val left = slowRotateLeft(wide, amount as u128, 16)
		assert(x.rotateLeft(amount) as u128 == left, "\(x) turned left by \(amount)")
		assert(
			x.rotateRight(amount).rotateLeft(amount) == x,
			"\(x) turned right by \(amount), and back",
		)
		// The signed type of the width has the same bits.
		val s = x as i16
		assert(s.countOnes() as u16 == x.countOnes() && s.leadingZeros() as u16 == x.leadingZeros())
		assert(
			s.trailingZeros() as u16 == x.trailingZeros() &&
				s.reverseBits() as u16 == x.reverseBits(),
		)
		assert(s.swapBytes() as u16 == x.swapBytes())
		assert(s.rotateLeft(amount as i16) as u16 == x.rotateLeft(amount))
		assert(s.rotateRight(amount as i16) as u16 == x.rotateRight(amount))
	}
}

