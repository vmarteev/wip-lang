@test
fn the128BitMethodsAreTheBitsCountedAndTurned() = {
	val values = bitSamples()
	for k in 0..values.len() {
		val wide = low(values[k], 128)
		val x = wide as u128
		val amount = (values[(k * 7 + 1) % values.len()] % 300) as u128
		assert(x.countOnes() as u128 == slowCountOnes(wide, 128), "countOnes of \(x)")
		assert(x.leadingZeros() as u128 == slowLeadingZeros(wide, 128), "leadingZeros of \(x)")
		assert(x.trailingZeros() as u128 == slowTrailingZeros(wide, 128), "trailingZeros of \(x)")
		assert(x.reverseBits() as u128 == slowReverseBits(wide, 128), "reverseBits of \(x)")
		assert(x.swapBytes() as u128 == slowSwapBytes(wide, 128), "swapBytes of \(x)")
		val left = slowRotateLeft(wide, amount as u128, 128)
		assert(x.rotateLeft(amount) as u128 == left, "\(x) turned left by \(amount)")
		assert(
			x.rotateRight(amount).rotateLeft(amount) == x,
			"\(x) turned right by \(amount), and back",
		)
		// The signed type of the width has the same bits.
		val s = x as i128
		assert(
			s.countOnes() as u128 == x.countOnes() && s.leadingZeros() as u128 == x.leadingZeros(),
		)
		assert(
			s.trailingZeros() as u128 == x.trailingZeros() &&
				s.reverseBits() as u128 == x.reverseBits(),
		)
		assert(s.swapBytes() as u128 == x.swapBytes())
		assert(s.rotateLeft(amount as i128) as u128 == x.rotateLeft(amount))
		assert(s.rotateRight(amount as i128) as u128 == x.rotateRight(amount))
	}
}

@test
fn theEdgesAreDefined() = {
	assert((0 as u8).leadingZeros() == 8 && (0 as u8).trailingZeros() == 8, "the width, for 0")
	assert((0 as i64).leadingZeros() == 64 && (0 as u128).trailingZeros() == 128)
	assert((-1).countOnes() == 64 && (-1).leadingZeros() == 0, "a signed number's two's complement")
	assert((-128 as i8).trailingZeros() == 7 && (-1 as i8).countOnes() == 8)
	assert((0x81 as u8).rotateLeft(9) == 3, "the amount, modulo the width")
	assert(
		(1 as i64).rotateLeft(-1) == (1 as i64).rotateRight(1),
		"a negative amount turns the other way",
	)
	assert((1 as i64).rotateRight(1) < 0)
	assert((0x12 as u8).swapBytes() == 0x12, "one byte has no other order")
	assert((0x1234 as u16).swapBytes() == 0x3412 && (0x12345678 as u32).swapBytes() == 0x78563412)
	assert((1 as usize).leadingZeros() == 63 && (8 as isize).trailingZeros() == 3)
	val size: u64 = 1000
	assert(1 << (64 - (size - 1).leadingZeros()) == 1024, "a count is a shift's amount, as it is")
}

@comptime
val COUNTED: [u64; 7] = [
	(0xF0F0 as u64).countOnes(),
	(0xF0F0 as u64).leadingZeros(),
	(0xF0F0 as u64).trailingZeros(),
	(0xF0F0 as u64).rotateLeft(60),
	(0xF0F0 as u64).rotateRight(8),
	(0xF0F0 as u64).swapBytes(),
	(0xF0F0 as u64).reverseBits(),
]

@comptime
val NARROW: [i8; 5] = [
	(-16 as i8).countOnes(),
	(3 as i8).leadingZeros(),
	(-16 as i8).rotateLeft(5),
	(-16 as i8).reverseBits(),
	(0 as i8).trailingZeros(),
]

@comptime
val WIDE: [u128; 3] = [
	(1 as u128).rotateRight(1),
	(0x0102 as u128).swapBytes(),
	(1 as u128).reverseBits().leadingZeros(),
]

assert((0b1011_0000 as u8).countOnes() == 3)

@test
fn theCompilerCountsAndTurnsTheSameBits() = {
	val word: u64 = 0xF0F0
	val counted = [
		word.countOnes(),
		word.leadingZeros(),
		word.trailingZeros(),
		word.rotateLeft(60),
		word.rotateRight(8),
		word.swapBytes(),
		word.reverseBits(),
	]
	for i in 0..7 {
		assert(COUNTED[i] == counted[i])
	}
	val small: i8 = -16
	val narrow = [
		small.countOnes(),
		(3 as i8).leadingZeros(),
		small.rotateLeft(5),
		small.reverseBits(),
		(0 as i8).trailingZeros(),
	]
	for i in 0..5 {
		assert(NARROW[i] == narrow[i])
	}
	val one: u128 = 1
	assert(WIDE[0] == one.rotateRight(1) && WIDE[0] == 0x80000000000000000000000000000000)
	assert(WIDE[1] == (0x0102 as u128).swapBytes() && WIDE[2] == one.reverseBits().leadingZeros())
}
