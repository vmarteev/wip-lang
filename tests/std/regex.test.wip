// `std::regex`: what a pattern matches, the groups it
// captures, what it replaces, and what it refuses to compile.

import std::regex::{Regex, Problem}

/// What `pattern` makes of `text` with `replacement`.
fn replaced(pattern: str, text: str, replacement: str): String = match Regex::new(pattern) {
	.Ok(re) => re.replaceAll(text, replacement)
	.Err(..) => "<not a pattern>"
}

@test
fn aPatternFindsTheLeftmostMatch() = {
	val .Ok(re) = Regex::new("\\d+") else {
		assert(false, "a pattern of digits compiles")
		return
	}
	assert(re.isMatch("img12.jpg"))
	assert(!re.isMatch("img.jpg"))
	val .Some(found) = re.find("a1b22c333") else {
		assert(false, "there are digits")
		return
	}
	assert(found.start == 1 && found.end == 2, "the leftmost, not the longest")
}

@test
fn alternativesAndRepetitionsAreChosenAsWritten() = {
	assert(replaced("a|ab", "ab", "X") == "Xb", "the alternative written first")
	assert(replaced("x{2,3}", "xxxxx", "Y") == "YY", "as many as can be")
	assert(replaced("x{2,3}?", "xxxxx", "Y") == "YYx", "or, with ?, as few")
	assert(replaced("(?:ab)+", "ababx", "Z") == "Zx")
}

@test
fn groupsCaptureAndAreReplacedByNumber() = {
	val .Ok(re) = Regex::new("^(\\w+)\\.(\\w+)$") else {
		assert(false, "it compiles")
		return
	}
	assert(re.groups() == 2)
	val .Some(found) = re.find("notes.txt") else {
		assert(false, "it matches")
		return
	}
	assert(found.group(1) == .Some((0, 5)) && found.group(2) == .Some((6, 9)))
	assert(found.group(3).isNone(), "there is no third group")
	assert(re.replaceAll("notes.txt", "$2.$1") == "txt.notes")
	assert(replaced("(\\d+)", "a1b22", "<${1}>") == "a<1>b<22>")
	assert(replaced("(a)|(b)", "b", "[$1|$2]") == "[|b]", "a group that took no part is nothing")
	assert(replaced("x", "x", "$$1") == "$1", "$$ is a $")
}

@test
fn classesTakeWholeCharacters() = {
	assert(replaced(".", "añ😀", "<$0>") == "<a><ñ><😀>")
	assert(replaced("[^a-c]+", "abcdefabc", "_") == "abc_abc")
	assert(replaced("[\\d-]+", "ab-12-3c", "#") == "ab#c")
	assert(replaced("\\s", "a b\tc", "") == "abc")
	assert(replaced("[ñ-ü]", "año", "n") == "ano")
}

@test
fn emptyMatchesAreCountedAsRustCountsThem() = {
	assert(replaced("", "ab", "X") == "XaXbX")
	assert(replaced("a*", "baaa", "-") == "-b-")
}

@test
fn noPatternTakesLongerThanTheTextTimesThePattern() = {
	// A backtracking matcher takes 2^50 steps over this; a Pike VM, a few
	// thousand.
	val text = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaac"
	assert(replaced("(a*)*b", text, "!") == text)
}

@test
fn whatIsNotAPatternSaysWhyAndWhere() = {
	val cases = [
		("(a", Problem::UnclosedGroup, 0),
		("a)", Problem::UnopenedGroup, 1),
		("[a", Problem::UnclosedClass, 0),
		("*a", Problem::NothingToRepeat, 0),
		("a{3,1}", Problem::BadRepeat, 1),
		("a{1001}", Problem::BadRepeat, 1),
		("\\q", Problem::BadEscape, 0),
		("[z-a]", Problem::BackwardsRange, 1),
		("(?P<n>a)", Problem::UnknownGroup, 0),
	]
	for case in cases {
		match Regex::new(case.0) {
			.Ok(..) => assert(false, "a broken pattern is refused")
			.Err(why) => assert(why.problem == case.1 && why.at == case.2, "with what and where")
		}
	}
}

@test
fn aPatternInAnyCaseMatchesLettersEitherWay() = {
	val .Ok(host) = Regex::anyCase("^(www\\.)?example\\.com$") else {
		assert(false, "it compiles")
		return
	}
	assert(host.isMatch("example.com") && host.isMatch("WWW.Example.COM"))
	assert(!host.isMatch("example.org"))
	assert(
		!Regex::new("^example\\.com$").unwrap().isMatch("EXAMPLE.COM"),
		"without it, case counts",
	)
	val .Ok(letters) = Regex::anyCase("^[a-c]+[X-Z]$") else {
		assert(false, "classes compile")
		return
	}
	assert(letters.isMatch("aBcz") && letters.isMatch("CBAX"))
	assert(!letters.isMatch("abd"))
	// A negated class refuses both cases of what it names.
	val .Ok(notA) = Regex::anyCase("^[^a]$") else {
		assert(false, "negated classes compile")
		return
	}
	assert(!notA.isMatch("a") && !notA.isMatch("A") && notA.isMatch("b"))
	// Digits and what is not a letter are as written; beyond ASCII, a
	// letter matches as written.
	assert(Regex::anyCase("^[0-9_]+$").unwrap().isMatch("09_"))
	assert(
		Regex::anyCase("^é$").unwrap().isMatch("é") && !Regex::anyCase("^é$").unwrap().isMatch("É"),
	)
	assert(Regex::anyCase("\\w+").unwrap().replaceAll("Hello, World", "x") == "x, x")
}
