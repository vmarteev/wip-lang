import std::c
import std::math::{
	Aabb,
	Mat3,
	Mat4,
	Mat4d,
	Noise,
	PI,
	Plane,
	Quat,
	Ray,
	Sphere,
	Vec2,
	Vec2d,
	Vec3,
	Vec3d,
	Vec4,
	Vec4d
}

val CLOSE: f32 = 0.00001

@test
fn vectorsAddScaleAndMultiplyAxisByAxis() = {
	val a = Vec3::of(1.0, 2.0, 3.0)
	val b = Vec3::of(4.0, -5.0, 6.0)
	assert(a + b == Vec3::of(5.0, -3.0, 9.0) && a - b == Vec3::of(-3.0, 7.0, -3.0))
	assert(a * 2.0 == Vec3::of(2.0, 4.0, 6.0) && 2.0 * a == a * 2.0)
	assert(a / 2.0 == Vec3::of(0.5, 1.0, 1.5) && -a == Vec3::of(-1.0, -2.0, -3.0))
	assert(a * b == Vec3::of(4.0, -10.0, 18.0))
	var moved = a
	moved += b
	moved *= 0.5
	assert(moved == Vec3::of(2.5, -1.5, 4.5))
	assert(Vec2::of(1.0, 2.0) + Vec2::one() == Vec2::of(2.0, 3.0))
	assert(Vec4::splat(1.0) - Vec4::unitW() == Vec4::of(1.0, 1.0, 1.0, 0.0))
	assert(Vec3::zero() == Vec3::splat(0.0))
}

@test
fn aDotAndACrossProductAreTheRightHandsOnes() = {
	val a = Vec3::of(1.0, 2.0, 3.0)
	val b = Vec3::of(4.0, -5.0, 6.0)
	assert(a.dot(b) == 12.0)
	assert(a.cross(b) == Vec3::of(27.0, 6.0, -13.0))
	assert(Vec3::unitX().cross(Vec3::unitY()) == Vec3::unitZ())
	assert(
		a.cross(b).dot(a) == 0.0 && a.cross(b).dot(b) == 0.0,
		"the cross product is at right angles to both",
	)
	assert(Vec2::of(3.0, 4.0).dot(Vec2::of(-4.0, 3.0)) == 0.0)
}

@test
fn lengthsDistancesAndDirections() = {
	val v = Vec3::of(3.0, 4.0, 12.0)
	assert(v.length() == 13.0 && v.lengthSquared() == 169.0)
	assert(Vec2::of(1.0, 1.0).distance(Vec2::of(4.0, 5.0)) == 5.0)
	assert(v.normalized().approxEquals(Vec3::of(3.0 / 13.0, 4.0 / 13.0, 12.0 / 13.0), CLOSE))
	assert((v.normalized().length() - 1.0).abs() < CLOSE)
	val none = Vec3::zero().normalized()
	assert(none.x.isNaN() && none.y.isNaN() && none.z.isNaN(), "a zero vector has no direction")
	assert(Vec3::zero().normalizedOr(Vec3::unitY()) == Vec3::unitY())
	assert(v.normalizedOr(Vec3::unitY()) == v.normalized())
	assert((Vec3::unitX().angleTo(Vec3::unitY()) - (PI / 2.0) as f32).abs() < CLOSE)
	assert(Vec3::unitX().angleTo(Vec3::unitX() * 5.0) == 0.0)
}

@test
fn betweenAndAroundOtherVectors() = {
	val a = Vec3::of(0.0, 10.0, -4.0)
	val b = Vec3::of(10.0, 20.0, 4.0)
	assert(
		a.lerp(b, 0.0) == a && a.lerp(b, 1.0) == b && a.lerp(b, 0.25) == Vec3::of(2.5, 12.5, -2.0),
	)
	assert(
		a.min(b) == a &&
			a.max(b) == b &&
			Vec3::of(-1.0, 2.0, -3.0).abs() == Vec3::of(1.0, 2.0, 3.0),
	)
	assert(Vec3::of(-5.0, 15.0, 0.0).clamp(a, b) == Vec3::of(0.0, 15.0, 0.0))
	assert(
		Vec3::of(1.0, -1.0, 0.0).reflect(Vec3::unitY()) == Vec3::of(1.0, 1.0, 0.0),
		"a ball off the floor",
	)
}

@test
fn vectorsChangeSizeAndPrecision() = {
	val v = Vec2::of(1.0, 2.0).extend(3.0)
	assert(v == Vec3::of(1.0, 2.0, 3.0) && v.xy() == Vec2::of(1.0, 2.0))
	val p = v.extend(1.0)
	assert(p == Vec4::of(1.0, 2.0, 3.0, 1.0) && p.xyz() == v && p.xy() == v.xy())
	assert(v.toF64() == Vec3d::of(1.0, 2.0, 3.0) && v.toF64().toF32() == v)
	assert("\(Vec2::of(1.5, -2.0))" == "Vec2(x: 1.5, y: -2)")
}

@test
fn aFarPositionIsExactRelativeToTheCamera() = {
	// Four billion metres from the origin an `f32` steps by 512 metres; the
	// difference of two `f64` positions there is exact.
	val ship = Vec3d::of(4.2e9, 0.0, -1.7e8)
	val camera = Vec3d::of(4.2e9 - 3.25, 1.5, -1.7e8 + 0.125)
	assert(ship.relativeTo(camera) == Vec3::of(3.25, -1.5, -0.125))
	assert((ship.toF32() - camera.toF32()).x == 0.0, "while in `f32` alone the two are one place")
	assert(
		Vec2d::of(1.0, 2.0) * 2.0 == Vec2d::of(2.0, 4.0) && Vec4d::unitW().xyz() == Vec3d::zero(),
	)
	assert(Vec3d::unitX().cross(Vec3d::unitY()) == Vec3d::unitZ())
}

@test
fn aQuaternionTurnsAsItsMatrixDoes() = {
	val quarter = Quat::axisAngle(Vec3::unitZ(), (PI / 2.0) as f32)
	assert(
		(quarter * Vec3::unitX()).approxEquals(Vec3::unitY(), CLOSE),
		"a quarter turn about z takes x to y",
	)
	val turn = Quat::axisAngle(Vec3::of(1.0, 2.0, 3.0).normalized(), 0.7)
	val point = Vec3::of(-2.0, 0.5, 4.0)
	assert((turn * point).approxEquals(Mat4::rotation(turn).transformPoint(point), CLOSE))
	assert((turn * point).approxEquals(Mat3::rotation(turn) * point, CLOSE))
	assert(((turn * point).length() - point.length()).abs() < CLOSE, "a rotation keeps lengths")
	assert((turn * turn.inverse()).approxEquals(Quat::identity(), CLOSE))
	assert(turn.conjugate().approxEquals(turn.inverse(), CLOSE))
	assert(
		(turn * quarter * point).approxEquals(turn * (quarter * point), CLOSE),
		"`a * b` turns by `b` first",
	)
}

@test
fn aQuaternionTurnsBetweenTwoDirections() = {
	val from = Vec3::of(1.0, 1.0, 0.0).normalized()
	val to = Vec3::of(0.0, 0.0, -1.0)
	assert((Quat::fromRotationArc(from, to) * from).approxEquals(to, CLOSE))
	assert((Quat::fromRotationArc(to, to) * from).approxEquals(from, CLOSE))
	assert((Quat::fromRotationArc(to, -to) * to).approxEquals(-to, CLOSE), "half a circle")
	val start = Quat::identity()
	val end = Quat::axisAngle(Vec3::unitY(), 2.0)
	assert(
		start.slerp(end, 0.0).approxEquals(start, CLOSE) &&
			start.slerp(end, 1.0).approxEquals(end, CLOSE),
	)
	assert(
		start.slerp(end, 0.5).approxEquals(Quat::axisAngle(Vec3::unitY(), 1.0), CLOSE),
		"at a steady rate",
	)
}

@test
fn matricesMoveTurnAndScaleInTheOrderWritten() = {
	val point = Vec3::of(1.0, 2.0, 3.0)
	assert(
		Mat4::translation(Vec3::of(10.0, 0.0, -1.0)).transformPoint(point) ==
			Vec3::of(11.0, 2.0, 2.0),
	)
	assert(Mat4::translation(Vec3::of(10.0, 0.0, -1.0)).transformDirection(point) == point)
	assert(Mat4::scale(Vec3::of(2.0, 3.0, 4.0)).transformPoint(point) == Vec3::of(2.0, 6.0, 12.0))
	assert(
		Mat4::rotationZ((PI / 2.0) as f32).transformPoint(Vec3::unitX()).approxEquals(
			Vec3::unitY(),
			CLOSE,
		),
	)
	assert(
		Mat4::rotationX((PI / 2.0) as f32).transformPoint(Vec3::unitY()).approxEquals(
			Vec3::unitZ(),
			CLOSE,
		),
	)
	assert(
		Mat4::rotationY((PI / 2.0) as f32).transformPoint(Vec3::unitZ()).approxEquals(
			Vec3::unitX(),
			CLOSE,
		),
	)
	// Scaled first, then moved.
	val model = Mat4::translation(Vec3::of(0.0, 5.0, 0.0)) * Mat4::scale(Vec3::splat(2.0))
	assert(model.transformPoint(point) == Vec3::of(2.0, 9.0, 6.0))
	assert(Mat4::identity() * model == model && model * Mat4::identity() == model)
	val numbers = model.toArray()
	assert(numbers[0] == 2.0 && numbers[13] == 5.0 && numbers[15] == 1.0, "a column at a time")
	assert(Mat4::fromArray(numbers) == model)
	assert(Mat4::fromRows(model.x, model.y, model.z, model.w) == model.transposed())
}

@test
fn aMatrixByItsInverseIsTheIdentity() = {
	val model =
		Mat4::translation(Vec3::of(3.0, -1.0, 7.5)) *
		Mat4::rotation(Quat::axisAngle(Vec3::of(1.0, 1.0, 0.0).normalized(), 0.9)) *
		Mat4::scale(Vec3::of(2.0, 0.5, 3.0))
	val .Some(inverse) = model.inverse() else panic("it has one")
	assert((model * inverse).approxEquals(Mat4::identity(), 0.0001))
	assert((model.determinant() - 3.0).abs() < 0.0001, "the scale's volume")
	assert(Mat4::scale(Vec3::of(1.0, 0.0, 1.0)).inverse().isNone(), "flattened, it has none")
	val turn =
		Mat3::rotation(Quat::axisAngle(Vec3::unitY(), 0.3)) * Mat3::scale(Vec3::of(2.0, 2.0, 2.0))
	val .Some(back) = turn.inverse() else panic("it has one")
	assert(
		(turn * back).approxEquals(Mat3::identity(), CLOSE) &&
			(turn.determinant() - 8.0).abs() < 0.0001,
	)
	assert(Mat3::fromMat4(Mat4::scale(Vec3::splat(2.0))) == Mat3::scale(Vec3::splat(2.0)))
	assert(turn.toColumns4()[2] == turn.z.extend(0.0))
}

@test
fn aCameraLooksDownMinusZ() = {
	val eye = Vec3::of(0.0, 2.0, 6.0)
	val view = Mat4::lookAt(eye, target: Vec3::zero(), up: Vec3::unitY())
	assert(view.transformPoint(eye).approxEquals(Vec3::zero(), CLOSE), "the camera at the origin")
	assert(view.transformPoint(Vec3::zero()).approxEquals(Vec3::of(0.0, 0.0, -eye.length()), CLOSE))
	assert(
		view.transformDirection(Vec3::unitX()).approxEquals(Vec3::unitX(), CLOSE),
		"right stays right",
	)
}

@test
fn projectionsPutNearAndFarAtTheDepthsTheGpuWants() = {
	val gl = Mat4::perspective(fovY: 1.0, aspect: 2.0, near: 0.5, far: 50.0)
	val zeroToOne = Mat4::perspectiveZeroToOne(fovY: 1.0, aspect: 2.0, near: 0.5, far: 50.0)
	val depth = (m: Mat4, z: f32) => {
		val clip = m * Vec4::of(0.0, 0.0, z, 1.0)
		return clip.z / clip.w
	}
	assert((depth(gl, -0.5) + 1.0).abs() < CLOSE && (depth(gl, -50.0) - 1.0).abs() < 0.0001)
	assert(depth(zeroToOne, -0.5).abs() < CLOSE && (depth(zeroToOne, -50.0) - 1.0).abs() < 0.0001)
	val top = gl * Vec4::of(0.0, (0.5 as f32).tan(), -1.0, 1.0)
	assert((top.y / top.w - 1.0).abs() < CLOSE, "the top of the view at the top of the screen")
	val box = Mat4::orthographic(-4.0, 4.0, -2.0, 2.0, 1.0, 11.0)
	assert(
		box.transformPoint(Vec3::of(4.0, -2.0, -1.0)).approxEquals(
			Vec3::of(1.0, -1.0, -1.0),
			CLOSE,
		),
	)
	val flat = Mat4::orthographicZeroToOne(-4.0, 4.0, -2.0, 2.0, 1.0, 11.0)
	assert(
		flat.transformPoint(Vec3::of(0.0, 0.0, -11.0)).approxEquals(Vec3::of(0.0, 0.0, 1.0), CLOSE),
	)
}

@test
fn aLargeWorldsTransformIsTakenRelativeToTheCamera() = {
	val ship = Vec3d::of(4.2e9, 0.0, -1.7e8)
	val camera = Vec3d::of(4.2e9 - 2.0, 0.0, -1.7e8)
	val place = Mat4d::translation(ship) * Mat4d::scale(Vec3d::splat(2.0))
	assert(place.transformPoint(Vec3d::unitX()) == ship + Vec3d::of(2.0, 0.0, 0.0))
	val near = place.relativeTo(camera)
	assert(near.transformPoint(Vec3::unitX()) == Vec3::of(4.0, 0.0, 0.0))
	assert(
		Mat4d::rotation(Quat::identity()) == Mat4d::identity() &&
			Mat4::identity().toF64().toF32() == Mat4::identity(),
	)
}

@test
fn raysMeetTheShapesWhereTheyAre() = {
	val box = Aabb::of(Vec3::of(-1.0, -1.0, -1.0), Vec3::of(1.0, 1.0, 1.0))
	val ray = Ray::of(Vec3::of(-5.0, 0.0, 0.0), Vec3::unitX())
	assert(box.hit(ray) == .Some(4.0) && ray.at(4.0) == Vec3::of(-1.0, 0.0, 0.0))
	assert(box.hit(Ray::of(Vec3::zero(), Vec3::unitY())) == .Some(0.0), "from inside, at once")
	assert(box.hit(Ray::of(Vec3::of(-5.0, 2.0, 0.0), Vec3::unitX())).isNone())
	assert(box.hit(Ray::of(Vec3::of(5.0, 0.0, 0.0), Vec3::unitX())).isNone(), "behind")
	val ball = Sphere::of(Vec3::of(0.0, 0.0, -10.0), 2.0)
	assert(ball.hit(Ray::of(Vec3::zero(), -Vec3::unitZ())) == .Some(8.0))
	assert(ball.hit(Ray::of(Vec3::zero(), Vec3::unitZ())).isNone())
	val floor = Plane::of(Vec3::zero(), Vec3::unitY())
	assert(floor.hit(Ray::of(Vec3::of(0.0, 3.0, 0.0), -Vec3::unitY())) == .Some(3.0))
	assert(floor.hit(Ray::of(Vec3::of(0.0, 3.0, 0.0), Vec3::unitX())).isNone())
	assert(floor.signedDistance(Vec3::of(7.0, -2.0, 1.0)) == -2.0)
}

@test
fn shapesTouchOrDoNot() = {
	val box = Aabb::enclosing([Vec3::of(1.0, 5.0, -2.0), Vec3::of(-3.0, 0.0, 4.0), Vec3::zero()])
	assert(box == Aabb::of(Vec3::of(-3.0, 0.0, -2.0), Vec3::of(1.0, 5.0, 4.0)))
	assert(box.center() == Vec3::of(-1.0, 2.5, 1.0) && box.size() == Vec3::of(4.0, 5.0, 6.0))
	assert(box.contains(Vec3::of(0.0, 5.0, 0.0)) && !box.contains(Vec3::of(0.0, 5.5, 0.0)))
	assert(box.intersects(Aabb::of(Vec3::of(1.0, 1.0, 1.0), Vec3::splat(9.0))))
	assert(!box.intersects(Aabb::of(Vec3::of(1.5, 1.0, 1.0), Vec3::splat(9.0))))
	assert(box.intersectsSphere(Sphere::of(Vec3::of(3.0, 2.0, 0.0), 2.0)))
	assert(!box.intersectsSphere(Sphere::of(Vec3::of(3.0, 2.0, 0.0), 1.5)))
	val ball = Sphere::of(Vec3::zero(), 1.0)
	assert(ball.contains(Vec3::of(0.6, 0.8, 0.0)) && !ball.contains(Vec3::of(0.6, 0.8, 0.1)))
	assert(ball.intersects(Sphere::of(Vec3::of(3.0, 0.0, 0.0), 2.0)))
	assert(!ball.intersects(Sphere::of(Vec3::of(3.0, 0.0, 0.0), 1.5)))
	val none: [Vec3; 0] = []
	assert(Aabb::enclosing(&none).enclose(Vec3::unitX()) == Aabb::of(Vec3::unitX(), Vec3::unitX()))
}

@test
fn theLayoutsAreWhatCAndAGpuRead() = {
	assert(c::sizeOf<Vec2>() == 8 && c::alignOf<Vec2>() == 4)
	assert(c::sizeOf<Vec3>() == 12 && c::alignOf<Vec3>() == 4, "a vertex's position, as C's")
	assert(c::sizeOf<Vec4>() == 16 && c::alignOf<Vec4>() == 16)
	assert(c::sizeOf<Quat>() == 16 && c::alignOf<Quat>() == 16)
	assert(c::sizeOf<Mat3>() == 36 && c::sizeOf<Mat4>() == 64 && c::alignOf<Mat4>() == 16)
	assert(c::offsetOf<Mat4>("w") == 48 && c::sizeOf<Vec3d>() == 24)
}

@test
fn noiseIsPerlinsAndASeedIsAWorld() = {
	val perlin = Noise::perlin()
	assert(perlin.at3(3.14, 42.0, 7.0) == 0.13691995878400012, "his reference value")
	assert(perlin.at3(1.0, 2.0, 3.0) == 0.0 && perlin.at2(-4.0, 9.0) == 0.0, "zero at whole points")
	val world = Noise::seeded(7)
	var low = 1.0
	var high = -1.0
	for i in 0..10000 {
		val value = world.at2(i as f64 * 0.137, i as f64 * 0.071)
		low = low.min(value)
		high = high.max(value)
	}
	assert(low >= -1.0 && high <= 1.0 && low < -0.5 && high > 0.5)
	assert(Noise::seeded(7).at2(1.3, 2.7) == world.at2(1.3, 2.7), "the same seed, the same world")
	assert(Noise::seeded(8).at2(1.3, 2.7) != world.at2(1.3, 2.7))
	// Nearby points are alike: noise is smooth.
	assert((world.at3(0.5, 0.5, 0.5) - world.at3(0.501, 0.5, 0.5)).abs() < 0.01)
	val terrain = world.fractal2(0.3, 0.7, 5)
	assert(terrain >= -1.0 && terrain <= 1.0 && terrain != world.at2(0.3, 0.7))
	assert(
		world.fractal3(0.3, 0.7, 0.0, 1) == world.at2(0.3, 0.7),
		"one octave is the noise itself",
	)
}
