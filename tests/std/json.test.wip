// `std::json`: what a document reads as, what a value
// writes as, what is refused, where, and how a value that is there is read.

import std::json
import std::json::{Json, JsonError, Problem, MOST_NESTED}

/// What `text` reads as, written back; or the error, written.
fn reread(text: str): String = match json::parse(text) {
    .Ok(value) => "\(value)"
    .Err(error) => "\(error)"
}

/// The problem `text` is refused for, and where.
fn refused(text: str): Option<JsonError> = match json::parse(text) {
    .Ok(..) => .None
    .Err(error) => .Some(error)
}

/// The line and column `text` is refused at.
fn whereRefused(text: str): Option<(i64, i64)> = match refused(text) {
    .Some(error) => .Some((error.line, error.column))
    .None => .None
}

/// Whether `text` is refused for `problem`.
fn refusedFor(text: str, problem: Problem): bool = match refused(text) {
    .Some(error) => error.problem == problem
    .None => false
}

@test
fn eachKindOfValueIsRead() = {
    assert(json::parse("null") == .Ok(.Null))
    assert(json::parse("true") == .Ok(.Bool(value: true)))
    assert(json::parse("false") == .Ok(.Bool(value: false)))
    assert(json::parse("42") == .Ok(.Int(value: 42)))
    assert(json::parse("-2.5") == .Ok(.Float(value: -2.5)))
    assert(json::parse("\"hi\"") == .Ok(.Text(text: String::of("hi"))))
    assert(json::parse("[]") == .Ok(.Array(items: Vec())))
    assert(json::parse("{}") == .Ok(.Object(fields: Vec())))
}

@test
fn anObjectKeepsItsFieldsInTheOrderWritten() = {
    val .Ok(.Object(fields)) = json::parse("{\"b\": 1, \"a\": [true, null], \"b\": 2}") else {
        assert(false, "an object")
        return
    }
    assert(fields.len() == 3, "a name written twice is kept twice")
    assert(fields[0].0 == "b" && fields[0].1 == .Int(value: 1))
    assert(fields[1].0 == "a")
    assert(fields[2].0 == "b" && fields[2].1 == .Int(value: 2))
}

@test
fn whiteSpaceIsAllowedBetweenTheParts() = {
    assert(reread(" \t\r\n[ 1 , { \"a\" : 2 } ]\n ") == "[1,{\"a\":2}]")
}

@test
fn aNumberIsAnIntWhereItFits() = {
    assert(json::parse("9223372036854775807") == .Ok(.Int(value: 9223372036854775807)))
    assert(json::parse("-9223372036854775808") == .Ok(.Int(value: -9223372036854775807 - 1)))
    assert(
        json::parse("9223372036854775808") == .Ok(.Float(value: 9223372036854775808.0)),
        "one past is a float",
    )
    assert(json::parse("1.0") == .Ok(.Float(value: 1.0)), "a fraction makes a float")
    assert(json::parse("1e2") == .Ok(.Float(value: 100.0)), "so does an exponent")
    assert(json::parse("0.1") == .Ok(.Float(value: 0.1)), "the nearest f64")
    assert(json::parse("-0") == .Ok(.Int(value: 0)))
}

@test
fn aNumberIsWrittenAsJsonWritesOne() = {
    assert(refusedFor("01", .TrailingText), "no leading zero")
    assert(refusedFor("-", .BadNumber))
    assert(refusedFor("+1", .ExpectedValue))
    assert(refusedFor(".5", .ExpectedValue))
    assert(refusedFor("1.", .BadNumber))
    assert(refusedFor("1e", .BadNumber))
    assert(refusedFor("1e+", .BadNumber))
    assert(refusedFor("-a", .BadNumber))
    assert(refusedFor("1e400", .NumberTooLarge))
    assert(refusedFor("NaN", .ExpectedValue))
    assert(refusedFor("Infinity", .ExpectedValue))
}

@test
fn aStringsEscapesAreRead() = {
    val read = json::parse("\"a\\\"b\\\\c\\/d\\be\\ff\\ng\\rh\\ti\"")
    assert(read == .Ok(.Text(text: String::of("a\"b\\c/d\u{8}e\u{c}f\ng\rh\ti"))))
    assert(json::parse("\"\\u00e9\\u4e2d\"") == .Ok(.Text(text: String::of("é中"))))
    assert(json::parse("\"\\ud83d\\ude00\"") == .Ok(.Text(text: String::of("😀"))), "a UTF-16 pair")
    assert(
        json::parse("\"\\u00E9\"") == .Ok(.Text(text: String::of("é"))),
        "either case of hexadecimal",
    )
    assert(json::parse("\"é😀\"") == .Ok(.Text(text: String::of("é😀"))), "UTF-8 as it is")
}

@test
fn aBadEscapeIsRefused() = {
    assert(refusedFor("\"\\x\"", .BadEscape))
    assert(refusedFor("\"\\u12\"", .BadEscape))
    assert(refusedFor("\"\\u12g4\"", .BadEscape))
    assert(refusedFor("\"\\", .BadEscape))
    assert(refusedFor("\"\\ud800\"", .LoneSurrogate), "a high half alone")
    assert(refusedFor("\"\\ud800\\u0041\"", .LoneSurrogate), "a high half before another character")
    assert(refusedFor("\"\\udc00\"", .LoneSurrogate), "a low half alone")
    assert(refusedFor("\"a\tb\"", .ControlInString), "a tab is written escaped")
    assert(refusedFor("\"abc", .UnclosedString))
}

@test
fn whatIsNotAValueIsRefused() = {
    assert(refusedFor("", .ExpectedValue))
    assert(refusedFor("   ", .ExpectedValue))
    assert(refusedFor("tru", .ExpectedValue))
    assert(refusedFor("nul", .ExpectedValue))
    assert(refusedFor("'a'", .ExpectedValue))
    assert(refusedFor("[1,]", .ExpectedValue), "no comma after the last element")
    assert(refusedFor("[1 2]", .ExpectedCommaOrBracket))
    assert(refusedFor("[1", .ExpectedCommaOrBracket))
    assert(refusedFor("{\"a\":1,}", .ExpectedName))
    assert(refusedFor("{a:1}", .ExpectedName))
    assert(refusedFor("{\"a\" 1}", .ExpectedColon))
    assert(refusedFor("{\"a\":1 \"b\":2}", .ExpectedCommaOrBrace))
    assert(refusedFor("{\"a\":}", .ExpectedValue))
    assert(refusedFor("[] []", .TrailingText))
    assert(refusedFor("1 x", .TrailingText))
}

@test
fn anErrorSaysWhereByLineAndColumn() = {
    assert(whereRefused("[1,\n  2,\n  x]") == .Some((3, 3)))
    assert(whereRefused("\"é\" x") == .Some((1, 5)), "columns count characters")
    assert(reread("{\n\"a\" 1}") == "expected `:` after a field's name, at line 2, column 5")
}

@test
fn nestingIsLimited() = {
    var deep = String()
    for n in 0..MOST_NESTED {
        deep.push("[")
    }
    for n in 0..MOST_NESTED {
        deep.push("]")
    }
    assert(json::parse(deep.toStr()).isOk(), "as deep as the limit")
    var deeper = String()
    for n in 0..100000 {
        deeper.push("[")
    }
    assert(refusedFor(deeper.toStr(), .TooDeep), "deeper is refused, not a crash")
}

@test
fn aValueIsWrittenCompact() = {
    var items: Vec<Json> = Vec()
    items.push(.Null)
    items.push(.Bool(value: true))
    items.push(.Int(value: -3))
    items.push(.Float(value: 0.5))
    items.push(.Text(text: String::of("a\"b")))
    var fields: Vec<(String, Json)> = Vec()
    fields.push((String::of("list"), .Array(items: move items)))
    fields.push((String::of("empty"), .Object(fields: Vec())))
    val value = Json::Object(fields: move fields)
    assert("\(value)" == "{\"list\":[null,true,-3,0.5,\"a\\\"b\"],\"empty\":{}}")
}

@test
fn aFloatIsWrittenToReadBackAsAFloat() = {
    assert("\(Json::Float(value: 1.0))" == "1.0", "not `1`, which reads as an Int")
    assert("\(Json::Float(value: 1e20))" == "1e+20")
    assert("\(Json::Float(value: 0.1 + 0.2))" == "0.30000000000000004")
    assert("\(Json::Float(value: 1.0 / 0.0))" == "null", "infinity has no JSON")
    assert("\(Json::Float(value: 0.0 / 0.0))" == "null", "nor has NaN")
}

@test
fn aStringIsWrittenWithItsEscapes() = {
    val written = "\(Json::Text(text: String::of("q\"b\\n\nr\rt\t\u{8}\u{c}\u{1}é")))"
    assert(written == "\"q\\\"b\\\\n\\nr\\rt\\t\\b\\f\\u0001é\"")
}

@test
fn whatIsWrittenReadsBackTheSame() = {
    val texts = [
        "{\"a\":[1,2.5,-7,1e+20,true,false,null],\"b\":{\"c\":\"x\\ny\\u0000\"},\"d\":[]}",
        "[0.30000000000000004,-0.0,1.7976931348623157e+308,5e-324]",
        "\"😀 é \\\\ \\\" /\"",
    ]
    for text in texts {
        val .Ok(first) = json::parse(text) else {
            assert(false, "the text reads")
            return
        }
        val written = "\(first)"
        assert(json::parse(written.toStr()) == .Ok(first.clone()), "the same value")
        assert(reread(written.toStr()) == written, "and the same text")
    }
}

@test
fn aFieldAndAnElementAreFoundByReference() = {
    val .Ok(doc) = json::parse("{\"kind\": \"Record\", \"size\": 8, \"inner\": [1, {\"name\": \"x\"}], \"kind\": \"Last\"}") else {
        assert(false, "a document")
        return
    }
    assert(doc.get("kind").flatMap((kind) => kind.asText()) == .Some("Last"), "the name written last")
    assert(doc.get("size").flatMap((size) => size.asInt()) == .Some(8))
    assert(doc.get("size").flatMap((size) => size.asFloat()) == .Some(8.0))
    assert(doc.get("missing").isNone() && doc.item(0).isNone(), "an object has no elements")
    val .Some(inner) = doc.get("inner") else {
        assert(false, "a field")
        return
    }
    assert(inner.asArray().map((items) => items.len()) == .Some(2))
    assert(inner.item(1).flatMap((item) => item.get("name")).flatMap((name) => name.asText()) == .Some("x"))
    assert(inner.item(2).isNone() && inner.item(-1).isNone())
}

@test
fn aValueIsReadAsItsKind() = {
    val .Ok(doc) = json::parse("[true, null, 1.5, \"a\"]") else {
        assert(false, "a document")
        return
    }
    assert(doc.item(0).flatMap((b) => b.asBool()) == .Some(true))
    assert(doc.item(1).map((n) => n.isNull()) == .Some(true))
    assert(doc.item(2).flatMap((f) => f.asInt()).isNone(), "a fraction is not an Int")
    assert(doc.item(3).flatMap((t) => t.asBool()).isNone(), "text is not a bool")
}
