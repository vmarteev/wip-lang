// `std::url`'s percent-encoding: what RFC 3986 leaves and what it encodes,
// a character beyond ASCII as its UTF-8, what the caller keeps, either
// case of digit read, `+` left as it is, and a `%` without its digits
// refused.

import std::url
import std::url::{UrlError}

@test
fn urlEncodesAllButTheUnreserved() = {
	assert(url::encode("AZaz09-._~") == "AZaz09-._~")
	assert(url::encode("a b&c=d/e?f#g") == "a%20b%26c%3Dd%2Fe%3Ff%23g")
	assert(url::encode("100%+") == "100%25%2B")
	assert(url::encode("é€") == "%C3%A9%E2%82%AC")
	assert(url::encode("") == "")
}

@test
fn urlKeepsWhatItIsTold() = {
	assert(url::encode("/docs/a b/", keep: "/") == "/docs/a%20b/")
	assert(url::encode("a=1&b", keep: "=&") == "a=1&b")
}

@test
fn urlDecodesEitherCaseAndLeavesThePlus() = {
	assert(url::decode("a%20b%2fc%2Fd") == .Ok(String::of("a b/c/d")))
	assert(url::decode("%c3%A9") == .Ok(String::of("é")))
	assert(url::decode("a+b") == .Ok(String::of("a+b")))
	val text = "any text: é, %, +, /, ?"
	assert(url::decode(url::encode(text)) == .Ok(String::of(text)))
}

@test
fn urlRefusesAPercentWithoutItsDigits() = {
	assert(url::decode("100%") == .Err(.BadEscape(3)))
	assert(url::decode("%2") == .Err(.BadEscape(0)))
	assert(url::decode("a%zz") == .Err(.BadEscape(1)))
	assert("\(UrlError::BadEscape(3))".contains("at 3"))
}
