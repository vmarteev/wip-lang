// `std::url`'s percent-encoding: what RFC 3986 leaves and what it encodes,
// a character beyond ASCII as its UTF-8, what the caller keeps, either
// case of digit read, `+` left as it is, and a `%` without its digits
// refused. Then `Url`: its parts, what `parse` refuses, and a literal's
// holes, each encoded as its part needs, a `Url` joined at the start, and
// what is refused as a URL is built by name.

import std::url
import std::url::{Url, UrlError}

@test
fn urlEncodesAllButTheUnreserved() = {
	assert(url::encode("AZaz09-._~") == "AZaz09-._~")
	assert(url::encode("a b&c=d/e?f#g") == "a%20b%26c%3Dd%2Fe%3Ff%23g")
	assert(url::encode("100%+") == "100%25%2B")
	assert(url::encode("é€") == "%C3%A9%E2%82%AC")
	assert(url::encode("") == "")
}

@test
fn urlKeepsWhatItIsTold() = {
	assert(url::encode("/docs/a b/", keep: "/") == "/docs/a%20b/")
	assert(url::encode("a=1&b", keep: "=&") == "a=1&b")
}

@test
fn urlDecodesEitherCaseAndLeavesThePlus() = {
	assert(url::decode("a%20b%2fc%2Fd") == String::of("a b/c/d"))
	assert(url::decode("%c3%A9") == String::of("é"))
	assert(url::decode("a+b") == String::of("a+b"))
	val text = "any text: é, %, +, /, ?"
	assert(url::decode(url::encode(text)) == String::of(text))
}

@test
fn urlRefusesAPercentWithoutItsDigits() = {
	assert(url::decode("100%") == .Err(.BadEscape(3)))
	assert(url::decode("%2") == .Err(.BadEscape(0)))
	assert(url::decode("a%zz") == .Err(.BadEscape(1)))
	assert("\(UrlError::BadEscape(3))".contains("at 3"))
}

@test
fn aUrlAnswersItsPartsAsWritten() = {
	val url = Url::parse("HTTPS://ada@[::1]:8443/a/b%20c?x=1&y=2#top").unwrap()
	assert(url.scheme() == "HTTPS" && url.userInfo() == "ada" && url.host() == "::1")
	assert(url.port() == Option::Some(8443 as u16) && url.path() == "/a/b%20c")
	assert(url.query() == "x=1&y=2" && url.fragment() == "top")
	assert(url.toStr() == "HTTPS://ada@[::1]:8443/a/b%20c?x=1&y=2#top" && "\(url)" == url.toStr())
	val relative = Url::parse("/users/7?tab=posts").unwrap()
	assert(relative.scheme().isNone() && relative.host().isNone())
	assert(relative.path() == "/users/7" && relative.query() == "tab=posts")
	val bare = Url::parse("http://example.com").unwrap()
	assert(bare.path() == "" && bare.port().isNone() && bare.query().isNone())
	assert(Url::parse("mailto:ada@example.com").unwrap().path() == "ada@example.com")
	assert(Url::parse("a/b").unwrap() == Url::parse("a/b").unwrap())
}

@test
fn whatIsNotAUrlIsRefusedAtItsByte() = {
	assert(Url::parse("1http://x/") == .Err(.BadScheme(0)))
	assert(Url::parse("ht tp://x/") == .Err(.NotAllowed(2)))
	assert(Url::parse("ht_tp://x/") == .Err(.BadScheme(2)))
	assert(Url::parse("http://x:8a/") == .Err(.BadPort(10)))
	assert(Url::parse("http://x:99999/") == .Err(.BadPort(9)))
	assert(Url::parse("http://[::1/") == .Err(.UnclosedBracket(7)))
	assert(Url::parse("/a%2") == .Err(.BadEscape(2)))
	assert("\(UrlError::BadPort(9))" == "a port is a number up to 65535, at 9")
}

@test
fn aHoleIsEncodedAsItsPartNeeds() = {
	val every = "a b/?#&=+;@:[]%é"
	val path: Url = "https://example.com/users/\(every)/posts"
	assert(
		path.path() == "/users/a%20b%2F%3F%23%26%3D%2B%3B%40%3A%5B%5D%25%C3%A9/posts",
		path.toStr(),
	)
	val query: Url = "https://example.com/?tag=\(every)&page=2"
	assert(query.query() == "tag=a%20b%2F%3F%23%26%3D%2B%3B%40%3A%5B%5D%25%C3%A9&page=2")
	val fragment: Url = "https://example.com/#\(every)"
	assert(fragment.fragment() == "a%20b%2F%3F%23%26%3D%2B%3B%40%3A%5B%5D%25%C3%A9")
	val host: Url = "http://\(every)/"
	assert(
		host.host() == "a%20b%2F%3F%23&=+;%40%3A%5B%5D%25%C3%A9" && host.path() == "/",
		host.toStr(),
	)
	val address = "::1]/x"
	val bracketed: Url = "http://[\(address)]:8080/"
	assert(bracketed.host() == "::1%5D%2F%78" && bracketed.port() == Option::Some(8080 as u16))
	val loopback = "::1"
	assert(
		Url::parse("http://[::1]/").unwrap() == "http://[\(loopback)]/",
		"an address's `:` is kept",
	)
	val port = "80/x"
	val ported: Url = "http://example.com:\(port)/"
	assert(ported.portText() == "80%2F%78" && ported.path() == "/")
	val id = 7
	val plain: Url = "/users/\(id)/a-b_c.d~e"
	assert(plain.toStr() == "/users/7/a-b_c.d~e", "the unreserved are as they are")
	val name = "../admin"
	val climbed: Url = "/users/\(name)/posts"
	assert(climbed.path() == "/users/..%2Fadmin/posts")
}

@test
fn aUrlJoinedAtTheStartIsWhatTheRestGoesOnFrom() = {
	val api: Url = "https://api.example.com/v1"
	val user = "a/b"
	val posts: Url = "\(api)/users/\(user)/posts"
	assert(posts.toStr() == "https://api.example.com/v1/users/a%2Fb/posts")
	val search: Url = "https://example.com/find?q=wip"
	val tag = "a&b"
	val paged: Url = "\(search)&tag=\(tag)"
	assert(paged.query() == "q=wip&tag=a%26b")
}

/// A URL of `text` and then a hole of `value`, given to `pushValue` by name.
fn holeAfter(text: str, value: str): Url = {
	var url = Url::withCapacity(16)
	url.pushLiteral(text)
	url.pushValue(&value)
	return url
}

@test(panics = "a hole in the scheme")
fn aHoleInTheSchemeIsRefused() = holeAfter("htt", "p")

@test(panics = "a hole in the scheme")
fn aHoleAtTheStartIsRefused() = holeAfter("", "http")

@test(panics = "a hole inside a `%` and its two digits")
fn aHoleInAnEscapeIsRefused() = holeAfter("/a%2", "0")

@test(panics = "a `Url` joined after the start")
fn aUrlJoinedAfterTheStartIsRefused() = {
	val base: Url = "https://example.com"
	var url = Url::withCapacity(16)
	url.pushLiteral("/a")
	url.pushBuilt(&base)
}

@test
fn refusalSaysWhereAUrlIsWrong() = {
	assert(Url::refusal(["https://example.com/", "?q=", ""], [false, false]).isNone())
	assert(Url::refusal(["", "/users/", ""], [true, false]).isNone(), "a URL joined at the start")
	assert(Url::refusal(["", "://x"], [false]) is .Some(.Hole(index: 0, ..)))
	assert(Url::refusal(["/a/", "/b"], [true]) is .Some(.Hole(index: 0, ..)))
	assert(Url::refusal(["/a%", "0"], [false]) is .Some(.Hole(index: 0, ..)))
	assert(Url::refusal(["http://x:8a/"], []) is .Some(.Text(piece: 0, at: 10, ..)))
	assert(Url::refusal(["/a/", " b"], [false]) is .Some(.Text(piece: 1, at: 0, ..)))
	assert(Url::refusal(["http://x:", "/"], [false]).isNone(), "a port a value writes is a digit")
}
