// `own<T>`, a box: what the prelude writes for it where its `T` has it.
// It compares, orders, hashes and is written as what it holds, so a
// recursive type built of boxes derives `Eq`, `Ord`, `Hash` and `Text`,
// and a box is what generic code asks of a `T`: in a vector, an option, a
// set.

import std::collections::{Set}

@derive(Eq, Ord, Hash, Text, Clone)
enum Tree {
	Leaf(value: i64)
	Node(left: own<Tree>, right: own<Tree>)
}

fn pair(left: i64, right: i64): Tree = .Node(left: own .Leaf(left), right: own .Leaf(right))

@test
fn aTreeOfBoxesDerivesWhatItsNodesHave() = {
	val a = pair(1, 2)
	assert(a == pair(1, 2) && a != pair(1, 3), "boxes compare as what they hold")
	assert(a < pair(1, 3) && pair(2, 0) > a, "and order as it")
	var seen: Set<Tree> = Set()
	seen.add(a.clone())
	assert(seen.contains(pair(1, 2)) && !seen.contains(pair(2, 1)), "and hash as it")
	assert("\(a)" == ".Node(left: .Leaf(value: 1), right: .Leaf(value: 2))")
}

@test
fn aBoxIsWhatGenericCodeAsksOfAType() = {
	val boxes: Vec<own<i64>> = [own 1, own 2]
	val held: Option<own<i64>> = own 3
	assert("\(boxes) \(held)" == "[1, 2] .Some(3)", "written as what it holds")
	assert(boxes == Vec::of([own 1, own 2]) && boxes[0] < boxes[1])
	val five: own<i64> = own 5
	assert("[\(five, width: 4)]" == "[   5]", "a number in a box aligns as a number")
}
