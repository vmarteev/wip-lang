// The program's own environment: a variable set and taken away, read back
// by `io::env`, listed whole, and given to every program started after; and
// each change refused where it is not safe, with a second thread running,
// or not one C can hold.

import std::future::{Future}
import std::io
import std::process::{Command}
import std::time::{Duration, sleep}

@test
fn aVariableIsSetReadAndTakenAway() = {
	assert(io::env("WIP_ENV_PROBE").isNone())
	io::setEnv("WIP_ENV_PROBE", "one two")
	assert(io::env("WIP_ENV_PROBE") is .Some(set) && set == "one two")
	io::setEnv("WIP_ENV_PROBE", "")
	assert(io::env("WIP_ENV_PROBE") is .Some(empty) && empty.isEmpty(), "set, to nothing")
	io::unsetEnv("WIP_ENV_PROBE")
	assert(io::env("WIP_ENV_PROBE").isNone())
	io::unsetEnv("WIP_ENV_PROBE")
	assert(io::env("WIP_ENV_PROBE").isNone(), "taking away what is not there changes nothing")
}

@test
fn theEnvironmentIsListedWhole() = {
	io::setEnv("WIP_ENV_LISTED", "a=b")
	val all = io::environment()
	val found: Vec<String> = [
		for (name, value) in all do
			if name == "WIP_ENV_LISTED" then
				yield value.clone()
	]
	assert(found == ["a=b"].toVec(), "once, with an `=` in its value")
	for (name, value) in all do
		assert(io::env(name.toStr()) is .Some(read) && read == value, name.toStr())

	io::unsetEnv("WIP_ENV_LISTED")
	for (name, _) in io::environment() do
		assert(name != "WIP_ENV_LISTED")
}

@test
@target(os = "macos")
@target(os = "linux")
fn aProgramStartedIsGivenWhatIsSet() = {
	io::setEnv("WIP_ENV_GIVEN", "given")
	val said = Command::of("sh").arg("-c").arg("echo \"${WIP_ENV_GIVEN-unset}\"").output().unwrap()
	assert(said.stdout.trim() == "given")
	io::unsetEnv("WIP_ENV_GIVEN")
	val after = Command::of("sh").arg("-c").arg("echo \"${WIP_ENV_GIVEN-unset}\"").output().unwrap()
	assert(after.stdout.trim() == "unset")
}

@test(panics = "threads run, and another may be reading it")
fn theEnvironmentIsNotSetWhileAThreadRuns() = {
	val waiting = Future::run(own () => {
		sleep(Duration::seconds(5))
		return 0
	})
	io::setEnv("WIP_ENV_LATE", "late")
}

@test(panics = "threads run, and another may be reading it")
fn theEnvironmentIsNotChangedWhileAThreadRuns() = {
	val waiting = Future::run(own () => {
		sleep(Duration::seconds(5))
		return 0
	})
	io::unsetEnv("HOME")
}

@test(panics = "`A=B` is not a name the environment can hold")
fn aNameHoldsNoEquals() = io::setEnv("A=B", "c")

@test(panics = "`` is not a name the environment can hold")
fn aNameIsNotEmpty() = io::unsetEnv("")

@test(panics = "the value of `WIP_ENV_NUL` holds a NUL")
fn aValueHoldsNoNul() = io::setEnv("WIP_ENV_NUL", "a\0b")
