// The float methods written in Wip: their answers at the
// edges C's give, and the same bits in a `@comptime` constant as when the
// program runs.

@test
fn aFloatIsItsBits() = {
	assert((1.0).toBits() == 0x3FF0000000000000)
	assert((-0.0).toBits() == 0x8000000000000000)
	assert(f64::fromBits(0x7FF0000000000000) == 1.0 / 0.0)
	assert(f64::fromBits(0x7FF8000000000000).isNaN())
	assert((1.0 as f32).toBits() == 0x3F800000)
	assert(f32::fromBits(0xC0000000) == -2.0)
	val odd: u64 = 0x400921FB54442D18
	assert(f64::fromBits(odd).toBits() == odd, "every bit comes back")
}

@test
fn theExactOperationsAnswerAsCDoes() = {
	assert((2.0).sqrt() == 1.4142135623730951)
	assert((-1.0).sqrt().isNaN())
	assert((-2.5).floor() == -3.0 && (-2.5).ceil() == -2.0 && (-2.5).trunc() == -2.0)
	assert((2.5).round() == 3.0 && (-2.5).round() == -3.0, "halves away from zero")
	assert((0.49999999999999994).round() == 0.0, "the largest number below a half")
	assert((4503599627370497.0).round() == 4503599627370497.0, "already whole")
	assert((-0.0).abs().toBits() == 0)
	assert((-3.0).abs() == 3.0)
	val nan = 0.0 / 0.0
	assert(nan.min(1.0) == 1.0 && (1.0).max(nan) == 1.0, "a NaN gives the other")
	assert((0.0).min(-0.0).toBits() == (-0.0).toBits())
	assert((-0.0).max(0.0).toBits() == 0)
	assert((2.0 as f32).sqrt() == 1.41421356 as f32)
}

@test
fn aRemainderKeepsTheSignOfTheNumberDivided() = {
	assert(5.5 % 2.0 == 1.5)
	assert(-5.5 % 2.0 == -1.5)
	assert(5.5 % -2.0 == 1.5)
	assert((1.0e300 % 7.0) == 1.0, "exact however far apart")
	assert((0.1 % 0.01) == 3.4694469519536142e-18, "0.1 is a little above ten of 0.01")
	assert((1.0 % 0.0).isNaN())
	assert(((1.0 / 0.0) % 2.0).isNaN())
	assert(3.0 % (1.0 / 0.0) == 3.0)
	assert((5.5 as f32) % (2.0 as f32) == 1.5 as f32)
}

@test
fn aRemainderOfSubnormalsIsExact() = {
	assert(7.5e-323 % 2.0e-323 == 1.5e-323, "fifteen of the smallest, by four")
	assert(2.2250738585072014e-308 % 1.5e-323 == 5.0e-324, "the smallest normal, by a subnormal")
	assert(1.0 % 5.0e-324 == 0.0 && 1.7976931348623157e308 % 5.0e-324 == 0.0)
	assert(1.0e-310 % 3.0e-320 == 4.125e-321)
	assert(3.0 % 1.0e-310 == 5.2229528313e-312)
}

@test
fn aFusedMultiplyAddRoundsOnce() = {
	assert((0.1).mulAdd(10.0, -1.0) == 5.551115123125783e-17, "what 0.1 is above a tenth")
	assert(0.1 * 10.0 - 1.0 == 0.0, "the product rounded first loses it")
	val x = 1.0000000000000002
	assert(x.mulAdd(x, -1.0000000000000004) == 4.930380657631324e-32)
	assert((0.1 as f32).mulAdd(10.0, -1.0) == 1.4901161e-8)
	assert(
		(1.0e308).mulAdd(10.0, -INFINITY) == -INFINITY,
		"the product is not rounded to infinity first",
	)
	assert(INFINITY.mulAdd(0.0, 1.0).isNaN() && (0.0 / 0.0).mulAdd(1.0, 1.0).isNaN())
	assert((2.0).mulAdd(3.0, 4.0) == 10.0)
}

@test
fn aFusedMultiplyAddIsCs() = {
	val xs = samples()
	for i in 0..xs.len() {
		val x = xs[i]
		val by = xs[(i * 7 + 3) % xs.len()]
		val plus = xs[(i * 13 + 5) % xs.len()]
		assert(ulps(x.mulAdd(by, plus), cFma(x, by, plus)) == 0, "\(x) * \(by) + \(plus)")
	}
}

@comptime
val EXACT: [f64; 6] = [
	(2.0).sqrt(),
	(-2.5).round(),
	(7.25).floor(),
	1.0e300 % 3.0,
	(-0.0).abs(),
	(0.3).min(0.2),
]

@test
fn theCompilerComputesTheSameBits() = {
	val now = [
		(2.0).sqrt(),
		(-2.5).round(),
		(7.25).floor(),
		1.0e300 % 3.0,
		(-0.0).abs(),
		(0.3).min(0.2),
	]
	for i in 0..6 {
		assert(EXACT[i].toBits() == now[i].toBits())
	}
}

@target(os = "linux")
@link("m")
extern "C" {}

// The platform's own, to measure the ported functions against.
extern "C" {
	@symbol("sin")
	fn cSin(x: f64): f64
	@symbol("cos")
	fn cCos(x: f64): f64
	@symbol("tan")
	fn cTan(x: f64): f64
	@symbol("asin")
	fn cAsin(x: f64): f64
	@symbol("acos")
	fn cAcos(x: f64): f64
	@symbol("atan")
	fn cAtan(x: f64): f64
	@symbol("atan2")
	fn cAtan2(y: f64, x: f64): f64
	@symbol("exp")
	fn cExp(x: f64): f64
	@symbol("log")
	fn cLog(x: f64): f64
	@symbol("log2")
	fn cLog2(x: f64): f64
	@symbol("log10")
	fn cLog10(x: f64): f64
	@symbol("pow")
	fn cPow(x: f64, y: f64): f64
	@symbol("fma")
	fn cFma(x: f64, y: f64, z: f64): f64
}

val INFINITY: f64 = 1.0 / 0.0
val HALF_PI: f64 = 1.5707963267948966

/// How many representable numbers lie between two answers: 0 when they
/// are the same, and when both are NaN.
fn ulps(a: f64, b: f64): u64 = {
	if a.isNaN() && b.isNaN() then return 0
	if a.isNaN() || b.isNaN() then return 0xFFFFFFFFFFFFFFFF
	val (low, high) =
		if ordered(a) < ordered(b) then (ordered(a), ordered(b)) else (ordered(b), ordered(a))
	return high - low
}

/// The bits in the order of the numbers, negative ones below.
fn ordered(x: f64): u64 = {
	val bits = x.toBits()
	return if bits >> 63 == 1 then !bits else bits | 0x8000000000000000
}

/// Numbers spread over where each function is interesting: whole turns
/// and their halves, the unit interval, the range `exp` answers in, and
/// the large angles that need the most bits of 2/π.
fn samples(): Vec<f64> = {
	var all: Vec<f64> = Vec()
	var state: u64 = 12345
	for i in 0..20000 {
		state = state *% 6364136223846793005 +% 1442695040888963407
		val unit = (state >> 11) as f64 * (1.0 / 9007199254740992.0)
		val x = match i % 6 {
			0 => unit * 20.0 - 10.0
			1 => unit * 2.0 - 1.0
			2 => unit * 1400.0 - 700.0
			3 => (unit * 1400.0 - 700.0) * 1.0e-3
			4 => f64::fromBits(state >> 1)
			_ => (unit - 0.5) * 1.0e22
		}
		all.push(x)
	}
	return move all
}

// Each is within an ulp of the true value, and so, mostly, is the
// platform's; two ulps apart is the most two such can be. Apple's `tan`
// is further out at some large angles — 1.6 ulps at 2.0635894270720462e27,
// where the port is 0.4 ulp from the true value. `exp`, `ln`, `log2` and
// `pow` are within 0.55 ulp, as the platforms' are, and
// so within one of theirs.
@test
fn theFunctionsAgreeWithThePlatforms() = {
	val xs = samples()
	for i in 0..xs.len() {
		val x = xs[i]
		val y = xs[(i * 7 + 3) % xs.len()]
		assert(ulps(x.sin(), cSin(x)) <= 2, "sin(\(x))")
		assert(ulps(x.cos(), cCos(x)) <= 2, "cos(\(x))")
		assert(ulps(x.tan(), cTan(x)) <= 2, "tan(\(x))")
		assert(ulps(x.asin(), cAsin(x)) <= 2, "asin(\(x))")
		assert(ulps(x.acos(), cAcos(x)) <= 2, "acos(\(x))")
		assert(ulps(x.atan(), cAtan(x)) <= 2, "atan(\(x))")
		assert(ulps(x.atan2(y), cAtan2(y: x, x: y)) <= 2, "atan2(\(x), \(y))")
		assert(ulps(x.exp(), cExp(x)) <= 1, "exp(\(x))")
		assert(ulps(x.ln(), cLog(x)) <= 1, "ln(\(x))")
		assert(ulps(x.log2(), cLog2(x)) <= 1, "log2(\(x))")
		assert(ulps(x.log10(), cLog10(x)) <= 2, "log10(\(x))")
		assert(
			ulps(x.abs().pow(y * 0.01), cPow(x.abs(), y * 0.01)) <= 1,
			"pow(\(x.abs()), \(y * 0.01))",
		)
	}
}

@test
fn theTrigonometricFunctionsAnswerAsCDoesAtTheEdges() = {
	assert((0.0).sin() == 0.0 && (-0.0).sin().toBits() == (-0.0).toBits())
	assert((0.0).cos() == 1.0 && (0.0).tan() == 0.0)
	assert(INFINITY.sin().isNaN() && (-INFINITY).cos().isNaN() && INFINITY.tan().isNaN())
	assert((1.0e22).sin() == -0.8522008497671888, "a large angle, with 2/π's bits")
	assert((1.0e300).cos() == cCos(1.0e300))
	assert((1.0).asin() == HALF_PI && (-1.0).asin() == -HALF_PI)
	assert((1.0).acos() == 0.0 && (-1.0).acos() == 3.141592653589793)
	assert((1.5).asin().isNaN() && (-1.5).acos().isNaN())
	assert(INFINITY.atan() == HALF_PI && (-INFINITY).atan() == -HALF_PI)
	assert((0.0).atan2(-1.0) == 3.141592653589793 && (-0.0).atan2(-1.0) == -3.141592653589793)
	assert((1.0).atan2(0.0) == HALF_PI && INFINITY.atan2(INFINITY) == 0.7853981633974483)
	assert((0.0 / 0.0).atan2(1.0).isNaN())
}

@test
fn theExponentialAndLogarithmsAnswerAsCDoesAtTheEdges() = {
	assert((0.0).exp() == 1.0 && (710.0).exp() == INFINITY && (-746.0).exp() == 0.0)
	assert((-INFINITY).exp() == 0.0 && (-740.0).exp() > 0.0, "a subnormal answer")
	assert((1.0).ln() == 0.0 && (0.0).ln() == -INFINITY && (-1.0).ln().isNaN())
	assert(INFINITY.ln() == INFINITY && (5.0e-324).ln() == -744.4400719213812)
	assert((8.0).log2() == 3.0 && (1000.0).log10() == 3.0 && (0.5).log2() == -1.0)
	assert((0.0 / 0.0).pow(0.0) == 1.0 && (1.0).pow(0.0 / 0.0) == 1.0, "C's two rules")
	assert((-8.0).pow(1.0 / 3.0).isNaN() && (-2.0).pow(3.0) == -8.0 && (-2.0).pow(2.0) == 4.0)
	assert((0.0).pow(-1.0) == INFINITY && (-0.0).pow(-1.0) == -INFINITY)
	assert((2.0).pow(1024.0) == INFINITY && (2.0).pow(-1074.0) == 5.0e-324)
	assert((2.0).pow(0.5) == (2.0).sqrt() && (10.0).pow(-2.0) == 0.01)
	assert((0.5).pow(INFINITY) == 0.0 && (-1.0).pow(INFINITY) == 1.0)
}

// Arm's C gives these bits; the port must too, as it did for millions of inputs
// when it was written.
@test
fn theExponentialAndLogarithmsAreArmsBits() = {
	assert((1.0).exp().toBits() == 0x4005BF0A8B145769)
	assert((-740.0).exp().toBits() == 0x0000000000000055)
	assert((709.0).exp().toBits() == 0x7FDD422D2BE5DC9B)
	assert((0.1).exp().toBits() == 0x3FF1AEC7B35A00D4)
	assert((2.0).ln().toBits() == 0x3FE62E42FEFA39EF)
	assert((1.0e-310).ln().toBits() == 0xC0864E69394D9508)
	assert((0.99).ln().toBits() == 0xBF8495453E6FD4BC)
	assert((3.0).log2().toBits() == 0x3FF95C01A39FBD68)
	assert((1.01).log2().toBits() == 0x3F8D664ECEE35B7F)
	assert((2.0).pow(0.5).toBits() == 0x3FF6A09E667F3BCD)
	assert((-1.5).pow(3.0).toBits() == 0xC00B000000000000)
	assert((1.0000001).pow(1.0e10).toBits() == 0x7FF0000000000000)
	assert((10.0).pow(-2.5).toBits() == 0x3F69E7C6E43390B7)
	assert((2.0).pow(-1070.5).toBits() == 0x000000000000000B)
}

@test
fn anF32IsAnF64sAnswerRoundedOnce() = {
	val x: f32 = 0.7
	assert(x.sin() == (x as f64).sin() as f32)
	assert(x.atan2(2.0) == (x as f64).atan2(2.0) as f32)
	assert((2.0 as f32).pow(10.0) == 1024.0)
	assert((1.0 as f32).exp() == 2.7182817)
}

@comptime
val SINES: [f64; 5] = [(1.0).sin(), (1.0e22).sin(), (0.5).acos(), (1.0).exp(), (3.0).pow(0.7)]

@comptime
val FUSED: [f64; 3] = [
	(0.1).mulAdd(10.0, -1.0),
	(1.0e308).mulAdd(10.0, -1.0e308),
	7.5e-323 % 2.0e-323,
]

@comptime
val LOGARITHMS: [f64; 4] = [(10.0).ln(), (3.0).log2(), (7.0).log10(), (-2.0).atan2(-3.0)]

@test
fn theCompilerComputesTheSameTranscendentalBits() = {
	val sines = [(1.0).sin(), (1.0e22).sin(), (0.5).acos(), (1.0).exp(), (3.0).pow(0.7)]
	for i in 0..5 {
		assert(SINES[i].toBits() == sines[i].toBits())
	}
	val fused = [(0.1).mulAdd(10.0, -1.0), (1.0e308).mulAdd(10.0, -1.0e308), 7.5e-323 % 2.0e-323]
	for i in 0..3 {
		assert(FUSED[i].toBits() == fused[i].toBits())
	}
	val logarithms = [(10.0).ln(), (3.0).log2(), (7.0).log10(), (-2.0).atan2(-3.0)]
	for i in 0..4 {
		assert(LOGARITHMS[i].toBits() == logarithms[i].toBits())
	}
}

// A subnormal is written as short as any float: as few digits as read
// back as it, fewer than the six a normal float is written with at least.
@test
fn aSubnormalIsWrittenAsShortAsItReadsBack() = {
	assert("\(f64::fromBits(1))" == "5e-324" && "\(f64::fromBits(2))" == "1e-323")
	assert("\(f64::fromBits(3))" == "1.5e-323" && "\(f64::fromBits(1000))" == "4.94e-321")
	assert("\(f32::fromBits(1))" == "1e-45")
	assert("5e-324".toFloat() == .Ok(f64::fromBits(1)), "and it reads back")
	assert(
		"\(2.2250738585072014e-308)" == "2.2250738585072014e-308",
		"the smallest normal, as it was",
	)
	assert("\(1e21)" == "1e+21" && "\(100.0)" == "100" && "\(0.1)" == "0.1")
}
