// A list built as it runs borrows what its elements borrow, as any list of
// views does, and so does what it is moved into: used after that changed, it is
// refused.

import std::io

fn keep(all: Vec<str>): Vec<str> = move all

fn built() = {
    var owned = String::of("word")
    val views: own<[str]> = own [owned.toStr(), if true { yield "x" }]
    owned.clear()
    io::println(views[0])
}

fn moved() = {
    var owned = String::of("word")
    var all: Vec<str> = Vec()
    all.push(owned.toStr())
    val kept = keep(move all)
    owned.clear()
    io::println(kept[0])
}

fn main() = {}
