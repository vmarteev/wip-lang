// An `extend` block is for a type of this module, and names its type
// parameters, one for each. A constraint on one of them
// says when the block applies; a conformance's must be an interface.

import lib

struct Pair<A, B> {
    first: A
    second: B
}

extend Pair {             // the parameters are not named
    fn one(): i64 = 1
}

extend Pair<X> {          // one name for two parameters
    fn two(): i64 = 2
}

interface Numbered {
    fn number(): i64
}

extend Pair<X: copy, Y>: Numbered { // `copy` is not a conformance's condition
    fn number(): i64 = 3
}

extend lib::Thing {       // another module's type
    fn four(): i64 = 4
}

extend Missing {          // no such type
    fn five(): i64 = 5
}

fn main() = {}
