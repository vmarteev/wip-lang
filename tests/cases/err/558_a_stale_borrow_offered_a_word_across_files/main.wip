// A word offered for a function in another file says which, and its fix
// edits that file.

import words::{Words}

fn main() = {
	var line = String::of("a b")
	var words = Words()
	for text in ["a b", "c"] {
		words.clear()
		line.clear()
		line.push(text)
		for word in line.toStr().split(" ") {
			words.add(word)
		}
	}
}
