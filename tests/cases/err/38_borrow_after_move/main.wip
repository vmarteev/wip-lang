// Moves (E0404, E0408): borrowing a value given away, and assigning to a
// field of one. Assigning the whole variable makes it usable again.

struct Point {
    x: i64
}

fn show(p: &own<Point>): i64 = {
    return p.x
}

fn discard(p: own<Point>) = {}

fn main(): i64 = {
    var p = own Point(x: 1)
    discard(p)
    val a = show(&p)
    var q = own Point(x: 2)
    discard(q)
    q.x = 5
    q = own Point(x: 3)
    return show(&q)
}
