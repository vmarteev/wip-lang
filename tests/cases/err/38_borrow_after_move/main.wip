// Moves (E0401, E0408): borrowing a moved value, and assigning to a field of a
// moved value. Assigning the whole variable makes it usable again.

struct Point {
    x: i64
}

fn show(p: &own<Point>): i64 = {
    return p.x
}

fn discard(p: own<Point>) = {}

fn main(): i64 = {
    var p = own Point(x: 1)
    discard(move p)
    val a = show(&p)
    var q = own Point(x: 2)
    discard(move q)
    q.x = 5
    q = own Point(x: 3)
    return show(&q)
}
