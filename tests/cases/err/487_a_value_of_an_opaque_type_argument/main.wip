// An opaque C type may be a type argument, and a value of it may not be
// made anywhere: not in an instance that holds one, reads one through a
// pointer or asks its size, nor in a program's own code, an `Option` of one
// or a vector of them. An instance's message names where it was made.

import std::c

extern "C" {
    type Handle
}

fn holds<T>(p: ptr<T>): Option<T> = .None

fn sized<T>(): size_t = c::sizeOf<T>()

fn first<T: copy>(p: ptr<T>): T = p[0]

fn main() = {
    val h: ptr<Handle> = null
    val held = holds(h)
    val read = first(h)
    val handles: Vec<Handle> = Vec()
    val size = c::sizeOf<Handle>()
}
