// A binding written through is the place it matched, so the place does not
// change while the binding is in scope (E0414), even after the binding's
// last use; and a `for` loop holds what it walks while it walks.

struct Counter {
    count: i64
}

fn written(slot: &var Option<Counter>) = {
    if slot is .Some(counter) {
        counter.count = counter.count + 1
        slot = .None
    }
}

fn walked(names: &var Vec<String>) = {
    for name in names {
        if name.isEmpty() then names.clear()
    }
}

fn main() = {}
