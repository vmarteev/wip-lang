// A handle says what it names: a `Handle<Edge>` is not
// taken where a `Handle<Node>` is.

import std::collections::{Arena, Handle}

struct Node {
	value: i64
}

struct Edge {
	weight: i64
}

fn valueOf(nodes: &Arena<Node>, node: Handle<Node>): i64 = nodes[node].value

fn main() = {
	var nodes: Arena<Node> = Arena()
	var edges: Arena<Edge> = Arena()
	nodes.add(Node(value: 1))
	val edge = edges.add(Edge(weight: 2))
	valueOf(&nodes, edge)
}
