// Three programs written the natural way, with references kept in
// structs, and why Wip rejects each. The versions that work are ok/42-44.
// A `&` may be only a view's field, so the node and the
// iterator are refused as structs that are not views (E0427).
// - A tree node that points at its parent.
// - An iterator that holds the collection it walks.
// - A function that hands out a reference to an item inside its argument.
//   This one is expressible, as a projection (ok/54);
//   what fails here is writing it with `&` instead of `lend`.

struct TreeNode {
    value: i64
    parent: &TreeNode
}

struct Item {
    weight: i64
}

struct Bag {
    items: [own<Item>; 3]
}

struct Iter {
    bag: &Bag
    at: i64
}

fn heaviest(bag: &Bag): &Item = &bag.items[0]
