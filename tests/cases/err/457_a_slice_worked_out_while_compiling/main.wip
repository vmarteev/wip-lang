// A `@comptime` constant whose value is a slice is refused (E0442): what it
// works out by running code points into memory that is gone once the
// program is compiled, even where it reads a list kept with another
// constant.

view struct Spec {
    name: str
    keys: &[str]
}

val SPECS: [Spec; 1] = [Spec(name: "quit", keys: ["q", "Q"])]

@comptime
val KEYS: &[str] = SPECS[0].keys

fn main() = {}
