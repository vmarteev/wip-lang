// Block values (E0301, E0305, E0320, E0319): `if` branches of different types,
// an `if` without `else` used as a value, a block that ends in a statement
// where a value is expected, a value in a function with no return type (the
// fix adds one), and conversions that `as` does not do.

fn pick(flag: bool): i64 = {
    val x = if flag { 1 } else { true }
    x
}

fn maybe(flag: bool): i64 = {
    val y: i64 = if flag { 1 }
    y
}

fn nothingLeft(): i64 = {
    val z = 5
}

fn forgotType(x: i64) = x * 2

fn badCasts(b: bool): i64 = {
    val n = b as i64
    val s = "5" as i64
    val t = 1 as bool
    0
}
