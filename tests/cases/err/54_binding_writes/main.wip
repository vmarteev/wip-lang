// The bindings of a matched place that cannot be written, such as a `&`
// parameter or a `val`, only read: they cannot be passed on
// as `&var` (E0412) or assigned (E0304). The help says which places give
// writable bindings; ok/53 uses them.

enum Tree {
    Node(value: i64, left: own<Tree>, right: own<Tree>)
    Leaf
}

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

fn grow(tree: &var Tree) = {}

fn descend(tree: &Tree) = match tree {
    .Node(left, ..) => grow(&var left)
    .Leaf => {}
}

fn bump(list: &List) = match list {
    .Cons(head, ..) => head = head + 1
    .Nil => {}
}

fn sealed() = {
    val list = List::Cons(head: 1, tail: own List::Nil)
    match list {
        .Cons(head, ..) => head = 2
        .Nil => {}
    }
}
