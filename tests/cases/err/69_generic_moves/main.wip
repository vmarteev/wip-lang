// The move checker checks a generic body once, with a type parameter taken
// to own memory unless it is `copy`: using one as a value gives it away, so
// it is used once (E0404), and it cannot be moved out from behind a
// reference (E0405) or out of an array (E0406).

fn duplicate<T>(x: T): (T, T) = (x, x)

fn first<T>(xs: &[T]): T = {
    for x in xs {
        return x
    }
    xs[0]
}

// With `copy`, all of this is allowed.
fn firstCopy<T: copy>(xs: &[T]): T = {
    for x in xs {
        return x
    }
    xs[0]
}

fn main(): i64 = 0
