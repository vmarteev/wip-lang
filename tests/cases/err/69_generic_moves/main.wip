// The move checker checks a generic body once, with a type parameter taken
// to own memory unless it is `copy`: reading one needs
// `move` (E0404), and it cannot be copied out from behind a reference
// (E0405) or out of an array (E0406).

fn duplicate<T>(x: T): T = x

fn first<T>(xs: &[T]): T = {
    for x in xs {
        return x
    }
    xs[0]
}

// With `copy`, all of this is allowed.
fn firstCopy<T: copy>(xs: &[T]): T = {
    for x in xs {
        return x
    }
    xs[0]
}

fn main(): i64 = 0
