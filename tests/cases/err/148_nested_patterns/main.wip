// A pattern inside a pattern tests what a field holds, so
// what holds one can fail: a `val` without `else` and a `for` binding must
// match every value, a `match` must cover them all, and a pattern that
// names no field must be the one field of its variant.

import std::io

struct Cell {
    value: Option<i64>
}

enum Pair {
    Both(left: i64, right: i64)
    Neither
}

fn main() = {
    // The struct always matches; what its field is tested for does not.
    val Cell(value: .Some(n)) = Cell(value: Option<i64>::Some(2))
    io::printInt(n)

    var cells = Vec<Cell>()
    cells.push(Cell(value: .Some(1)))
    for Cell(value: .Some(v)) in cells {
        io::printInt(v)
    }

    // Two fields: which one the pattern tests must be said.
    val pair = Pair::Both(left: 1, right: 2)
    match pair {
        .Both(0) => io::printInt(0)
        _ => io::printInt(1)
    }

    // The arms leave a value out, which the message names.
    val nested = Option<Option<i64>>::Some(.None)
    match nested {
        .Some(.Some(k)) => io::printInt(k)
        .None => io::printInt(0)
    }
}
