// `pub` inside a conformance block says nothing: a
// method of an interface is as visible as the interface, so a block that
// implements one cannot make its methods more or less visible. A block
// with no interface is untouched, since there `pub` is what exports a
// method from its module.

interface Named {
    fn name(): i64
}

struct Ticket {
    number: i64
}

extend Ticket: Named {
    pub fn name(): i64 = self.number
}

extend Ticket {
    pub fn ticket(): i64 = self.number
}

fn main() = {}
