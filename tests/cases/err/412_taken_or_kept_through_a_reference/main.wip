// What a pattern binds below a reference it tests through is the referent's,
// not the matched value's: `match move` takes nothing from there (E0405),
// and the binding borrows what the reference does, so it is not used after
// that changes (E0436).

enum Token {
	Word(text: String)
	Space
}

fn taken(token: Option<&Token>): String = match move token {
	.Some(.Word(text)) => move text
	_ => String()
}

fn kept(tokens: &var Vec<Token>): i64 = {
	val first = tokens.first()
	if first is .Some(.Word(text)) {
		tokens.push(.Space)
		return text.len()
	}
	return 0
}

fn main() = {
	assert(taken(.None).isEmpty())
	var tokens: Vec<Token> = Vec()
	assert(kept(&var tokens) == 0)
}
