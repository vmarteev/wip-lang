// What a walk one place at a time is walking stays as it is until the walk
// ends, as for a walk of a slice: a map whose values are being walked cannot
// gain a key in the body.

import std::collections::{Map}

fn main() = {
    var growing = Map<str, i64>()
    growing.put("a", 1)
    for value in growing.values() {
        growing.put("b", value)
    }
}
