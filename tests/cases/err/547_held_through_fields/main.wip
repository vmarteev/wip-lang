// A generic type given a view is a view where its fields hold the
// parameter, through the types they name: an `Option` of it, another
// generic type that holds it, and a pointer to it each do, and a struct
// that is not a view cannot hold one given a `str` (E0427). A handle beside
// them does not make them plain data.

import std::collections::{Handle}

struct Maybe<T> {
	value: Option<T>
}

struct Indexed<T> {
	at: Handle<T>
	cached: Maybe<T>
}

struct Pointed<T> {
	first: ptr<T>
}

struct Holder {
	maybe: Maybe<str>
	indexed: Indexed<str>
	pointed: Pointed<str>
}

fn main() = {}
