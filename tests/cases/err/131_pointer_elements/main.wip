// What `p[i]` and `p.field` will not do. Both find
// what they read by the size of what the pointer points at, and neither
// `void` nor a C type whose contents Wip does not know has one. A pointer
// to something that is not a struct has no fields, and a `ptr<T>` is not
// borrowed as a slice: C never said how many there are.

extern "C" {
    type Handle
    fn malloc(bytes: size_t): ptr<void>
    fn handleOf(): ptr<Handle>
}

fn count(xs: &[c_int]): i64 = xs.len()

fn main() = {
    val nothing = malloc(8 as size_t)
    val first = nothing[0]

    val handle = handleOf()
    val inside = handle[1]
    val field = handle.state

    val numbers = malloc(8 as size_t) as ptr<c_int>
    val many = count(&numbers[0..2])
    val length = numbers.len()
}
