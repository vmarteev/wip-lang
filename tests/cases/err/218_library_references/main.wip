// What the library answers by reference borrows what it was found in:
// a map's value, a slice's element, what a `Peekable`
// looked at. Each is refused after that changes.

import std::io
import std::collections::{Map}

fn mapCleared() = {
    var ages = Map<String, i64>()
    ages.put(String::of("ann"), 31)
    val key = String::of("ann")
    val found = ages.get(&key)
    ages.clear()
    io::println("\(found)")
}

fn vectorCleared() = {
    var words: Vec<String> = Vec()
    words.push(String::of("one"))
    val first = words.first()
    words.clear()
    io::println("\(first)")
}

fn peekedPast() = {
    var it = "ab".chars().peekable()
    val next = it.peek()
    it.next()
    io::println("\(next)")
}

fn main() = {}
