// An `Option` of a reference crosses to C as a parameter, as the
// reference does, and nowhere else (E0314): not as what a C function
// answers, which C does not lend, nor as what a callback takes, which C
// would pass in a register where a Wip function C calls takes its
// address. An `Option` of a slice is not one pointer, as the slice is not.

extern struct Size {
    width: i32
}

extern "C" {
    fn found(): Option<&Size>
    fn each(visit: (size: Option<&Size>) => void)
    fn all(sizes: Option<&[Size]>)
    fn fine(size: Option<&Size>)
}

fn main() = {}
