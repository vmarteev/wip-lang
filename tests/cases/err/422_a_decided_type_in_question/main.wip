// What `I::Item` names must be one type: refused where two interfaces the
// parameter is constrained by each decide an `Item`, where none does, and
// where a concrete type implements no interface that decides one.

interface Bag<type Item> {
	fn size(): i64
}

fn both<I: Iterator + Bag>(it: I): Option<I::Item> = .None

fn neither<T: copy>(value: T): T::Item = value

fn concrete(): i64::Item = 0

fn main() = {}
