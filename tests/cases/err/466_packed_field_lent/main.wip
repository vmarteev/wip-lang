// A field of a packed struct may lie at an address no reference can point
// at: lent to be written, by `&var` or as a `var fn`'s receiver, it is
// refused. A `&` of it is fine, and lends a copy.

@packed
struct Header {
	kind: u8
	length: u32
}

fn grow(n: &var u32) = n += 1

fn read(n: &u32): u32 = n

fn main() = {
	var header = Header(kind: 1, length: 2)
	grow(&var header.length)
	val seen = read(&header.length)
	var counts: [u32; 2] = [0, 0]
	counts[0] = seen
}
