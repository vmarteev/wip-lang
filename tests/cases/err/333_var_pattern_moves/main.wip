// What a `var` pattern took is gone from where it was, and a view it holds
// still borrows.

fn pair(): (i64, String) = (1, String::of("a"))

fn moved(): i64 = {
    val q = pair()
    var (k, _) = move q
    k += q.1.len()
    return k
}

fn borrowed(): i64 = {
    var owner = String::of("abc")
    var (n, text) = (1, owner.toStr())
    owner.push("d")
    n += text.len()
    return n
}

fn main() = {
    moved()
    borrowed()
}
