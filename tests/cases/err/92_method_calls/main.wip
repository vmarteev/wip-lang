// Calling a method: the receiver is borrowed or moved as the
// method declares, a `static fn` is called through the type, and a method is
// not a value.

import std::io

struct Counter {
    count: i64

    static fn new(): Counter = Counter(count: 0)
    fn get(): i64 = self.count
    var fn add(by: i64) = self.count = self.count + by
}

struct Bag {
    item: own<i64>

    static fn new(): Bag = Bag(item: own 1)
    move fn take(): own<i64> = move self.item
}

struct Boxed {
    inner: own<Bag>
}

fn readOnly(c: &Counter) = c.add(1)

fn main() = {
    val fixed = Counter::new()
    fixed.add(1)                    // a `var fn` on a `val`
    io::printInt(fixed.get)        // a method is not a value
    io::printInt(fixed.new())      // a `static fn` through a value
    io::printInt(Counter::get(3))  // a method through the type
    io::printInt(fixed.total())    // no such method
    io::printInt(fixed.get(1))     // the receiver is not an argument

    val boxed = Boxed(inner: own Bag::new())
    val taken = boxed.inner.take()  // a `move fn` through `own`
    io::printInt(taken + 0)
}

