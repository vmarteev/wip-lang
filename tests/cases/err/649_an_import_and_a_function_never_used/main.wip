// An imported name nothing in its file names is a warning (E0474), whose
// fix removes it, and the import with it where it was the import's last; a
// function of the module's own that nothing calls is a warning too (E0475),
// with no fix, since removing one is a decision. What another target's code
// names is used, and so is what a test file names, which `wip check` does
// not read. Nothing is said of `main`, of a `pub` function, or of an
// interface's methods.

import std::collections::{Map, Set}
import std::io
import std::path

interface Named {
    fn name(): str
}

struct Thing {
    n: i64
}

extend Thing: Named {
    fn name(): str = "thing"
}

fn forgotten(): i64 = 1

fn forIos(): i64 = 2

fn forTests(): i64 = 3

pub fn offered(): i64 = 4

@target(os = "ios")
fn onIos(): i64 = {
    var seen: Set<i64> = Set()
    seen.add(forIos())
    return seen.len()
}

fn main() = {
    io::println("\(Thing(n: 1).name())")
}
