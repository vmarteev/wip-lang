// The whole text of a `String` the function owns, copied where nothing
// reads the variable after on some path, is a warning (E0448): it could
// have been given itself, and moved. Copied as text where a `String` is
// expected, written `String::of(line.toStr())`, in one branch of two, and
// before the variable is given a new value. Nothing is said where the
// variable is read again after the copy, in a loop that copies it again,
// or where it is borrowed by what is kept.

import std::io

fn record(names: &var Vec<String>, line: String) = {
	names.push(line.toStr())
}

fn written(names: &var Vec<String>, line: String) = {
	names.push(String::of(line.toStr()))
}

fn branch(names: &var Vec<String>, line: String, shown: bool) = {
	if shown {
		names.push(line.toStr())
	} else {
		io::println(line)
	}
}

fn replaced(names: &var Vec<String>) = {
	var local: String = "first"
	names.push(local.toStr())
	local = "second"
	io::println(local)
}

fn readAgain(names: &var Vec<String>, line: String) = {
	names.push(line.toStr())
	names.push(move line)
}

fn looped(names: &var Vec<String>, line: String) = {
	for i in 0..3 {
		names.push(line.toStr())
	}
}

fn kept(names: &var Vec<String>, line: String) = {
	val text = line.toStr()
	names.push(line.toStr())
	io::println(text)
}

fn main() = {
	var names: Vec<String> = Vec()
	record(&var names, "a")
	written(&var names, "b")
	branch(&var names, "c", true)
	replaced(&var names)
	readAgain(&var names, "d")
	looped(&var names, "e")
	kept(&var names, "f")
}
