// What a struct built by a call is refused for: a value
// by position among two or more fields, more values than one field, a
// field that is not there or is set twice, a field left out that has no
// default, `..` where no struct is built, an enum's name, and a function
// with a struct's name.

struct Point {
    x: i64
    y: i64
}

struct Wrap {
    value: i64
}

enum Shape {
    Dot
}

struct Row {
    size: i64
}

fn Row(size: i64): i64 = size

fn f(a: i64): i64 = a

fn main() = {
    val a = Point(1, 2)
    val one = Wrap(1, 2)
    val b = Point(x: 1, z: 2)
    val c = Point(x: 1)
    val d = f(1, ..a)
    val e = Shape(1)
    val g = Point(x: 1, x: 2)
}
