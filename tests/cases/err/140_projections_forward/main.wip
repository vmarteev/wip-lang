// What forwarding a projection will not do. The borrow a
// projection passes on is still one of its own parameters': a place inside
// a local is gone when the call returns, two parameters cannot both be
// lent, and a projection that only forwards to itself lends nothing the
// compiler can name.

struct Card { rank: i64 }

struct Deck {
    cards: Vec<Card>

    pub fn at(index: i64): &Card = lend self.cards.at(index)
}

fn ofALocal(): &Card = {
    var deck = Deck(cards: Vec<Card>())
    lend deck.at(0)
}

fn ofEither(first: &Deck, second: &Deck, which: bool): &Card = if which {
    lend first.at(0)
} else {
    lend second.at(0)
}

fn roundAndRound(deck: &Deck): &Card = lend roundAndRound(&deck)

fn main() = {}
