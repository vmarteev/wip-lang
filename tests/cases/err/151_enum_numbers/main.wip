// Only an enum whose variants carry nothing is a number:
// one that carries values is which variant it holds *and* what that
// variant holds, and no integer says both. The number is an integer, so a
// float is not what a variant is either.

enum Event {
    Key(code: i64)
    Quit
}

enum Colour { Red, Green, Blue }

fn main() = {
    val n = Event::Quit as i64
    val f = Colour::Red as f64
    val c = 1 as Colour
}
