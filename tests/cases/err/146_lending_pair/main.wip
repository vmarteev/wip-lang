// What a lending pair will not do. A type that lends only
// for reading says so where a write is attempted; a pair is two methods
// that differ in mutability alone, so two that differ in anything else are
// the duplicate they always were; and the writing half cannot be reached
// through a value that is only read.

struct Card {
    rank: i64
}

struct Deck {
    cards: Vec<Card>

    pub fn at(index: i64): &Card = lend self.cards.at(index)
}

struct Twice {
    cards: Vec<Card>

    pub fn at(index: i64): &Card = lend self.cards.at(index)
    pub fn at(index: i64): &Card = lend self.cards.at(index)
}

struct Wrong {
    cards: Vec<Card>

    pub fn get(index: i64): &Card = lend self.cards.at(index)
    pub var fn get(): &var Card = lend self.cards.at(0)
}

fn readOnly(deck: &Deck) = {
    deck.at(0).rank = 9
}

fn noTwin() = {
    var deck = Deck(cards: Vec<Card>())
    deck.at(0).rank = 9
}

fn main() = {}
