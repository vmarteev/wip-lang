// What `@test` may say a test expects: that it panics, `@test(panics)`,
// or that it panics with a message holding a text, `@test(panics = "out
// of bounds")`. Anything else is refused: a text that is not a string, an
// argument that is not `panics`, more than one, and none between the
// parentheses.

@test(panics = 3)                   // the text is a string
fn notAString() = {}

@test(fails)                        // what it may expect is a panic
fn notPanics() = {}

@test(panics, panics = "no")        // one expectation
fn twice() = {}

@test()                             // or none, without the parentheses
fn empty() = {}

fn main() = {}
