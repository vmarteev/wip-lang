// What a `when` refuses where it is checked: a value with no `else`, as
// an `if` without one is (E0354), a condition that is no `bool` (E0301),
// and a name an arm's `is` bound, used in another arm (E0203).

fn main() = {
    val n = 3
    val described = when {
        n > 5 => "many"
        n > 1 => "some"
    }
    when {
        n => {}
        else => {}
    }
    val maybe: Option<i64> = .Some(n)
    when {
        maybe is .Some(value) => {}
        n > 0 => assert(value > 0)
    }
}
