// What `@derive` writes asks its conditions of the type's parameters, and
// a type an implementation decides is not one of them: a field of a GPU's
// texture, or of a list of them, cannot ask the texture to clone, and is
// refused where it is written.

interface Gpu<type Texture> {
	fn frames(): i64
}

@derive(Clone)
struct Raw<G: Gpu> {
	texture: G::Texture
}

@derive(Clone)
struct Many<G: Gpu> {
	textures: Vec<G::Texture>
}

fn main() = {}
