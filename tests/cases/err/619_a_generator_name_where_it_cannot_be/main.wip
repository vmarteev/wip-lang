// A generator's name stands only where a function of a module answers a
// generator, and the generator is made only by calling it (E0466): a name
// after a result that is no `Iterator` names nothing, nor one on a method,
// whose would be its type's; and the generator is not built as a struct
// is, nor extended. A struct that keeps one that borrows is a view struct
// (E0427).

fn pieces(text: str, separator: str): Iterator<str> as Pieces = {
	yield text
}

fn count(text: str): i64 as Counted = text.len()

struct Holder {
	parts: Pieces
}

struct Box {
	n: i64
}

extend Box {
	fn walk(): Iterator<i64> as Walk = {
		yield self.n
	}
}

extend Pieces {
	fn first(): str = "x"
}

fn main() = {
	val made = Pieces(text: "a", separator: ",")
}
