// A chain written with a `.` at the start of each line is one expression,
// checked as it would be on one line: `xs.forwards().count()` is a count,
// and nothing about it is reported. The rest of the function is checked
// too, so its mismatch is (E0301).

fn main() = {
    val xs = [1, 2, 3, 4]
    val n: i64 = xs
        .forwards()
        .count()
    val wrong: i64 = "text"
}
