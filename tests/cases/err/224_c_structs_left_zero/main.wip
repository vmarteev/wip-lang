// A C struct's field that has no zero is still given: a reference, which
// is never null. And a function type is a field only as an `Option`, which
// may be null as C's pointer is.

struct Point {
    x: i64
}

extern "C" {
    pub struct Holder {
        count: c_int
        point: &Point
    }

    pub struct Callbacks {
        frame: () => void
    }
}

fn main() = {
    val holder = Holder(count: 1)
}
