// A variant's fields are named: a type alone, as a tuple
// variant is written in Rust, is reported as a field without a name, once
// for the variant, with a fix to name a lone one. Empty parentheses are
// reported only where they are empty.

enum Reduced {
	Answer(f64)
	Parts(i64, f64)
	Node(own<Reduced>, radius: f64)
	Empty()
	Named(value: f64)
}

fn main() = {}
