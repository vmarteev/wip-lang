// What a guard's `is` test binds is held as a condition's is: a reference
// into a place holds the place, which the arm may not change while it reads
// the reference; and what a guard gives away is gone for the arms after
// it, as for the arm itself.

fn grown(names: &var Vec<String>, at: i64) = match at {
    i if names.get(i) is .Some(name) => {
        names.push("b")
        assert(name == "a")
    }
    _ => {}
}

fn consume(text: String): bool = text.len() > 5

fn given(n: i64) = {
    val text = String::of("abc")
    match n {
        1 if consume(text) => {}
        _ => assert(text.len() == 3)
    }
}

fn main() = {}
