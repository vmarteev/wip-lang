// Parser (E0133): a struct written with braces, anywhere and in a
// condition, where `Point {` is the name and the block unless a field
// follows it. The fix writes the call.

struct Point {
    x: i64
    y: i64
}

fn main(): i64 = {
    val p = Point { x: 1, y: 2 }
    if p == Point { x: 1, y: 2 } {
        return 1
    }
    return 0
}
