// A type's constant is refused in a type with parameters and in a block
// that implements an interface (E0370); where a method or a variant of the
// type has its name, or another of its constants (E0201); where a build
// would set it (E0368); called (E0306); used outside its module without
// `pub` (E0210); and a name a struct or a built-in type has no constant or
// static function of is said to be one (E0337).

import shapes::{Square}

interface Area {
	fn area(): f64
}

struct Pair<T> {
	a: T
	b: T

	val ORIGIN: i64 = 0
}

struct Rect {
	w: f64
}

extend Rect: Area {
	val UNIT: f64 = 1.0

	fn area(): f64 = self.w * self.w
}

extend Rect {
	val SIDES: i64 = 4
	val SIDES: i64 = 5

	fn SIDES(): i64 = 4

	@define
	val LEVEL: i64 = 1
}

enum Light {
	Red

	val Red: i64 = 1
}

fn main() = {
	val a = Rect::SIDES()
	val b = Square::SIDES
	val c = Rect::SIDE
	val d = i64::NOTHING
}
