// `Self` is the type a method belongs to, and is written nowhere else.

struct Counter {
    count: i64
}

extend Counter {
    fn get(): i64 = self.count
}

enum Shape {
    Circle(radius: i64)
}

extend Shape {
    fn broken(): Self = Self(radius: 1)  // an enum is not a struct
}

fn outside(n: Self): Self = n

struct Holder {
    value: Self                             // a field is not in a method
}

fn main() = {}
