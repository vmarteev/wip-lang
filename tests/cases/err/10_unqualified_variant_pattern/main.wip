// Variant patterns must be qualified. `Circle(r)`
// without `Shape::` is an error: a name with fields after it is a struct
// taken apart, and there is no struct by that name. The bare
// `Point` is a legal catch-all binding that shares a name with a variant;
// that earns warning E0207.

enum Shape {
    Circle(radius: f64)
    Point
}

fn area(s: Shape): f64 = {
    return match s {
        Circle(r) => 3.14 * r * r
        Point => 0.0
    }
}
