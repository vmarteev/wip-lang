// What a piece of an interpolation may say (E0134): `width`, `fill`,
// `align`, `precision` and `radix`, each once, and a width wherever a fill
// or an alignment is said.

fn main() = {
    val unknown = "\(1, size: 4)"
    val twice = "\(1, width: 4, width: 5)"
    val noWidth = "\(1, fill: '0')"
}
