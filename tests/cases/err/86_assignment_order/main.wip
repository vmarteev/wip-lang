// What an assignment's value may not do. `=` finds its place after the
// value, so the value may change what the place is in; but what the place's
// expression lends is taken before the value, so the value may not change a
// projection's key (E0414); and the value may not move what the place is
// found from (E0408, E0401). `op=` reads its place before the value, so
// there the value may not change what the place is in (E0414).

import std::collections::{Map}

struct Point {
    x: i64
}

struct Grid {
    cells: own<[i64]>
}

struct Nodes {
    counts: Vec<i64>
}

extend Nodes {
    var fn make(): i64 = {
        self.counts.push(0)
        return self.counts.len() - 1
    }
}

fn at(grid: &var Grid, i: i64): &var i64 = lend grid.cells[i]

fn bump(n: &var i64): i64 = {
    n += 1
    return 1
}

fn consume(p: own<Point>) = {}

fn main() = {
    // A projection's key, taken before the value.
    var m: Map<String, i64> = Map()
    m.put(String::of("a"), 1)
    var k = String::of("a")
    m.at(&k) = {
        k = String::of("b")
        10
    }

    // What the place is found from, moved by the value.
    var b = own Point(x: 1)
    b.x = {
        consume(move b)
        5
    }
    var grid = Grid(cells: own [0; 4])
    at(&var grid, 1) = {
        val gone = move grid
        2
    }

    // `op=` reads its place first.
    var n = 1
    n += {
        n = 10              // lost: `n` was read first
        1
    }
    n *= bump(&var n)
    var nodes = Nodes(counts: Vec())
    nodes.counts.push(0)
    nodes.counts[0] += nodes.make()
}
