// An assignment finds its place before it computes the value, so the value
// may not change what the place was found in (E0414).

struct Point {
    x: i64
}

struct Grid {
    cells: own<[i64]>
}

fn at(grid: &var Grid, i: i64): &var i64 = lend grid.cells[i]

fn bump(n: &var i64): i64 = {
    n += 1
    1
}

fn refill(p: &var own<Point>): i64 = {
    p = own Point(x: 0)
    5
}

fn main() = {
    var b = own Point(x: 1)
    b.x = {
        b = own Point(x: 2)  // frees the box `b.x` was found in
        5
    }
    b.x = refill(&var b)        // the same, through `&var`

    var xs = own [1, 2, 3]
    xs[0] = {
        xs = own [4, 5, 6]      // replaces the elements `xs[0]` was found in
        7
    }

    var grid = Grid(cells: own [0; 4])
    at(&var grid, 1) = {
        grid.cells = own [1; 4] // replaces what the projection lent
        2
    }

    var n = 1
    n += {
        n = 10                  // lost: `n` was read first
        1
    }
    n *= bump(&var n)
    n = bump(&var n)            // `=` may use the target itself
}
