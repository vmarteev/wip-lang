// How a module's C is built is said with strings, and an `@include` is a
// directory inside the module: where something is on this
// machine is the command line's `-I`.

@include("/usr/local/include")
extern "C" {
    fn first(): c_int
}

@framework()
extern "C" {
    fn second(): c_int
}

@include("src", 3)
@framework("")
extern "C" {
    fn third(): c_int
}

// On a function, neither means anything.
@framework("Cocoa")
fn fourth(): i64 = 4

fn main(): i64 = 0
