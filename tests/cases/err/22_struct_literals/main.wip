// Struct literals (E0308): a missing field, a misspelt field (one error, not a
// second one about the field it was meant to be), a field set twice, and a
// struct literal that names an enum.

struct Size {
    width: i64
    height: i64
}

enum Shape {
    Dot
}

fn main(): i64 = {
    val a = Size(width: 1)
    val b = Size(width: 1, hieght: 2)
    val c = Size(width: 1, width: 2, height: 3)
    val d = Shape(x: 1)
    return 0
}
