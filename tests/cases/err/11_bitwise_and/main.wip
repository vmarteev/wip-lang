// `&` is bitwise and, which needs integers (E0303). On `bool` the fix
// suggests `&&`. `&&` in borrow position is logical-and, not
// a double borrow; the fix suggests `& &` (E0109).

fn f(a: bool, b: bool): bool = {
    return a & b
}

fn g(x: &i64): i64 = {
    return 0
}

fn main(): i64 = {
    val x = 1
    return g(&&x)
}
