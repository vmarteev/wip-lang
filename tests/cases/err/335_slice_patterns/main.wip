// What a slice pattern refuses: a match that leaves
// lengths out, an arm a longer one above covers, an array's length, a
// value that is not an array or a slice, a rest of a value made where it
// is matched, two `..`, and `val` without `else` where the length may
// differ.

fn three(): [i64; 3] = [1, 2, 3]

fn missing(xs: &[i64]): i64 = match xs {
    [] => 0
    [a] => a
}

fn unreachable(xs: &[i64]): i64 = match xs {
    [..] => 0
    [a, ..] => a
}

fn lengths(): i64 = {
    val [a, b] = three()
    val [p, q, r, s, ..] = three()
    return a + b
}

fn notSlice(v: &Vec<i64>): i64 = match v {
    [a, ..] => a
    _ => 0
}

fn restOfValue(): i64 = {
    val [a, ..rest] = three()
    return a + rest.len()
}

fn twice(xs: &[i64]): i64 = match xs {
    [a, .., ..] => a
    _ => 0
}

fn noElse(xs: &[i64]): i64 = {
    val [first, ..] = xs
    return first
}

fn main() = {}
