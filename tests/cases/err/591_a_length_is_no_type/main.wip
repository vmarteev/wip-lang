// A length is a number and a type is a type: a length parameter used as a
// type, a type given for a length or a number for a type, a number written
// as a type, a length an interface would take, a length constrained, and
// arithmetic in a type are each refused; and two lengths that differ are
// two types.

struct Ring<T, val N> {
    items: [T; N]
}

interface Sized<val N> {
    fn size(): i64
}

struct Bounded<val N: Clone> {
    at: i64
}

fn wrong<val N>(x: N): i64 = 1

fn arithmetic<val N>(xs: [i64; N + 1]): i64 = 1

fn main() = {
    val a: Ring<i64, i64> = Ring(items: [1])
    val b: Ring<3, 3> = Ring(items: [1, 2, 3])
    val c: 3 = 3
    val d: Ring<i64, 2> = Ring(items: [1, 2, 3])
}
