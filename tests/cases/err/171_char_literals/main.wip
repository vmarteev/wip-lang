// A character literal holds one character (E0008): not
// none, and not more than one — text is written in double quotes — and it
// ends on its line. `\u{…}` names a Unicode scalar value (E0003).

fn main() = {
    val none = ''
    val two = 'ab'
    val surrogate = '\u{D800}'
    val far = '\u{110000}'
}
