// A type that says it walks as a `Sequence`, an `Iterator`, an
// `IntoIterator` or `Items` but implements none of the methods that do, or
// only some: each is refused for the methods it lacks, and a `for` over it
// finds no way to walk it, rather than reading the interface's own
// declaration as if it were the type's.

struct Ring {}

extend Ring: Sequence<i64> {
	fn len(): i64 = 0
}

struct Counter {}

extend Counter: Iterator<i64> {}

struct Box {}

extend Box: Items<i64> {}

struct Bag {}

extend Bag: IntoIterator<Vec<i64>> {}

fn main() = {
	var ring = Ring()
	for x in ring {}
	var counter = Counter()
	for x in counter {}
	var box = Box()
	for x in box {}
	var bag = Bag()
	for x in move bag {}
}
