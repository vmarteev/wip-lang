// Type arguments in an expression are written after the name, without `::`
// (E0120). After a name, `<` starts them when `(`, `{` or
// `::` follows the matching `>` (grammar R7), so a comparison written that
// way reads as type arguments; E0211 then suggests parentheses.

enum Maybe<T> {
    Some(value: T)
    None
}

fn empty<T>(): Maybe<T> = .None

fn both(a: bool, b: bool): i64 = if a && b { 1 } else { 0 }

fn withColons(): i64 = {
    val a = empty::<i64>()
    0
}

fn compares(x: i64, y: i64): i64 = both(x < y, y > (x))

fn main(): i64 = 0
