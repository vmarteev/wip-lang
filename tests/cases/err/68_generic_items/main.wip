// Errors in declaring and using generic items: an unknown
// constraint (E0212), a generic C function (E0213), an operator or a field on
// a type parameter (E0303, E0307), the wrong number of type arguments
// (E0211), a `&var` as a type argument (E0410), type arguments that
// cannot be inferred (E0315), and a type that owns memory where `copy` is
// required (E0325).

struct Pair<A, B> {
    first: A
    second: B
}

struct Plain<T: copy> {
    value: T
}

struct Sorted<T: ord> {
    value: T
}

enum Maybe<T> {
    Some(value: T)
    None
}

struct Token {
    id: i64
}

extern "C" {
    fn c_fn<T>(x: i64)
}

fn add<T>(a: T, b: T): T = a + b

fn size<T>(x: &T): i64 = x.len()

fn make<T>(): Maybe<T> = .None

fn keep<T: copy>(x: T): T = x

fn main(): i64 = {
    val a: Pair<i64> = Pair(first: 1, second: 2)
    val b: Pair<&var i64, i64> = Pair(first: 1, second: 2)
    val c: i64<bool> = 1
    val d = make()
    val e = Maybe::None
    val f: Plain<own<Token>> = Plain(value: own Token(id: 1))
    val g = keep(own Token(id: 2))
    val h = make<i64, bool>()
    0
}
