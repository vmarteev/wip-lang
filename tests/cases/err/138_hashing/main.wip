// What `@derive(Hash)` will not do. It writes the hashing from the fields, so
// every field must be hashed; a type has one answer, so `@derive(Hash)` and an
// `extend … : Hash` cannot both be written; and it needs `@derive(Eq)` beside
// it, because a map is wrong the moment two equal values hash differently.

@derive(Hash)
struct Alone { n: i64 }

@derive(Eq, Hash)
struct Measured { size: f64 }

@derive(Eq, Hash)
struct Twice { n: i64 }

extend Twice: Hash {
    fn hashInto(out: &var Hasher) = out.writeInt(self.n as u64)
}

// Equality written by hand: the compiler will not guess that the hashing
// should leave the note out too.
struct Ticket { number: i64, note: i64 }

extend Ticket: Eq {
    fn equals(other: &Ticket): bool = self.number == other.number
}

@derive(Hash)
struct Booked { ticket: Ticket }
