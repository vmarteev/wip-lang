// An `own<T>` implements nothing itself, whatever its `T` does: a method is
// looked up through it, as a field is, and a constraint is not. So a
// recursive enum whose field is an `own` of itself cannot `@derive(Clone)`
// (E0440), and an `own<Point>` given where `T: Eq` or `T: Text` is asked
// for is refused (E0342), with a note that `&` lends the `Point` where a
// type argument written out asks for one. Both compiled, and stopped the
// code generator, which had no implementation to call.

import std::io

@derive(Clone)
enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

@derive(Eq, Text)
struct Point {
    x: i64
}

fn same<T: Eq>(a: &T, b: &T): bool = a == b

fn shown<T: Text>(a: &T): String = "\(a)"

fn main() = {
    val a = own Point(x: 1)
    val b = own Point(x: 1)
    io::println("\(same(&a, &b))")
    io::println(shown(&a))
    io::println("\(same<Point>(&a, &b))")
}
