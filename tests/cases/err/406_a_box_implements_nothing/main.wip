// An `own<T>` implements none of what its `T` does, only what is written for
// a box: a method is looked up through it, as a field is, and a constraint
// is not. A box clones where what it holds does, so a field that boxes
// what cannot be cloned is refused by `@derive(Clone)` (E0440), with the
// chain that says why; and an `own<Point>` given where `T: Eq` or
// `T: Text` is asked for is refused (E0342), with a note that `&` lends
// the `Point` where a type argument written out asks for one. Both
// compiled once, and stopped the code generator, which had no
// implementation to call.

import std::io

struct Plain {
    name: String
}

@derive(Clone)
struct Holder {
    inner: own<Plain>
}

@derive(Eq, Text)
struct Point {
    x: i64
}

fn same<T: Eq>(a: &T, b: &T): bool = a == b

fn shown<T: Text>(a: &T): String = "\(a)"

fn main() = {
    val a = own Point(x: 1)
    val b = own Point(x: 1)
    io::println("\(same(&a, &b))")
    io::println(shown(&a))
    io::println("\(same<Point>(&a, &b))")
}
