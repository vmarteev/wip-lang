// Calls (E0302, E0306): wrong argument counts, and calling something that is
// not a function. A function used as a value is no longer an error;
// ok/61 uses one.

fn add(a: i64, b: i64): i64 = {
    return a + b
}

fn main(): i64 = {
    val x = add(1)
    val y = add(1, 2, 3)
    val z = x(2)
    return 0
}
