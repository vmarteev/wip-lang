// A type that cleans up after itself follows two rules: its drop is not a
// method a program may call, and no part of it is taken out from under the drop
// that is about to run. That it is never copied is the move checker's, in the
// case beside this one.

import std::io

struct Guard {
    handle: own<i64>,
    id: i64
}

extend Guard: Destroy {
    var fn destroy() = io::printInt(self.id)
}

fn called(): i64 = {
    var guard = Guard(handle: own 2, id: 2)
    guard.drop()                    // it runs where the value ends
    0
}

fn partOut(): own<i64> = {
    val guard = Guard(handle: own 3, id: 3)
    val handle = move guard.handle  // the drop would run over the hole
    handle
}

fn main() = {
    io::printInt(called())
}
