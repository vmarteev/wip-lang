// `empties` is said only by a `var fn`, which changes its receiver
// (E0462); and an implementation of an interface's method that says it
// says it too, since a call through the interface takes the receiver to
// hold nothing after it (E0462).

view struct Words {
	words: Vec<str> = Vec()
}

extend Words {
	fn looked() empties = {}

	static fn made(): Words empties = Words()
}

fn alone() empties = {}

interface Emptying {
	var fn clear() empties
}

extend Words: Emptying {
	var fn clear() = {
		self.words = Vec()
	}
}

fn main() = {}
