// A closure kept in a `val` that writes what it captures holds it until its
// last use, as a place lent `&var` is held: reading it, or assigning it,
// before then is refused (E0414). After its last use, both are as before.

fn main() = {
    var seen = 0
    val note = (x: i64) => {
        seen += x
        return seen
    }
    note(1)
    val early = seen
    note(2)
    seen = 5
    note(3)
    val after = seen
    seen = 0
}
