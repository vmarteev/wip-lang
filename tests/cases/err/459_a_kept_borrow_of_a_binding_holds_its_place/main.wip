// A binding borrowed where the borrow may be kept is the place it matched,
// not a copy, so the place may not change while the binding is in scope
// (E0414), as for a binding that is written through, and what keeps the
// borrow is not used after it does (E0436).

view struct Marker {
    at: &i64
}

fn main() = {
    var slot: Option<i64> = .Some(7)
    if slot is .Some(value) {
        val marker = Marker(at: &value)
        slot = .None
        assert(marker.at == 7)
    }
}
