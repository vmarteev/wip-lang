// A guard runs once the pattern has bound its names, so an arm whose `var`
// name takes a part that owns memory cannot have one: a guard that failed
// would leave the value half taken (E0313).

enum Shape {
	Named(label: String, sides: i64)
	Dot
}

fn main() = {
	val named = Shape::Named(label: String::of("tri"), sides: 3)
	match named {
		.Named(var label, ..) if label.len() > 2 => label.push("angle")
		_ => {}
	}
}
