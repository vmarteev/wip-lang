// A doubly linked list built from `own` (E0408, E0401). Each node
// would have two owners, the node before it and the node after it, but an
// `own` has exactly one: linking the second direction uses a
// node that was already moved into the first link. The version that works is
// ok/44.

enum Link {
    To(node: own<DNode>)
    End
}

struct DNode {
    value: i64
    prev: Link
    next: Link
}

fn pair(): own<DNode> = {
    var first = own DNode(value: 1, prev: Link::End, next: Link::End)
    var second = own DNode(value: 2, prev: Link::End, next: Link::End)
    first.next = Link::To(move second)
    second.prev = Link::To(move first)
    move first
}
