// Assignment (E0304): to a `val` binding (fix: `var`), to a parameter, through
// a `&` reference (only `&var` writes), and to something that is not a place.

struct Counter {
    hits: i64
}

fn bump(c: &Counter, n: i64) = {
    c.hits = c.hits + 1
    n = n + 1
}

fn main(): i64 = {
    val total = 0
    total = total + 1
    val c = Counter(hits: 0)
    c.hits = 1
    bump(&c, 1)
    1 = total
    return total
}
