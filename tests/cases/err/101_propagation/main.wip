// `?` needs an `Option` or a `Result`, and a function that can carry it.

import std::io

fn ok(): Result<i64, i64> = .Ok(1)
fn opt(): Option<i64> = .Some(1)

fn plain(): i64 = ok()?                          // returns neither
fn wrongError(): Result<i64, bool> = .Ok(ok()?)  // another error type
fn optionInResult(): Result<i64, i64> = .Ok(opt()?)
                                                 // an `Option` in a `Result`
fn notEither(): Result<i64, i64> = .Ok(3?)       // not either type
fn nothing() = ok()?                             // returns nothing

fn main() = {
    io::printInt(plain())
}

