// A binding written through refers to the place it was matched from, so the
// place itself must not change while the binding is in scope: neither a
// field of it, written directly, nor the whole of it.

struct Point {
	x: i64
	y: i64
}

fn main() = {
	var p = Point(x: 1, y: 2)
	match p {
		Point(x, ..) => {
			x += 1
			p.x = 5
			p = Point(x: 0, y: 0)
			x += 1
		}
	}
}
