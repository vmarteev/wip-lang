// A line that ends with `.` is refused (E0113), with the fix that moves the
// `.` to the start of the next line, where a chain goes on; the chain is
// read on as it was meant, so nothing more is said of it. Inside
// parentheses a line break is whitespace, and a `.` may end a line.

fn main() = {
    val words = ["wip", "is", "short"]
    val count = words.walk().
        filter(own (w) => w.len() > 2).
        count()
    val inside = (words.walk().
        count())
}
