// A `clone()` of plain data, which naming copies, is a warning (E0464),
// where the clone is that copy: of a type with no `clone` of its own, a
// derived one, or the library's — an enum of names, a struct of numbers, an
// `Option` and a tuple of them, an element. Nothing is said of a clone the
// program writes, which may do more; of a reference, whose clone is what it
// refers to; of a type parameter, which may own memory; or of a `String`.

@derive(Clone)
enum Kind {
    Sand
    Rock
}

struct Point {
    x: i64
    y: i64
}

struct Counted {
    n: i64
}

extend Counted: Clone {
    fn clone(): Counted = Counted(n: self.n + 1)
}

val KINDS: [Kind; 2] = [Kind::Sand, Kind::Rock]

fn generic<T: Clone>(value: &T): T = value.clone()

/// What is given, which goes no further.
fn kept<T>(_: T) = {}

fn main() = {
    val kind = Kind::Rock
    kept(kind.clone())
    val point = Point(x: 1, y: 2)
    kept(point.clone())
    val maybe: Option<i64> = 3
    kept(maybe.clone())
    val pair = (1, true)
    kept(pair.clone())
    kept(KINDS[1].clone())
    val counted = Counted(n: 0)
    kept(counted.clone())
    val lent = &point
    kept(lent.clone())
    kept(generic(&point))
    val text = String::of("t")
    val i = text.clone()
    val j = text
}
