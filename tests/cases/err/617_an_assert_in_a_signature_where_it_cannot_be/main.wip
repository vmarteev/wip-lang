// An `assert` in a signature asks something of a generic's type and length
// parameters, for each instance a call makes; where it cannot, it is
// refused (E0465): a value parameter read, known only when the call runs;
// a function with no type or length parameter, whose fact a top-level
// `assert` says; an interface's method; and a C function's.

fn counted<T>(count: i64): i64
	assert(count > 0) = count

fn plain(n: i64): i64
	assert(n > 0) = n

interface Sized {
	fn size(): i64
		assert(true)
}

extern "C" {
	fn abs(n: c_int): c_int
		assert(true)
}

fn main() = {}
