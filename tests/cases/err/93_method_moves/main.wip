// A `move fn` takes its receiver, so the receiver is moved at the call, and
// cannot be taken from behind a reference.

import std::io

struct Bag {
    item: own<i64>

    static fn new(): Bag = Bag(item: own 1)
    fn peek(): i64 = self.item + 0
    move fn take(): own<i64> = move self.item
}

fn throughRef(b: &Bag): own<i64> = b.take()

fn main() = {
    var bag = Bag::new()
    val first = bag.take()
    io::printInt(first + 0)
    io::printInt(bag.peek())
}

