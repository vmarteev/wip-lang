// A default type argument where it cannot be: after it, a
// parameter with none; one naming a parameter after it, or resting on
// itself; one that breaks its own parameter's constraint; one on a
// function; and a use that writes more than the type takes.

struct Plain {
	x: i64
}

struct Pool<T, K = T> {
	items: Vec<T>
}

struct Gap<A = i64, B> {
	a: A
}

struct Later<A = B, B = i64> {
	a: A
}

struct Itself<A = Itself> {
	a: i64
}

struct Needs<T: Eq = Plain> {
	t: i64
}

fn generic<T = i64>(x: T): T = x

extend Pool<T> {}

fn tooMany(pool: &Pool<i64, str, bool>) = {}

fn main() = {
	val plain: bool = Pool<i64>(items: Vec())
}
