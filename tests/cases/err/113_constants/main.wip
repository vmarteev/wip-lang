// A top-level `val` is a constant: no cycles, and no
// division by zero where it is folded. One that calls a function is run
// while the program is compiled, which `ok/252` shows.
// A top-level `var` is a global variable, which is not decided yet.

import std::io

val FROM_CALL = 7
val DIVIDED = 1 / 0
val SELF = SELF + 1
val EACH_OTHER = OTHER + 1
val OTHER = EACH_OTHER + 1
val TYPED: i32 = "text"
val TWICE = 1
val TWICE = 2

fn main() = {
    io::printInt(FROM_CALL)
}

