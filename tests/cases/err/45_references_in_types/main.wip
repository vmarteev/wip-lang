// References in types. A `&` is a view: a field
// or a variant's payload holds one only in a view (E0427). A `&var` is a
// parameter's whole type alone, and nothing holds one (E0410); neither does
// a constant or a C pointer. `first` declares a projection by returning
// `&i64`, so it is judged as one (E0418): it lends nothing.

struct Holder {
    value: &i64
}

enum Maybe {
    Some(value: &i64)
    None
}

fn first(h: Holder): &i64 = h.value

fn boxed(r: own<&var i64>) = {}

fn later(): Option<&var i64> = .None

fn local(x: &i64): i64 = {
    val y: &var i64 = x
    0
}

val ONE: &i64 = 1

fn pointed(p: ptr<&i64>) = {}

fn main() = {}
