// What a range of a pointer cannot be: one with no end, since only the
// program knows where C's memory ends; one of a `void` or an opaque C
// type, whose elements have no size; and one not borrowed, as no range
// of elements may be.

import std::c

extern "C" {
    type Handle
}

fn main() = {
    val values: [u32; 4] = [1, 2, 3, 4]
    val p = c::pointerTo(&values)
    val open = &p[1..]
    val raw = p as ptr<void>
    val bytes = &raw[0..4]
    val h: ptr<Handle> = null
    val handles = &h[0..1]
    val loose = p[0..2]
}
