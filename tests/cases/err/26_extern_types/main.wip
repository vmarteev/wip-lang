// Extern declarations (E0314): only integers of up to 64 bits, `f32`, `f64`,
// `bool` and `cstring` cross the C boundary. A `str`
// goes to C as a pointer and a length, two arguments, so it can be passed but
// not returned; 128-bit integers, `isize` and `usize` are Wip's own.
// A result may also be `never`, for a C function that does not return, but a
// parameter may not: no value of that type exists.

struct Point {
    x: i64
}

extern "C" {
    fn draw(p: Point)
    fn make(): own<Point>
    fn text(s: str): str
    fn wide(x: i128): usize
    fn nothing(x: never): i32
    fn fine(x: i64, y: f64, b: bool, s: cstring, c: u8, f: f32): i64
    fn stops(code: i32): never
}
