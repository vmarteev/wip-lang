// A binding written through is the place itself, so the place cannot change
// while it is in scope, even when it holds plain data.

fn main() = {
	var counter: Option<i64> = .Some(1)
	match counter {
		.Some(n) => {
			n += 1
			counter = .None
		}
		.None => {}
	}
	var pair: Option<(i64, i64)> = .Some((1, 2))
	if pair is .Some(both) {
		both.0 = 5
		pair = .None
	}
}
