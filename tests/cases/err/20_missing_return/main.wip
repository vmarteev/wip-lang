// Control flow (E0305, E0301): a function that can fall off its end, a
// `return` without a value, and a value returned from a function that returns
// nothing.

fn sign(x: i64): i64 = {
    if x < 0 {
        return -1
    } else if x > 0 {
        return 1
    }
}

fn nothing(): i64 = {
    return
}

fn log(x: i64) = {
    return x
}
