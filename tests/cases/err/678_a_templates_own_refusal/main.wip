// A template of a program's own says what it refuses in a literal by a
// `refusal` of its own, which the compiler asks of each literal that builds
// it: a hole, or a byte of the literal's own text, which the error points
// at as the source writes it, through escapes and a text block's
// indentation. Two literals with the same text and holes are each refused.
// A `refusal` that panics is an error at the literal.

struct Pattern {
	text: String
}

extend Pattern: Template {
	static fn withCapacity(capacity: i64): Pattern = Pattern(text: .withCapacity(capacity))

	var fn pushLiteral(text: str) = self.text.push(text)

	var fn pushBuilt(built: &Pattern, implicit at: Location) = self.text.push(built.text.toStr())
}

extend Pattern {
	var fn pushValue<T: Text>(value: &T) = value.appendTo(&var self.text)

	/// A `(` the literal does not close, a `!` it was not written for, and a
	/// third hole.
	static fn refusal(pieces: &[str], joined: &[bool]): Option<Refusal> = {
		var open: Option<(i64, i64)> = .None
		for (i, piece) in pieces.indexed() {
			if piece.startsWith("!") then
				panic("a `!` it was not written for")

			for at in 0..piece.len() {
				if piece[at] == b'(' then
					open = (i, at)
				else if piece[at] == b')' then
					open = .None
			}
		}
		if open is .Some((piece, at)) then
			return .Text(piece:, at:, why: "a `(` that is never closed")

		if joined.len() > 2 then
			return .Hole(index: 2, why: "past the second")

		return .None
	}
}

fn main() = {
	val n = 1
	val escaped: Pattern = "a\tb\u{e9}(c"
	val after: Pattern = "x\(n)y\"\\(z"
	val again: Pattern = "x\(n)y\"\\(z"
	val third: Pattern = "\(n)\(n)\(n)"
	val block: Pattern = """
		first \(n)
		  é (open
		"""
	val loud: Pattern = "!"
	val closed: Pattern = "(\(n))"
}
