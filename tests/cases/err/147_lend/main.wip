// A projection `lend`s, and `yield` is kept for what yields.
// A word in the wrong place is reported where it is written: `impl`,
// which Wip writes `extend`, and `lend` outside a projection.

struct Deck {
    cards: Vec<i64>

    pub fn at(index: i64): &i64 = yield self.cards.at(index)
}

fn notAProjection(deck: &Deck): i64 = lend deck.cards.at(0)

fn main() = {}
