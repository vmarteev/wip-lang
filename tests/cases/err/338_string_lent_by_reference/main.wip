// A `String` is lent as a `str` to read and for a call alone: not to a `&var
// str`, whose writes would not reach it, and not to a local, which would
// outlive the lending.

fn change(text: &var str) = {}

fn main() = {
    var name = String::of("edit")
    change(&var name)
    val kept: &str = name
}
