// `forwards()` lends a list's elements where they lie, so the list is
// borrowed while the iterator is kept: pushing to it, which may move its
// elements, before the iterator is used again is refused (E0436).

fn main() = {
	var names: Vec<String> = Vec()
	names.push("ann")
	var walk = names.forwards()
	names.push("bo")
	assert(walk.next().isSome())
}
