// A list is made into a collection only where that collection implements
// `Collect`: a struct that does not, and an arena, whose values are each
// known by the handle `add` answers, are refused (E0301); and each element
// is checked against what the collection holds.

import std::collections::{Arena, Set}

struct Point {
    x: i64
    y: i64
}

fn main() = {
    val point: Point = [1, 2]
    val values: Arena<i64> = [1]
    val numbers: Set<i64> = ["one"]
}
