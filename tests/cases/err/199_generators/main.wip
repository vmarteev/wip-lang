// What a generator refuses where it is written: a loop
// that stands for a value and yields nothing, `return` in one, a function
// that answers `Iterator<T>` and yields nothing, one that would hold a
// `&var` between calls, and generators that hold themselves, directly or
// through each other.

fn yieldsNothing(xs: &[i64]) = {
    var none = for x in xs { val y = x }
}

fn returns(xs: &[i64]) = {
    var early = for x in xs {
        if x > 1 {
            return
        }
        yield x
    }
}

fn silent(n: i64): Iterator<i64> = {
    val m = n
}

fn grows(v: &var Vec<i64>): Iterator<i64> = {
    yield v.len()
}

enum Tree {
    Leaf(value: i64)
    Node(children: own<[Tree]>)
}

fn leaves(tree: &Tree): Iterator<i64> = {
    match tree {
        .Leaf(value) => { yield value }
        .Node(children) => {
            for child in children {
                for value in leaves(&child) {
                    yield value
                }
            }
        }
    }
}

fn ping(n: i64): Iterator<i64> = {
    if n > 0 {
        for x in pong(n - 1) {
            yield x
        }
    }
    yield n
}

fn pong(n: i64): Iterator<i64> = for x in ping(n) { yield x * 10 }

fn main() = {}
