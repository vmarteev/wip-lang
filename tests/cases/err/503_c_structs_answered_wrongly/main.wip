// A C struct a function answers borrows what the signature lends to what
// its pointers point at, and is held to it: answered pointing at a local,
// or at a parameter `from` leaves out (E0437); and kept, it is refused
// after what it points into changes (E0436), whether an argument or a
// method's receiver.

@header("parts.h")
extern "C" {
    struct Part {
        values: ptr<i32>
        count: i64
    }

    fn total(parts: &[Part]): i64
}

fn partOf(values: &[i32]): Part = Part(values: &values, count: values.len())

fn ofLocal(): Part = {
    val values: [i32; 2] = [1, 2]
    return Part(values: &values, count: 2)
}

fn other(a: &[i32], b: &[i32]): Part from a = Part(values: &b, count: b.len() + 0 * a.len())

struct Numbers {
    values: Vec<i32>
}

extend Numbers {
    fn part(): Part = Part(values: &self.values.items(), count: self.values.len())
}

fn main() = {
    var values: Vec<i32> = Vec::of(own [1, 2, 3])
    val part = partOf(&values.items())
    values.push(4)
    total([part])
    var numbers = Numbers(values: Vec::of(own [1, 2]))
    val mine = numbers.part()
    numbers.values.clear()
    total([mine])
}
