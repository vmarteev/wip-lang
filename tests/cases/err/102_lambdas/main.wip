// A lambda takes its parameters' types from what is expected, and captures
// nothing until closures arrive.

import std::io

fn apply(f: (x: i64) => i64, n: i64): i64 = f(n)

fn noTypes(): i64 = {
    val f = (x) => x + 1          // no type to take from
    f(1)
}

fn wrongCount(): i64 = apply(() => 1, 2)
                                  // one parameter is expected

fn captures(): i64 = {
    val factor = 3
    apply((x) => x * factor, 2)   // a closure, which comes next
}

fn twice(): i64 = {
    val f = (x: i64, x: i64) => x // one name, twice
    f(1, 2)
}

fn main() = {
    io::printInt(noTypes())
}

