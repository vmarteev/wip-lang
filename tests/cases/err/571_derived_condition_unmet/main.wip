// What `@derive` writes holds where the type's arguments give its fields
// what they need, and a use where they do not is told which field asks it:
// a comparison of pairs of values that do not compare, a clone in generic
// code of a parameter that promises none, a map keyed by a type whose hash
// asks its parameter, and a field whose implementation asks `Ord` of
// values that only compare.

import std::collections::{Map}

@derive(Clone, Eq)
struct Pair<T> {
	first: T
	second: T
}

@derive(Eq, Hash)
struct Key<T> {
	id: T
}

struct Plain {
	n: i64
}

/// Values kept in order: its equality asks `Ord` of them.
struct Sorted<T> {
	values: Vec<T>
}

extend Sorted<T: Ord>: Eq {
	fn equals(other: &Sorted<T>): bool = self.values.len() == other.values.len()
}

@derive(Eq)
struct Kept<T> {
	sorted: Sorted<T>
}

@derive(Eq)
struct Equal {
	n: i64
}

fn copied<T>(pair: &Pair<T>): Pair<T> = pair.clone()

fn counted<T>(table: &Map<Key<T>, i64>): i64 = 0

fn main() = {
	val pair = Pair(first: Plain(n: 1), second: Plain(n: 2))
	val same = pair == pair
	val kept = Kept(sorted: Sorted(values: [Equal(n: 1)]))
	val also = kept == kept
}
