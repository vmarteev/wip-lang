// Moves (E0405): a reference can read a value but not give it away, either
// with `move` or by copying.

struct Engine {
    power: i64
}

struct Car {
    engine: own<Engine>
}

fn scrap(e: own<Engine>) = {}

fn strip(c: &Car) = {
    scrap(move c.engine)
}

fn peek(c: &Car): i64 = {
    val e = c.engine
    return 0
}
