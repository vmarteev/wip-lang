// A closure kept in a `val` that writes what it captures is not taken where
// a closure that reads is, nor by `future::map`, which shares one closure
// among threads (E0301), and a closure that reads cannot use it (E0350).
// What it holds until its last use is `err/541`.

import std::future

fn reads(f: &(x: i64) => i64): i64 = f(1)

fn givenToReaders() = {
    var seen = 0
    val note = (x: i64) => {
        seen += x
        return seen
    }
    reads(note)
    future::map([1, 2], note)
}

fn readerHoldsWriter(): i64 = {
    var seen = 0
    val note = (x: i64) => {
        seen += x
        return seen
    }
    return reads((x) => note(x))
}

fn main() = {}
