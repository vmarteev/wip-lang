// A reference a local holds borrows its place as a declared one does:
// the place may not change while it is used (E0436), and a temporary is not
// kept past its statement (E0437).

fn make(): String = String::of("t")

fn main() = {
    var items = Vec::of(own [1, 2, 3])
    val first = &items[0]
    items.push(4)
    val n = first + 1
    val r = &make()
    val m = r.len()
}
