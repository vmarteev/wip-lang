// `extend` is how a block is written, and `impl` is reported rather than read
// as a name; a block is one interface's methods, so a second
// one is reported too.

interface Named {
    fn name(): i64
}

interface Sized {
    fn size(): i64
}

struct Box {
    n: i64
}

impl Box {                          // written `extend`
    fn one(): i64 = 1
}

impl Named for Box {                // and the type comes first
    fn name(): i64 = 2
}

extend Box: Named + Sized {         // one interface at a time
    fn name(): i64 = 3
    fn size(): i64 = 4
}

fn main() = {}
