// A file embedded where it cannot be, each E0446: outside
// the package, not there, a whole path, a path that is not a literal, a
// text that is not UTF-8, a directory, and a call in a function, where a
// file is read through a constant instead.

import std::embed

val OUTSIDE = embed::text("../113_constants/main.wip")
val MISSING = embed::bytes("nope.bin")
val WHOLE = embed::bytes("/etc/hosts")
val NAME = "latin1.txt"
val NOT_LITERAL = embed::text(NAME)
val NOT_TEXT = embed::text("latin1.txt")
val DIRECTORY = embed::bytes(".")

fn inside(): str = embed::text("latin1.txt")

fn main() = {}
