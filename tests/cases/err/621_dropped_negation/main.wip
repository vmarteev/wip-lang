// A statement that starts with `-` and whose value is dropped is refused:
// a line break ends an expression that is complete, so a subtraction
// wrapped before its `-` is two statements, and the second negates a
// value and drops it. Whatever it negates, a value or a call, it is never
// what was meant. The fix joins the line to the one above, unless a
// comment lies between or the line above ends in a block.

import std::io

fn cost(x: i64): i64 = x * 2

fn main() = {
    val base = 100
    val total = base
        - cost(3)
    var width = 10.0
    width = width * 2.0
        - 1.5
    val area = base
        // the margin
        - total * 2
    if base > 0 {
        io::printInt(total + area)
    }
    - base as f64
    { -base; io::printInt(base) }
}
