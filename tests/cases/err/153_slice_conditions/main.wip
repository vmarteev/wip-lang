// A slice's methods may ask something of its element, and
// a slice whose element answers nothing has none of them: the message says
// which constraint was not met and where the block asked for it.

import std::io

struct Plain {
    n: i64
}

fn main() = {
    var values = Vec<Plain>()
    values.push(Plain(n: 1))
    values.items().sort()
    io::println("\(values.contains(Plain(n: 1)))")
}
