// What a C struct's pointer field cannot be given `&` of: a place of
// another type, a `val` for C to write through, and a Wip struct's
// pointer, which is no C struct's: a Wip struct that points into the
// program says so with a reference in a view.

extern "C" {
    struct Span {
        values: ptr<i32>
        count: i64
    }
}

struct Mine {
    at: ptr<i32>
}

fn main() = {
    val wide: [i64; 2] = [1, 2]
    val narrow: [i32; 2] = [1, 2]
    val other = Span(values: &wide, count: 2)
    val written = Span(values: &var narrow, count: 2)
    var mine = Mine(at: &narrow)
}
