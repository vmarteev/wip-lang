// A call whose arguments by position are the parameters' own names, each
// in another's place, is a warning (E0361): two swapped, three in a ring,
// fields read and swapped, a method's and a C function's arguments.
// Naming them says the order is meant, and its fix does. Nothing is said of
// arguments in their places, named ones, one variable given to two
// parameters, a chain — a variable named as another parameter, whose own
// argument is something else — or a call through a function value, whose
// parameters have no names.

struct Size {
    width: i64
    height: i64
}

extend Size {
    fn scaled(width: i64, height: i64): Size = Size(width: width, height: height)
}

extern "C" {
    fn c_move(x: i32, y: i32)
}

fn draw(width: i64, height: i64) = {}

fn ring(a: i64, b: i64, c: i64) = {}

fn binary(kind: i64, lhs: i64, rhs: i64) = {}

fn warned(width: i64, height: i64, size: Size) = {
    draw(height, width)
    draw(size.height, size.width)
    val a = 1
    val b = 2
    val c = 3
    ring(b, c, a)
    val other = size.scaled(height, width)
    val x: i32 = 1
    val y: i32 = 2
    c_move(y, x)
}

fn quiet(width: i64, height: i64, size: Size) = {
    draw(width, height)
    draw(width: height, height: width)
    draw(height, height)
    val a = 1
    val c = 3
    ring(a, a, c)
    val rhs = 4
    binary(0, rhs, size.width)
    val f = draw
    f(height, width)
}

fn main() = {}
