// A chain continued with a `.` at the start of each line is not one:
// each line warns (E0126) with the fix that moves the `.` to the end of the
// line above, and each name, a variant that no enum is expected for, is E0315
// with the same advice.

fn main() = {
    val xs = [1, 2, 3, 4]
    val n = xs
        .walk()
        .count()
}
