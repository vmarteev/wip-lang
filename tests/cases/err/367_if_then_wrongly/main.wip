// One `if`, one form (E0101): `then` before a block, with
// the fix that drops it; a `then` form whose `else` is a block; a braced
// `if` whose `else` is not; and a chain that changes form, each way.

fn a(c: bool): i64 = if c then { 1 } else 2

fn b(c: bool): i64 = if c then 1 else {
    2
}

fn d(c: bool): i64 = if c { 1 } else 2

fn e(x: i64): i64 = if x < 0 then -1 else if x == 0 { 0 } else { 1 }

fn f(x: i64): i64 = if x < 0 { -1 } else if x == 0 then 0 else 1

fn main() = {}
