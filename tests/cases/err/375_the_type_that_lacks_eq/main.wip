// A type that compares only where its argument does, whose argument
// compares only where its own does: the help follows each condition down
// and names the type that lacks `Eq`, to derive it where the program
// declares it, and with its module where the standard library does. A
// derived comparison and a constraint say the same.

import std::sync::{Mutex}

enum Argument {
	Short(c: char)
}

fn parsed(): Result<Option<Argument>, i64> = .Ok(.None)

@derive(Eq)
struct Parsed {
	arguments: Vec<Option<Argument>>
}

fn same<T: Eq>(a: &T, b: &T): bool = a == b

fn main() = {
	assert(parsed() == .Ok(.None))
	val locks: Option<Mutex<i64>> = .None
	assert(locks == .None)
	val arguments: Vec<Option<Argument>> = Vec()
	assert(same(&arguments, &arguments))
}
