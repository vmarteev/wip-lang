// A constant takes another integer type only where its value fits: one too
// large, and a negative one where the type has no negatives, are refused
// as a literal would be, naming the value. What the program computes is
// converted by `as` where something may be lost: a wider local, a wider
// constant `@comptime` code works out, and an integer where a float is
// expected are refused as before.

val MOST: i64 = 512
val GRAPHICS: c_int = 1

@comptime
val WORKED: i64 = twice(3)

fn twice(n: i64): i64 = n * 2

fn main() = {
    val big: u8 = MOST
    val negative: u32 = -GRAPHICS
    val local: i64 = 3
    val wanted: u32 = local
    val worked: u32 = WORKED
    val ratio: f32 = GRAPHICS
}
