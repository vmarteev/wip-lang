// What a C function that takes more than it declares will not take.
// Only a C declaration may be variadic, C reads the rest
// by what the first ones said, and what follows must already be a scalar C
// knows — nothing widens on the way there.

struct Point {
    x: i64,
    y: i64
}

extern "C" {
    fn printf(fmt: cstring, ...): c_int
    fn justDots(...): c_int
    fn andMore(fmt: cstring, ..., last: c_int): c_int
}

fn wipVariadic(first: i64, ...): i64 = first

fn main() = {
    val text = "a string of Wip's own"
    val point = Point(x: 1, y: 2)

    printf("%s\n", text)
    printf("%d %d\n", point)
    printf(fmt: "%d\n")
    printf()
}
