 14 │     fn andMore(fmt: cstring, ..., last: c_int): c_int
    │                              ─┬─  ─────┬─────  
    │                               ╰──────────────── the declaration ends here
    │                                        │       
    │                                        ╰─────── a parameter after it
    │ 
