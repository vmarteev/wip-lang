// `match` bindings (E0405, E0436, E0413). Matching a place makes
// the bindings aliases for its fields: one cannot be moved out of (the hint
// points at `match move`), one is not used after the arm assigns the place
// (E0436), and the place is not passed as `&var` alongside a binding
// (E0413).

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

fn consume(list: own<List>) = {}

fn show(list: &List) = {}

fn clear(list: &var own<List>, keep: &List) = {}

fn takeTail(list: &List) = match list {
    .Cons(tail, ..) => consume(tail)
    .Nil => {}
}

fn dropWhileBorrowed(list: own<List>) = {
    var l = list
    match l {
        .Cons(tail, ..) => {
            l = own List::Nil
            show(&tail)
        }
        .Nil => {}
    }
}

fn clearWhileBorrowed(list: own<List>) = {
    var l = list
    match l {
        .Cons(tail, ..) => clear(&var l, &tail)
        .Nil => {}
    }
}

fn fine(list: own<List>) = {
    var l = list
    match l {
        .Cons(..) => l = own List::Nil
        .Nil => {}
    }
}
