// `match` bindings (E0405, E0414, E0413). Matching a place makes
// the bindings aliases for its fields: one cannot be moved out of (the hint
// points at `match move`), and while an arm's bindings refer into the matched
// place, the arm cannot move or assign that place, or pass it as `&var`
// (E0414), let alone alongside a binding (E0413).

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

fn consume(list: own<List>) = {}

fn show(list: &List) = {}

fn clear(list: &var own<List>, keep: &List) = {}

fn takeTail(list: &List) = match list {
    .Cons(tail, ..) => consume(move tail)
    .Nil => {}
}

fn dropWhileBorrowed(list: own<List>) = {
    var l = move list
    match l {
        .Cons(tail, ..) => {
            l = own List::Nil
            show(&tail)
        }
        .Nil => {}
    }
}

fn clearWhileBorrowed(list: own<List>) = {
    var l = move list
    match l {
        .Cons(tail, ..) => clear(&var l, &tail)
        .Nil => {}
    }
}

fn fine(list: own<List>) = {
    var l = move list
    match l {
        .Cons(..) => l = own List::Nil
        .Nil => {}
    }
}
