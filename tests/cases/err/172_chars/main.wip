// A `char` is not a number: it converts to one with `as`,
// but only a `u8` converts to it, and it takes no arithmetic. Text and a
// character are not one another.

fn main() = {
    val n: i64 = 65
    val c = n as char
    val next = 'a' + 1
    val text: str = 'a'
    val letter: char = "a"
    val kind = match "a" {
        'a' => 1,
        _ => 0,
    }
}
