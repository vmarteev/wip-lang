// A loop over a slice, an array or a `Vec` whose body only tests and
// returns, and then returns the other answer, is warned of (E0481), with
// the fix that says it as `any`, `all` or `find`: `all` takes the `!` off a
// test that has one, and writes one before a test that has none. Left
// alone: a test with a `?`, a loop over a `Set` or an iterator, whose
// element is not what the method lends, one that returns something else, a
// loop with a comment in it, and the method's own loop.

import std::collections::{Set}
import std::text::{ParseError}

struct Item {
    name: String
    size: i64
}

fn large(items: &[Item]): bool = {
    for item in items {
        if item.size > 10 then return true
    }
    return false
}

fn named(items: &Vec<Item>): bool = {
    for item in items {
        if !item.name.isEmpty() then return false
    }
    return true
}

fn small(sizes: &[i64]): bool = {
    for size in sizes {
        if size > 3 then return false
    }
    return true
}

fn called(items: &[Item], name: str): Option<&Item> = {
    for item in items {
        if item.name == name then return &item
    }
    return .None
}

fn parsed(texts: &[str]): Result<bool, ParseError> = {
    for text in texts {
        if text.toInt()? > 3 then return true
    }
    return false
}

fn inSet(numbers: &Set<i64>): bool = {
    for n in numbers {
        if n > 3 then return true
    }
    return false
}

fn counted(numbers: &Vec<i64>): bool = {
    for n in numbers.copies() {
        if n > 2 then return true
    }
    return false
}

fn where(sizes: &[i64]): i64 = {
    for (i, size) in sizes.forwards().enumerate() {
        if size > 3 then return i
    }
    return -1
}

fn commented(sizes: &[i64]): bool = {
    for size in sizes {
        // Over three is large.
        if size > 3 then return true
    }
    return false
}

fn main() = {
    val items = [Item(name: String::of("a"), size: 12)]
    val all = Vec::of(own [Item(name: String(), size: 1)])
    assert(large(&items) && named(&all) && small([1]) && called(&items, "a").isSome())
    val numbers: Vec<i64> = [1, 3]
    assert(parsed(["5"]).unwrap() && counted(&numbers) && where([4]) == 0 && commented([4]))
    val set: Set<i64> = [1, 5]
    assert(inSet(&set))
}
