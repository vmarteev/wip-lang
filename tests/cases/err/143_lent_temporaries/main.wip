// What the lending rule will not do. A temporary is lent
// where it is used, so an `&` in front of one is a word that says nothing;
// a place still needs its `&`, since that is where a reader learns a call
// can see their value; and `&var` is written wherever it writes.

struct Card {
    rank: i64
}

fn rankOf(card: &Card): i64 = card.rank

fn bump(card: &var Card) = card.rank += 1

fn main() = {
    // Already lent: the `&` says nothing.
    destroy(rankOf(&Card(rank: 1)))
    destroy(rankOf(&rankOf(&Card(rank: 1))))

    // A place: the `&` is what says the call can see it.
    val card = Card(rank: 2)
    destroy(rankOf(card))

    // A write is written, wherever it goes.
    var mine = Card(rank: 3)
    bump(mine)
}
