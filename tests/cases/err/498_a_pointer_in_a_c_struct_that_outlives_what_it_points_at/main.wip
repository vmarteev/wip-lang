// A C struct that points at what its literal was given `&` of borrows it:
// used after that changed, or returned from the function it is a local
// of, it would point at what is not there.

extern "C" {
    struct Span {
        values: ptr<i32>
        count: i64
    }

    fn summed(span: &Span): i64
}

fn escaped(): Span = {
    val values: [i32; 2] = [1, 2]
    return Span(values: &values, count: 2)
}

fn main() = {
    var values: [i32; 2] = [1, 2]
    val span = Span(values: &values, count: 2)
    values[0] = 5
    summed(&span)
}
