// An implementation that holds only for some type arguments
// gives the operator nothing where the condition is unmet: `Option<T: Eq>`
// compares where `T` compares, and `Wrong` does not. Before this was
// checked, `==` was accepted here and the code generator asked for an
// `equals` no one had written.

enum Wrong {
    Empty
    BadDigit(at: i64)
}

struct Unordered {
    id: i64
}

fn answer(): Result<i64, Wrong> = .Ok(42)

fn compared(): bool = answer() == .Ok(42)

fn optional(): bool = {
    val here: Option<Wrong> = .None
    here == .None
}

fn ordered(): bool = {
    val a: Option<Unordered> = .None
    val b: Option<Unordered> = .None
    a < b
}

fn inVectors(): bool = Vec<Wrong>() == Vec<Wrong>()

fn main() = {}
