// What does not widen: two integer types neither of which holds the other
// beside each other (E0303), a signed value where an unsigned type is
// expected, an integer where a float is, a `u64` where a `usize` is, and
// an argument whose generic type an earlier one decided (E0301). A shift
// by a constant at least the value's width is refused (E0367). A sum and
// a shift worked out in a narrow type and widened are warned of (E0366),
// with the fix that widens an operand.

fn takesU64(n: u64): u64 = n

fn takesFloat(x: f64): f64 = x

fn same<T>(a: T, b: T): T = a

fn main() = {
    val a: i64 = 1
    val b: u64 = 2
    val c = a + b
    val s: i32 = -1
    takesU64(s)
    takesFloat(a)
    val address: usize = b
    val byte: u8 = 4
    same(byte, a)
    val shifted = byte << 8
    var word: u32 = 1
    word <<= 32
    val total: i64 = byte * 2
    val packed: u32 = byte << 4 | byte
}
