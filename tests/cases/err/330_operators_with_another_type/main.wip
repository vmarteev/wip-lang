// An operator with another type on one side, where it is refused. A built-in
// type implements another module's interface only where an argument is a type
// of this module (E0338); an implementation an operator between two built-in
// numbers would never call; `a /= b` where the implementation answers another
// type than `a`'s;
// an operator no implementation answers, told which block would; and a
// default that names a parameter after it (E0216).
//
// Expected output: the compile errors only.

import std::io

struct Vec2 {
    x: f32
    y: f32
}

struct Meters {
    n: f64
}

struct Speed {
    n: f64
}

extend Meters: Divide<f64, Speed> {
    fn divide(other: &f64): Speed = Speed(n: self.n / other)
}

extend f64: Multiply<f32> {
    fn multiply(other: &f32): f64 = self * (other as f64)
}

extend f32: Multiply<f32, Vec2> {
    fn multiply(other: &f32): Vec2 = Vec2(x: self * other, y: 0.0)
}

interface Scale<Out = By, By = f32> {
    fn scale(by: &By): Out
}

fn main() = {
    var m = Meters(n: 10.0)
    m /= 2.0
    val v = Vec2(x: 1.0, y: 2.0)
    val w = v * 2.0
    val u = 2.0 * v
    io::println("\(w.x) \(u.x)")
}
