// A name an `is` test binds inside `||` in a guard reaches nothing after
// the parentheses, as in an `if`'s condition: the arm cannot read it,
// since on the other side of the `||` nothing bound it.

fn read(value: Option<Option<i64>>, flag: bool): i64 = match value {
    .Some(inner) if (inner is .Some(x) && x > 0) || flag => x
    _ => 0
}

fn main() = {}
