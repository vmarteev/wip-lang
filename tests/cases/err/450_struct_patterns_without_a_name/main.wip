// A struct is taken apart in parentheses, without its name, by its fields'
// names. Refused: the name written (E0452, with the fix that drops it); a
// name that is not a field, with the fields listed; a field left out
// without `..`; a name, `..` or an element too few in a tuple's pattern,
// which goes by position; and parentheses around what is neither a tuple
// nor a struct.

struct Point {
    x: i64
    y: i64
}

fn main() = {
    val here = Point(x: 1, y: 2)
    val Point(x, y) = here
    val (a, b) = here
    val (x: across) = here
    val (first: one, second) = (1, 2)
    val (s, ..) = (1, 2)
    val (t,) = (1, 2)
    val (n) = 5
}
