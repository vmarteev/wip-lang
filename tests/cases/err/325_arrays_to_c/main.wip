// What C may be lent an array of (E0314): elements C can
// hold, and the array by reference, as C cannot take one by value; and
// `usize`, which stays Wip's own, with C's names for it in the help.

extern "C" {
    fn names(list: &[String; 2]): c_int
    fn byValue(bytes: [u8; 4]): c_int
    fn length(text: cstring): usize
}

fn main() = {}
