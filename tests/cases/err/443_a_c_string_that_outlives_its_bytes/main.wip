// A C string made from a `String` points into its bytes: it may not be kept
// past a temporary `String`, used after the `String` changed, returned or
// given to the caller borrowing a local, or held in a value that leaves
// where its `String` ends.

extern "C" {
	fn strlen(s: cstring): size_t
}

struct Request {
	name: cstring
}

fn kept(name: str): size_t = {
	val c = String::of(name).toCstring()
	return strlen(c)
}

fn changed(): size_t = {
	var s = String::of("hi")
	val c = s.toCstring()
	s.push(" there")
	return strlen(c)
}

fn madeAgain(): size_t = {
	var s = String::of("hi")
	val first = s.toCstring()
	val second = s.toCstring()
	return strlen(first) + strlen(second)
}

fn returned(text: str): cstring = {
	var owned = String::of(text)
	return owned.toCstring()
}

fn given(request: &var Request, text: str) = {
	var owned = String::of(text)
	request.name = owned.toCstring()
}

fn held(text: str): Request = {
	var owned = String::of(text)
	return Request(name: owned.toCstring())
}

fn main() = {
	var request = Request(name: "x")
	given(&var request, "y")
	strlen(returned("z"))
	strlen(held("w").name)
	kept("v")
	changed()
	madeAgain()
}
