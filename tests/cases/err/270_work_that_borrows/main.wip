// What threads that borrow may not do: write what another
// reads or writes, in one `both`; write what `each`'s closure, which
// every thread shares, captured; and use an `Atomic` after giving it away,
// since a copy would be a read that is not one step, so it is only moved.

import std::future
import std::sync::{Atomic}

fn main() = {
	var count = 0
	var other = 0
	future::both(() => { count += 1 }, () => count)
	future::both(() => { count += 1 }, () => { count += 2 })
	future::both(() => { count += 1 }, () => { other += 1 })
	val flag = Atomic::of(false)
	val given = flag
	val still = flag.load()
}
