// What threads that borrow may not do: write what another
// reads or writes, in one `together`; write what `each`'s closure, which
// every thread shares, captured; and copy an `Atomic`, since a copy is a
// read that is not one step.

import std::future
import std::sync::{Atomic}

fn main() = {
	var count = 0
	var other = 0
	future::together(() => { count += 1 }, () => count)
	future::together(() => { count += 1 }, () => { count += 2 })
	future::together(() => { count += 1 }, () => { other += 1 })
	val flag = Atomic::of(false)
	val copied = flag
}
