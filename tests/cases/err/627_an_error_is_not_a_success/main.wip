// A value where a `Result` is expected is its `.Ok` only where it is of the
// success's type: one of the error's type is refused, with the fix that
// says `.Err`; and a value of neither type, or an `i64` where an
// `Option<Option<i64>>` is, is refused as before, since a value is wrapped
// once.

enum Problem {
    Empty
    TooLong
}

fn parse(text: str): Result<i64, Problem> = {
    if text.isEmpty() then return Problem::Empty
    return 1
}

fn deeper(): Option<Option<i64>> = 5

fn main() = {
    val flag: Option<i64> = true
    val n = parse("1")
    val d = deeper()
}
