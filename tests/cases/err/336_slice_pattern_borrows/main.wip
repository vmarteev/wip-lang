// A slice pattern's bindings refer to the elements: the
// place is not written while they do, and nothing is moved out of a
// slice, which is only lent.

fn take(s: String): i64 = s.len()

fn changed(): i64 = {
    var grid = [1, 2, 3]
    match grid {
        [first, ..rest] => {
            grid[0] = 5
            return rest[0]
        }
    }
}

fn moved(v: &Vec<String>): i64 = match v.items() {
    [a, ..] => take(move a)
    _ => 0
}

fn main() = {}
