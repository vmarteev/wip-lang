// What `become` cannot do (E0421, E0460, E0461): call what is not a
// function by its name, or one that has no call to give the frame to; call a
// function whose parameters or result are not the caller's; give a struct
// made in the frame, or a reference into it; be written in a lambda or in
// an `@inline` function.

struct Point {
    x: i64
    y: i64
}

fn other(n: i64, m: i64): i64 = n + m

fn closure(f: &(n: i64) => i64, n: i64): i64 = {
    become f(n)
}

fn signature(n: i64): i64 = {
    become other(n, 1)
}

fn takesPoint(p: Point): i64 = p.x

fn made(p: Point): i64 = {
    become takesPoint(Point(x: p.x, y: 1))
}

fn takesRef(r: &i64): i64 = r

fn local(r: &i64): i64 = {
    val n = 5
    become takesRef(&n)
}

fn counted(n: i64): i64 = n

fn inLambda(n: i64): i64 = {
    val f = (k: i64) => {
        become counted(k)
    }
    return f(n)
}

@inline
fn spliced(n: i64): i64 = {
    become counted(n)
}

@inline
fn small(n: i64): i64 = n

fn ofInline(n: i64): i64 = {
    become small(n)
}

fn main() = {}
