// `pub` exports the reading of a field and `pub var` its writing.
// A counter that promises its count never goes down
// exports the count and keeps the writing.

pub struct Counter {
    /// Read by anyone, written here: that is the promise.
    pub n: i64
    /// Anyone's to change.
    pub var limit: i64
    /// Nobody else's business at all.
    steps: i64
}

extend Counter {
    pub static fn upTo(limit: i64): Counter = Counter(n: 0, limit: limit, steps: 0)

    pub var fn step() = {
        self.steps += 1
        if self.n < self.limit {
            self.n += 1
        }
    }

    pub fn stepsTaken(): i64 = self.steps
}
