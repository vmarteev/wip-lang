// Building a value writes every field, so `..base` takes only the fields
// the literal's module may write: a read-only field or a private one of
// another module's struct is not taken, and the literal is refused as one
// that leaves it out (E0210).

import counter::{Counter}

fn main() = {
    val c = Counter::upTo(5)
    val d = Counter(limit: 9, ..c)
}
