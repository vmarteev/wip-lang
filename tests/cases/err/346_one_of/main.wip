// `@oneOf` (E0341, E0420): a type that writes neither of
// `Text`'s, or of an interface's own; `@oneOf` naming a method the
// interface lacks, one without a default, one twice, a single method, a
// string, and written on a struct.

struct Silent {
    n: i64
}

extend Silent: Text {}

@oneOf(first, second)
interface Pair {
    fn first(): i64 = self.second()
    fn second(): i64 = self.first()
}

extend Silent: Pair {}

@oneOf(first, missing, third, first)
@oneOf(first)
@oneOf(first, "second")
interface Broken {
    fn first(): i64 = 1
    fn third(): i64
}

@oneOf(a, b)
struct NotAnInterface {
    a: i64
}

fn main() = {}
