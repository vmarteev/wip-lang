// What an owned `dyn` cannot be made of: a view, whose borrow it would
// keep where nothing says what it is; a type parameter, which an instance
// may make a view; and a type that does not implement the interface.

interface Shape {
    fn area(): i64
}

view struct Label {
    text: str
}

extend Label: Shape {
    fn area(): i64 = self.text.len()
}

struct Point {
    x: i64
}

fn boxed<T: Shape>(value: T): own<dyn Shape> = own value

fn main() = {
    val text = "abc"
    val label: own<dyn Shape> = own Label(text:)
    val point: own<dyn Shape> = own Point(x: 1)
}
