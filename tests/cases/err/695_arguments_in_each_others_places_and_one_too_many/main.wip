// A call whose arguments are the parameters' names in each other's places,
// with one more than the function takes: it is refused for the one too
// many, and the warning of the two swapped names only those that have a
// parameter, with none past the last.

fn draw(width: i64, height: i64) = {}

fn main() = {
	val width = 1
	val height = 2
	draw(height, width, 3)
}
