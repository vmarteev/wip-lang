// `forwards().enumerate()` on a slice, an array or a `Vec` is a warning
// (E0482), with the fix that writes the list's `indexed()`, the same walk.
// Left alone: `backwards().enumerate()`, which counts from the last
// element, `copies().enumerate()`, which copies, an iterator's
// `enumerate()`, and a `forwards()` of a type of the program's own.

import std::io
import std::iter::{Forwards}

struct Shelf {
    books: Vec<String>
}

extend Shelf {
    fn forwards(): Forwards<String> = self.books.forwards()
}

fn main() = {
    val names: Vec<String> = ["ann", "bo"]
    for (i, name) in names.forwards().enumerate() do
        io::println("\(i) \(name)")

    val sizes = [3, 4]
    val lent: &[i64] = &sizes
    for (i, size) in sizes.forwards().enumerate() do
        io::println("\(i) \(size)")

    val counted = lent.forwards().enumerate().count()
    for (i, name) in names.backwards().enumerate() do
        io::println("\(i) \(name)")

    for (i, size) in sizes.copies().enumerate() do
        io::println("\(i) \(size)")

    for (i, n) in (0..2).enumerate() do
        io::println("\(i) \(n)")

    val shelf = Shelf(books: ["a"])
    for (i, book) in shelf.forwards().enumerate() do
        io::println("\(i) \(book) \(counted)")
}
