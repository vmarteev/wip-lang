// A `str` is used after what it borrows changed (E0436), or would outlive
// what it borrows (E0437).

import std::io

fn dangling(): str = {
    var owned = String()
    owned.push("hello")
    owned.toStr()
}

fn early(): str = {
    val owned = String::of("hello")
    return owned.toStr()
}

fn byValue(text: String): str = text.toStr()

fn set(out: &var str) = {
    val o = String::of("hi")
    out = o.toStr()
}

fn cleared() = {
    var owned = String::of("hello world")
    val s = owned.toStr()
    owned.clear()
    io::println(s)
}

fn reassigned() = {
    var owned = String::of("hello world")
    val s = owned.toStr()
    owned = String()
    io::println(s)
}

fn moved() = {
    val owned = String::of("x")
    val s = owned.toStr()
    val other = move owned
    io::println(s)
}

fn temporary() = {
    val s = String::of("x").toStr()
    io::println(s)
}

fn inner() = {
    val s = {
        val o = String::of("x")
        o.toStr()
    }
    io::println(s)
}

fn outer() = {
    var s = ""
    {
        val o = String::of("x")
        s = o.toStr()
    }
    io::println(s)
}

fn sameCall() = {
    var owned = String::of("x")
    val s = owned.toStr()
    owned.push(s)
}

fn looped() = {
    var owned = String::of("x")
    var s = ""
    var i = 0
    while i < 3 {
        io::println(s)
        s = owned.toStr()
        owned.clear()
        i += 1
    }
}

fn element() = {
    var owned = String::of("x")
    var words = ["one", "two"]
    words[0] = owned.toStr()
    owned.clear()
    io::println(words[1])
}

fn walked() = {
    var owned = String::of("x")
    val words = [owned.toStr(), "b"]
    for w in words {
        owned.clear()
        io::println(w)
    }
}

fn main() = {}
