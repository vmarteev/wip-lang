// `own` of a function value is refused, as `&` of one is: it would have an
// owned closure's type, which is a pair, and a function value is code
// alone. A function's name goes where an owned closure is taken as it is.

struct Holder {
    measure: own<(x: i64) => i64>
}

fn double(x: i64): i64 = x * 2

fn main() = {
    val named = Holder(measure: double)
    val boxed = Holder(measure: own double)
    val held = (x: i64) => x + 1
    val kept: own<(x: i64) => i64> = own held
}
