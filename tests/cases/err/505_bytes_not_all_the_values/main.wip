// `c::bytesOf` takes a value whose bytes are all its value's (E0459): not
// one with padding between fields or after the last, nor an enum whose
// variants hold values, nor what holds an address; and where a generic
// function asks, it is said where that function was made for the type.

import std::c

struct Gap {
    tag: u8
    value: u32
}

struct Tail {
    value: u32
    tag: u8
}

view struct Named {
    name: str
}

enum Shape {
    Dot
    Circle(radius: f32)
}

struct Later {
    small: u16
    big: u64
}

fn byteCount<T: copy>(value: &T): i64 = c::bytesOf(&value).len()

fn main() = {
    val gap = Gap(tag: 1, value: 2)
    c::bytesOf(&gap)
    val tail = Tail(value: 1, tag: 2)
    c::bytesOf(&tail)
    val named = Named(name: "a")
    c::bytesOf(&named)
    val shape = Shape::Dot
    c::bytesOf(&shape)
    val later = Later(small: 1, big: 2)
    byteCount(&later)
}
