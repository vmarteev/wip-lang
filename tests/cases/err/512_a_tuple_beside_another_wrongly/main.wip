// In an array of tuples, a position takes the type of the first part
// there that says its own, and only a literal moves (E0301): a float
// literal beside an integer is refused, and so is a value of another type
// than the first said.

fn main() = {
    val n: i64 = 3
    val y: f32 = 1.0
    val floats = [(1.0, y), (n, y)]
    val a: f32 = 0.5
    val b: f64 = 1.5
    val mixed = [(a, 1), (b, 2)]
}
