// What a function declares and never uses is a warning, each with its fix:
// a `var` nothing writes is a `val` (E0470), and so is a `var` pattern none
// of whose names is written; a local nothing reads (E0471) is removed where
// what it is given only reads; a binding (E0472) and a parameter (E0473),
// of a function and of a lambda, are `_`, and a field taken apart by its
// name is `name: _`. Nothing is said of a local that owns memory, which
// being bound keeps to the end of its block; of a `var` written through a
// binding of it, or one of a pattern another of whose names is written; of
// `self`; of a `pub` function's parameters, an interface method's, an
// implicit, or one a call gives by name; or of a lambda's captures.

struct Point {
    x: i64
    y: i64
}

interface Shape {
    fn area(scale: i64): i64
}

extend Point: Shape {
    fn area(scale: i64): i64 = self.x * self.y
}

extend Point {
    fn one(): i64 = 1
}

fn total(a: i64, unread: i64): i64 = a

fn named(a: i64, given: i64): i64 = a

pub fn exported(a: i64, unused: i64): i64 = a

fn placed(implicit at: Location): i64 = 0

fn locals(point: &Point): i64 = {
    val kept = 1
    val unread = 2
    val computed = total(1, 2)
    val text = String::of("kept to the end of the block")
    var never = 3
    var changed = 4
    changed += 1
    var maybe: Option<Point> = Point(x: 1, y: 2)
    if maybe is .Some(p) then p.x = 5
    var .Some(seen) = maybe else return 0
    var (written, read) = (1, 2)
    written += read
    val (x, y) = point
    var sum = 0
    for (i, n) in [1, 2].copies().enumerate() {
        sum += n
    }
    val doubled = [1, 2].copies().map((n) => kept * 2).count()
    return kept + never + changed + seen.x + written + x + sum + doubled
}

fn main() = {
    val point = Point(x: 1, y: 2)
    assert(locals(&point) > 0)
    assert(total(1, 2) + named(1, given: 2) + exported(1, 2) + placed() + point.area(1) + point.one() > 0)
}
