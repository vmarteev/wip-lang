// What a loop over a range of elements borrows: the
// container, for as long as the loop runs, as a loop over the whole does.
// It cannot be pushed to, and no element of it written, until the loop
// ends.

fn pushWhileWalking() = {
    var v: Vec<i64> = Vec()
    v.push(1)
    v.push(2)
    for x in v.items()[0..2] {
        v.push(x)
    }
}

fn writeWhileWalking() = {
    var a = [1, 2, 3, 4]
    for x in a[0..2] {
        a[3] = x
    }
}

fn main() = {}
