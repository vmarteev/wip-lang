// Errors with named arguments, defaults and named variant fields:
// an unknown name (E0328), a parameter given twice (E0329),
// missing and extra arguments (E0302), a name through a function value
// (E0332), defaults that cannot be (E0330), and a variant built by position
// (E0331).

extern "C" {
    fn c_print(x: i64 = 1)
}

enum Shape {
    Rect(width: i64, height: i64)
    Circle(radius: i64)
}

fn area(width: i64, height: i64): i64 = width * height

fn first<T>(x: T = 1): T = move x

fn borrow(x: &i64 = 3) = {}

fn open(path: str, buffer: i64 = 4096): i64 = buffer

fn main(): i64 = {
    val a = area(widht: 1, height: 2)
    val b = area(1, width: 2)
    val c = area(height: 2)
    val d = open(buffer: 1)
    val e = open("x", 1, 2)
    val f = area
    val g = f(width: 1, height: 2)
    val h = Shape::Rect(3, 4)
    val w = 3
    val i = Shape::Rect(w, height: 4)
    val j = Shape::Circle(size: 2)
    0
}
