// What a type's function is a value, and what is not: one of several
// implementations the expected type does not choose, one a type parameter's
// constraint answers, one the compiler writes where it is called, an
// `@inline` one and a projection, each refused with what to write; and
// `x.name`, which would hold `x`, its help naming the type's function.

struct Meters {
	value: i64
}

extend Meters: From<i64> {
	static fn from(value: i64): Meters = Meters(value: value)
}

extend Meters: From<bool> {
	static fn from(value: bool): Meters = Meters(value: if value then 1 else 0)
}

interface Unit {
	static fn unit(): Self
}

struct Grid {
	cells: [i64; 4]

	lend fn cell(at: i64): &i64 = lend self.cells[at]

	@inline
	fn first(): i64 = self.cells[0]

	fn total(): i64 = self.cells[0] + self.cells[1]
}

extend Grid: Unit {
	static fn unit(): Grid = Grid(cells: [1, 1, 1, 1])
}

fn unitOf<T: Unit>(): T = {
	val make = T::unit
	return T::unit()
}

fn main() = {
	val which = Meters::from
	val length = str::len
	val lent = Grid::cell
	val inlined = Grid::first
	val grid = unitOf<Grid>()
	val bound = grid.total
}
