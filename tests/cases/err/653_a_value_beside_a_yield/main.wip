// `yield` is a branch but never a value: a branch that is a value beside
// one that yields is refused, in an `if`, a chain of them, a `match` and a
// `when`, since the statement would drop it; and a `yield` where a value
// is taken, or with no list or generator to hand its value to, is refused
// as before.

fn inIf(xs: &[i64]) = {
    val ys = [for x in xs { if x > 1 then yield x else 0 }]
}

fn inChain(xs: &[i64]) = {
    val ys = [for x in xs { if x > 1 then yield x else if x < 0 then x * 2 else yield 0 }]
}

fn inMatch(xs: &[Option<i64>]): Iterator<i64> = for x in xs {
    match x {
        .Some(v) => yield v
        .None => 0
    }
}

fn inWhen(xs: &[i64]) = {
    val ys = [for x in xs {
        when {
            x > 1 => yield x
            else => 0
        }
    }]
}

fn asValue(xs: &[i64]) = {
    val ys = [for x in xs { val y = yield x }]
}

fn outside(c: bool) = {
    if c then yield 1
}

fn main() = {}
