// How a method is written: `fn`, `var fn`, `move fn` or
// `static fn`. `pub` stands on a method or a field, and a
// variant is exported with its enum, so it takes none.

struct Counter {
    count: i64
    pub limit: i64              // a field may be exported

    var missing(): i64 = 0      // `var` without `fn`
    move gone(): i64 = 0        // `move` without `fn`
    fn get(): i64 = self.count
}

enum Step {
    pub First                   // `pub` belongs on a field or a method
    Second
}

fn main() = {}
