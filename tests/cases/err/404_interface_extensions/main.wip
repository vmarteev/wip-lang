// What an extension of an interface is refused for (E0362): an interface
// of another module, the prelude's `Iterator` among them; no condition;
// `copy` as one; implementing an interface; a method the interface or
// another extension has already; a `static fn`. A call of an extension
// whose condition is not met says which type lacks what, on a concrete
// type and through a constraint that does not promise it (E0337). An
// implementation that writes an extension's method writes no method of the
// interface (E0341). And a method two interfaces give a type is not chosen
// between at the call (E0363).

interface Source<T> {
    var fn take(): Option<T>
    fn label(): i64 = 1
}

extend Source<T: Add + Zero> {
    var fn total(): T = {
        var sum = T::zero()
        while self.take() is .Some(x) {
            sum = sum + x
        }
        return move sum
    }

    fn label(): i64 = 2

    static fn made(): i64 = 0
}

extend Source<T: Ord> {
    fn total(): i64 = 0
}

extend Source<T> {
    fn plain(): i64 = 3
}

extend Source<T: copy> {
    fn copied(): i64 = 4
}

extend Source<T: Ord>: Text {
    fn appendTo(out: &var String) = {}
}

extend Iterator<T: Text> {
    move fn joined(): String = String()
}

interface Named {
    fn label(): i64 = 4
}

struct Letters {
    left: i64
}

extend Letters: Source<char> {
    var fn take(): Option<char> = .None
}

extend Letters: Named {}

struct Writer {
    left: i64
}

extend Writer: Source<i64> {
    var fn take(): Option<i64> = .None

    var fn total(): i64 = 0
}

fn through<S: Source<T>, T>(source: &var S): T = source.total()

fn main() = {
    var letters = Letters(0)
    val total = letters.total()
    val label = letters.label()
}
