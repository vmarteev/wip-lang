// What a closure captures, it captures by reference, so it reads the value
// but never takes it. The move checker sees the capture
// under the name the lambda wrote.

import std::io

struct Bag {
    id: i64
}

fn apply(f: &(x: i64) => i64, n: i64): i64 = f(n)

fn takesCapture(): i64 = {
    val bag = own Bag(id: 1)
    apply((x) => {
        val taken = move bag        // the closure only borrowed it
        taken.id + x
    }, 2)
}

fn usesMoved(): i64 = {
    val bag = own Bag(id: 1)
    val gone = move bag
    apply((x) => bag.id + x, 2)     // captured after it was moved out
}

fn main() = {
    io::printInt(takesCapture())
}

