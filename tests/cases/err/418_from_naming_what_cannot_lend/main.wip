// `from` names a parameter that is a `str`, a reference or a view,
// `self`, or a `&` or view field reached from one: not a name that is no
// parameter, one of a type that borrows nothing, nor a field the view
// holds as its own (E0364).

struct Ast {
	names: Vec<String>
}

view struct Lowerer {
	ast: &Ast
	errors: Vec<String>
	count: i64
}

extend Lowerer {
	fn notAParam(): str from other = "x"

	fn counted(): str from self.count = "x"

	fn heldOwn(): str from self.errors = "x"

	fn noField(): str from self.tables = "x"
}

fn number(n: i64, text: str): str from n = text

fn main() = {}
