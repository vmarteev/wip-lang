// An integer literal is a float only where the float holds its value
// exactly: past 2 to the 24 an `f32`, and past 2 to the 53 an `f64`, holds
// only some whole numbers, and one it would round is refused, negative or
// not. An integer constant is not a literal, and stays an integer; nor does
// a literal's local that kept its own type become a float later.

import std::io

val SIZE = 16

fn main() = {
    val big: f32 = 16_777_217
    val below: f32 = -16_777_217
    val wide: f64 = 9_007_199_254_740_993
    val sized: f32 = SIZE
    val n = 2
    io::println("\(n)")
    val w: f32 = n
}
