// `String::of(text)` of a `str`, where a `String` was expected before the
// call was checked, is a warning (E0483), with the fix that writes the
// text alone, which is copied into a `String` there as the call copied
// it: in a field, an argument, a branch, an arm, an element of a list, a
// value pushed, and inside a `.Some`, whose wrapper is then kept. Left
// alone: a `val` with no type, which the call makes a `String`; a
// receiver; a `String` copied, which the name alone would move;
// `String::of` as a value; and a local whose first use says the rest of
// its type.

import std::io

struct App {
    id: String
}

enum Kind {
    Sum
    Product
}

fn word(kind: Kind): String = match kind {
    .Sum => String::of("sum")
    .Product => String::of("product")
}

fn pick(either: bool, text: str): String = if either then String::of(text) else String::of("none")

fn told(it: Result<String, String>): bool = it.isOk()

fn main() = {
    val line: str = "ab"
    val app = App(id: String::of("com.example.game"))
    var names: Vec<String> = Vec()
    names.push(String::of(line))
    val files: Vec<String> = [String::of("a.wip"), String::of("b.wip")]
    val maybe: Option<String> = .Some(String::of(line))
    val name = String::of(line)
    val padded = String::of(" ").repeat(2)
    val owned = String::of("x")
    val copied: String = String::of(owned)
    val make: (text: str) => String = String::of
    val waiting = Result::Ok(String::of("y"))
    io::println("\(app.id) \(names[0]) \(files[1]) \(maybe.unwrap()) \(name)\(padded)\(owned)\(copied) \(make("q"))")
    io::println("\(word(.Sum)) \(pick(false, line)) \(told(waiting))")
}
