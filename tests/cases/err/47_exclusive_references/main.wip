// Exclusive `&var` (E0413, E0414, E0415). A `&var` argument is
// the only reference to its place during the call; different fields of a
// struct are different places, but elements of one array are not told apart.
// A later argument cannot move or assign what an earlier one borrowed. A
// `&var` parameter that is moved out of must hold a value again at every
// exit.

struct Pair {
    a: i64
    b: i64
}

struct Box {
    value: i64
}

fn swap(a: &var i64, b: &var i64) = {
    val t = a
    a = b
    b = t
}

fn peek(p: &Pair, v: &var i64) = {}

fn keep(b: &Box, c: own<Box>) = {}

fn store(b: &var own<Box>, value: i64) = {}

fn take(b: own<Box>): i64 = b.value

fn drain(b: &var own<Box>): i64 = take(move b)

fn drainSometimes(b: &var own<Box>, flag: bool): i64 = {
    if flag {
        return take(move b)
    }
    0
}

fn main(): i64 = {
    var x = 1
    swap(&var x, &var x)
    var p = Pair(a: 1, b: 2)
    peek(&p, &var p.a)
    swap(&var p.a, &var p.b)
    var xs = [1, 2]
    swap(&var xs[0], &var xs[1])
    val b = own Box(value: 1)
    keep(&b, move b)
    var c = own Box(value: 2)
    store(&var c, { c = own Box(value: 3); 0 })
    0
}
