// `..value` takes the rest of a literal's fields from a value of the
// literal's type, and a value of another type is refused. Naming every
// field and then writing one is a warning: the `..` has nothing to do.

struct Window {
    width: i64
    height: i64
}

struct Other {
    width: i64
}

fn main() = {
    val wrong = Window(width: 3, ..Other(width: 9))

    val w = Window(width: 1, height: 2)
    val pointless = Window(width: 1, height: 2, ..w)
}
