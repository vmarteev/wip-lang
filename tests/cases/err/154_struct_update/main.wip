// `..value` takes the rest of a literal's fields from a value that is
// there, and copies them. So the value must be a place —
// a variable, a field, an element — and each field it gives must be one
// that copies. Naming every field and then writing one is a warning: the
// `..` has nothing to do.

import std::io

struct Window {
    width: i64
    height: i64
}

struct Other {
    width: i64
}

struct Owning {
    name: String
    size: i64
}

fn make(): Window = Window(width: 1, height: 2)

fn main() = {
    val built = Window(width: 3, ..make())
    val wrong = Window(width: 3, ..Other(width: 9))

    val one = Owning(name: String::of("a"), size: 1)
    val two = Owning(size: 2, ..one)

    val w = Window(width: 1, height: 2)
    val pointless = Window(width: 1, height: 2, ..w)
}
