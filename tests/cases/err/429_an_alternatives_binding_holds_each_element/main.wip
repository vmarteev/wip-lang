// A binding of an arm's alternatives on a tuple matched in place may refer
// to either element: `n` is `left`'s in one alternative and `right`'s in
// the other, so both stay borrowed until the arm ends, and writing `right`
// while `n` is in use is refused, whichever alternative matched.

import std::io

fn main() = {
	var left: Option<String> = .Some(String::of("l"))
	var right: Option<String> = .None
	match (left, right) {
		(.Some(n), _) | (_, .Some(n)) => {
			right = .None
			io::println(n.toStr())
		}
		_ => {}
	}
}
