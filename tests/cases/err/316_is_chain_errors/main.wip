// What an `is` test binds is seen by the rest of its `&&` chain and no
// further: a test with nothing after it in its chain binds a
// name nothing can use (E0333), and a name used past the chain is not in
// scope (E0203).

fn main() = {
    val slot: Option<i64> = .Some(1)
    val last = slot.isSome() && slot is .Some(y)
    val either = slot is .None || slot is .Some(z)
    val ok = slot is .Some(v) && v > 0
    val after = v
}
