// A literal where a `Url` is expected is a URL, checked while the program
// is compiled: a hole in the scheme or inside a `%` and its digits, a
// `Url` joined anywhere but the start, and text that is not a URL — a
// scheme, a port, an escape, an IPv6 address's brackets, a space — are each
// an error where they are written.

import std::url::{Url}

fn main() = {
	val scheme = "http"
	val base: Url = "https://example.com"
	val id = 7
	val inScheme: Url = "\(scheme)://example.com/"
	val inEscape: Url = "/a%2\(id)"
	val joinedLate: Url = "/v1\(base)"
	val badScheme: Url = "ht_tp://example.com/"
	val badPort: Url = "http://example.com:80a/"
	val badEscape: Url = "/a%zz"
	val unclosed: Url = "http://[::1/"
	val spaced: Url = "/users/\(id)/my posts"
	// Not refused: a value in the host, the port, the path, the query and
	// the fragment, and a `Url` the rest goes on from.
	val fine: Url = "\(base)/users/\(id)?tab=\(scheme)#\(id)"
	val parts: Url = "http://\(scheme):\(id)/"
}
