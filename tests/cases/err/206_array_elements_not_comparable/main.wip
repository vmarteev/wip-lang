// An array compares where its elements do: one of a type
// that is neither `Eq` nor `Ord` is reported with the element that is in
// the way.

struct File {
    fd: i64
}

fn main() = {
    val a = [File(fd: 1), File(fd: 2)]
    val b = [File(fd: 1), File(fd: 2)]
    val same = a == b
    val first = a < b
}
