// A type answers an operator by implementing its interface,
// and a report says which block would do it. The
// wrapping forms are the machine's, for its integers, so a type never
// answers them; and a type does not meet a number halfway — `From`
// is how a number becomes one.

struct Meters {
    value: i64
}

extend Meters: Add {
    fn add(other: &Meters): Meters = Meters(value: self.value + other.value)
}

fn main() = {
    val a = Meters(value: 1)
    val sum = a + a

    val difference = a - a
    val negated = -a
    val turned = !a
    val wrapped = a +% a
}
