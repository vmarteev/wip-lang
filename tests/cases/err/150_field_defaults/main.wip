// A field's default is a value of the field's type, as a parameter's is:
// `0` is no `T`. A union holds one field at a time, so a default there would
// say nothing; and a field without a default is still missing when a literal
// leaves it out.

struct Holder<T> {
    value: T = 0
}

extern union Either {
    n: c_int = 0
}

struct Missing {
    a: i64 = 0
    b: i64
}

fn main() = {
    val m = Missing()
}
