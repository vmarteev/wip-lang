// Moves (E0404): after one field is given away, the struct cannot be used as
// a whole. The error points at where the field was given.

struct Engine {
    power: i64
}

struct Car {
    engine: own<Engine>
    seats: i64
}

fn scrap(e: own<Engine>) = {}

fn park(c: Car) = {}

fn main(): i64 = {
    val car = Car(engine: own Engine(power: 150), seats: 4)
    scrap(car.engine)
    park(car)
    return 0
}
