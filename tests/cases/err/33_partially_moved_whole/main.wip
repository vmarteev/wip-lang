// Moves (E0401): after one field is moved out, the struct cannot be used as a
// whole. The error points at the field's move.

struct Engine {
    power: i64
}

struct Car {
    engine: own<Engine>
    seats: i64
}

fn scrap(e: own<Engine>) = {}

fn park(c: Car) = {}

fn main(): i64 = {
    val car = Car(engine: own Engine(power: 150), seats: 4)
    scrap(move car.engine)
    park(move car)
    return 0
}
