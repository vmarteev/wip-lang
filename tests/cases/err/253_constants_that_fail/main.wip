// A constant whose code cannot finish while the program is compiled:
// one that panics, reported with the calls that led to
// it (E0441); one that calls into C, here by printing (E0442); and one
// that needs another that failed, which says nothing more. One that runs
// past its budget (E0443) is the MIR's own test, with a budget small
// enough to reach quickly.

import std::io

@comptime
val BROKEN: i64 = divide(10, 0)
@comptime
val LOUD: i64 = shout()
@comptime
val AFTER_BROKEN: i64 = BROKEN + 1

fn divide(a: i64, b: i64): i64 = a / b

fn shout(): i64 = {
    io::println("hi")
    return 1
}

fn main() = {
    io::printInt(AFTER_BROKEN)
}
