// What an `extern struct` may hold, and how it may cross. Its fields are the
// types C writes — another `extern struct` among them, but not a Wip one, and
// nothing that owns memory. It has no type parameters, since C has none. And it
// crosses behind a reference:
// by value it waits for the shims of item 7.

struct Plain {
    x: i64
}

extern struct Holds {
    fine: c_int,
    alsoFine: ptr<u8>,
    andThis: [c_int; 4],
    owned: Vec<i64>,
    wip: Plain
}

extern struct Generic<T> {
    value: T
}

extern struct Point {
    x: c_int,
    y: c_int
}

extern "C" {
    fn byValue(p: Point): c_int
}

fn main() = {}
