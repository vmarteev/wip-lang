// A method a type does not have, and no typo of one (E0337): a type of a
// few methods names them all; a type of many names those named like the
// one asked, or how many it has where none is; and what the language
// calls in a program's place — `destroy`, a map's hash, a format's — is
// never offered.

struct Point {
    x: i64
}

extend Point {
    fn norm(): i64 = self.x
    fn scaled(by: i64): Point = Point(x: self.x * by)
}

fn main() = {
    val p = Point(x: 1)
    val n = p.normalise()
    val events = Vec::of([1, 2, 3])
    val a = events.length()
    val b = events.pushBack(4)
    val c = events.sizeOf()
    val d = events.hashOf()
    val e = events.destroyAll()
}
