// What taking a struct apart will not do. A struct pattern
// names fields the struct has and names each of them once; it always
// matches, so an `else` beside it cannot run and an `is` test of it is not
// a test; a range counts with numbers, which have nothing to take apart;
// and a name with no struct behind it is a variant missing its enum.

struct Point {
    x: i64
    y: i64
}

enum Shape {
    Round(radius: i64)
    Flat
}

fn corners(p: &Point): i64 = {
    val Point(x) = p
    return x
}

fn twice(p: &Point): i64 = {
    val Point(x, x: again) = p
    return x + again
}

fn named(p: &Point): i64 = {
    val Point(z, ..) = p
    return z
}

fn cannotFail(p: &Point): i64 = {
    val Point(x, y) = p else {
        return 0
    }
    return x + y
}

fn notATest(p: &Point): bool = p is Point(x, y)

fn counting() = {
    for Point(x, y) in 0..3 {}
}

fn noSuchStruct(s: &Shape): i64 = match s {
    Round(radius) => radius
    .Flat => 0
}

fn main() = {}
