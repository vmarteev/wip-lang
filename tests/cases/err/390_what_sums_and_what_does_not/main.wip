// A slice sums where its elements add and have a zero, and multiplies where
// they multiply and have a one: text does neither, and a type that adds
// without a zero has no sum.

struct Money {
	cents: i64
}

extend Money: Add {
	fn add(other: &Money): Money = Money(cents: self.cents + other.cents)
}

fn main() = {
	val words = ["a", "b"]
	val joined = words.sum()
	val prices = [Money(cents: 1), Money(cents: 2)]
	val spent = prices.sum()
	val scaled = prices.product()
}
