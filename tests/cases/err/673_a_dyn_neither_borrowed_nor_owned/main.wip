// A `dyn` is only behind `&`, `&var` or `own`: a bare one is refused
// wherever a type is written, in a field, a parameter, a function type's
// parts and an array's or a slice's elements, and the error points at the
// `dyn`. Where it is the whole type, the fix borrows it; as an element,
// it owns it. `Vec<own<dyn Shape>>` and `Vec<&dyn Shape>` are allowed.

interface Shape {
    fn area(): i64
}

struct Scene {
    shape: dyn Shape                        // in a field
    pick: (shape: dyn Shape) => i64         // a function type's parameter
    make: () => dyn Shape                   // and its result
    many: [dyn Shape; 2]                    // an array's elements
    lent: &[dyn Shape]                      // a slice's
    shapes: Vec<own<dyn Shape>>             // allowed
}

fn largest(shape: dyn Shape): i64 = 0       // a parameter

fn total(shapes: &Vec<&dyn Shape>): i64 = 0 // allowed

fn main() = {
    val kept: Option<own<dyn Shape>> = .None // allowed
    val lent: Vec<&dyn Shape> = Vec()        // allowed
    assert(total(&lent) == 0)
}
