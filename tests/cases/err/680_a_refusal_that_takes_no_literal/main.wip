// A template's `refusal` that does not take what a literal says is an
// error where it is declared: the compiler would have nothing to ask it,
// and the literals it was written to refuse would build without a word.

struct Wrong {
	text: String
}

extend Wrong: Template {
	static fn withCapacity(capacity: i64): Wrong = Wrong(text: .withCapacity(capacity))

	var fn pushLiteral(text: str) = self.text.push(text)

	var fn pushBuilt(built: &Wrong, implicit at: Location) = self.text.push(built.text.toStr())
}

extend Wrong {
	static fn refusal(pieces: &[str]): Option<Refusal> = .None
}

fn main() = {
	val wrong: Wrong = "("
}
