// A value written between `\(` and `)` of a `String` is given to its
// `pushValue`, which takes any `Text`: a type that does not implement it
// cannot be written in a literal, and neither can a function, which
// cannot implement it.

struct Point {
    x: i64
}

fn nothing() = {}

fn main() = {
    val p = Point(x: 1)
    val a = "at \(p)"
    val b = "\(nothing)"
}
