// A value written between `\(` and `)` is appended through `Text`:
// a type that does not implement it cannot be written in a
// literal, and neither can something that is not a value at all.

struct Point {
    x: i64
}

fn nothing() = {}

fn main() = {
    val p = Point(x: 1)
    val a = "at \(p)"
    val b = "\(nothing())"
}
