// A `view enum` is kept only where a view may be, and holds `&`, never
// `&var`, as a `view struct` does. An enum that
// is not a view still holds no `str`, and is told how it could.

view enum Token {
    Word(text: str),
    End,
}

struct Holder {
    token: Token,
}

enum Wrapped {
    One(token: Token),
}

view enum Writes {
    Into(target: &var i64),
}

enum Plain {
    Word(text: str),
}

fn main() = {}
