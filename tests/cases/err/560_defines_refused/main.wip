// A constant a build may set says `@define`, takes no arguments there, is a
// `bool`, an integer, a float or a `str`, and has its value written where it
// is (E0368); `@define` is written on a constant or an `extern` block alone
// (E0420).

@define
val SIZES: [i64; 2] = [1, 2]

@define("LEVEL")
val LEVEL: i64 = 1

@define
@comptime
val TWICE: i64 = double(4)

@define
fn opened() = {}

fn double(n: i64): i64 = n * 2

fn main() = {}
