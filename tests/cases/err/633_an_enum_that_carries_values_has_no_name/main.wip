// An enum whose variants carry values has neither `name()` nor
// `fromName(text)`: a value of it is not made from a word alone, and the
// variant such a value holds is what `Encode` names.

enum Shape {
    Circle(radius: f64)
    Square(side: f64)
}

fn main() = {
    val shape = Shape::Circle(radius: 1.0)
    val name = shape.name()
    val back = Shape::fromName("Square")
}
