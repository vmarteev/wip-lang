// `&dyn Interface`: only behind a reference, only for an
// interface whose methods can be called through a table, and only for a type
// that implements it.

import std::io

interface Counter {
    fn get(): i64
    var fn bump(by: i64)
}

interface Maker {
    static fn zero(): Self          // needs the type
}

interface Taker {
    move fn consume(): i64          // needs the size
}

interface Grower {
    fn grown(): Self                // `Self` is not known through a table
}

struct Cell {
    n: i64
}

struct Plain {
    n: i64
}

extend Cell: Counter {
    fn get(): i64 = self.n
    var fn bump(by: i64) = self.n += by
}

fn writes(c: &dyn Counter) = c.bump(1)  // a `var fn` through `&dyn`
fn unknown(c: &dyn Counter): i64 = c.total()
                                        // no such method
fn maker(m: &dyn Maker): i64 = 0
fn taker(t: &dyn Taker): i64 = 0
fn grower(g: &dyn Grower): i64 = 0
fn missing(m: &dyn Missing): i64 = 0    // no such interface
fn bare(c: dyn Counter): i64 = 0        // not behind `&`

struct Holder {
    inner: dyn Counter                  // nor in a field
}

fn reads(c: &dyn Counter): i64 = c.get()

fn main() = {
    io::printInt(reads(Plain(n: 1)))
                                        // `Plain` does not implement it
}

