// A hole `Html` or `Xml` refuses is an error where it is written, while
// the program is compiled: the compiler asks the template's `refusal` of
// each literal, whether or not the program ever writes the page. Inside a
// script or a style, in an `on…` attribute, in `style`, in `srcset`, in
// an attribute's value with no quotes, between a tag's attributes, in a
// tag's name, in a comment and in a text block; `Html` joined where its
// tags would be read as text; and XML in a tag and in CDATA. Each literal
// is refused at its first refused hole.

import std::markup::{Html, Xml}

fn script(name: str): Html = "<main>\(name)<script>const user = \"\(name)\";</script></main>"

fn style(color: str): Html = "<STYLE>p { color: \(color) }</STYLE>"

fn click(name: str): Html = "<a onClick=\"go('\(name)')\">x</a>"

fn styled(color: str): Html = "<p style=\"color: \(color)\">x</p>"

fn sources(path: str): Html = "<img srcset=\"\(path)\">"

fn unquoted(class: str): Html = "<p class=\(class)>x</p>"

fn between(flag: str): Html = "<input \(flag)>"

fn heading(level: i64): Html = "<h\(level)>x</h\(level)>"

fn noted(name: str): Html = """
	<div>
	  <!-- \(name) -->
	</div>
	"""

fn titled(inner: Html): Html = "<title>\(inner)</title>"

fn quoted(inner: Html): Html = "<p title=\"\(inner)\">x</p>"

fn key(name: str): Xml = "<key \(name)/>"

fn data(name: str): Xml = "<![CDATA[\(name)]]>"

// Not refused: between tags, in a quoted value, in a link, in a title.
fn fine(
	name: str,
	inner: Html,
): Html = "<title>\(name)</title><p title=\"\(name)\"><a href=\"\(name)\">\(inner)</a></p>"

fn main() = {
	val name = "Ada"
	val pages: Vec<Html> = [
		script(name),
		style(name),
		click(name),
		styled(name),
		sources(name),
		unquoted(name),
		between(name),
		heading(2),
		noted(name),
		titled(fine(name, "<b>x</b>")),
		quoted("<b>x</b>"),
	]
	val keys: Vec<Xml> = [key(name), data(name)]
}
