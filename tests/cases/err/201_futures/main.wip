// What a future refuses: work that borrows, a view it
// would hold, a channel of views, and the intrinsics a program cannot
// declare. An owned closure holds only what it owns, and that is the
// whole of what makes it safe on another thread.

import std::future::{Future, channel}

fn borrowed(values: &Vec<i64>): i64 = {
    val sum = Future::run(own () => values.len())
    sum.get()
}

fn viewed(text: String) = {
    val piece = text.toStr()
    val count = Future::run(own () => piece.len())
}

fn views() = {
    val (words, heard) = channel<str>()
    val speaker = Future::run(own () => words.send("hi"))
}

@intrinsic
fn intoAddress<T>(value: own<T>): ptr<u8>

fn main() = {}
