// A pointer is an address as wide as a pointer, so it converts to and
// from `usize`, `isize`, `u64` and `i64`, and to nothing narrower, nor to a
// float.

fn main() = {
    val p: ptr<u8> = null
    val narrow = p as u32
    val float = p as f64
    val small: u16 = 7
    val made = small as ptr<u8>
}
