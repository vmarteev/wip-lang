// An implicit generic in a type parameter is filled as if it were written:
// where another argument decides the type parameter, the implicit found
// must be of the type it says, and the error names the implicit; one of
// another shape is refused as such, not as a type argument nothing
// decided; and where none is in scope, that is the error, said once.

struct Draw<G> {
    width: i64
}

struct Writer<G> {
    scale: i64
}

fn both<G>(writer: &Writer<G>, implicit draws: &var Vec<Draw<G>>) = {}

fn shaped<G>(implicit draws: &var Vec<Draw<G>>) = {}

fn decided() = {
    implicit var draws: Vec<Draw<bool>> = Vec()
    val writer: Writer<i64> = Writer(scale: 1)
    both(&writer)
}

fn anotherShape() = {
    implicit val draws: i64 = 0
    shaped()
}

fn noneHere() = {
    shaped()
}

fn main() = {}
