// Alternatives bind the same names, each of one type: a name bound in one
// alternative and not another is refused, with the rename that would join
// them where one name stands for another, and so is a name of two types,
// since the arm is checked once. Under `match move`, a guard may not stand
// beside an alternative's binding that takes what it matched (E0313).

enum Value {
	Number(x: f64)
	Text(x: String)
	Pair(a: i64, b: i64)
	Single(a: i64)
}

fn first(v: &Value): i64 = match v {
	.Pair(a, b) | .Single(a) => a
	_ => 0
}

fn renamed(v: &Value): i64 = match v {
	.Single(a) | .Pair(b, ..) => 0
	_ => 1
}

fn types(v: &Value): bool = match v {
	.Number(x) | .Text(x) => true
	_ => false
}

fn guarded(v: Value): String = match move v {
	.Text(x) | .Text(x) if x.len() > 2 => move x
	_ => String()
}

fn main() = {
	assert(first(Value::Single(a: 1)) == 1)
	assert(renamed(Value::Single(a: 1)) == 0)
	assert(types(Value::Number(x: 1.0)))
	assert(guarded(Value::Single(a: 1)).isEmpty())
}
