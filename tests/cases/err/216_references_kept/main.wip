// A `&` reference kept as a view borrows what it points into: used after that
// changes (E0436), leaving what it borrows (E0437), or passed beside a `&var`
// to the same place (E0413).

import std::io

struct Node {
    size: i64
}

struct Tree {
    nodes: Vec<Node>
}

extend Tree {
    fn find(size: i64): Option<&Node> = {
        for i in 0..self.nodes.len() {
            if self.nodes[i].size == size {
                return .Some(&self.nodes[i])
            }
        }
        return .None
    }
}

fn tree(): Tree = {
    var nodes: Vec<Node> = Vec()
    nodes.push(Node(size: 1))
    return Tree(nodes: move nodes)
}

/// A local that holds a reference, after what it points into changed.
fn keptLocal() = {
    var t = tree()
    val first: &Node = &t.nodes[0]
    t.nodes.clear()
    io::println("\(first.size)")
}

/// Pointed somewhere else, it borrows only the new place: the first use is
/// good, the second is not.
fn repointed() = {
    var a = tree()
    var b = tree()
    var at: &Node = &a.nodes[0]
    at = &b.nodes[0]
    a.nodes.clear()
    io::println("\(at.size)")
    b.nodes.clear()
    io::println("\(at.size)")
}

/// A binding of the reference a call answered.
fn bound() = {
    var t = tree()
    match t.find(1) {
        .Some(n) => {
            t.nodes.clear()
            io::println("\(n.size)")
        }
        .None => {}
    }
}

/// A reference taken through another borrows what that one borrows.
fn throughAnother() = {
    var t = tree()
    val found = t.find(1)
    val .Some(n) = found else {
        return
    }
    val size: &i64 = &n.size
    t.nodes.clear()
    io::println("\(size)")
}

fn escapes(): Option<&Node> = {
    val t = tree()
    return t.find(1)
}

fn local(): Option<&Node> = {
    val n = Node(size: 1)
    return .Some(&n)
}

fn both(a: &var Node, b: &Node) = {
    a.size = b.size + 1
}

fn chosen(pick: bool) = {
    var x = Node(size: 1)
    val y = Node(size: 2)
    both(&var x, if pick { &x } else { &y })
}

fn kept() = {
    var x = Node(size: 1)
    val r: &Node = &x
    both(&var x, &r)
}

/// A reference given where a type parameter is taken is the value itself,
/// and what it borrows is where it points.
fn id<T>(x: T): T = move x

fn throughAGeneric() = {
    var n = Node(size: 1)
    val r: &Node = id<&Node>(&n)
    n = Node(size: 2)
    io::println("\(r.size)")
}

fn pushed(): Vec<&Node> = {
    val n = Node(size: 1)
    var all: Vec<&Node> = Vec()
    all.push(&n)
    return move all
}

/// What a `&var &Node` parameter is pointed at goes to the caller.
fn pointedAtALocal(at: &var &Node) = {
    val local = Node(size: 9)
    at = &local
}

enum List {
    Cons(value: i64, next: own<List>)
    Nil
}

/// What is bound through a kept reference borrows what it points into.
fn listChanged() = {
    var list = List::Cons(value: 1, next: own List::Nil)
    val at: &List = &list
    if at is .Cons(value, next) {
        list = List::Nil
        if next is .Nil {
            io::println("\(value)")
        }
    }
}

fn main() = {}
