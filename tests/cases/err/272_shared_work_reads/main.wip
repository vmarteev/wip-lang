// `each` gives one closure to every thread it starts, so the closure only
// reads what it captured; and a type the compiler knows,
// `@intrinsic`, is the standard library's to declare.

import std::future

@intrinsic
struct Counter {
	value: i64
}

fn main() = {
	var count = 0
	var cells = [1, 2, 3]
	future::each(&var cells, (cell) => { count += cell })
}
