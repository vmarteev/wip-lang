// Parser (E0104): match arms on separate lines need no separator, but arms on
// one line need a `,` between them, block arms included. The
// fix inserts the `,`.

enum Light {
    Red
    Yellow
    Green
}

fn code(l: Light): i64 = match l {
    .Red => 0 Light::Yellow => 1
    .Green => 2
}

fn go(l: Light): i64 = {
    match l { Light::Red => { return 0 } _ => 1 }
}
