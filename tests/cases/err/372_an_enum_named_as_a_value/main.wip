// An enum's name is not a value: interpolated, or before a dot and a name
// that is not one of its variants, it is reported as a type used as a value.
// Only a variant after the dot is the variant written with `.` for `::`.

import std::io

enum Json {
	Null
	Text(text: String)
}

fn main() = {
	io::println("\(Json)")
	val parse = Json.parse
}
