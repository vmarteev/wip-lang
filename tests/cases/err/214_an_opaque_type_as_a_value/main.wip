// An opaque C type says only that the type exists, so only a `ptr` may
// point at one: the type a `ptr` points at itself, and
// nothing inside it — an array of them or an `Option` of one would be
// values of it. One another module declares is refused as a value too.

import handles

extern "C" {
    type Local
}

fn plain(h: ptr<Local>): bool = h.isNull

fn twice(h: ptr<ptr<Local>>): bool = h.isNull

fn behind(h: ptr<handles::Handle>): bool = h.isNull

fn many(h: ptr<[Local; 2]>): bool = h.isNull

fn wrapped(h: ptr<Option<Local>>): bool = h.isNull

fn byValue(h: handles::Handle): i64 = 0

fn main() = {}
