// A `str` borrows bytes that live somewhere else, so it may
// stand in a parameter, a local and a result — but not where it would
// outlive what it borrows (E0427): not a field, and not a variant's
// payload. A `String` owns its bytes, and is what those places want. A type
// argument or an element may be one, and what it
// makes borrows in turn: `Option<str>` and `[str; 2]` are results here, and
// `Vec<str>` is refused as a field.
//
// A `String` is lent as a `str` where a call expects one,
// and nowhere else: stored or returned, it would outlive the bytes, so it is
// the mismatch it looks like.

import std::io

struct Line {
    text: str
}

struct Document {
    lines: Vec<str>
}

enum Token {
    Word(text: str)
    End
}

fn names(): Option<str> = .None

fn table(): [str; 2] = ["a", "b"]

fn text(): str = {
    var built = String()
    built.push("gone by the time it is read")
    built
}

fn main() = {
    val fine: str = "a local may hold one"
    io::printInt(fine.len())
    val kept: str = String()
}

