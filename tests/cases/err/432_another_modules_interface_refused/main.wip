// Another module's interface is imported, or named by its path, only where
// it is `pub` and declared there; an import may not take a name this
// module declares as an interface. Each is said as for a type: private,
// not found with the name meant, a clash, and a path through no module.

import shapes
import shapes::{Hidden, Aera}
import shapes::{Area as Measured}

interface Measured {
	fn size(): i64
}

fn kept<T: shapes::Hidden>(item: &T): i64 = 0

fn misspelt(item: &dyn shapes::Aera): i64 = 0

struct Square {
	side: i64
}

extend Square: elsewhere::Area {
	fn area(): i64 = self.side * self.side
}

fn main() = {}
