// What `@derive(Eq)` and `@derive(Ord)` will not do. They write the
// comparison from the fields, so every field must be comparable; a type has
// one answer, so an annotation and an `extend` block cannot both be written;
// a type that asked for neither cannot be compared at all; and a type that
// is ordered must say when two of it are equal. A field whose `Eq` holds
// only for some type arguments is told which argument is in the way;
// one whose arguments do compare, as `Vec<i64>` does, is
// compared (`ok/212_derived_comparison`).

struct Plain { n: i64 }

// A `Vec<T>` compares when `T` does, and `Plain` does not.
@derive(Eq)
struct Holder { items: Vec<Plain> }

@derive(Eq)
struct Twice { n: i64 }

extend Twice: Eq {
    fn equals(other: &Twice): bool = self.n == other.n
}

@derive(Ord)
struct Alone { n: i64 }

@derive(Eq, Ord)
struct Pointed { p: ptr<i64> }

fn same(a: &Plain, b: &Plain): bool = a == b

fn first(a: &Plain, b: &Plain): bool = a < b
