// Bitwise operators need integers of one type, or one that holds the other
// (E0303), as arithmetic does;
// a shift's amount may be any integer. On `bool`, `&` and `|` get a fix to `&&`
// and `||`, and `^` a hint that `!=` is exclusive or. `!` takes a `bool` or an
// integer.

fn main(): i64 = {
    val ready = true
    val done = false
    val both = ready & done
    val either = ready | done
    val differ = ready ^ done
    val half = 1.5 & 2.0
    val small: u8 = 3
    val signed: i8 = -2
    val mixed = small & signed
    val flipped = !2.5
    0
}
