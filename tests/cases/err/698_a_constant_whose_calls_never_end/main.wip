// A constant whose function calls itself and never ends is stopped ten
// thousand calls deep, rather than run the compiler out of stack, and its
// error names the innermost calls and counts the rest.

fn climbed(n: i64): i64 = if n < 0 then 0 else climbed(n + 1) + 1

@comptime
val HEIGHT: i64 = climbed(0)

fn main() = {}
