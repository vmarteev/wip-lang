// A constant worked out by running code says so with `@comptime`, and one
// known where it is written does not, since a mark that does nothing is
// worse than none: E0444 both ways, each with the
// fix. A constant that reads a marked one runs too, and needs the mark. A
// top-level assert is always checked while the program is compiled, and
// takes no mark (E0420).

@comptime
val DOUBLED: i64 = twice(64)
val UNMARKED: i64 = twice(3)
val READS_MARKED: i64 = DOUBLED + 1

@comptime
val PLAIN: i64 = 5

@comptime
assert(true)

fn twice(n: i64): i64 = n * 2

fn main() = {}
