// Where `implicit` cannot stand: before a pattern, which binds more than one
// name; on a parameter before an ordinary one; with a default; on a value
// that owns memory; of a type parameter's type; on a C function. A function
// with implicits is not a value, and an implementation declares the
// implicits its interface does.

struct Log {
	lines: Vec<String>
}

fn early(implicit log: &Log, count: i64): i64 = count

fn defaulted(implicit level: i64 = 3): i64 = level

fn owned(implicit log: Log): i64 = 0

fn generic<T>(implicit value: &T): i64 = 0

extern "C" {
	fn abs(n: i32, implicit log: &Log): i32
}

fn logged(implicit log: &Log): i64 = 1

interface Report {
	fn write(implicit log: &Log): i64
}

struct Plain

extend Plain: Report {
	fn write(log: &Log): i64 = 0
}

fn asAValue(): i64 = {
	val f = logged
	return 0
}

fn main() = {
	implicit val (a, b) = (1, 2)
}
