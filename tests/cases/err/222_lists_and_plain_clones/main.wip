// An array where a list on the heap is expected is told to write `own`;
// what owns memory is not its own clone, and a struct of it clones only
// where it says so.

struct Holder {
    items: own<[i64]>
}

struct Bag {
    items: Vec<i64>
}

fn needsClone<T: Clone>(value: T): T = value

fn main() = {
    val v = Vec::of([1, 2])
    val h = Holder(items: [3, 4])
    val o = needsClone(own 5)
    val b = needsClone(Bag(items: Vec()))
}
