// Asserts at the top level that do not hold while the program is compiled:
// one with a note and one without, each saying what it
// would say at run time (E0445); one whose check panics in what it calls,
// with the calls (E0441); and one that calls into C (E0442).

import std::c
import std::io

struct Pair {
    a: i64
    b: i64
}

val KEYS: [i64; 3] = [1, 2, 3]

assert(KEYS[2] == 4, "the last key is 4")
assert(c::sizeOf<Pair>() == 8)
assert(pick(&KEYS, 5) > 0)
assert(loud())

fn pick(values: &[i64], i: i64): i64 = values[i]

fn loud(): bool = {
    io::println("checking")
    return true
}

fn main() = {}
