// `as%` where nothing is cut is a warning (E0371), with the fix that
// writes `as`: a widening, the same type, and a constant the type holds.
// A byte made a byte is not, since C's `char` is a `u8` on one system and
// an `i8` on another. Of a float, made an integer or made from one, `as%`
// is refused (E0319), since a float has no bits to cut, as is `as%` to or
// from anything that is not an integer or a character.

enum Light {
	Red
	Green
}

fn main() = {
	val b: u8 = 7
	val wide = b as% u32
	val word: u32 = 7
	val same = word as% u32
	val byte = b as% u8
	val small = 5 as% u8
	val letter = 'a' as% u8
	val f = 2.5 as% i64
	val g = 3 as% f64
	val light = Light::Green as% u8
	val t = true as% u8
}
