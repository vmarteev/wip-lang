// A `@tailrec` function's call to itself reuses the frame, so nothing of the
// frame may be left to clean up where it jumps: no local that still owns
// memory, and no `defer` waiting. Drops are never moved to
// make a call fit.

import std::io

struct Node {
    id: i64
}

@tailrec
fn holds(n: i64, acc: i64): i64 = {
    val node = own Node(id: n)
    if n == 0 { acc } else { holds(n - 1, acc + node.id) }
}

// Moved on one path and not the other, so it may still own something here.
@tailrec
fn maybeHolds(n: i64, node: own<Node>, acc: i64): i64 = {
    if n == 0 {
        val taken = move node
        return acc + taken.id
    }
    maybeHolds(n - 1, own Node(id: n), acc)
}

@tailrec
fn deferred(n: i64, acc: i64): i64 = {
    defer io::printInt(acc)
    if n == 0 { acc } else { deferred(n - 1, acc + n) }
}

fn main() = {
    io::printInt(holds(3, 0))
}

