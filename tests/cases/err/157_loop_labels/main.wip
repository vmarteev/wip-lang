// A loop's name says which loop a jump leaves. Two loops
// around each other cannot share a name, a jump cannot name a loop that
// is not around it, and a jump outside every loop is the error it was.

fn main() = {
    outer: while true {
        outer: while true {
            break outer
        }
    }

    for i in 0..3 {
        break nowhere
    }

    break away
}
