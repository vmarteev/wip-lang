// Moves (E0403): moving a variable declared outside a loop. The second
// iteration would move it again after the first one already did.

struct Job {
    id: i64
}

fn run(j: own<Job>) = {}

fn main(): i64 = {
    val job = own Job(id: 1)
    var i = 0
    while i < 3 {
        run(move job)
        i = i + 1
    }
    return 0
}
