// An alias is another name for a type, so it declares
// nothing: it names no methods, it takes no constraints, and one that
// names itself names nothing at all. Its parameters are counted as any
// type's are.

type Loop = Loop
type Ping = Pong
type Pong = Ping
type Bounded<T: Eq> = Vec<T>
type Pairs<T> = Vec<T>
type Id = i64

extend Id {
    pub fn twice(): Id = self * 2
}

fn main() = {
    val a: Pairs = 1
    val b: Id<i64> = 1
}
