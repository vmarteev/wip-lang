// A method that changes its receiver, called on the `&` a call answers:
// what the reference refers to is reached through it, and a `&` only reads,
// so the call is refused. It was lent the reference itself, as if the
// reference were the value, and wrote through it to memory it does not
// hold. Through a `&var` the same call is lent what it refers to.

import std::collections::{Map}

fn main() = {
	var lists: Map<i64, Vec<i64>> = Map()
	lists.put(1, Vec())
	lists.get(1).unwrap().push(7)
	var held: Option<Vec<i64>> = .None
	held.getOrInsert(Vec()).push(7)
}
