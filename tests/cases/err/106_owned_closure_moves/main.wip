// An owned closure owns its environment, so it is moved rather than copied,
// and what it captured it only reads.

import std::io

struct Token {
    id: i64
}

fn run(f: own<(x: i64) => i64>, n: i64): i64 = f(n)

fn copies(): i64 = {
    val f = own (x: i64) => x + 1
    val g = f                       // two owners of one environment
    run(move f, 1) + run(move g, 1)
}

fn afterMove(): i64 = {
    val f = own (x: i64) => x + 1
    val used = run(move f, 1)
    used + f(2)                     // the closure is gone
}

fn takesCapture(): i64 = {
    val token = own Token(id: 1)
    val f = own (x: i64) => {
        val taken = move token      // it holds the token, and keeps it
        taken.id + x
    }
    f(2)
}

fn main() = {
    io::printInt(copies())
}

