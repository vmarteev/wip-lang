// `keeps` names the parameters a call may keep in its `&var` arguments: not
// a `&var` one, whose contents are lent for the call alone; not a name that
// is no parameter; not on a function with nothing to keep in; and an
// implementation keeps no more than its interface says.

view struct Words {
	words: Vec<str>
}

extend Words {
	var fn take(other: &var Words) keeps other = {}

	var fn add(word: str) keeps text = {}
}

fn nowhere(text: str): str from text keeps text = text

interface Collect {
	var fn collect(text: str)
}

extend Words: Collect {
	var fn collect(text: str) keeps text = self.words.push(text)
}

fn main() = {}
