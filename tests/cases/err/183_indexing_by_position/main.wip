// A type indexed by a position says so once, by `Sequence`: with `Index<i64,
// …>` beside it, `x[i]` would have two meanings. And a type whose `Index` has
// only the reading half is read, not written.

struct Ring {
    slots: [i64; 4]
}

extend Ring: Sequence<i64> {
    fn len(): i64 = 4
    fn at(i: i64): &i64 = lend self.slots[i]
}

extend Ring: Index<i64, i64> {
    fn at(i: i64): &i64 = lend self.slots[i]
}

struct Squares {
    values: [i64; 3]
}

extend Squares: Index<str, i64> {
    fn at(key: str): &i64 = lend self.values[0]
}

fn main() = {
    var table = Squares(values: [1, 4, 9])
    table["one"] = 2
}
