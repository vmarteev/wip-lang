// What a pattern that is a value may not be: of another
// type than the value being matched, alternatives that bind other names, a guard
// on an arm that takes what it matched, and a list of numbers that is not
// all of them.

import std::io

enum Shape {
    Round(radius: i64)
    Square(side: i64)
}

fn main() = {
    val s = Shape::Round(radius: 1)

    // A guard covers nothing: `Round` is still missing.
    val guarded = match s {
        .Round(..) if true => 1
        .Square(..) => 2
    }

    // A list of numbers is never all of them.
    val listed = match 3 {
        1 => "one"
        2 => "two"
    }

    val wrong = match 3 {
        "text" => 1
        _ => 0
    }

    // Whichever alternative matches gives the arm its names, so each binds
    // the same ones: `radius` and `side` are two.
    val bound = match s {
        .Round(radius) | .Square(side) => 1
    }

    // The guard runs after the value has been taken apart.
    var v = Vec<i64>()
    val maybe = Option<Vec<i64>>::Some(move v)
    val taken = match move maybe {
        .Some(held) if held.len() > 0 => 1
        _ => 0
    }
}
