// `@derive(Clone)` clones each field, so each field's type must clone:
// one that does not is reported where the field is written, with the
// annotation beside it, and the `clone` `@derive` wrote says nothing more.

// It owns memory, so it clones only where it says so.
struct Named {
    name: String
}

@derive(Clone)
struct Holder {
    named: Named
    name: String
}

// What an `own<T>` points at may clone, but the field does not.
@derive(Clone)
enum Boxed {
    One(inner: own<i64>)
}

fn main() = {
    val holder = Holder(named: Named(name: "n"), name: "x")
    val copy = holder.clone()
}
