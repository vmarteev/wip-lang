// A `?` in a lambda whose result is said after it is refused once the
// result is said, where the lambda is found to answer another kind, a
// `Result` with an error that does not convert, or nothing (E0348); and
// in a lambda whose result is written, as in a function, naming the lambda.

import std::io

fn half(n: i64): Option<i64> = if n % 2 == 0 then .Some(n / 2) else .None

fn parsed(text: str): Result<i64, str> = .Err(text)

fn main() = {
	val anotherKind = (n: i64) => {
		val h = half(n)?
		return h + 1
	}
	val anotherError = (text: str) => {
		val n = parsed(text)?
		val r: Result<i64, i64> = .Ok(n)
		return r
	}
	val nothing = (n: i64) => {
		val h = half(n)?
		io::println("\(h)")
	}
	val byValue = (n: i64) => half(n)? + 1
	val written = (n: i64): i64 => half(n)?
}
