// Two mistakes that read as something else:
// a variable declared with an `if` without `else`, which has no value, is
// told so where it is declared (E0354); and an argument named with `=`,
// which would assign, is told it is named with `:` (E0355), and is then
// matched as the named argument it was meant to be. Where a variable of
// that name is in scope, `=` assigns to it, as it always did.

import std::io

fn label(text: str, width: i64 = 10): i64 = text.len() + width

fn main() = {
    val quiet = false
    val r = if quiet { 1 }
    io::println("\(r)")
    val n = label("x", width = 3)
    io::println("\(n)")
}
