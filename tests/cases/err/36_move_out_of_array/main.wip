// Moves (E0406, E0407): one element cannot be moved out of an array of `own`
// values, and a value containing `own` cannot be repeated with `[x; n]`.

struct Cell {
    v: i64
}

fn take(c: own<Cell>) = {}

fn main(): i64 = {
    val cells = [own Cell(v: 1), own Cell(v: 2)]
    take(move cells[0])
    val many = [own Cell(v: 0); 4]
    return 0
}
