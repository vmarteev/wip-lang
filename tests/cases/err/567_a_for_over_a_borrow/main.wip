// A `for` walks a place and writes its elements where it can be written;
// a `&var` or a `&` before what it walks is refused, with the fix that
// removes it.

struct Ball {
	age: i64
}

fn main() = {
	var balls = [Ball(age: 1), Ball(age: 2)]
	for ball in &var balls {
		ball.age += 1
	}
	for ball in &balls {
		assert(ball.age > 1)
	}
}
