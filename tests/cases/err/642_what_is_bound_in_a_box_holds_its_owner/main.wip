// What a pattern binds inside a box is part of the value that owns the box,
// as a field is: the value is not changed while the binding is used, and
// once `match move` has taken from inside it, it is not matched again.

enum Tree {
    Leaf(value: i64)
    Named(name: String)
    Node(left: own<Tree>, right: own<Tree>)
}

fn rename(tree: &var Tree) = match tree {
    .Node(left: .Named(name), ..) => {
        tree = .Leaf(value: 0)
        assert(name.len() > 0)
    }
    _ => {}
}

fn takenTwice(tree: Tree): String = {
    val first = match move tree {
        .Node(left: .Named(name), ..) => name
        _ => String()
    }
    val again = match move tree {
        .Node(left: .Named(name), ..) => name
        _ => String()
    }
    return first
}

fn main() = {}
