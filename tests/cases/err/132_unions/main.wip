// What a union will not do. It is C's, so its fields are
// the ones C can write and it has no type parameters; it holds one field at
// a time, so a literal names one or none; and it is one of its fields, so
// there must be a field to be.

extern union Empty {
}

extern union Owning {
    count: c_int,
    numbers: Vec<i64>
}

extern union Generic<T> {
    value: T
}

extern union Value {
    number: c_int,
    bytes: [u8; 4]
}

fn main() = {
    val both = Value(number: 1 as c_int, bytes: [0 as u8, 0 as u8, 0 as u8, 0 as u8])
    val unknown = Value(text: 1 as c_int)
}
