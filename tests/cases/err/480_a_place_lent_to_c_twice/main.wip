// A place lent to a C function is lent as a reference argument is: a
// `&var` argument is the only reference to its place while the call
// runs, so a count and the array C fills are two places, not one.

extern "C" {
    fn listed(count: ptr<u32>, items: ptr<u32>)
}

fn main() = {
    var count: u32 = 0
    listed(&var count, &var count)
    var items: [u32; 4] = [0; 4]
    listed(&var items[0], &var items)
}
