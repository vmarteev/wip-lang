// What passes a reference on still refuses one into what the function
// owns: a vector the function built, walked, and a `?` on a lookup of
// it.

import std::json::{Json}

fn firsts(): Vec<&Json> = {
	val owned: Vec<Json> = Vec::of(own [Json::Null])
	var found: Vec<&Json> = Vec()
	for item in owned.items() {
		found.push(item)
	}
	return move found
}

fn first(): Option<&Json> = {
	val document = Json::Array(items: Vec::of(own [Json::Null]))
	return .Some(document.item(0)?)
}

fn main() = {}
