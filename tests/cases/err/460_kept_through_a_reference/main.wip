// A reference made from a parameter's place borrows what the parameter
// borrows, so storing it in a `&var` parameter keeps the parameter, as
// storing the parameter itself does: a field borrowed through it, a view
// its method answers, and an element or a payload bound from it, each
// without `keeps`. A method keeping what its receiver borrows is told to
// say `keeps self`.

view struct Seen {
	name: &String
}

struct Thing {
	name: String
}

extend Thing {
	fn seen(): Seen = Seen(name: &self.name)

	fn into(out: &var Option<Seen>) = {
		out = Seen(name: &self.name)
	}
}

fn field(thing: &Thing, out: &var Option<Seen>) = {
	out = Seen(name: &thing.name)
}

fn answered(thing: &Thing, out: &var Option<Seen>) = {
	out = thing.seen()
}

struct Shelf {
	names: Vec<String>
}

fn element(shelf: &Shelf, out: &var Option<&String>) = {
	for name in shelf.names {
		out = &name
		return
	}
}

enum Slot {
	Full(name: String)
	Empty
}

fn payload(slot: &Slot, out: &var Option<&String>) = {
	match slot {
		.Full(name) => out = &name
		.Empty => {}
	}
}

fn said(thing: &Thing, out: &var Option<Seen>) keeps thing = {
	out = thing.seen()
}

fn main() = {
	val thing = Thing(name: "kept")
	var out: Option<Seen> = .None
	said(&thing, &var out)
	assert(out.isSome())
}
