// What a map will not take. A key must answer whether two
// of it are equal and what its bytes hash to, which is what `K: Hash + Eq`
// asks for: a struct that asked for neither cannot be one, and neither can
// a float, whose equality and bytes disagree.

import std::collections::{Map}

struct Plain {
    n: i64
}

fn main() = {
    var byStruct = Map<Plain, i64>()
    byStruct.put(Plain(n: 1), 1)

    var byFloat = Map<f64, i64>()
    byFloat.put(1.5, 1)
}
