// A constant table of more elements than the compiler makes: every element
// is worked out while the program is compiled and kept in it, so a table
// past sixteen million is refused, rather than run the compiler for minutes
// and out of memory; a small one is a constant as any.

val SIDE: i64 = 2147483648

val CELLS: [i64; SIDE] = [0; SIDE]

val SMALL: [u8; 16] = [7; 16]

fn main() = {
	assert(SMALL[15] == 7)
}
