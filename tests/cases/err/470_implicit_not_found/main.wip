// A call that leaves an implicit parameter out is filled only from an
// implicit of its name: where there is none it is refused, with the two ways
// to declare one; an ordinary variable of the name is not used, and the
// message says so; and an implicit of another type is a mismatch.

struct Dice {
	next: i64
}

fn roll(implicit dice: &var Dice): i64 = dice.next

fn nothingHere(): i64 = roll()

fn onlyAVariable(): i64 = {
	var dice = Dice(next: 4)
	return roll()
}

fn anotherType(): i64 = {
	implicit var dice = 4
	return roll()
}

fn main() = {}
