// Slices and exclusivity (E0413). A `&var` slice
// overlaps every other reference into the same array, even when the two
// ranges do not overlap: indices are not known when the program is checked.
// Disjoint slices of different arrays are fine.

fn copyInto(from: &[i64], to: &var [i64]) = {}

fn swapHalves(a: &var [i64], b: &var [i64]) = {}

fn main(): i64 = {
    var xs = [1, 2, 3, 4]
    var ys = [5, 6, 7, 8]
    swapHalves(&var xs[..2], &var xs[2..])
    copyInto(&xs[..2], &var xs[2..])
    copyInto(&xs, &var ys)
    0
}
