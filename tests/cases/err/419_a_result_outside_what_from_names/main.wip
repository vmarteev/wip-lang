// A function that says with `from` what its result borrows is held to it:
// an answer from a place of the view it does not name, or from a parameter
// it does not name, is refused where it leaves (E0437). Its callers keep
// what it names, and are refused where that changes (E0436).

struct Ast {
	names: Vec<String>
}

view struct Lowerer {
	ast: &Ast
	errors: Vec<String>
}

extend Lowerer {
	fn owned(): str from self.ast = self.errors[0].toStr()
}

fn shorter(a: str, b: str): str from a = b

fn pick(a: str, b: str): str from a = a

fn kept(): i64 = {
	var first = String::of("ab")
	val second = String::of("c")
	val picked = pick(first.toStr(), second.toStr())
	first.push("!")
	return picked.len()
}

fn main() = {
	assert(kept() > 0)
}
