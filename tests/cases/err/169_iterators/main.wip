// A `for` over an iterator calls `next()`, which changes it, so a place it
// walks must be able to change (E0323).

view struct Words {
    text: str,
    at: i64
}

extend Words: Iterator<str> {
    var fn next(): Option<str> = .None
}

fn fixed() = {
    val words = Words(text: "a b", at: 0)
    for w in words {}
}

fn main() = {}
