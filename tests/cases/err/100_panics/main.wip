// `panic` takes one message in text — written at the call, or built when it
// panics — and `never` is the type of what does not return.

import std::io

fn bad(): i64 = {
    panic("one", "two")              // one message
    panic(text: "named")             // not named
    panic(3)                         // text
    0
}

fn notLeaving(): never = 3           // a value, not a panic

fn reaches(n: i64): never = if n > 0 {
    panic("positive")
}                                    // can reach its end

struct Holder {
    value: never                     // no value can exist
}

fn takes(x: never): i64 = 0          // nor be passed

fn main() = {
    io::printInt(bad())
}

