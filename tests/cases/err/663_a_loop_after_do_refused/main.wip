// What `do` does not take is refused, each with its fix: a block after
// `do`, which drops the `do`; and a binding, a loop, an `if` with an
// `else`, an `if` in braces and a `match`, each of which the fix puts in
// the loop's braces.

fn main() = {
    for n in [1] do { assert(n > 0) }
    for n in [1] do val twice = n * 2
    for row in [Vec::of([1])] do for n in row do assert(n > 0)
    for n in [1] do if n > 0 then assert(true) else assert(false)
    for n in [1] do if n > 0 { assert(true) }
    while false do match 1 { _ => {} }
}
