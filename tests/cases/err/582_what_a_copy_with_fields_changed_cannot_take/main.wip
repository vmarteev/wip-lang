// `..base` moves a field that owns memory out of `base`, so it cannot take
// one from behind a reference (E0405), and a field it took is not used
// after (E0404); a variant that takes one gives up all of `base`, which a
// reference cannot do either.

struct Moved {
    definite: bool
    name: String
}

enum Thing {
    Prop(name: String, turn: i64)
    Opening(name: String, turn: i64)
}

fn behind(m: &Moved): Moved = Moved(definite: false, ..m)

fn usedAfter(m: Moved): i64 = {
    val unsure = Moved(definite: false, ..m)
    return m.name.len()
}

fn variantBehind(t: &Thing): Thing = match t {
    .Prop(..) => .Prop(turn: 1, ..t)
    .Opening(name, turn) => .Opening(name: name.clone(), turn: turn)
}

fn main() = {}
