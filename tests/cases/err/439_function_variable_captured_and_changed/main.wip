// A variable holding a function value, captured, is kept as any other is:
// not assigned while a closure kept in a `val` still reads it, and not
// written by one closure of a call while another reads it.

import std::io

fn both(a: &(x: i64) => void, b: &var (x: i64) => void) = {
	a(1)
	b(2)
}

fn main() = {
	var scale = (x: i64) => x * 2
	val doubled = (x: i64) => scale(x)
	scale = (x: i64) => x * 3
	io::println("\(doubled(3))")
	// A closure that writes it, beside one that reads it, in one call.
	both((x) => io::println("\(scale(x))"), (x) => {
		scale = (y: i64) => y
	})
}
