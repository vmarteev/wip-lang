// An `own` closure may be kept anywhere, so it cannot capture a `str`, or
// an array of them, which it would outlive (E0427).

fn make(): own<() => i64> = {
    val s = "x"
    own () => s.len()
}

fn letters(): own<() => i64> = {
    val words = ["a", "b"]
    own () => words[0].len()
}

fn main() = {}
