// Moves (E0404): a value containing `own` is never copied implicitly. The fix
// adds `move`; borrowing is offered as the alternative. Two separate
// mistakes, two errors.

struct Buffer {
    len: i64
}

fn size(b: own<Buffer>): i64 = {
    return b.len
}

fn main(): i64 = {
    val a = own Buffer(len: 8)
    val b = a
    return size(b)
}
