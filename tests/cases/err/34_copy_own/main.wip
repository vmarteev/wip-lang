// Moves (E0404): a value containing `own` is never copied, so a place used
// as a value is given away there, and used again it is refused where it was
// given.

struct Buffer {
    len: i64
}

fn size(b: own<Buffer>): i64 = {
    return b.len
}

fn main(): i64 = {
    val a = own Buffer(len: 8)
    val b = a
    return size(b) + a.len
}
