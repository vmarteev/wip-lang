// An `if` whose value is wanted, a branch of which answers nothing: one
// empty, one that ends in a statement. Each is refused where it is, as a
// block that answers nothing is wherever a value is expected; a branch that
// ends the path, and an `if` of no value, are not.

fn label(menu: bool): String = if menu {} else { "Back" }

fn count(more: bool): i64 = if more {
	val extra = 2
} else {
	1
}

fn chosen(first: bool): i64 = if first { return 0 } else { 1 }

fn noted(loud: bool) = if loud {} else {}

fn main() = {
	assert(chosen(true) == 0)
	noted(false)
}
