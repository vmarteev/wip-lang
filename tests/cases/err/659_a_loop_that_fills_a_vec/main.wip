// A `Vec` declared empty and filled by the loop right after it, one `push`
// an element, is warned of (E0479), with the fix that says it as the list
// that yields: a `push` as a statement, a branch, an arm or in an inner
// loop, and a vector written after the loop, which stays a `var`. Left
// alone: a vector made with a capacity, one the loop reads, a `Set`
// filled, a loop that does more than work out what it pushes, one that
// pushes a `String` where a `str` is kept, which only a call lends, and a
// body of more statements than a list reads well with.

import std::collections::{Set}

fn evens(numbers: &[i64]): Vec<i64> = {
    var found: Vec<i64> = Vec()
    for n in numbers {
        if n % 2 == 0 then found.push(n)
    }
    return found
}

fn pairs(rows: &[Vec<i64>]): Vec<(i64, i64)> = {
    var all = Vec()
    for (i, row) in rows.indexed() {
        for n in row {
            match n {
                0 => {}
                _ => all.push((i, n))
            }
        }
    }
    all.push((-1, -1))
    return all
}

fn kept(numbers: &[i64]): i64 = {
    var reserved: Vec<i64> = Vec::withCapacity(numbers.len())
    for n in numbers {
        reserved.push(n)
    }
    var growing: Vec<i64> = Vec()
    for n in numbers {
        if growing.len() < 2 then growing.push(n)
    }
    var seen: Set<i64> = Set()
    for n in numbers {
        seen.add(n)
    }
    var counted = 0
    var doubled: Vec<i64> = Vec()
    for n in numbers {
        counted += 1
        doubled.push(n * 2)
    }
    return reserved.len() + growing.len() + seen.len() + counted + doubled.len()
}

fn lent(names: &[String]): Vec<str> = {
    var all: Vec<str> = Vec()
    for name in names {
        all.push(name)
    }
    return all
}

fn long(numbers: &[i64]): Vec<i64> = {
    var out: Vec<i64> = Vec()
    for n in numbers {
        val a = n + 1
        val b = a * 2
        val c = b - 3
        val d = c / 2
        out.push(d)
    }
    return out
}

fn main() = {
    val names = [String::of("a")]
    assert(evens([1, 2, 4]).len() == 2 && pairs([[0, 1]]).len() == 2)
    assert(kept([1, 2, 3]) == 14 && lent(&names).len() == 1 && long([1]).len() == 1)
}
