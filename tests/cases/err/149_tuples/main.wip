// A tuple has two elements or more, and the prelude writes them out to
// four. One element is parentheses around an expression,
// five is a struct whose fields have names, and an element beyond the
// fourth is not an element at all. `pair.5.1` is one token to the lexer,
// which is why the report says how to write two positions.

fn five(): (i64, i64, i64, i64, i64) = (1, 2, 3, 4, 5)

fn main() = {
    val one = (1,)
    val (x,) = (1, 2)
    val pair = (1, 2)
    val gone = pair.9
    val two = pair.5.1
}
