// A method of a generic type takes its type arguments from its receiver,
// and only then from what is expected of its answer. The
// other order made `Option<i64>`'s `unwrap` an `unwrap<str>` wherever a
// `str` was expected: the program compiled, and read an `i64`'s bits as a
// `str`'s, or a `Node`'s as a `Result`'s. Each is a mismatch now.

enum Node {
    Leaf(n: i64),
    Pair(left: own<Node>, right: own<Node>),
}

fn first(parts: &var Vec<Node>): Result<Node, str> = {
    return parts.pop().unwrap()
}

fn main() = {
    val v: Option<i64> = .Some(3)
    val s: str = v.unwrap()
    val b: bool = v.unwrapOr(0)
}
