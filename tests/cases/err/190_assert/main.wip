// What an `assert` refuses: a condition that is not a
// question, a note that is not text, more than a condition
// and a note, and the call shape itself. A `@test` function takes
// nothing and answers nothing, since the runner calls it by itself.

fn checked(n: i64) = {
    assert(n)
    assert(n == 0, n)
}

fn written(n: i64) = {
    assert(n == 0, "one", "two")
    assert n == 0
}

@test
fn takesSomething(n: i64) = assert(n == 0)

@test
fn answersSomething(): i64 = 3

fn main() = {
    checked(0)
    written(0)
}
