// How many is a method on everything that has a length:
// `.len` written as the field it was for an array, a slice, a `str` and a
// `Vec` is reported with the fix, `len()`.

fn count(values: &[i64]): i64 = values.len

fn main(): i64 = {
    val array = [1, 2, 3]
    val vector = Vec::of(own [1, 2])
    array.len + "abc".len + vector.len + count(&array)
}
