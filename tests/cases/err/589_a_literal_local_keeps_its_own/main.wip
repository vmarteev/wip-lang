// A local of a number literal whose first use says nothing of its type
// keeps the literal's own, and a later use that wants another is refused,
// with where the first use was and how to write the type: a method on it,
// an operand beside a literal, a lambda.

fn half(x: f32): f32 = x / 2.0

fn main() = {
    val halfX: f32 = 2.0
    var loudest = 0.0
    loudest = loudest.max(1.0)
    val a = loudest * halfX
    val size = 3.0
    val twice = size * 2.0
    val h = half(size)
    val count = 0
    val later = () => count + 1
    val small: u8 = count
}
