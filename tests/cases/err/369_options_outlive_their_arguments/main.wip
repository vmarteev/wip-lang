// What a function reads from C strings borrows the array they are in, so
// the array may not change while it is used (E0436).

fn first(args: &[cstring]): str = args[1].toStr()

fn main() = {
	var given: [cstring; 2] = ["prog", "a.txt"]
	val name = first(&given)
	given[1] = "b.txt"
	assert(name.len() == 5)
}
