// An array's length may be a top-level `val`, which must be
// a whole number that is known where it is written.

val NEGATIVE = -1
val NOT_A_NUMBER = true
val TOO_LARGE: u128 = (1 as u128) << 100

struct Negative {
    xs: [i64; NEGATIVE]
}

struct NotANumber {
    xs: [i64; NOT_A_NUMBER]
}

struct Missing {
    xs: [i64; MISSING]
}

struct TooLarge {
    xs: [i64; TOO_LARGE]
}

fn main() = {}
