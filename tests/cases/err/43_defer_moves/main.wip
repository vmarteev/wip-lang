// Moves and `defer` (E0404). A deferred
// expression runs where its block exits, so what it uses must still hold a
// value at every exit that runs it: the end of the block, or a `return`. Its
// own moves happen there too, newest `defer` first.

struct File {
    fd: i64
}

fn close(f: own<File>) = {}

fn show(f: &File) = {}

fn movedBeforeDeferRuns() = {
    val f = own File(fd: 1)
    defer show(&f)
    close(f)
}

fn movedBeforeReturn(flag: bool): i64 = {
    val f = own File(fd: 2)
    defer show(&f)
    if flag {
        close(f)
        return 1
    }
    0
}

fn maybeMoved(flag: bool) = {
    val f = own File(fd: 3)
    defer show(&f)
    if flag {
        close(f)
    }
}

fn newerDeferMovesFirst() = {
    val f = own File(fd: 4)
    defer show(&f)
    defer close(f)
}

fn movedByInnerDefer() = {
    val f = own File(fd: 5)
    {
        defer close(f)
    }
    show(&f)
}

fn movedInEveryIteration() = {
    val f = own File(fd: 6)
    var i = 0
    while i < 3 {
        defer close(f)
        i = i + 1
    }
}

fn fine() = {
    var f = own File(fd: 7)
    defer close(f)
    show(&f)
    close(f)
    f = own File(fd: 8)
}
