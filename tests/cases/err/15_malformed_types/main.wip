// Parser: malformed types. Each field has its own error; the parser recovers at
// the next line so all of them are reported. `[i64; n]` is not among them: an
// array's length may be a constant's name, and whether
// `n` is one is the checker's question, which this file never reaches.

struct Bad {
    a: own<i64
    b: [i64 4]
    c: [i64; n]
    d: &
}
