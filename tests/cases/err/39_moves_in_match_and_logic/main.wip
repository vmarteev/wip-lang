// Moves (E0404): a value given away in one `match` arm, or on the right of
// `&&`, may not have been, and is refused afterwards on the path where it
// was.

struct Key {
    code: i64
}

enum Mode {
    Keep
    Discard
}

fn consume(k: own<Key>): bool = {
    return true
}

fn byMatch(mode: Mode): i64 = {
    val k = own Key(code: 1)
    match mode {
        .Keep => {}
        .Discard => {
            consume(k)
        }
    }
    return k.code
}

fn byAnd(flag: bool): i64 = {
    val k = own Key(code: 2)
    val consumed = flag && consume(k)
    return k.code
}
