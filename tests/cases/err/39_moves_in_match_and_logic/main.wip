// Moves (E0402): a move in one `match` arm, or on the right of `&&`, may not
// happen, so the value is only possibly moved afterwards.

struct Key {
    code: i64
}

enum Mode {
    Keep
    Discard
}

fn consume(k: own<Key>): bool = {
    return true
}

fn byMatch(mode: Mode): i64 = {
    val k = own Key(code: 1)
    match mode {
        .Keep => {}
        .Discard => {
            consume(move k)
        }
    }
    return k.code
}

fn byAnd(flag: bool): i64 = {
    val k = own Key(code: 2)
    val consumed = flag && consume(move k)
    return k.code
}
