// A function C calls must be one C could have written: `@export("C")` holds its
// signature to what crosses, the only ABI is C's, and it belongs on a function.
// A C function pointer is the same rule one level down — what it points at must
// cross too, and a `str` cannot, since it would take two of C's parameters
// where the type says one. A struct by value cannot either: C would pass it in
// registers, and a Wip function value takes its address.

@export("C")
fn takesAVec(values: Vec<i64>): Vec<i64> = move values

@export("Rust")
fn wrongAbi(): i64 = 0

@export("C")
struct Point {
    x: i64
}

extern "C" {
    struct Pair {
        a: i64,
        b: i64
    }

    fn takesText(callback: (text: str) => i64)
    fn takesOwned(callback: (values: Vec<i64>) => i64)
    fn takesPair(callback: (pair: Pair) => i64)
    fn answersPair(callback: () => Pair)
}

fn main() = {}
