// What a range is refused for: a container whose elements are not in one
// slice (a `Deque`, a map's values), and one that lends a slice but has no
// positions for a range to count (a `Map`, an `Arena`), each told which; and
// a vector declared with `val`, written through its range or an element,
// told to be declared with `var`. And a struct or a variant of two or more
// fields built with a variable by position, before a named argument (E0331,
// whose fix names the field the variable is named for) and after one (E0122,
// as in any call).

import std::collections::{Arena, Deque, Map}

struct File {
    name: String
    fileNo: i64
}

enum Shape {
    Rect(width: i64, height: i64)
}

fn ranges() = {
    var queue: Deque<i64> = Deque()
    queue.pushBack(1)
    val a = &queue[0..1]
    var map: Map<String, i64> = Map()
    val b = &map.values()[0..1]
    val c = &map[0..1]
    var nodes: Arena<i64> = Arena()
    val d = &nodes[0..1]
}

fn written() = {
    val v: Vec<i64> = Vec::of(own [1, 2])
    v[0..1].fill(3)
    v[0] = 3
}

fn built(name: str, fileNo: i64) = {
    val width = 2
    val height = 3
    val shape = Shape::Rect(height, width: width)
    val file = File(fileNo, name: String::of(name))
    val other = File(fileNo, String::of(name))
}

// A parse error leaves its function unchecked, so it stands alone.
fn after(name: str, fileNo: i64) = {
    val last = File(name: String::of(name), fileNo)
}

fn main() = {}
