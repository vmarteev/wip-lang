// What a template refuses: text that is not a literal where it is
// expected, an option its `pushValue` does not take, a value it cannot
// write, and a hole given to a template that has no `pushValue`.

import std::markup::{Html}

struct Point {
	x: i64
}

struct Bare {
	text: String = String()
}

extend Bare: Template {
	static fn withCapacity(capacity: i64): Bare = Bare()

	var fn pushLiteral(text: str) = self.text.push(text)

	var fn pushBuilt(built: &Bare, implicit at: Location) = self.text.push(built.text.toStr())
}

fn main() = {
	val text: str = "<b>x</b>"
	val name = "Ada"
	val a: Html = text
	val b: Html = "<p>\(name, width: 8)</p>"
	val c: Html = "<p>\(Point(x: 1))</p>"
	val d: Bare = "a\(name)b"
}
