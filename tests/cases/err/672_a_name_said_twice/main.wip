// A named argument whose value is the variable of its name, `x: x`, is a
// warning (E0485), with the fix that writes it once, `x:`: in a build of a
// struct and of a variant, in a call, and for `panic`'s place. Left alone:
// a value that is more than the name, `x.clone()` or `&x`; a value of
// another name; an interpolation's width, whose option the program names
// once; and a pattern, which binds by name already.

struct Point {
    x: i64
    y: i64
}

struct Named {
    name: String
}

enum Shape {
    Rect(width: i64, height: i64)
}

fn area(width: i64, height: i64): i64 = width * height

fn size(values: &Vec<i64>): i64 = values.len()

fn check(ok: bool, implicit at: Location) = if !ok then panic("not ok", at: at)

fn main() = {
    val x = 1
    val y = 2
    val p = Point(x: x, y: y)
    val width = 3
    val height = 4
    val shape = Shape::Rect(width: width, height: height)
    val a = area(height: height, width: width)
    val name: String = "ann"
    val named = Named(name: name.clone())
    val values: Vec<i64> = [1]
    val counted = size(values: &values)
    val other = Point(x: y, y: x)
    val line = "\(a, width: width)"
    val sides = match shape {
        .Rect(width: width, height: height) => width + height
    }
    check(p.x + other.x + sides + counted == 11 && named.name == name && line.len() == 3)
}
