// Only a variant of one field is a function. One of two fields is refused
// where a function is expected, with the lambda that builds it naming each;
// one without fields is a value, refused there too; and one of one field
// where its enum is expected is still missing its field.

enum Failure {
    Io(code: i64)
    Parse(at: i64, why: String)
    Gone
}

fn main() = {
    val parsed = [1].copies().map(Failure::Parse).toVec()
    val gone = [1].copies().map(Failure::Gone).toVec()
    val failure: Failure = Failure::Io
}
