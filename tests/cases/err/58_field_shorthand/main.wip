// The field shorthand `Size { width }`, in braces: E0133's fix writes it as a
// call, `width: width`. A field with neither `:` nor the end of the braces
// after it is still E0101.

struct Size {
    width: i64
    height: i64
}

fn noSuchVariable(): i64 = {
    val width = 1
    val s = Size { width, height }
    s.width
}

fn missingColon(): i64 = {
    val s = Size { width 1, height: 2 }
    s.width
}
