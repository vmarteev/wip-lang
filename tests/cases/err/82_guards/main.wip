// Errors with guards: an `else` block that can reach its end
// (E0334), and a binding used in the `else` block (E0203).

enum Maybe<T> {
    Some(value: T)
    None
}

fn first(a: Maybe<i64>): i64 = {
    val .Some(x) = a else {
        0
    }
    x
}

fn second(a: Maybe<i64>): i64 = {
    val .Some(y) = a else {
        return y
    }
    y
}

fn main(): i64 = 0
