// An owned closure, `own<(…) => R>`, is written with `own`, captures by
// value, and follows the rules of every other value that owns memory.

import std::io

fn plain(f: (x: i64) => i64, n: i64): i64 = f(n)

fn lent(f: &(x: i64) => i64, n: i64): i64 = f(n)

fn capturesRef(items: &[i64]): own<(i: i64) => i64> =
    own (i) => items[i]             // a reference does not outlive the call

fn writes(): own<(x: i64) => i64> = {
    var total = 0
    own (x) => {                    // it reads what it captured
        total += x
        total
    }
}

fn intoPlain(): i64 = plain(own (x) => x + 1, 2)

fn intoLent(): i64 = lent(own (x) => x + 1, 2)

fn missingOwn(n: i64): own<(x: i64) => i64> = (x) => x + n

fn noTypes(): i64 = {
    val f = own (x) => x + 1        // nothing says what `x` is
    f(1)
}

fn main() = {
    io::printInt(intoPlain())
}

