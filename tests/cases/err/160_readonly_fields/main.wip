// A `pub` field is read by another module and written by the one that
// declares it. Writing one, borrowing it `&var` and
// setting it in a literal are all writing, and so is leaving it out of a
// literal: the value is built where the field is written.

import counter::{Counter}
import std::io

fn bump(n: &var i64) = n = 99

fn main() = {
    var c = Counter::upTo(5)

    io::printInt(c.n)
    c.n = 9
    c.n += 1
    bump(&var c.n)

    val built = Counter(n: 1, limit: 2)
    val short = Counter(limit: 2)
}
