// A field another module cannot name is one it cannot read, write,
// build or take apart. The report says where the field
// was declared and how to export it.

import counter::{Counter}
import std::io

fn main() = {
    var c = Counter::upTo(5)

    io::printInt(c.n)
    c.n = 9

    val built = Counter(n: 1, limit: 2)
    val short = Counter(limit: 2)

    val Counter(n, ..) = c
    io::printInt(n)
}
