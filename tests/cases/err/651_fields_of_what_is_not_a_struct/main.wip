// What `c::fieldsOf` refuses: no struct named, a type that is not a
// struct, a type parameter, whose layout a generic does not know, and an
// `@opaque` struct, whose layout is C's and which no value has.

import std::c

@header("config.h")
@opaque
extern struct Config {
    mode: c_uint,
}

fn counted<T>(): i64 = c::fieldsOf<T>().len()

fn main() = {
    assert(c::fieldsOf().len() == 0)
    assert(c::fieldsOf<i64>().len() == 0)
    assert(c::fieldsOf<Config>().len() == 0)
    assert(counted<i64>() == 0)
}
