// A constant table is kept in memory nothing writes, so an
// element assigned, a method that changes it, and a `&var` of it are each
// refused, and the message says to change a copy.

val TABLE: [i64; 3] = [1, 2, 3]

fn bump(values: &var [i64]) = {
    values[0] += 1
}

fn main() = {
    TABLE[0] = 5
    TABLE.reverse()
    bump(&var TABLE)
    var copy = TABLE
    copy[0] = 5
}
