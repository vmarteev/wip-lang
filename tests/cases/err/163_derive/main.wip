// `@derive` names the interfaces the compiler writes from a type's fields:
// `Eq`, `Ord`, `Hash` and `Text`, each once. The four
// annotations it replaced are reported with the form that replaced them,
// and an interface the compiler cannot write is reported with the ones it
// can.

interface Shape {
    fn area(): i64
}

@eq @hash
struct Old {
    n: i64
}

@derive(Shape)
struct Unknown {
    n: i64
}

@derive(Eq, Eq)
struct Twice {
    n: i64
}

// Written on two lines, it is still one list, so a name twice across them
// is the same mistake.
@derive(Eq)
@derive(Hash, Eq)
struct Across {
    n: i64
}

@derive()
struct Nothing {
    n: i64
}

@derive("Eq")
struct Quoted {
    n: i64
}

fn main() = {}
