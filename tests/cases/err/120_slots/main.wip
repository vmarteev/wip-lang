// `Slots<T>` is the prelude's: a block of slots that hold
// nothing is the one place in Wip where memory holds no value, and only the
// prelude may name it. A program uses `Vec<T>`, which is written on top of
// it — in Wip.

import std::io

fn raw(): i64 = {
    var block: Slots<i64> = Slots<i64>::alloc(4)
    0
}

@intrinsic
fn mine(): i64

fn main() = {
    io::printInt(raw())
}
