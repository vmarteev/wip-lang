// An `own<T>` implements what is written for a box, as the prelude writes
// `Clone`, `Eq` and `Text` where its `T` has them, and none of what its `T`
// alone does: a method is looked up through it, as a field is, and a
// constraint is not. A box clones where what it holds does, so a field
// that boxes what cannot be cloned is refused by `@derive(Clone)` (E0440),
// with the chain that says why; and an `own<Square>` given where `T: Area`
// is asked for, an interface nothing writes for a box, is refused (E0342),
// with a note that `&` lends the `Square` where a type argument written
// out asks for one. Both compiled once, and stopped the code generator,
// which had no implementation to call.

import std::io

struct Plain {
    name: String
}

@derive(Clone)
struct Holder {
    inner: own<Plain>
}

interface Area {
    fn area(): i64
}

struct Square {
    side: i64
}

extend Square: Area {
    fn area(): i64 = self.side * self.side
}

fn total<T: Area>(a: &T, b: &T): i64 = a.area() + b.area()

fn main() = {
    val a = own Square(side: 1)
    val b = own Square(side: 2)
    io::println("\(total(&a, &b))")
    io::println("\(total<Square>(&a, &b))")
}
