// A `dyn` is only behind `&` or `&var`, inside a type's arguments too:
// `Vec<own<dyn Shape>>` is refused wherever a type is written, in a field,
// a parameter, a result, a function type, a constant and a local, and the
// error points at the `dyn`. `Vec<&dyn Shape>` is allowed.

interface Shape {
    fn area(): i64
}

struct Box<T> {
    item: T
}

struct Scene {
    shapes: Vec<own<dyn Shape>>             // in a field
    first: Option<own<dyn Shape>>
    pick: (shape: dyn Shape) => i64         // a function type's parameter
    make: () => Option<own<dyn Shape>>      // and its result
}

fn largest(shapes: &Vec<own<dyn Shape>>): i64 = 0  // a parameter

fn chosen(): Option<own<dyn Shape>> = .None         // a result

val NONE: Option<own<dyn Shape>> = .None            // a constant

fn total(shapes: &Vec<&dyn Shape>): i64 = 0         // allowed

fn main() = {
    val kept: Option<Box<own<dyn Shape>>> = .None   // a local
    val none: [own<dyn Shape>; 0] = []              // and no second error for the empty list
    val lent: Vec<&dyn Shape> = Vec()               // allowed
    assert(total(&lent) == 0)
}
