// Slices (E0416, E0417, E0309, E0412, E0301): a slice type without `&`, a range
// of elements that is not borrowed (fix: add `&`), a range of something that is
// not an array, `&var` on elements that cannot change, and an array passed
// where a slice is expected but without `&` (fix: add it).

struct Window {
    rows: [i64]
}

fn total(xs: [i64]): i64 = 0

fn sum(xs: &[i64]): i64 = xs.len()

fn fill(xs: &var [i64]) = {}

fn main(): i64 = {
    val xs = [1, 2, 3, 4]
    val part = xs[1..3]
    val n = 5
    sum(&n[0..1])
    fill(&var xs[0..2])
    sum(xs)
    0
}
