// `keeps self` names a method's receiver where it is `&` or a value: not a
// `var fn`'s, whose contents are lent for the call alone; not in a `static
// fn` or a function, which have none; and an implementation keeps no more
// than its interface says (E0449).

view struct Label {
    text: str
}

struct Shelf {
    names: Vec<String>
}

extend Shelf {
    var fn written(labels: &var Vec<Label>) keeps self = {}

    static fn none(labels: &var Vec<Label>) keeps self = {}
}

fn alone(labels: &var Vec<Label>) keeps self = {}

interface Labels {
    fn labelled(labels: &var Vec<Label>)
}

extend Shelf: Labels {
    fn labelled(labels: &var Vec<Label>) keeps self = {}
}

fn main() = {}
