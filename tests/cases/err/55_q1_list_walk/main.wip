// The natural loop over a linked list. It needs a
// variable that refers to the current node, which second-class references do
// not allow. The list cannot be copied out of the reference
// (E0405), `at` cannot change while `tail` refers into it (E0414), and `tail`
// cannot be moved out of its binding (E0405). Holding `&list` in a variable
// is E0411 (err/46); ok/51 walks lists by recursion, or consumes them.

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

fn sum(list: &own<List>): i64 = {
    var total = 0
    var at = list
    var done = false
    while !done {
        match at {
            .Cons(head, tail) => {
                total = total + head
                at = move tail
            }
            .Nil => done = true
        }
    }
    total
}
