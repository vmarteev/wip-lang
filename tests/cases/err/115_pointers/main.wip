// What a C pointer is, and is not: `ptr<T>` takes one type
// argument, an opaque C type is only ever written behind it, `null` takes
// its type from what is expected, and Wip knows nothing about what a
// pointer points at.

import std::io

extern "C" {
    type Db
    fn db_rows(db: ptr<Db>): i64
}

struct Holder {
    db: Db                          // no value of a C type exists
}

fn opaque(db: Db): i64 = 0          // nor as a parameter

fn arguments(p: ptr): i64 = 0       // `ptr` needs to say what it points at

fn two(p: ptr<Db, i64>): i64 = 0    // and only one thing

fn loose(): i64 = {
    val p = null                    // nothing says which pointer
    0
}

fn fields(p: ptr<Db>): i64 = {
    if p.rows { 1 } else { 0 }      // Wip does not know what is there
}

fn narrow(p: ptr<Db>): i32 = p as i32

fn main() = {
    io::printInt(loose())
}
