// A keyword names a field and nothing else (E0101): a pattern's field
// written alone would bind a variable of the keyword's name, and is told
// to bind it under a name of its own; a parameter, a variable and a
// function named by a keyword are refused as before.

enum Shape {
    Opening(type: i64)
}

fn kind(shape: Shape): i64 = match shape {
    .Opening(type) => 1
}

fn twice(when: i64): i64 = when * 2

fn main() = {
    val then = 1
}
