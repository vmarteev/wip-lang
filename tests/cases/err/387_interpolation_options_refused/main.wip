// A piece of an interpolation is written to a precision or in a radix, not
// both; a fill needs a width; upper-case digits need a radix; and an
// option it does not take is named.

fn main() = {
    val x = 1.5
    val n = 7
    val both = "\(x, precision: 2, radix: 16)"
    val filled = "\(n, fill: '0')"
    val unknown = "\(n, base: 2)"
    val shouted = "\(n, upper: true)"
}
