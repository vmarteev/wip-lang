// What conversion will not do. `?` finds the conversion a
// program wrote and nothing else; an interface that takes types cannot be
// a `&dyn` or constrain a type parameter yet; and where a type implements
// one more than once, what is passed says which is meant.

import std::io

enum AppError {
    Bad
}

struct Meters { n: i64 }

extend Meters: From<i64> {
    static fn from(value: i64): Meters = Meters(n: value)
}

extend Meters: From<bool> {
    static fn from(value: bool): Meters = Meters(n: 0)
}

// No `extend AppError: From<i64>`, so `?` has nothing to use.
fn count(): Result<i64, i64> = .Err(2)

fn total(): Result<i64, AppError> = {
    val n = count()?
    return .Ok(n)
}

// An interface that takes types is not a table of methods.
fn measure(m: &dyn From): i64 = 0

// A constraint must say which types the interface takes.
fn build<T: From>(n: i64): i64 = 0

fn main() = {
    // Which `from`? Nothing takes a `str`.
    val far = Meters::from("two")
}
