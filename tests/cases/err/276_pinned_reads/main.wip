// What C holds and calls back with is read through a `&`:
// C may call on a thread of its own while the program reads, so a change
// goes through an `Atomic` or a `Mutex` in it, and a plain field is not
// written.

import std::c

struct Watched {
	count: i64
}

fn told(data: ptr<void>) = c::pinnedAt<Watched, void>(data, (watched) => { watched.count += 1 })

fn main() = {
	val shared = c::Pinned::of(Watched(count: 0))
	told(shared.address())
	shared.value().count = 5
}
