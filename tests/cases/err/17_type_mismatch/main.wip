// Types (E0301, E0303): each mismatch points at the expression and at where the
// expected type comes from. An integer literal where a float is expected gets
// a `.0` fix.

import std::io

fn half(x: f64): f64 = {
    return x / 2
}

fn main(): i64 = {
    val flag: bool = 1
    io::printFloat(3)
    val h = half(true)
    return 1.5
}
