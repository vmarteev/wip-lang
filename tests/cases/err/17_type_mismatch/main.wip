// Types (E0301, E0303): each mismatch points at the expression and at where the
// expected type comes from. An integer the program holds is not a float where
// one is expected, nor beside one, as a literal would be.

import std::io

fn share(x: f64, parts: i64): f64 = {
    return x / parts
}

fn main(): i64 = {
    val flag: bool = 1
    val count: i64 = 3
    io::printFloat(count)
    val h = share(true, 2)
    return 1.5
}
