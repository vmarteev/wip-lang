    val found: Option<i64> = .None
    val p = Point(x: 0, y: 5)
    val n = 3
    val a = n is _
    val b = n is m
    val c = p is Point(x, y)
    val d = found is .Some(..) | .None
    val e = n is ..0 | 0..
    val f = found is .Some(k)
}
