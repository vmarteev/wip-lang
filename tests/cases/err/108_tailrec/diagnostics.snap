[E0421] Error: `neverRecurses` never calls itself
    ╭─[ err/108_tailrec/main.wip:34:4 ]
    │
 34 │ fn neverRecurses(n: i64): i64 = n + 1
    │    ──────┬──────
    │          ╰──────── no call to itself
    │
    │ Help: remove `@tailrec`
    │
