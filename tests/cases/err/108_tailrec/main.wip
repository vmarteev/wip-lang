// `@tailrec` promises that every call a function makes to itself is a jump
// back to the top. Where it cannot be, the compiler says so
// rather than quietly growing the stack.

import std::io

struct Node {
    id: i64
}

fn total(xs: &[i64]): i64 = xs[0]

@tailrec
fn notTail(n: i64): i64 = if n == 0 { 0 } else { 1 + notTail(n - 1) }

@tailrec
fn asArgument(n: i64): i64 = if n == 0 { 0 } else { total([asArgument(n - 1)]) }

@tailrec
fn borrowsFrame(n: i64, acc: i64): i64 = {
    val xs = [1, 2, 3]
    if n == 0 { acc } else { borrowsFrame(n - 1, acc + total(&xs)) }
}

@tailrec
fn lendsAClosure(n: i64, acc: i64): i64 = {
    val base = acc
    if n == 0 { acc } else { lendsAClosure(n - 1, apply((x) => x + base, n)) }
}

fn apply(f: &(x: i64) => i64, n: i64): i64 = f(n)

@tailrec
fn neverRecurses(n: i64): i64 = n + 1

@tailrec
fn first(xs: &var [i64]): &var i64 = lend xs[0]

fn main() = {
    io::printInt(notTail(3))
}

