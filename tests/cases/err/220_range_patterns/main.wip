// What a range pattern is refused for: a range with
// nothing in it, one of a type with no order, an end of another type or
// not a constant; and what a `match` of ranges leaves out, or reaches no
// value with.

val NAME: str = "x"

fn backwards(c: char): i64 = match c {
    '9'..='0' => 1
    _ => 0
}

fn empty(n: i64): i64 = match n {
    5..5 => 1
    _ => 0
}

fn float(x: f64): i64 = match x {
    0..=1 => 1
    _ => 0
}

fn text(n: i64): i64 = match n {
    0..=NAME => 1
    _ => 0
}

fn unknown(n: i64): i64 = match n {
    0..=NOWHERE => 1
    _ => 0
}

fn mixed(c: char): i64 = match c {
    'a'..=5 => 1
    _ => 0
}

fn inside(c: char): i64 = match c {
    'a'..='z' => 1
    'a'..='f' => 2
    _ => 0
}

fn upper(n: i64): i64 = match n {
    ..0 => 1
    0..=9 => 2
}

fn lower(b: u8): i64 = match b {
    10.. => 1
}

fn gap(c: char): i64 = match c {
    ..='a' => 1
    'c'.. => 2
}

fn main() = {}
