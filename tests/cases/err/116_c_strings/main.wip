// A `cstring` answers nothing by itself: what it holds is found by walking
// it, which is what `toStr()` does.

import std::io

extern "C" {
    fn text_greeting(): cstring
}

fn notCalled(): i64 = text_greeting().toStr          // a method, not a field

fn arguments(): i64 = text_greeting().toStr(1).len()   // it takes none

fn length(): i64 = text_greeting().len()               // walk it first

fn alreadyText(): i64 = "literal".toStr().len()        // a `str` is text already

fn main() = {
    io::printInt(length())
}

