// `Vec::of` of a list written there, `[…]` or `own […]`, where a `Vec` was
// expected before the call was checked, is a warning (E0484), with the fix
// that writes the list alone, which is that `Vec` there: in a field, an
// argument, a `val` of its type and a branch. Left alone: a `val` with no
// type, where a list alone would be an array; a buffer held elsewhere,
// which a list in its place would not be; and a receiver.

import std::io

struct Call {
    args: Vec<i64>
}

fn total(values: Vec<i64>): i64 = values.copies().sum()

fn some(many: bool): Vec<i64> = if many then Vec::of([1, 2, 3]) else Vec::of(own [1])

fn main() = {
    val call = Call(args: Vec::of([1]))
    val sum = total(Vec::of(own [2, 3]))
    val names: Vec<str> = Vec::of(["a", "b"])
    val plain = Vec::of([4, 5])
    val buffer: own<[i64]> = own [6, 7]
    val held: Vec<i64> = Vec::of(buffer)
    val long = Vec::of([8]).len()
    io::println("\(call.args.len()) \(sum) \(names[1]) \(plain.len()) \(held.len()) \(long) \(some(true).len())")
}
