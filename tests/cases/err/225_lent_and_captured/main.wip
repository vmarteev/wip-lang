// A lent closure refers to what it captured while the call may call it,
// so it may not capture what the same call is given `&var`: not a value
// lent to C, and not a place passed beside it.

import std::c

struct Tally {
    total: i64 = 0
}

fn both(target: &var i64, read: &() => i64): i64 = {
    target += 1
    return read()
}

fn main() = {
    var tally = Tally()
    val doubled = c::lending(&var tally, (data) => tally.total * 2)
    var x = 1
    val seen = both(&var x, () => x)
}
