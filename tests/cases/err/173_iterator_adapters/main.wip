// An adapter keeps its closure, which is owned, so it cannot capture a `str` it
// would outlive (E0427); a consumer's closure is lent, and may.

fn kept(prefix: str) = {
    val text = "alpha beta"
    for w in text.split(" ").filter(own (w) => w.startsWith(prefix)) {}
    val found = text.split(" ").find((w) => w.startsWith(prefix))
}

fn main() = {}
