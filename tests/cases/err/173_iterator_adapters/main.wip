// An adapter holds its closure lent, as a view does, and the closure reads:
// one that writes what it captures is refused (E0304), where a consumer's
// may write, and `own` at an adapter is refused with the fix that leaves it
// out (E0301). What a chain may not leave is `err/542`.

fn writes(text: str): i64 = {
    var seen = 0
    return text.split(" ").map((w) => {
        seen += 1
        return w.len()
    }).count()
}

fn owned(text: str): i64 = text.split(" ").map(own (w) => w.len()).count()

fn main() = {}
