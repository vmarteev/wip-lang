// What the parser refuses of a `when` (E0101): `else` before another arm,
// two `else`s, an arm with no condition, and a value after `when`, with the
// fix that writes the `match` it means.

fn main() = {
    val n = 3
    when {
        else => {}
        n > 1 => {}
    }
    when {
        n > 1 => {}
        else => {}
        else => {}
    }
    when {}
    when n {
        1 => {}
        _ => {}
    }
}
