// What a variant's field defaults refuse, as a struct's and a parameter's do: a
// value that is not of the field's type. A variant built without a field that
// has none is told which it lacks, and one written without parentheses, whose
// fields all have defaults, is told to write `()`.

enum Boxed<T> {
    Full(value: T = 0),
    Empty,
}

enum Shape {
    Circle(radius: i64 = 1),
    Rect(width: i64 = 80, height: i64),
}

fn main() = {
    val a = Shape::Circle
    val b = Shape::Rect()
}
