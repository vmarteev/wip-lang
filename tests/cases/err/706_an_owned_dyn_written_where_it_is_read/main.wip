// A `var fn` called through an owned `dyn` writes the value, so the owned
// `dyn` must be in a place the call may write: not a `val`, and not one
// reached through a `&`.

interface Counter {
    var fn bump()
}

struct Count {
    n: i64
}

extend Count: Counter {
    var fn bump() = self.n += 1
}

fn throughShared(counter: &own<dyn Counter>) = counter.bump()

fn main() = {
    val counter: own<dyn Counter> = own Count(n: 0)
    counter.bump()
}
