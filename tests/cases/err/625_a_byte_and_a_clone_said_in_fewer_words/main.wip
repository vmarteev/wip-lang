// A character literal made a byte is warned of (E0468), with the fix that
// writes the byte literal, escapes and all; a character that is not ASCII,
// or a cast to another integer type, is left alone. `@derive(Clone)` on
// plain data, which is its own clone, is warned of (E0467): a struct of
// numbers, and a generic type whose parameter no field holds. A generic
// type that holds its parameter, and one that owns memory, keep it.

@derive(Clone, Eq)
struct Point {
    x: i64
    y: i64
}

@derive(Clone)
struct Id<T> {
    number: u32
}

@derive(Clone, Eq)
struct Pair<T> {
    first: T
    second: T
}

@derive(Clone)
struct Named {
    name: String
}

fn main() = {
    val open = '[' as u8
    val newline = '\n' as u8
    val quote = '\'' as u8
    val wide = 'x' as u32
    val accented = 'é' as u8
    assert(open == b'[' && newline == 10 && quote == 39 && wide == 120 && accented == 0xE9)
}
