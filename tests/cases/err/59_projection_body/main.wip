// A projection's body (E0418, E0419). `lend` belongs in a
// projection; every path through it lends, all of them lend a place in
// the same reference parameter, and it ends by lending rather than
// returning. A body that forgets to lend, or returns a value, also
// mismatches its declared result, so those report twice. What a `&`
// projection lends only reads, so borrowing it `&var` is E0412.

struct Item {
    weight: i64
}

struct Bag {
    items: [own<Item>; 2]
}

fn stray(): i64 = lend 1

fn somePaths(bag: &var Bag, flag: bool): &var Item = {
    if flag {
        lend bag.items[0]
    }
}

fn differentParameters(a: &var Bag, b: &var Bag, flag: bool): &var Item = if flag {
    lend a.items[0]
} else {
    lend b.items[0]
}

fn returnsInstead(bag: &var Bag): &var Item = {
    return bag.items[0]
    lend bag.items[0]
}

fn notAParameter(bag: &Bag): &Item = {
    val temp = Item(weight: 1)
    lend temp
}

fn writesAReadOnlyPlace(bag: &Bag): &var Item = lend bag.items[0]

fn cleansUp(bag: &var Bag): &var Item = {
    defer bag.items[1].weight = 0
    lend bag.items[0]
}

fn forgets(bag: &Bag): &Item = bag.items[0]

fn grow(item: &var Item) = {}

fn readOnly(bag: &Bag): &Item = lend bag.items[0]

fn writeThroughARead(bag: &Bag) = {
    grow(&var readOnly(&bag))
}
