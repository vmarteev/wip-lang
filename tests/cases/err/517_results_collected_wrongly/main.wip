// An iterator that hands out what a constraint's argument does not match
// is refused where it is given (E0342): texts where results are collected,
// and numbers where pairs make a map.

import std::collections::{Map}

fn main() = {
    val texts: Vec<str> = Vec::of(own ["1", "2"])
    val numbers = Result::collect(texts.walk())
    val counts: Vec<i64> = Vec::of(own [1, 2])
    val map = Map::fromPairs(counts.walk())
}
