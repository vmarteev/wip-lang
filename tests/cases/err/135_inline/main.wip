// `@inline` is a promise the compiler keeps or refuses.
// A function that reaches itself could never be spliced, a call through a
// value has no callee to splice, and a C declaration has no body at all.

@inline
fn ping(n: i64): i64 = if n == 0 { 0 } else { pong(n - 1) }

@inline
fn pong(n: i64): i64 = ping(n)

@inline
fn double(n: i64): i64 = n * 2

extern "C" {
    @inline
    fn abs(n: c_int): c_int
}

fn apply(f: &(n: i64) => i64, to: i64): i64 = f(to)

fn main() = {
    val used = apply(double, 3)
}
