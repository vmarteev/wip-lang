// Errors with `is` tests: a binding nothing after it can
// use — a test alone, or the last of its chain under `||` or `!` (E0333);
// a pattern that is not a variant (E0313); a binding used in the `else` or
// after the `if` (E0203); a variant tested on a value that is not an enum
// (E0315); and a write through the binding of a place that cannot be written
// (E0304).

enum Maybe<T> {
    Some(value: T)
    None
}

fn read(option: &Maybe<i64>) = {
    if option is .Some(x) {
        x = 2
    }
}

fn main(): i64 = {
    val a: Maybe<i64> = .Some(1)
    val b = a is .Some(x)
    if a is .None || a is .Some(y) {
        0
    }
    if !(a is .Some(z)) {
        0
    }
    if a is value {
        0
    }
    if a is .Some(w) {
        w
    } else {
        w
    }
    val after = w
    val n = 5
    if n is .Some(..) {
        0
    }
    0
}
