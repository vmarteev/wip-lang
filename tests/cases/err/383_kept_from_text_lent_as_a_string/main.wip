// What a call answers that points into the `String` text is lent as is
// borrowed from a temporary: used in the statement it is, and kept past it
// it is refused, as it is for `&String::of(…)`.

fn firstWord(text: &String): str = text.toStr().split(" ").next().unwrapOr("")

fn main() = {
	assert(firstWord("a b") == "a")
	val kept = firstWord("c d")
	assert(kept == "c")
}
