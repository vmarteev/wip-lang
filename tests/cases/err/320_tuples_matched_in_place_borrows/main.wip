// What an arm binds of a tuple matched in place refers into the elements'
// places, which cannot be assigned while it does.

enum Shape {
    Circle(radius: i64)
    Named(name: String)
}

fn main() = {
    var p = Shape::Named(name: String::of("p"))
    val q = Shape::Circle(radius: 1)
    val length = match (p, q) {
        (.Named(name: n), _) => {
            p = Shape::Circle(radius: 2)
            n.len()
        }
        _ => 0
    }
}
