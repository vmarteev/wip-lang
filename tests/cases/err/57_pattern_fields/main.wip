// Binders name their fields: a field the variant does not
// have, a field named twice, fields left out without `..`, `_` where a field
// name belongs, `..` before another binder, and a `.Variant` with nothing to
// tell which enum it belongs to.

struct Point {
    x: f64
    y: f64
}

enum Shape {
    Circle(center: Point, radius: f64)
    Rect(min: Point, max: Point)
}

fn unknownField(s: &Shape): f64 = match s {
    .Circle(radius, colour) => radius
    .Rect(min, max) => max.x - min.x
}

fn namedTwice(s: &Shape): f64 = match s {
    .Circle(radius, radius: again) => radius + again
    .Rect(min, max) => max.x - min.x
}

fn notEveryField(s: &Shape): f64 = match s {
    .Circle(radius) => radius
    .Rect(min) => min.x
}

fn underscore(s: &Shape): f64 = match s {
    .Circle(_, radius) => radius
    .Rect(min, max) => max.x - min.x
}

fn restFirst(s: &Shape): f64 = match s {
    .Circle(.., radius) => radius
    .Rect(min, max) => max.x - min.x
}

fn noExpectedType(): f64 = {
    val s = .Circle(Point(x: 0.0, y: 0.0), 1.0)
    0.0
}
