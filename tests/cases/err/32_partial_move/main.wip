// Moves (E0404): giving away one field of a struct leaves the other fields
// usable, but not the one given.

struct Engine {
    power: i64
}

struct Car {
    engine: own<Engine>
    seats: i64
}

fn scrap(e: own<Engine>) = {}

fn main(): i64 = {
    val car = Car(engine: own Engine(power: 150), seats: 4)
    scrap(car.engine)
    val seats = car.seats
    val power = car.engine.power
    return seats
}
