// A projection that lends a parameter's place on any path holds the
// argument, even where another path lends a table.

val DEFAULT: [i64; 2] = [0, 0]

struct Mode {
	values: [i64; 2] = [5, 6]
	set: bool = true
}

fn values(mode: &Mode): &[i64] = if mode.set { lend mode.values } else { lend DEFAULT }

fn change(mode: &var Mode, seen: &[i64]) = {
	mode.set = seen[0] > 0
}

fn main() = {
	var mode = Mode()
	change(&var mode, &values(&mode))
}
