// Writable bindings keep the rules of references. A binding
// cannot be moved out of, even a writable one (E0405). A `&var` binding
// cannot be passed next to another reference to the matched place (E0413).
// A nested `match` on a binding keeps that binding from changing while its
// own bindings refer into it (E0414), where they are written through.
// `fine` writes through the bindings of both matches, which is allowed.

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

fn consume(list: own<List>) = {}

fn both(a: &var own<List>, b: &List) = {}

fn show(x: &i64) = {}

fn take(list: &var List) = match list {
    .Cons(tail, ..) => consume(move tail)
    .Nil => {}
}

fn overlap(list: &var List) = match list {
    .Cons(tail, ..) => both(&var tail, &list)
    .Nil => {}
}

fn nested(list: &var List) = match list {
    .Cons(tail, ..) => match tail {
        .Cons(head: next, ..) => {
            tail = own List::Nil
            next += 1
            show(&next)
        }
        .Nil => {}
    }
    .Nil => {}
}

fn fine(list: &var List) = match list {
    .Cons(head, tail) => match tail {
        .Cons(head: next, ..) => {
            head = next
            next = 0
        }
        .Nil => tail = own List::Cons(head, tail: own List::Nil)
    }
    .Nil => {}
}
