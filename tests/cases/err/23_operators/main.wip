// Operators (E0303, E0310): operands of the wrong type, mixed numeric
// types (with a `.0` fix for the integer literal), `!` on a float, comparing
// structs, `^` on floats, and an integer literal out of range. (`%` on
// floats is C's `fmod`.)
// `-9223372036854775808` is fine.

struct Point {
    x: i64
}

fn main(): i64 = {
    val a = true + false
    val b = 1.5 * 2
    val c = -true
    val d = !5.0
    val p = Point(x: 1)
    val q = Point(x: 1)
    val same = p == q
    val r = 5.0 ^ 2.0
    val big = 9223372036854775808
    val min = -9223372036854775808
    return 0
}
