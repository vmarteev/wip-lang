// A guard on a place binds aliases for its fields: a binding only read
// holds the place to its last use, so one used after the place is
// assigned is refused (E0436).

enum Maybe<T> {
    Some(value: T)
    None
}

struct Token {
    id: i64
}

fn main(): i64 = {
    var slot: Maybe<own<Token>> = .Some(own Token(id: 1))
    {
        val .Some(token) = slot else {
            return 0
        }
        slot = .None
        assert(token.id == 1)
    }
    slot = .None
    0
}
