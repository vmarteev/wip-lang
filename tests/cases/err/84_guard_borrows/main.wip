// A guard on a place binds aliases for its fields until the block ends:
// the place cannot be assigned before then (E0414).

enum Maybe<T> {
    Some(value: T)
    None
}

struct Token {
    id: i64
}

fn main(): i64 = {
    var slot: Maybe<own<Token>> = .Some(own Token(id: 1))
    {
        val .Some(token) = slot else {
            return 0
        }
        slot = .None
    }
    slot = .None
    0
}
