// `become` gives the frame to the call, so nothing of the frame may be left
// for after it (E0422): a local that still owns memory, or a `defer`. A
// value given to the call is not left.

fn counted(n: i64): i64 = n

fn owned(n: i64): i64 = {
    val text = String::of("a")
    become counted(n)
}

fn deferred(n: i64): i64 = {
    defer counted(1)
    become counted(n)
}

fn takesText(text: String, n: i64): i64 = n

fn given(text: String, n: i64): i64 = {
    become takesText(text, n)
}

fn main() = {}
