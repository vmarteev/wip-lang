// Match (E0311, E0312, E0321, E0313, E0207): a missing variant, an arm after
// a catch-all, a field the pattern does not name, a pattern from another
// enum, and a bare name that looks like a variant but binds everything.

enum Light {
    Red
    Yellow
    Green
}

enum Shape {
    Circle(radius: f64)
    Rect(w: f64, h: f64)
}

fn a(l: Light): i64 = {
    return match l {
        .Red => 0
        .Green => 2
    }
}

fn b(l: Light): i64 = {
    return match l {
        .Red => 0
        _ => 1
        .Green => 2
    }
}

fn c(s: Shape): f64 = {
    return match s {
        .Circle(radius: r) => r
        Shape::Rect(w) => w
    }
}

fn d(s: Shape): f64 = {
    return match s {
        Light::Red => 0.0
        _ => 1.0
    }
}

fn e(l: Light): i64 = {
    return match l {
        Red => 0
        .Yellow => 1
    }
}
