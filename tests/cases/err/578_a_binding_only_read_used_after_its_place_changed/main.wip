// A binding only read holds its place to its last use, so a use after the
// place changes is refused where it is (E0436): in an arm of a `match`,
// after a call that changes the place, in a `while` whose next pass reads
// a binding the last pass's change left behind, and after `val … else`.

struct Talk {
    who: String
}

struct Game {
    talking: Option<Talk>
    savesTo: Option<String>
}

extend Game {
    var fn stop() = {
        self.talking = .None
    }

    var fn inMatch(): i64 = match self.talking {
        .Some(talk) => {
            self.talking = .None
            talk.who.len()
        }
        .None => 0
    }

    var fn afterCall(): i64 = {
        if self.talking is .Some(talk) {
            self.stop()
            return talk.who.len()
        }
        return 0
    }

    var fn afterElse(): i64 = {
        val .Some(path) = self.savesTo else return 0
        self.savesTo = .None
        return path.len()
    }
}

fn inLoop(slot: &var Option<String>, seen: &var i64) = {
    if slot is .Some(name) {
        var pass = 0
        while pass < 2 {
            seen = seen + name.len()
            slot = .None
            pass = pass + 1
        }
    }
}

fn main() = {}
