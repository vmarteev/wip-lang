// Errors with function values: a function type in a C
// signature (E0314), a function type whose result is a reference (E0410), a
// mismatched function type (E0301), a projection as a value (E0208), a
// generic function whose type arguments cannot be inferred (E0315), calling
// a value that is not a function (E0306), and the wrong arguments through a
// function value (E0302, E0301). A closure type is no longer among them:
// `&(…) => R` and `&var (…) => R` work.

extern "C" {
    fn c_callback(f: (x: i64) => void)
}

struct Item {
    weight: i64
}

fn double(x: i64): i64 = x * 2

fn first(xs: &var [i64]): &var i64 = lend xs[0]

fn identity<T>(x: T): T = move x

fn apply(f: (v: i64) => i64, x: i64): i64 = f(x)

fn lent(f: &(v: i64) => i64): i64 = f(1)

fn lends(): (v: i64) => &i64 = double

fn main(): i64 = {
    val a = apply(double, 1, 2)
    val b: (v: i64) => bool = double
    val c = first
    val d = identity
    val x = 5
    val e = x(3)
    val f = double
    val g = f(1, 2)
    val h = f(true)
    0
}
