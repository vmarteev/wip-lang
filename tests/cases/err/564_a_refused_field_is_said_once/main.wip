// A field that borrows, in a struct that is not a view, is refused once:
// what is built of it, a vector it was to hold or a variant of an enum
// whose payload is refused, says nothing more of what it cannot infer.

struct Named<T> {
	names: Vec<(str, T)>
}

enum Held<T> {
	Labels(labels: Vec<(str, T)>)
	Nothing
}

fn main() = {
	val named: Named<i64> = Named(names: Vec())
	val held: Held<i64> = Held::Labels(labels: Vec())
}
