// A function of a type is not a value: `Type::name` written without a call
// is refused, with the call to write, whether the type is the program's, the
// prelude's, generic, named through an alias, implements an interface twice,
// or is a type parameter. Each line is also what an editor checks while the
// call is being typed.

struct Point {
	x: i64
	y: i64

	static fn origin(): Point = Point(x: 0, y: 0)
}

struct Box<T> {
	value: T

	static fn of(value: T): Box<T> = Box(value: value)
}

type Points = Box<Point>

enum Problem {
	Text(text: String)
	Number(value: i64)
}

extend Problem: From<String> {
	static fn from(text: String): Problem = .Text(move text)
}

extend Problem: From<i64> {
	static fn from(value: i64): Problem = .Number(value)
}

interface Unit {
	static fn unit(): Self
}

extend Point: Unit {
	static fn unit(): Point = Point(x: 1, y: 1)
}

fn unitOf<T: Unit>(): T = {
	val make = T::unit
	return T::unit()
}

fn main() = {
	val origin = Point::origin
	val text = String::of
	val boxed = Box<i64>::of
	val points = Points::of
	val problem = Problem::from
	val unit = unitOf<Point>()
}
