// A `lend` of a `lend`: what is lent is a place, and `lend` hands its place
// to the caller and ends there, as `return` does, so a second is refused,
// with the fix that takes it out.

struct Bag {
	items: [i64; 3]
}

fn first(bag: &var Bag): &var i64 = {
	lend lend bag.items[0]
}

fn main() = {
	var bag = Bag(items: [1, 2, 3])
	first(&var bag) = 5
}
