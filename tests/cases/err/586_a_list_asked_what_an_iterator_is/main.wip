// A list asked what an iterator is asked (E0337): `count`, where a list
// knows its length, `len`, and what `filter` keeps is counted by
// `countWhere`; and `toVec`, where `map` and `filter` answer a `Vec`
// already.

fn evens(events: &Vec<i64>): i64 = events.filter((e) => e % 2 == 0).count()

fn size(events: &Vec<i64>): i64 = events.count()

fn doubled(events: &Vec<i64>): Vec<i64> = events.map((e) => e * 2).toVec()

fn main() = {}
