// `for x in move c` takes each element, so `c` must give
// them up: an array lends its elements, and a type of a program's own
// that lends them gives up nothing until it says how.

struct Deck {
    cards: Vec<i64>
}

extend Deck: Items<i64> {
    fn items(): &[i64] = lend self.cards.items()
}

fn main() = {
    val numbers = [1, 2, 3]
    for n in move numbers {}
    val deck = Deck(cards: Vec())
    for card in move deck {}
}
