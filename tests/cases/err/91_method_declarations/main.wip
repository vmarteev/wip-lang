// A type's methods share one set of names, with each other and with its
// variants, a method's type parameter may not shadow one of its type's, and
// `self` names a receiver only where there is one.

struct Counter {
    count: i64

    fn get(): i64 = self.count
    fn get(): i64 = self.count + 1      // declared twice
    static fn start(): i64 = self.count // a `static fn` has no receiver
}

enum Shape {
    Circle(radius: i64)

    static fn Circle(): i64 = 0         // the name of a variant
}

struct Holder<T> {
    value: T

    fn map<T>(other: T): T = other      // the type's `T`
}

fn outside(): i64 = self.count

fn main() = {}
