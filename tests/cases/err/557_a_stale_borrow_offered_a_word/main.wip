// A view refused because what it borrows changed (E0436) is offered the
// word the callee could have said, where saying it would have kept the
// view good: `from self.ast` for a helper that answers from the tree the
// view holds a `&` to, `from a` for a function of two texts that answers
// from the first, and `empties` for a method that leaves the receiver
// holding nothing.

struct Ast {
	names: Vec<String>
}

view struct Lowerer {
	ast: &Ast
	errors: Vec<String>
}

extend Lowerer {
	fn text(i: i64): str = self.ast.names[i].toStr()
}

fn first(a: str, b: str): str = if a.isEmpty() then "?" else a

view struct Words {
	words: Vec<str> = Vec()
}

extend Words {
	var fn clear() = {
		self.words = Vec()
	}
}

fn main() = {
	val ast = Ast(names: ["ab"])
	var lowerer = Lowerer(ast: &ast, errors: Vec())
	val text = lowerer.text(0)
	lowerer.errors.push("the view changes; the text is the tree's")
	assert(text == "ab")

	var other = String::of("b")
	val named = first("a", other.toStr())
	other.push("!")
	assert(named == "a")

	var line = String::of("a b")
	var words = Words()
	for text in ["a b", "c"] {
		words.clear()
		line.clear()
		line.push(text)
		for word in line.toStr().split(" ") {
			words.words.push(word)
		}
	}
}
