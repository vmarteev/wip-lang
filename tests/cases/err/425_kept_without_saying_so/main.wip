// A call keeps nothing of its arguments but what its signature's `keeps`
// names, and a body is held to it: a view kept through a call that keeps
// it, one assigned through a `&var` parameter, and a value of a type
// parameter kept by a generic container, each without `keeps`, and each
// with the fix that names it.

view struct Words {
	words: Vec<str>
	first: str
}

extend Words {
	var fn add(word: str) = self.words.push(word)

	var fn setFirst(word: str) = {
		self.first = word
	}
}

struct Bag<T> {
	items: Vec<T>
}

extend Bag<T> {
	var fn put(item: T) = self.items.push(move item)
}

fn fill(slot: &var Option<str>, text: str) = {
	slot = .Some(text)
}

fn main() = {}
