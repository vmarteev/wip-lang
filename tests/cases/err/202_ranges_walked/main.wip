// What a range of elements may not be: written through
// where the whole could not be, and held in a variable, which the error's
// note now says. What the loop borrows is err/203_range_walk_borrows.

fn writeThroughAVal() = {
    val a = [1, 2, 3, 4]
    for x in a[0..2] {
        x = 5
    }
}

fn holdARange() = {
    val a = [1, 2, 3]
    val part = a[0..2]
}

fn main() = {}
