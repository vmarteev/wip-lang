// A field whose type does not encode, in a type that asks for
// `@derive(Encode)`, is reported where the field is written; so is one that
// does not decode, a view's borrowed text among them, which has nowhere to
// come from.

@derive(Encode)
struct Raw {
	at: ptr<u8>
}

@derive(Decode)
view struct Named {
	name: str
}

fn main() = {}
