// Line breaks (E0113, E0320): a line cannot start with a binary-only operator
// (the fix joins it to the line before, unless a comment is in the way). A
// line starting with `-` is a new statement: `total` is thrown away and
// `-discount` becomes the value, which earns a warning about the first.

fn withTax(base: i64): i64 = {
    val total = base
        + 10
    val doubled = total // before the operator
        * 2
    doubled
}

fn price(total: i64, discount: i64): i64 = {
    total
        - discount
}

// Compound assignment cannot start a line either.
fn grow(n: i64): i64 = {
    var total = n
    total
        += 1
    total
}
