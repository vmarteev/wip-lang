// A leading `.` calls a function of the type expected only where it has no
// receiver and answers that type: a method is refused, as are a function
// that answers another type, a name the type does not have (with the fix
// that names one it has), a function named without its call, an enum's
// name that is neither a variant nor a function, and a function where
// nothing is expected, whose help names the type to write.

struct Axis {
    size: f32 = 0

    static fn fixed(size: f32): Axis = Axis(size: size)
    static fn parse(text: str): Option<Axis> = .None
    fn doubled(): Axis = Axis(size: self.size * 2)
}

enum Shade {
    Light
    Dark
}

fn main() = {
    val a: Axis = .doubled()
    val b: Axis = .parse("1")
    val c: Axis = .fixd(1)
    val d: Axis = .fixed
    val e: Shade = .fromBit(true)
    val f = .fixed(1)
    val v: Vec<i64> = .len()
}
