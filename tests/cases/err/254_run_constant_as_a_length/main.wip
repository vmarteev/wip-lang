// A constant that is run while the program is compiled is
// known only once the program is checked, so it cannot be what types need
// while they are checked: an array's length (E0423).

@comptime
val SIZE: i64 = sizeOf()

fn sizeOf(): i64 = 4

fn total(cells: [i64; SIZE]): i64 = cells[0]

fn main() = {}
