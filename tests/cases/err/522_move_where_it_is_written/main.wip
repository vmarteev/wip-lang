// `move` written where a place is moved anyway is a warning (E0451), whose
// fix removes it: an argument, a `return`, a `val`, and a `var` pattern
// that binds what owns memory. Where the place alone would be looked into
// — a `match`, a `for`, an `is`, a `val` pattern, a `var` pattern that
// binds only plain data — `move` takes the value apart, nothing is said,
// and a later use is refused as a use after `move` (E0401, E0402, E0403).
// A part of a value that cleans up after itself cannot be given away
// written or not (E0426).

struct Guard {
    name: String
}

extend Guard: Destroy {
    var fn destroy() = {}
}

fn length(text: String): i64 = text.len()

fn inferred(text: String): String = {
    val n = length(move text)
    val again = String::of("b")
    val kept = move again
    val both = (n, kept)
    var (count, label) = move both
    return move label
}

fn taken(flag: bool, pair: (i64, String), options: Vec<Option<String>>): i64 = {
    val maybe: Option<String> = .Some(String::of("m"))
    val first = match move maybe {
        .Some(text) => length(text)
        .None => 0
    }
    val n = if maybe.isSome() then first else 0
    val other: Option<String> = .None
    var m = 0
    if flag && move other is .Some(text) then m = length(text)
    if other.isSome() then m += 1
    for option in 0..2 {
        for each in move options {}
    }
    var (count, _) = move pair
    return n + m + count + pair.0
}

fn part(guard: Guard): String = guard.name

fn main() = {}
