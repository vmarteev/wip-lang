// A guard's `else` of one expression must leave, as its block must: a call
// that returns can go on, so the code after the guard would run without
// the bindings (E0334).

import std::io

fn first(values: &[i64]): i64 = {
	val [head, ..] = values else io::println("empty")
	return head
}

fn main() = {}
