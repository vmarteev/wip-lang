// A binding below a reference a pattern tests through aliases what it names
// there, to read: writing through it is refused (E0412). A `match` on a
// value holding a reference is checked for every case of what it refers
// to: an arm left out is named (E0311).

enum Token {
	Word(text: String)
	Space
}

fn shout(token: Option<&Token>) = {
	if token is .Some(.Word(text)) {
		text.push("!")
	}
}

fn width(token: Option<&Token>): i64 = match token {
	.Some(.Word(text)) => text.len()
	.None => 0
}

fn main() = {
	shout(.None)
	assert(width(.None) == 0)
}
