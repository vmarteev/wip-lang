// A test on a place binds aliases for its fields, as a `match` on it does:
// while the block of the `if`, or the body of the
// `while`, runs, the place cannot be assigned (E0414). After it, it can.

enum Maybe<T> {
    Some(value: T)
    None
}

struct Token {
    id: i64
}

fn main(): i64 = {
    var slot: Maybe<own<Token>> = .Some(own Token(id: 1))
    if slot is .Some(token) {
        slot = .None
    }
    while slot is .Some(token) {
        slot = .None
    }
    if slot is .Some(token) {
        token.id
    } else {
        slot = .None
        0
    }
}
