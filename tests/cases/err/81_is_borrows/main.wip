// A test on a place binds aliases for its fields, as a `match` on it does:
// a binding only read holds the place to its last use, so one used after
// the block of the `if`, or the body of the `while`, assigns the place is
// refused (E0436). Before the change, or after the last use, it is not.

enum Maybe<T> {
    Some(value: T)
    None
}

struct Token {
    id: i64
}

fn main(): i64 = {
    var slot: Maybe<own<Token>> = .Some(own Token(id: 1))
    if slot is .Some(token) {
        slot = .None
        assert(token.id == 1)
    }
    while slot is .Some(token) {
        slot = .None
        assert(token.id == 1)
    }
    if slot is .Some(token) {
        val id = token.id
        slot = .None
        id
    } else {
        slot = .None
        0
    }
}
