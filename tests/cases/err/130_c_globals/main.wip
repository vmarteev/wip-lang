// What a variable C owns will not do. It is read
// as a copy of what C holds, so it is one of the types that cross, it has
// no address here, only a `var` may be written, and it takes a name in the
// module as a constant does.

val limit = 1

extern "C" {
    val limit: c_int
    val ceiling: c_int
    var counter: c_int
    var name: str
    var slots: [c_int; 4]
}

fn bump(value: &var c_int) = { value = value + 1 }

fn main() = {
    ceiling = 2 as c_int
    bump(&var counter)
}
