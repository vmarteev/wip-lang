// What borrows is kept to parameters, locals, results and a view's
// fields (E0427): not a field of a struct that is
// not a view, nor the payload of an enum that is not one — an `own` of a
// view among them. A view holds `&`, never `&var`.

view struct Words {
    text: str
}

struct Holder {
    words: Words,
    name: str,
    list: Vec<str>,
    boxed: own<Words>
}

enum Token {
    Word(text: str)
}

view struct Writer {
    target: &var i64
}

fn main() = {}
