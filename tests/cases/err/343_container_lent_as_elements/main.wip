// What a container lent as its elements still asks: the
// `&` that borrows it, plain or generic, said by the help; `&var` where
// they are written; and a `Map`, whose elements are entries, is not a
// slice of its values.

import std::collections::{Map}

fn total(values: &[i64]): i64 = values.len()

fn firstOf<T>(xs: &[T]): i64 = xs.len()

fn zero(xs: &var [i64]) = {}

fn main() = {
    var numbers = Vec::of(own [1, 2, 3])
    val ages: Map<str, i64> = Map()
    val a = total(numbers)
    val b = firstOf(numbers.items())
    val c = firstOf(numbers)
    val d = total(&ages)
    zero(&numbers)
}
