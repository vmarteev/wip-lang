// A value given without the `&` a generic function's reference parameter
// is declared with: the `&` is what is said to be missing, as for a
// function that is not generic, not that the type argument cannot be
// inferred; `&var` likewise.

interface Named {
    fn name(): String
}

struct Dog {}

extend Dog: Named {
    fn name(): String = String::of("dog")
}

fn greet<N: Named>(n: &N): String = n.name()

fn plain(n: &Dog): String = n.name()

fn renamed<T>(value: &var T) = {}

fn main() = {
    var dog = Dog()
    val a = greet(dog)
    val b = plain(dog)
    renamed(dog)
}
