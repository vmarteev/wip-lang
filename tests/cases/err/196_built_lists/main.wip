// What a list built as it runs refuses: `yield` with no
// list around it — a lambda is not inside the list around it; an `if`
// without `else` among a list's elements, which adds nothing; a list that
// yields without `own`; an element of another type; and `yield` where a
// value is expected. A loop standing for a value is a generator.

struct Deck {
    cards: Vec<i64>,

    pub fn at(index: i64): &i64 = yield self.cards.at(index)
}

fn outside() = {
    yield 1
}

fn inLambda() = {
    val xs = own [
        for i in 0..2 {
            val f = (x: i64): i64 => {
                yield x
                x
            }
            yield f(i)
        },
    ]
}

fn nothing(c: bool) = {
    val xs = own [1, if c { 2 }]
}

fn onStack(c: bool) = {
    val xs = [1, if c { yield 2 }]
}

fn mixed(c: bool) = {
    val xs = own [1, if c { yield "two" }]
}

fn main() = {}
