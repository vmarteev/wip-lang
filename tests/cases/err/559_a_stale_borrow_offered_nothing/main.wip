// A view refused because what it borrows changed (E0436) is offered no word
// where none would keep it good: a helper that answers from a field the
// view owns, which `from` cannot name; one that answers from what changed;
// and a method that does not empty all it holds.

struct Owner {
	text: String
	count: i64
}

extend Owner {
	fn text(): str = self.text.toStr()
}

fn second(a: str, b: str): str = b

view struct Pair {
	words: Vec<str> = Vec()
	first: str = ""
}

extend Pair {
	var fn reset() = {
		self.words = Vec()
	}
}

fn main() = {
	var owner = Owner(text: String::of("abc"), count: 0)
	val text = owner.text()
	owner.count += 1
	assert(text == "abc")

	var other = String::of("b")
	val named = second("a", other.toStr())
	other.push("!")
	assert(named == "b")

	var line = String::of("a b")
	var pair = Pair()
	for text in ["a b", "c"] {
		pair.reset()
		line.clear()
		line.push(text)
		pair.first = line.toStr()
	}
}
