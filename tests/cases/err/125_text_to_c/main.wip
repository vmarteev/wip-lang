// Text that C takes must end with a NUL, and a `str` is a pointer and a
// length with nothing after it. Nothing converts one
// silently: it would have to allocate, and C may keep the pointer. A
// literal is either, if its type is said; text built at run time goes
// through `String::toCstring()`.

extern "C" {
    fn puts(text: cstring): i32
}

fn main() = {
    val greeting = "hello"
    puts(greeting)

    var built = String()
    built.push("hello")
    puts(built)

    val said: cstring = "this one is fine"
    puts(said)
}
