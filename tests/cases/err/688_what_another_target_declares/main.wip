// A name declared only for another target, by a file of its own or an
// `@target`, is not there where the program is built for this one, and
// the error says it is that target's: in another module, a function and a
// type; and in the program itself.

import gadget

fn main() = {
	gadget::shake()                  // the module's file for iOS
	val feel = gadget::Haptics()     // an `@target` type of the module
	gadget::present()                // declared for every target: fine
	tilt()                           // the program's own, for iOS
}

@target(os = "ios")
fn tilt() = {}
