// Using what a projection lends (E0405, E0413). The lent
// place belongs to the caller, so it cannot be moved out of, and the borrow
// covers the argument it came from, so it conflicts with another reference to
// that place in the same call. Borrowing a `&` projection as `&var` is a type
// error, in err/59.

struct Item {
    weight: i64
}

struct Bag {
    items: [own<Item>; 2]
}

fn heaviestVar(bag: &var Bag): &var Item = lend bag.items[0]

fn consume(item: Item) = {}

fn both(item: &var Item, bag: &Bag) = {}

fn take(bag: &var Bag) = {
    consume(move heaviestVar(&var bag))
}

fn overlap(bag: &var Bag) = {
    both(&var heaviestVar(&var bag), &bag)
}
