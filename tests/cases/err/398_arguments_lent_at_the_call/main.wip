// A place given to a call is lent when the call starts, after every argument;
// but what borrows where it is made borrows from there. A later argument may
// not change what an earlier `str` or view borrows, nor what a closure
// captured, nor the key a projection was given (E0414); and may not move what
// an earlier place is found from, which leaves nothing to lend (E0401).

import std::collections::{Map}

struct Bag {
    name: String
    count: i64 = 0
}

extend Bag {
    var fn rename(): i64 = {
        self.name = String::of("renamed")
        return 0
    }
}

struct Grid {
    cells: own<[i64]>
}

fn at(grid: &var Grid, i: i64): &var i64 = lend grid.cells[i]

fn show(text: str, n: i64) = {}

fn apply(f: &() => i64, n: i64): i64 = f() + n

fn set(n: &var i64, value: i64) = {
    n = value
}

fn main() = {
    // A `str` borrows where it is made: the later argument frees its bytes.
    var bag = Bag(name: String::of("bag"))
    show(bag.name.toStr(), bag.rename())

    // A closure refers to what it captured from where it is made.
    apply(() => bag.count, { bag.count = 2; 0 })

    // A projection's key is taken where it is written.
    var m: Map<String, i64> = Map()
    m.put(String::of("a"), 1)
    var k = String::of("a")
    set(&var m.at(&k), { k = String::of("b"); 1 })

    // What a place is found from, moved before the call starts.
    var grid = Grid(cells: own [0; 4])
    set(&var at(&var grid, 1), { val gone = move grid; 1 })
}
