// A list where a reference to a collection is expected, or a box of one:
// a list is made a `Vec`, or another collection that collects, only where
// that collection itself is expected, so each of these is a list, which is
// not what the parameter takes.

import std::collections::{Set}

fn sum(v: &Vec<i64>): i64 = 0

fn grow(v: &var Vec<i64>) = {}

fn count(s: &Set<i64>): i64 = 0

fn held(s: own<Set<i64>>): i64 = 0

fn main() = {
	sum([1, 2])
	grow([1])
	count([1])
	held([1])
}
