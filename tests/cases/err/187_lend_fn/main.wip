// A `lend fn` lends a place both ways from one body, so
// its result is `&T`, which the writing half lends as `&var T`; and the body
// must lend a place it can write when it is checked as the writing half.
// Each mistake is reported once.

struct Box {
    x: i64
}

extend Box {
    fn fixed(): &i64 = lend self.x

    // Not a reference: nothing to lend.
    lend fn size(): i64 = 3

    // Written as the writing half: a `lend fn`'s result is `&T`.
    lend fn raw(): &var i64 = lend self.x

    // Reads well, and cannot write: what it lends is only ever read.
    lend fn view(): &i64 = lend self.fixed()
}

fn main() = {}
