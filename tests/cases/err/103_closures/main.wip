// A closure is a reference, and every reference in Wip is second class: it is
// an argument to a call, or a `val` of the block that writes it, which reads
// what it captures, and nothing else. A lent closure reads what it captures;
// only `&var (…) => R` writes it.

import std::io

struct Holder {
    f: &(x: i64) => i64             // a field cannot hold a reference
}

fn apply(f: &(x: i64) => i64, n: i64): i64 = f(n)

fn plain(f: (x: i64) => i64, n: i64): i64 = f(n)

fn writesThroughLent(): i64 = {
    var total = 0
    apply((x) => {                  // `&(…) => R` may only read
        total += x
        total
    }, 2)
}

fn intoPlain(): i64 = {
    val factor = 3
    plain((x) => x * factor, 2)     // a plain function captures nothing
}

fn main() = {
    io::printInt(writesThroughLent())
}

