// Where a field and a method may not share a name, or the field is not
// there: another module reads a private field that a method is named as
// (E0337, with the fix to call the method), and a field that holds a
// function beside a method of its name, its own or an interface's (E0201),
// since `x.name(…)` would call either.

import clock::{Moment}

struct Button {
    press: (times: i64) => i64

    fn press(times: i64): i64 = times
}

interface Ordered {
    fn compare(other: i64): i64
}

struct Sorter {
    compare: own<(a: i64, b: i64) => i64>
}

extend Sorter: Ordered {
    fn compare(other: i64): i64 = other
}

fn main() = {
    val moment = Moment::of(90)
    val seconds = moment.seconds
}
