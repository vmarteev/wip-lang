// What `@align`, `@packed` and `offsetOf` refuse: an alignment that is no
// power of two or is more than a page; a struct both packed and aligned; a
// field of a packed struct aligned, or owning memory; the annotations where
// they do not belong; and `offsetOf` given no struct, something that is not
// one, a name that is not a literal, or a field the struct does not have.

import std::c

@align(24)
struct NotAPower {
	x: i64
}

@align(8192)
struct TooLarge {
	x: i64
}

@packed
@align(16)
struct Both {
	x: u8
}

@packed
struct Holding {
	kind: u8
	@align(8) length: u32
	name: String
}

@align(16)
enum Kind {
	One
}

struct Point {
	@packed x: f32
	y: f32
}

@packed
struct Header {
	kind: u8
	length: u32
}

fn grow(n: &var u32) = n += 1

fn main() = {
	var header = Header(kind: 1, length: 2)
	grow(&var header.length)
	val name = "length"
	val a = c::offsetOf("x")
	val b = c::offsetOf<i64>("x")
	val d = c::offsetOf<Point>(name)
	val e = c::offsetOf<Point>("z")
}
