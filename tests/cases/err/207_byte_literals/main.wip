// What a byte literal is not: a byte is one ASCII
// character, so one that is not ASCII is an error that says how it is
// written; it holds one character; and it is a `u8`, compared and
// matched with a `u8` alone.

fn letters() = {
    val accented = b'é'
    val past = b'\u{80}'
    val two = b'ab'
}

fn typed(wide: i64, c: char): bool = {
    val narrow: i64 = b'x'
    val same = match c {
        b'x' => true
        _ => false
    }
    return wide == b'x'
}

fn main() = {}
