// What a byte literal is not: a byte is one ASCII
// character, so one that is not ASCII is an error that says how it is
// written; it holds one character; and it is a `u8`, which a `char` is
// not matched with.

fn letters() = {
    val accented = b'é'
    val past = b'\u{80}'
    val two = b'ab'
}

fn typed(c: char): bool = match c {
    b'x' => true
    _ => false
}

fn main() = {}
