[E0012] Error: a byte literal holds one ASCII character
   ╭─[ err/207_byte_literals/main.wip:7:20 ]
   │
 7 │     val accented = b'é'
   │                    ──┬─
   │                      ╰─── not ASCII
   │
   │ Help: `'é'` is a character, a `char`; in UTF-8 it is 2 bytes
   │
   │ Note: `b'x'` is the byte of an ASCII character, which is what every byte below 128 is in UTF-8
───╯
[E0012] Error: a byte literal holds one ASCII character
   ╭─[ err/207_byte_literals/main.wip:8:16 ]
   │
 8 │     val past = b'\u{80}'
   │                ────┬────
   │                    ╰────── not ASCII
   │
   │ Help: a byte past 127 is written as its number: `0x80`
   │
   │ Note: `b'x'` is the byte of an ASCII character, which is what every byte below 128 is in UTF-8
───╯
[E0008] Error: a byte literal holds one character
   ╭─[ err/207_byte_literals/main.wip:9:15 ]
   │
 9 │     val two = b'ab'
   │               ──┬──
   │                 ╰──── holds more than one
   │
   │ Help: write text in double quotes: `"ab"`
   │
   │ Note: a byte literal is the byte of one ASCII character; text, which is bytes, is written in double quotes
───╯
[E0301] Error: mismatched types
    ╭─[ err/207_byte_literals/main.wip:13:23 ]
    │
 13 │     val narrow: i64 = b'x'
    │                 ─┬─   ──┬─
    │                  ╰────────── expected because of this type
    │                         │
    │                         ╰─── expected `i64`, found `u8`
────╯
[E0313] Error: a byte cannot match `char`
    ╭─[ err/207_byte_literals/main.wip:15:9 ]
    │
 15 │         b'x' => true
    │         ──┬─
    │           ╰─── a byte, and the value is `char`
    │
    │ Note: a pattern that is a value asks whether the value being matched equals it, so the two are of one type
────╯
[E0303] Error: cannot apply `==` to `i64` and `u8`
    ╭─[ err/207_byte_literals/main.wip:18:17 ]
    │
 18 │     return wide == b'x'
    │            ──┬─ ─┬ ──┬─
    │              ╰─────────── `i64`
    │                  │   │
    │                  ╰─────── operands of different types
    │                      │
    │                      ╰─── `u8`
    │
    │ Note: Wip has no implicit numeric conversions
────╯
