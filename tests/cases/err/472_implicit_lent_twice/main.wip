// An implicit `&var` is lent as an argument is: a call that lends the same
// place again, written out, lends it twice, which the borrow rules refuse as
// they would the call written in full.

struct Dice {
	next: i64
}

fn swap(other: &var Dice, implicit dice: &var Dice) = {
	val held = other.next
	other.next = dice.next
	dice.next = held
}

fn main() = {
	implicit var dice = Dice(next: 1)
	swap(&var dice)
}
