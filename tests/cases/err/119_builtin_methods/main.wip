// Only the prelude gives a built-in type methods of its own:
// a method is found by the type of its receiver, so one written anywhere
// else would appear in every file that uses the type. A module's own
// interface is another matter — that one is allowed, and is in the case
// beside this.

import std::io

extend i64 {
    pub fn twice(): i64 = self * 2
}

extend str {
    pub fn shout(): i64 = 1
}

extend [T] {
    pub fn count(): i64 = self.len()
}

fn main() = {
    io::printInt(21)
}
