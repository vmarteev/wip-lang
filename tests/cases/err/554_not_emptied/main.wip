// A method that says `empties` is held to it: a field of `self` that may
// hold a view is, at every way out, emptied after the last thing of `self`
// put in it (E0463). Left as it was; filled again from another field; and
// emptied on one path only.

view struct Words {
	words: Vec<str> = Vec()
	first: str = ""
	count: i64 = 0
}

extend Words {
	var fn reset() empties = {
		self.count = 0
		self.first = ""
	}

	var fn again() empties = {
		self.words = Vec()
		self.words.push(self.first)
		self.first = ""
	}

	var fn maybe(really: bool) empties = {
		self.first = ""
		if really then self.words = Vec()
	}

	var fn early(really: bool) empties = {
		self.first = ""
		if really then return
		self.words = Vec()
	}
}

fn main() = {
	var words = Words()
	words.reset()
	words.again()
	words.maybe(true)
	words.early(true)
}
