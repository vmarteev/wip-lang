// A template's `finished` is what a literal's block ends with, so it takes
// the template and answers it: one that answers another type, or takes a
// value, is an error where it is declared.

struct Draft {
	text: String
}

extend Draft: Template {
	static fn withCapacity(capacity: i64): Draft = Draft(text: .withCapacity(capacity))

	var fn pushLiteral(text: str) = self.text.push(text)

	var fn pushBuilt(built: &Draft, implicit at: Location) = self.text.push(built.text.toStr())
}

extend Draft {
	move fn finished(): String = self.text
}

struct Sealed {
	text: String
}

extend Sealed: Template {
	static fn withCapacity(capacity: i64): Sealed = Sealed(text: .withCapacity(capacity))

	var fn pushLiteral(text: str) = self.text.push(text)

	var fn pushBuilt(built: &Sealed, implicit at: Location) = self.text.push(built.text.toStr())
}

extend Sealed {
	move fn finished(mark: char): Sealed = Sealed(text: "\(self.text)\(mark)")
}

fn main() = {
	val draft: Draft = "a"
	val sealed: Sealed = "b"
}
