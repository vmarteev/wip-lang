// What walking will not do. A type is walked when it lends its elements; what
// it lends is read, so writing through the binding is an assignment to
// something that belongs to the container; and a type that would lend two
// kinds of element is refused where it says the second.

struct Plain {
    n: i64
}

struct Deck {
    cards: Vec<i64>
}

extend Deck: Items<i64> {
    fn items(): &[i64] = lend self.cards.items()
}

fn nothingToWalk(plain: &Plain) = {
    for _ in plain {}
}

fn notANumber(n: i64) = {
    for _ in n {}
}

fn writingWhileWalking(deck: &var Deck) = {
    for card in deck {
        card = 1
    }
}

fn main() = {}

// A type lends one kind of element, which its implementation decides: a
// second is a second implementation of `Items`.
struct Both {
    numbers: Vec<i64>
    flags: Vec<bool>
}

extend Both: Items<i64> {
    fn items(): &[i64] = lend self.numbers.items()
}

extend Both: Items<bool> {
    fn items(): &[bool] = lend self.flags.items()
}

fn twoKinds(both: &Both) = {
    for _ in both {}
}
