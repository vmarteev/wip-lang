// A literal where a `Regex` is expected is a pattern, checked while the
// program is compiled: what does not parse is an error at the byte that
// stops it, and a hole is refused where a value cannot be matched as text,
// inside a class, inside a repetition's braces, and after a `\`.

import std::regex::{Regex}

fn main() = {
	val name = "x"
	val inner: Regex = "a"
	val unclosed: Regex = "// \\[((java|c) line (\\d+)\\] (Error.*)"
	val escape: Regex = "\\q"
	val nothing: Regex = "a|*b"
	val class: Regex = "[a-\(name)]"
	val braces: Regex = "a{\(name)}"
	val after: Regex = "a\\\(name)"
	val joinedInClass: Regex = "[\(inner)]"
	val unopened: Regex = "\(name))"
	// Not refused: a hole is a group, which may be repeated.
	val fine: Regex = "^\(name)*\(inner)?$"
}
