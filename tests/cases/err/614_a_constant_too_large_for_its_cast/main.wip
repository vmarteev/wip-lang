// A constant made an integer type that does not hold it is refused where
// it is written (E0310), since `as` would panic each time the line runs:
// too large, negative for an unsigned type, a character past a byte, and a
// constant made another type first. The fix writes `as%`, which keeps the
// low bits; a constant that fits is taken as it is. An enum of names made
// a type too small to number its last variant is refused the same way.

enum Many {
	V0
	V1
	V2
	V3
	V4
	V5
	V6
	V7
	V8
	V9
