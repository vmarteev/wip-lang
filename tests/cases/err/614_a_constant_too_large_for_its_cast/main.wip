fn main() = {
	val large = 300 as u8
	val negative = -1 as u64
	val euro = '€' as u8
	val chained = -1 as i8 as u8
	val fits = 255 as u8
	val cut = 300 as% u8
	val first = Many::V0 as i8
	val numbered = Many::V128 as u8
}
