// A view borrows what it holds, and is checked as a `str` is:
// used after what it borrows changed (E0436), or outliving it (E0437). A view's
// method that answers a place inside the view is `ok/227`'s.

import std::io

view struct Words {
    text: str,
    at: i64
}

extend Words {
    var fn next(): Option<str> = .None
}

fn cleared() = {
    var owned = String::of("a b")
    var words = Words(text: owned.toStr(), at: 0)
    owned.clear()
    val w = words.next()
}

fn pushed() = {
    var owned = String::of("a b")
    var all: Vec<str> = Vec()
    all.push(owned.toStr())
    owned.clear()
    io::println(all[0])
}

fn returned(): Words = {
    val owned = String::of("a b")
    Words(text: owned.toStr(), at: 0)
}

fn matched() = {
    var owned = String::of("a b")
    val maybe: Option<str> = .Some(owned.toStr())
    owned.clear()
    match maybe {
        .Some(w) => io::println(w),
        .None => {}
    }
}

fn main() = {}
