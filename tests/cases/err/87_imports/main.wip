// Imports that name items, done wrong. Each mistake is
// reported once, where it is imported, and its uses stay quiet.

import std::io::{printInt, prnt}
import lib::{labs}
import lib::{Shown, hidden, twice}
import std::io::{print, println as print}
import nowhere::{thing}

fn twice(x: i64): i64 = x * 2

fn main(): i64 = {
    printInt(twice(1))
    printInt(hidden(2))
    prnt(3)
    thing(4)
    val shown = Shown(value: 5)
    printInt(shown.value)
    0
}
