// A place a view owns is part of the view, and borrows it: what is kept of
// it is refused once the view changes. A place read through a view's `&`
// field borrows what the field borrows, and is refused once that changes,
// read from a local view and walked by a `for` (E0436).

struct Ast {
	names: Vec<String>
}

view struct Lowerer {
	ast: &Ast
	errors: Vec<String>
	seen: i64
}

extend Lowerer {
	var fn owned(): i64 = {
		val e = &self.errors[0]
		self.errors.push("more")
		return e.len()
	}
}

fn outlives(): i64 = {
	var ast = Ast(names: Vec::of(own ["ab"]))
	val l = Lowerer(ast: &ast, errors: Vec(), seen: 0)
	val n = &l.ast.names[0]
	ast.names.push("x")
	return n.len()
}

fn walked(): i64 = {
	var ast = Ast(names: Vec::of(own ["ab"]))
	val l = Lowerer(ast: &ast, errors: Vec(), seen: 0)
	var kept = 0
	for n in l.ast.names.items() {
		ast.names.push("x")
		kept += n.len()
	}
	return kept
}

fn main() = {
	assert(outlives() + walked() > 0)
}
