// A closure kept in a `val` reads what it captures where it is: it does not
// write what it captured, and a `var` holds none. What it captured changing
// while it is still used is `err/210`.

fn writes() = {
    var count = 0
    val bump = () => count += 1
}

fn inVar() = {
    val limit = 2
    var below = (n: i64) => n < limit
}

fn main() = {}
