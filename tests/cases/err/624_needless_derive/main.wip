// An enum of names implements `Eq` and `Hash` without being told, so a
// `@derive` that names either is warned of (E0467), with the fix that
// takes the names away, and the `@derive` where nothing else is left in
// it. An enum with a field still asks for `Eq`, and one that does not is
// refused where it is compared (E0303). One that writes its own equality
// is not hashed without asking, since a hash of which name it is matches
// only that equality (E0342). An enum of names is plain data too, so a
// `Clone` beside them is named in the same warning.

import std::collections::{Set}

/// Kept as it is, but for the three words.
@derive(Clone, Eq, Hash, Text)
enum Kind {
    Floor
    Ice
}

@derive(Eq)
@derive(Ord)
enum Size {
    Small
    Large
}

@derive(Hash) // the comment stays
enum Mode {
    Fit
    Grow
}

enum Hand {
    Left
    Right
}

// Every hand is as good as the other.
extend Hand: Eq {
    fn equals(other: &Hand): bool = true
}

enum Shape {
    Circle(radius: f64)
    Square
}

fn main() = {
    assert(Kind::Floor != .Ice && Size::Small < .Large && Mode::Fit != .Grow)
    val same = Shape::Square == Shape::Square
    var hands: Set<Hand> = Set()
}
