// Annotations are a closed set the compiler knows: a name it
// does not know is a mistake, not a hint, and so are the wrong place, the
// wrong arguments and a repeat.

import std::io

@tailrce                            // a typo, not a silent nothing
fn misspelt(): i64 = 1

@align(16)                          // not an annotation yet
struct Header {
    tag: i64
}

@tailrec                            // a promise about calls, on a type
enum Shape {
    Leaf
}

@tailrec(16)                        // it takes no arguments
fn arguments(n: i64): i64 = if n == 0 { 0 } else { arguments(n - 1) }

@link                               // this one needs a library's name
extern "C" {
    fn abs(x: i32): i32
}

@link(16)                           // and it is a string
extern "C" {
    fn labs(x: i64): i64
}

@link("z", "/usr/lib/libz.dylib")   // names, not paths
extern "C" {
    fn compressBound(n: i64): i64
}

@header                             // a header to include, or none at all
extern "C" {
    fn fabs(x: f64): f64
}

@header("math.h")                   // and it belongs on the block, not here
fn notABlock(): i64 = 1

@define("2FAST", "A B=1", "OK=1")   // what `-D` could not pass, and one it can
extern "C" {}

@define("DEBUG")                    // C's settings, on a Wip function
fn notC2(): i64 = 1

@symbol("wip_print_i64")            // a C name, on a Wip function
fn notC(): i64 = 1

extern "C" {
    @symbol("one two")              // a name C could not have written
    fn spaced(): i64

    @tailrec                        // a promise about calls, on C's function
    fn recursive(): i64

    @symbol("wip_print_i64")        // a type has no name of its own to give
    type Handle
}

@tailrec
@tailrec                            // written twice
fn twice(n: i64): i64 = if n == 0 { 0 } else { twice(n - 1) }

@tailrec                            // an interface is not a function
interface Empty {
    fn area(): i64
}

@source("x.c", language = "rust")  // a language it knows
extern "C" {}

@source(kind = "c")                 // a file, or `language`
extern "C" {}

@source(language = "c")             // and at least one file
extern "C" {}

fn main() = {
    @tailrec                        // statements take no annotations
    io::printInt(misspelt())
}

@tailrec                            // nothing follows it
