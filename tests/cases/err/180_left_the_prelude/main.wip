// `Map`, `Set`, the text and iterator types and a free `sort`, used as if the
// prelude had them: each is reported with where it is, as the import that
// brings it back or the method that took its place.

fn count(words: &Map<str, i64>): i64 = words.len()

fn pieces(text: str): Split = text.split(",")

fn main() = {
    var seen = Set<i64>()
    var numbers = Vec::of(own [3, 1, 2])
    sort(&var numbers.items())
    sortBy(&var numbers.items(), (a: &i64, b: &i64) => a > b)
    val wrong: ParseError = .Empty
}
