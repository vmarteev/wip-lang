// The prelude's names are in scope in every file, and may not be declared or
// imported again.

import std::io

import shapes
import shapes::{Rect as Option}
import std::prelude::{Option as Maybe}   // the prelude's own, renamed: fine

enum Option<T> {                         // a type of that name
    Yes(value: T)
}

fn flatten(n: i64): i64 = n              // a function of that name

interface Option3 {
    fn area(): i64
}

fn main() = {
    val m: Maybe<i64> = .Some(1)
    io::printInt(m.unwrapOr(0))
}

