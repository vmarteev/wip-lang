// What a module may not name as it likes: a name it both imports and
// declares, and the prelude's tuples, which `(a, b)` and `(A, B)` are
// written into by name. Any other name of the prelude is a module's to
// take, as `shapes` takes `Option`.

import std::io

import shapes
import shapes::{Rect as Option}
import std::prelude::{Option as Maybe}   // the prelude's own, renamed: fine

enum Option<T> {                         // imported above, and declared
    Yes(value: T)
}

struct Tuple2 {                          // the prelude's tuple
    first: i64
}

fn main() = {
    val m: Maybe<i64> = .Some(1)
    io::printInt(m.unwrapOr(0))
}
