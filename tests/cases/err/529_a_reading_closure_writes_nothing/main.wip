// A closure lent as `&(…) => R` only reads what it captures, and that holds
// for what it reaches through a `&var` it captured too: `self` in a `var
// fn`, or a `&var` parameter. It once wrote through one, which let
// `future::map`, which lends one such closure to every thread, run
// `self.bump()` on all of them at once. Each write is refused, with the
// help that lends a writing closure.

import std::future

struct Counter {
    n: i64

    var fn bump(): i64 = {
        self.n += 1
        return self.n
    }

    // Every thread calls the one closure: a write would race.
    var fn shared(xs: &[i64]): Vec<i64> = future::map(xs, (x) => x + self.bump())
}

fn twice(f: &() => void) = {
    f()
    f()
}

// A `&var` parameter, written through by a reading closure.
fn bumpTwice(n: &var i64) = twice(() => { n += 1 })

fn main() = {}
