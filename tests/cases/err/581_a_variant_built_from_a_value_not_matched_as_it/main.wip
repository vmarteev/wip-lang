// A variant takes the fields it does not name from `base` only where an
// arm or an `is` test matched `base` as that variant (E0130): not where
// nothing did, not in an arm of alternatives of two variants, and not from
// another value than the one matched. The values the literal names are
// still checked as the variant's fields, so a `.South` among them is the
// enum its field is, and the base the one thing refused.

enum Thing {
    Prop(name: String, turn: i64)
    Opening(name: String, turn: i64)
}

fn unmatched(t: Thing): Thing = .Prop(turn: 1, ..t)

fn alternatives(t: Thing): Thing = match t {
    .Prop(..) | .Opening(..) => .Prop(turn: 1, ..t)
}

fn another(t: Thing, u: Thing): Thing = match t {
    .Prop(..) => .Prop(turn: 1, ..u)
    _ => t
}

enum Facing {
    North
    South
}

enum Arrow {
    Pointing(facing: Facing, length: i64)
    Gone
}

fn turned(arrow: Arrow): Arrow = .Pointing(facing: .South, ..arrow)

fn main() = {}
