// A lambda that only calls a function with its parameters, in order, each
// as it is or with the `&` that lends what it refers to, is warned of
// (E0478), with the fix that writes the function's name: a module's
// function, a type's, a variant of one field, a generic function, and a
// closure the function was given. A method of the parameter, a parameter
// of another type than the function's, an `@inline` function and a lambda
// whose types are written are left as they are.

enum Failure {
    Io(code: i64)
}

struct Cut {
    at: i64
}

fn starts(kind: i64): bool = kind > 1

fn small(n: i64): bool = n < 3

fn check(cut: &Cut): i64 = cut.at

fn wrap<T>(value: T): Option<T> = Option::Some(value)

@inline
fn spliced(n: i64): i64 = n + 1

fn apply(test: &(x: i64) => bool): bool = test(1)

fn each(test: &(x: i64) => bool): bool = apply((x) => test(x))

fn main() = {
    // Warned of.
    val texts = ["a"].copies().map((text) => String::of(text)).toVec()
    val failed: Result<i64, i64> = .Err(1)
    val failure = failed.mapErr((code) => Failure::Io(code))
    val cuts = [Cut(at: 1)]
    val ats = cuts.map((cut) => check(&cut))
    val wrapped = [1].copies().map((x) => wrap(x)).toVec()
    val started = [1, 2].copies().map((kind) => starts(kind)).toVec()
    // Left alone.
    val few = Vec::of([1, 2]).any((x) => small(x))
    val next = [1].copies().map((x) => spliced(x)).toVec()
    val typed = [1].copies().map((x: i64) => small(x)).toVec()
    val answered = [1].copies().map((x): bool => small(x)).toVec()
    val none = Vec::of([Option::Some(1)]).any((o) => o.isNone())
    assert(each(small) && texts.len() == ats.len() && failure.isErr() && wrapped.len() == 1)
    assert(started[1] && few && next.len() == typed.len() && answered.len() == 1 && !none)
}
