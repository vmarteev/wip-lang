// What a generator may not borrow: what it yields may
// borrow what it was given, not what it holds, and nothing may point into
// what it holds across a `yield`, since it may be moved while it waits —
// but for what lies on the heap, as a `Vec`'s elements do. A type that
// lends an array of its own lends what moves with it.
// What it borrows from around it must not change while it is used, and
// must outlive it.

fn yieldsItsOwn(xs: &[i64]) = {
    var pieces = for x in xs {
        val owned = String::of("a,b")
        yield owned.toStr()
    }
}

fn walksItsOwnText(xs: &[i64]) = {
    var lengths = for x in xs {
        val owned = String::of("a,b")
        for piece in owned.split(",") {
            yield piece.len()
        }
    }
}

fn walksItsOwnArray(xs: &[i64]) = {
    var copies = for x in xs {
        val pair = [x, x]
        for y in pair {
            yield y
        }
    }
}

struct Hand {
    cards: [i64; 3],
}

extend Hand: Items<i64> {
    fn items(): &[i64] = lend self.cards[0..3]
}

fn walksWhatItWasGiven(hand: Hand): Iterator<i64> = {
    for card in hand {
        yield card
    }
}

fn evens(xs: &[i64]): Iterator<i64> = for x in xs { if x % 2 == 0 { yield x } }

fn main() = {
    var text = String::of("a b")
    var words = for w in text.split(" ") { yield w }
    text.push(" c")
    assert(words.next() == .Some("a"))

    var kept = evens([1, 2, 3, 4])
    assert(kept.next() == .Some(2))
}
