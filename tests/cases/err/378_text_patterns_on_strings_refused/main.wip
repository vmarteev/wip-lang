// A `String` has as many values as a `str`, so a `match` on one ends with
// `_`; and text matches only text, not a number or a `Vec<u8>`.

fn command(word: String): i64 = match word {
	"add" => 1
	"remove" => 2
}

fn main() = {
	val bytes: Vec<u8> = Vec()
	assert(!(bytes is "abc"))
	assert(!(7 is "seven"))
}
