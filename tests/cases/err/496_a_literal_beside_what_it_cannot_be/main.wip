// A literal takes the type of the branch beside it only where it can be
// one: a float where an integer is, a constant that does not fit, and a
// type said from outside that a branch does not meet are refused where
// the part is that does not fit.

val BIG = 300

fn main() = {
    val n: u8 = 7
    val m: i64 = 4
    val wide = m > 1
    val x: f32 = 2.5
    val mixed = if wide then 1.0 else m
    val outside: f64 = if wide then 1.0 else x
    val tooBig = if wide then BIG else n
    val arms = match wide {
        true => 1.5
        false => m
    }
    val elements = [1.0, m]
}
