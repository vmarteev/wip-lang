// Moves and indexing (E0317, E0309, E0315): moving a temporary, indexing
// something that is not an array, a constant index out of bounds, and an empty
// array whose type cannot be known.

fn make(): own<i64> = {
    return own 1
}

fn main(): i64 = {
    val a = move make()
    val n = 5
    val x = n[0]
    val xs = [1, 2, 3]
    val y = xs[3]
    val e = []
    return 0
}
