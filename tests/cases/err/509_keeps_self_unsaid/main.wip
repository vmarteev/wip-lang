// A method that keeps what its receiver holds in a `&var` argument says
// `keeps self`, and is given the fix that says it where it does not
// (E0449); the list it kept the receiver in is not used after the receiver
// changes (E0436).

view struct Label {
    text: str
}

struct Shelf {
    names: Vec<String>
}

extend Shelf {
    fn unsaid(labels: &var Vec<Label>) = labels.push(Label(text: self.names[0].toStr()))

    fn said(labels: &var Vec<Label>) keeps self = labels.push(Label(text: self.names[0].toStr()))
}

fn main() = {
    var shelf = Shelf(names: Vec::of(own [String::of("apple")]))
    var labels: Vec<Label> = Vec()
    shelf.said(&var labels)
    shelf.names.clear()
    assert(labels.len() == 1)
}
