// A method's type arguments refused: what reads as type arguments after a
// field, `a.x < b, c > (d)` in an argument list; type arguments given to a
// method that takes none, and more than one takes; and a method whose type
// argument nothing says, which the help says how to write.

import std::json
import std::json::{DecodeError}

struct Answer {
	text: String
	x: i64
}

extend Answer {
	fn read<T: Decode>(): Result<T, DecodeError> = json::decode(&self.text)
	fn plain(): i64 = self.x
}

fn both(a: bool, b: bool): bool = a && b

fn main() = {
	val a = Answer(text: String::of("[1]"), x: 1)
	val b = 2
	val c = 3
	assert(both(a.x < b, c > (1)))
	val p = a.plain<i64>()
	val q = a.read<i64, bool>()
	val r = a.read().unwrap()
}
