// What `@opaque` will not do. It says C knows where the
// fields are, which is only true of a struct C declares, and only when the
// header that declares it is named; and since nothing here knows how large
// one is, no value may have its type.

@opaque
struct Wip {
    count: i64
}

@opaque
extern struct NoHeader {
    count: c_int
}

@header("config.h")
@opaque
extern struct Config {
    mode: c_uint,
    level: c_uint
}

fn held(c: Config): c_uint = c.mode

fn main() = {
    var here = Config(mode: 1 as c_uint, level: 2 as c_uint)
}
