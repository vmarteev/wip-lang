// A closure passed to a call lends the call's result what it may give back
// (E0437): one answering a `str` it captured gives that back, so what the
// call answers borrows the local it captured, and cannot leave the function
// the local dies in.

struct Character {
    name: String
}

/// What `name` answers of `character`.
fn nameOf(name: &(of: &Character) => str, character: &Character): str = name(&character)

fn made(character: &Character): str = {
    val text = String::of("made here")
    val local = text.toStr()
    return nameOf((of) => local, &character)
}

fn main() = {
    val pebble = Character(name: String::of("pebble"))
    made(&pebble)
}
