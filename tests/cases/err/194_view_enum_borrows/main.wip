// A `view enum` borrows what its variants hold, and is checked as a
// `str` is: used after what it borrows changed,
// through the enum or through what a `match` bound from it (E0436), or
// outliving it (E0437).

import std::io

view enum Token {
    Word(text: str),
    End,
}

fn cleared() = {
    var owned = String::of("word")
    val token = Token::Word(owned.toStr())
    owned.clear()
    if token is .Word(text) {
        io::println(text)
    }
}

fn bound() = {
    var owned = String::of("word")
    val text = match Token::Word(owned.toStr()) {
        .Word(text) => text
        .End => ""
    }
    owned.push("s")
    io::println(text)
}

fn boxed() = {
    var owned = String::of("word")
    val kept: own<Token> = own Token::Word(owned.toStr())
    owned.clear()
    io::println(wordOf(&kept))
}

fn wordOf(token: &Token): str = match token {
    .Word(text) => text
    .End => ""
}

fn escaped(): Token = {
    val owned = String::of("word")
    .Word(owned.toStr())
}

fn main() = {}
