// A local whose value leaves its type arguments open is refused (E0315)
// where it is first named, if that place does not say them: a test, a
// method whose arguments say nothing of them, a generic parameter, a walk,
// a lambda, or a use that leaves a parameter with no default open. Never
// named again, it is refused where it is declared, as before.

import std::collections::{Map}

struct Pair<A, B> {
    a: Vec<A> = Vec()
    b: Vec<B> = Vec()
}

extend Pair<A, B> {
    var fn addA(a: A) keeps a = self.a.push(a)
}

fn count<T>(items: &Vec<T>): i64 = items.len()

fn main() = {
    var best = .None
    if best is .Some(hit) then best = .Some(hit)
    var sizes = Vec()
    val n = sizes.len()
    var names = Map()
    val k = count(&names)
    var walked = Vec()
    for w in walked {}
    var later = Vec()
    val f = &() => later.push(1)
    var pair = Pair()
    pair.addA(1)
    var never = Vec()
}
