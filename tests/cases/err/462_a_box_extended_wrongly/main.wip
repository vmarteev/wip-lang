// A box is extended with one type parameter, what it holds; a method of a
// module's own on it is refused, as on any built-in type; and a box
// implements nothing an `extend own<T>` block does not give it.

interface Describe {
	fn describe(): String
}

extend own {
	fn nothing() = {}
}

extend own<A, B> {
	fn nothing() = {}
}

extend own<T> {
	fn mine(): i64 = 1
}

struct Point {
	x: i64
}

extend Point: Describe {
	fn describe(): String = "a point"
}

fn told<T: Describe>(x: &T): String = x.describe()

fn main() = {
	val p = own Point(x: 1)
	told(&p)
}
