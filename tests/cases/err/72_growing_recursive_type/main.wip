// A struct that holds itself by value with ever larger type arguments has no
// size (E0316), and checking it must end: once overflowed the stack, and once
// hung, because each level doubles `Pair<T, T>`. Asking whether it owns
// memory, for the `copy` check, must not stop the compiler either.

struct Pair<A, B> {
    first: A
    second: B
}

struct Growing<T> {
    inner: Growing<Pair<T, T>>
}

struct Plain<T: copy> {
    value: T
}

fn take(p: Plain<Growing<i64>>) = {}

fn main(): i64 = 0
