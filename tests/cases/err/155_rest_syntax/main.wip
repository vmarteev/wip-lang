// `..base` comes last in a call that builds a struct, as `..` does in a
// pattern, and a call takes one of it. One in a call that builds no struct is
// the checker's, `err/219`.

struct Window {
    width: i64
    height: i64
}

fn main() = {
    val w = Window(width: 1, height: 2)
    val early = Window(..w, height: 9)
    val twice = Window(..w, ..w)
}
