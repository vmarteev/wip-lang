// A constant in a pattern that cannot be one: hidden by a
// local of its name, of another type than the value matched, or a float,
// which a pattern does not compare.

val LIMIT: i64 = 3
val SMALL: u8 = 1
val HALF: f64 = 0.5

fn main() = {
	val LIMIT = 9
	match 4 {
		LIMIT => {}
		_ => {}
	}
	val count: i64 = 2
	match count {
		SMALL => {}
		_ => {}
	}
	match 0.5 {
		HALF => {}
		_ => {}
	}
}
