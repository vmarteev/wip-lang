// A named argument written `name:` is refused as `name: name` would be:
// where nothing of that name is in scope, where the function has no
// parameter of that name, and where the variable is not of the
// parameter's type.

struct Point {
    x: i64
    y: i64
}

fn area(width: i64, height: i64): i64 = width * height

fn main() = {
    val x = 3
    val p = Point(x:, y:)
    val depth = 2
    val a = area(width: x, depth:)
    val height = "tall"
    val b = area(width: 1, height:)
}
