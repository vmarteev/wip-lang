// What an iterator borrows must not change while a `for` walks it
// (E0436): an iterator made in the loop's header,
// and one walked where it is.

view struct Words {
    text: str,
    at: i64
}

extend Words: Iterator<str> {
    var fn next(): Option<str> = .None
}

fn made() = {
    var owned = String::of("a b")
    for w in (Words(text: owned.toStr(), at: 0)) {
        owned.clear()
    }
}

fn walked() = {
    var owned = String::of("a b")
    var words = Words(text: owned.toStr(), at: 0)
    for w in words {
        owned.clear()
    }
}

fn main() = {}
