// The move checker follows the order arguments are written in, not the order
// of the parameters: moving `x` before a later argument
// borrows it is a use after the move (E0401), and so is borrowing it before
// a later argument moves it, since a place is lent when the call starts and
// the move has left nothing there.

struct Token {
    id: i64
}

fn keep(token: own<Token>, look: &Token) = {}

fn main(): i64 = {
    val a = own Token(id: 1)
    keep(token: move a, look: &a)
    val b = own Token(id: 2)
    keep(look: &b, token: move b)
    0
}
