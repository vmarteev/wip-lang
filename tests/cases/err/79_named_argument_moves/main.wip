// The move checker follows the order arguments are written in, not the order
// of the parameters: giving `x` away before a later argument borrows it is a
// use after it was given (E0404), and so is borrowing it before a later
// argument gives it away, since a place is lent when the call starts and the
// move has left nothing there.

struct Token {
    id: i64
}

fn keep(token: own<Token>, look: &Token) = {}

fn main(): i64 = {
    val a = own Token(id: 1)
    keep(token: a, look: &a)
    val b = own Token(id: 2)
    keep(look: &b, token: b)
    0
}
