// What a call's answer borrows, by the callee's signature:
// what it does borrow must not change while it is used, and a body may not
// answer a place its signature does not lend.

import std::io

struct Node {
    name: String
    size: i64
}

struct Tree {
    nodes: Vec<Node>
}

view struct Found {
    node: &Node
}

extend Tree {
    fn find(key: str): Option<Found> = {
        for i in 0..self.nodes.len() {
            if self.nodes[i].name == key {
                return .Some(Found(node: &self.nodes[i]))
            }
        }
        return .None
    }
}

view struct Short {
    bytes: [u8; 4]
    length: i64
}

extend Short {
    fn text(): str = str::fromBytes(&self.bytes[0..self.length])
}

/// The tree changes while what was found in it is used.
fn treeChanged() = {
    var tree = Tree(nodes: Vec())
    tree.nodes.push(Node(name: String::of("a"), size: 1))
    val found = tree.find("a")
    tree.nodes.clear()
    if found is .Some(f) {
        io::println(f.node.name)
    }
}

/// The view changes while what it answered, which points into it, is used.
fn viewChanged() = {
    var short = Short(bytes: ['h' as u8, 'i' as u8, 0, 0], length: 2)
    val text = short.text()
    short.bytes[0] = 'x' as u8
    io::println(text)
}

/// An interface whose `pick` answers what `T` cannot hold: a caller through
/// it does not keep `other` borrowed.
interface Pick<T> {
    fn pick(other: &T): Option<Found>
}

extend Tree: Pick<Tree> {
    fn pick(other: &Tree): Option<Found> = .Some(Found(node: &other.nodes[0]))
}

fn main() = {}
