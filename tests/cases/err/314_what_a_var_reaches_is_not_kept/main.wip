// What a `&var` argument reaches is lent for the call alone, and is not
// kept by another argument: not assigned through it, and
// not handed to what keeps its argument, as `push` does. What a shared
// reference reaches may still be kept, as before.

struct Vm {
	names: Vec<String>
}

view struct Parser {
	source: str
	words: Vec<str>
}

extend Parser {
	// Assigned through `self`, a view of what `vm` holds.
	var fn steal(vm: &var Vm) = {
		self.source = vm.names[0].toStr()
	}

	// Kept through a call: `push` keeps what it is given.
	var fn collect(vm: &var Vm) = {
		self.words.push(vm.names[0].toStr())
	}

	// A shared context may still be kept from, where the signature says so.
	var fn borrowFrom(names: &Vec<String>) keeps names = {
		self.words.push(names[0].toStr())
	}
}

fn main() = {}
