// A `val … else` binding of a payload that owns memory refers to the place it
// came from: it cannot be copied out, so the place may not change until the
// block ends.

struct Holder {
    text: Option<String>
}

fn taken(h: &var Holder): i64 = {
    val .Some(text) = h.text else {
        return 0
    }
    h.text = .None
    text.len()
}

fn main() = {}
