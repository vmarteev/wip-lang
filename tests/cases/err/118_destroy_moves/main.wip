// A type that cleans up after itself is never copied:
// exactly one owner runs exactly one drop. It follows the rules an `own`
// already had, although this one holds no memory at all — the drop is what
// makes it a resource.

import std::io

struct Handle {
    id: c_int
}

extend Handle: Destroy {
    var fn destroy() = io::printInt(self.id as i64)
}

fn copied(): i64 = {
    val a = Handle(id: 1)
    val b = a                       // two owners, two drops
    (a.id + b.id) as i64
}

fn afterMove(): i64 = {
    val a = Handle(id: 2)
    val b = move a
    a.id as i64                     // it was moved away
}

fn main() = {
    io::printInt(copied())
}
