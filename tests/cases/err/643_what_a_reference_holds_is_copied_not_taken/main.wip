// What a pattern binds behind a reference cannot be taken, and `match move`
// cannot take it either: the help says to copy it. A reference the value held,
// such as an element `get` found, and a value matched through a reference are
// both behind one; a value of the function's own is not, and `match move`
// takes it apart.

struct Name {
    text: String
}

fn found(names: &[Name]): Name = {
    val .Some(name) = names.get(0) else panic("none")
    return name
}

fn lent(name: &Option<Name>): Name = match name {
    .Some(name) => name
    .None => panic("none")
}

fn owned(name: Option<Name>): String = match name {
    .Some(name) => name.text
    .None => panic("none")
}

fn main() = {}
