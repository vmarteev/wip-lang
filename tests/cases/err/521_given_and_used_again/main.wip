// A place that owns memory is given away where it is used as a value, so a
// later use is refused (E0404), where it was given: after it, on the path
// where it was given, in the next iteration of a loop, in every iteration,
// and in a `defer` that runs after it. What only a reference or an array
// holds cannot be given at all (E0405, E0406).

fn length(text: String): i64 = text.len()

fn after(): i64 = {
    val text = String::of("a")
    val n = length(text)
    return n + text.len()
}

fn onOnePath(flag: bool): i64 = {
    val text = String::of("a")
    if flag then length(text)
    return text.len()
}

fn nextIteration(): i64 = {
    var total = 0
    val text = String::of("a")
    for i in 0..3 {
        total += text.len()
        if i == 1 then length(text)
    }
    return total
}

fn everyIteration() = {
    val text = String::of("a")
    for i in 0..3 {
        length(text)
    }
}

fn deferred() = {
    val text = String::of("a")
    defer length(text)
    length(text)
}

fn behindReference(text: &String): i64 = length(text)

fn element(texts: [String; 2]): i64 = length(texts[0])

fn main() = {}
