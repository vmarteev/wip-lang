// A line break ends an expression, and a `.` that starts a line begins a
// variant of the expected type, so a variant written under a call is a
// statement of its own — however much it reads like a method on the line above.
// That is E0126, a warning, since the code means what it says.
//
// It is a warning about how the two lines read, so the value below is
// exactly what the one above would have been: only `first` is reported.

import std::io

fn first(): Result<i64, i64> = {
    io::println("working")
    .Ok(1)
}

// A binding cannot take a `.`, so nothing here can be misread.
fn second(): Result<i64, i64> = {
    val value = 1
    .Ok(value)
}

// Neither can an assignment.
fn third(): Option<i64> = {
    var count = 1
    count += 1
    .Some(count)
}

// Said outright, which a `.` cannot continue.
fn fourth(): Result<i64, i64> = {
    io::println("working")
    return .Ok(4)
}

// An `if` without `else` and a loop have no value either: a guard that
// leaves, then the answer.
fn fifth(limit: i64): Option<i64> = {
    if limit < 0 {
        return .None
    }
    .Some(limit)
}

fn sixth(): Option<i64> = {
    var total = 0
    for i in 0..3 {
        total += i
    }
    .Some(total)
}

fn main() = {
    io::printInt(first().unwrapOr(0))
    io::printInt(second().unwrapOr(0))
    io::printInt(third().unwrapOr(0))
    io::printInt(fourth().unwrapOr(0))
    io::printInt(fifth(5).unwrapOr(0))
    io::printInt(sixth().unwrapOr(0))
}
