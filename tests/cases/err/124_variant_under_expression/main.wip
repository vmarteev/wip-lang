// A `.` at the start of a line continues the expression above it, as it
// would on one line, so a variant written under an expression is a member
// of what that expression answers (E0126). Where the variant's type is
// expected — a block's value — the error says so, with the fix that writes
// the type: under a call, a binding's value, an assignment's value, a
// braced `if`. Under a `return`, or a loop, which is no expression, there
// is nothing to continue, and the variant is the block's value.

import std::io

fn first(): Result<i64, i64> = {
    io::println("working")
    .Ok(1)
}

fn second(): Result<i64, i64> = {
    val value = 1
    .Ok(value)
}

fn third(): Option<i64> = {
    var count = 1
    count += 1
    .Some(count)
}

fn fourth(): Result<i64, i64> = {
    io::println("working")
    return .Ok(4)
}

fn fifth(limit: i64): Option<i64> = {
    if limit < 0 {
        return .None
    }
    .Some(limit)
}

fn sixth(): Option<i64> = {
    var total = 0
    for i in 0..3 {
        total += i
    }
    .Some(total)
}

fn main() = {}
