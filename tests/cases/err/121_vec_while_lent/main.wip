// A vector's elements are lent where they are, so
// the rules that already hold for a slice hold for a `Vec`: what is being
// walked, or lent, must not change while the loan lasts — which is
// the bug every language with iterators and a growable array has to answer
// for.

import std::io

fn grow(v: &var Vec<i64>) = {
    for x in v.items() {
        v.push(x)                   // it could move the elements
        io::printInt(x)
    }
}

fn main() = {
    var values: Vec<i64> = Vec()
    values.push(1)
    grow(&var values)
}
