// A test on a place binds aliases for its fields until its chain ends:
// the place cannot be written in the rest of the
// chain (E0414), and can after it.

fn main() = {
    var named: Option<String> = .Some(String::of("x"))
    val cleared = named is .Some(w) && {
        named = .None
        w.len() > 0
    }
    named = .None
}
