// Moves (E0404): a value given away on one branch of an `if` and used after
// it. It may or may not hold a value there, and the error shows where it was
// given.

struct File {
    fd: i64
}

fn close(f: own<File>) = {}

fn work(flag: bool): i64 = {
    val f = own File(fd: 3)
    if flag {
        close(f)
    }
    return f.fd
}
