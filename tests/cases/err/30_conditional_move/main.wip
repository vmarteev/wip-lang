// Moves (E0402): a value moved on one branch of an `if` and used after it. It
// may or may not hold a value there, and the error shows the move.

struct File {
    fd: i64
}

fn close(f: own<File>) = {}

fn work(flag: bool): i64 = {
    val f = own File(fd: 3)
    if flag {
        close(move f)
    }
    return f.fd
}
