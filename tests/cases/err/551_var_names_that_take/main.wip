// A `var` name of a part that owns memory takes it, and the place it was
// in is given up: used again after, it is E0404. Matching through a
// reference nothing can be given up (E0405), and through a `&var` the
// parameter would be left empty (E0415).

enum Shape {
	Named(label: String, sides: i64)
	Dot
}

fn relabel(shape: &Shape) = match shape {
	.Named(var label, ..) => label.push("!")
	_ => {}
}

fn resize(shape: &var Shape) = match shape {
	.Named(var label, ..) => label.push("!")
	_ => {}
}

fn main() = {
	val named = Shape::Named(label: String::of("tri"), sides: 3)
	match named {
		.Named(var label, ..) => label.push("angle")
		_ => {}
	}
	assert(named is .Dot)
}
