// A call that empties gives its receiver no roots, and nothing more: a
// view taken from it before the call still borrows what it did, and is
// refused where that changed (E0436).

view struct Words {
	words: Vec<str> = Vec()
}

extend Words {
	var fn clear() empties = {
		self.words = Vec()
	}
}

fn main() = {
	var line = String::of("a b")
	var words = Words()
	for word in line.toStr().split(" ") {
		words.words.push(word)
	}
	val first = words.words[0]
	words.clear()
	line.clear()
	assert(first == "a")
}
