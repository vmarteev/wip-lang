// Implementing an interface: every method without a default,
// with the receiver and signature the interface declares, and once per type.

import std::io

interface Shape {
    fn area(): i64
    fn scaled(by: i64): Self
    fn name(): i64 = 0
}

struct Rect {
    width: i64
}

struct Plain {
    n: i64
}

extend Rect: Shape {
    var fn area(): i64 = self.width         // the interface declares `fn`
    fn scaled(by: i64, extra: i64): Rect = Rect(width: 0)
                                            // a parameter the interface has not
    fn extra(): i64 = 1                     // not a method of the interface
}

extend Rect: Shape {                    // implemented twice
    fn area(): i64 = 0
    fn scaled(by: i64): Rect = Rect(width: 0)
}

extend Plain: Shape {                   // `scaled` is missing
    fn area(): i64 = self.n
}

extend Plain: Missing {                 // no such interface
    fn area(): i64 = 0
}

fn describe<T: Shape>(x: &T): i64 = x.missing()

fn unknown<T: Nothing>(x: &T): i64 = 0

fn main() = {
    io::printInt(describe(Plain(n: 1)))
}

