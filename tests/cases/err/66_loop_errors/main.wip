// Loop errors found by the type checker: `break` and
// `continue` outside a loop (E0322) or leaving a deferred expression (E0504),
// though a loop wholly inside the deferred expression may use them; walking
// something that is not an array, a slice or a buffer (E0323); assigning to a
// range's number or to an element of a collection that cannot be written
// (E0304); and bounds of two types.

fn helper(xs: &[i64]) = {
    for x in xs {
        x = 0
    }
}

fn main(): i64 = {
    break
    for i in 0..3 {
        defer { continue }
        defer {
            for j in 0..i {
                break
            }
        }
        i = 5
    }
    val n = 10
    for x in n {
        continue
    }
    val small: i32 = 1
    val big: i64 = 2
    for k in small..big {}
    0
}
