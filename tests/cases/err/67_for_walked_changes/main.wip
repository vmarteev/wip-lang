// What a `for` walks stays put while the loop runs: it
// cannot be assigned (E0414), moved (E0414) or passed as `&var` (E0414) in
// the body, and a writable binding cannot be passed next to another
// reference to it (E0413). Writing through the binding is allowed.

struct Token {
    id: i64
}

fn touch(xs: &var [i64; 3]) = {}

fn both(x: &var i64, xs: &[i64; 3]) = {}

fn consume(tokens: [own<Token>; 2]) = {}

fn main(): i64 = {
    var xs = [1, 2, 3]
    for x in xs {
        x = x + 1
        xs = [4, 5, 6]
        touch(&var xs)
        both(&var x, &xs)
    }
    var tokens = [own Token(id: 1), own Token(id: 2)]
    for token in tokens {
        consume(move tokens)
        break
    }
    0
}
