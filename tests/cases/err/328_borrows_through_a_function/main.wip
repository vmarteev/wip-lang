// What a function a call is given makes of what it is passed borrows what
// that borrowed: `map` on an `Option<&String>` makes `str`s
// of the `String` it refers to, and a slice's `map` makes them of its
// elements, so changing what they came from while they are used is E0436.

fn main() = {
    var s = String::of("first")
    val o: Option<&String> = .Some(&s)
    val n = o.map((h) => h.toStr())
    s = String::of("second")
    val m = n

    var names = Vec::of(own [String::of("a"), String::of("b")])
    val views = names.map((name) => name.toStr())
    names.clear()
    val first = views[0]
}
