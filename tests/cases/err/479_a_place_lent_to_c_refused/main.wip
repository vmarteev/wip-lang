// What a call cannot lend where a C function takes a pointer: a place of
// another type than the one pointed at, a lent place given to a Wip
// function that takes a pointer, which says `&var` when it means one, and
// an `Option` of a reference, which C is given as a pointer that may be
// null instead.

extern "C" {
    struct Point {
        x: f64
        y: f64
    }

    fn listed(count: ptr<u32>, items: ptr<u32>)
    fn nearest(to: Option<&Point>): f64
}

fn counted(count: ptr<u32>) = {}

fn main() = {
    var wide: u64 = 0
    listed(&var wide, null)
    var count: u32 = 0
    counted(&var count)
}
