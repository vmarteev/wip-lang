// A `clone()` of a value the function owns, or of a field of one, where
// nothing reads the variable after on some path, is a warning (E0448): it
// could have been given itself, and moved. A local, a parameter, a field of
// one, and in one branch of two. Nothing is said where the variable is read
// again — another field assigned is no new value of the whole — in a loop
// that clones it again, where it is a reference, a field of `self`, of a
// type parameter, or of a struct with a `destroy`, which cannot be moved
// out of.

import std::io

struct Named {
    name: String
    count: i64
}

struct Held {
    name: String
}

extend Held: Destroy {
    var fn destroy() = {}
}

fn local(names: &var Vec<String>) = {
    val made = String::of("a")
    names.push(made.clone())
}

fn param(names: &var Vec<String>, line: String) = {
    names.push(line.clone())
}

fn field(names: &var Vec<String>, named: Named) = {
    names.push(named.name.clone())
}

fn branch(names: &var Vec<String>, line: String, shown: bool) = {
    if shown {
        names.push(line.clone())
    } else {
        io::println(line)
    }
}

fn readAgain(names: &var Vec<String>, line: String) = {
    names.push(line.clone())
    names.push(line)
}

fn fieldAssigned(names: &var Vec<String>, named: Named) = {
    var held = named
    names.push(held.name.clone())
    held.count = 2
    io::println(held.name)
}

fn looped(names: &var Vec<String>, line: String) = {
    for _ in 0..3 {
        names.push(line.clone())
    }
}

fn lent(names: &var Vec<String>, line: &String) = {
    names.push(line.clone())
}

fn destroyed(names: &var Vec<String>, held: Held) = {
    names.push(held.name.clone())
}

fn generic<T: Clone>(value: T): T = value.clone()

extend Named {
    fn named(names: &var Vec<String>) = {
        names.push(self.name.clone())
    }
}

fn main() = {
    var names: Vec<String> = Vec()
    local(&var names)
    param(&var names, "b")
    field(&var names, Named(name: "c", count: 1))
    branch(&var names, "d", true)
    readAgain(&var names, "e")
    fieldAssigned(&var names, Named(name: "e2", count: 1))
    looped(&var names, "f")
    val g = String::of("g")
    lent(&var names, &g)
    destroyed(&var names, Held(name: "h"))
    io::println("\(generic(1))")
    Named(name: "i", count: 2).named(&var names)
}
