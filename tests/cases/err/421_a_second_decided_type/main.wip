// A decided type is not part of which implementation it is: a type that
// implements an interface twice, deciding two types, is refused at the
// second, where it is declared, not where it is used.

interface Shelf<type Book> {
	fn count(): i64
}

struct Library

extend Library: Shelf<String> {
	fn count(): i64 = 0
}

extend Library: Shelf<i64> {
	fn count(): i64 = 1
}

struct Counter

extend Counter: Iterator<i64> {
	var fn next(): Option<i64> = .None
}

extend Counter: Iterator<bool> {
	var fn next(): Option<bool> = .None
}

fn main() = {}
