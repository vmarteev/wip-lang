// A function passed to C as a callback takes and answers no function
// pointer that may be null (E0314), as it takes no struct by value: C
// passes the pointer in a register, and a Wip function C calls through a
// pointer would take its address. As a parameter or a result of a C
// function itself, one crosses.

extern "C" {
    fn c_through(taker: (f: Option<() => i32>) => i32): i32
    fn c_giving(maker: () => Option<() => i32>): i32
    fn c_fine(f: Option<() => i32>): Option<() => i32>
}

fn main() = {}
