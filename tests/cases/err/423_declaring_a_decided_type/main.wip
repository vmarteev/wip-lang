// How a decided type is declared: only by an interface, after the types a
// constraint names, and with no default, since each implementation says
// what it is.

interface Late<type Item, Key> {
	fn get(key: Key): Item
}

interface Defaulted<type Item = i64> {
	fn get(): Item
}

struct Box<type T> {
	value: T
}

fn main() = {}
