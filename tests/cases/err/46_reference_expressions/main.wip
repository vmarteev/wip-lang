// Reference expressions (E0411, E0412, E0304, E0301). `&var` is written only as
// a call's argument, and `&` as one or where a reference is expected — a
// `val`'s whole value, but not a part of one, as an element of a tuple whose
// type is not said; `&var` needs something that can be written, a `&` parameter
// only reads, and an argument must match its parameter's kind of reference
// (each mismatch has a fix).

struct Point {
    x: i64
}

fn read(p: &Point): i64 = p.x

fn write(p: &var Point) = {
    p.x = 1
}

fn readOnly(p: &Point) = {
    p.x = 2
    write(&var p)
}

fn main(): i64 = {
    val fixed = Point(x: 0)
    var moving = Point(x: 0)
    val pair = (&moving, 1)
    write(&var fixed)
    write(&var Point(x: 3))
    write(&moving)
    read(&var moving)
    0
}
