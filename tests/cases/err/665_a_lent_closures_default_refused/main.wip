// A lent closure's default is a lambda or a function's name, and in a
// generic function a function's name; any other value is refused, and a
// reference parameter of anything but a closure keeps its refusal.

fn pick<T>(value: T, keep: &(x: &T) => bool = (_) => true): bool = keep(&value)

fn twice(x: i64): i64 = x * 2

fn half(x: i64): i64 = x / 2

fn chosen(f: &(x: i64) => i64 = if true then twice else half): i64 = f(1)

fn plain(value: &i64 = 3): i64 = value + 0

fn main() = {}
