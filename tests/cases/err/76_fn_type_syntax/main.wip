// Function types are written like lambdas, with every parameter named:
// `(a: A, b: B) => R`, and `=> void` for a function that returns nothing.
// The first spelling, `fn(A, B): R`, is reported (E0121), as
// is a parameter without a name (E0121) and a function type without its
// result.

fn apply(f: fn(i64): i64, x: i64): i64 = f(x)

fn visit(f: (item: i64)) = {}

fn count(f: (i64, flag: bool) => i64) = {}

fn main(): i64 = 0
