// What `@target` refuses: a condition that names nothing,
// a key the compiler does not know, a value it does not know, an argument
// with no key, and a value that is not a name in quotes. Each is reported
// wherever it is written, including on an item this target does not take.

@target()
fn nothing(): i64 = 1

@target(platform = "linux")
fn key(): i64 = 2

@target(os = "solaris")
fn value(): i64 = 3

@target("linux")
fn bare(): i64 = 4

@target(arch = 64)
fn number(): i64 = 5

fn main() = {}
