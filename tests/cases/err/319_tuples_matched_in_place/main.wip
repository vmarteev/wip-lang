// A tuple matched in place: a name for the whole has no
// tuple to bind (E0313); the arms still cover every pair (E0311); and a
// place an arm's bindings refer into cannot be assigned while they do
// (E0414).

enum Shape {
    Circle(radius: i64)
    Named(name: String)
}

fn whole(a: &Shape, b: &Shape): i64 = match (a, b) {
    pair => 0
}

fn missing(a: &Shape, b: &Shape): i64 = match (a, b) {
    (.Circle(..), .Circle(..)) => 1
    (.Named(..), _) => 2
}

fn main() = {}
