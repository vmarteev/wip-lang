// `x[i]` is the machine's indexing for an array, a slice and a `str`, and
// for everything else it is what the type says by implementing `Index`.
// A type that says nothing cannot be indexed, and one
// that says `Index<Point, i64>` is not indexed by a number.

struct Plain {
    n: i64
}

struct Grid {
    cells: Vec<i64>
}

struct Point {
    x: i64
    y: i64
}

extend Grid: Index<Point, i64> {
    fn at(key: Point): &i64 = lend self.cells[key.x]
}

// The writing half, beside the interface, which declares the reading one.
extend Grid {
    var fn at(key: Point): &var i64 = lend self.cells[key.x]
}

fn main() = {
    val p = Plain(n: 1)
    val n = p[0]

    val grid = Grid(cells: Vec<i64>())
    val cell = grid[0]
}
