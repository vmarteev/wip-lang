// `@derive(Text)` writes the value field by field, so every field must be one
// that can be written: a number, a `bool`, text, an array of those, or a type
// that implements `Text`. A type that already implements it has its answer, and
// `@derive(Text)` would be a second. A `Vec<i64>` field, and one of a
// parameter's type, are written (`ok/213_derived_text`).

struct Plain {
    n: i64
}

@derive(Text)
struct Holder {
    items: Vec<i64>
    plain: Plain
}

@derive(Text)
struct Twice {
    n: i64
}

extend Twice: Text {
    fn appendTo(out: &var String) = out.push("twice")
}

fn main() = {}
