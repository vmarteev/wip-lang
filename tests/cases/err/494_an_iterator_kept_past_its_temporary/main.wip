// An iterator over a temporary lives as long as a loop that walks it, and
// no longer: kept in a variable past its statement, it would walk a vector
// already dropped — over the vector, or over what a projection of it
// lends.

fn words(): Vec<String> = Vec::of(own [String::of("one"), String::of("two")])

fn main() = {
    var all = words().forwards()
    var lent = words().items().forwards()
    all.next()
    lent.next()
}
