// A `var fn` called on a temporary may answer what points into it: used in
// the same statement it is, and kept past it the temporary is gone, as it
// is for any call that borrows one.

view struct Buffer {
	text: String

	var fn appended(more: str): str = {
		self.text.push(more)
		return self.text.toStr()
	}
}

fn main() = {
	assert(Buffer(text: String()).appended("y") == "y")
	val kept = Buffer(text: String()).appended("x")
	assert(kept == "x")
}
