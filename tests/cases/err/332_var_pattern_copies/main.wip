// A `var` pattern copies a place's parts out, and a part that owns memory
// is never copied: the place gives its value up to the variables, and a
// later use of it is refused (E0404).

fn pair(): (i64, String) = (1, String::of("a"))

fn main() = {
    val p = pair()
    var (n, s) = p
    n += s.len()
    n += p.1.len()
}
