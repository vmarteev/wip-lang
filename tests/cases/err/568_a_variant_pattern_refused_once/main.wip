// A variant taken apart in a `val … else` without naming every field is
// refused for that, once: nothing more is said of the `else` beside it.

enum Shape {
	Circle(radius: i64, centre: i64)
	Square(side: i64)
}

fn radiusOf(shape: Shape): i64 = {
	val .Circle(radius) = shape else return 0
	return radius
}

fn main() = {
	assert(radiusOf(Shape::Circle(radius: 2, centre: 0)) == 2)
}
