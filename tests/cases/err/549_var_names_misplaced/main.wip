// `var` before a name in a `var` pattern, whose names are all variables
// already, is refused with the fix that takes it out (E0136); and `var`
// stands only before a name (E0101).

fn main() = {
	var (a, var b) = (1, 2)
	var .Some(var c) = Option::Some(3) else return
	a += b + c
	val d = match Option::Some(3) {
		.Some(var .Some) => 1
		_ => 2
	}
}
