// Compound assignment takes the operator's operand types, and a writable
// place.

fn main() = {
    var count = 1
    count += 1.5                // operands of different types
    var ratio = 2.0
    ratio &= 2.0                // `&` needs integers
    ratio += 1                  // a float literal was meant
    var done = false
    done &= true                // bitwise operators need integers
    var name = "a"
    name += "b"                 // no `+` on `str`
    val fixed = 3
    fixed -= 1                  // not writable
}
