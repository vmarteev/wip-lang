// Taking part of a temporary (E0409). The value a call
// returns has nowhere to live once the statement ends, so a part of it that
// owns memory cannot be taken out: bind the whole value with `val` first,
// and move the part out of that.

struct Engine {
    power: i64
}

struct Car {
    engine: own<Engine>
    seats: i64
}

fn make(): Car = Car(engine: own Engine(power: 300), seats: 4)

fn take(engine: own<Engine>) = {}

fn bound(): i64 = {
    val e = make().engine
    0
}

fn passed(): i64 = {
    take(make().engine)
    0
}

// Reading a plain field of a temporary is fine: nothing owns memory.
fn fine(): i64 = make().seats
