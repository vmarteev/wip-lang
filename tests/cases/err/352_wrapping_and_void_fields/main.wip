// What 0247 refuses: `+%=` on a type of a program's own, which answers only
// the plain operators; `+% =` written apart, which is no operator; and a
// bare `.Ok` whose field is `void`, with the fix `.Ok()`,
// and a bare one whose field is not, which keeps its message.

struct Money {
    cents: i64
}

fn pay(): Result<void, i64> = .Ok

fn paid(): Result<void, i64> = Result::Ok

fn pass<T>(value: T): Result<T, i64> = .Ok

fn main() = {
    var money = Money(cents: 1)
    money +%= money
}

fn apart() = {
    var x = 1
    x +% = 2
}
