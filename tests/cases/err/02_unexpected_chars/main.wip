// Lexer (E0001, E0008): characters that are not part of the language. Each run
// of bad characters is reported once, `'xy'` is one error rather than two — a
// character literal holds one character — and the column must
// be right even after multi-byte UTF-8 earlier on the same line.
// `@` is not among them: it begins an annotation.

fn main(): i64 = {
    val price = 5 $ 3
    val café = 1
    val s = "naïve"; val t = 2 ` 3
    val q = 'xy'
    #[inline]
    return 0
}
