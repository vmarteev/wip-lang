// A generic's signature `assert` that does not hold for the type arguments
// a call gives is an error at that call (E0445), naming them, with the
// `assert` shown as where it is asked: for a type that is too large, for a
// length that is not a power of two, and through a generic that calls it,
// where the error is at the call that made that generic's instance. Each
// set of type arguments is checked once.

import std::c

val ROOM: u64 = 16

struct Wide {
	a: i64
	b: i64
	c: i64
}

struct Wider {
	a: i64
	b: i64
	c: i64
	d: i64
}

fn stored<C: copy>(value: &C): u64
	assert(c::sizeOf<C>() <= ROOM, "a value fits the room") = c::sizeOf<C>()

fn passed<T: copy>(value: &T): u64 = stored(&value)

struct Ring<val N> {
	length: i64
}

extend Ring<val N> {
	static fn new(): Ring<N>
		assert(N > 0 && (N & (N - 1)) == 0, "a power of two") = Ring(length: N)
}

fn main() = {
	val fits = stored(42)
	val wide = stored(Wide(a: 1, b: 2, c: 3))
	val again = stored(Wide(a: 4, b: 5, c: 6))
	val wider = passed(Wider(a: 1, b: 2, c: 3, d: 4))
	val six: Ring<6> = Ring::new()
}
