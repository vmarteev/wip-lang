// A struct is its name alone only where it is a plain one with no fields:
// a `view struct` borrows through fields it would not have, C has no struct
// without members, and a body begins on the line of the struct's name.

view struct Nothing

extern struct Opaque

struct Late
{
    x: i64
}

fn main() = {
    val late = Late(x: 1)
    assert(late.x == 1)
}
