// Only the prelude's `Location` is filled at a call that has no implicit of
// its name: an implicit of another type is still refused, and so is a
// program's own type that happens to be called `Location` (E0455). A
// panic's place is a `Location` (E0346), and `at` is the one name `panic`
// takes beside its message.

import places

struct Rng {
    seed: i64
}

fn roll(implicit rng: &var Rng): i64 = rng.seed

fn mapped(implicit at: places::Location): i64 = at.row

fn main() = {
    val n = roll()
    val m = mapped()
    panic("stopped", at: 3)
    panic("stopped", where: n)
}
