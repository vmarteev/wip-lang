// A closure kept in a `val` reads what it captures where it is, so what it
// captured must not change while it is still used:
// neither passed as `&var` nor moved away, as for a `str`.

fn changed() = {
    var names: Vec<String> = Vec()
    val empty = () => names.isEmpty()
    names.push("x")
    val before = empty()
}

fn moved() = {
    var names: Vec<String> = Vec()
    val empty = () => names.isEmpty()
    val taken = move names
    val before = empty()
}

fn main() = {}
