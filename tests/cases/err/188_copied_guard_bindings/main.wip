// What a copied `val … else` binding is not: writing
// through it would change the copy, so it is refused and `match` is named;
// and a payload that owns memory still refers to the place, which may not
// change until the block ends.

struct Point {
    x: i64
}

struct Holder {
    point: Option<Point>
}

fn written(h: &var Holder) = {
    val .Some(p) = h.point else {
        return
    }
    p.x = 5
}

fn main() = {}
