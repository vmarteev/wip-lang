// A chain whose closure reads what is around it borrows that, as a view
// does: it does not leave the function that holds it (E0437), and it is
// not used after what it borrows changed (E0436). A closure that names
// nothing around it borrows nothing, and its chain leaves as far as what it
// walks may.

import std::iter::{Forwards, Mapped}

fn leaves(xs: &[i64]): Mapped<Forwards<i64>, i64> = {
    val step = 3
    return xs.forwards().map((x) => x + step)
}

fn double(x: &i64): i64 = x * 2

fn stays(xs: &[i64]): Mapped<Forwards<i64>, i64> from xs = xs.forwards().map(double)

fn changes() = {
    val xs = [1, 2]
    var step = 10
    var shifted = xs.forwards().map((x) => x + step)
    step = 20
    val first = shifted.next()
}

fn main() = {}
