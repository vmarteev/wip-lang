// What a list kept with a constant may not be: one that holds what owns
// memory (E0423), since nothing frees it, and one written through, since a
// constant is only read (E0304).

view struct Spec {
    name: str
    keys: &[str]
}

val SPECS: [Spec; 1] = [Spec(name: "quit", keys: ["q", "Q"])]

val NAMES: &[String] = ["ann", "bo"]

fn main() = {
    SPECS[0].keys[0] = "x"
}
