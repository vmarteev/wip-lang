// Small aggregates a release build keeps as locals of their fields:
// a struct copied whole in and out of memory and written
// by field, one nested in another, a field lent to a call, an enum an
// inlined function answers and a `match` takes apart, and one copied whole,
// which stays in memory. The case runs built both ways, and each prints
// the same.
//
// Expected output: 4, 2.5, 11, 7, 3, 12, 0, 5.

import std::io

struct Pair {
	a: i64
	b: f64
}

struct Outer {
	pair: Pair
	tag: i64
}

enum Maybe {
	Some(value: i64)
	Nothing
}

@inline
fn found(n: i64): Maybe = if n > 0 { .Some(value: n) } else { .Nothing }

fn bump(x: &var i64) = {
	x += 10
}

fn main() = {
	val pair = Pair(a: 3, b: 2.5)
	var copy = pair
	copy.a += 1
	io::printInt(copy.a)
	io::printFloat(copy.b)

	// Whole into memory, and back out.
	var pairs: Vec<Pair> = Vec()
	pairs.push(copy)
	pairs[0].a = 11
	val back = pairs[0]
	io::printInt(back.a)

	// Nested, and a field lent to a call.
	var outer = Outer(pair: Pair(a: 7, b: 0.0), tag: 3)
	io::printInt(outer.pair.a)
	io::printInt(outer.tag)
	bump(&var outer.tag)
	io::printInt(outer.tag + outer.pair.a - 8)

	// Taken apart where it is made, and copied whole.
	val none = match found(-1) {
		.Some(value) => value
		.Nothing => 0
	}
	io::printInt(none)
	val kept = found(5)
	val again = kept
	if again is .Some(value) {
		io::printInt(value)
	}
}
