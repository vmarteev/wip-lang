// Lambdas that capture nothing: `(x) => x * 2` is a plain function value, so it
// goes wherever a function type is expected, and its parameters take their
// types from there.
//
// Expected output: 8 (a lambda as an argument), 6, 3 and 13 (`map`, `filter`
// and `fold` of an `Option`), 200 (`fold` of a `Result`), 6 (types written
// out), 9 (a lambda in a variable), 7 (one that returns nothing, and a
// block body), 25 (a lambda in a field), and 12 (one in a generic function),
// with every allocation freed.

import std::io

fn apply(f: (x: i64) => i64, n: i64): i64 = f(n)

fn applyTwice<T: copy>(f: (x: T) => T, value: T): T = f(f(value))

struct Handler {
    onValue: (value: i64) => i64
}

fn main() = {
    io::printInt(apply((x) => x * 2, 4))

    val some: Option<i64> = .Some(3)
    io::printInt(some.map((x) => x * 2).unwrapOr(0))
    io::printInt(some.filter((x: &i64) => x > 2).unwrapOr(0))
    io::printInt(some.fold(() => 0, (x) => x + 10))

    val err: Result<i64, i64> = .Err(2)
    io::printInt(err.fold((e) => e * 100, (x) => x))

    io::printInt(apply((x: i64): i64 => x + 1, 5))

    val triple = (x: i64) => x * 3
    io::printInt(triple(3))

    val show = (n: i64) => {
        io::printInt(n)
    }
    show(7)

    val handler = Handler(onValue: (value) => value * 5)
    io::printInt(handler.onValue(5))

    io::printInt(applyTwice((x) => x + 3, 6))
}
