// A field whose type asks something of its arguments: `Map<K, V>` takes
// `K: Hash + Eq`. A field's type is resolved before any `extend` block is
// declared, so the check waits until the implementations are there, or a
// struct could not hold a map at all.
//
// Expected output: 2 (a map in a field), 3 (a set in a field), 1 and 2 (a
// vector of vectors, compared), and 7 (a map in an array).

import std::io
import std::collections::{Map, Set}

struct World {
    cells: Map<i64, i64>
    seen: Set<String>
    rows: Vec<Vec<i64>>
}

fn main() = {
    var world = World(
        cells: Map<i64, i64>(),
        seen: Set<String>(),
        rows: Vec<Vec<i64>>(),
    )
    world.cells.put(1, 2)
    io::printInt(world.cells.at(1))

    world.seen.add(String::of("a"))
    world.seen.add(String::of("b"))
    world.seen.add(String::of("c"))
    io::printInt(world.seen.len())

    var row = Vec<i64>()
    row.push(1)
    world.rows.push(move row)
    io::println("\(world.rows.at(0).len()) \(world.rows.len() + 1)")

    var maps = [Map<i64, i64>()]
    maps[0].put(1, 7)
    io::printInt(maps[0].at(1))
}
