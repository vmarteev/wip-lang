// Nested scopes and shadowing. Each block frees its own values, innermost first.
// `if true { … }` opens a scope, as a bare block does.

import std::io

struct Res {
    id: i64
}

fn main(): i64 = {
    val x = 1
    val a = own Res(id: 1)
    if true {
        val x = 2
        val b = own Res(id: 2)
        var n = 0
        while n < 2 {
            val c = own Res(id: n + 10)
            io::printInt(c.id)     // 10, then 11; `c` is freed each iteration
            n = n + 1
        }
        io::printInt(x + b.id)     // 4
    } // `b` is freed here
    io::printInt(x + a.id)         // 2
    0
} // `a` is freed here
