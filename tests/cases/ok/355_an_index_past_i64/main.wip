// An index of 64 bits or more that an `i64` cannot hold is past every
// length, and is said so with what it was, not wrapped into a position.
//
// Expected: a panic, "index 18446744073709551615 is out of bounds".

fn main() = {
    val table: [u8; 4] = [1, 2, 3, 4]
    val big: u64 = 18446744073709551615
    val read = table[big]
    assert(read == 0)
}
