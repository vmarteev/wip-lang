// A struct, an enum or a function may take a length, `val N`: an `i64`
// known where the program compiles, standing where an array's length may
// and a value in the code. A use gives it a number, a constant, a length
// parameter, or its default, or leaves it to be inferred from an array; a
// repeat may be as long as one; and an array may implement a module's own
// interface for every length.
//
// Expected output:
// capacity 3 4
// first 1 last 4
// sum 10 lent 6
// same true false
// filled 7 7 7
// totals 10 6
// shape 1.5
// counted 5 2

import std::io

val WIDE = 4

@derive(Eq)
struct Ring<T, val N = 3> {
    items: [T; N]
    at: i64 = 0
}

extend Ring<T: copy, N> {
    fn capacity(): i64 = N
    fn first(): T = self.items[0]
    fn last(): T = self.items[N - 1]
    fn folded(add: &(a: T, b: T) => T): T = {
        var total = self.items[0]
        for x in self.items[1..N] {
            total = add(total, x)
        }
        return total
    }
    fn all(): &[T] = lend self.items
}

enum Shape<val N> {
    Points(at: [f32; N])
    Nothing
}

interface Counted {
    fn count(): i64
}

extend [T; N]: Counted {
    fn count(): i64 = N
}

fn filled<T: copy, val N>(value: T): [T; N] = [value; N]

fn total<val N>(numbers: [i64; N]): i64 = {
    var sum = 0
    for n in numbers {
        sum += n
    }
    return sum
}

fn sumOf(numbers: &[i64]): i64 = {
    var sum = 0
    for n in numbers {
        sum += n
    }
    return sum
}

fn wrapped<T: copy, val N>(items: [T; N]): Ring<T, N> = Ring(items: items)

fn main() = {
    val ring = Ring(items: [1, 2, 3])
    val wide: Ring<i64, WIDE> = Ring(items: [1, 2, 3, 4])
    io::println("capacity \(ring.capacity()) \(wide.capacity())")
    io::println("first \(wide.first()) last \(wide.last())")
    io::println("sum \(wide.folded((a, b) => a + b)) lent \(sumOf(&ring.all()))")
    io::println("same \(ring == wrapped([1, 2, 3])) \(ring == Ring(items: [3, 2, 1]))")
    val sevens: [u8; 3] = filled(7)
    io::println("filled \(sevens[0]) \(sevens[1]) \(sevens[2])")
    val nine: [i64; 3] = [1, 2, 3]
    io::println("totals \(total([1, 2, 3, 4])) \(total(nine))")
    val shape: Shape<2> = .Points(at: [0.5, 1.5])
    val y = match shape {
        .Points(at) => at[1]
        .Nothing => 0.0
    }
    io::println("shape \(y)")
    io::println("counted \([1, 2, 3, 4, 5].count()) \(["a", "b"].count())")
}
