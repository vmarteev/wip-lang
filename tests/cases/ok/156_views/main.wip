// A `view struct` may hold a `str` or a `&` reference, and is kept where a
// `str` is. What its methods answer borrows what it
// borrows, not the view, so two pieces taken one after the other are both
// still good; and a generic type given a view is one, so `Option<str>`
// and `Vec<str>` stand in locals, parameters and results.

import std::io

/// The words of a text, one at a time.
view struct Words {
    text: str,
    at: i64
}

extend Words {
    static fn of(text: str): Words = Words(text: text, at: 0)

    var fn next(): Option<str> = {
        while self.at < self.text.len() && self.text[self.at] == 32 {
            self.at += 1
        }
        if self.at == self.text.len() {
            return .None
        }
        val start = self.at
        while self.at < self.text.len() && self.text[self.at] != 32 {
            self.at += 1
        }
        .Some(self.text[start..self.at])
    }
}

/// Numbers, lent.
view struct Numbers {
    values: &[i64]
}

fn total(numbers: Numbers): i64 = {
    var sum = 0
    for value in numbers.values {
        sum += value
    }
    sum
}

fn show(word: Option<str>) = match word {
    .Some(w) => io::println(w),
    .None => io::println("none"),
}

fn main() = {
    var owned = String::of("the quick  brown fox")
    var words = Words::of(owned.toStr())
    val first = words.next()
    val second = words.next()
    show(first)
    show(second)

    var rest: Vec<str> = Vec()
    while true {
        match words.next() {
            .Some(w) => rest.push(w),
            .None => { break },
        }
    }
    io::printInt(rest.len())
    for w in rest {
        io::println(w)
    }
    show(words.next())

    val xs = [1, 2, 3]
    io::printInt(total(Numbers(values: &xs)))

    val boxed = Option::Some("literal")
    show(boxed)
}
