// Searching a sorted slice by halves: where a value is,
// or where it would go; and a table of names searched by its key.

import std::io

view struct Known {
    key: str
    size: i64
}

val TABLE: [Known; 4] = [
    Known(key: "c", size: 1),
    Known(key: "go", size: 2),
    Known(key: "rs", size: 3),
    Known(key: "zig", size: 4),
]

fn sizeOf(key: str): i64 = match TABLE.binarySearchBy((known: &Known) => known.key.compare(&key)) {
    .Ok(at) => TABLE[at].size
    .Err(..) => 0
}

fn main() = {
    val numbers = [1, 3, 5, 7, 9]
    io::println("\(numbers.binarySearch(7)) \(numbers.binarySearch(4)) \(numbers.binarySearch(10))")

    var sorted: Vec<i64> = Vec::of(own [2, 4, 8])
    match sorted.binarySearch(6) {
        .Ok(..) => {}
        .Err(at) => sorted.insert(at, 6)
    }
    io::println("\(sorted)")

    val empty: [i64; 0] = []
    io::println("\(empty.binarySearch(1))")

    io::println("\(sizeOf("rs")) \(sizeOf("zig")) \(sizeOf("py"))")
}
