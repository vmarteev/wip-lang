// A variant of one field, named by its path, is the function from its field
// to its enum: given where a function or a closure is expected, lent or
// owned, kept in a `val`, or a generic enum's, whose type arguments come
// from the function type expected. A generic function goes where a closure
// is expected too, its type arguments learnt the same way, in a generic
// function as well.
//
// Expected output:
// io 7
// some 2 .Some(2)
// made 3
// kept 4
// text b
// owned 9
// wrapped 5
// generic 2

import std::io

enum Failure {
    Io(code: i64)
    Parse(at: i64, why: String)
}

enum Wrapped<T> {
    One(value: T)
    Nothing
}

fn wrap<T>(value: T): Wrapped<T> = Wrapped::One(value)

fn optional<T>(values: Vec<T>): Vec<Option<T>> = values.intoIterator().map(Option::Some).toVec()

fn main() = {
    val failed: Result<i64, i64> = .Err(7)
    if failed.mapErr(Failure::Io) is .Err(.Io(code)) then io::println("io \(code)")

    val some = [1, 2].copies().map(Option::Some).toVec()
    io::println("some \(some.len()) \(some[1])")

    val make: (code: i64) => Failure = Failure::Io
    if make(3) is .Io(code) then io::println("made \(code)")
    val kept = Failure::Io
    if kept(4) is .Io(code) then io::println("kept \(code)")

    val texts = ["a", "b"].copies().map(String::of).map(Wrapped::One).toVec()
    if texts[1] is .One(text) then io::println("text \(text)")

    val owned: own<(code: i64) => Failure> = Failure::Io
    if owned(9) is .Io(code) then io::println("owned \(code)")

    val wrapped: Vec<Wrapped<i64>> = [5].copies().map(wrap).toVec()
    if wrapped[0] is .One(n) then io::println("wrapped \(n)")

    val names = optional(["x", "y"].copies().map(String::of).toVec())
    io::println("generic \(names.len())")
}
