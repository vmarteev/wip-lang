pub struct Point {
    pub var x: i64
    pub var y: i64
}

pub enum Shape {
    Circle(radius: i64)
    Rect(width: i64, height: i64)
}

pub fn area(p: &Point): i64 = p.x * p.y

pub fn size(shape: &Shape): i64 = match shape {
    .Circle(radius) => radius * radius * 3
    .Rect(width, height) => width * height
}
