// Modules. The root module is the directory this
// file is in; `util` and `shapes` are directories below it, and the standard
// library is compiled into the compiler. An import binds the last segment of
// its path, or only the names in its braces.
//
// Expected output: 42, 9, 10, 6, 10, 12.

import std::io::{printInt}
import util
import shapes::{Point, Shape, area, size}

fn main(): i64 = {
    // `util` is imported as a module, so its functions stay qualified.
    printInt(util::double(21))
    // `triple` lives in the module's other file and calls something private
    // to the module.
    printInt(util::triple(3))
    printInt((50).clamp(0, 10))

    val p = Point(x: 2, y: 3)
    printInt(area(&p))

    // A variant of an imported enum, with the enum's name and then with a
    // leading dot, where the annotation says which enum.
    printInt(size(Shape::Rect(width: 2, height: 5)))
    val circle: Shape = .Circle(2)
    printInt(size(&circle))
    0
}
