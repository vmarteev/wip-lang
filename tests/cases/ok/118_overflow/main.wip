// An answer that does not fit the type it was written in panics, where the
// language used to wrap silently. The check costs
// about a tenth of a loop that does nothing else, because the machine
// computes the answer and whether it fits in one instruction and the branch
// is never taken.
//
// Where wrapping is what was meant — a hash, a checksum, a counter that is
// supposed to go round — it is written `+%`, `-%` and `*%`, so a reader can
// see which was intended. That is Zig's spelling, for Zig's reason: the two
// are different operations and should not look the same.
//
// Expected output: the sums that fit, the ones that wrap because they were
// asked to, and then the panic, on standard error, with status 101.

import std::io

fn main() = {
    val max = 9223372036854775807
    val min = -9223372036854775808

    io::printInt(max - 1)
    io::printInt(min + 1)

    // Wrapping, asked for.
    io::printInt(max +% 1)
    io::printInt(min -% 1)
    io::printInt(max *% 2)

    // A narrower type wraps at its own width.
    val byte: u8 = 255
    io::printInt((byte +% 1) as i64)

    // And this one does not fit.
    var total = max
    total = total + 1
    io::printInt(total)
}
