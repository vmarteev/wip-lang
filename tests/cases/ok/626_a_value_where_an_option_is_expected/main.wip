// A value where an `Option` or a `Result` of its type is expected is its
// `.Some` or its `.Ok`: at a `return`, an argument, a field, an element, an
// annotated `val`, an assignment, a branch beside a typed one, and either
// side of `==`. A `.Name` the wrapper does not have is the success's; a
// generic `Option<T>` is matched before a value is wrapped; an
// `Option<Option<T>>` wraps an `Option<T>` once; a `Result<str, str>` takes
// text as its `.Ok`; and a function that answers `Result<void, E>` may
// return bare, or end.
//
// Expected output:
// TALK
// none
// array of 2
// error: no
// written
// skipped
// failed: full
// 3 7 1.5
// [1, 2, 3]
// equal
// matched 5 and matched 5
// .Some(.Some(4)) .Some(.None)
// ok: x

import std::io

enum Json {
    Null
    Array(items: Vec<i64>)
}

struct Settings {
    best: Option<u8> = 3
    scale: Option<f32> = .None
}

fn prompt(near: bool): Option<str> = {
    if near then return "TALK"
    return .None
}

fn array(fail: bool): Result<Json, str> = {
    if fail then return .Err("no")
    return .Array([1, 2])
}

fn write(full: bool): Result<void, str> = {
    if full then return .Err("full")
    io::println("written")
}

fn early(skip: bool): Result<void, str> = {
    if skip {
        io::println("skipped")
        return
    }
    io::println("not skipped")
}

fn described<T: Text>(x: Option<T>): String = match x {
    .Some(value) => "matched \(value)"
    .None => "nothing"
}

fn deeper(inner: Option<i64>): Option<Option<i64>> = inner

fn named(text: str): Result<str, str> = {
    return text
}

fn main() = {
    io::println(prompt(true).unwrapOr("none"))
    io::println(prompt(false).unwrapOr("none"))
    match array(false) {
        .Ok(.Array(items)) => io::println("array of \(items.len())")
        _ => io::println("not an array")
    }
    if array(true) is .Err(message) then io::println("error: \(message)")
    write(false).unwrap()
    early(true).unwrap()
    if write(true) is .Err(why) then io::println("failed: \(why)")
    var settings = Settings()
    val seven: Option<u8> = 7
    settings.scale = 1.5
    io::println("\(settings.best.unwrap()) \(seven.unwrap()) \(settings.scale.unwrap())")
    val list: Option<Vec<i64>> = [1, 2, 3]
    io::println("\(list.unwrap())")
    val chosen: Option<i64> = if seven == 7 then 4 else .None
    val i = 4
    if chosen == i && i == chosen && chosen != 5 then io::println("equal")
    val five: Option<i64> = 5
    io::println("\(described(5)) and \(described(five))")
    io::println("\(deeper(4)) \(deeper(.None))")
    if named("x") is .Ok(text) then io::println("ok: \(text)")
}
