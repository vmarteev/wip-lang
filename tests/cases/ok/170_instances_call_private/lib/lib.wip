// Generic functions that lean on private helpers that are not generic.

fn twice(x: i64): i64 = x * 2

fn describe(count: i64): str = if count > 2 { "many" } else { "few" }

pub fn doubleLength<T>(values: &[T]): i64 = twice(values.len())

pub fn sizeOf<T>(values: &[T]): str = describe(values.len())

pub fn doubledOnes<T: copy>(values: &[T]): Vec<i64> = values.walk().map(own (v) => twice(1)).toVec()
