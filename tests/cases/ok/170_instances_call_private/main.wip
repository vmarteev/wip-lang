// A generic function may call what its own module keeps to itself, and an
// instance of it made in another module still reaches it: the instance is
// compiled where it was made, and what its body calls is exported for it, as a
// drop or a table's method is. A lambda written inside the generic function
// reaches it the same way.

import std::io
import lib::{doubleLength, sizeOf, doubledOnes}

fn main() = {
    val numbers = [3, 9, 4]
    io::printInt(doubleLength(&numbers))
    io::println(sizeOf(&numbers))
    io::println("\(doubledOnes(&numbers))")
}
