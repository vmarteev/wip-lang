// `void` has one value: every `void` is equal to every other and comes
// before none, hashes as nothing, and is written `{}`. So a `Result<void,
// E>`, what a function that can fail and answers nothing answers, compares
// where `E` does, and an `Option<void>` is written, hashed and kept in a
// set.
//
// Expected output: {} .Some({}) .Ok({}), then 2.

import std::collections::{Set}
import std::io

@derive(Eq, Text)
enum ListError {
	NoSuchItem(index: i64)
}

fn markDone(index: i64): Result<void, ListError> =
	if index < 3 then .Ok({}) else .Err(.NoSuchItem(index: index))

fn main() = {
	assert(markDone(2) == .Ok({}))
	assert(markDone(5) == .Err(.NoSuchItem(index: 5)))
	assert(markDone(5) != .Ok({}))

	val nothing: void = {}
	assert(nothing == {})
	assert(!(nothing < {}) && nothing <= {})

	val maybe: Option<void> = .Some({})
	assert(maybe == .Some({}))
	io::println("\(nothing) \(maybe) \(markDone(1))")

	var seen: Set<Option<void>> = Set()
	seen.add(.Some({}))
	seen.add(.Some({}))
	seen.add(.None)
	io::println("\(seen.len())")
}
