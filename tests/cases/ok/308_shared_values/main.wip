// A value several owners hold: the text of a document that
// two versions share until one is edited, and a tree whose children link
// back to their parent with a `Weak`, which does not keep it. Each `share`
// is where a count goes up; each owner reads through a `&`.
//
// Expected output: 2, "draft", "draft", "final", 1, "root", 0, false.

import std::io
import std::shared::{Shared, Weak}

struct Version {
	text: Shared<String>
}

struct Node {
	name: String
	parent: Option<Weak<Node>>
}

fn main() = {
	val first = Version(text: Shared::of(String::of("draft")))
	var second = Version(text: first.text.share())
	io::printInt(first.text.owners())
	io::println("\"\(first.text.value())\"")
	second.text.edit().clear()
	second.text.edit().push("final")
	io::println("\"\(first.text.value())\"")
	io::println("\"\(second.text.value())\"")
	io::printInt(first.text.owners())

	val root = Shared::of(Node(name: String::of("root"), parent: .None))
	val child = Node(name: String::of("leaf"), parent: .Some(root.downgrade()))
	if child.parent is .Some(link) && link.upgrade() is .Some(parent) {
		io::println("\"\(parent.value().name)\"")
	}
	destroy(move root)
	io::printInt(if child.parent is .Some(link) && link.upgrade().isSome() { 1 } else { 0 })
	io::println("\(child.parent.map((link) => link.upgrade().isSome()).unwrapOr(true))")
}
