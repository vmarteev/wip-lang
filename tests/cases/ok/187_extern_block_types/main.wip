// A `struct` written inside an `extern "C"` block is C's layout, and takes
// the block's `@header`: the block says `extern` once, so
// a binding of a hundred structs does not repeat an annotation a hundred
// times. It is the same declaration as `extern struct` at the top level,
// which is still how a struct with no block is written.
//
// The two are mixed here on purpose. `area` is a `static inline` that only
// C can call, so it names the header itself: the block's says where the
// types are, and `quadrant` is called directly.
//
// Expected output: 2 (the quadrant of a point passed by value), 12 (a
// circle through a `static inline`), 1 (a union written in the block),
// and 3 (a struct declared the old way).

import std::io

@header("shapes.h")
extern "C" {
    pub struct Point {
        x: f64,
        y: f64
    }

    pub struct Circle {
        at: Point,
        r: f64
    }

    // A union in a block is C's too.
    union Bits {
        whole: i64,
        half: i32
    }

    @header("shapes.h")
    fn area(c: Circle): f64
    fn quadrant(p: Point): i64
}

// A struct with no block of its own says `extern` itself, and names the
// header it belongs to.
@header("shapes.h")
extern struct Pair {
    first: i64,
    second: i64
}

fn main() = {
    val here = Point(x: -1.0, y: 2.0)
    io::printInt(quadrant(here))
    val round = Circle(at: here, r: 2.0)
    io::printInt(area(round) as i64)
    val bits = Bits(whole: 1)
    io::printInt(bits.whole)
    val pair = Pair(first: 1, second: 2)
    io::printInt(pair.first + pair.second)
}
