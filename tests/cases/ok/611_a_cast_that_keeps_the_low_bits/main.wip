// `as%` makes an integer, or a character, another integer type by keeping
// its low bits and reading them in that type: the value modulo 2 to the
// width. A narrower type keeps what fits, and a type of the other sign
// reads the same bits as its own.
//
// Expected output:
// 44 255 52
// 18446744073709551615 -1
// 205 4294967295
// 172 -84

import std::io

fn byteOf(word: u32, at: u32): u8 = (word >> (8 * at)) as% u8

fn main() = {
	val n = 300
	val big: i64 = 0x1234
	io::println("\(n as% u8) \(-1 as% u8) \(big as% u8)")
	val minus: i64 = -1
	val all = minus as% u64
	io::println("\(all) \(all as% i64)")
	io::println("\(byteOf(0xABCD, 0)) \(-1 as% u32)")
	val euro = '€'
	io::println("\(euro as% u8) \(euro as% i8)")
}
