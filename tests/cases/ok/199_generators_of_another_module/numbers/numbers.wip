/// The numbers from 0 up to `n`, one at a time.
pub fn upTo(n: i64): Iterator<i64> = {
    var i = 0
    while i < n {
        yield i
        i += 1
    }
}

/// The lengths of names it owns, and then how many there were.
pub fn lengths(names: Vec<String>): Iterator<i64> = {
    for name in names.items() {
        yield name.len()
    }
    yield names.len()
}
