// A generator walked in another module than its own. Its
// `next` belongs to a struct the compiler writes, which is never `pub`, so
// the module that walked it did not declare it, and the compiler stopped:
// "`next` was not declared". The case runs with the leak check on.
//
// Expected output: 6, then 5 4 2.

import std::io
import numbers::{lengths, upTo}

fn main() = {
    var total = 0
    for n in upTo(4) {
        total += n
    }
    io::println("\(total)")

    var names: Vec<String> = Vec()
    names.push(String::of("hello"))
    names.push(String::of("wip!"))
    var line = String()
    for n in lengths(move names) {
        line.push("\(n) ")
    }
    io::println(line.toStr().trimEnd())
}
