// In an array of tuples, each position takes the type of the first part
// there that says its own, and a literal in that position takes it: a
// float before an `f32`, an integer before a `u8`, a position of tuples
// worked out the same way, a position of literals alone, and a tuple
// beside a value that says the whole type. An array of calls is no array
// of tuples, whatever the number of arguments.
//
// Expected output:
// 4 f32 f32 bool
// 1 u8
// 0.5 3
// 2.5 7
// 3 15

import std::io

fn sides(reach: f32): i64 = {
    var count = 0
    for (x, z, alongX) in [(0.0, -reach, true), (0.0, reach, true), (-reach, 0.0, false), (reach, 0.0, false)] {
        val across: f32 = x + z
        if alongX || across != 0.0 then count += 1
    }
    return count
}

fn one(x: i64): i64 = x

fn five(a: i64, b: i64, c: i64, d: i64, e: i64): i64 = a + b + c + d + e

fn main() = {
    io::println("\(sides(12.0)) f32 f32 bool")
    val small: u8 = 7
    val big: i64 = 1
    val pairs = [(1, small), (big, 2)]
    val firstSmall: u8 = pairs[0].1
    io::println("\(pairs[0].0) u8")
    val a: f32 = 0.5
    val b: f32 = 1.5
    val nested = [((0.0, 1), a), ((b, 2), 0.5)]
    val inner: f32 = nested[0].0.0
    io::println("\(nested[1].1 + inner) \(nested[0].0.1 + nested[1].0.1)")
    val pair: (f64, i64) = (2.5, 7)
    val withValue = [pair, (1.0, 3)]
    io::println("\(withValue[0].0) \(withValue[0].1 + firstSmall as i64 - 7)")
    val ones = [one(1), one(2)]
    val fives = [five(1, 2, 3, 4, 5), five(0, 0, 0, 0, 0)]
    io::println("\(ones[0] + ones[1]) \(fives[0] + fives[1])")
}
