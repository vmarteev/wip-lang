// A binding of plain data that is only read is a copy, so the place it came
// from may change while it is in scope; one written through is still the
// place.

import std::io

enum Fruit {
	Cherry
	Key
}

struct Game {
	fruit: Option<Fruit> = .Some(.Key)
	score: i64 = 0
	queue: Option<i64> = .Some(3)
	slots: [Option<i64>; 2] = [.Some(10), .None]
}

extend Game {
	var fn eat() = {
		if self.fruit is .Some(fruit) {
			self.fruit = .None
			self.score += match fruit {
				.Cherry => 10
				.Key => 500
			}
		}
	}

	var fn add(amount: i64) = {
		self.score += amount
	}

	var fn play() = {
		for slot in 0..2 {
			match self.slots[slot] {
				// `self` is lent as `&var` while `amount` is read.
				.Some(amount) => self.add(amount)
				.None => {}
			}
		}
	}
}

fn main() = {
	var game = Game()
	game.eat()
	game.play()
	io::println("\(game.score) \(game.fruit.isNone())")

	// A `while … is` whose binding outlives the change to its place.
	var total = 0
	while game.queue is .Some(n) {
		game.queue = if n > 1 { .Some(n - 1) } else { .None }
		total += n
	}
	io::println("\(total)")

	// Written through, a binding is still the place.
	var counter: Option<i64> = .Some(1)
	match counter {
		.Some(n) => n += 41
		.None => {}
	}
	io::println("\(counter.unwrap())")
}
