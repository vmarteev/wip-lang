// `x[i]` is a lookup the type answers. An array, a slice
// and a `str` are indexed by the machine; everything else implements the
// prelude's `Index` for a key, or `Sequence` for a position,
// each a lending pair: `x[i]` reads through one half and
// `x[i] = v` writes through the other.
//
// So an array and a `Vec` are indexed alike, `xs[0]` and `v[0]`, and so is
// a type of a program's own, by any key it likes.
//
// Expected output: 7 (a vector read), 9 and 9 (one written, and one read
// and written at once), 9 (a generic function that indexes through its
// constraint), 5 (an array, as before), 3 (a grid of its own, by a
// point), and 7 (`at` called by its own name).

import std::io

@derive(Eq, Hash)
struct Point {
    x: i64
    y: i64
}

struct Grid {
    width: i64
    cells: Vec<i64>
}

extend Grid: Index<Point, i64> {
    fn at(key: Point): &i64 = lend self.cells[key.y * self.width + key.x]
}

// The writing half, beside the interface, which declares the reading one.
extend Grid {
    var fn at(key: Point): &var i64 = lend self.cells[key.y * self.width + key.x]
}

// Anything indexed by a position, whatever it is: a sequence carries its
// length, which `Index` does not.
fn total<C: Sequence<i64>>(c: &C): i64 = {
    var sum = 0
    var i = 0
    while i < c.len() {
        sum += c[i]
        i += 1
    }
    return sum
}

fn main() = {
    var v = Vec<i64>()
    v.push(7)
    v.push(8)
    io::printInt(v[0])

    v[0] = 9
    v[1] += 1
    io::println("\(v[0]) \(v[1])")

    io::printInt(total(&v) - 9)

    val n = [4, 5]
    io::printInt(n[1])

    var grid = Grid(width: 2, cells: Vec<i64>())
    grid.cells.push(0)
    grid.cells.push(0)
    grid.cells.push(0)
    grid.cells.push(3)
    io::printInt(grid[Point(x: 1, y: 1)])

    // The method is there by its own name, as `Items::items` is.
    io::printInt(v.at(0) - 2)
}
