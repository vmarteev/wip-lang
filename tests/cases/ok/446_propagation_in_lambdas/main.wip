// `?` in a lambda whose result is neither written nor expected: it is
// checked once the result is said — by the lambda's first `return`, by its
// body's value, or through a generic callee — and on a `Result` whose error
// differs it converts through `From`, as in a function.
//
// Expected output: .Some(3) and .None through the callee; .Some(2) and
// .None said by a `return`; .Some(5) said by the body's value; then
// "wrapped: not positive" and 10, the error converted.

import std::io

fn half(n: i64): Option<i64> = if n % 2 == 0 then .Some(n / 2) else .None

fn apply<E>(n: i64, f: (n: i64) => Option<E>): Option<E> = f(n)

struct Small {
	text: String
}

enum Big {
	Wrapped(small: Small)
}

extend Big: From<Small> {
	static fn from(small: Small): Big = .Wrapped(small: small)
}

fn positive(n: i64): Result<i64, Small> =
	if n > 0 then .Ok(n) else .Err(Small(text: "not positive"))

fn main() = {
	io::println("\(apply(4, (n) => .Some(half(n)? + 1))) \(apply(3, (n) => .Some(half(n)? + 1)))")
	val quarter = (n: i64) => {
		val h = half(n)?
		return half(h)
	}
	io::println("\(quarter(8)) \(quarter(6))")
	val plusOne = (n: i64) => {
		val h = half(n)?
		.Some(h + 1)
	}
	io::println("\(plusOne(8))")
	val doubled = (n: i64) => {
		val p = positive(n)?
		val made: Result<i64, Big> = .Ok(p * 2)
		return made
	}
	match doubled(-1) {
		.Ok(v) => io::println("\(v)")
		.Err(.Wrapped(small)) => io::println("wrapped: \(small.text)")
	}
	match doubled(5) {
		.Ok(v) => io::println("\(v)")
		.Err(.Wrapped(small)) => io::println("wrapped: \(small.text)")
	}
}
