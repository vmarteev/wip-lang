// A C string may be null, as C's `const char *` may: `null` is passed
// where C takes one, C answers one where there is nothing, and a C struct's
// string left out of its literal is one. `isNull` asks, and so does
// comparing with `null`, which has no text to compare; two C strings still
// compare by their text.
//
// Expected output: what C answered for a null and for a name, a field left
// out, and two C strings compared by their text.

import std::io

extern "C" {
    struct Window {
        title: cstring
        width: c_int
    }

    fn named(name: cstring): cstring
}

fn main() = {
    val none = named(null)
    io::println("none: \(none.isNull) \(none == null) \(null == none) \(none != null)")
    val some = named("wip")
    val shown = if some.isNull then "nothing" else some.toStr()
    io::println("some: \(some == null), \(shown)")
    val window = Window(width: 640)
    io::println("title: \(window.title.isNull)")
    val text: cstring = "wip"
    io::println("text: \(some == text) \(some != "c")")
}
