// A module's own C files: every `.c` file beside the `.wip` files is compiled
// and linked with the program, and the module's directory is on the include
// path, so `counter.c` finds `counter.h`. C keeps state of its own between
// calls.
//
// Expected output: 1, 2, 3 (a counter kept in C), and 7 (a C function of two
// arguments).

import std::io

extern "C" {
    fn counter_next(): i64
    fn counter_add(a: i64, b: i64): i64
}

fn main() = {
    io::printInt(counter_next())
    io::printInt(counter_next())
    io::printInt(counter_next())
    io::printInt(counter_add(3, 4))
}
