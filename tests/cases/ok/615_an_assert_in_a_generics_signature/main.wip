// A generic function's signature may end with `assert(…)`, a fact about
// its type and length parameters, checked while the program compiles for
// each set of type arguments a call gives: here for two types, through a
// generic that calls it, for a length, and for a method of a generic type,
// whose fact names the type's parameter as well as its own. A fact that
// holds leaves nothing in the program.
//
// Expected output:
// 8 16 8
// 8
// 4 2

import std::c
import std::io

val ROOM: u64 = 16

struct Pair {
	a: i64
	b: i64
}

fn stored<C: copy>(value: &C): u64
	assert(c::sizeOf<C>() <= ROOM, "a value fits the room") = c::sizeOf<C>()

fn passed<T: copy>(value: &T): u64 = stored(&value)

struct Ring<val N> {
	length: i64
}

extend Ring<val N> {
	static fn new(): Ring<N>
		assert(N > 0 && (N & (N - 1)) == 0, "a power of two") = Ring(length: N)
}

struct Lanes<T> {
	count: i64
}

extend Lanes<T> {
	static fn of<U: copy>(part: U): Lanes<T>
		assert(c::sizeOf<T>() >= c::sizeOf<U>(), "a lane holds a part")
		assert(c::sizeOf<T>() % c::sizeOf<U>() == 0) = Lanes(count: partsOf<T, U>())
}

fn partsOf<T, U>(): i64 = (c::sizeOf<T>() / c::sizeOf<U>()) as i64

fn main() = {
	io::println("\(stored(42)) \(stored(Pair(a: 1, b: 2))) \(passed(7))")
	val ring: Ring<8> = Ring::new()
	io::println("\(ring.length)")
	val part: u16 = 0
	val wide = Lanes<u64>::of(part)
	val narrow = Lanes<u32>::of(part)
	io::println("\(wide.count) \(narrow.count)")
}
