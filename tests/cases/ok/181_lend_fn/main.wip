// A lending pair written once: `lend fn` is the reading
// half as written and the writing half from the same body, `&T` where the
// call reads and `&var T` where it writes. The body is checked both ways,
// so a branch that picks which place to lend works for both.
//
// Expected output: 9, then 4 1 after writing through the larger; a ring
// buffer read, written and walked through one `at`: 2 21 4; 27 summed
// through `Sequence<i64>`; and a map's value written by key, 11.

import std::io
import std::collections::{Map}

struct Pair {
    first: i64,
    second: i64
}

extend Pair {
    // Which field is lent is decided by the values; both halves agree.
    lend fn larger(): &i64 = if self.first >= self.second {
        lend self.first
    } else {
        lend self.second
    }
}

struct Ring {
    slots: [i64; 3],
    start: i64
}

// In the block that implements the interface, the writing half stands
// beside the reading one `Sequence` asks for.
extend Ring: Sequence<i64> {
    fn len(): i64 = 3

    lend fn at(i: i64): &i64 = lend self.slots[(self.start + i) % 3]
}

fn total<C: Sequence<i64>>(c: &C): i64 = {
    var sum = 0
    for x in c {
        sum += x
    }
    sum
}

fn main() = {
    var pair = Pair(first: 4, second: 9)
    io::println("\(pair.larger())")
    pair.larger() = 1
    io::println("\(pair.first) \(pair.second)")

    var ring = Ring(slots: [1, 2, 3], start: 0)
    ring[4] = 20
    for x in ring {
        x += 1
    }
    io::println("\(ring[0]) \(ring[1]) \(ring[2])")
    io::println("\(total(&ring)) summed")

    var map = Map<str, i64>()
    map.put("a", 10)
    map.at("a") += 1
    io::println("\(map.at("a"))")
}
