// C pointers: `ptr<T>` is a C pointer — it may be null, it
// is copied like an integer, it is never dropped, and the move checker
// leaves it alone, so it can be held in a variable where a reference cannot.
// `type Db` declares a C type whose contents Wip does not know, which is
// only ever written as `ptr<Db>`.
//
// Expected output: 0 (the status of a call that filled an out-parameter),
// 5 (a length computed in C, read back through the pointer), 1 (a pointer
// that is not null), 5 again (through a `ptr<void>` and back), 1 (a handle
// that failed to open is null), and 7 (a pointer kept in a struct field).

import std::io

extern "C" {
    type Db
    fn db_open(name: cstring, out: &var ptr<Db>): c_int
    fn db_rows(db: ptr<Db>): i64
    fn db_close(db: ptr<Db>)
    fn db_as_void(db: ptr<Db>): ptr<void>
}

// A C pointer is a value like any other, so a struct may hold one.
struct Connection {
    handle: ptr<Db>,
    id: i64
}

fn main() = {
    var db: ptr<Db> = null
    val status = db_open("hello", &var db)
    defer db_close(db)
    io::printInt(status as i64)
    io::printInt(db_rows(db))

    val anonymous: ptr<void> = db_as_void(db)
    if anonymous.isNull { io::printInt(0) } else { io::printInt(1) }
    io::printInt(db_rows(anonymous as ptr<Db>))

    var failed: ptr<Db> = null
    db_open("bad", &var failed)
    if failed.isNull { io::printInt(1) } else { io::printInt(0) }

    val connection = Connection(handle: db, id: 7)
    io::printInt(connection.id)
}
