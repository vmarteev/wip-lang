// A pattern that tests a value, met where the value is a reference, tests
// what the reference refers to, at any depth: a variant, a number, a
// character's range, text, a slice, a tuple and a struct below an
// `Option<&T>`, two references deep, in a `match`, an `is` test, a
// `val … else` and a `for` over references. A binding below a reference
// reads through it. A `match` whose arms cover the referent's variants is
// complete without `_`, and a name at the reference binds the reference.
//
// Expected output: `matched through references`.

import std::collections::{Map}
import std::io

enum Kind {
	Int
	Float
	Text(name: String)
}

enum Token {
	Word(text: String)
	Space
}

struct Point {
	x: i64
	y: i64
}

fn kind(k: Option<&Kind>): bool = k is .Some(.Int)

fn digit(c: Option<&char>): bool = c is .Some('0'..='9')

fn three(n: Option<&i64>): bool = n is .Some(3)

fn width(token: Option<&Token>): i64 = match token {
	.Some(.Word(text)) => text.len()
	.Some(.Space) => 1
	.None => 0
}

fn named(k: Option<&Kind>): str = match k {
	.Some(.Int) => "int"
	.Some(.Float) => "float"
	.Some(.Text("struct")) => "a struct"
	.Some(.Text(name)) => name.toStr()
	.None => "none"
}

fn deep(k: Option<& &Kind>): bool = k is .Some(.Float)

fn firstTwo(xs: Option<&[i64]>): i64 = match xs {
	.Some([a, b, ..]) => a + b
	.Some(_) => -1
	.None => 0
}

fn origin(p: Option<&Point>): bool = p is .Some(Point(x: 0, y: 0))

fn sum(p: Option<&Point>): i64 = {
	val .Some(Point(x, y)) = p else {
		return 0
	}
	return x + y
}

fn onAxis(pair: Option<&(i64, i64)>): bool = pair is .Some((0, _)) || pair is .Some((_, 0))

fn total(points: &Vec<Point>): i64 = {
	var sum = 0
	for Point(x, y) in points.forwards() {
		sum += x * y
	}
	return sum
}

fn main() = {
	val kinds: Vec<Kind> = Vec::of(own [
		Kind::Int,
		Kind::Text(name: "struct"),
		Kind::Text(name: "enum"),
	])
	assert(kind(kinds.first()))
	assert(!kind(kinds.last()))
	assert(named(.Some(&kinds[1])) == "a struct")
	assert(named(.Some(&kinds[2])) == "enum")
	assert(named(.None) == "none")
	assert("x7".chars().peekable().peek() is .Some('x'))
	val digits = ['4', 'a']
	assert(digit(digits.first()) && !digit(digits.last()))
	val n = 3
	assert(three(.Some(&n)))
	val tokens: Vec<Token> = Vec::of(own [Token::Word(text: "hello"), Token::Space])
	assert(width(tokens.first()) == 5 && width(tokens.last()) == 1 && width(.None) == 0)
	val k = &kinds[0]
	assert(!deep(.Some(&k)))
	val numbers = [1, 2, 3]
	assert(firstTwo(.Some(&numbers)) == 3)
	val p = Point(x: 0, y: 0)
	val q = Point(x: 2, y: 5)
	assert(origin(.Some(&p)) && !origin(.Some(&q)) && sum(.Some(&q)) == 7)
	val pair = (0, 4)
	val other = (3, 4)
	assert(onAxis(.Some(&pair)) && !onAxis(.Some(&other)))
	val points: Vec<Point> = Vec::of(own [Point(x: 2, y: 3), Point(x: 4, y: 5)])
	assert(total(&points) == 26)
	var counts: Map<String, i64> = Map()
	counts.put("a", 1)
	assert(counts.get("a") is .Some(1))
	match counts.get("a") {
		.Some(1..=5) => {}
		_ => assert(false)
	}
	val first: Option<&Token> = tokens.first()
	if first is .Some(token) then
		assert(token is .Word(_), "a name at the reference binds the reference")
	io::println("matched through references")
}
