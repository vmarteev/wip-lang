// `c::bytesOf(&value)` is a value's bytes, as C sees them at its address:
// an integer's, in the machine's order; a struct of floats; an array; a
// `@packed` struct, with no gap; a C struct; an enum without payloads, its
// tag; given through a generic function; and copied into an array, as a
// GPU's constants are.
//
// Expected output:
// 4 10
// 8
// 6
// 5
// 8
// 1
// 63

import std::c
import std::io

struct Point {
    x: f32
    y: f32
}

@packed
struct Tight {
    tag: u8
    value: u32
}

enum Side {
    Left
    Right
}

extern "C" {
    struct Pair {
        a: i32
        b: i32
    }
}

fn total(bytes: &[u8]): i64 = {
    var sum = 0
    for b in bytes {
        sum += b as i64
    }
    return sum
}

fn byteCount<T: copy>(value: &T): i64 = c::bytesOf(&value).len()

fn main() = {
    val n: u32 = 0x01020304
    io::println("\(c::bytesOf(&n).len()) \(total(&c::bytesOf(&n)))")
    val point = Point(x: 1.0, y: 2.0)
    io::println("\(byteCount(&point))")
    val numbers: [u16; 3] = [1, 2, 3]
    io::println("\(total(&c::bytesOf(&numbers)))")
    val tight = Tight(tag: 1, value: 2)
    io::println("\(c::bytesOf(&tight).len())")
    io::println("\(byteCount(Pair(a: 1, b: 2)))")
    io::println("\(c::bytesOf(Side::Right)[0])")
    var constants: [u8; 8] = [0; 8]
    constants.copyFrom(&c::bytesOf(&point))
    io::println("\(constants[3])")
}
