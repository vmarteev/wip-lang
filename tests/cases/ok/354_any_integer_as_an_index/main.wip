// An index of any integer type: an array's, a slice's, a
// range's bounds, and a `Vec`'s through its `at`, read and written; a
// table's `u16` indexing another; and 64 and 128 bits through the
// prelude's checks.
//
// Expected output:
// 20 30 40 10 20 30 40 10
// 7 80 | 2 | 20

import std::io

val TABLE: [u16; 4] = [10, 20, 30, 40]

fn main() = {
    val a: u8 = 1
    val b: u16 = 2
    val c: u32 = 3
    val d: u64 = 0
    val e: i8 = 1
    val f: usize = 2
    val g: u128 = 3
    val h: i128 = 0
    io::println("\(TABLE[a]) \(TABLE[b]) \(TABLE[c]) \(TABLE[d]) \(TABLE[e]) \(TABLE[f]) \(TABLE[g]) \(TABLE[h])")
    var list = Vec::of(own [5, 6, 7, 8])
    list[c] = 80
    val table = TABLE
    val part = &table[a..c]
    io::println("\(list[b]) \(list[c]) | \(part.len()) | \(TABLE[TABLE[0] / 10])")
}
