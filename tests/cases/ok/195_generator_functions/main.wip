// A function that answers `Iterator<T>` and yields is a generator:
// nothing of its body runs until a value is asked for.
// What it was given is the generator's: a `str` it borrows, a `Vec` it
// owns, dropped whether it was started or not. A body that is one loop is
// the function's own; `return` ends it; a method yields as a function
// does; and a tree is walked by a generator that walks itself, on the
// heap. The case runs with the leak check on.

import std::io

fn words(text: str): Iterator<str> = {
    var start = 0
    var i = 0
    while i < text.len() {
        if text[i] == 32 {
            if i > start {
                yield text[start..i]
            }
            start = i + 1
        }
        i += 1
    }
    if start < text.len() {
        yield text[start..]
    }
}

fn evens(xs: &[i64]): Iterator<i64> = for x in xs { if x % 2 == 0 { yield x } }

fn numbered(names: Vec<String>): Iterator<String> = {
    io::println("started")
    for i in 0..names.len() {
        yield "\(i): \(names[i])"
    }
}

// Its own `Vec`, walked: the elements are on the heap, and stay where
// they are when the generator is moved.
fn doubled(values: Vec<i64>): Iterator<i64> = {
    for value in values {
        yield value * 2
    }
}

// A `String` it owns lends its bytes from the heap too.
fn letters(text: String): Iterator<u8> = {
    for byte in text {
        yield byte
    }
}

fn upTo<T: copy>(values: &[T], stop: i64): Iterator<T> = {
    for i in 0..values.len() {
        if i == stop {
            return
        }
        yield values[i]
    }
}

struct Deck {
    cards: Vec<i64>,
}

extend Deck {
    fn over(limit: i64): Iterator<i64> = for card in self.cards { if card > limit { yield card } }
}

enum Tree {
    Leaf(value: i64)
    Node(children: own<[Tree]>)
}

fn leaves(tree: &Tree): Iterator<i64> = {
    match tree {
        .Leaf(value) => { yield value }
        .Node(children) => {
            for child in children {
                for value in own leaves(&child) {
                    yield value
                }
            }
        }
    }
}

fn main() = {
    var all = String()
    for w in words("the quick  brown fox") {
        all.push(w)
        all.push("|")
    }
    assert(all == "the|quick|brown|fox|")
    assert(evens([1, 2, 3, 4]).toVec() == Vec::of(own [2, 4]))

    var names: Vec<String> = Vec()
    names.push(String::of("a"))
    names.push(String::of("b"))
    var lines = numbered(move names)
    io::println("made")
    assert(lines.next() == .Some(String::of("0: a")))

    // Never started: what it was given is dropped where it lies.
    var kept: Vec<String> = Vec()
    kept.push(String::of("never asked for"))
    val unstarted = numbered(move kept)

    assert(upTo([5, 6, 7], 2).toVec() == Vec::of(own [5, 6]))

    // Moved while it waits, twice: into a variable, then into `take`.
    var twice = doubled(Vec::of(own [1, 2, 3, 4]))
    assert(twice.next() == .Some(2))
    var moved = move twice
    assert(moved.next() == .Some(4))
    assert((move moved).take(5).toVec() == Vec::of(own [6, 8]))
    assert(letters(String::of("ab")).toVec() == Vec::of(own [97 as u8, 98 as u8]))
    val deck = Deck(cards: Vec::of(own [3, 9, 1, 12]))
    assert(deck.over(5).toVec() == Vec::of(own [9, 12]))

    val tree = Tree::Node(children: own [
        .Leaf(1),
        .Node(children: own [.Leaf(2), .Leaf(3)]),
        .Leaf(4),
    ])
    assert(leaves(&tree).toVec() == Vec::of(own [1, 2, 3, 4]))
    var partly = leaves(&tree)
    assert(partly.next() == .Some(1))
    assert(partly.next() == .Some(2))
    io::println("done")
}
