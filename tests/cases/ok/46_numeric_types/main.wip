// Integer and float types. A literal takes the integer or
// float type expected of it. Arithmetic needs operands of one type, panics on
// overflow, and divides and compares unsigned values as unsigned. `as`
// converts between all of them: widening extends by the source's sign,
// narrowing keeps the low bits, and a float converts toward zero, saturating.

import std::io

fn main(): i64 = {
    // The limits of each type.
    val a: i8 = -128
    val b: u8 = 255
    val c: i16 = -32768
    val d: u16 = 65535
    val e: i32 = -2147483648
    val f: u32 = 4294967295
    val g: u64 = 18446744073709551615
    val h: isize = -9223372036854775808
    val i: usize = 18446744073709551615
    io::printInt(a as i64)                      // -128
    io::printInt(b as i64)                      // 255
    io::printInt(c as i64)                      // -32768
    io::printInt(d as i64)                      // 65535
    io::printInt(e as i64)                      // -2147483648
    io::printInt(f as i64)                      // 4294967295
    io::printUnsigned(g)                             // 18446744073709551615
    io::printInt(h as i64)                      // -9223372036854775808
    io::printUnsigned(i as u64)                      // 18446744073709551615

    // Wrapping, at each type's width.
    io::printInt((b +% 1) as i64)               // 0, since `+%` wraps
    io::printInt((a -% 1) as i64)               // 127, the same way
    io::printUnsigned(g +% 2)                        // 1, wrapping u64

    // Unsigned division, remainder and comparison.
    io::printUnsigned(g / 2)                         // 9223372036854775807
    io::printUnsigned(g % 10)                        // 5
    io::printInt(if f > 1 { 1 } else { 0 })     // 1: `f` is not -1

    // 128 bits.
    val big: i128 = 9223372036854775807
    val bigger = big * 1000
    io::printInt((bigger / 1000) as i64)        // 9223372036854775807
    val top: u128 = 340282366920938463463374607431768211455
    io::printUnsigned((top / 18446744073709551616) as u64) // 18446744073709551615
    val low: i128 = -170141183460469231731687303715884105728
    io::printInt(if low < 0 { 1 } else { 0 })  // 1

    // Conversions.
    io::printInt(-1 as i8 as u8 as i64)         // 255: the same bits
    io::printInt(200 as u8 as i8 as i64)        // -56
    io::printInt(65535 as u16 as i32 as i64)    // 65535: zero-extended
    io::printInt(3.9 as u8 as i64)              // 3
    io::printInt(-1.5 as u8 as i64)             // 0: saturated
    io::printInt(300.0 as u8 as i64)            // 255: saturated
    io::printFloat(g as f64)                      // 1.84467e+19
    val half: f32 = 0.5
    io::printFloat((half * 3.0) as f64)           // 1.5
    0
}
