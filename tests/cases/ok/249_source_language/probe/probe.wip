// The same file, compiled as Objective-C on a Mac, as a window layer's is,
// and as C elsewhere.
@target(vendor = "apple")
@source("src/probe.c", language = "objective-c")
extern "C" {}

@target(os = "linux")
@source("src/probe.c", language = "c")
extern "C" {}

extern "C" {
	pub fn probe_objc(): c_int
}
