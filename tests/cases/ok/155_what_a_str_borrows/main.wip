// A `str` knows what it borrows. What it borrows may
// change once the `str` is used for the last time; a literal borrows
// nothing; a function may answer a `str` that borrows what its reference
// parameters refer to; and a temporary may be borrowed within its
// statement. An array of `str`s borrows what its elements borrow.

import std::io

fn first(text: str, n: i64): str = text[0..n]

fn view(s: &String): str = s.toStr()

fn trimmed(s: &String): str = {
    val t = s.toStr()
    t.trim()
}

fn pick(a: str, b: str, left: bool): str = if left { a } else { b }

fn literal(): str = "kept"

fn main() = {
    var owned = String::of("  hello world  ")
    val s = owned.toStr()
    io::println(s)
    owned.push("x")                             // `s` is not used again

    val t = owned.toStr().trim()
    io::println(first(t, 5))
    io::println(view(&owned))
    io::println(trimmed(&owned))
    io::println(pick("a", t, false))
    io::println(literal())
    io::println(String::of("temp").toStr())     // used within its statement

    var u = owned.toStr()
    owned.clear()
    u = "fresh"                                 // a new value before any use
    io::println(u)

    val words = ["one", owned.toStr()]          // an array borrows what its elements do
    for w in words {
        io::println(w)
    }

    val kept = "static"
    owned = String()
    io::println(kept)
}
