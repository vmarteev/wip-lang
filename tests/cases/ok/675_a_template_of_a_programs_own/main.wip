// A template of a program's own: a query that keeps its literal's text and
// binds each hole's value as a parameter, never written into the text, so
// no value is read as SQL. Its `pushValue` takes only what it binds, and a
// hole of a query is joined with its parameters.
//
// Expected output:
// select * from users where name = ? and age > ? -- ["O'Brien", "30"]
// select * from users where (name = ?) or (name = ?) -- ["a", "b"]

import std::io

struct Query {
	text: String = String()
	bound: Vec<String> = Vec()
}

extend Query: Template {
	static fn withCapacity(capacity: i64): Query = Query(text: .withCapacity(capacity))

	var fn pushLiteral(text: str) = self.text.push(text)

	var fn pushBuilt(built: &Query, implicit at: Location) = {
		self.text.push(built.text.toStr())
		for value in built.bound do
			self.bound.push(value.clone())
	}
}

extend Query {
	/// A parameter: a `?` in the text, and the value beside it.
	pub var fn pushValue<T: Text>(value: &T) = {
		self.text.push("?")
		self.bound.push("\(value)")
	}
}

extend Query: Text {
	fn appendTo(out: &var String) = {
		out.push(self.text.toStr())
		out.push(" -- [")
		for (i, value) in self.bound.indexed() {
			if i > 0 then
				out.push(", ")

			out.push("\"\(value)\"")
		}
		out.push("]")
	}
}

fn named(name: str): Query = "name = \(name)"

fn main() = {
	val name = "O'Brien"
	val query: Query = "select * from users where name = \(name) and age > \(30)"
	io::println("\(query)")
	val either: Query = "select * from users where (\(named("a"))) or (\(named("b")))"
	io::println("\(either)")
}
