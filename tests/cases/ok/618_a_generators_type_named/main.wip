// A function that yields may name the generator it answers, `as Name`
// after its result, and the name is a type: kept in a view struct's
// field and drawn from there, written as a parameter's type, and generic,
// its type parameters the function's in order. It is the generator the
// function answers unnamed, an `Iterator` with every adapter. Another
// module's is imported by its name, and its `next` called where it is.
//
// Expected output:
// a bb ccc
// 4
// 12
// 3
// one two

import std::io
import words
import words::{Words}

fn pieces(text: str, separator: str): Iterator<str> as Pieces = {
	var at = 0
	while true {
		val rest = text[at..text.len()]
		val .Some(offset) = rest.indexOf(separator) else {
			yield rest
			return
		}
		at += offset + separator.len()
		yield rest[0..offset]
	}
}

fn doubled<I: Iterator<i64>>(inner: I): Iterator<i64> as Doubled = {
	var walking = inner
	for x in walking {
		yield x * 2
	}
}

view struct Fields {
	parts: Pieces
	asked: i64
}

extend Fields {
	var fn nextField(): Option<str> = {
		self.asked += 1
		return self.parts.next()
	}
}

fn total(walk: Doubled<Range<i64>>): i64 = {
	var sum = 0
	var walking = walk
	for x in walking {
		sum += x
	}
	return sum
}

fn main() = {
	var fields = Fields(parts: pieces("a,bb,ccc", ","), asked: 0)
	var seen: Vec<str> = Vec()
	while fields.nextField() is .Some(field) {
		seen.push(field)
	}
	io::println(seen.join(" "))
	io::printInt(fields.asked)
	io::printInt(total(doubled(0..4)))
	io::printInt(pieces("x-y-z", "-").map((p) => p.len()).sum())
	var said: Words = words::words(" one  two ")
	val first = said.next().unwrap()
	val second = said.next().unwrap()
	io::println("\(first) \(second)")
}
