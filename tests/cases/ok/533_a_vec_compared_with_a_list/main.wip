// A `Vec` compared with a list, an array or a slice compares their
// elements, on either side, and builds no vector to compare with; a
// `Vec<String>` compares with a list of text, each `String` with the text
// beside it, and with a list of `String`s, and so does a buffer.
//
// Expected output:
// true true true false
// true true true false
// true
// true false

import std::io

fn main() = {
    val order: Vec<i64> = [3, 2, 1]
    val array = [3, 2, 1]
    val slice: &[i64] = &array
    io::println("\(order == [3, 2, 1]) \([3, 2, 1] == order) \(order == slice) \(order != array)")
    val names: Vec<String> = ["x", "y"]
    io::println("\(names == ["x", "y"]) \(["x", "y"] == names) \(names != ["x"]) \(names == ["x", "z"])")
    io::println("\(names == [String::of("x"), String::of("y")])")
    val boxed: own<[i64]> = [1, 2]
    io::println("\(boxed == [1, 2]) \(boxed == [1])")
}
