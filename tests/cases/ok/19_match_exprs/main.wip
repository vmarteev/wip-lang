// `match` as an expression with expression arms. Arms on separate lines need no
// separator; arms on one line are separated by `,`.

import std::io

enum Shape {
    Circle(radius: f64)
    Rect(w: f64, h: f64)
    Point
}

fn area(s: &Shape): f64 = {
    return match s {
        .Circle(radius: r) => 3.14159 * r * r
        .Rect(w, h) => w * h
        .Point => 0.0
    }
}

fn corners(s: &Shape): f64 = match s { Shape::Rect(w, h) => 4.0, _ => 0.0 }

fn main(): i64 = {
    io::printFloat(corners(Shape::Point))
    io::printFloat(area(Shape::Circle(1.0)))
    io::printFloat(area(Shape::Rect(w: 2.0, h: 3.0)))
    io::printFloat(area(Shape::Point))
    0
}
