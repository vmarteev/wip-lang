// `<` on a type a program declares. `@derive(Ord)` says the type is
// ordered, and the compiler writes the comparison: field by field in the
// order they are written, and for an enum by the order the variants are
// written and then that variant's fields.
//
// It answers with an `Ordering` — `Less`, `Same` or `More` — rather than a
// negative, zero or positive number, because Wip has enums and `match` and
// a sign convention is a comment that can be got wrong. `a < b` asks for
// it, and so do `<=`, `>` and `>=`.
//
// A type that asks for `@derive(Ord)` asks for `@derive(Eq)` too: two values that compare
// `Same` and are not equal would make every algorithm that uses both wrong.
//
// Expected output: the comparisons, the order of two ranks, and three
// versions put in order by the prelude's `sort`, which is written once for
// every ordered type.

import std::io

@derive(Eq, Ord)
struct Version { major: i64, minor: i64 }

@derive(Eq, Ord)
enum Rank { Low, Middle(step: i64), High }

fn name(order: Ordering): str = match order {
    .Less => "less"
    .Same => "same"
    .More => "more"
}

fn main() = {
    val old = Version(major: 1, minor: 2)
    val newer = Version(major: 1, minor: 9)
    val newest = Version(major: 2, minor: 0)

    // The first field settles it; where it does not, the next one does.
    io::println("versions \(old < newer), \(newest > newer), \(old <= old), \(old >= newest)")
    io::println("compare \(name(old.compare(&newer))), \(name(old.compare(&old)))")

    // An enum: the variant first, in the order the variants are written.
    io::println("ranks \(Rank::Low < Rank::High), \(Rank::Middle(step: 9) < Rank::High)")
    io::println("steps \(Rank::Middle(step: 1) < Rank::Middle(step: 2))")

    var versions = [newest, old, newer]
    versions.sort()
    io::println("sorted \(versions[0].minor), \(versions[1].minor), \(versions[2].minor)")
}
