// Plain function values. A named function is a value of a
// function type, `(a: A, b: B) => R`: it can be passed, returned, stored in a
// variable or a field, and called. A generic function takes its type
// arguments from the function type expected, or from those written after its
// name. A C function is a value too.
//
// Expected output: 42, 25, 36, 49, 9, 2, 8, 11, 1, 99.

import std::io

struct Item {
    weight: i64
}

struct Handler {
    onValue: (value: i64) => i64
}

fn double(x: i64): i64 = x * 2

fn square(x: i64): i64 = x * x

fn apply(f: (v: i64) => i64, x: i64): i64 = f(x)

fn pick(big: bool): (x: i64) => i64 = if big { square } else { double }

fn heavier(a: &Item, b: &Item): bool = a.weight > b.weight

fn largest<T: copy>(xs: &[T], less: (a: &T, b: &T) => bool): T = {
    var best = xs[0]
    for x in xs {
        if less(&best, &x) {
            best = x
        }
    }
    best
}

fn lessI64(a: &i64, b: &i64): bool = a < b

fn genericLess<T: copy>(a: &T, b: &T): bool = false

fn forEach(items: &[Item], visit: (item: &Item) => void) = {
    for item in items {
        visit(&item)
    }
}

fn show(item: &Item) = io::printInt(item.weight)

fn makeItem(weight: i64): Item = Item(weight: weight)

fn main(): i64 = {
    io::printInt(apply(double, 21))
    io::printInt(pick(true)(5))
    val handler = Handler(onValue: square)
    io::printInt(handler.onValue(6))
    var f = double
    f = square
    io::printInt(f(7))
    io::printInt(largest([3, 9, 4], lessI64))
    val items = [Item(weight: 2), Item(weight: 8)]
    forEach(&items, show)
    val maker: (weight: i64) => Item = makeItem
    io::printInt(maker(11).weight)
    val g: (a: &i64, b: &i64) => bool = genericLess
    io::printInt(largest([1, 2], g))
    val print = io::printInt
    print(99)
    0
}
