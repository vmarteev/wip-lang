// `Vec::of(own [ … ])` takes the values the list was built with, of any
// type; plain data is its own clone, so `clone()`, `toVec()`,
// `Vec::filled` and `T: Clone` take it without `@derive(Clone)`.

import std::io

struct Point {
    x: i64
    y: i64
}

enum Colour {
    Red
    Green
}

fn copyOf<T: Clone>(value: &T): T = value.clone()

fn both<T: copy>(value: T): (T, T) = (value.clone(), value)

fn main() = {
    val names = Vec::of(own [String::of("a"), String::of("b")])
    val numbers = Vec::of(own [1, 2, 3])
    io::println("\(names.len()) \(names[1]) \(numbers[2])")

    val p = Point(x: 1, y: 2)
    val q = p.clone()
    val r = copyOf(&p)
    val seen: &Point = &p
    val s = seen.clone()
    io::println("\(q.x + r.y + s.x)")

    val points = [p, Point(x: 3, y: 4)].toVec()
    val pairs = [(1, Colour::Green)].toVec()
    val (first, second) = both(Colour::Red)
    io::println("\(points[1].y) \(pairs.len()) \(first is .Red) \(second is .Red)")

    val rows = Vec::filled(3, String::of("row"))
    val origins = Vec::filled(2, Point(x: 0, y: 0))
    val none: Vec<String> = Vec::filled(0, String::of("unused"))
    io::println("\(rows.len()) \(rows[2]) \(origins[1].x) \(none.len())")
}
