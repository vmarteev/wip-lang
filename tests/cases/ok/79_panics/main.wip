// Panics: a message, where it was written, and a stop. The
// program runs what it can, then ends at the first panic.
//
// Expected output: 3 (a function that panics only on the other path), 1 (a
// value declared `never` is never reached), 8 (`getOrInsert`, which panics
// on a path that cannot happen), and 4 (`unwrap` of a value that is there),
// then the panic itself on standard error, and status 101.

import std::io

fn checkAge(age: i64): i64 = if age < 0 {
    panic("an age cannot be negative")
} else {
    age
}

fn giveUp(): never = panic("gave up")

fn main() = {
    io::printInt(checkAge(3))
    io::printInt(if true { 1 } else { giveUp() })

    var slot: Option<i64> = .None
    slot.getOrInsert(7) += 1
    io::printInt(slot.unwrap())

    val some: Option<i64> = .Some(4)
    io::printInt(some.unwrap())

    io::printInt(checkAge(-1))
    io::printInt(0)
}
