// A projection may lend a constant table, which lives as long as the
// program: a call that lends only tables holds nothing.

import std::io

val PRELUDE: [u32; 4] = [1, 2, 3, 4]
val DEAD: [u32; 2] = [9, 8]
val UNKNOWN: [i64; 1] = [-1]

enum Recording {
	Prelude
	Dead
}

fn registers(recording: Recording): &[u32] = match recording {
	.Prelude => lend PRELUDE
	.Dead => lend DEAD
}

// What it forwards to lends tables alone, so it does too.
fn deadOnes(): &[u32] = lend registers(.Dead)

fn total(values: &[u32]): u32 = {
	var sum: u32 = 0
	for value in values {
		sum += value
	}
	return sum
}

struct Labels {
	values: Vec<i64>
}

extend Labels {
	// A parameter's place on one path, a table on the other.
	fn at(i: i64): &i64 = if i < self.values.len() {
		lend self.values[i]
	} else {
		lend UNKNOWN[0]
	}
}

struct Mode {
	dead: bool = false
}

fn playing(mode: &Mode): &[u32] = if mode.dead { lend DEAD } else { lend PRELUDE }

fn switch(mode: &var Mode, heard: &[u32]) = {
	mode.dead = heard[0] < 5
}

fn main() = {
	io::println("\(total(&registers(.Prelude))) \(total(&registers(.Dead))) \(registers(.Prelude)[2])")
	io::println("\(total(&deadOnes()))")
	val labels = Labels(values: Vec::of(own [5, 6]))
	io::println("\(labels.at(1)) \(labels.at(7))")
	// Nothing of `mode` is held, so it may be lent as `&var` beside it.
	var mode = Mode()
	switch(&var mode, &playing(&mode))
	io::println("\(mode.dead)")
}
