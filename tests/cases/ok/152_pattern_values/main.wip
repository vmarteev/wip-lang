// A pattern may be a value the scrutinee must equal:
// a number, a `bool`, or text, compared by its bytes. Until now a `match`
// could only ask which variant a value was, so every table of numbers was
// an `if`/`else` chain.
//
// A `match` on something that is not an enum needs a `_` or a name, since
// the values a program lists are never all of them — except for a `bool`,
// where `true` and `false` are.
//
// Expected output: none two many (numbers), 1 2 0 (text), yes no (a
// `bool`, with no `_`), 7 (a byte, matched as a number), -1 (a negative
// number), and 42 (a value the arm binds).

import std::io

fn describe(n: i64): str = match n {
    0 => "none"
    1 => "one"
    2 => "two"
    _ => "many"
}

fn word(text: str): i64 = match text {
    "one" => 1
    "two" => 2
    _ => 0
}

fn yes(b: bool): str = match b {
    true => "yes"
    false => "no"
}

fn digit(byte: u8): i64 = match byte {
    55 => 7
    _ => 0
}

fn sign(n: i64): i64 = match n {
    -1 => -1
    0 => 0
    _ => 1
}

fn named(n: i64): i64 = match n {
    0 => 0
    other => other
}

fn main() = {
    io::println("\(describe(0)) \(describe(2)) \(describe(9))")
    io::println("\(word("one")) \(word("two")) \(word("ten"))")
    io::println("\(yes(true)) \(yes(false))")
    io::printInt(digit(55))
    io::printInt(sign(-1))
    io::printInt(named(42))
}
