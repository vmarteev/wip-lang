// Standard output and standard error as an `io::Write`, which a function
// that writes to any destination takes, and `io::copy` copies into: what
// is written goes through the buffer `print` writes through, so the two
// arrive in one order, and standard error empties it first, as `eprint`
// does. Bytes that are not text are written as they are.
//
// Expected output: on standard output, `one two three` on a line, three
// lines copied from a reader, and the bytes 0xFF and 0x0A; on standard
// error, `a warning`.

import std::io

/// A report written wherever it is told.
fn report(to: &var dyn io::Write, words: str): Result<void, io::IoError> = {
	to.writeAll(&words)?
	return .Ok()
}

/// Bytes read from a list of them, a piece at a time.
struct Pieces {
	left: Vec<u8>
}

extend Pieces: io::Read {
	var fn read(into: &var [u8]): Result<i64, io::IoError> = {
		val count = self.left.len().min(into.len()).min(4)
		for at in 0..count {
			into[at] = self.left[at]
		}
		self.left = self.left.splitOff(count)
		return .Ok(count)
	}
}

fn main(): Result<void, io::IoError> = {
	var out = io::stdout()
	io::print("one")
	report(&var out, " two")?
	io::println(" three")

	var errors = io::stderr()
	report(&var errors, "a warning\n")?

	val lines = "first\nsecond\nthird\n"
	var left: Vec<u8> = Vec()
	left.pushAll(&lines)
	var pieces = Pieces(left: left)
	val copied = io::copy(&var pieces, &var out)?
	assert(copied == 19)

	val notText = [0xFF as u8, 0x0A]
	out.writeAll(&notText)?
	return .Ok()
}
