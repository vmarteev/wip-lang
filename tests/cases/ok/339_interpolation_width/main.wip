// A piece of an interpolation padded to a width: text
// left and numbers right unless said, a fill of any character, zeros after
// a sign, the middle, a width worked out as the program runs, a type of
// the program's own, and a text wider than its width left whole.

import std::io

struct Point {
    x: i64
    y: i64
}

extend Point: Text {
    fn appendTo(out: &var String) = out.push("(\(self.x), \(self.y))")
}

fn main() = {
    val name = String::of("OP_ADD")
    val columns = 8
    io::println("[\(name, width: 10)] [\(42, width: 6)] [\(3.5, width: 6)]")
    io::println("[\(-5, width: 4, fill: '0')] [\(7, width: 3, fill: '0')] [\(-5, width: 4)]")
    io::println("[\("mid", width: 8, align: .Center)] [\("é", width: 3, fill: '·')] [\(3.5, width: 6, align: .Left)]")
    io::println("[\("long text", width: 3)] [\(Point(x: 1, y: 2), width: columns, fill: '*', align: .Right)] [\(true, width: 6)]")
}
