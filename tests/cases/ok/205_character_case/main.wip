// A character's case, as Unicode has it: the simple
// mappings, one character to one; the properties; and the fold that
// compares without case.
//
// Expected output: "привет, world", then "ΣΟΦΟΣ", then "true",
// then "false", then "k k k".

import std::io

fn main() = {
    io::println("ПРИВЕТ, World".toLowercase())
    io::println("σοφος".toUppercase())
    io::println("\("ΣΟΦΟΣ".folded() == "σοφος".folded())")
    io::println("\("Straße".folded() == "STRASSE".folded())")
    io::println("\('K'.folded()) \('k'.folded()) \('\u{212A}'.folded())")
    assert('ß'.toUppercase() == 'ß', "its capital is two characters")
    assert('İ'.toLowercase() == 'İ', "its small letter is two characters")
    assert('Ⓐ'.isUppercase() && 'ª'.isLowercase())
    assert(!'1'.isUppercase() && !'1'.isLowercase())
    assert('Σ'.toLowercase() == 'σ' && 'ς'.toUppercase() == 'Σ')
}
