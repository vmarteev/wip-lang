// A moved `var` can be reassigned and used again.

import std::io

struct Box {
    value: i64
}

fn consume(b: own<Box>): i64 = {
    b.value
}

fn main(): i64 = {
    var b = own Box(value: 10)
    io::printInt(consume(move b)) // 10
    b = own Box(value: 20)
    io::printInt(consume(move b)) // 20
    0
}
