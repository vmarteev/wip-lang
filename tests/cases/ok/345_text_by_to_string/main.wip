// `Text` by `toString` or by `appendTo`: an enum that
// writes only `toString`, as a match of literals and interpolations, is
// interpolated, with a width, in a list, and through `&dyn Text`; a struct
// that writes only `appendTo` is asked for its `toString()`; numbers, a
// `str` and a `String` are asked for theirs; and an interface of the
// program's own says with `@oneOf` that one of two defaults is written.
//
// Expected output:
// Invalid option: -x | Invalid level!  |
// Invalid option: -x
// (1, 2) 5 abc copy
// [Invalid level!, Invalid option: -y]
// 4 4

import std::io

enum Failure {
    InvalidOption(option: String)
    InvalidLevel
}

extend Failure: Text {
    fn toString(): String = match self {
        .InvalidOption(option) => "Invalid option: \(option)"
        .InvalidLevel => "Invalid level!"
    }
}

struct Point {
    x: i64
    y: i64
}

extend Point: Text {
    fn appendTo(out: &var String) = out.push("(\(self.x), \(self.y))")
}

fn shown(value: &dyn Text): String = value.toString()

/// Its area, or its side: whichever a shape knows, the other from it.
@oneOf(area, side)
interface Square {
    fn area(): i64 = self.side() * self.side()
    fn side(): i64 = {
        var side = 0
        while side * side < self.area() {
            side += 1
        }
        return side
    }
}

struct BySide {
    length: i64
}

extend BySide: Square {
    fn side(): i64 = self.length
}

struct ByArea {
    size: i64
}

extend ByArea: Square {
    fn area(): i64 = self.size
}

fn main() = {
    val failure = Failure::InvalidOption(option: String::of("-x"))
    io::println("\(failure) | \(Failure::InvalidLevel, width: 16)|")
    io::println(shown(&failure))
    val copied = String::of("copy")
    io::println("\(Point(x: 1, y: 2).toString()) \(5.toString()) \("abc".toString()) \(copied.toString())")
    val all = Vec::of(own [Failure::InvalidLevel, Failure::InvalidOption(option: String::of("-y"))])
    io::println(all.toString())
    io::println("\(BySide(length: 2).area()) \(ByArea(size: 16).side())")
}
