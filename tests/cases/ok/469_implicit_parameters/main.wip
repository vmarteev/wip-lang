// An implicit parameter is filled, where a call leaves it out, from the
// caller's implicit of the same name: one of its own implicit parameters,
// or an `implicit val` or `var` in scope, lent as the parameter takes it.
// It passes through calls that only pass it on, may be given by name, is
// captured by a lambda as anything around it is, reaches a worker's
// closure where it is shared, and is filled through an interface, a
// constraint and a `&dyn` as the interface declares it.
//
// Expected output:
// [run] start
// [run] drew 0 then 3
// [run] drew 0 then 3
// 3 3 true
// [run] 3 6 9
// [run] four workers, 20 marks
// [run] 1
// [run] 2
// [run] 3
// [run] counted 3
// [run] shape 12
// [run] dyn 12

import std::future
import std::io
import std::sync::{Atomic}

struct Log {
	prefix: String
}

extend Log {
	fn say(text: str) = io::println("\(self.prefix) \(text)")
}

struct Dice {
	next: i64
}

extend Dice {
	var fn roll(): i64 = {
		self.next = (self.next * 7 + 3) % 10
		return self.next
	}
}

/// Three calls deep: `leaf` draws, `pair` only passes the implicits on.
fn leaf(implicit dice: &var Dice): i64 = dice.roll()

fn pair(implicit dice: &var Dice, implicit log: &Log): i64 = {
	val first = leaf()
	val second = leaf()
	log.say("drew \(first) then \(second)")
	return first + second
}

fn twice(implicit dice: &var Dice, implicit log: &Log): i64 = pair()

/// A plain value, copied.
fn scaled(x: i64, implicit factor: i64): i64 = x * factor

/// How long the prefix is, read by every worker at once.
fn width(implicit log: &Log): i64 = log.prefix.len()

fn mark(x: i64, implicit log: &Log): i64 = {
	log.say("\(x)")
	return x
}

interface Shape {
	fn area(implicit log: &Log): i64
}

struct Square {
	side: i64
}

extend Square: Shape {
	fn area(implicit log: &Log): i64 = self.side * self.side - scaled(4, factor: 1)
}

fn measured<S: Shape>(shape: &S, implicit log: &Log): i64 = shape.area()

fn main() = {
	implicit val log = Log(prefix: String::of("[run]"))
	log.say("start")
	implicit var dice = Dice(next: 1)
	val drawn = twice()
	var other = Dice(next: 1)
	val again = twice(dice: &var other)
	io::println("\(drawn) \(again) \(drawn == again)")

	// A lambda captures them, as it does anything around it.
	implicit val factor = 3
	val numbers = [1, 2, 3].map((x) => scaled(x))
	io::println("\(log.prefix) \(numbers[0]) \(numbers[1]) \(numbers[2])")

	// A shared implicit reaches every worker.
	val marks = Atomic::of(0)
	var workers = [1, 2, 3, 4]
	future::each(&var workers, (worker) => {
		marks.add(width())
		worker = 0
	})
	log.say("four workers, \(marks.load()) marks")
	val counted = [1, 2, 3].map((x) => mark(x) * 0 + 1)
	log.say("counted \(counted.len())")

	val square = Square(side: 4)
	log.say("shape \(measured(&square))")
	val shape: &dyn Shape = &square
	log.say("dyn \(shape.area())")
}
