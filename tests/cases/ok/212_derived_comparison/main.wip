// `@derive(Eq)` and `@derive(Ord)` written as code the checker checks:
// a field compares by whatever implementation its type
// has, generic or not — a `Vec<i64>`, a `Vec<String>`, an array, a
// parameter's type — and two values of an enum by their variants' order
// first, then by their fields.

import std::io

@derive(Eq)
enum Carrier {
    Empty
    Holding(items: Vec<i64>)
}

@derive(Eq, Ord)
struct Entry {
    name: String
    tags: Vec<String>
    cells: [u8; 2]
    hidden: bool
    weight: f64
}

@derive(Eq, Ord)
enum Shape {
    Circle(r: f64, labels: Vec<String>)
    Dot
    Square(side: i64)
}

// `T` need not be `Eq` for a `Pair<T>` to exist: the pair compares where
// `T` does.
@derive(Eq, Ord)
struct Pair<T> {
    first: T
    second: Vec<T>
}

struct Opaque {
    n: i64
}

@derive(Eq)
struct Handle {
    at: ptr<u8>
}

fn entry(name: str, tags: &[str]): Entry = {
    var list: Vec<String> = Vec()
    for tag in tags {
        list.push(String::of(tag))
    }
    return Entry(name: String::of(name), tags: move list, cells: [1, 2], hidden: false, weight: 0.5)
}

fn main() = {
    var held: Vec<i64> = Vec()
    held.push(1)
    val one = Carrier::Holding(items: move held)
    io::println("carrier: \(one == Carrier::Empty) \(Carrier::Empty == Carrier::Empty)")

    val a = entry("a", ["x", "y"])
    val b = entry("a", ["x", "z"])
    var c = entry("a", ["x", "y"])
    c.cells[1] = 3
    io::println("entries: \(a == entry("a", ["x", "y"])) \(a < b) \(a < c) \(b > c) \(a == c)")

    var sorted: Vec<Shape> = Vec()
    sorted.push(.Square(side: 1))
    sorted.push(.Dot)
    sorted.push(.Circle(r: 2.0, labels: Vec()))
    sorted.push(.Circle(r: 1.0, labels: Vec()))
    sorted.sort()
    for shape in sorted.items() {
        match shape {
            .Circle(r, ..) => io::println("circle \(r)")
            .Dot => io::println("dot")
            .Square(side) => io::println("square \(side)")
        }
    }

    val p = Pair(first: 1, second: Vec::of(own [2]))
    val q = Pair(first: 1, second: Vec::of(own [3]))
    io::println("pairs: \(p == p) \(p < q)")
    val kept = Pair(first: Opaque(n: 1), second: Vec())
    io::println("a pair of what does not compare: \(kept.first.n)")

    io::println("handles: \(Handle(at: null) == Handle(at: null))")
}
