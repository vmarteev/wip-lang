// A `char` is one Unicode scalar value, written `'x'`. It
// compares, matches, hashes and writes as itself, and converts to a number
// with `as`; a number becomes one with `char::fromInt`, which says whether
// it is one. A `str` is walked by character with `chars()`, which reads
// what is not UTF-8 as U+FFFD, a byte at a time; `split` and `lines` hand
// out pieces of it.

import std::io
import std::collections::{Map}

fn kind(c: char): str = match c {
    'a' | 'e' | 'i' | 'o' | 'u' => "vowel",
    ' ' => "space",
    _ if c.isDigit() => "digit",
    _ => "other",
}

fn main() = {
    val e = '\u{e9}'
    io::println("\(e) is \(e as u32) and takes \(e.utf8Len()) bytes")
    io::println(kind('a'))
    io::println(kind('7'))
    io::println(kind(' '))
    io::println(kind('x'))
    io::println(if 'a' < 'b' && 'é' != 'e' { "ordered" } else { "not ordered" })
    val b: u8 = 65
    io::println("\(b as char)")
    io::println("\(char::fromInt(0x1F600))")
    io::println("\(char::fromInt(0xD800))")

    // Walking by character.
    val text = "héllo, 世界"
    var count = 0
    var shouted = String()
    for c in text.chars() {
        count += 1
        shouted.pushChar(c.toAsciiUpper())
    }
    io::println("\(count) characters in \(text.len()) bytes: \(shouted)")

    // Bytes that are not UTF-8 read as U+FFFD, one byte at a time.
    var broken = String::of("a")
    broken.pushByte(0xFF)
    broken.pushByte(0xE4)
    broken.push("b")
    for c in broken.chars() {
        io::println("\(c as u32)")
    }
    io::println("\(broken.isValidUtf8()) \(text.isValidUtf8())")

    // Counting, by character.
    var counts: Map<char, i64> = Map()
    for c in "hello".chars() {
        val seen = if counts.contains(&c) { counts.at(&c) } else { 0 }
        counts.put(c, seen + 1)
    }
    io::println("l appears \(counts.at('l')) times")

    // Pieces and lines.
    for piece in "a,b,,c".split(",") {
        io::println("[\(piece)]")
    }
    for line in "one\ntwo\r\nthree\n".lines() {
        io::println("<\(line)>")
    }
    var fields: Vec<str> = Vec()
    for field in "name=wip".split("=") {
        fields.push(field)
    }
    io::println("\(fields.len()) fields, the second \(fields[1])")
}
