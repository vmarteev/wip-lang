// Strings. A `str` is a pointer and a length, and `s.len()` counts its bytes of
// UTF-8. C takes strings as `cstring`, a pointer to NUL-terminated bytes, and a
// string literal can be either. Arrays have `.len()` too. The last call checks
// that arguments narrower than 32 bits, and `f32`, reach C intact.

import std::io

extern "C" {
    fn strlen(s: cstring): u64
    fn wip_sum_args(a: u8, b: i16, c: u32, d: f32): i64
}

fn length(s: str): i64 = s.len()

fn main(): i64 = {
    val greeting = "hello, world"
    io::printInt(length(greeting))                        // 12
    io::printInt("naïve".len())                             // 6: bytes, not characters
    io::printInt("".len())                                  // 0
    io::println("a literal passed to C")
    io::printInt(strlen("four") as i64)                   // 4
    val xs = [1, 2, 3]
    io::printInt(xs.len())                                  // 3
    io::printInt(wip_sum_args(200, -300, 4000000000, 0.5)) // 3999999902
    0
}
