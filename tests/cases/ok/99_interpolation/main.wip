// `"read \(rows) rows"`: a value written inside a literal.
// The parser rewrites the literal into the block a program would write
// itself — a `String`, a `push` for each piece of text, and an `appendTo`
// for each value — so what a program gets is a `String`, and a literal with
// no `\(` in it is still a `str` that allocates nothing.
//
// A value is appended through `Text`, an interface of the prelude, which a
// program may implement for its own types, as `Point` does here.
//
// Expected output: read 12 rows from table; 1.5 true and a `String` inside
// another; point (1, 2); nested brackets; a literal backslash, which `\\(`
// is; then the numbers, each written by its own `Text`; then true, since
// the C string, walked to its NUL; and 12, since a plain literal is still
// a `str`.

import std::io

struct Point {
    x: i64,
    y: i64
}

extend Point: Text {
    fn appendTo(out: &var String) = {
        out.push("(")
        out.pushInt(self.x)
        out.push(", ")
        out.pushInt(self.y)
        out.push(")")
    }
}

fn main() = {
    val rows = 12
    val name = "table"
    io::println("read \(rows) rows from \(name)")

    val ratio = 1.5
    val ok = true
    var held = String()
    held.push("held")
    io::println("\(ratio) \(ok) \(held)")

    io::println("point \(Point(x: 1, y: 2))")
    io::println("\("[\(name)]")")
    io::println("a \\(not) b")

    // Every number writes itself, whatever its width, and so does C's
    // kind of string, which is walked to its NUL.
    val small: u8 = 7
    val wide: i32 = -9
    val huge: u64 = 18446744073709551615
    val tiny: f32 = 0.5
    val size: usize = 42
    io::println("\(small) \(wide) \(huge) \(tiny) \(size)")
    // C's kind of string is walked to its NUL to be written.
    val label: cstring = "bytes that end with a NUL"
    io::println("\(label)")

    val plain = "no interpolation here"
    io::printInt(plain.len() - 9)
}
