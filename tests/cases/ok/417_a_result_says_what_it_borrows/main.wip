// `from` after a result type says what the result borrows, and nothing
// else: a view's helper that answers out of the tables it borrows says
// `from self.ast`, and its answer is kept while the view's own fields
// change, by its caller and by another of its methods; a function of two
// texts that answers from one names that one, and its answer is kept while
// the other changes; one that may answer either names both.
//
// Expected output: `borrowed what it says`.

import std::io

struct Ast {
	names: Vec<String>
}

view struct Lowerer {
	ast: &Ast
	errors: Vec<String>
}

extend Lowerer {
	fn text(i: i64): str from self.ast = self.ast.names[i].toStr()

	var fn note(i: i64) = {
		val text = self.text(i)
		self.errors.push("unknown")
		assert(text.len() > 0)
	}
}

fn longer(a: str, b: str): str from a, b = if a.len() >= b.len() then a else b

fn label(name: str, fallback: str): str from name = if name.isEmpty() then "?" else name

fn main() = {
	val ast = Ast(names: Vec::of(own ["ab", "c"]))
	var lowerer = Lowerer(ast: &ast, errors: Vec())
	val text = lowerer.text(0)
	lowerer.errors.push("kept across")
	assert(text == "ab")
	lowerer.note(1)
	var fallback = String::of("fallback")
	val named = label("name", fallback.toStr())
	fallback.push("!")
	assert(named == "name" && longer("ab", "c") == "ab")
	io::println("borrowed what it says")
}
