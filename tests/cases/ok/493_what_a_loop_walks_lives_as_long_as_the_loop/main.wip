// What a `for` loop's head makes lives until the loop ends, whatever it
// walks: an iterator over a constant table, which is read where it is
// kept; an iterator over a vector a call answered; one over what a
// projection of that vector lends, numbered; and the same where the loop
// is left by `break` or `return`, nested in another, and in a generator,
// which holds the vector across each `yield`, run to its end or dropped
// part way. The case runs with the leak check on: each vector is dropped
// once its loop ends.
//
// Expected output: what each loop walked.

import std::io

val PRIMES: [i64; 4] = [2, 3, 5, 7]

fn words(): Vec<String> = Vec::of(own [String::of("one"), String::of("two"), String::of("three")])

fn firstLong(): Option<String> = {
    for word in words().forwards() {
        if word.len() > 3 then return .Some(word.clone())
    }
    return .None
}

fn lengths(): Iterator<i64> = {
    for word in words().items().forwards() {
        yield word.len()
    }
}

fn main() = {
    var sum = 0
    for (i, p) in PRIMES.forwards().enumerate() {
        sum += i * p
    }
    var table = PRIMES.forwards()
    io::println("table: \(sum) \(table.next())")
    for word in words().forwards() {
        io::print("\(word) ")
    }
    for (i, word) in words().items().forwards().enumerate() {
        io::print("\(i):\(word) ")
    }
    io::println("")
    var before = 0
    for word in words().forwards() {
        if word == "two" then break
        before += 1
    }
    var nested = 0
    for i in 0..2 {
        for word in words().items().forwards() {
            nested += i + word.len()
        }
    }
    var lengthSum = 0
    for n in lengths() {
        lengthSum += n
    }
    var started = lengths()
    val first = started.next()
    io::println("left: \(before) \(firstLong()) \(nested) \(lengthSum) \(first)")
}
