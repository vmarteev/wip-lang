// Interfaces: a set of methods a type implements, used as a
// constraint on a type parameter. A method may have a default body, and
// `Self` is the implementing type.
//
// Expected output: 6 and 12 (methods of two implementations), 106 and 1 (a
// default body, and an implementation that replaces it), 112 and 13 (a
// generic function that calls both through its constraint), 24 (a method
// that returns `Self`), 101 (a `static fn` of an interface, called through a
// constraint), and 30 (an interface a generic type implements), with every
// allocation freed.

import std::io

interface Shape {
    fn area(): i64
    fn scaled(by: i64): Self
    static fn unit(): Self

    fn label(): i64 = self.area() + 100
}

struct Rect {
    width: i64
    height: i64
}

struct Circle {
    radius: i64
}

extend Rect: Shape {
    fn area(): i64 = self.width * self.height
    fn scaled(by: i64): Rect = Rect(
        width: self.width * by,
        height: self.height * by,
    )
    static fn unit(): Rect = Rect(width: 1, height: 1)
}

extend Circle: Shape {
    fn area(): i64 = self.radius * self.radius * 3
    fn scaled(by: i64): Circle = Circle(radius: self.radius * by)
    static fn unit(): Circle = Circle(radius: 1)
    fn label(): i64 = 1
}

// A type parameter constrained by an interface gives its methods.
fn describe<T: Shape>(shape: &T): i64 = shape.area() + shape.label()

fn twiceArea<T: Shape>(shape: &T): i64 = shape.scaled(2).area()

fn unitLabel<T: Shape>(): i64 = T::unit().label()

// An interface a generic type implements.
interface Counted {
    fn count(): i64
}

struct Boxed<T> {
    value: T
    size: i64
}

extend Boxed<V>: Counted {
    fn count(): i64 = self.size
}

fn total<T: Counted>(a: &T, b: &T): i64 = a.count() + b.count()

fn main() = {
    val r = Rect(width: 2, height: 3)
    val c = Circle(radius: 2)
    io::printInt(r.area())
    io::printInt(c.area())
    io::printInt(r.label())
    io::printInt(c.label())
    io::printInt(describe(&r))
    io::printInt(describe(&c))
    io::printInt(twiceArea(&r))
    io::printInt(unitLabel<Rect>())

    val boxed = Boxed(value: r, size: 10)
    val other = Boxed(value: Rect(width: 1, height: 1), size: 20)
    io::printInt(total(&boxed, &other))
}
