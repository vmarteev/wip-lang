// `own<T>`: a uniquely owned heap allocation. `own expr` allocates; the value is
// freed when its owner goes out of scope, in reverse declaration order.

import std::io

struct Point {
    x: i64
    y: i64
}

fn main(): i64 = {
    val p: own<Point> = own Point(x: 3, y: 4)
    val n = own 42
    io::printInt(p.x + p.y) // 7
    0
} // `n` is freed, then `p`
