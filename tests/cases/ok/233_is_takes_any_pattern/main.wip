// `is` takes any pattern that can fail: a value, a range, alternatives,
// and a struct with a field that tests something, as well as a variant;
// a binding is still made only in a condition.

import std::io

struct Point {
    x: i64
    y: i64
}

val LIMIT: i64 = 5

fn isHex(c: char): bool = c is '0'..='9' | 'a'..='f' | 'A'..='F'

fn main() = {
    val c = 'x'
    io::println("\(c is 'a'..='z') \(c is 'A'..='Z') \(isHex('b')) \(isHex('g'))")
    io::println("\(3 is 1 | 2 | 3) \(-1 is ..0) \("ab" is "ab") \(true is false)")
    val p = Point(x: 0, y: 5)
    io::println("\(p is Point(x: 0, ..)) \(p is Point(x: 1, ..))")
    if p is Point(x: 0, y) && y > 2 {
        io::println("on the axis at \(y)")
    }
    val next: Option<u8> = .Some(b'7')
    if next is .Some(b' ' | b'0'..=b'9') {
        io::println("a space or a digit")
    }
    var n = 0
    while n is 0..LIMIT {
        n += 1
    }
    io::println("\(n)")
}
