// A `pub` field is read by any module and written by the one that
// declares it; `pub var` is the one anyone writes. It is
// what a type needs to promise anything about a field it shows: `v.len()`
// is the prelude's example, and reading it is free while writing it
// would leave the vector saying it holds what it does not.
//
// Expected output: 0 (a count read from outside), 2 (after two steps), 5
// (an exported limit), 7 (the same limit, written from outside), 7 again
// (the count following the limit the caller set), 2 (a field nobody
// outside may name, read through a method), and 3 (a vector's length).

import counter::{Counter}
import std::io

fn main() = {
    var c = Counter::upTo(5)
    io::printInt(c.n)

    c.step()
    c.step()
    io::printInt(c.n)
    io::printInt(c.limit)

    // `limit` says `pub var`, so it is written like any field.
    c.limit = 7
    io::printInt(c.limit)

    var i = 0
    while i < 10 {
        c.step()
        i += 1
    }
    io::printInt(c.n)

    io::printInt(c.stepsTaken() - 10)

    var v = Vec<i64>()
    v.push(1)
    v.push(2)
    v.push(3)
    io::printInt(v.len())
}
