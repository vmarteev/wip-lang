// A string literal where a `String` is expected is a `String`, made from
// its text: a struct's field, a variant's, an argument,
// what a function answers, an element pushed, a variable declared or
// assigned, and each branch of an `if`. Where nothing expects a `String`
// it stays a `str`, and comparing a `String` with one allocates nothing.
// The case runs with the leak check on.
//
// Expected output: each value, one to a line, and then `str` twice.

import std::io

struct Dialog {
    title: String,
}

enum Shown {
    Problem(title: String, text: String),
    Nothing,
}

fn named(name: String): String = move name

fn titled(): String = {
    return " Cannot edit "
}

fn kindOf(text: str): str = "str"

fn main() = {
    val dialog = Dialog(title: " Cannot open ")
    io::println(dialog.title)
    val shown: Shown = .Problem(title: " Stopped ", text: "no room")
    if shown is .Problem(title, text) {
        io::println("\(title)\(text)")
    }
    io::println(named("given"))
    io::println(titled())
    var words: Vec<String> = Vec()
    words.push("pushed")
    io::println(words[0])
    var later: String = "declared"
    io::println(later)
    later = "assigned"
    io::println(later)
    val choice: String = if words.len() > 0 { "then" } else { "else" }
    io::println(choice)
    val plain = "a view"
    io::println(kindOf(plain))
    assert(later == "assigned")
    io::println(kindOf("still"))
}
