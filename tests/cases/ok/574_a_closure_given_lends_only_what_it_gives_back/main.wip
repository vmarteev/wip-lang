// A closure passed to a call lends the call's result only what calling it
// may give back: a test that answers a `bool` gives back nothing it
// captured, so `find` with one that reads a parameter answers a reference
// into its receiver alone, which a function may answer `from self`. One
// whose result may refer to what it captured still lends it.
//
// Expected output:
// pebble 1.2
// none
// glint

import std::io

struct Character {
    name: String
    size: f32
}

struct Cast {
    characters: Vec<Character>
}

extend Cast {
    fn find(name: str): Option<&Character> from self =
        self.characters.find((character) => character.name == name)
}

/// What `name` answers of the first character: what it captured, which
/// the answer borrows.
fn nameOf(name: &(first: &Character) => str, cast: &Cast): str = name(&cast.characters[0])

fn main() = {
    val cast = Cast(characters: [
        Character(name: String::of("pebble"), size: 1.2),
        Character(name: String::of("glint"), size: 0.9),
    ])
    match cast.find("pebble") {
        .Some(found) => io::println("\(found.name) \(found.size)")
        .None => io::println("none")
    }
    if cast.find("bolt") is .None then io::println("none")
    val other = cast.characters[1].name.toStr()
    io::println(nameOf((first) => other, &cast))
}
