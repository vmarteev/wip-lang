// An interface extended under a condition on its types gives every type
// that implements it, with types that meet the condition, the block's
// methods: `extend Source<T: Add + Zero> { var fn total() }`. They are
// called on a concrete type and through a constraint, and a type's own
// method of the name is its own. The prelude's iterators have `sum` and
// `product` where their element adds up and multiplies, and `min` and
// `max` where it is ordered: over characters, lines, a generator's
// numbers, owned strings and references.
//
// Expected output: 6 and 10 through the extension, 99 from a type's own
// method, then a text's width, the longest and shortest line, a product,
// a sum, nothing from an empty iterator, the least word, the largest of a
// generic iterator, the greatest of owned strings and of references.

import std::io

interface Source<T> {
    var fn take(): Option<T>
}

extend Source<T: Add + Zero> {
    var fn total(): T = {
        var sum = T::zero()
        while self.take() is .Some(x) {
            sum = sum + x
        }
        return move sum
    }
}

struct Countdown {
    left: i64
}

extend Countdown: Source<i64> {
    var fn take(): Option<i64> = {
        if self.left == 0 then return .None
        self.left -= 1
        return .Some(self.left + 1)
    }
}

struct Fixed {
    left: i64
}

extend Fixed {
    var fn total(): i64 = 99
}

extend Fixed: Source<i64> {
    var fn take(): Option<i64> = .None
}

fn through<S: Source<i64>>(source: &var S): i64 = source.total()

fn upto(n: i64): Iterator<i64> = {
    var i = 1
    while i <= n {
        yield i
        i += 1
    }
}

fn largest<I: Iterator<T>, T: Ord>(values: I): Option<T> = values.max()

fn main() = {
    var countdown = Countdown(3)
    io::println("\(countdown.total())")
    var more = Countdown(4)
    io::println("\(through(&var more))")
    var fixed = Fixed(5)
    io::println("\(fixed.total())")

    val text = "wide 字\nab"
    io::println("\(text.chars().map(own (c) => c.width()).sum())")
    val lengths = text.lines().map(own (line) => line.len())
    io::println("\(lengths.max()) \(text.lines().map(own (line) => line.len()).min())")
    io::println("\(upto(5).product()) \(upto(4).sum()) \(upto(0).max())")
    io::println("\("pear fig plum".split(" ").min()) \(largest(upto(3)))")
    val names = Vec::of(own [String::of("pear"), String::of("fig")])
    io::println("\(names.intoIterator().max())")
    val values = [3, 9, 4]
    io::println("\(values.backwards().max())")
}
