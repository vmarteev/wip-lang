// An array by reference crosses to C as a pointer to its first element, as
// C's `T x[N]` parameter is: read through `&`, written
// through `&var`, and two deep.

import std::io

extern "C" {
    fn sum4(xs: &[i32; 4]): i32
    fn fill16(out: &var [u8; 16], start: u8)
    fn grid(g: &[[i32; 3]; 2]): i32
}

fn main() = {
    val xs: [i32; 4] = [1, 2, 3, 4]
    io::println("\(sum4(&xs))")
    var bytes: [u8; 16] = [0; 16]
    fill16(&var bytes, 7)
    io::println("\(bytes[0]) \(bytes[15])")
    val g: [[i32; 3]; 2] = [[1, 2, 3], [4, 5, 6]]
    io::println("\(grid(&g))")
    return
}
