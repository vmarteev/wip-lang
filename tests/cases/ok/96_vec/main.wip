// A buffer that grows. `Vec<T>` is written in Wip, in the
// prelude, on top of one primitive the compiler knows: `Slots<T>`, a block
// of slots none of which holds a value. Its `push`, `pop`, `reserve` and
// `clear` are ordinary code, and so is its drop.
//
// Expected output: 1000 (a thousand pushes, through several growths),
// 499500 (their sum, popped back out one at a time), 0 (empty again), 3 and
// 6 (a vector of vectors), 2 (elements that own memory, dropped with the
// vector), 7 (one held in a struct and moved), 20 and 10 (elements lent by
// `at`, a projection), and 60 with 10, 20 and 30 (a slice lent by `items`,
// summed by a function written for `&[T]` and walked by `for`), with every
// allocation freed.

import std::io

struct Token {
    id: i64
}

struct Holder {
    values: Vec<i64>
}

fn sum(v: &var Vec<i64>): i64 = {
    var total = 0
    while v.len() > 0 {
        match v.pop() {
            .Some(value) => total += value
            .None => {}
        }
    }
    total
}

fn totalOf(xs: &[i64]): i64 = {
    var total = 0
    for x in xs {
        total += x
    }
    total
}

fn main() = {
    var values: Vec<i64> = Vec()
    var i = 0
    while i < 1000 {
        values.push(i)
        i += 1
    }
    io::printInt(values.len())
    io::printInt(sum(&var values))
    io::printInt(values.len())

    // A vector of vectors: the inner ones are dropped with the outer.
    var rows: Vec<Vec<i64>> = Vec::withCapacity(2)
    var first: Vec<i64> = Vec()
    first.push(1)
    first.push(2)
    first.push(3)
    io::printInt(first.len())
    var second: Vec<i64> = Vec()
    second.push(6)
    rows.push(move first)
    rows.push(move second)
    match rows.pop() {
        .Some(row) => {
            var taken = move row
            io::printInt(sum(&var taken))
        }
        .None => io::printInt(0)
    }

    // Elements that own memory.
    var owners: Vec<own<Token>> = Vec()
    owners.push(own Token(id: 1))
    owners.push(own Token(id: 2))
    io::printInt(owners.len())

    // A vector held in a struct, moved into it.
    var held: Vec<i64> = Vec()
    held.push(7)
    var holder = Holder(values: move held)
    match holder.values.pop() {
        .Some(value) => io::printInt(value)
        .None => io::printInt(0)
    }

    // An element is lent where it is, and the whole is lent as a slice, so
    // everything written for `&[T]` works.
    var lent: Vec<i64> = Vec()
    lent.push(10)
    lent.push(20)
    lent.push(30)
    io::printInt(lent.at(1))
    io::printInt(lent.at(0))
    io::printInt(totalOf(&lent.items()))
    for value in lent.items() {
        io::printInt(value)
    }
}
