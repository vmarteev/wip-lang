// A value with no place of its own is lent where it is used, so a call
// takes it without an `&`: `map.at(1)`. `move` is ruled the same way —
// writing it on a temporary is an error, because a temporary is already
// moved where it is used.
//
// A place keeps its `&`, which is where a reader learns that a call can
// see their value. A projection's call is a place, so what
// it lends keeps its `&` too.
//
// Expected output: 10 and 1 (a number and a text key looked up without an
// `&`), 3 (an array literal lent as a slice, counted), 2 (a struct
// literal), 3 again (a generic parameter inferred through the lending), 7
// (a place, lent with its `&`), and 9 (what a projection lends, which is a
// place).

import std::io
import std::collections::{Map}

struct Card {
    rank: i64
}

struct Deck {
    cards: Vec<Card>

    pub static fn of(ranks: &[i64]): Deck = {
        var cards = Vec<Card>()
        for rank in ranks {
            cards.push(Card(rank: rank))
        }
        return Deck(cards: move cards)
    }
}

extend Deck: Items<Card> {
    fn items(): &[Card] = lend self.cards.items()
}

fn highest(cards: &[Card]): i64 = {
    var best = 0
    for card in cards {
        if card.rank > best {
            best = card.rank
        }
    }
    return best
}

fn rankOf(card: &Card): i64 = card.rank

fn sizeOf<T: Hash>(value: &T): i64 = {
    var hasher = Hasher()
    value.hashInto(&var hasher)
    return if hasher.finish() == 0 { 0 } else { 3 }
}

fn main() = {
    // A literal, and a `String` built for the lookup.
    var ages = Map<i64, i64>()
    ages.put(1, 10)
    io::printInt(ages.at(1))

    var counts = Map<String, i64>()
    counts.atOrPut(String::of("one"), 0) += 1
    io::printInt(counts.at(String::of("one")))

    // An array literal, lent as a slice by the parameter that takes it.
    val deck = Deck::of([2, 9, 4])
    io::printInt(deck.cards.len())

    // A struct literal.
    io::printInt(rankOf(Card(rank: 2)))

    // A type parameter inferred through the lending.
    io::printInt(sizeOf(7))

    // A place keeps its `&`.
    val card = Card(rank: 7)
    io::printInt(rankOf(&card))

    // What a projection lends is a place, so it keeps its `&` as well.
    io::printInt(highest(&deck.items()))
}
