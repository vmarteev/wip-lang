// `Result::collect` answers every value an iterator of results hands out,
// or the first error, after which nothing more is asked of it; and
// `Option::collect` likewise. A call's type arguments are inferred through
// what an iterator hands out: `Result::collect`'s from an iterator of
// results, `Map::fromPairs`'s from one of pairs, and a program's own
// function's through `Iterator<(K, V)>`.
//
// Expected output:
// 1 2 3
// error: 'x' after 2 asked
// 5 none
// ana 31, bo 47
// 2 pairs

import std::collections::{Map}
import std::io
import std::shared::{Shared}
import std::sync::{Atomic}

/// The numbers `texts` hold, read in turn, counting in `asked` how many
/// were read.
view struct Reading {
    texts: Vec<str>
    at: i64
    asked: Shared<Atomic<i64>>
}

extend Reading: Iterator<Result<i64, String>> {
    var fn next(): Option<Result<i64, String>> = {
        if self.at == self.texts.len() then return .None
        val text = self.texts[self.at]
        self.at += 1
        self.asked.value().add(1)
        return .Some(match text.toInt() {
            .Ok(n) => .Ok(n)
            .Err(..) => .Err("'\(text)'")
        })
    }
}

/// How many pairs a program's own function is given, its `K` and `V`
/// inferred from them.
fn countPairs<K, V, I: Iterator<(K, V)>>(pairs: I): i64 = {
    var count = 0
    for _ in move pairs {
        count += 1
    }
    return count
}

fn main() = {
    val good: Vec<str> = Vec::of(own ["1", "2", "3"])
    val all = Result::collect(good.walk().map(own (text) => text.toInt()))
    if all is .Ok(numbers) then io::println("\(numbers[0]) \(numbers[1]) \(numbers[2])")
    val asked = Shared::of(Atomic::of(0))
    val bad = Reading(texts: Vec::of(own ["1", "x", "3"]), at: 0, asked: asked.share())
    match Result::collect(bad) {
        .Ok(..) => io::println("all read")
        .Err(why) => io::println("error: \(why) after \(asked.value().load()) asked")
    }
    val maybe: Vec<Option<i64>> = Vec::of(own [.Some(2), .Some(3)])
    val some = Option::collect(maybe.walk())
    val gaps: Vec<Option<i64>> = Vec::of(own [.Some(2), .None])
    val none = Option::collect(gaps.walk())
    val both = some.unwrapOr(Vec())
    io::println("\(both[0] + both[1]) \(if none.isNone() then "none" else "some")")
    val names: Vec<String> = Vec::of(own [String::of("ana"), String::of("bo")])
    val years: Vec<i64> = Vec::of(own [31, 47])
    val ages = Map::fromPairs(names.intoIterator().zip(years.walk()))
    val ana = String::of("ana")
    val bo = String::of("bo")
    io::println("ana \(ages.get(&ana).unwrap()), bo \(ages.get(&bo).unwrap())")
    io::println("\(countPairs(good.walk().zip(years.walk()))) pairs")
}
