// Whether a product of two `i128`s fits, at the edges: the least value
// times one and minus one, the greatest times minus one and two, and the
// halves that reach the least exactly. Built for release on Linux, the
// check must not need a helper of LLVM's own runtime, which a program
// linked by GCC's toolchain has not.
//
// Expected output: least*1 fits, least*-1 overflows, greatest*-1 fits,
// greatest*2 overflows, half*2 fits, half*-2 overflows, -half*-2 fits,
// -4*3 = -12, and the saturated products are the greatest and the least.

import std::io

fn said(product: Option<i128>): str = if product.isSome() then "fits" else "overflows"

fn main() = {
	val least: i128 = -170141183460469231731687303715884105727 - 1
	val greatest: i128 = 170141183460469231731687303715884105727
	val half = least / 2
	io::println("least*1 \(said(least.checkedMul(1)))")
	io::println("least*-1 \(said(least.checkedMul(-1)))")
	io::println("greatest*-1 \(said(greatest.checkedMul(-1)))")
	io::println("greatest*2 \(said(greatest.checkedMul(2)))")
	io::println("half*2 \(said(half.checkedMul(2)))")
	io::println("half*-2 \(said(half.checkedMul(-2)))")
	io::println("-half*-2 \(said((0 - half).checkedMul(-2)))")
	if (-4 as i128).checkedMul(3) is .Some(product) then io::println("-4*3 = \(product)")
	io::println("\(greatest.saturatingMul(3) == greatest) \(greatest.saturatingMul(-3) == least)")
}
