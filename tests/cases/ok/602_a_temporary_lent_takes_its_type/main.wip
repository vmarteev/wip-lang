// A call whose value is lent where a `&` is taken — a temporary, which has
// no place of its own to write an `&` before — is expected to be what the
// `&` is to: a generic type's arguments come from it, and a lambda's
// parameters' types with them.
//
// Expected output: 0, then 12.

import std::io

struct Rule<F> {
	apply: own<F>
}

extend Rule<F> {
	static fn of(apply: own<F>): Rule<F> = Rule(apply: apply)
}

fn twice(rule: &Rule<(n: i64) => i64>, n: i64): i64 = (rule.apply)((rule.apply)(n))

fn total(numbers: &Vec<i64>): i64 = numbers.sum()

fn main() = {
	io::printInt(total(Vec::withCapacity(4)))
	io::printInt(twice(Rule::of(own (n) => n * 2), 3))
}
