// A slice read through a reference — a parameter, a constant of embedded
// bytes — stands for the elements, so a generic method finds its `T` in
// them; and where it is kept, in a local or an array, the reference is
// what is kept, since a slice has nothing of fixed size to copy. So is the
// one a call lends, which borrows what the call borrows.
//
// Expected output: "9 9 7 6 3".

import std::embed
import std::io

val BYTES: &[u8] = embed::bytes("assets/bytes.bin")

fn lengths(values: &[u8]): i64 = {
    val all = values
    var n = all.len()
    for part in [values, values] {
        n += part.len()
    }
    return n
}

fn main() = {
    val local: [u8; 3] = [1, 2, 3]
    val kept = BYTES
    var copy = kept.toVec()
    copy[0] += 1
    val both = [BYTES, kept]
    val list = Vec::of(own [4, 5, 6])
    val view = list.items()
    io::println("\(lengths(&local)) \(lengths(BYTES)) \(both[1].max().unwrap()) \(copy[0]) \(view.len())")
}
