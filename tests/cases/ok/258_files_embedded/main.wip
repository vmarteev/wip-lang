// Files embedded in the program: a text and a file of bytes read while the
// program is compiled, from beside the module, and kept as constants; the same
// file embedded twice, kept once; an array of them; a text parsed into a table
// while compiling; and a file's length checked by a top-level assert. A
// constant of bytes stands for the bytes, as a reference parameter does: a
// generic method of a slice is called on it directly. A text that may not be
// there is the file's where it is and the text given where it is not.
//
// Expected output: the two lines of the text, then "4 258 258 7 12": the
// bytes' count, their sum through each constant, the last level, and the
// text's length through an array of files' bytes; then "255 254": the
// largest byte, and the last of a copy changed; then "12 none": the length of
// a text that is there, and the text given for one that is not.

import std::embed
import std::io

val HELP: str = embed::text("assets/help.txt")
val DATA: &[u8] = embed::bytes("assets/data.bin")
val AGAIN = embed::bytes("assets/data.bin")
val BOTH: [&[u8]; 2] = [embed::bytes("assets/data.bin"), embed::bytes("assets/help.txt")]
val THERE: str = embed::textOr("assets/help.txt", "none")
val ABSENT: str = embed::textOr("assets/absent.txt", "none")

@comptime
val LEVELS: [i64; 3] = parse(embed::text("assets/levels.txt"))

assert(embed::bytes("assets/data.bin").len() == 4)

fn parse(text: str): [i64; 3] = {
    var out: [i64; 3] = [0, 0, 0]
    var i = 0
    for part in text.split(",") {
        out[i] = part.toInt().unwrap()
        i += 1
    }
    return out
}

fn total(bytes: &[u8]): i64 = {
    var sum = 0
    for b in bytes {
        sum += b as i64
    }
    return sum
}

fn main() = {
    io::print(HELP)
    io::println("\(DATA.len()) \(total(DATA)) \(total(AGAIN)) \(LEVELS[2]) \(BOTH[1].len())")
    var copy = DATA.toVec()
    copy[3] ^= 1
    io::println("\(DATA.max().unwrap()) \(copy[3])")
    io::println("\(THERE.len()) \(ABSENT)")
}
