// Top-level `val`s are constants: their values are worked
// out where they are written, so nothing runs before `main`, and a use is
// the value itself. One may use another, whatever order they are written in,
// and an array's length may be one.
//
// Expected output: 8191 (arithmetic over constants), -4096, 4096000000 (a
// cast), 1024 (a shift), 42 (a constant written after the one that uses it),
// 3 (`READ | WRITE` from another module), flags (a `cstring`), 1.5, 1 (a
// `bool`), and 9 (an array whose length is a constant).

import std::io

import flags

val SIZE = 4096
val LIMIT = SIZE * 2 - 1
val NEGATIVE = -SIZE
val WIDE: i64 = SIZE as i64 * 1000000
val SHIFTED = 1 << 10
val TOTAL = BASE * 2
val BASE = 21
val ELEMENTS = 4

struct Buffer {
    bytes: [i64; ELEMENTS]
}

extern "C" {
    fn puts(s: cstring): c_int
}

fn main() = {
    io::printInt(LIMIT)
    io::printInt(NEGATIVE)
    io::printInt(WIDE)
    io::printInt(SHIFTED)
    io::printInt(TOTAL)

    io::printInt(flags::BOTH as i64)
    puts(flags::NAME)
    io::printFloat(flags::RATIO)
    if flags::ON { io::printInt(1) } else { io::printInt(0) }

    val buffer = Buffer(bytes: [1, 2, 3, 4])
    val xs: [i64; ELEMENTS] = [5, 6, 7, 8]
    io::printInt(buffer.bytes[0] + xs[3])
}
