// Passing ownership with `move`. After `move a`, `a` is statically dead.

import std::io

struct Buffer {
    len: i64
    cap: i64
}

fn make(len: i64): own<Buffer> = {
    val b = own Buffer(len: len, cap: len * 2)
    move b
}

fn consume(b: own<Buffer>): i64 = {
    b.len
} // `b` is freed here

fn main(): i64 = {
    val a = make(16)
    val b = move a
    io::printInt(consume(move b)) // 16
    0
}
