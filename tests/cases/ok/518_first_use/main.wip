// A local whose value leaves its type arguments open takes them from the
// first place after it that names it: a method's arguments, as a generic
// function's say its own; a type expected there, of an argument, a field or
// a `return`; or a value assigned to it. A parameter that use leaves open
// takes its default. The value is checked again then, among the names it
// was declared among.
//
// Expected output:
// 2 3
// one 1
// nearest 2.5
// pool 1 0
// total 7
// shelf 1
// made 0
// three

import std::collections::{Map}
import std::io

struct Hit {
    at: f64
}

// The values default to the keys.
struct Pool<K, V = K> {
    keys: Vec<K> = Vec()
    values: Vec<V> = Vec()
}

extend Pool<K, V> {
    var fn add(key: K) keeps key = self.keys.push(key)
}

view struct Shelf {
    books: Vec<str>
}

fn total(items: &Vec<i64>): i64 = {
    var sum = 0
    for i in items {
        sum += i
    }
    return sum
}

fn made(): Vec<str> = {
    var names = Vec()
    return names
}

fn main() = {
    // A method's argument.
    var small = Vec()
    var large = Vec()
    for at in 0..5 {
        if at < 2 then small.push(at) else large.push(at * 10)
    }
    io::println("\(small.len()) \(large.len())")
    var counts = Map()
    counts.put("one", 1)
    for entry in counts {
        io::println("\(entry.key) \(entry.value)")
    }
    // A value assigned.
    var nearest = .None
    nearest = .Some(Hit(at: 2.5))
    if nearest is .Some(hit) then io::println("nearest \(hit.at)")
    // A default.
    var pool = Pool()
    pool.add(5)
    io::println("pool \(pool.keys.len()) \(pool.values.len())")
    // An argument's type; the value's own argument is checked among the
    // names around the declaration, not the use.
    val n = 4
    var numbers = Vec::withCapacity(n)
    {
        val n = "abc"
        numbers.push(n.len())
    }
    numbers.push(4)
    io::println("total \(total(&numbers))")
    // A field's type.
    var books = Vec()
    val shelf = Shelf(books: books)
    io::println("shelf \(shelf.books.len() + 1)")
    // A result's type.
    io::println("made \(made().len())")
    // In an arm.
    var picked = .None
    match n {
        4 => picked = .Some("three")
        _ => {}
    }
    if picked is .Some(p) then io::println(p)
}
