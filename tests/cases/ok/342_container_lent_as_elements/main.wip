// A container given where a call expects a slice is lent as its elements:
// a `Vec`, a `String` as its bytes, a `Set` as its keys
// and a type of the program's own; to a plain parameter and a generic one,
// whose `T` is found through it; through a reference parameter; a
// temporary, lent where it is used; and lent to be written with `&var`.

import std::io
import std::collections::{Set}

struct Bag {
    values: Vec<i64>
}

extend Bag: Items<i64> {
    fn items(): &[i64] = lend self.values.items()
}

fn total(values: &[i64]): i64 = {
    var sum = 0
    for v in values {
        sum += v
    }
    return sum
}

fn firstOf<T: Text>(xs: &[T]): String = "\(xs[0])"

fn count<T>(xs: &[T]): i64 = xs.len()

fn zero(xs: &var [i64]) = {
    for x in xs {
        x = 0
    }
}

fn viaReference(v: &Vec<i64>): i64 = total(v) + count(v)

fn main() = {
    var numbers = Vec::of(own [1, 2, 3])
    val names = Vec::of(own [String::of("a"), String::of("b")])
    io::println("\(total(&numbers)) \(firstOf(&names)) \(viaReference(&numbers))")
    val text = String::of("héllo")
    var keys: Set<i64> = Set()
    keys.add(7)
    val bag = Bag(values: Vec::of(own [4, 5]))
    io::println("\(count(&text)) \(count(&keys)) \(total(&bag))")
    io::println("\(total(Vec::of(own [1, 2]))) \(count(String::of("abc")))")
    zero(&var numbers)
    io::println("\(numbers)")
}
