// A variable whose whole value is an `if` or a `match` holds a reference
// where each branch ends in a `&place`, with nothing said of its type, as
// one whose value is a `&place` alone does: the reference chosen is read
// through, and nothing is copied.
//
// Expected output:
// gem
// coin
// coin 3

import std::io

struct Look {
    name: String
    count: i64
}

fn main() = {
    val gem = Look(name: String::of("gem"), count: 1)
    val coin = Look(name: String::of("coin"), count: 3)
    val first = if gem.count > coin.count then &coin else &gem
    io::println(first.name)
    val second = match coin.count {
        1 => &gem
        _ => {
            assert(coin.count > 1)
            &coin
        }
    }
    io::println(second.name)
    val third = (if second.count == 3 then &second else &first)
    io::println("\(third.name) \(third.count)")
}
