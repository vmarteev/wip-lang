// A container indexed by a position implements `Sequence` once, and gets
// `x[i]` and `for` both: `ring[i]` reads and writes through
// the same `at` a walk lends from. Generic code asks for `Sequence<T>`, which
// carries the length `Index` does not. `Index` is for a lookup whose key is
// not a position, and a type that has only its reading half is read-only.
//
// Expected output: 2 and 30, a position read and written; 1 2 30 4 walked;
// 37 summed and 5 at the ends through `Sequence<i64>`; b is 21 through a map's values; 7 read
// from a table that is only read.

import std::io
import std::collections::{Map}

struct Ring {
    slots: [i64; 4],
    start: i64
}

extend Ring: Sequence<i64> {
    fn len(): i64 = 4

    fn at(i: i64): &i64 = lend self.slots[(self.start + i) % 4]
}

extend Ring {
    var fn at(i: i64): &var i64 = lend self.slots[(self.start + i) % 4]
}

// Anything indexed by a position, with its length: no count passed beside
// it, as `Index<i64, i64>` needed.
fn total<C: Sequence<i64>>(c: &C): i64 = {
    var sum = 0
    for x in c {
        sum += x
    }
    sum
}

// The first and the last, by position.
fn ends<C: Sequence<i64>>(c: &C): i64 = c[0] + c[c.len() - 1]

// A lookup by a key that is not a position, only ever read.
struct Squares {
    values: [i64; 3]
}

extend Squares: Index<str, i64> {
    fn at(key: str): &i64 = lend self.values[if key == "two" { 1 } else { 2 }]
}

fn main() = {
    var ring = Ring(slots: [3, 4, 1, 2], start: 2)
    io::print("\(ring[1]) and ")
    ring[2] = 30
    io::println("\(ring[2])")
    for x in ring {
        io::print("\(x) ")
    }
    io::println("")
    io::println("\(total(&ring)) summed, ends \(ends(&ring))")

    var map = Map<str, i64>()
    map.put("a", 10)
    map.put("b", 20)
    map.values()[1] += 1
    io::println("\(map.keyAt(1)) is \(map.values()[1])")

    val table = Squares(values: [1, 4, 7])
    io::println("\(table["three"]) read")
}
