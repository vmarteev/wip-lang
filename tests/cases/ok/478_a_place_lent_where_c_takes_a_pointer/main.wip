// Where a C function takes a pointer, a call lends it a place: `&var x`
// for C to write, `&x` for it to read, an array or a slice as the address
// of its first element, anything for a `void *`, and `null` where C
// allows none. Each is lent for the call, as a reference argument is, so
// two out-parameters are two arguments: a count and the array C fills.
//
// Expected output: the count C wrote when asked with a null array, the
// elements it then wrote into an array and into a vector's slice, a
// handle C made, the sum of what it read, and a value C cleared.

import std::io

@header("lent.h")
extern "C" {
    type Thing
    fn listed(count: ptr<u32>, items: ptr<u32>)
    fn made(info: ptr<i32>, out: ptr<ptr<Thing>>)
    fn summed(items: ptr<u32>, count: i64): i64
    fn cleared(at: ptr<void>)

    // A `static inline`, called through C the compiler writes.
    @header("lent.h")
    fn doubled(at: ptr<u32>)
}

fn main() = {
    var count: u32 = 0
    listed(&var count, null)
    io::println("count \(count)")
    var items: [u32; 4] = [0; 4]
    listed(&var count, &var items)
    var more: Vec<u32> = Vec::filled(3, 0)
    listed(&var count, &var more.items())
    io::println("items \(items[0]) \(items[2]), more \(more[0]) \(more[2])")
    var thing: ptr<Thing> = null
    val info: i32 = 7
    made(&info, &var thing)
    io::println("made \(!thing.isNull)")
    io::println("summed \(summed(&items, 3)) \(summed(&more.items(), 3))")
    var value: i64 = 5
    cleared(&var value)
    doubled(&var count)
    io::println("cleared \(value), doubled \(count)")
}
