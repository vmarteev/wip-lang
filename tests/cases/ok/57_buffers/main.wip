// Buffers whose length is chosen at run time.
//
// Expected output: 5, 0, 30, 5, 9, 0, 2, 60, 2, 6.

import std::io

struct Point {
    x: i64
    y: i64
}

struct Samples {
    values: own<[i64]>
    scale: i64
}

fn squares(n: i64): own<[i64]> = {
    var xs = own [0; n]
    var i = 0
    while i < xs.len() {
        xs[i] = i * i
        i = i + 1
    }
    move xs
}

fn sum(xs: &[i64]): i64 = {
    var total = 0
    var i = 0
    while i < xs.len() {
        total = total + xs[i]
        i = i + 1
    }
    total
}

fn fill(xs: &var [i64], value: i64) = {
    var i = 0
    while i < xs.len() {
        xs[i] = value
        i = i + 1
    }
}

fn main(): i64 = {
    val count = 5
    val xs = squares(count)
    io::printInt(xs.len())
    io::printInt(xs[0])
    io::printInt(sum(&xs))
    io::printInt(sum(&xs[1..3]))

    // A buffer passed on to be written.
    var threes = own [7; count - 2]
    fill(&var threes, 3)
    io::printInt(sum(&threes))

    // An empty buffer still allocates, and is dropped like any other.
    val empty = own [1; count - 5]
    io::printInt(empty.len())

    // Elements that are structs.
    val points = own [Point(x: 1, y: 2); count]
    io::printInt(points[4].y)

    // An array on the heap becomes a buffer where one is expected, and one
    // whose elements own memory drops each of them.
    val fixed: own<[i64]> = own [10, 20, 30]
    io::printInt(sum(&fixed))
    val boxes: own<[own<i64>]> = own [own 1, own 2]
    io::printInt(boxes.len())

    // Moved into a struct, and dropped with it.
    val samples = Samples(values: move threes, scale: 2)
    io::printInt(samples.values.len() * samples.scale)
    0
}
