// A pattern inside a pattern tests what the field holds, to any depth,
// and `match` checks that the arms between them cover
// every value. A pattern that names no field tests the one field its
// variant has, so `.Some((a, b))` and `.Some(.None)` need no field name.
//
// Expected output: the same number, two numbers, a number and a flag,
// nothing twice, something else; then 7 seven, zero, 3; inner, outer,
// none; and false -1, where neither the `is` test nor the guard matches
// what is nested; then 1 ball.

import std::io
import std::collections::{Map}

@derive(Eq)
enum Value {
    Int(n: i64)
    Flag(on: bool)
    Nothing
}

fn describe(a: Value, b: Value): str = match (a, b) {
    (.Int(x), .Int(y)) => if x == y { "the same number" } else { "two numbers" }
    (.Int(..), .Flag(..)) => "a number and a flag"
    (.Nothing, .Nothing) => "nothing twice"
    _ => "something else"
}

fn named(v: Option<(i64, str)>): String = match v {
    .Some((0, _)) => String::of("zero")
    .Some((n, name)) => "\(n) \(name)"
    .None => String::of("none")
}

// Two deep, and every case written out: no `_` arm, and the checker agrees.
fn inside(v: Option<Option<i64>>): str = match v {
    .Some(.Some(0)) => "inner zero"
    .Some(.Some(..)) => "inner"
    .Some(.None) => "outer"
    .None => "none"
}

// A payload whose own fields the checker never had to name: asking what
// the arms cover must not need them.
struct Ball {
    x: i64
}

fn held(): Option<Vec<Ball>> = {
    var v = Vec<Ball>()
    v.push(Ball(x: 4))
    return .Some(move v)
}

// The `else` runs where the nested pattern does not match.
fn deep(v: Option<Option<i64>>): i64 = {
    val .Some(.Some(n)) = v else {
        return -1
    }
    n
}

fn main() = {
    io::println(describe(.Int(1), .Int(1)))
    io::println(describe(.Int(1), .Int(2)))
    io::println(describe(.Int(1), .Flag(true)))
    io::println(describe(.Nothing, .Nothing))
    io::println(describe(.Flag(false), .Nothing))

    io::println(named(.Some((7, "seven"))).toStr())
    io::println(named(.Some((0, "nought"))).toStr())
    var map = Map<str, Option<i64>>()
    map.put("a", .Some(3))
    // A nested pattern in a guard, which takes the value apart in one step.
    val .Some(.Some(n)) = map.remove("a") else {
        return
    }
    io::println("\(n)")

    io::println("\(inside(.Some(.Some(1)))) \(inside(.Some(.None))) \(inside(.None))")

    // An `is` test and a guard test what is nested too: neither matches
    // `.Some(.None)`, so the `else` runs.
    val outer: Option<Option<i64>> = .Some(.None)
    io::println("\(outer is .Some(.Some(..))) \(deep(outer))")

    match held() {
        .Some(balls) => io::println("\(balls.len()) ball")
        .None => io::println("none")
    }
}
