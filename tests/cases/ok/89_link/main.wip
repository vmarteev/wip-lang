// `@link("name", …)` on an extern block names the libraries its declarations
// come from: each becomes `-lname` on the linker's command line, once however
// many blocks name it. `m` is the math library, and `pthread` the threads,
// which every Unix has.
//
// Expected output: 12 (a square root computed by C), and 5 (a C function
// declared in a block that names no library, as before).

import std::io

@link("m", "pthread")
extern "C" {
    fn sqrt(x: f64): f64
}

// Named again: still linked once.
@link("m")
extern "C" {}

extern "C" {
    fn strlen(s: cstring): u64
}

fn main() = {
    io::printInt(sqrt(144.0) as i64)
    io::printInt(strlen("hello") as i64)
}
