// A local whose value is a number literal, or an `if`, a `match` or a block
// of them, takes the type that value would take where the local is first
// named: beside an operand, on either side; in a compound assignment,
// either way round; as an argument, a field, a `return`, a place lent, to
// Wip or to C; beside a type of a program's own, as what its operator
// takes; or from a value assigned to it. Where that first use says nothing — a method
// on it, a shift's amount, a lambda, a narrower integer that widens — it
// keeps the literal's own type, `i64` or `f64`. And on an operator's left,
// what takes its type from beside it takes the right's, as on its right.
//
// Expected output:
// sides -2 2
// sum 3.5 along 2
// half 1.5 point 1
// count 7 bytes 7 exponent 4
// scaled 3
// cases 3 2
// own 8 4 true 2.5
// left 2 2 2 2

import std::io

extern "C" {
    fn frexp(x: f64, exponent: ptr<c_int>): f64
}

struct Point {
    x: f32
}

extend Point: Multiply<f32> {
    fn multiply(other: &f32): Point = Point(x: self.x * other)
}

fn half(x: f32): f32 = x / 2.0

fn fill(into: &var c_int) = {
    into = 7
}

fn one(): f32 = {
    val value = 1.0
    return value
}

fn main() = {
    val halfX: f32 = 2.0
    val dx: f32 = -1.0
    // An operand, on the left and on the right.
    val side = if dx >= 0.0 then 1.0 else -1.0
    val west = side * halfX
    val other = 1.0
    val east = halfX * other
    io::println("sides \(west) \(east)")
    // A compound assignment, either way round, and a comparison.
    var sum = 0.0
    for x in [halfX, dx, 0.5] {
        sum += x.abs()
    }
    var along = 0.0
    while along < halfX {
        along += 0.5
    }
    io::println("sum \(sum) along \(along)")
    // An argument, a field, a `return`.
    val size = 3.0
    val x = 1.0
    io::println("half \(half(size)) point \(Point(x: x).x + one() - 1.0)")
    // A place lent, and a value assigned.
    var count = 0
    fill(&var count)
    var bytes = 0
    bytes = 7 as u8
    var exponent = 0
    frexp(8.0, &var exponent)
    io::println("count \(count) bytes \(bytes) exponent \(exponent)")
    val by = 1.5
    io::println("scaled \((Point(x: 2.0) * by).x)")
    // A `match` of literals, a negated literal, an integer.
    val small: u8 = 1
    val step = match small {
        1 => 2
        _ => 3
    }
    val down = -1
    io::println("cases \(small + step) \(small as i8 - down)")
    // What says nothing: a shift's amount, a lambda, a narrower integer.
    val n = 3
    val shifted = (1 as u32) << n
    val total: i64 = n + 1
    val wide = 2
    val compared = wide > small
    val scale = 2.5
    val scaled = () => scale * 1.0
    val also: f64 = scale
    io::println("own \(shifted) \(total) \(compared) \(scaled() + also - also)")
    // The value is checked where it was written, among its names, though a
    // later one hides one of them.
    val sign = if dx >= 0.0 then 1.0 else -1.0
    val towards = sign * halfX
    val dx = "hidden"
    // On the left as on the right.
    val a = (if halfX > 0.0 then 1.0 else -1.0) * halfX
    val b = (1.0) * halfX
    val c = { 1.0 } * halfX
    io::println("left \(a) \(b) \(c) \(-towards)")
}
