// `if c then a else b`: a value; a chain; a chain broken
// before each `else`; `return`, `continue` and `break` as a branch; an
// assignment; what an `is` binds, in the branch; `else` taking the rest
// of the expression; and a line ending in `then` or `else` going on.
//
// Expected output:
// 7 -1 0 .Some(8) 9 9 10 4 1
// nothing one item 3 items 4

import std::io

fn max(a: i64, b: i64): i64 = if a < b then b else a

fn sign(x: i64): i64 = if x < 0 then -1 else if x == 0 then 0 else 1

fn first(xs: &[i64]): Option<i64> = {
    if xs.isEmpty() then return .None
    return .Some(xs[0])
}

fn describe(count: i64): String =
    if count == 0 then "nothing"
    else if count == 1 then "one item"
    else "\(count) items"

fn main() = {
    val wraps = true
    val limit = if wraps then 10 - 1 else -1
    var best = 0
    for n in [3, 9, 4] {
        if n > best then best = n
    }
    val found: Option<i64> = .Some(5)
    val doubled = if found is .Some(n) then n * 2 else 0
    var total = 0
    for n in [1, 2, 3, 4] {
        if n == 2 then continue
        if n == 4 then break
        total += n
    }
    val rest = if wraps then 1 else 2 + 3
    io::println("\(max(2, 7)) \(sign(-4)) \(sign(0)) \(first([8, 9])) \(limit) \(best) \(doubled) \(total) \(rest)")
    val spread = if !wraps then
        3
    else
        4
    io::println("\(describe(0)) \(describe(1)) \(describe(3)) \(spread)")
}
