// A closure kept in a `val`: a lambda that is a `val`'s
// whole value may capture what is around it by `&`, and be called, or
// passed where a closure is taken, for as long as what it captures stays
// as it was. One that captures nothing is still a plain function value.
// What it captures is found before the module's names.

import std::io

fn count(names: &Vec<String>, keep: &(name: &String) => bool): i64 = {
    var n = 0
    for name in names {
        if keep(&name) {
            n += 1
        }
    }
    return n
}

fn twice(f: (n: i64) => i64, n: i64): i64 = f(f(n))

// A variable a lambda captures shadows a function of the same name, as
// any variable does.
fn limit(): i64 = 100

fn main() = {
    var names: Vec<String> = Vec()
    names.push("ann")
    names.push("bartholomew")
    names.push("cy")
    val limit = 3
    val short = (name: &String) => name.len() <= limit
    io::println("\(short(&names[0])) \(short(&names[1]))")
    io::println("\(count(&names, short)) short")

    // One kept closure may call another.
    val long = (name: &String) => !short(&name)
    io::println("\(count(&names, long)) long")

    // Captured nothing: a plain function value, which a plain one takes.
    val double = (n: i64) => n * 2
    io::println("\(twice(double, 3))")

    // What it captured may change once it is no longer used.
    names.push("dee")
    io::println("\(names.len())")
}
