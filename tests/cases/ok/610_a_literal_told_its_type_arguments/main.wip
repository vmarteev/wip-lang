// An argument whose type arguments are said by what is expected of it — a
// generic struct built without them, a number literal — is checked after
// the arguments that say their own type, and after an implicit the call
// fills, so it is told them: by value, lent where a `&` is taken, and
// given by name.
//
// Expected output:
// 11 11
// 30
// 1 5

import std::io

struct Metal {
    n: i64
}

struct Draw<G> {
    width: i64
}

struct Writer<G> {
    scale: i64
}

fn byValue<G>(writer: Writer<G>, draw: Draw<G>): i64 = writer.scale + draw.width

fn byRef<G>(writer: &Writer<G>, draw: Draw<G>): i64 = writer.scale + draw.width

fn written<G>(writer: &Writer<G>, text: str, implicit draws: &var Vec<Draw<G>>) = {
    draws.push(Draw(width: text.len() * writer.scale))
}

fn paired<T: copy>(by: T, implicit unit: T): (T, T) = (by, unit)

fn main() = {
    val draw: Draw<Metal> = Draw(width: 1)
    io::println("\(byValue(Writer(scale: 10), draw)) \(byRef(Writer(scale: 10), draw))")
    implicit var draws: Vec<Draw<Metal>> = Vec()
    written(Writer(scale: 10), "abc")
    io::println("\(draws[0].width)")
    implicit val unit: i32 = 1
    // `T` is the implicit's `i32`, which the literal is.
    val pair = paired(by: 5)
    val narrow: (i32, i32) = pair
    io::println("\(narrow.1) \(narrow.0)")
}
