/// Its fields are its own, and each has a default that is code.
pub struct Bag {
    items: Vec<i64> = Vec()
    count: i64 = 0
}

extend Bag {
    pub var fn put(item: i64) = {
        self.items.push(item)
        self.count += 1
    }

    pub fn len(): i64 = self.count
}

/// The same, generic.
pub struct Shelf<T> {
    items: Vec<T> = Vec()
}

extend Shelf<T> {
    pub var fn put(item: T) keeps item = self.items.push(move item)

    pub fn len(): i64 = self.items.len()
}
