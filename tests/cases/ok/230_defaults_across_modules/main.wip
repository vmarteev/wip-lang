// A literal in another module leaves fields to their defaults, private ones
// included, and the default that is code is called from there.

import std::io
import bag::{Bag, Shelf}

fn main() = {
    var bag = Bag()
    bag.put(3)
    var shelf: Shelf<String> = Shelf()
    shelf.put(String::of("a"))
    io::println("\(bag.len()) \(shelf.len())")
}
