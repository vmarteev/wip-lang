// `unbox(boxed)` takes the value a box holds out of it and frees the box:
// the value goes on to its new owner and ends once, where that owner does,
// never with the box. A box of a box is emptied twice to reach the value.
//
// Expected output:
// pushed: a b
// taken, then ~1
// inner: 7
// word: hello

import std::io

struct Loud {
    id: i64
}

extend Loud: Destroy {
    var fn destroy() = io::print(" ~\(self.id)")
}

enum Datum {
    Symbol(name: String)
    List(elements: Vec<Datum>)
}

fn names(data: &[Datum]): String = {
    var out = String()
    for datum in data {
        if datum is .Symbol(name) then out.push(" \(name)")
    }
    return out
}

fn main() = {
    var data: Vec<Datum> = [.Symbol("a")]
    val tail: own<Datum> = own .Symbol("b")
    data.push(unbox(tail))
    io::println("pushed:\(names(&data))")

    {
        val loud = unbox(own Loud(1))
        io::print("taken, then")
    }
    io::println("")

    val twice: own<own<i64>> = own own 7
    val inner: own<i64> = unbox(twice)
    io::println("inner: \(unbox(inner))")

    val word = unbox(own String::of("hello"))
    io::println("word: \(word)")
}
