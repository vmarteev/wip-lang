// A lambda's result type is written after its parameters, and a tuple
// there is a tuple, though the lambda's `=>` follows it; a function type
// there names its parameters, or has none.
//
// Expected output:
// (2, 3)
// 8

import std::io

fn main() = {
    val pair = (n: i64): (i64, i64) => (n, n + 1)
    io::println("\(pair(2))")
    val doubling = (n: i64): (step: i64) => i64 => (step) => step * 2
    io::println("\(doubling(0)(4))")
}
