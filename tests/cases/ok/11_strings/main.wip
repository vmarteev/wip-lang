// String literals and escapes, passed to C as `cstring`: a pointer to
// NUL-terminated bytes, `const char *` in C.

import std::io

fn greet(name: cstring) = {
    io::printCstring(name)
}

fn main(): i64 = {
    greet("plain")
    greet("tab:\there")
    greet("two\nlines")
    greet("quote: \" backslash: \\")
    greet("carriage return:\r nul:\0 (C stops reading here)")
    greet("")
    greet("non-ASCII is fine inside strings: héllo, wörld, 日本")
    0
}
