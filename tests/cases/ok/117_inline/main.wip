// `@inline` is a guarantee: every call to the function is spliced into its
// caller, and a call that cannot be is an error. There is
// no optimizer on this path — the Cranelift backend is the debug backend —
// so a call is a call, and a small function costs about half of one.
//
// The part worth having is the second: a lambda handed to an `@inline`
// function is spliced with it. Without that, internal iteration goes
// through a closure pair and an indirect call for every element, so
// `forEach` costs about twice the loop it replaces, and that is a cost the
// program cannot write its way around.
//
// Measured on Apple arm64, 300M rounds of `add(total, i)`: 0.29s as a call,
// 0.15s inlined, which is what the same loop written by hand costs. For
// `forEach` over 240M elements: 0.20s, 0.15s inlined, against 0.11s for the
// loop. What is left of that gap is the environment, which is still built
// and read through.
//
// Expected output: the same answers a program without `@inline` gives —
// which is the whole promise.

import std::io

struct Bag { total: i64 }

@inline
fn add(a: i64, b: i64): i64 = a + b

// One `@inline` function calling another: both are spliced, innermost
// first.
@inline
fn twice(n: i64): i64 = add(n, n)

@inline
fn forEach(items: &[i64], visit: &var (item: &i64) => void) = {
    for item in items {
        visit(&item)
    }
}

// A `@tailrec` function is a loop before inlining sees it, so it may be
// both.
@inline
@tailrec
fn countDown(n: i64, sum: i64): i64 = if n == 0 { sum } else { countDown(n - 1, sum + n) }

fn main() = {
    var total = 0
    var i = 0
    while i < 5 {
        total = add(total, twice(i))
        i = i + 1
    }
    io::println("total \(total)")

    val xs = [1, 2, 3, 4]
    var bag = Bag(total: 0)
    forEach(&xs, (item) => bag.total += item)
    io::println("bag \(bag.total)")

    // A closure that reads another variable as well as writing one.
    var seen = Bag(total: 0)
    var base = 10
    forEach(&xs, (item) => seen.total += item + base)
    io::println("seen \(seen.total)")

    io::println("counted \(countDown(4, 0))")
}
