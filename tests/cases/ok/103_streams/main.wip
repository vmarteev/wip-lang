// The three streams. `print` and `println` write to
// standard output, `eprint` and `eprintln` to standard error, and `flush`
// empties the buffer the two do not share — which is C's, since Wip's
// output and the output of any C it calls must arrive in one order.
//
// Reading is a value the program holds, because a reader must remember the
// bytes it has read and not yet given out, and the library has nowhere to
// keep them. This program is run with nothing on its standard input, so the
// first read is the end of it.
//
// Expected output: on standard output, a line built from three writes,
// then 0 for the bytes read and 0 for what they appended, and `nothing` for
// the read that found the end; on standard error, two lines.

import std::io

fn main(): Result<void, io::IoError> = {
    io::print("one")
    io::print(" two")
    io::println(" three")
    io::flush()?

    var input = io::stdin()
    var text = String()
    io::printInt(input.readAll(&var text)?)
    io::printInt(text.len())

    var line = String()
    if input.readLine(&var line)? {
        io::println("read a line")
    } else {
        io::println("nothing")
    }

    io::eprint("half a line, ")
    io::eprintln("and the rest")
    return .Ok()
}
