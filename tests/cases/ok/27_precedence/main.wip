// Operator precedence and associativity, pinned down by the parser snapshot.
// From loosest to tightest: `=`, `||`, `&&`, `==` `!=`, `<` `<=` `>` `>=`,
// `+` `-`, `*` `/` `%`, prefix `-` `!` `&` `move` `own`, postfix `.` `()` `[]`.

struct V {
    x: i64
}

fn f(a: i64): i64 = {
    a
}

fn main(): i64 = {
    var a = 1
    var b = 2
    val c = 3
    val t = true
    val u = a + b * c - a / b % c   // (a + (b * c)) - ((a / b) % c)
    val w = a < b == b < c          // (a < b) == (b < c)
    val z = t || t && !t            // t || (t && (!t))
    val n = -f(a) * -c              // (-(f(a))) * (-c)
    val v = own V(x: 1)
    val k = -v.x                    // -(v.x)
    val arr = [1, 2, 3]
    val m = -arr[0] + f(arr[1]) * (a - b)
    a = b - 1
    u + n + k + m
}
