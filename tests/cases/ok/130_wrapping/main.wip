// A long expression wraps in parentheses, where line
// breaks are whitespace. The rule is that a line break ends an
// expression that is complete, and that no line may begin with an
// operator; inside brackets neither applies, so one rule wraps a chain of
// calls, a sum and an argument list alike.
//
// Expected output: 4 (a chain of calls), 6 (a sum), 12 (a call whose
// arguments are spread over lines), and 9 (a chain that reads a field).

import std::io

struct Point {
    x: i64
    y: i64
}

fn area(width: i64, height: i64): i64 = width * height

fn main() = {
    val some: Option<i64> = .Some(2)
    val doubled = (some
        .map((v: i64) => v * 2)
        .unwrapOr(0))
    io::printInt(doubled)

    val total = (1
        + 2
        + 3)
    io::printInt(total)

    io::printInt(area(
        width: 3,
        height: 4,
    ))

    val here = Point(x: 4, y: 5)
    io::printInt((here
        .x) + here.y)
}
