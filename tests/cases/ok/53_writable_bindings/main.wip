// Writable `match` bindings. When the matched place can be
// written, a `var` or a `&var` parameter, its bindings are `&var` aliases: a
// search tree grows in place, its subtrees swap, and a list is updated in
// place. Compare ok/51, which rebuilds. The trace shows that nothing is
// freed or allocated again: each insertion allocates only the two leaves of
// its new node, and `incrementAll` allocates nothing.
//
// Expected output: six allocations for three insertions, 16 (the sum), 3
// (the leftmost value), 8 (leftmost after mirroring), three allocations for
// the list, 5 (its sum after incrementing 1 and 2), then every allocation
// freed.

import std::io

extern "C" {
    fn wip_trace_allocs()
}

enum Tree {
    Node(value: i64, left: own<Tree>, right: own<Tree>)
    Leaf
}

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

fn insert(tree: &var Tree, value: i64) = match tree {
    .Node(value: v, left, right) => if value < v {
        insert(&var left, value)
    } else {
        insert(&var right, value)
    }
    .Leaf => tree = .Node(value, left: own .Leaf, right: own .Leaf)
}

fn swap(a: &var own<Tree>, b: &var own<Tree>) = {
    val t = move a
    a = move b
    b = move t
}

fn mirror(tree: &var Tree) = match tree {
    .Node(left, right, ..) => {
        swap(&var left, &var right)
        mirror(&var left)
        mirror(&var right)
    }
    .Leaf => {}
}

fn sum(tree: &Tree): i64 = match tree {
    .Node(value: v, left, right) => v + sum(&left) + sum(&right)
    .Leaf => 0
}

fn leftmost(tree: &Tree, default: i64): i64 = match tree {
    .Node(value: v, left, ..) => leftmost(&left, v)
    .Leaf => default
}

fn incrementAll(list: &var List) = match list {
    .Cons(head, tail) => {
        head = head + 1
        incrementAll(&var tail)
    }
    .Nil => {}
}

fn sumList(list: &List): i64 = match list {
    .Cons(head, tail) => head + sumList(&tail)
    .Nil => 0
}

fn main(): i64 = {
    wip_trace_allocs()
    var tree = Tree::Leaf
    insert(&var tree, 5)
    insert(&var tree, 3)
    insert(&var tree, 8)
    io::printInt(sum(&tree))
    io::printInt(leftmost(&tree, -1))
    mirror(&var tree)
    io::printInt(leftmost(&tree, -1))
    var list = own List::Cons(head: 1, tail: own List::Cons(head: 2, tail: own List::Nil))
    incrementAll(&var list)
    io::printInt(sumList(&list))
    0
}
