// A constant that says `@define` has the value written where no build sets
// it, and is read as any constant: in a condition, which takes one branch
// only, in an array's length and in another constant.
//
// Expected output:
// editor
// Marble 32 1.5
// 2

import std::io

@define
val EDITOR: bool = true

@define
val ZONE: i64 = 32

@define
val SCALE: f64 = 1.5

@define
val TITLE: str = "Marble"

@define
val SIDE: i64 = 2

val CELLS: [i64; SIDE] = [0; SIDE]

fn main() = {
	if EDITOR then io::println("editor") else io::println("no editor")
	if !EDITOR && TARGET_OS == "nowhere" then io::println("never")
	io::println("\(TITLE) \(ZONE) \(SCALE)")
	io::println("\(CELLS.len())")
}
