// `as` between integers gives the same number in the new type: a value the
// type holds goes through, a narrower type and the other sign alike, and
// one it does not hold panics with the value and the type. `as%` keeps the
// low bits of the same values instead.
//
// Expected output:
// 200 -5 4000000000
// 44 251 4294967295
// panicked: 300 does not fit in a u8

import std::io

fn byte(n: i64): u8 = n as u8

fn signed(n: u64): i64 = n as i64

fn main() = {
	val minus: i64 = -5
	val big: u64 = 4000000000
	io::println("\(byte(200)) \(minus as i32) \(big as u32)")
	io::println("\(300 as% u8) \(minus as% u8) \(-1 as% u32)")
	io::println("\(signed(big) + byte(300) as i64)")
}
