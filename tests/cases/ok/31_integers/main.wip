// Integer semantics: `-9223372036854775808` is a
// literal, an answer that does not fit panics, `+%` wraps where wrapping is
// what was meant, and division truncates toward zero.

import std::io

fn main(): i64 = {
    val min = -9223372036854775808
    val max = 9223372036854775807
    io::printInt(min)
    io::printInt(max +% 1)  // wraps to -9223372036854775808
    io::printInt(-7 / 2)    // -3
    io::printInt(-7 % 2)    // -1
    io::printInt(7 / -2)    // -3
    0
}
