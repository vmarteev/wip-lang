// A `main` that returns a `Result`. `?` then works at the
// top level, which is where a small program does its work, and the error
// type is any type that can be written as text — `Text`, the interface
// interpolation already asks for.
//
// This one succeeds, so nothing is reported and the exit code is 0. The
// error that is built and thrown away on the way proves the `Ok` path runs
// with an error type that owns memory.
//
// A line that begins with `.` is a variant, never a method call on the line
// above it, but it reads like one after a call — so where
// the value follows a statement, it is written `return .Ok(…)`.
//
// Expected output: read 12 rows, and then found, since the second read is
// handled rather than propagated.

import std::io

enum ReadError {
    NotFound(path: String)
    Empty
}

extend ReadError: Text {
    fn appendTo(out: &var String) = match self {
        .NotFound(path) => {
            out.push("no such file: ")
            out.push(path)
        }
        .Empty => out.push("the file is empty")
    }
}

fn rowsIn(name: str): Result<i64, ReadError> = if name == "input.txt" {
    .Ok(12)
} else {
    var path = String()
    path.push(name)
    return .Err(.NotFound(move path))
}

fn main(): Result<void, ReadError> = {
    val rows = rowsIn("input.txt")?
    io::println("read \(rows) rows")
    match rowsIn("nope.txt") {
        .Ok(count) => io::println("unreachable")
        .Err(error) => io::println("found")
    }
    return .Ok()
}
