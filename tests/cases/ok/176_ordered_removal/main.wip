// A map and a set keep the order keys went in through `remove`, as a
// `Vec` does, and `swapRemove` moves the last one into the gap, as a
// `Vec`'s does. Every key is still found afterwards, which
// is what the table's positions being moved down makes true.
//
// Expected output: [one, three, four, five] (remove keeps the order);
// [five, three, four, one] (swapRemove moved `five` into `one`'s gap, and
// `one` went back in at the end); 30, 10 (found by key after both); a walk
// of 50 keys still in order with every lookup right; the set's order after
// each, the same way.

import std::io
import std::collections::{Map, Set}

fn keys(map: &Map<str, i64>): String = {
    var out = String()
    out.push("[")
    for entry in map {
        if out.len() > 1 {
            out.push(", ")
        }
        out.push(entry.key)
    }
    out.push("]")
    move out
}

fn main() = {
    var map = Map<str, i64>()
    map.put("one", 10)
    map.put("two", 20)
    map.put("three", 30)
    map.put("four", 40)
    map.put("five", 50)

    io::println("\(map.remove("two")) \(keys(&map))")
    io::println("\(map.swapRemove("one")) \(map.remove("two"))")
    map.put("one", 10)
    io::println("\(keys(&map))")
    io::println("\(map.at("three")), \(map.at("one"))")

    // Many removals, and the table still points where the entries are.
    var numbers = Map<i64, i64>()
    for n in 0..100 {
        numbers.put(n, n * n)
    }
    for n in 0..100 {
        if n % 2 == 0 {
            numbers.remove(&n)
        }
    }
    var ordered = true
    var previous = -1
    var right = true
    for entry in numbers {
        ordered = ordered && entry.key > previous
        previous = entry.key
        right = right && numbers.at(&entry.key) == entry.key * entry.key
    }
    io::println("\(numbers.len()) keys, in order \(ordered), found \(right)")

    var set = Set<str>()
    for word in ["red", "green", "blue", "cyan"] {
        set.add(word)
    }
    set.remove("green")
    io::println("\(set.items().walk().toVec())")
    set.swapRemove("red")
    io::println("\(set.items().walk().toVec()) \(set.contains("cyan")) \(set.contains("red"))")
}
