// A generic method whose type parameter only its result names: its type
// argument written after its name, or said by what is expected of the
// value — through `?`, which takes it out of a `Result`, and through a
// method called on it, `unwrap` or `unwrapOr`, whose result is read in the
// type the value is. A free function's the same way.
//
// Expected output: 6, 3, 2, 0 and 1, each on a line.

import std::io
import std::json
import std::json::{DecodeError}

struct Answer {
	text: String
}

extend Answer {
	fn read<T: Decode>(): Result<T, DecodeError> = json::decode(&self.text)
}

fn total(answer: &Answer): Result<i64, DecodeError> = {
	val numbers: Vec<i64> = answer.read()?
	return .Ok(numbers.sum())
}

fn count(numbers: Vec<i64>): i64 = numbers.len()

fn first(text: str): Result<i64, DecodeError> = {
	val numbers: Vec<i64> = json::decode(text)?
	return .Ok(numbers[0])
}

fn main() = {
	val answer = Answer(text: String::of("[1, 2, 3]"))
	io::printInt(total(&answer).unwrap())
	val numbers: Vec<i64> = answer.read().unwrap()
	io::printInt(numbers.len())
	val written = answer.read<Vec<i64>>().unwrap()
	io::printInt(written[1])
	val broken = Answer(text: String::of("[1,"))
	val none: Vec<i64> = broken.read().unwrapOr(Vec())
	io::printInt(none.len())
	assert(count(answer.read().unwrap()) == 3)
	io::printInt(first("[1]").unwrap())
}
