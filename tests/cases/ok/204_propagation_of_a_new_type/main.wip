// `?` asks whether what it takes out owns memory, and the answer needs
// the field types of the type inside the `Result`. A type the program
// first spells while a body is checked — here `Map<String, Vec<String>>` —
// had not had them worked out yet, and the compiler stopped with a panic.
// They are worked out as the question is asked now, as everywhere else
// the checker asks it.
//
// Expected output: 2, then 1, then "none".

import std::collections::{Map}
import std::io

fn made(): Result<Map<String, Vec<String>>, String> = {
    var map: Map<String, Vec<String>> = Map()
    map.put("a", Vec())
    map.put("b", Vec())
    return .Ok(move map)
}

fn counted(map: &Map<String, Vec<String>>): Result<i64, String> = .Ok(map.len())

fn taken(): Result<i64, String> = {
    val map = made()?
    return .Ok(map.len())
}

fn passed(): Result<i64, String> = {
    val count = counted(made()?)?
    return .Ok(count - 1)
}

fn failed(): Result<Option<Vec<String>>, String> = .Err("none")

fn refused(): Result<i64, String> = {
    val nothing = failed()?
    return .Ok(if nothing.isSome() { 1 } else { 0 })
}

fn main() = {
    io::println("\(taken().unwrapOr(0))")
    io::println("\(passed().unwrapOr(0))")
    match refused() {
        .Ok(..) => io::println("?")
        .Err(why) => io::println(why)
    }
}
