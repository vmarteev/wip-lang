// A method called through a `&dyn` takes its arguments as any call does:
// `&place` and `&var place` lend where its parameters take references, and
// a value is given as it is. A default method is called the same way.
//
// Expected output: [a|b] then <a b>, each said twice.

import std::io

interface Joiner {
	fn open(out: &var String) = out.push("[")

	fn join(parts: &[str], times: i64, out: &var String)
}

struct Bars {}

struct Spaces {}

extend Bars: Joiner {
	fn join(parts: &[str], times: i64, out: &var String) = {
		for _ in 0..times {
			out.push(parts.join("|"))
		}
		out.push("]")
	}
}

extend Spaces: Joiner {
	fn open(out: &var String) = out.push("<")

	fn join(parts: &[str], times: i64, out: &var String) = {
		for _ in 0..times {
			out.push(parts.join(" "))
		}
		out.push(">")
	}
}

fn written(joiner: &dyn Joiner, parts: &[str]): String = {
	var out = String()
	joiner.open(&var out)
	joiner.join(&parts, 1, &var out)
	return move out
}

fn main() = {
	val parts = ["a", "b"]
	for _ in 0..2 {
		io::println("\(written(Bars(), &parts)) \(written(Spaces(), &parts))")
	}
}
