// f64 literals, including exponents, and float arithmetic.

import std::io

fn circleArea(r: f64): f64 = {
    3.141592653589793 * r * r
}

fn main(): i64 = {
    val tiny = 1.5e-3
    val big = 6.02E23
    val whole = 2e10
    val signed = 1e+2
    io::printFloat(circleArea(2.0))
    io::printFloat(tiny * 1000.0)
    io::printFloat(big / whole)
    io::printFloat(signed)
    io::printFloat(-0.5)
    0
}
