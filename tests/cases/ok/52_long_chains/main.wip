// Dropping long chains of `own` values. When the last part a
// node drops is an `own` of the same type, the drop continues with it in a
// loop instead of calling itself, so the stack does not grow with the length
// of the chain. Before, dropping a list of 500,000 nodes overflowed the
// stack. Every run test checks that nothing leaks, so each chain is freed
// completely.
//
// Three shapes: an enum whose payload holds the next node (`List`), a struct
// whose field is an enum holding the next node (`Node` and `Link`), and the
// left spine of a tree, whose right children are dropped by a call.
//
// Expected output: 1000000 three times, once after each chain is dropped.

import std::io

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

struct Node {
    value: i64
    next: Link
}

enum Link {
    Some(node: own<Node>)
    None
}

enum Tree {
    Node(value: i64, left: own<Tree>, right: own<Tree>)
    Leaf
}

fn list(n: i64): i64 = {
    var list = own List::Nil
    var i = 0
    while i < n {
        list = own List::Cons(head: i, tail: move list)
        i = i + 1
    }
    n
}

fn links(n: i64): i64 = {
    var head = Link::None
    var i = 0
    while i < n {
        head = Link::Some(own Node(value: i, next: move head))
        i = i + 1
    }
    n
}

fn leftSpine(n: i64): i64 = {
    var tree = own Tree::Leaf
    var i = 0
    while i < n {
        tree = own Tree::Node(value: i, left: move tree, right: own Tree::Leaf)
        i = i + 1
    }
    n
}

fn main(): i64 = {
    io::printInt(list(1000000))
    io::printInt(links(1000000))
    io::printInt(leftSpine(1000000))
    0
}
