// Compound assignment: `place op= value` is `place = place op value`, with the
// place found once, then its old value read, then the value computed.
//
// Expected output:
// - 7, 3, 20, 5 and 1 (`+=` `-=` `*=` `/=` `%=` on an `i64`);
// - 12, 14, 6, 48 and 3 (`&=` `|=` `^=` `<<=` `>>=`);
// - 5 (a `u8` that wraps, as `+%=` says it may), and 2 as
//   an `f64` times 100 (`+=` `*=` `/=`);
// - 11 (a field through `own`), 5 (a `&var` parameter);
// - 0 then 1 (the place's index, then the value), 1 (`next` called once),
//   and 40 (the element it chose);
// - 1 (the projection ran once) and 9 (the place it lent);
// - 10 (the index is read once, before the value changes it);
// - 6 (`=` may still take the target itself), and every allocation freed.

import std::io

struct Point {
    x: i64
    y: i64
}

struct Grid {
    cells: [i64; 4]
    lends: i64
}

struct Stack {
    items: own<[i64]>
    size: i64
}

fn say(n: i64): i64 = {
    io::printInt(n)
    n
}

fn next(calls: &var i64): i64 = {
    calls += 1
    2
}

fn addFive(n: &var i64) = n += 5

fn at(grid: &var Grid, i: i64): &var i64 = {
    grid.lends += 1
    lend grid.cells[i]
}

fn push(stack: Stack, value: i64): Stack = {
    var s = move stack
    s.items[s.size] = value
    s.size += 1
    move s
}

fn main() = {
    var a = 5
    a += 2
    io::printInt(a)
    a -= 4
    io::printInt(a)
    a *= 7 - 3 + 1
    io::printInt(a * 4 / 3)
    a /= 3
    io::printInt(a)
    a %= 4
    io::printInt(a)

    var bits = 14
    bits &= 12
    io::printInt(bits)
    bits |= 2
    io::printInt(bits)
    bits ^= 8
    io::printInt(bits)
    bits <<= 3
    io::printInt(bits)
    bits >>= 4
    io::printInt(bits)

    var small: u8 = 250
    small +%= 11 as u8
    io::printInt(small as i64)
    var f = 0.5
    f += 0.5
    f *= 4.0
    f /= 2.0
    io::printInt((f * 100.0) as i64)

    var p = own Point(x: 1, y: 2)
    p.x += 10
    io::printInt(p.x)
    var n = 0
    addFive(&var n)
    io::printInt(n)

    var xs = [10, 20, 40, 80]
    xs[say(0)] += say(1)
    var calls = 0
    xs[next(&var calls)] *= 2
    io::printInt(calls)
    io::printInt(xs[2] / 2)

    var grid = Grid(cells: [0, 0, 0, 0], lends: 0)
    at(&var grid, 3) += 9
    io::printInt(grid.lends)
    io::printInt(grid.cells[3])

    var i = 0
    xs[i] += {
        i = 3
        0
    }
    io::printInt(xs[0] - 1)

    var stack = Stack(items: own [0; 8], size: 0)
    var k = 0
    while k < 6 {
        stack = push(move stack, k)
        k += 1
    }
    io::printInt(stack.size)
}
