// A C call's value passed where a `&` is taken is lent for the call, as
// any temporary is — a call to a C function that takes
// more than it declares too, whose arguments were once checked in a way
// that made the argument around it forget it was one.

extern "C" {
    fn abs(x: c_int): c_int
    fn printf(format: cstring, ...): c_int
}

fn shown(x: &c_int): c_int = x

fn main() = {
    assert(shown(abs(-3)) == 3)
    val written = shown(printf("seven: %d\n", 7 as c_int))
    assert(written == 9)
}
