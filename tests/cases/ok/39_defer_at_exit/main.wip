// A deferred expression runs, whole, where its block exits.
// It sees the values its variables have there, makes its moves there, and may
// assign to variables declared outside it.
//
// Expected output:
//   1, 2, 3                  `live`: `i` at the end of each iteration
//   0, 1, 2                  `snapshot`: a copy taken with `val`
//   1, 0                     `nesting`: a `defer` restores the counter
//   committed, rolled back   `transaction`: a flag read at the exit
//   alloc #1, 7, consumed, free #1
//                            `consumeAtExit`: `c` is usable until the end
//   alloc #2, free #2        `maybeConsume`: not moved, so dropped after
//   nested: body, nested: outer defer, nested: inner defer
//   value: computing, value: after the result, 7

import std::io

extern "C" {
    fn wip_trace_allocs()
}

struct Counter {
    hits: i64
}

fn show(c: &Counter) = io::printInt(c.hits)

fn consume(c: own<Counter>) = io::println("consumed")

fn live() = {
    var i = 0
    while i < 3 {
        defer io::printInt(i)
        i = i + 1
    }
}

fn snapshot() = {
    var i = 0
    while i < 3 {
        val start = i
        defer io::printInt(start)
        i = i + 1
    }
}

fn nesting() = {
    var depth = 0
    {
        depth = depth + 1
        defer depth = depth - 1
        io::printInt(depth)
    }
    io::printInt(depth)
}

fn transaction(fail: bool) = {
    var committed = false
    defer if !committed { io::println("rolled back") }
    if fail {
        return
    }
    committed = true
    io::println("committed")
}

fn consumeAtExit() = {
    val c = own Counter(hits: 7)
    defer consume(move c)
    show(&c)
}

fn maybeConsume(flag: bool) = {
    val c = own Counter(hits: 1)
    defer if flag { consume(move c) }
}

fn nested() = {
    defer {
        defer io::println("nested: inner defer")
        io::println("nested: outer defer")
    }
    io::println("nested: body")
}

fn result(): i64 = {
    io::println("value: computing")
    7
}

fn value(): i64 = {
    defer io::println("value: after the result")
    result()
}

fn main(): i64 = {
    wip_trace_allocs()
    live()
    snapshot()
    nesting()
    transaction(false)
    transaction(true)
    consumeAtExit()
    maybeConsume(false)
    nested()
    io::printInt(value())
    0
}
