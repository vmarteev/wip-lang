// Mutating fields of a `var` struct. `val` bindings cannot be assigned.

import std::io

struct Counter {
    hits: i64
    misses: i64
}

fn main(): i64 = {
    var c = Counter(hits: 0, misses: 0)
    var i = 0
    while i < 5 {
        if i % 2 == 0 {
            c.hits = c.hits + 1
        } else {
            c.misses = c.misses + 1
        }
        i = i + 1
    }
    io::printInt(c.hits)   // 3
    io::printInt(c.misses) // 2
    0
}
