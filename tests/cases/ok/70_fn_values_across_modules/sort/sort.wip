// Generic code that takes behaviour as a function value.

pub fn largest<T: copy>(xs: &[T], less: (a: &T, b: &T) => bool): T = {
    var best = xs[0]
    for x in xs {
        if less(&best, &x) {
            best = x
        }
    }
    best
}

pub fn byValue<T: copy>(a: &T, b: &T): bool = weight(&a) < weight(&b)

fn weight<T: copy>(x: &T): i64 = 1

pub fn ascending(a: &i64, b: &i64): bool = a < b
