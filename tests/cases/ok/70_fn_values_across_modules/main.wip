// Function values across modules: a function of another
// module, named or imported, passed to a generic function of that module,
// and a generic function named as a value with its type arguments written.
//
// Expected output: 9, 9, 5, 7.

import std::io

import sort::{largest, ascending, byValue}

fn main(): i64 = {
    io::printInt(largest([3, 9, 4], ascending))
    io::printInt(largest([3, 9, 4], sort::ascending))
    io::printInt(largest([5, 6], byValue<i64>))
    val chosen = byValue<i64>
    io::printInt(largest([7, 8], chosen))
    0
}
