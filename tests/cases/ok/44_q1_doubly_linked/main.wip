// A doubly linked list. Each node would need two
// owners, the node before it and the node after it (err/49), or references
// stored in the nodes (E0410). The workaround is the arena again: nodes in an
// array, linked by index, with removed slots kept on a free list. Nothing
// stops an index from outliving its node: `two` below names a slot that is
// reused after `remove`.
//
// Expected output: 1 3 4 forwards, then 4 3 1 backwards.

import std::io

struct Node {
    value: i64
    prev: i64
    next: i64
}

struct List {
    nodes: [Node; 8]
    head: i64
    tail: i64
    free: i64 // the first free slot; free slots are linked through `next`
}

fn newList(): List = {
    val unused = Node(value: 0, prev: -1, next: -1)
    var list = List(nodes: [unused; 8], head: -1, tail: -1, free: 0)
    var i = 0
    while i < list.nodes.len() {
        list.nodes[i].next = if i < list.nodes.len() - 1 { i + 1 } else { -1 }
        i = i + 1
    }
    list
}

fn pushBack(list: &var List, value: i64): i64 = {
    val id = list.free
    list.free = list.nodes[id].next
    list.nodes[id] = Node(value: value, prev: list.tail, next: -1)
    if list.tail >= 0 {
        list.nodes[list.tail].next = id
    } else {
        list.head = id
    }
    list.tail = id
    id
}

fn remove(list: &var List, id: i64) = {
    val node = list.nodes[id]
    if node.prev >= 0 {
        list.nodes[node.prev].next = node.next
    } else {
        list.head = node.next
    }
    if node.next >= 0 {
        list.nodes[node.next].prev = node.prev
    } else {
        list.tail = node.prev
    }
    list.nodes[id].next = list.free
    list.free = id
}

fn printForwards(list: &List) = {
    var at = list.head
    while at >= 0 {
        io::printInt(list.nodes[at].value)
        at = list.nodes[at].next
    }
}

fn printBackwards(list: &List) = {
    var at = list.tail
    while at >= 0 {
        io::printInt(list.nodes[at].value)
        at = list.nodes[at].prev
    }
}

fn main(): i64 = {
    var list = newList()
    pushBack(&var list, 1)
    val two = pushBack(&var list, 2)
    pushBack(&var list, 3)
    remove(&var list, two)
    pushBack(&var list, 4)
    printForwards(&list)
    printBackwards(&list)
    0
}
