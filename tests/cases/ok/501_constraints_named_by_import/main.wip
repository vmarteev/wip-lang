// A struct's, an enum's and an interface's type parameters may be
// constrained by an interface the file imports by name, and given a type it
// imports, as a function's may: `S: Shelf` and `L: Labelled<Tag>` name what
// `import shelf::{…}` brought in.
//
// Expected output:
// 3
// 4
// 7
// 9

import std::io
import shelf::{Labelled, Shelf, Tag}

struct Held<S: Shelf> {
    book: S::Book
}

enum Found<S: Shelf> {
    Book(book: S::Book)
    Nothing
}

struct Tagged<L: Labelled<Tag>> {
    item: L
}

interface Counted<S: Shelf> {
    fn count(shelf: &S): i64
}

struct Range {
    from: i64
}

extend Range: Shelf<i64> {
    fn first(): i64 = self.from
}

struct Box {
    id: i64
}

extend Box: Labelled<Tag> {
    fn label(): Tag = Tag(id: self.id)
}

struct Counter

extend Counter: Counted<Range> {
    fn count(shelf: &Range): i64 = shelf.first() + 6
}

fn main() = {
    val held: Held<Range> = Held(book: Range(from: 3).first())
    io::println("\(held.book)")
    val found: Found<Range> = .Book(4)
    if found is .Book(book) then io::println("\(book)")
    val tagged = Tagged(item: Box(id: 7))
    io::println("\(tagged.item.label().id)")
    io::println("\(Counter().count(Range(from: 3)))")
}
