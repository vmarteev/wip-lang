// A `&T` passes through `?`, a method's receiver and a walk as the value
// it is, and what it borrows is what it points into: here, the document
// the caller keeps.

import std::io
import std::json
import std::json::{Json}

/// The kind of a node, through two `?`s and a method of what they answer.
fn kind(node: &Json): Option<str> = node.get("kind")?.asText()

/// The same, with the reference kept in a variable on the way.
fn name(node: &Json): Option<str> = {
	val name = node.get("name")?
	return name.asText()
}

/// The nodes inside `node` of one kind, as references into it.
fn children(node: &Json, wanted: str): Vec<&Json> = {
	var found: Vec<&Json> = Vec()
	if node.get("inner").flatMap((inner) => inner.asArray()) is .Some(nodes) {
		for child in nodes.items() {
			if kind(child) == .Some(wanted) {
				found.push(child)
			}
		}
	}
	return move found
}

fn main() = {
	val text = "{\"kind\": \"Unit\", \"inner\": [{\"kind\": \"Fn\", \"name\": \"f\"}, {\"kind\": \"Var\"}, {\"kind\": \"Fn\", \"name\": \"g\"}]}"
	val .Ok(document) = json::parse(text) else {
		return
	}
	io::println("\(kind(&document)) \(name(&document))")
	for function in children(&document, "Fn") {
		io::println("\(name(function))")
	}
}
