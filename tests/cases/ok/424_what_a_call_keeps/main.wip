// What a call keeps is what its signature says. A view's `var fn` given
// text it only reads keeps nothing of it, so the text may end while the
// view goes on; a method that keeps says `keeps`, and so does a function
// that fills a table it is given; `keeps` after `from`; and an interface
// whose method keeps, implemented by one type that keeps and one that
// keeps nothing.
//
// Expected output: `ab|cd|kept: x, y|longer|2|z`.

import std::io
import std::mem

view struct Printer {
	src: str
	out: String
}

extend Printer {
	var fn line(text: str) = {
		self.out.push(text)
		self.out.push("|")
	}
}

/// Words, kept as they are given.
view struct Words {
	words: Vec<str>
}

extend Words {
	var fn add(word: str) keeps word = self.words.push(word)
}

/// Fills `into` with the words of `text`, which what it keeps borrows.
fn split(text: str, into: &var Vec<str>) keeps text = {
	for word in text.split(" ") {
		into.push(word)
	}
}

/// The longer of two texts, kept in `into` as well.
fn longer(a: str, b: str, into: &var Vec<str>): str from a, b keeps a, b = {
	val chosen = if a.len() >= b.len() then a else b
	into.push(chosen)
	return chosen
}

interface Collect {
	var fn collect(text: str) keeps text
}

view struct All {
	texts: Vec<str>
}

extend All: Collect {
	var fn collect(text: str) keeps text = self.texts.push(text)
}

struct Count {
	count: i64
}

extend Count: Collect {
	var fn collect(text: str) = {
		self.count += 1
	}
}

fn main() = {
	val source = String::of("ab cd")
	var printer = Printer(src: source.toStr(), out: String())
	for word in source.toStr().split(" ") {
		// A text that ends with each turn, which `line` only reads.
		val text = String::of(word)
		printer.line(text.toStr())
	}

	val given = String::of("x y")
	var words = Words(words: Vec())
	var parts: Vec<str> = Vec()
	split(given.toStr(), &var parts)
	for part in parts {
		words.add(part)
	}

	var chosen: Vec<str> = Vec()
	val first = String::of("longer")
	val second = String::of("short")
	val answer = longer(first.toStr(), second.toStr(), &var chosen)

	var all = All(texts: Vec())
	var count = Count(count: 0)
	val z = String::of("z")
	all.collect(z.toStr())
	count.collect(z.toStr())
	count.collect(z.toStr())

	var slot: Option<str> = .None
	mem::replace(&var slot, .Some(all.texts[0]))
	val last = slot.unwrapOr("")
	io::println("\(printer.out)kept: \(words.words.join(", "))|\(answer)|\(count.count)|\(last)")
}
