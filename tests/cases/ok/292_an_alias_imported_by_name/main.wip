// A type alias another module exports is imported by name, as a struct is;
// the import once found only structs and enums. The alias
// names an arena's handle whose second type is that module's, which is how
// a program's lower layer names what its upper layer keeps.
//
// Expected output: 3, then 1.

import std::io
import std::collections::{Arena}
import shapes::{Corner, Corners, Pair, sum}

fn main() = {
	val pair: Pair<i64> = (1, 2)
	io::printInt(sum(pair))
	var corners: Arena<str, Corners> = Arena()
	val first: Corner = corners.add("north-east")
	io::printInt(corners.len())
	assert(corners[first] == "north-east")
}
