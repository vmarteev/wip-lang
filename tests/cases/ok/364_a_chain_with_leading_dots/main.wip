// A `.` at the start of a line continues the expression above it, as Swift's
// and Kotlin's do: a method, a field, a `?` after one, a chain as a binding's
// value, a `return`'s and an argument's. In a `match`, a line that reads as
// a pattern before `=>` is the next arm, not a chain on the arm above it;
// and a `.` first in a block, or after a loop, is a variant, as before.
//
// Expected output: 4 3 HELLO 9 6 1 2

import std::io

struct Point {
    x: i64
    y: i64
}

fn count(xs: &[i64]): i64 = xs
    .forwards()
    .filter((x) => x > 1)
    .count()

fn shout(text: str): String = {
    return text
        .trim()
        .toUppercase()
}

fn parsed(text: str): Option<i64> = {
    val n = text
        .trim()
        .toInt()
        .toOption()?
    return .Some(n * 3)
}

fn kind(n: Option<i64>): i64 = match n {
    .Some(v) => v
        .abs()
        .max(1)
    .None => 0
}

fn first(): Option<i64> = {
    .Some(1)
}

fn afterLoop(): Option<i64> = {
    var total = 0
    for i in 0..3 {
        total += i
    }
    .Some(total - 1)
}

fn main() = {
    val p = Point(x: 3, y: 4)
    val sum = p
        .x
    io::println("\(count([1, 2, 3, 4]) + 1) \(sum) \(shout(" hello ")) \(parsed(" 3 ").unwrapOr(0)) \(kind(.Some(-6))) \(first().unwrapOr(0)) \(afterLoop().unwrapOr(0))")
}
