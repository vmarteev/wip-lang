// What a call's answer borrows is decided by the types in the callee's
// signature: an argument whose type cannot hold what the answer refers to
// is not borrowed.

import std::io

struct Node {
    called: String
    size: i64
}

struct Tree {
    nodes: Vec<Node>
}

/// A node found in a tree, by reference.
view struct Found {
    node: &Node
}

extend Tree {
    /// The node called `key`. The answer refers to a `Node`, which a `str`
    /// cannot hold, so it borrows the tree and not the key.
    fn find(key: str): Option<Found> = {
        for i in 0..self.nodes.len() {
            if self.nodes[i].called == key {
                return .Some(Found(node: &self.nodes[i]))
            }
        }
        return .None
    }
}

/// A view whose bytes are its own: what it answers points into it, and
/// borrows the variable that holds it.
view struct Short {
    bytes: [u8; 4]
    length: i64
}

extend Short {
    fn text(): str = str::fromBytes(&self.bytes[0..self.length])
}

interface Named {
    fn name(): str
}

extend Node: Named {
    fn name(): str = self.called.toStr()
}

/// What `T`'s `name()` answers may point into `T` itself, so it borrows
/// `who`.
fn nameOf<T: Named>(who: &T): str = who.name()

fn main() = {
    var nodes: Vec<Node> = Vec()
    nodes.push(Node(called: String::of("a"), size: 1))
    nodes.push(Node(called: String::of("b"), size: 2))
    val tree = Tree(nodes: move nodes)

    // The key changes while the answer is used: the answer does not
    // borrow it.
    var key = String::of("b")
    val found = tree.find(key.toStr())
    key.clear()
    key.push("a")
    match found {
        .Some(f) => io::println("\(f.node.called) is \(f.node.size)")
        .None => io::println("not there")
    }

    var short = Short(bytes: ['h' as u8, 'i' as u8, 0, 0], length: 2)
    val text = short.text()
    io::println(text)
    short.length = 1
    io::println(short.text())

    io::println(nameOf(&tree.nodes[0]))
}
