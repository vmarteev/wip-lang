// A top-level assert whose condition holds a lambda, passed to a function
// and called while the program is compiled, as a constant's value may
// hold one: each file's asserts are checked with the lambdas it declares.
//
// Expected output: 6

import std::io

fn apply(f: &(x: i64) => i64, x: i64): i64 = f(x)

assert(apply((x) => x * 2, 3) == 6)
assert(((x: i64) => x + 1)(1) == 2)

fn main() = {
	io::printInt(apply((x) => x * 2, 3))
}
