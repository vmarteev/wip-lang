// `become f(x)` leaves the function and calls `f` in its place, so calls
// that end in each other a million deep use one frame: two functions, two
// methods, a generic function's instances, a struct answered through the
// place the first caller gave, a `str` parameter passed on, and a constant
// worked out while the program is compiled.
//
// Expected output:
// true false
// -3
// 2.5 7
// 1 2 0
// 4
// true

import std::io

fn isEven(n: u64): bool = {
    if n == 0 then return true
    become isOdd(n - 1)
}

fn isOdd(n: u64): bool = {
    if n == 0 then return false
    become isEven(n - 1)
}

struct Walker {
    steps: i64
}

extend Walker {
    fn left(n: i64): i64 = {
        if n == 0 then return self.steps
        become self.right(n - 1)
    }

    fn right(n: i64): i64 = {
        if n == 0 then return -self.steps
        become self.left(n - 1)
    }
}

fn ping<T: copy>(value: T, n: i64): T = {
    if n == 0 then return value
    become pong(value, n - 1)
}

fn pong<T: copy>(value: T, n: i64): T = {
    if n == 0 then return value
    become ping(value, n - 1)
}

struct Big {
    a: i64
    b: i64
    c: i64
}

fn bigPing(seed: Big, n: i64): Big = {
    if n == 0 then return Big(a: seed.a, b: seed.b, c: n)
    become bigPong(seed, n - 1)
}

fn bigPong(seed: Big, n: i64): Big = {
    if n == 0 then return Big(a: seed.c, b: seed.b, c: n)
    become bigPing(seed, n - 1)
}

// A state machine whose states are functions.
fn inSpace(text: str, at: i64, words: i64): i64 = {
    if at == text.len() then return words
    if text[at] == b' ' then become inSpace(text, at + 1, words)
    become inWord(text, at + 1, words + 1)
}

fn inWord(text: str, at: i64, words: i64): i64 = {
    if at == text.len() then return words
    if text[at] == b' ' then become inSpace(text, at + 1, words)
    become inWord(text, at + 1, words)
}

@comptime
val EVEN = isEven(100_000)

fn main() = {
    io::println("\(isEven(1_000_000)) \(isOdd(1_000_000))")
    val walker = Walker(steps: 3)
    io::println("\(walker.left(1_000_001))")
    io::println("\(ping(2.5, 1_000_000)) \(ping(7, 3))")
    val big = bigPing(Big(a: 1, b: 2, c: 3), 1_000_000)
    io::println("\(big.a) \(big.b) \(big.c)")
    io::println("\(inSpace("the quick  brown fox", 0, 0))")
    io::println("\(EVEN)")
}
