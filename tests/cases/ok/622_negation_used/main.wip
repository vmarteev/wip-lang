// A negation whose value is used stays as it is: a block's last
// expression, a `return`, a `val`'s value after the `=` on the next line,
// and a subtraction whose `-` ends the line.
//
// Expected output:
// -5
// -7
// -9
// 2

import std::io

fn negated(x: i64): i64 = {
    val y = x + 2
    -y
}

fn opposite(x: i64): i64 = {
    if x == 0 then return 0
    return -x
}

fn main() = {
    val a = negated(3)
    val b = opposite(7)
    val c =
        -9
    val d = 10 -
        8
    io::printInt(a)
    io::printInt(b)
    io::printInt(c)
    io::printInt(d)
}
