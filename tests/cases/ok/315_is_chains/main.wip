// An `is` test binds for the rest of its `&&` chain, wherever the chain is:
// a function's value, a `val`, an argument, a chain under
// `||` or `!`. What a test binds is dropped where the chain ends, and the
// place it binds into is free again after it.

import std::io

enum Address {
    V4(octets: [u8; 4], port: u16)
    Unix(path: String)
}

/// One test of each pair, as a value: ports aside, are they one place?
fn same(a: &Address, b: &Address): bool =
    (a is .V4(octets: x, ..) && b is .V4(octets: y, ..) && x == y) ||
    (a is .Unix(path: p) && b is .Unix(path: q) && p == q)

/// A binding that owns what it holds, dropped with the chain.
fn named(slot: Option<String>): bool = slot is .Some(name) && name.len() > 3

fn main() = {
    val a = Address::V4(octets: [127, 0, 0, 1], port: 80)
    val b = Address::V4(octets: [127, 0, 0, 1], port: 8080)
    val c = Address::Unix(path: String::of("/run/quark.sock"))
    io::println("\(same(&a, &b)) \(same(&a, &c)) \(same(&c, &c))")

    val parsed = "42".toInt()
    assert(parsed is .Ok(n) && n == 42, "an argument")
    val big = parsed is .Ok(n) && n > 40
    val small = !(parsed is .Ok(n) && n > 50)
    io::println("\(big) \(small)")

    io::println("\(named(.Some(String::of("quark")))) \(named(.Some(String::of("wip")))) \(named(.None))")

    // A test on a place binds into it until the chain ends; after it, the
    // place may be written.
    var slot: Option<String> = .Some(String::of("job"))
    val long = slot is .Some(job) && job.len() > 2
    slot = .None
    io::println("\(long) \(slot.isNone())")

    // A chain inside a condition's `||` binds for itself, not the block.
    var counted = 0
    for i in 0..6 {
        val text = String::of("item \(i)")
        val boxed: Option<String> = .Some(move text)
        if (move boxed is .Some(t) && t.len() > 5) || i == 0 {
            counted += 1
        }
    }
    io::println("\(counted)")
}
