// A struct whose layout Wip does not work out. `config.h`
// declares it with bitfields:
//
//     struct Config {
//         unsigned mode : 3;
//         unsigned level : 5;
//         const char *name;
//     };
//
// Where those bits are is C's business — the order within the unit, and
// whether a field may straddle one, differ between ABIs — so Wip declares
// the fields, promises nothing about where they live, and reads and writes
// each one through C:
//
//     uint32_t wip_shim_99(struct Config *a0) { return a0->mode; }
//     void wip_shim_100(struct Config *a0, uint32_t a1) { a0->mode = a1; }
//
// So bitfields need no syntax of their own. `@opaque` also covers the other
// layouts Wip does not model, and it is why a `Config` is only ever behind
// a `ptr<Config>`: nothing here knows how large one is.
//
// Expected output: what C put in the struct it made, then what Wip wrote
// back into it, including a field that was read, added to and written.

import std::io

@header("config.h")
@opaque
extern struct Config {
    mode: c_uint,
    level: c_uint,
    name: cstring
}

@header("config.h")
extern "C" {
    fn config_new(): ptr<Config>
    fn config_free(c: ptr<Config>)
}

fn main() = {
    val config = config_new()
    io::println("mode \(config.mode), level \(config.level), name \(config.name.toStr())")

    config.mode = 5 as c_uint
    config.level += 1 as c_uint
    io::println("now mode \(config.mode), level \(config.level)")

    config_free(config)
}
