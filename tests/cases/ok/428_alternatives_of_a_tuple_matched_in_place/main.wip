// An arm's alternatives on a tuple matched where its elements are: each is
// tried on the elements in turn, the arm binds from whichever matched, and
// a value none of them matches goes on to the next arm. A name may be
// bound from one element in one alternative and another in the next, and
// an owned value taken by a binding is the arm's.
//
// Expected output: `same 20|same 5|apart|none|left 7|right 9|neither|ab|bc|other`.

import std::io

enum Kind {
	Own(inner: i64)
	Slice(elem: i64)
	Unit
}

fn kindOf(n: i64): Kind = if n > 10 then .Own(n) else if n > 0 then .Slice(n) else .Unit

/// Alternatives that bind, each from both elements.
fn same(x: i64, y: i64): String = match (kindOf(x), kindOf(y)) {
	(.Own(inner: a), .Own(inner: b)) | (.Slice(elem: a), .Slice(elem: b)) if a == b => "same \(a)"
	(.Unit, .Unit) => String::of("none")
	_ => String::of("apart")
}

/// One name, bound from the left element in one alternative and the right
/// in the other.
fn side(x: Option<i64>, y: Option<i64>): String = match (x, y) {
	(.Some(n), .None) => "left \(n)"
	(.None, .Some(n)) | (.Some(_), .Some(n)) => "right \(n)"
	(.None, .None) => String::of("neither")
}

/// Alternatives that bind nothing, and owned text taken by a binding.
fn pair(a: str, b: str): String = match (String::of(a), String::of(b)) {
	("a", "b") | ("b", "a") => String::of("ab")
	(first, "c") | ("c", first) => "\(first)c"
	_ => String::of("other")
}

fn main() = {
	val seen = [
		same(20, 20),
		same(5, 5),
		same(5, 20),
		same(-1, -1),
		side(.Some(7), .None),
		side(.Some(1), .Some(9)),
		side(.None, .None),
		pair("b", "a"),
		pair("c", "b"),
		pair("a", "a"),
	]
	var out = String()
	for (i, s) in seen.forwards().enumerate() {
		if i > 0 then out.push("|")
		out.push(s.toStr())
	}
	io::println(out.toStr())
}
