// Iterating over a collection of `own` values. An
// iterator object would have to hold a reference to the collection, which a
// struct cannot (E0410, err/48), and `next` could not return a reference to
// the current item. The workarounds:
// - an index loop inside a function that borrows the collection (`total`);
// - a cursor that holds only a position and is given the collection again on
//   every call, copying out what it finds (`next`);
// - returning an index instead of a reference to the item (`heaviest`), and
//   indexing again.
// Wip has no growable vector or generics yet, so the collection is an array.
//
// Expected output: 16, 9, 8 (the heaviest item after lightening it), 15.

import std::io

struct Item {
    weight: i64
}

struct Bag {
    items: [own<Item>; 3]
}

struct Cursor {
    at: i64
}

fn total(bag: &Bag): i64 = {
    var sum = 0
    var i = 0
    while i < bag.items.len() {
        sum = sum + bag.items[i].weight
        i = i + 1
    }
    sum
}

fn next(cursor: &var Cursor, bag: &Bag, weight: &var i64): bool = {
    if cursor.at >= bag.items.len() {
        return false
    }
    weight = bag.items[cursor.at].weight
    cursor.at = cursor.at + 1
    true
}

fn heaviest(bag: &Bag): i64 = {
    var cursor = Cursor(at: 0)
    var weight = 0
    var best = 0
    var bestAt = 0
    while next(&var cursor, &bag, &var weight) {
        if weight > best {
            best = weight
            bestAt = cursor.at - 1
        }
    }
    bestAt
}

fn lighten(bag: &var Bag, i: i64) = {
    bag.items[i].weight = bag.items[i].weight - 1
}

fn main(): i64 = {
    var bag = Bag(items: [own Item(weight: 5), own Item(weight: 9), own Item(weight: 2)])
    io::printInt(total(&bag))
    io::printInt(bag.items[heaviest(&bag)].weight)
    lighten(&var bag, heaviest(&bag))
    io::printInt(bag.items[heaviest(&bag)].weight)
    io::printInt(total(&bag))
    0
}
