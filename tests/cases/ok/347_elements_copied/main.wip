// Elements copied at once: a range of a buffer made the
// elements of another with `copyFrom`, as a method's receiver, lent where
// it is written; a vector given many at the end with `pushAll`; a
// `String` given bytes, through it; and nothing copied into nothing.
//
// Expected output: "0 7 8 9 0 | 13 3 4 | abcd | 0".

import std::io

fn main() = {
    var window = own [0 as u8; 5]
    val block: [u8; 3] = [7, 8, 9]
    window[1..4].copyFrom(&block)
    var list: Vec<u16> = Vec()
    list.pushAll([1 as u16, 2, 3])
    list.pushAll([4 as u16; 10])
    var text = String::of("ab")
    text.pushBytes(&"cd".items())
    var none: Vec<i64> = Vec()
    none.pushAll([0 as i64; 0])
    window[0..0].copyFrom(&block[0..0])
    io::println("\(window[0]) \(window[1]) \(window[2]) \(window[3]) \(window[4]) | \(list.len()) \(list[2]) \(list[12]) | \(text) | \(none.len())")
}
