// A binding a pattern made, moved away on one path and not on the other, is
// dropped where it was not moved. A `String` cleans up after itself rather than
// being zeroed as an `own` is, so a flag says whether it still holds its value;
// the binding's flag was never set, and a binding that stayed was never
// dropped: one allocation leaked per `return .Err(.Unsupported(path: move
// path))` not taken. The case runs with the leak check on.
//
// Expected output: each shape once with the move and once without.

import std::io

enum Found {
    Entry(path: String, size: i64),
    Nothing,
}

// Moved by a `return` in a match arm.
fn returned(found: Found, stop: bool): Result<i64, String> = {
    match move found {
        .Entry(path, size) => {
            if stop {
                return .Err(move path)
            }
            return .Ok(size)
        }
        .Nothing => .Ok(0)
    }
}

// Moved as the arm's value, on one branch.
fn branched(found: Found, keep: bool): Option<String> = match move found {
    .Entry(path, ..) => if keep { .Some(move path) } else { .None }
    .Nothing => .None
}

// Bound by `val … else`, and moved by a `return`.
fn bound(found: Found, stop: bool): Result<i64, String> = {
    val .Entry(path, size) = move found else { return .Ok(0) }
    if stop {
        return .Err(move path)
    }
    .Ok(size)
}

fn entry(): Found = .Entry(path: String::of("notes.txt"), size: 3)

fn main() = {
    io::println("returned: \(returned(entry(), true).isErr()) \(returned(entry(), false).isOk())")
    io::println("branched: \(branched(entry(), true).isSome()) \(branched(entry(), false).isSome())")
    io::println("bound: \(bound(entry(), true).isErr()) \(bound(entry(), false).isOk())")
}
