// A variant's field may say what it is when the variant is built without
// it, as a struct's field and a parameter may: a constant,
// copied in where the variant is built. `()` takes every default.
// Patterns are unchanged: a default is about building, not matching.

import std::io

struct Style {
    fg: i64 = 0,
    bold: bool = false,
}

val WIDE: i64 = 80

enum Shape {
    Circle(radius: i64 = 1),
    Rect(width: i64 = WIDE, height: i64, style: Style = Style(bold: true)),
    Point,
}

fn show(s: Shape): String = match s {
    .Circle(radius) => String::of("circle \(radius)")
    .Rect(width, height, style) => String::of("rect \(width)x\(height) bold \(style.bold), fg \(style.fg)")
    .Point => String::of("point")
}

/// A view enum's variants take defaults as any enum's do.
view enum View {
    Text(text: str, style: Style = Style()),
    Gap(lines: i64 = 1),
}

fn draw(v: View): String = match v {
    .Text(text, style) => String::of("text \(text), bold \(style.bold)")
    .Gap(lines) => String::of("gap \(lines)")
}

fn main() = {
    io::println(show(.Circle()).toStr())
    io::println(show(.Circle(5)).toStr())
    io::println(show(.Rect(height: 2)).toStr())
    io::println(show(.Rect(height: 2, width: 3)).toStr())
    io::println(show(.Rect(height: 2, style: Style(fg: 7))).toStr())
    io::println(show(Shape::Point).toStr())
    val name = String::of("title")
    io::println(draw(.Text(text: name.toStr())).toStr())
    io::println(draw(.Text(text: "loud", style: Style(bold: true))).toStr())
    io::println(draw(.Gap()).toStr())
    // A default is copied where the variant is built, so two built with
    // it are two values.
    var first = Shape::Rect(height: 1)
    first = Shape::Rect(height: 9)
    io::println(show(first).toStr())
}
