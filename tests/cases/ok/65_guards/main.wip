// Guards: `val pattern = value else { … }`.
//
// Expected output: 21 (two guards that match), -1 and -2 (each `else`
// returning), 6 (a guard's copy of a place, and a `match` that writes it), 12
// (owned bindings from a call's value and from `move`), 3 (`continue` and
// `break` in a loop), and every allocation freed.

import std::io

enum Maybe<T> {
    Some(value: T)
    None
}

struct Order {
    count: i64
    price: Maybe<i64>
}

struct Token {
    id: i64
}

fn find(id: i64): Maybe<Order> = if id > 0 {
    .Some(Order(count: id, price: if id > 1 { .Some(7) } else { .None }))
} else {
    .None
}

fn total(id: i64): i64 = {
    val .Some(order) = find(id) else {
        return -1
    }
    val .Some(price) = order.price else {
        return -2
    }
    price * order.count
}

fn token(id: i64): Maybe<own<Token>> = if id > 0 { .Some(own Token(id: id)) } else { .None }

fn owned(): i64 = {
    val .Some(first) = token(5) else {
        return 0
    }
    var second = token(7)
    val .Some(other) = move second else {
        return 0
    }
    first.id + other.id
}

fn main(): i64 = {
    io::printInt(total(3))
    io::printInt(total(-4))
    io::printInt(total(1))
    var slot: Maybe<i64> = .Some(3)
    // A `match` binding is the place itself, so this doubles what `slot`
    // holds.
    match slot {
        .Some(held) => held = held * 2
        .None => {}
    }
    // A guard's binding of plain data is a copy, so `slot` is free for the
    // rest of the block.
    val .Some(value) = slot else {
        return 1
    }
    slot = .None
    io::printInt(value)
    io::printInt(owned())
    var found = 0
    for i in 0..10 {
        val .Some(t) = token(i % 3) else {
            continue
        }
        if t.id == 2 {
            found = found + 1
        }
        if found == 3 {
            break
        }
    }
    io::printInt(found)
    0
}
