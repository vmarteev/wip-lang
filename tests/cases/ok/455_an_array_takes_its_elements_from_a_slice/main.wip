// An array written where a slice is expected takes the slice's element
// type: an empty one is a slice of nothing, numbers are of the element's
// type, and an array of slices holds the references a slice is read
// through.
//
// Expected output: "0 6 4", the sums of an empty list and of bytes; and
// "ab cd", two slices read through references.

import std::io

fn sum(bytes: &[u8]): i64 = {
    var total = 0
    for byte in bytes {
        total += byte as i64
    }
    return total
}

fn joined(parts: &[&[u8]]): String = {
    var all: Vec<String> = Vec()
    for part in parts {
        all.push(String::of(str::fromBytes(part)))
    }
    return all.join(" ")
}

fn main() = {
    io::println("\(sum([])) \(sum([1, 2, 3])) \(sum([255 / 64 + 1]))")
    val first = "ab"
    val second = "cd"
    io::println(joined([first.items(), second.items()]))
}
