// An `own<T>` implements what an `extend own<T>` block implements for a
// box, where its condition on `T` holds: a module's own interface, asked
// through a constraint, of a box and of a box in a box. A method called on
// the box is still what it holds.
//
// Expected output:
// boxed leaf a
// leaf a
// boxed boxed leaf b

import std::io

interface Describe {
	fn describe(): String
}

struct Leaf {
	name: String
}

extend Leaf: Describe {
	fn describe(): String = "leaf \(self.name)"
}

extend own<T: Describe>: Describe {
	fn describe(): String = "boxed \(self.describe())"
}

fn told<T: Describe>(x: &T): String = x.describe()

fn main() = {
	val boxed = own Leaf(name: String::of("a"))
	io::println(told(&boxed))
	io::println(boxed.describe())
	val twice = own own Leaf(name: String::of("b"))
	io::println(told(&twice))
}
