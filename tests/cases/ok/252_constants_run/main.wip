// Constants worked out by running the program's own code while it is
// compiled: a table computed in a loop, a constant derived
// through a function, one built with a `Vec` and `String`s that are gone by
// the time it is kept, a struct of other such constants, a `str` taken
// from a text, a variant, and a `char`. Each says so with `@comptime`, one
// that reads another such constant too, and each is kept once, and read
// where it is used, as a table is.
//
// Expected output: the CRC-32 of "hello" as zlib gives it (907060870),
// then 128 5 128 -5, then "b|cc", then "slow 3", then "A".

import std::io

@comptime
val CRC: [u32; 256] = crcTable()

fn crcTable(): [u32; 256] = {
    var table: [u32; 256] = [0; 256]
    for i in 0..256 {
        var c = i as u32
        for bit in 0..8 {
            c = if c & 1 != 0 { 0xEDB88320 ^ (c >> 1) } else { c >> 1 }
        }
        table[i] = c
    }
    return table
}

fn crc(bytes: &[u8]): u32 = {
    var c: u32 = 0xFFFFFFFF
    for b in bytes {
        c = CRC[((c ^ b as u32) & 0xFF) as i64] ^ (c >> 8)
    }
    return c ^ 0xFFFFFFFF
}

@comptime
val CAPACITY: i64 = nextPowerOfTwo(100)

fn nextPowerOfTwo(n: i64): i64 = {
    var p = 1
    while p < n {
        p *= 2
    }
    return p
}

@comptime
val LETTERS: i64 = {
    var words: Vec<String> = Vec()
    words.push(String::of("ab"))
    words.push(String::of("cde"))
    var total = 0
    for word in words.items() {
        total += word.len()
    }
    total
}

struct Corner {
    x: i64
    y: i64
}

@comptime
val CORNER: Corner = Corner(x: CAPACITY, y: -LETTERS)

@comptime
val PARTS: [str; 2] = splitTwo("b,cc")

fn splitTwo(text: str): [str; 2] = {
    var parts: [str; 2] = ["", ""]
    var i = 0
    for part in text.split(",") {
        parts[i] = part
        i += 1
    }
    return parts
}

enum Mode {
    Fast
    Slow(level: i64)
}

@comptime
val MODE: Mode = if CAPACITY > 100 { .Slow(level: 3) } else { .Fast }

@comptime
val LETTER: char = 'a'.toUppercase()

fn main() = {
    io::println("\(crc(&"hello".items()))")
    io::println("\(CAPACITY) \(LETTERS) \(CORNER.x) \(CORNER.y)")
    io::println("\(PARTS[0])|\(PARTS[1])")
    match MODE {
        .Slow(level) => io::println("slow \(level)")
        .Fast => io::println("fast")
    }
    io::println("\(LETTER)")
}
