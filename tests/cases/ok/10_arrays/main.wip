// Fixed-size arrays: types, list and repeat literals, indexing, element assignment.

import std::io

fn sum(xs: &[i64; 4]): i64 = {
    var total = 0
    var i = 0
    while i < 4 {
        total = total + xs[i]
        i = i + 1
    }
    total
}

fn main(): i64 = {
    val primes: [i64; 4] = [2, 3, 5, 7]
    var zeros = [0; 4]
    zeros[2] = 9
    val grid: [[i64; 2]; 2] = [[1, 2], [3, 4]]
    val empty: [i64; 0] = []
    io::printInt(sum(&primes)) // 17
    io::printInt(sum(&zeros))  // 9
    io::printInt(grid[1][0])   // 3
    0
}
