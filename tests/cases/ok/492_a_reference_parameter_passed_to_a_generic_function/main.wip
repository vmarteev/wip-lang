// A reference parameter passed on to a generic function's `&T` stands for
// what it refers to, and says what `T` is, as it is passed to any other
// function: from a parameter of a concrete type, of a type parameter, and
// of a method's. A `&var` parameter is lent for reading with `&`, as
// anywhere.
//
// Expected output: the sizes of what each passed on.

import std::c
import std::io

fn size<T: copy>(value: &T): size_t = c::sizeOf<T>()

fn ofInt(value: &i64): size_t = size(value)

fn ofAny<T: copy>(value: &T): size_t = size(value)

fn ofWritten<T: copy>(value: &var T): size_t = size(&value)

struct Measure {}

extend Measure {
    fn of<T: copy>(value: &T): size_t = size(value)
}

fn main() = {
    val n: i64 = 5
    var b: u8 = 1
    val pair: [i32; 2] = [1, 2]
    io::println("\(ofInt(&n)) \(ofAny(&pair)) \(ofWritten(&var b)) \(Measure().of(&pair))")
}
