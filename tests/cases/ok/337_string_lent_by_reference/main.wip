// A `String` is lent as a `str` where a call expects a `&str` too:
// a parameter written so, a generic `&T` with `T` text,
// and `compare`; from a variable, a field, a reference and a call.

import std::io

val ELSEWHERE = ["open", "edit", "trash"]

struct Holder {
    name: String
}

fn length(text: &str): i64 = text.len()

fn made(): String = String::of("made")

fn known(name: &String): bool = ELSEWHERE.contains(name)

fn main() = {
    val name = String::of("edit")
    val other = String::of("open")
    val held = Holder(name: String::of("trash"))
    io::println("\(ELSEWHERE.contains(name)) \(ELSEWHERE.contains(held.name)) \(known(&other))")
    io::println("\(length(name)) \(length(made())) \(name.toStr().compare(other) is .Less)")
}
