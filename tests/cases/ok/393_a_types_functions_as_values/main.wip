// A type's functions as values: a method, its receiver its first parameter,
// by `&`, by `&var` and by value; a `static fn`; a function of the prelude's
// `String`, kept and given to an iterator's `map`; a generic type's, its
// type from the expected type or an alias; and one of two implementations of
// `From`, chosen by the expected type. Each is passed or kept as a function
// of a module is.
//
// Expected output: [4, 9], then bc [a, bc], then 9, then 2, then 5, then 4,
// then 6, then 3, then 9.

import std::io

struct Shape {
	side: i64

	fn area(): i64 = self.side * self.side
	var fn grow() = {
		self.side += 1
	}
	move fn into(): i64 = self.side
	static fn square(side: i64): Shape = Shape(side: side)
}

struct Box<T> {
	value: T

	static fn of(value: T): Box<T> = Box(value: move value)
}

struct Meters {
	value: i64
}

struct Feet {
	value: i64
}

extend Meters: From<Feet> {
	static fn from(feet: Feet): Meters = Meters(value: feet.value * 3 / 10)
}

extend Meters: From<i64> {
	static fn from(value: i64): Meters = Meters(value: value)
}

type Boxes = Box<i64>

fn main() = {
	val shapes = [Shape(side: 2), Shape(side: 3)]
	io::println("\(shapes.map(Shape::area))")
	val build: (text: str) => String = String::of
	io::println("\(build("bc")) \("a bc".split(" ").map(String::of).toVec())")
	val area: (shape: &Shape) => i64 = Shape::area
	io::println("\(area(&shapes[1]))")
	val grow: (shape: &var Shape) => void = Shape::grow
	var s = Shape(side: 1)
	grow(&var s)
	io::println("\(s.side)")
	val make = Shape::square
	io::println("\(make(5).side)")
	val boxed: (value: i64) => Box<i64> = Box::of
	io::println("\(boxed(4).value)")
	val viaAlias = Boxes::of
	io::println("\(viaAlias(6).value)")
	val fromFeet: (feet: Feet) => Meters = Meters::from
	io::println("\(fromFeet(Feet(value: 10)).value)")
	val into = Shape::into
	io::println("\(into(Shape(side: 9)))")
}
