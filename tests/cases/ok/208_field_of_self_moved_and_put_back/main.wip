// A `var fn` that moves a field out of `self` and puts another back —
// `val old = move self.held; self.held = …` — dropped what the move left
// in the field before putting the new one there: a `destroy` run on
// zeros. A field moved out of what a reference refers to has a flag of
// its own now, as a field of a local does; a build that
// checks moves found it.
//
// Expected output, one a line: "took 1", "destroy 1", "swapped", "took 2",
// "destroy 2", "done", "destroy 3" — and no "destroy 0", which the
// zeros made.

import std::io

struct Loud {
    n: i64
}

extend Loud: Destroy {
    var fn destroy() = io::println("destroy \(self.n)")
}

struct Holder {
    held: Loud
}

extend Holder {
    var fn swap(n: i64) = {
        val old = move self.held
        self.held = Loud(n: n)
        io::println("took \(old.n)")
    }
}

fn main() = {
    var holder = Holder(held: Loud(n: 1))
    holder.swap(2)
    io::println("swapped")
    holder.swap(3)
    io::println("done")
}
