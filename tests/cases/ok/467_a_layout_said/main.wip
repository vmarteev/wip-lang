// What a layout can say: `@align(n)` on a field puts it at a multiple of
// `n`, as a shader's buffer lays a `vec3` and a `vec4`; on a struct it
// aligns every value of it, on the stack, in a `Vec` and in an `own`;
// `@packed` lays fields one after another with no padding, read and written
// where they lie and lent as copies; and `c::offsetOf` says where a field
// lies, which a top-level `assert` can hold the layout to.
//
// Expected output:
// uniforms 96 64 76 80
// counters 64 64
// header 7 1 1 5
// aligned true true true 4
// packed 7 16909061 18
// packed vec 2 16909061
// boxes 20 of 20

import std::c
import std::io

struct Vec3 {
	x: f32
	y: f32
	z: f32
}

struct Uniforms {
	model: [f32; 16]
	@align(16) lightDir: Vec3
	intensity: f32
	@align(16) color: [f32; 4]
}

@align(64)
struct Counters {
	done: i64
	stolen: i64
}

@packed
struct Header {
	kind: u8
	length: u32
	flags: u16
}

assert(c::offsetOf<Uniforms>("color") == 80, "where the shader reads it")

fn addressOf(counters: &var Counters): usize = c::lending(&var counters, (p) => p as usize)

fn boxesAligned(): i64 = {
	var all: Vec<own<Counters>> = Vec()
	var aligned = 0
	for i in 0..20 {
		var boxed = own Counters(done: i, stolen: 0)
		if c::lending(&var boxed.done, (p) => p as usize) % 64 == 0 then aligned += 1
		all.push(move boxed)
	}
	return aligned
}

fn main() = {
	io::println("uniforms \(c::sizeOf<Uniforms>()) \(c::offsetOf<Uniforms>("lightDir")) \(c::offsetOf<Uniforms>("intensity")) \(c::offsetOf<Uniforms>("color"))")
	io::println("counters \(c::sizeOf<Counters>()) \(c::alignOf<Counters>())")
	io::println("header \(c::sizeOf<Header>()) \(c::alignOf<Header>()) \(c::offsetOf<Header>("length")) \(c::offsetOf<Header>("flags"))")
	var local = Counters(done: 1, stolen: 2)
	val boxed = own Counters(done: 3, stolen: 4)
	var many: Vec<Counters> = Vec()
	for i in 0..5 {
		many.push(Counters(done: i, stolen: i))
	}
	var fromBox = Counters(done: boxed.done, stolen: boxed.stolen)
	io::println("aligned \(addressOf(&var local) % 64 == 0) \(addressOf(&var fromBox) % 64 == 0) \(c::pointerTo(&many.items()) as usize % 64 == 0) \(many[4].stolen)")
	var header = Header(kind: 7, length: 0x01020304, flags: 9)
	header.length += 1
	header.flags = header.flags * 2
	val copy = header
	io::println("packed \(copy.kind) \(copy.length) \(copy.flags)")
	var headers: Vec<Header> = Vec()
	headers.push(header)
	headers.push(Header(kind: 1, length: 2, flags: 3))
	io::println("packed vec \(headers[1].length) \(headers[0].length)")
	io::println("boxes \(boxesAligned()) of 20")
}
