// Every number implements the operators' interfaces and `Zero` and `One`,
// so code generic over numbers is written once: a function that totals
// any of them, `sum` and `product` on a slice and a vector, a program's own
// type that adds; and `minBy` and `maxBy`, the first of equals, on a slice,
// a vector and an iterator.
//
// Expected output: 6 0.75, then 10 24 4, then 0 1, then 4 6, then
// .Some(fig) .Some(pear) .Some(fig) .None, then -3.

import std::io

struct Vec2 {
	x: f64
	y: f64
}

extend Vec2: Add {
	fn add(other: &Vec2): Vec2 = Vec2(x: self.x + other.x, y: self.y + other.y)
}

extend Vec2: Zero {
	static fn zero(): Vec2 = Vec2(x: 0.0, y: 0.0)
}

fn total<T: Add + Zero + copy>(items: &[T]): T = {
	var sum = T::zero()
	for x in items {
		sum = sum + x
	}
	return sum
}

fn negated<T: Negate>(x: T): T = -x

fn main() = {
	val counts = [1, 2, 3]
	val weights = [0.5, 0.25]
	io::println("\(total(&counts)) \(total(&weights))")

	val numbers = [1, 2, 3, 4]
	io::println("\(numbers.sum()) \(numbers.product()) \(Vec::of(own [1.5, 2.5]).sum())")
	val none: [i64; 0] = []
	io::println("\(none.sum()) \(none.product())")
	val moves = [Vec2(x: 1.0, y: 2.0), Vec2(x: 3.0, y: 4.0)]
	val at = moves.sum()
	io::println("\(at.x) \(at.y)")

	val words = Vec::of(own [String::of("pear"), String::of("fig"), String::of("plum")])
	val shortest = words.clone().intoIterator().minBy((w) => w.len())
	val nothing: Vec<String> = Vec()
	io::println("\(words.minBy((w) => w.len())) \(words.maxBy((w) => w.len())) \(shortest) \(nothing.minBy((w) => w.len()))")
	io::println("\(negated(3))")
}
