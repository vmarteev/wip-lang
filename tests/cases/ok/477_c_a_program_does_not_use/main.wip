// A binding written from a newer version of a header than the one a
// program is built with: it declares a struct of bitfields and a function
// the header defines, neither of which the older header has. The program
// uses neither, so the C the compiler writes for it reaches neither: C is
// written only for the calls and fields a program uses, and what it does
// not use need not compile.
//
// Expected output: the field C laid out, read through C, and the value of
// a function the older header has.

import std::io

@header("older.h")
@opaque
extern struct Kept {
    flags: c_uint,
    count: c_uint
}

// What the newer header added.
@header("older.h")
@opaque
extern struct Added {
    bits: c_uint
}

@header("older.h")
extern "C" {
    fn kept_new(): ptr<Kept>
    fn kept_free(kept: ptr<Kept>)
    fn added_new(): ptr<Added>

    // A `static inline` of the newer header.
    @header("older.h")
    fn added_twice(n: c_int): c_int
}

fn main() = {
    val kept = kept_new()
    io::println("flags \(kept.flags), count \(kept.count)")
    kept_free(kept)
}
