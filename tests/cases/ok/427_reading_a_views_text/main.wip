// A view's `str` field lends as a `&` field does: its bytes are never what
// holds it. A helper answers the source's text `from self.source`, and
// what it answers stays good while the view changes — a reader stepped on,
// a note pushed — and goes bad only where the source does.
//
// Expected output: `fn main|2 notes`.

import std::io

view struct Reader {
	source: str
	at: i64
	notes: Vec<String>
}

extend Reader {
	/// The text from `lo` to `hi`: the source's, not the reader's.
	fn text(lo: i64, hi: i64): str from self.source = self.source[lo..hi]

	/// The next word, and past it.
	var fn word(): str from self.source = {
		val start = self.at
		while self.at < self.source.len() && self.source[self.at] != b' ' {
			self.at += 1
		}
		val found = self.text(start, self.at)
		self.at += 1
		self.notes.push(String::of("read"))
		return found
	}
}

fn main() = {
	val source = String::of("fn main = {}")
	var reader = Reader(source: source.toStr(), at: 0, notes: Vec())
	val first = reader.word()
	val second = reader.word()
	io::println("\(first) \(second)|\(reader.notes.len()) notes")
}
