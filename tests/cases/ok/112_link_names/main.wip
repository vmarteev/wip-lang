// `@symbol` gives a C declaration a name of Wip's own. A C library prefixes
// every name it has, since C has one namespace for the whole program; a module
// of bindings is a namespace already, so `sqlite::open` reads better than
// `sqlite::sqlite3_open`.
//
// The name only changes what the compiler writes: `add` is imported as
// `wip_case_add`, and the C the compiler writes for a wrapper calls it by
// that name too.
//
// Expected output: 5 and 41, then 42 twice — once as Wip read it back, and
// once as `printf` printed it, which is `write` here.

import std::io

extern "C" {
    @symbol("wip_case_add")
    pub fn add(a: c_int, b: c_int): c_int

    @symbol("wip_case_total")
    pub var total: c_int
}

// A name of Wip's own for a variadic function behind a header, so all
// three parts meet: the wrapper, the header and the link name.
@header("<stdio.h>")
extern "C" {
    @symbol("printf")
    fn write(fmt: cstring, ...): c_int
}

fn main() = {
    io::println("add \(add(2 as c_int, 3 as c_int)), total \(total)")
    total += 1 as c_int
    io::println("total \(total)")
    write("printf says %d\n", total)
}
