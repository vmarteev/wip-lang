// Dividing by zero panics, where the language once ended the program with
// no message at all.
//
// Expected output: 5 and -1 (the divisions that work), then the panic on
// standard error, and status 101.

import std::io

fn main() = {
    var n = 2
    io::printInt(10 / n)
    io::printInt(10 % 3 - 2)
    n = 0
    io::printInt(10 / n)
}
