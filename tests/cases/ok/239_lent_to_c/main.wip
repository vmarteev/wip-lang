// A value is lent to C as a callback's `void *`, and had back in the
// callback as what it is: C holds the address while the call that lends
// it runs, and each callback is given the `&var` for its own time.

import std::c
import std::io
import each::{each_desc, each_run}

struct Tally {
    total: i64 = 0
    seen: Vec<i64> = Vec()
}

/// What C calls with the `void *` it was given.
fn step(data: ptr<void>, n: c_int) = c::lentBack(data, (tally: &var Tally) => {
    tally.total += n as i64
    tally.seen.push(n as i64)
})

fn main() = {
    var tally = Tally()
    c::lending(&var tally, (data) => each_run(each_desc(count: 4, step: .Some(step), user_data: data)))
    io::println("total \(tally.total), seen \(tally.seen.len())")
    // What `run` answers is what `lending` does.
    val address = c::lending(&var tally, (data) => data as i64)
    io::println("\(address != 0)")
}
