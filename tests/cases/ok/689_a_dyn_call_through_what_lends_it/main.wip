// A method called through a `&dyn` that is itself reached through a
// reference: an element of a `Vec<&dyn T>`, which `at` lends, its last, a
// map's value, an element walked or mapped, and a `& &dyn T` parameter. The
// call reads the table from the `&dyn` it reaches, not from the reference
// to it.
//
// Expected output: 9, 9, 13, 4 and 9, 13, 8, 9 and 9.

import std::collections::{Map}
import std::io

interface Shape {
	fn area(): i64
}

struct Square {
	side: i64
}

extend Square: Shape {
	fn area(): i64 = self.side * self.side
}

fn twice(shape: & &dyn Shape): i64 = shape.area() * 2

fn total(shapes: &[&dyn Shape]): i64 = {
	var sum = 0
	for shape in shapes do
		sum += shape.area()

	return sum
}

fn main() = {
	val small = Square(side: 2)
	val large = Square(side: 3)
	val shapes: Vec<&dyn Shape> = [&small, &large]
	io::println("\(shapes[1].area())")
	io::println("\(shapes.atLast().area())")
	io::println("\(total(&shapes))")
	val areas = shapes.map((shape) => shape.area())
	io::println("\(areas[0]) and \(areas[1])")
	io::println("\(shapes.forwards().map((shape) => shape.area()).sum())")
	val first: &dyn Shape = shapes[0]
	io::println("\(twice(&first))")
	var named: Map<str, &dyn Shape> = Map()
	named.put("large", &large)
	val .Some(found) = named.get("large") else return
	io::println("\(named.at("large").area()) and \(found.area())")
}
