// A place read through a view's `&` field borrows what that field borrows,
// not the view: inside the view's methods it is the caller's, as a
// reference parameter's referent is, so the view may change while it is
// held — an element kept across a call that writes the view, one passed
// to such a call, a walk of the borrowed list while the view changes, and
// text answered from it by a view that owns nothing to hold text. A local
// view's field is read the same way.
//
// Expected output: `read through the reference`.

import std::io

struct Ast {
	names: Vec<String>
}

view struct Lowerer {
	ast: &Ast
	errors: Vec<String>
	seen: i64
}

extend Lowerer {
	var fn bump() = {
		self.seen += 1
	}

	var fn report(text: str) = {
		self.seen += text.len()
	}

	var fn first(): i64 = {
		val n = &self.ast.names[0]
		self.bump()
		return n.len()
	}

	var fn second() = self.report(self.ast.names[0].toStr())

	var fn third() = {
		for n in self.ast.names.items() {
			self.bump()
			self.errors.push(n.clone())
		}
	}
}

view struct Reader {
	ast: &Ast
	at: i64
}

extend Reader {
	fn text(i: i64): str = self.ast.names[i].toStr()
}

fn main() = {
	val ast = Ast(names: Vec::of(own ["ab", "c"]))
	var lowerer = Lowerer(ast: &ast, errors: Vec(), seen: 0)
	assert(lowerer.first() == 2)
	lowerer.second()
	lowerer.third()
	assert(lowerer.seen == 5 && lowerer.errors.len() == 2)
	val n = &lowerer.ast.names[1]
	lowerer.bump()
	assert(n == "c")
	val reader = Reader(ast: &ast, at: 0)
	assert(reader.text(0) == "ab")
	io::println("read through the reference")
}
