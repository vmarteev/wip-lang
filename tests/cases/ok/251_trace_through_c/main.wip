// A panic in a function C calls back: the calls go through
// C's `qsort`, and the trace goes on past it to the Wip that called C, the
// run of C's frames between being one line, `in C`. The system's unwinder
// walks them all, by the unwind information every function has.
//
// Expected output: nothing on standard output; the panic on standard error,
// from `ascending`, through C, from `sortAll` and `main`; and status 101.

extern "C" {
    fn sort_i64(values: &var [i64], compare: (a: &i64, b: &i64) => c_int)
}

fn ascending(a: &i64, b: &i64): c_int = {
    assert(a != b, "two of a kind")
    return if a < b { -1 } else { 1 }
}

fn sortAll(values: &var [i64]) = {
    sort_i64(&var values, ascending)
}

fn main() = {
    var values = [3, 1, 3]
    sortAll(&var values)
}
