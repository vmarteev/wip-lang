// A variable given a new value after a field was moved out of it: what it
// held before is dropped without that field, which its new owner ends; on
// every path, where the field was moved out on one; and where the field
// moved out is a field of a field. Each value ends once.
//
// Expected output, a line each: ended 2, replaced; held 5, ended 5, ended
// 6, replaced either; ended 16, ended 15, replaced neither; held 10, ended
// 10, ended 11, ended 9, replaced outer; and as `main` ends, ended 14, 13,
// 12, 18, 17, 8, 7, 1 and 3.

import std::io

struct Loud {
	id: i64
}

extend Loud: Destroy {
	var fn destroy() = io::println("ended \(self.id)")
}

struct Pair {
	a: Loud
	b: Loud
}

struct Outer {
	inner: Pair
	c: Loud
}

fn held(loud: Loud) = io::println("held \(loud.id)")

fn main() = {
	// The field given away, then the whole replaced: 2 ends there, 1 not.
	var pair = Pair(a: Loud(1), b: Loud(2))
	val kept = pair.a
	pair = Pair(a: Loud(3), b: kept)
	io::println("replaced")

	// Given away on one path only.
	var either = Pair(a: Loud(5), b: Loud(6))
	if pair.a.id == 3 then
		held(either.a)

	either = Pair(a: Loud(7), b: Loud(8))
	io::println("replaced either")

	// And on a path not taken, which leaves both fields to drop.
	var neither = Pair(a: Loud(15), b: Loud(16))
	if pair.a.id == 4 then
		held(neither.a)

	neither = Pair(a: Loud(17), b: Loud(18))
	io::println("replaced neither")

	// A field of a field given away.
	var outer = Outer(inner: Pair(a: Loud(9), b: Loud(10)), c: Loud(11))
	held(outer.inner.b)
	outer = Outer(inner: Pair(a: Loud(12), b: Loud(13)), c: Loud(14))
	io::println("replaced outer")
}
