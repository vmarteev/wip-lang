// What compares that did not: an array or a slice by its
// elements — equal where they are, ordered as a dictionary orders words —
// also where a generic function or a `Vec` asks for `Eq` or `Ord`; a
// pointer by where it points; and `false` before `true`.

import std::io
import std::libc::{free, malloc}

fn same<T: Eq>(a: &T, b: &T): bool = a == b

fn before<T: Ord>(a: &T, b: &T): bool = a < b

fn slices(a: &[i64], b: &[i64]): String = "\(a == b) \(a < b) \(b < a)"

fn main() = {
	val a: [i64; 3] = [1, 2, 3]
	val b: [i64; 3] = [1, 2, 4]
	io::println("arrays: \(a == b) \(a != b) \(a < b) \(a >= b)")
	io::println("slices: \(slices(&a, &b)) | \(slices(&a[0..2], &a))")

	var grid: [[i64; 2]; 2] = [[1, 2], [3, 4]]
	val other: [[i64; 2]; 2] = [[1, 2], [3, 5]]
	io::println("nested: \(grid == other) \(grid < other)")
	grid[1][1] = 5
	io::println("nested, changed: \(grid == other)")

	var pairs: Vec<[i64; 2]> = Vec()
	pairs.push([3, 4])
	pairs.push([1, 9])
	pairs.push([1, 2])
	pairs.sort()
	io::println("sorted: \(pairs[0][1]) \(pairs[1][1]) \(pairs[2][0])")
	io::println("generic: \(same(&a, &a)) \(before(&b, &a)) \(pairs.contains([1, 9]))")

	io::println("bools: \(false < true) \(true.compare(false).isMore()) \(before(true, true))")

	val p = malloc(8)
	val q: ptr<u8> = null
	io::println("pointers: \(p == q) \(p != null) \(null == q) \(p == p)")
	free(p)
}
