// A name that holds a reference stands for what it refers to, so a call
// lends it with `&`, as it lends a value of its own: a reference
// parameter, to a parameter of its type, to a slice of its elements and to
// a generic one; `self`; a name a pattern binds behind a reference; an
// element a `for` walks; and a local that keeps a slice. A closure is
// passed on by its name, as a function is.
//
// Expected output: 3 7 3 3 7 6 11

import std::io

enum Shape {
    Row(cells: Vec<i64>)
    Dot
}

struct Grid {
    cells: Vec<i64>

    fn width(): i64 = measure(&self)
}

fn measure(grid: &Grid): i64 = grid.cells.len()

fn size(values: &Vec<i64>): i64 = values.len()

fn total(values: &[i64]): i64 = {
    var sum = 0
    for value in values {
        sum += value
    }
    return sum
}

fn count<T>(values: &[T]): i64 = values.len()

fn sizeOf(values: &Vec<i64>): i64 = size(&values)

fn sumOf(values: &Vec<i64>): i64 = total(&values)

fn countOf(values: &Vec<i64>): i64 = count(&values)

fn cellsOf(shape: &Shape): i64 = match shape {
    .Row(cells) => total(&cells)
    .Dot => 0
}

fn largest(rows: &[Vec<i64>], measure: &(row: &[i64]) => i64): i64 = {
    var most = 0
    for row in rows {
        most = most.max(measure(&row))
    }
    return most
}

fn mostOf(rows: &[Vec<i64>]): i64 = largest(&rows, total)

fn keptTotal(values: &[i64]): i64 = {
    val kept = values
    return total(&kept)
}

fn main() = {
    val numbers: Vec<i64> = [1, 2, 4]
    val grid = Grid(cells: [0, 0, 0])
    val row = Shape::Row(cells: [3, 4])
    val rows: Vec<Vec<i64>> = [[1, 1], [6]]
    io::println(
        "\(sizeOf(&numbers)) \(sumOf(&numbers)) \(countOf(&numbers)) \(grid.width()) \(cellsOf(&row)) \(mostOf(&rows)) \(keptTotal([2, 9]))",
    )
}
