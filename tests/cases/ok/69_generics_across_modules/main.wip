// Generic items of another module: `Stack<T>` and the
// functions over it are used with two element types, one of which owns
// memory. A private generic function of the module is instantiated here
// too, through a public one.
//
// Expected output: 3, 3, 2, then every allocation freed.

import std::io

import stack::{Stack, empty, push, depth, count}

struct Name {
    length: i64
}

fn main(): i64 = {
    var numbers = empty<i64>()
    numbers = push(move numbers, 1)
    numbers = push(move numbers, 2)
    numbers = push(move numbers, 3)
    io::printInt(depth(&numbers))
    io::printInt(count(&numbers))
    var names: own<Stack<own<Name>>> = empty()
    names = push(move names, own Name(length: 4))
    names = push(move names, own Name(length: 5))
    io::printInt(depth(&names))
    0
}
