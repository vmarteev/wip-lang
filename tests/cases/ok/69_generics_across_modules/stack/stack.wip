// A generic stack exported by a module. The module that
// uses it makes the instances it needs.

pub enum Stack<T> {
    Push(top: T, rest: own<Stack<T>>)
    Empty
}

pub fn empty<T>(): own<Stack<T>> = own .Empty

pub fn push<T>(stack: own<Stack<T>>, value: T): own<Stack<T>> = own Stack::Push(top: move value, rest: move stack)

pub fn depth<T>(stack: &Stack<T>): i64 = match stack {
    .Push(rest, ..) => 1 + depth(&rest)
    .Empty => 0
}

// Not exported: only this module's generic functions call it.
fn countOne<T>(value: &T): i64 = 1

pub fn count<T>(stack: &Stack<T>): i64 = match stack {
    .Push(top, rest) => countOne(&top) + count(&rest)
    .Empty => 0
}
