// An array written in a constant where a slice is wanted is kept with the
// constant, and the slice points at it: a view's field, a list of lists of
// different lengths, an empty one, a constant that is a slice, an element of
// an array or a tuple, a copy of a table, a row answered by a projection and
// its list walked, a `@comptime` constant that reads the lists, and a table
// of another module.
//
// Expected output: each spec with its keys, "quit: q Q", "top: g g" and
// "none: "; "3 5 z 7", the slice constant's length, the array of slices, the
// list of lists and the tuple; "Q g g", a row answered by a projection and a
// copied table; "3 keys", worked out while compiling; and "ctrl-c", from the
// other module.

import std::io

import keys

view struct Spec {
    name: str
    keys: &[str]
}

val SPECS: [Spec; 3] = [
    Spec(name: "quit", keys: ["q", "Q"]),
    Spec(name: "top", keys: ["g g"]),
    Spec(name: "none", keys: []),
]

val WORDS: &[str] = ["a", "b", "c"]
val GRID: [&[i64]; 2] = [[1, 2], [3]]
val NESTED: &[&[str]] = [["x"], ["y", "z"]]
val PAIR: (&[u8], i64) = ([1, 2, 3], 4)
val COPY: [Spec; 3] = SPECS

fn specOf(at: i64): &Spec = lend SPECS[at]

@comptime
val COUNT: i64 = countKeys()

fn countKeys(): i64 = {
    var count = 0
    for spec in SPECS {
        count += spec.keys.len()
    }
    return count
}

fn main() = {
    for spec in SPECS {
        io::println("\(spec.name): \(spec.keys.join(" "))")
    }
    io::println("\(WORDS.len()) \(GRID[0][1] + GRID[1][0]) \(NESTED[1][1]) \(PAIR.0[2] as i64 + PAIR.1)")
    io::println("\(specOf(0).keys[1]) \(COPY[1].keys[0])")
    io::println("\(COUNT) keys")
    io::println(keys::BINDINGS[0].keys[2])
}
