// A C struct is built as C builds one: a field it is not given is zero —
// a number, a C string, a nested struct, an array, a pointer — and a
// function pointer that may be null is an `Option`, whose `.None` C reads
// as null and whose `.Some` it calls.

import std::io
import desc::{Desc, run}

fn frame() = io::println("frame called by C")

fn doubled(n: c_int): c_int = n * 2

fn main() = {
    val bare = Desc(width: 4, height: 3)
    io::println("\(run(&bare))")
    val full = Desc(width: 1, height: 2, title: "t", frame_cb: .Some(frame), event_cb: .Some(doubled))
    io::println("\(run(&full))")
    io::println("\(full.frame_cb.isSome()) \(bare.event_cb.isNone())")
}
