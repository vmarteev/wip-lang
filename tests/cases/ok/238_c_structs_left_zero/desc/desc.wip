@header("desc.h")
extern "C" {
	pub struct Inner {
		a: c_int
		b: f32
	}

	pub struct Desc {
		width: c_int
		height: c_int
		title: cstring
		frame_cb: Option<() => void>
		event_cb: Option<(a0: c_int) => c_int>
		inner: Inner
		counts: [c_int; 3]
		user: ptr<void>
	}

	pub fn run(d: &Desc): c_int
}
