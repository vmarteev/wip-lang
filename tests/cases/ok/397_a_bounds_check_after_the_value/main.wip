// An assignment's place is found after its value, and its bounds are
// checked there: against the `Vec` the value left. Here the value makes the
// `Vec` shorter, so the index the place was written with is out of bounds
// by the time it is used, and the program panics rather than write past the
// end — after the value, which has already printed.
//
// Expected output: the value ran, then a panic: index 2 is out of bounds
// for length 1.

import std::io

fn main() = {
    var v = Vec::of(own [1, 2, 3])
    v[2] = {
        v = Vec::of(own [4])
        io::println("the value ran")
        7
    }
    io::println("not reached")
}
