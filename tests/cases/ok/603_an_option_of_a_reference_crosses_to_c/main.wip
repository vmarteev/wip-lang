// An `Option` of a reference crosses to C as the pointer, with `.None` as
// null, which is how C says a struct it reads may be absent: given to C,
// and taken by a function C calls, from a pointer and from null. It is as
// large as the pointer, and so is an `Option` of a function. One C writes
// through stays a `ptr<T>`, which is given `null` or `addressOf`.
//
// Expected output:
// 6
// -1
// 3 by 4
// 1499
// 8 8 8

import std::c
import std::io

extern struct Size {
    width: i32
    height: i32
}

extern "C" {
    fn area_or(size: Option<&Size>, otherwise: i32): i32
    fn grow(size: ptr<Size>)
    fn call_wip_area(): i32
}

@export("C")
fn wip_area(size: Option<&Size>): i32 = match size {
    .Some(size) => size.width * size.height
    .None => -1
}

fn main() = {
    var size = Size(width: 2, height: 3)
    io::println("\(area_or(.Some(&size), -1))")
    io::println("\(area_or(.None, -1))")
    grow(addressOf(&var size) as ptr<Size>)
    grow(null)
    io::println("\(size.width) by \(size.height)")
    io::println("\(call_wip_area())")
    io::println("\(c::sizeOf<Option<&Size>>()) \(c::sizeOf<ptr<Size>>()) \(c::sizeOf<Option<() => void>>())")
}
