// A slice's block may say what its element must answer:
// `extend [T: Eq]` gives `indexOf` and `contains` to a slice of anything
// comparable, and `extend [T: Ord]` gives `sort`, `isSorted`, `minIndex`
// and `maxIndex`. A `Vec` has the same, through what it lends.
//
// The condition is checked where the method is called, so a slice of a
// type that answers nothing simply has no such method.
//
// Expected output: 1 and true and false (finding an element), 3 2 1 (a
// slice turned around), false then [1, 2, 3] and true (sorting), .Some(0)
// and .Some(2) (the smallest and the largest), a (a vector of strings
// searched by value), ok (a slice parameter sorted where it lies), and
// .Some(1) .None (an option written out).

import std::io

fn tidy(values: &var [i64]): bool = {
    values.sort()
    return values.isSorted()
}

fn main() = {
    var v = Vec<i64>()
    v.push(3)
    v.push(1)
    v.push(2)

    io::println("\(v.indexOf(1)) \(v.contains(3)) \(v.contains(9))")

    var n = [1, 2, 3]
    turn(&var n)
    io::println("\(n[0]) \(n[1]) \(n[2])")

    io::println("\(v.isSorted())")
    v.sort()
    io::println("\(v) \(v.isSorted())")
    io::println("\(v.minIndex()) \(v.maxIndex())")

    var words = Vec<String>()
    words.push(String::of("a"))
    words.push(String::of("b"))
    val .Some(where) = words.indexOf(String::of("a")) else {
        io::println("not there")
        return
    }
    io::println(words.at(where).toStr())

    var more = [9, 8, 7]
    io::println(if tidy(&var more) { "ok" } else { "not sorted" })

    io::println("\(v.indexOf(2)) \(v.indexOf(9))")
}

fn turn(values: &var [i64]) = values.reverse()
