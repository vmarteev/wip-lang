// A `view enum`'s variants may hold a `str`, a `&` reference or a view,
// as a `view struct`'s fields may, and the enum is kept where a `str` is.
// What a `match` binds from one borrows what it borrows.
// A tree of them, each holding the others in a `Vec`, borrows its text
// from the model it was made from — a screen's views, one frame at a time.

import std::io

/// A piece of text, as a scanner finds it.
view enum Token {
    Word(text: str),
    Number(value: i64),
    Quoted(text: str, closed: bool),
    End,
}

fn describe(token: Token): String = match token {
    .Word(text) => String::of("word \(text)")
    .Number(value) => String::of("number \(value)")
    .Quoted(text, closed) => String::of("quoted \(text), closed \(closed)")
    .End => String::of("end")
}

fn first(text: str): Token = {
    val trimmed = text.trim()
    if trimmed.isEmpty() {
        return .End
    }
    if trimmed.startsWith("\"") {
        val rest = trimmed[1..trimmed.len()]
        return match rest.find("\"") {
            .Some(at) => .Quoted(text: rest[0..at], closed: true)
            .None => .Quoted(text: rest, closed: false)
        }
    }
    match trimmed.toInt() {
        .Ok(value) => .Number(value)
        .Err(..) => .Word(trimmed)
    }
}

/// What a screen shows, borrowing from the model.
view enum View {
    Text(text: str),
    Column(children: Vec<View>),
    Titled(title: str, inside: Vec<View>),
}

struct Model {
    title: String,
    names: Vec<String>,
}

fn view(model: &Model): View = {
    var rows: Vec<View> = Vec()
    for name in model.names.items() {
        rows.push(.Text(name.toStr()))
    }
    var all: Vec<View> = Vec()
    all.push(.Titled(title: model.title.toStr(), inside: move rows))
    all.push(.Text("status"))
    View::Column(move all)
}

fn lines(view: &View, depth: i64, out: &var String) = {
    var pad = String()
    var i = 0
    while i < depth {
        pad.push("  ")
        i += 1
    }
    match view {
        .Text(text) => {
            out.push(pad.toStr())
            out.push(text)
            out.push("\n")
        }
        .Column(children) => {
            for child in children.items() {
                lines(&child, depth, &var out)
            }
        }
        .Titled(title, inside) => {
            out.push(pad.toStr())
            out.push("[\(title)]\n")
            for child in inside.items() {
                lines(&child, depth + 1, &var out)
            }
        }
    }
}

/// One child of a view enum is held in `own`, which is a view when what it
/// holds is one.
view enum Expr {
    Name(text: str),
    Neg(inner: own<Expr>),
}

fn render(e: &Expr): String = match e {
    .Name(text) => String::of(text)
    .Neg(inner) => String::of("-(\(render(&inner)))")
}

fn wordOf(token: &Token): str = match token {
    .Word(text) => text
    _ => "none"
}

/// A view enum may hold a reference, given as a parameter's is.
view enum Pick {
    One(from: &Vec<i64>, at: i64),
    Nothing,
}

fn picked(pick: Pick): i64 = match pick {
    .One(from, at) => from[at]
    .Nothing => -1
}

fn main() = {
    val source = String::of("  \"quoted text\" rest")
    io::println(describe(first(source.toStr())).toStr())
    io::println(describe(first("42")).toStr())
    io::println(describe(first("hello")).toStr())
    io::println(describe(first("\"open")).toStr())
    io::println(describe(first("   ")).toStr())

    // A binding from a view enum borrows what it borrowed, not the enum.
    val word = match first(source.toStr()) {
        .Quoted(text, ..) => text
        _ => ""
    }
    io::println(word)

    // `Option` of a view enum is a view too.
    val maybe: Option<Token> = .Some(first("7"))
    if maybe is .Some(.Number(value)) {
        io::println("seven is \(value)")
    }

    var names: Vec<String> = Vec()
    names.push(String::of("a.txt"))
    names.push(String::of("src/"))
    var model = Model(title: String::of("home"), names: move names)
    var out = String()
    lines(view(&model), 0, &var out)
    io::print(out.toStr())

    // Once the frame is done with, the model may change, and the next
    // frame shows it.
    model.names.push(String::of("new.md"))
    var again = String()
    lines(view(&model), 0, &var again)
    io::print(again.toStr())

    var numbers: Vec<i64> = Vec()
    numbers.push(10)
    numbers.push(20)
    io::println("\(picked(.One(from: &numbers, at: 1))) \(picked(.Nothing))")

    val name = String::of("x")
    val negated = Expr::Neg(own Expr::Neg(own Expr::Name(name.toStr())))
    io::println(render(&negated).toStr())
    val boxed: own<Token> = own first("boxed")
    io::println(wordOf(&boxed))
}
