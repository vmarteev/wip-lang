// `Option<T>` and the prelude. The type is in scope with no
// import, its variants are written `.Some(x)` and `.None`, and it is taken
// apart by `is`, `match` and `val … else` as much as by its methods.
//
// Expected output: 1 and 0 (`isSome` and `isNone`), 3 and 7 (`unwrapOr` with
// a value and without), 6 (`map`), 6 (a chain through `flatMap`), 3 and 0
// (`filter`), 30
// and 5 (`fold`), 1 and 1 (`any` and `all`), 8 (`orElse`), 9 then 1
// (`take`, and what it leaves), 4 (`replace`), 5 three times (`flatten` of
// a value, with its type argument written, and of nothing), 2 (a value
// that owns memory, through `map`), and 6 (an `is` test), with every
// allocation freed.

import std::io

fn double(value: i64): i64 = value * 2

fn half(value: i64): Option<i64> = if value % 2 == 0 {
    .Some(value / 2)
} else {
    .None
}

fn positive(value: &i64): bool = value > 0

fn negative(value: &i64): bool = value < 0

fn show(value: &i64) = io::printInt(value)

fn tenTimes(value: i64): i64 = value * 10

struct Token {
    id: i64
}

fn idOf(token: own<Token>): i64 = token.id

fn main() = {
    val some: Option<i64> = .Some(3)
    val none: Option<i64> = .None
    io::printInt(if some.isSome() { 1 } else { 0 })
    io::printInt(if some.isNone() { 1 } else { 0 })

    io::printInt(some.unwrapOr(7))
    io::printInt(none.unwrapOr(7))
    io::printInt(some.map(double).unwrapOr(0))
    io::printInt(some.map(double).flatMap(half).map(double).unwrapOr(0))

    io::printInt(some.filter(positive).unwrapOr(0))
    io::printInt(some.filter(negative).unwrapOr(0))

    io::printInt(some.fold(() => 5, tenTimes))
    io::printInt(none.fold(() => 5, tenTimes))

    io::printInt(if some.any(positive) { 1 } else { 0 })
    io::printInt(if none.all(negative) { 1 } else { 0 })

    val fallback: Option<i64> = .Some(8)
    io::printInt(none.or(fallback).unwrapOr(0))

    var slot: Option<i64> = .Some(9)
    io::printInt(slot.take().unwrapOr(0))
    io::printInt(if slot.isNone() { 1 } else { 0 })
    io::printInt(slot.replace(4).unwrapOr(0) + slot.unwrapOr(0))

    // `flatten` belongs to the type, so `Result` may have one of its own.
    val nested: Option<Option<i64>> = .Some(.Some(5))
    io::printInt(Option::flatten(nested).unwrapOr(0))
    io::printInt(Option<i64>::flatten(nested).unwrapOr(0))
    val emptyOuter: Option<Option<i64>> = .None
    io::printInt(Option::flatten(emptyOuter).unwrapOr(5))

    val owned: Option<own<Token>> = .Some(own Token(id: 2))
    io::printInt(owned.map(idOf).unwrapOr(0))

    val counted: Option<i64> = .Some(6)
    if counted is .Some(n) {
        show(&n)
    }
}
