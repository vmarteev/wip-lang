// Compute something, print it, and return it as the exit code.

import std::io

fn collatzSteps(start: i64): i64 = {
    var n = start
    var steps = 0
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        steps = steps + 1
    }
    steps
}

fn main(): i64 = {
    val steps = collatzSteps(27)
    io::printInt(steps) // 111
    steps % 256   // exit code 111
}
