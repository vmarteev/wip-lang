// Hashing: a value writes its parts into a hasher it is
// handed, rather than answering a number of its own, so what the hasher
// sees is the bytes of the whole value, mixed once. That is Swift's shape,
// and it composes: a struct's fields go in one after another.
//
// `@derive(Hash)` writes the body, and needs `@derive(Eq)` beside it — a map is wrong the
// moment two equal values hash differently, and a hashing written from the
// fields only matches an equality written from the fields.
//
// The hasher is one algorithm, FNV-1a, written in Wip in the prelude. It
// needs the wrapping multiplication, `*%`.
//
// Expected output: equal values hash alike and different ones apart, for a
// struct, an enum with a payload, text and a number; and the counting below
// finds three of one word, which is what a map will do for a living.

import std::io

@derive(Eq, Hash)
struct Cell { row: i64, column: i64 }

@derive(Eq, Hash)
enum Rank { Low, Middle(step: i64), High }

fn hashOf<T: Hash>(value: &T): u64 = {
    var hasher = Hasher()
    value.hashInto(&var hasher)
    return hasher.finish()
}

// What a map does, without being one yet: the words that hash alike and
// are equal are the same word.
fn countOf<T: Hash + Eq>(xs: &[T], wanted: &T): i64 = {
    val wantedHash = hashOf<T>(&wanted)
    var found = 0
    var i = 0
    while i < xs.len() {
        if hashOf<T>(&xs[i]) == wantedHash && xs[i] == wanted {
            found = found + 1
        }
        i = i + 1
    }
    return found
}

fn main() = {
    val here = Cell(row: 1, column: 2)
    val same = Cell(row: 1, column: 2)
    val swapped = Cell(row: 2, column: 1)
    io::println("cells \(hashOf(&here) == hashOf(&same)), \(hashOf(&here) != hashOf(&swapped))")

    io::println("ranks \(hashOf(Rank::Low) != hashOf(Rank::High))")
    io::println("steps \(hashOf(Rank::Middle(step: 1)) != hashOf(Rank::Middle(step: 2)))")
    io::println("payload \(hashOf(Rank::Middle(step: 0)) != hashOf(Rank::Low))")

    // The built-in types are hashed by the prelude, not by the compiler.
    io::println("text \(hashOf("hello") != hashOf("world")), \(hashOf("ab") != hashOf("a"))")
    io::println("numbers \(hashOf(7) != hashOf(8)), bools \(hashOf(true) != hashOf(false))")

    val words = ["one", "two", "one", "three", "one"]
    io::println("counted \(countOf(&words, "one"))")

    val cells = [here, swapped, same]
    io::println("cells counted \(countOf(&cells, &here))")
}
