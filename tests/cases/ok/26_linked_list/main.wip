// A singly linked list built from `own`. The recursion goes through `own`, so
// `List` has a finite size.

import std::io

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

fn push(list: own<List>, value: i64): own<List> = {
    own List::Cons(head: value, tail: move list)
}

fn sum(list: &List): i64 = {
    return match list {
        // `&tail` is a call argument, and `&own<List>` coerces to `&List`.
        .Cons(head, tail) => head + sum(&tail)
        .Nil => 0
    }
}

fn main(): i64 = {
    var list = own List::Nil
    var i = 1
    while i <= 4 {
        list = push(move list, i)
        i = i + 1
    }
    io::printInt(sum(&list)) // 10
    0
}
