// The library's containers empty with `clear` and `takeAll`, so a list of
// the words of each line, kept for its room from one line to the next, is
// cleared and filled again while the line it borrowed changes: a `Vec`, a
// `Deque`, a `Map`, a `Set` and an `Arena` of `str`s.
//
// Expected output:
// 6 6 6 6 6
// taken 6 6 6

import std::collections::{Arena, Deque, Map, Set}
import std::io

fn main() = {
	val lines = ["a b c", "d e", "f"]
	var line = String()
	var list: Vec<str> = Vec()
	var queue: Deque<str> = Deque()
	var counts: Map<str, i64> = Map()
	var seen: Set<str> = Set()
	var named: Arena<str> = Arena()
	var sizes = [0, 0, 0, 0, 0]
	var taken = [0, 0, 0]
	for text in lines {
		list.clear()
		queue.clear()
		counts.clear()
		seen.clear()
		named.clear()
		line.clear()
		line.push(text)
		for word in line.toStr().split(" ") {
			list.push(word)
			queue.pushBack(word)
			counts.put(word, 1)
			seen.add(word)
			named.add(word)
		}
		sizes[0] += list.len()
		sizes[1] += queue.len()
		sizes[2] += counts.len()
		sizes[3] += seen.len()
		sizes[4] += named.len()
		taken[0] += list.takeAll().len()
		taken[1] += queue.takeAll().len()
		taken[2] += counts.takeAll().len()
	}
	io::println("\(sizes[0]) \(sizes[1]) \(sizes[2]) \(sizes[3]) \(sizes[4])")
	io::println("taken \(taken[0]) \(taken[1]) \(taken[2])")
}
