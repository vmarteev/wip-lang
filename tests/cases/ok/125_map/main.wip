// A map from keys to values, written in Wip over `Vec<T>` and `Hash`. Its
// entries lie one after another in the order they were put in, and a table of
// positions says where each key's entry is — which is what lets `for entry in
// map` be a walk over a slice.
//
// Expected output: a hundred keys found after several rebuilds, a value
// replaced and another written through `at`, the entries walked in the
// order they went in, words counted with `atOrPut`, keys that own memory
// removed and the rest still answering, and a board of struct keys, with
// every allocation freed.

import std::io
import std::collections::{Map, MapEntry}

@derive(Eq, Hash)
struct Cell {
    row: i64
    column: i64
}

fn main() = {
    var squares = Map<i64, i64>()
    var i = 0
    while i < 100 {
        squares.put(i, i * i)
        i += 1
    }
    io::println("\(squares.len()) keys, 99 -> \(squares.at(99))")
    io::println("has 50 \(squares.contains(50)), has 200 \(squares.contains(200))")

    // Putting a key that is there again replaces its value.
    squares.put(9, 0)
    squares.at(9) += 81
    io::printInt(squares.at(9))

    // The order is the order they went in, which makes a map's walk
    // something a program can rely on.
    var names = Map<String, i64>()
    names.put(String::of("one"), 1)
    names.put(String::of("two"), 2)
    names.put(String::of("three"), 3)
    for MapEntry(key, value) in names {
        io::println("\(key.toStr()) = \(value)")
    }

    // What a map is for: counting.
    val words = ["one", "two", "one", "three", "one"]
    var counts = Map<String, i64>()
    for word in words {
        counts.atOrPut(String::of(word), 0) += 1
    }
    io::println("one \(counts.at(String::of("one"))), three \(counts.at(String::of("three")))")

    // Removal takes the value out and leaves the rest findable, however
    // the entries move about.
    var taken = 0
    i = 0
    while i < 100 {
        taken += squares.remove(&i).unwrapOr(0)
        i += 3
    }
    var left = 0
    var found = true
    i = 0
    while i < 100 {
        if squares.contains(&i) != (i % 3 != 0) {
            found = false
        }
        i += 1
    }
    for entry in squares {
        left += entry.value
    }
    io::println("taken \(taken), left \(squares.len()) worth \(left), all found \(found)")

    // A struct of its own as a key, hashed by `@derive(Hash)` and compared by
    // `@derive(Eq)`.
    var board = Map<Cell, i64>()
    board.put(Cell(row: 1, column: 2), 7)
    board.put(Cell(row: 2, column: 1), 8)
    io::println("cell \(board.at(Cell(row: 1, column: 2))), \(board.at(Cell(row: 2, column: 1)))")

    counts.clear()
    io::println("cleared \(counts.len()), empty \(counts.isEmpty())")
}
