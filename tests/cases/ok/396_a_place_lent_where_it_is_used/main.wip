// A place is lent where it is used: an assignment's at the write, after its
// value, and an argument's when the call starts, after every argument. So a
// value or a later argument may change what the place is in — grow the arena
// or the `Vec` it is in, replace the box or the array — and the write goes
// where the place is then. What the place's expression computes — an index,
// what a projection is given — is still computed where it is written, in the
// order written.
//
// Expected output: 5050, then 3 3, then 7 2, then f g 7, then .Some(2), then
// 5, then 7 5, then 2 5, then 9 3, then 1 100, then 3.

import std::collections::{Arena, Handle, Map}
import std::io

/// A list built in an arena, each node filled in with what is built after
/// it, as a parser fills in a node with what it parses next.
struct Node {
    value: i64
    next: Option<Handle<Node>> = .None
}

struct Builder {
    nodes: Arena<Node> = Arena()
}

extend Builder {
    var fn build(values: &[i64], i: i64): Option<Handle<Node>> = {
        if i == values.len() then return .None
        val node = self.nodes.add(Node(value: values[i]))
        self.nodes[node].next = self.build(values, i + 1)
        return .Some(node)
    }

    fn sum(from: Option<Handle<Node>>): i64 = {
        var total = 0
        var at = from
        while at is .Some(node) {
            total += self.nodes[node].value
            at = self.nodes[node].next
        }
        return total
    }
}

struct Counter {
    items: Vec<i64> = Vec()
    last: i64 = 0
    seen: i64 = 0
}

extend Counter {
    var fn add(n: i64): i64 = {
        self.items.push(n)
        return self.items.len()
    }

    var fn record(n: i64) = {
        self.seen = n
    }
}

struct Point {
    x: i64
}

struct Grid {
    cells: own<[i64]>
}

fn at(grid: &var Grid, i: i64): &var i64 = lend grid.cells[i]

fn say(word: str, n: i64): i64 = {
    io::print("\(word) ")
    return n
}

fn set(n: &var i64, value: i64) = {
    n = value
}

/// Grows `v` past what it has room for, so its elements move.
fn grow(v: &var Vec<i64>): i64 = {
    var i = 0
    while i < 99 {
        v.push(0)
        i += 1
    }
    return 1
}

fn keep(p: &var own<Point>, n: i64) = {
    p.x += n
}

fn main() = {
    // An arena filled with what is built next: each node's field is
    // assigned while the arena grows under it.
    var values: Vec<i64> = Vec()
    var n = 1
    while n <= 100 {
        values.push(n)
        n += 1
    }
    var builder = Builder()
    val first = builder.build(&values, 0)
    io::println("\(builder.sum(first))")

    // A field assigned a value that changes its struct, and a receiver
    // changed by its argument.
    var counter = Counter()
    counter.add(1)
    counter.add(2)
    counter.last = counter.add(3)
    io::println("\(counter.last) \(counter.items.len())")
    counter.record(counter.add(7) + 3)
    io::println("\(counter.seen) \(counter.items[3] - 5)")

    // The written order: the index, then the value.
    var xs = [0, 0]
    xs[say("f", 1)] = say("g", 7)
    io::println("\(xs[1])")

    // A projection runs where its place is used, after the value.
    var m: Map<String, i64> = Map()
    m.put(String::of("a"), 1)
    m.put(String::of("b"), 2)
    m.atOrPut(String::of("c"), 0) = m.len()
    io::println("\(m.get("c"))")

    // The value replaces what the place is in: the write goes to the new.
    var b = own Point(x: 1)
    b.x = {
        b = own Point(x: 2)
        5
    }
    io::println("\(b.x)")
    var array = own [1, 2, 3]
    array[0] = {
        array = own [4, 5, 6]
        7
    }
    io::println("\(array[0]) \(array[1])")
    var grid = Grid(cells: own [0; 4])
    at(&var grid, 1) = {
        grid.cells = own [5; 4]
        2
    }
    io::println("\(grid.cells[1]) \(grid.cells[0])")

    // An index is read where it is written.
    var ys = [1, 2, 3]
    var i = 0
    ys[i] = {
        i = 2
        9
    }
    io::println("\(ys[0]) \(ys[2])")

    // A later argument grows what an earlier one lends, and replaces the
    // box an earlier one lends from.
    var v = Vec::of(own [0])
    set(&var v[0], grow(&var v))
    io::println("\(v[0]) \(v.len())")
    var p = own Point(x: 1)
    keep(&var p, { p = own Point(x: 2); 1 })
    io::println("\(p.x)")
}
