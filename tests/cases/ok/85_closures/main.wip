// Closures lent for one call: `&(…) => R` reads the variables it names where
// they are, and `&var (…) => R` writes them. Both are second-class, as every
// reference is: an argument, and nothing else, so a closure cannot outlive the
// call it is passed to.
//
// Expected output: 11, 12 and 13 (a lent closure reading a variable), 6 (a
// writing closure adding to one), 4 and 5 (internal iteration over values
// that own memory, which is what closures were designed for), 30 (a closure
// that captures a reference parameter), 9 (a lambda that captures nothing
// where a closure is expected), and 7 (a closure with its own parameters
// and result), with every allocation freed.

import std::io

struct Token {
    id: i64
}

struct Bag {
    total: i64
}

fn forEach(items: &[i64], visit: &(item: &i64) => void) = {
    for item in items {
        visit(&item)
    }
}

fn forEachToken(items: &[own<Token>], visit: &(item: &own<Token>) => void) = {
    for item in items {
        visit(&item)
    }
}

fn step(items: &[i64], take: &var (item: &i64) => void) = {
    for item in items {
        take(&item)
    }
}

fn addUp(bag: &var Bag, items: &[i64]) = {
    step(&items, (item) => bag.total += item)
}

fn choose(pick: &(a: i64, b: i64) => i64): i64 = pick(3, 4)

fn main() = {
    val xs = [1, 2, 3]
    val base = 10
    forEach(&xs, (item) => io::printInt(item + base))

    var total = 0
    step(&xs, (item) => total += item)
    io::printInt(total)

    val tokens = [own Token(id: 4), own Token(id: 5)]
    forEachToken(&tokens, (item) => io::printInt(item.id))

    var bag = Bag(total: 24)
    addUp(&var bag, &xs)
    io::printInt(bag.total)

    io::printInt(choose((a, b) => a * 3))

    io::printInt(choose((a, b) => a + b))
}
