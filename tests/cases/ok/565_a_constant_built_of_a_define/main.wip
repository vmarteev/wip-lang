// A constant built of a define and a target, text compared among them, is
// a constant as they are: its value is known where it is written, and a
// condition of it takes one branch only.
//
// Expected output:
// tools
// not on nowhere

import std::io

@define
val EDITOR: bool = true

val TOOLS: bool = EDITOR && TARGET_OS != "nowhere"

val NOWHERE: bool = TARGET_OS == "nowhere"

val BOTH: bool = TOOLS && !NOWHERE

fn main() = {
	if TOOLS then io::println("tools")
	if NOWHERE then io::println("on nowhere") else io::println("not on nowhere")
	assert(BOTH)
}
