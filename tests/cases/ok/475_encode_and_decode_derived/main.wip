// `@derive(Encode, Decode)` writes a type's encoding and decoding from its
// fields: a struct is a record of its fields by name, an enum's variant its
// name and a record of its fields, a field the input lacks its default, an
// `Option` left out nothing, and a generic type's field is decoded by its
// type written in full, `Pair<i64>::decode`, whose own type arguments come
// after the type's name and the method's own are inferred.
//
// Expected output:
// {"title":"crate","size":{"first":2,"second":3},"tags":["wood"],"shape":{"Box":{"side":1.5}},"weight":0.5}
// true
// light 0.5 none

import std::io
import std::json

@derive(Encode, Decode, Eq)
struct Pair<T> {
	first: T
	second: T
}

@derive(Encode, Decode, Eq)
enum Shape {
	Box(side: f64)
	Ball
}

@derive(Encode, Decode, Eq)
struct Item {
	title: String
	size: Pair<i64>
	tags: Vec<String>
	shape: Shape
	weight: f64 = 0.5
	owner: Option<String>
}

fn main() = {
	val item = Item(
		title: "crate",
		size: Pair(first: 2, second: 3),
		tags: Vec::of(own [String::of("wood")]),
		shape: .Box(side: 1.5),
		weight: 0.5,
		owner: .None,
	)
	val written = json::encode(&item)
	io::println(written)
	io::println("\(json::decode<Item>(written).unwrap() == item)")
	val light = json::decode<Item>(
		"{\"title\": \"a\", \"size\": {\"first\": 1, \"second\": 1}, \"tags\": [], \"shape\": \"Ball\"}",
	)
	if light is .Ok(read) then
		io::println("light \(read.weight) \(if read.owner.isNone() then "none" else "some")")
}
