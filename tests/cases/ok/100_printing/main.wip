// Printing: `print` writes the bytes it is given and adds
// nothing, `println` adds a line break. Both take a `str`, and a `String`
// may stand where a `str` is expected — it lends its bytes for the call, and
// takes them back after, which is the rule references already keep.
//
// Expected output: Hello World, built from four calls; then the same line
// from an interpolated literal and from a `String` passed as it is; then
// three numbers, which the shims print a line at a time without building
// any text at all.

import std::io

fn main() = {
    io::print("Hello")
    io::print(" ")
    io::print("World")
    io::println("")

    val who = "World"
    io::println("Hello \(who)")

    var greeting = String()
    greeting.push("Hello ")
    greeting.push(who)
    io::println(greeting)

    io::printInt(-7)
    io::printUnsigned(7)
    io::printFloat(0.5)
}
