// A `var fn` called on a value made where it is called: an iterator asked
// for its first value, a call's answer and a literal changed, and a vector
// that owns memory popped and then dropped with the statement. What the
// method changed goes with the value.
//
// Expected output: .Some(first line) .Some(f) .Some(a), then 11 2, then
// .Some(y).

import std::io

struct Counter {
	count: i64

	var fn bump(): i64 = {
		self.count += 1
		return self.count
	}
}

fn counter(): Counter = Counter(count: 10)

fn main() = {
	val text = "first line\nsecond line"
	val first = text.lines().next()
	val c = text.chars().next()
	val word = "a b c".split(" ").next()
	io::println("\(first) \(c) \(word)")

	io::println("\(counter().bump()) \(Counter(count: 1).bump())")

	val last = Vec::of(own [String::of("x"), String::of("y")]).pop()
	io::println("\(last)")
}
