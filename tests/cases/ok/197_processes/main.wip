// Starting another program: run with this terminal, run
// for what it prints with no shell between — an argument with a `;` and a
// `$(…)` in it is one argument — both streams read at once, the
// environment and the directory given, a program that is not there,
// one started, polled, killed and waited for, one dropped, which is waited
// for, one writing on the terminal it shares, a command moved to another
// thread, and one launched and let go. And a program given input: read
// back, much of it while its output is read, one that reads none of it,
// and one run with it.

import std::io
import std::future::{Future}
import std::process::{Command, Exit}

fn main() = {
    // Run, with this terminal.
    val .Ok(exit) = Command::of("true").run() else {
        assert(false, "true runs")
        return
    }
    assert(exit.success())
    assert(Command::of("false").run() == .Ok(.Code(1)))

    // What it printed, with no shell between: the argument is one argument.
    val .Ok(said) = Command::of("printf").args(["%s|%s", "a;$(echo no) b", "c"]).output() else {
        assert(false, "printf runs")
        return
    }
    assert(said.stdout == "a;$(echo no) b|c")
    assert(said.exit.success())

    // Both streams, at once, and much of each.
    val .Ok(both) = Command::of("sh").args(["-c", "i=0; while [ $i -lt 20000 ]; do echo out$i; echo err$i >&2; i=$((i+1)); done"]).output() else {
        assert(false, "sh runs")
        return
    }
    assert(both.stdout.toStr().lines().count() == 20000)
    assert(both.stderr.toStr().lines().count() == 20000)

    // Its environment and its directory.
    val .Ok(env) = Command::of("sh").args(["-c", "echo $WIP_GREETING; pwd"]).env("WIP_GREETING", "hello").directory("/tmp").output() else {
        assert(false, "sh runs")
        return
    }
    assert(env.stdout.toStr().startsWith("hello\n"))
    assert(env.stdout.toStr().contains("tmp"))

    // Not there.
    assert(Command::of("no-such-program-anywhere").run() is .Err(.NotFound))

    // Started, polled, killed and waited for.
    val .Ok(sleeper) = Command::of("sleep").arg("30").start() else {
        assert(false, "sleep starts")
        return
    }
    var child = move sleeper
    assert(child.tryWait().isNone())
    child.kill()
    assert(child.wait() == .Signal(9))

    // A child dropped is waited for.
    val quick = Command::of("sleep").arg("0.2").start()

    // A child writes on this program's own output, which it shares.
    assert(Command::of("echo").arg("from a child").run() == .Ok(.Code(0)))

    // A command owns its strings, so it moves to another thread.
    val listing = Command::of("printf").arg("far away")
    val far = Future::run(own () => listing.output())
    match far.get() {
        .Ok(said) => assert(said.stdout == "far away")
        .Err(..) => assert(false, "printf runs on the other thread")
    }

    // Launched, and let go.
    assert(Command::of("true").launch().isOk())

    // Input, read back.
    val .Ok(echoed) = Command::of("cat").input("one\ntwo\n").output() else {
        assert(false, "cat runs")
        return
    }
    assert(echoed.stdout == "one\ntwo\n")

    // Much of it, written while the program's output is read: neither
    // waits on the other.
    var much = String()
    for i in 0..100000 {
        much.push("line \(i)\n")
    }
    val .Ok(counted) = Command::of("cat").input(much.toStr()).output() else {
        assert(false, "cat runs")
        return
    }
    assert(counted.stdout.len() == much.len())

    // A program that reads none of it ends the writing, and the rest is
    // dropped: this program goes on.
    val .Ok(deaf) = Command::of("sh").args(["-c", "echo early"]).input(much.toStr()).output() else {
        assert(false, "sh runs")
        return
    }
    assert(deaf.stdout == "early\n" && deaf.exit.success())

    // Run with input, which it reads before it ends.
    assert(Command::of("sh").args(["-c", "read word; test \"$word\" = yes"]).input("yes\n").run() == .Ok(.Code(0)))
    io::println("done")
}
