// `for`, `break` and `continue`. A `for` walks the elements of
// an array, a slice or a buffer, with a binding that refers to each element
// and can write it when the collection can be written, or counts through a
// range. `break` and `continue` run the `defer`s and drops of the blocks they
// leave, and `while true` with no `break` never finishes, so it can end a
// function that returns a value.
//
// Expected output: 60 (an array), 6 (a slice), 11, 21, 31 (elements written
// in place), 4 (a buffer's elements, owned by a temporary), 0 1 2 (a range),
// -2 (a range of i32 from -2 to 1), then 1, skip, skip, 3, skip, skip, stop,
// skip and 4 (continue and break with defers), 3 (nested loops), 12 and 24
// (an array of `own` values read, then replaced in place), 8 (`continue` as a
// value), 7 (the first square over 40), and 5 (`while true`), with every
// allocation freed.

import std::io

struct Token {
    id: i64
}

fn sum(xs: &[i64]): i64 = {
    var total = 0
    for x in xs {
        total = total + x
    }
    total
}

fn addOne(xs: &var [i64]) = {
    for x in xs {
        x = x + 1
    }
}

fn count(xs: &[i64]): i64 = {
    var n = 0
    for _ in xs {
        n = n + 1
    }
    n
}

fn buffer(n: i64): own<[i64]> = own [7; n]

fn countBuffer(): i64 = {
    var n = 0
    for x in buffer(4) {
        n = n + x / 7
    }
    n
}

fn firstSquareOver(limit: i64): i64 = {
    var i = 0
    while true {
        if i * i > limit {
            return i
        }
        i = i + 1
    }
}

fn countdown(from: i64): i64 = {
    var n = from
    while true {
        if n == 0 {
            break
        }
        n = n - 1
    }
    from
}

fn main(): i64 = {
    val array = [10, 20, 30]
    var total = 0
    for x in array {
        total = total + x
    }
    io::printInt(total)
    io::printInt(sum([1, 2, 3]))

    var written = [10, 20, 30]
    addOne(&var written)
    for x in written {
        io::printInt(x)
    }
    io::printInt(countBuffer())

    for i in 0..3 {
        io::printInt(i)
    }
    val lo: i32 = -2
    for i in lo..1 {
        if i == lo {
            io::printInt(i as i64)
        }
    }

    for i in 1..10 {
        defer io::println("skip")
        val token = own Token(id: i)
        if token.id % 2 == 0 {
            continue
        }
        if token.id == 5 {
            io::println("stop")
            break
        }
        io::printInt(token.id)
    }
    io::printInt(4)

    var pairs = 0
    for i in 0..3 {
        for j in 0..3 {
            if j > i {
                break
            }
            if j == i {
                continue
            }
            pairs = pairs + 1
        }
    }
    io::printInt(pairs)

    var tokens = [own Token(id: 3), own Token(id: 4), own Token(id: 5)]
    var ids = 0
    for token in tokens {
        ids = ids + token.id
    }
    io::printInt(ids)
    for token in tokens {
        token = own Token(id: token.id * 2)
    }
    ids = 0
    for token in tokens {
        ids = ids + token.id
    }
    io::printInt(ids)

    var odd = 0
    for i in 0..16 {
        val v = if i % 2 == 1 { i } else { continue }
        if v > 0 {
            odd = odd + 1
        }
    }
    io::printInt(odd)
    io::printInt(firstSquareOver(40))
    io::printInt(countdown(5))
    0
}
