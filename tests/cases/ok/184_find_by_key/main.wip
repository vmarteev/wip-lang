// A lookup that may miss answers a position: one pass over
// the table, and `keyAt`, `valueAt` and a set's `at` take it from there, to
// read or to write. `at` by key still panics where the key is not there,
// and `contains` still asks the plain question.
//
// Expected output: red 5 (a value found and written through its position),
// missing, b (a key by position), set 1 and none, and 1 left after a
// removal, where what followed moved forward to position 0.

import std::io
import std::collections::{Map, Set}

struct Ball {
    color: i64,
    age: i64
}

fn main() = {
    var balls = Map<str, Ball>()
    balls.put("a", Ball(color: 3, age: 0))
    balls.put("b", Ball(color: 4, age: 1))

    val .Some(at) = balls.find("a") else {
        return
    }
    balls.valueAt(at).age += 5
    io::println("red \(balls.valueAt(at).age)")

    match balls.find("zz") {
        .Some(..) => io::println("found")
        .None => io::println("missing")
    }

    // The position names the entry, so the key is there too.
    val .Some(second) = balls.find("b") else {
        return
    }
    io::println("\(balls.keyAt(second))")

    var seen = Set<i64>()
    seen.add(7)
    seen.add(9)
    io::println("set \(seen.find(9)) and \(seen.find(8))")

    // A removal moves what came after it, so a position is read again.
    balls.remove("a")
    io::println("\(balls.len()) left, \(balls.find("b"))")
}
