// A `val` or `var` whose value is `&place` holds a reference to the place,
// as if it were declared `&T`: read through, and,
// for a `var`, pointed somewhere else.

import std::io

struct Node {
    name: String
    next: Option<own<Node>>
}

struct Holder {
    items: Vec<String>
    label: String
}

fn main() = {
    val holder = Holder(items: Vec::of(own [String::of("a"), String::of("bb")]), label: String::of("held"))
    val second = &holder.items[1]
    val label = &holder.label
    io::println("\(second) \(second.len()) \(label)")

    // A `var` walks a list without taking it apart.
    val list = Node(name: String::of("one"), next: .Some(own Node(name: String::of("two"), next: .None)))
    var at = &list
    var names = String()
    while true {
        names.push(at.name.toStr())
        val .Some(next) = at.next else {
            break
        }
        at = &next
    }
    io::println(names.toStr())
}
