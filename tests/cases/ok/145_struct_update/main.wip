// `P { a: 1, ..other }` takes the fields the literal does not name from a
// value that has them. It is the other half of a field's
// default: a default says what a field starts as when nothing says otherwise,
// and `..` says where the rest come from when something does.
//
// The fields are copied, so the value after `..` goes on living, and a
// field that owns memory is refused rather than moved out of it.
//
// Expected output: the changed window and the one it came from, a field
// the taller one, a value read from a field of another value,
// a generic type, and a default filling what neither names.

import std::io

@derive(Text)
struct Window {
    width: i64 = 800
    height: i64 = 600
    scale: i64 = 1
}

@derive(Text)
struct Holder<T: Text> {
    value: T
    count: i64
}

struct Screen {
    window: Window
}

fn main() = {
    val defaults = Window()
    val bigger = Window(width: 1920, ..defaults)
    io::println("\(bigger)")
    io::println("\(defaults)")

    // A field the literal names is that field's value; `..` fills the
    // rest, and comes last as it does in a pattern.
    val tall = Window(height: 1080, ..defaults)
    io::println("\(tall)")

    // The value may be any place: a field of another value is one.
    val screen = Screen(window: bigger)
    val again = Window(scale: 2, ..screen.window)
    io::println("\(again)")

    val held = Holder<i64>(value: 1, count: 2)
    io::println("\(Holder<i64>(count: 3, ..held))")

    // `..` fills what it can; a field neither it nor the literal names
    // takes its default.
    val partial = Partial(n: 1)
    io::println("\(Partial(..partial))")
}

@derive(Text)
struct Partial {
    n: i64
    extra: i64 = 7
}
