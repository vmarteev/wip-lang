// A `for` or a `while` whose body is one statement is written after `do`,
// with no braces: a call, an assignment, a `yield` in a list or a
// generator, a jump, and an `if` in its `then` form, on the loop's line or
// on the next. A loop in braces may hold one in its `do` form, a label
// names one, and a `?` in its body leaves the function.
//
// Expected output:
// 1
// 2
// total 6 counted 5
// found 1
// evens [2, 4] cells [10, 20, 30] squares 14
// parsed [7, 8]
// refused

import std::io
import std::text::{ParseError}

fn parsed(texts: &[str]): Result<Vec<i64>, ParseError> = {
    val numbers = [for text in texts do yield text.toInt()?]
    return numbers
}

fn found(rows: &[Vec<i64>]): i64 = {
    var seen = 0
    outer: for row in rows {
        for n in row do if n > 2 then break outer
        seen += 1
    }
    return seen
}

fn main() = {
    for n in [1, 2] do io::println("\(n)")
    var total = 0
    for n in [1, 2, 3] do total += n
    var counted = 0
    while counted < 5 do
        counted += 1

    io::println("total \(total) counted \(counted)")
    io::println("found \(found([[1, 2], [3, 4]]))")
    val evens = [for n in [1, 2, 3, 4] do if n % 2 == 0 then yield n]
    val cells = [for row in [Vec::of([1]), [2, 3]] {
        for cell in row do yield cell * 10
    }]
    val squares = (for n in [1, 2, 3] do yield n * n).sum()
    io::println("evens \(evens) cells \(cells) squares \(squares)")
    io::println("parsed \(parsed(["7", "8"]).unwrap())")
    if parsed(["x"]).isErr() then io::println("refused")
}
