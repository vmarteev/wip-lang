// A field of a generic type whose default names the type's parameter, as
// `.None` of an `Option<Part<T>>` does, is the type of the value it is a
// default of: a value built without it holds nothing, of its own type.
//
// Expected output:
// false
// true 3

import std::io

struct Part<T> {
	width: i64
}

struct Holder<T> {
	part: Option<Part<T>> = .None
	parts: Vec<Part<T>> = Vec()
}

extend Holder<T> {
	var fn keep(made: Part<T>) = {
		self.part = .Some(made)
	}
}

fn main() = {
	var holder: Holder<str> = Holder()
	io::println("\(holder.part.isSome())")
	holder.keep(Part(width: 3))
	val width = match holder.part {
		.Some(part) => part.width
		.None => 0
	}
	io::println("\(holder.part.isSome()) \(width)")
	assert(holder.parts.isEmpty())
}
