// A struct crossing by value, in and out. C's rules
// for that are three specifications — System V, AAPCS64 and Windows x64 —
// and Wip implements none of them. Instead the compiler writes a little C
// of its own and lets `cc` decide how the fields travel:
//
//     extern struct Rect grow(struct Rect a0, int32_t a1);
//
//     void wip_shim_99(struct Rect *out, struct Rect *a0, int32_t a1) {
//         *out = grow(*a0, a1);
//     }
//
// Wip already passes an aggregate by its address, and takes an aggregate
// result through an address the caller gives, so that is the signature code
// generation would have emitted anyway. Only the symbol changes.
//
// Expected output: area 12, from a struct C was given; then 5 by 6 and
// area 30, from one C made and handed back.

import std::io

extern struct Rect {
    x: c_int,
    y: c_int,
    width: c_int,
    height: c_int
}

extern "C" {
    fn grow(r: Rect, by: c_int): Rect
    fn area(r: Rect): i64
}

fn main() = {
    val small = Rect(x: 0, y: 0, width: 3, height: 4)
    io::println("area \(area(small))")

    val big = grow(small, 2)
    io::println("\(big.width) by \(big.height), area \(area(big))")
}
