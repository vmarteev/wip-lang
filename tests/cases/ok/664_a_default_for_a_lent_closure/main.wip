// A parameter that takes a lent closure, `&` or `&var`, may have a default
// that is a lambda capturing nothing or a function's name: a call that
// leaves it out is given that function, and one that names it gives its
// own. In a generic function, the default is a function's name.
//
// Expected output:
// seen root separator box text
// counted 2 1
// named 2

import std::io

struct Builder {
    names: Vec<String> = Vec()
}

fn none(_: &var Builder) = {}

fn twice(x: i64): i64 = x * 2

extend Builder {
    var fn element(name: str, children: &var (builder: &var Builder) => void = (_) => {}) = {
        self.names.push(name)
        children(&var self)
    }

    var fn leaf(children: &var (builder: &var Builder) => void = none) = children(&var self)
}

fn counted(numbers: &[i64], test: &var (n: &i64) => bool = (n) => n > 0): i64 =
    numbers.countWhere(test)

fn named<T>(value: T, f: &(x: i64) => i64 = twice): T = {
    assert(f(1) == 2)
    return value
}

fn main() = {
    var builder = Builder()
    builder.element("root", (b) => {
        b.element("separator")
        b.element("box", children: (inner) => inner.element("text"))
    })
    builder.leaf()
    io::println("seen \(builder.names.join(" "))")
    io::println("counted \(counted([1, -2, 3])) \(counted([1, -2, 3], (n) => n < 0))")
    io::println("named \(named(2))")
}
