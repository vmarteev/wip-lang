// Lexed in a wave after the root's, with an interner of its own: the
// pieces of its interpolated text must be renumbered with its names.

import std::io

pub fn join(root: &String, relative: str): String = "\(root)/\(relative)"

pub fn report(what: str, count: i64) = io::println("FAILED: \(what), \(count) times, at the end")
