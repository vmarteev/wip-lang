// A `&var dyn` parameter lent on to another function, `&var source`, is
// the same value and the same table of methods: what the callee changes
// through it, the caller's value has.
//
// Expected output:
// 2 3
// 3 0

import std::io

interface Source {
	var fn take(): i64
}

struct Counted {
	left: i64
}

extend Counted: Source {
	var fn take(): i64 = {
		if self.left == 0 then return 0
		self.left -= 1
		return 1
	}
}

fn once(source: &var dyn Source): i64 = source.take()

fn twice(source: &var dyn Source): i64 = once(&var source) + once(&var source)

fn all(source: &var dyn Source): i64 = {
	var total = 0
	while once(&var source) == 1 {
		total += 1
	}
	return total
}

fn main() = {
	var counted = Counted(left: 5)
	io::println("\(twice(&var counted)) \(counted.left)")
	io::println("\(all(&var counted)) \(counted.left)")
}
