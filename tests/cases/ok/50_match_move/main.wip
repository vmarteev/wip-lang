// Taking values apart with `match move`. Matching a place
// gives bindings that alias its fields; matching a value moves it into a
// temporary, and each binding owns its field. A binding that is not moved on
// is dropped at the end of its arm, and fields that no binding takes are
// dropped after the `match`. The run test traces every allocation and checks
// that nothing leaks.
//
// Expected output:
//   alloc #1 … alloc #3        the list 3, 2, 1
//   6                          `sum` reads it through aliases
//   alloc #4 … free …          `reverse` takes it apart and builds 1, 2, 3
//   1 2 3                      printed in order, then freed
//   `first` keeps the head and frees the rest; `tagOf` matches a call result
//   and a `_` arm, so the whole value is dropped after the `match`.
//   `sumIf` makes a temporary in one `if` branch only; it is freed in that
//   branch, before the paths join.

import std::io

extern "C" {
    fn wip_trace_allocs()
}

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

// `Pair` keeps a tag byte: after `match move` takes `left` out, the null left
// behind must not make the value read as `Neither` while `right` still needs
// dropping.
enum Pair {
    Both(left: own<List>, right: own<List>)
    Neither
}

fn push(list: own<List>, value: i64): own<List> = own .Cons(head: value, tail: move list)

fn sum(list: &List): i64 = match list {
    .Cons(head, tail) => head + sum(&tail)
    .Nil => 0
}

fn reverse(list: own<List>, acc: own<List>): own<List> = match move list {
    .Cons(head, tail) => reverse(move tail, own .Cons(head, tail: move acc))
    .Nil => move acc
}

fn printAll(list: &List) = match list {
    .Cons(head, tail) => {
        io::printInt(head)
        printAll(&tail)
    }
    .Nil => {}
}

fn first(list: own<List>): i64 = match move list {
    .Cons(head, ..) => head
    .Nil => -1
}

fn makePair(): Pair = Pair::Both(left: push(own List::Nil, 7), right: push(own List::Nil, 8))

fn tagOf(): i64 = match makePair() {
    .Both(left, ..) => sum(&left)
    _ => 0
}

fn sumIf(flag: bool): i64 = if flag { sum(push(own List::Nil, 9)) } else { 0 }

fn main(): i64 = {
    wip_trace_allocs()
    var list = own List::Nil
    list = push(move list, 1)
    list = push(move list, 2)
    list = push(move list, 3)
    io::printInt(sum(&list))
    val reversed = reverse(move list, own List::Nil)
    printAll(&reversed)
    io::printInt(first(push(push(own List::Nil, 5), 4)))
    io::printInt(tagOf())
    io::printInt(sumIf(true))
    io::printInt(sumIf(false))
    0
}
