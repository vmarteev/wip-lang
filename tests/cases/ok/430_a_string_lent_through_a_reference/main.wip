// A `String` lent as a `str` through what holds it: an argument written
// `&text` where a `str` is taken, the same after `&&`, and a method a `str`
// has called on an `own<String>`. Each lends the `String` the reference or
// the box holds, as `text` alone would.
//
// Expected output: `Pair|Pair|true|Pair|3`.

import std::io

fn says(text: str): bool = {
	io::println(text)
	return true
}

fn width(text: str): i64 = text.len()

fn main() = {
	val name = String::of("Pair")
	says(&name)
	var go = true
	if go && says(&name) then io::println("\(go)")
	val boxed = own String::of("Pair")
	if boxed.startsWith("Pa") then io::println(boxed.toStr())
	val held = own String::of("abc")
	io::println("\(width(&held))")
}
