// `extend` blocks and `Self`: a type's methods may
// be written outside its declaration, in any file of its module, and `Self`
// names the type they belong to.
//
// Expected output: 0 and 8 (methods of a struct, written in a block), 6 (a
// `Self` result and a `Self` literal), 1 and 3 (methods of a generic enum,
// whose block renames its type parameter), and 4 (a method written inside
// the type beside a block), with every allocation freed.

import std::io

struct Counter {
    count: i64

    // Members may be written in the declaration and in a block.
    fn get(): i64 = self.count
}

extend Counter {
    static fn new(): Self = Self(count: 0)
    static fn at(count: i64): Self = Counter(count: count)

    var fn add(by: i64 = 1) = self.count += by
    fn doubled(): Self = Self(count: self.count * 2)
    move fn intoCount(): i64 = self.count
}

enum Maybe<T> {
    Some(value: T)
    None
}

// The block names the type's parameter as it likes.
extend Maybe<V> {
    fn isSome(): bool = self is .Some(..)
    static fn nothing(): Self = .None
    move fn unwrapOr(default: V): V = match move self {
        .Some(x) => move x
        .None => move default
    }
    move fn orElse(other: Self): Self = if self.isSome() {
        move self
    } else {
        move other
    }
}

struct Chest {
    gold: own<i64>
}

extend Chest {
    static fn new(gold: i64): Self = Chest(gold: own gold)
    move fn open(): own<i64> = move self.gold
}

fn main() = {
    var c = Counter::new()
    io::printInt(c.get())
    c.add(by: 4)
    io::printInt(c.doubled().intoCount())
    io::printInt(Counter::at(3).doubled().get())

    val some = Maybe<i64>::Some(3)
    io::printInt(if some.isSome() { 1 } else { 0 })
    val chosen = Maybe<i64>::nothing().orElse(Maybe<i64>::Some(3))
    io::printInt(chosen.unwrapOr(0))

    val chest = Chest::new(4)
    val gold = chest.open()
    io::printInt(gold + 0)
}
