// A vector is indexed by its values, not by the room it has made: an index
// past its length panics even where there is a slot for it, since that
// slot holds nothing. It once read whatever the slot held.
//
// Expected output: 1, 1, then the panic on standard error, and status 101.

import std::io

fn main() = {
	var v: Vec<String> = Vec::withCapacity(10)
	v.push("one")
	io::printInt(v.len())
	io::printInt(if v[0] == "one" { 1 } else { 0 })
	v[5] = String::of("five")
}
