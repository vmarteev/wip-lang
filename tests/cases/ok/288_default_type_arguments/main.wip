// A struct's or an enum's type parameter may have a default, which a use
// that leaves it out gets: written in a type, in a path, or
// inferred where nothing else decides it. A default may name the parameters
// before it.
//
// Expected output: 2, 7, 1, 3, 4.

import std::io

struct Tag<T> {
	number: i64
}

struct Pool<T, K = T> {
	items: Vec<T> = Vec()
}

extend Pool<T, K> {
	static fn empty(): Pool<T, K> = Pool()

	var fn add(value: T): Tag<K> = {
		self.items.push(move value)
		return Tag(number: self.items.len())
	}
}

enum Either<L, R = L> {
	Left(value: L)
	Right(value: R)
}

struct Names {
	unused: i64
}

type Words = Pool<String, Names>

fn named(tag: Tag<Names>): i64 = tag.number

fn main() = {
	// `Pool<i64>` is `Pool<i64, i64>`, so its tags are `Tag<i64>`.
	var numbers: Pool<i64> = Pool()
	numbers.add(5)
	val second: Tag<i64> = numbers.add(6)
	io::printInt(second.number)

	// The second argument written: the tags name `Names`.
	var words: Words = Pool()
	val first = words.add("one")
	io::printInt(named(first) + 6)

	// In a path, and inferred: `K` is what `T` turned out to be.
	var floats = Pool<f64>::empty()
	val tag: Tag<f64> = floats.add(1.5)
	io::printInt(tag.number)
	var inferred = Pool(items: Vec::of(own [1, 2]))
	val third: Tag<i64> = inferred.add(3)
	io::printInt(third.number)

	val either: Either<i64> = .Right(value: 4)
	match either {
		.Left(value) => io::printInt(value)
		.Right(value) => io::printInt(value)
	}
}
