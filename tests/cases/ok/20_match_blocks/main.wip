// Block arms, and a `match` used as a statement. Arms on separate lines need no
// `,`, block arms included.

import std::io

enum Command {
    Push(value: i64)
    Pop
    Clear
}

fn run(c: Command) = {
    match c {
        .Push(value: v) => {
            io::println("push")
            io::printInt(v)
        }
        .Pop => {
            io::println("pop")
        }
        .Clear => io::println("clear")
    }
}

fn main(): i64 = {
    run(Command::Push(5))
    run(Command::Pop)
    run(Command::Clear)
    0
}
