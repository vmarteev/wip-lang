// Arithmetic on literals alone takes the type expected of it, as a literal
// does: `input.frameTime = 1.0 / 60.0`.

import std::io

struct Frame {
    time: f32
}

fn half(): f32 = 1.0 / 2.0

fn main() = {
    var frame = Frame(time: 0.0)
    frame.time = 1.0 / 60.0
    val step: f32 = 2.0 * 3.0 - 0.5
    var mask: u8 = 0
    mask = 1 << 3 | 1
    val wide: i128 = 1 << 100
    io::println("\(frame.time > 0.016 && frame.time < 0.017) \(step) \(half()) \(mask) \(wide)")
}
