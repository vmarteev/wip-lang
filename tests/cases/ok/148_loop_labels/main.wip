// A loop may have a name, and `break` and `continue` may say which loop
// they mean. Without a name they mean the innermost, as
// they always have.
//
// Leaving two loops at once was a flag and a second test; the name says
// it where the jump is.
//
// Expected output: 23 (the first pair whose product is six, found by
// leaving both loops), 200 (an inner loop that starts the outer one's
// next pass), 3 (the innermost, unnamed), and 12 (a name on a `while`).

import std::io

fn main() = {
    var found = 0
    rows: for r in 0..5 {
        for c in 0..5 {
            if r * c == 6 {
                found = r * 10 + c
                break rows
            }
        }
    }
    io::printInt(found)

    var total = 0
    outer: while total < 100 {
        var i = 0
        while i < 10 {
            i += 1
            if i == 3 {
                continue outer
            }
            total += 100
        }
        total += 1000
    }
    io::printInt(total)

    var n = 0
    for i in 0..10 {
        if i > 2 {
            break
        }
        n += 1
    }
    io::printInt(n)

    // A name on the innermost loop is allowed, and means what `break`
    // means without it.
    var m = 0
    counting: while m < 12 {
        m += 1
        if m == 12 {
            break counting
        }
    }
    io::printInt(m)
}
