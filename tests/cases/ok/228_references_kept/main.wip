// A `&` reference is a view: a type argument, a local, a
// variant's payload, a `var` pointed somewhere else, and a binding of a
// payload may each hold one, and each borrows what it points into.

import std::io

struct Node {
    called: String
    size: i64
}

struct Tree {
    nodes: Vec<Node>
}

extend Tree {
    /// The node called `key`, by reference, or nothing.
    fn find(key: str): Option<&Node> = {
        for i in 0..self.nodes.len() {
            if self.nodes[i].called == key {
                return .Some(&self.nodes[i])
            }
        }
        return .None
    }

    /// The nodes larger than `size`, by reference.
    fn larger(size: i64): Vec<&Node> = {
        var found: Vec<&Node> = Vec()
        for i in 0..self.nodes.len() {
            if self.nodes[i].size > size {
                found.push(&self.nodes[i])
            }
        }
        return move found
    }
}

fn sizeOf(node: &Node): i64 = node.size

enum List {
    Cons(value: i64, next: own<List>)
    Nil
}

/// A list walked by a reference pointed at each link in turn: the bindings
/// point into the list, not into `at`, which moves on while they are used.
fn sum(list: &List): i64 = {
    var total = 0
    var at: &List = &list
    while at is .Cons(value, next) {
        total += value
        at = &next
    }
    return total
}

/// Points the caller's variable at `other` where it is larger: a `&var` to
/// a `&` reference points it somewhere else.
fn keepLarger(at: &var &Node, other: &Node) = {
    if other.size > at.size {
        at = &other
    }
}

fn main() = {
    var nodes: Vec<Node> = Vec()
    nodes.push(Node(called: String::of("a"), size: 1))
    nodes.push(Node(called: String::of("b"), size: 2))
    nodes.push(Node(called: String::of("c"), size: 3))
    val tree = Tree(nodes: move nodes)

    // Bound from what a call answers, and from a place.
    match tree.find("b") {
        .Some(node) => io::println("\(node.called) is \(node.size)")
        .None => io::println("no b")
    }
    val found = tree.find("c")
    if found is .Some(node) {
        io::println("\(node.called) is \(sizeOf(&node))")
    }
    if tree.find("z") is .None {
        io::println("no z")
    }

    // In a local, and pointed somewhere else.
    val first: &Node = &tree.nodes[0]
    var at: &Node = &tree.nodes[0]
    at = &tree.nodes[2]
    io::println("\(first.called), then \(at.called)")
    var largest: &Node = &tree.nodes[0]
    keepLarger(&var largest, &tree.nodes[1])
    val copied: &Node = largest
    io::println("the largest so far is \(copied.called)")

    // Many, in a `Vec`.
    val larger = tree.larger(1)
    io::println("\(larger.len()) larger: \(larger[0].called) and \(larger[1].called)")

    val list = List::Cons(value: 1, next: own List::Cons(value: 2, next: own List::Nil))
    io::println("the list adds up to \(sum(&list))")

    // A reference chosen by an `if`, as an argument.
    val pick = true
    io::println("\(sizeOf(if pick { &tree.nodes[1] } else { &tree.nodes[2] }))")
}
