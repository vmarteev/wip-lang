// Ownership nests: structs hold `own` fields, arrays hold `own` elements, and
// `own` wraps `own`. `own<own<i64>>` also checks that `>>` lexes as two `>`.

struct Engine {
    power: i64
}

struct Wheel {
    size: i64
}

struct Car {
    engine: own<Engine>
    wheels: [own<Wheel>; 2]
}

fn build(size: i64): own<Car> = {
    return own Car(
        engine: own Engine(power: 150),
        wheels: [own Wheel(size: size), own Wheel(size: size)],
    )
}

fn boxedTwice(): own<own<i64>> = {
    own own 1
}

fn main(): i64 = {
    val car = build(17)
    val deep = boxedTwice()
    car.engine.power - 150 + car.wheels[1].size - 17
}
