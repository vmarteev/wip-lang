// An integer is taken as a wider integer type that holds every value of
// it, with no `as`: an argument, a field, a variant's value, an element,
// an assignment and `+=`, a `return`, a typed `val`, a byte literal, a C
// type; beside a wider operand of an arithmetic, a bitwise or a comparison
// operator, which is then done in the wider type; and among the branches
// of an `if`, the arms of a `match` and the elements of an array, which
// are of the type that holds them all.
//
// Expected output:
// 400 -3
// 200 -5
// 70000
// 1200
// 1400 70000000 true true 204
// 200
// 200 1200 1000 70000
// 120 -5 70000 70000

import std::io

struct Point {
    x: i64
    y: i64
}

enum Size {
    Bytes(count: u64)
    Unknown
}

fn twice(n: i64): i64 = n * 2

fn status(code: c_int): i64 = code

fn main() = {
    val b: u8 = 200
    val c: u16 = 1000
    val w: u32 = 70000
    val s: i8 = -5
    io::println("\(twice(b)) \(status(-3))")
    val p = Point(x: b, y: s)
    io::println("\(p.x) \(p.y)")
    val size = Size::Bytes(count: w)
    if size is .Bytes(count) then io::println("\(count)")
    var total: i64 = 0
    total = c
    total += b
    io::println("\(total)")
    val sum = b + total
    val product = c * w
    val low = b | 4 as u16
    io::println("\(sum) \(product) \(b == 200) \(s < total) \(low)")
    var grown: Vec<i64> = Vec()
    grown.push(b)
    io::println("\(grown[0])")
    val chosen = if b > 100 then b else total
    val other = if b > 100 then total else b
    val arm = match b {
        200 => c
        _ => w
    }
    val array = [b, c, w]
    io::println("\(chosen) \(other) \(arm) \(array[2])")
    val byte: i64 = b'x'
    val signed: i64 = s
    val huge: u128 = w
    val address: usize = w
    io::println("\(byte) \(signed) \(huge) \(address)")
}
