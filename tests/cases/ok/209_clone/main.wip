// A copy of a value: `clone` on what the prelude and the
// collections implement it for, and on what asks `@derive(Clone)` — a
// struct with a `Vec<String>`, an enum, a generic struct and one inside
// another — each copy owning what it holds, so changing it leaves the
// value it came from as it was.
//
// Expected output: "a [x] [x, y]", then "circle c", then "l r", then "2 1".

import std::collections::{Map}
import std::io

@derive(Clone)
struct Row {
    name: String
    tags: Vec<String>
    size: i64
}

@derive(Clone)
enum Shape {
    Circle(r: f64, label: String)
    Dot
}

@derive(Clone)
struct Pair<T> {
    left: T
    right: T
}

@derive(Clone)
struct Table {
    rows: Vec<Row>
    names: Map<String, i64>
}

fn listed(tags: &Vec<String>): String = {
    var out = String::of("[")
    for i in 0..tags.len() {
        if i > 0 {
            out.push(", ")
        }
        out.push(tags[i].toStr())
    }
    out.push("]")
    return move out
}

fn main() = {
    var tags: Vec<String> = Vec()
    tags.push("x")
    val row = Row(name: "a", tags: move tags, size: 3)
    var copy = row.clone()
    copy.tags.push("y")
    io::println("\(copy.name) \(listed(&row.tags)) \(listed(&copy.tags))")

    match Shape::Circle(r: 1.5, label: "c").clone() {
        .Circle(r, label) => io::println("circle \(label)")
        .Dot => io::println("dot")
    }
    assert(Shape::Dot.clone() is .Dot)

    val pair = Pair(left: String::of("l"), right: String::of("r"))
    val other = pair.clone()
    io::println("\(other.left) \(other.right)")

    var table = Table(rows: Vec(), names: Map())
    table.rows.push(row.clone())
    table.names.put("a", 1)
    var bigger = table.clone()
    bigger.rows.push(row.clone())
    bigger.names.put("b", 2)
    assert(table.names.len() == 1 && bigger.names.len() == 2)
    io::println("\(bigger.rows.len()) \(table.rows.len())")

    // What owns nothing is its own clone.
    assert(7.clone() == 7 && 'c'.clone() == 'c' && "s".clone() == "s" && true.clone())
    val maybe: Option<String> = .Some("m")
    assert(maybe.clone() == .Some("m"))
    val both = (String::of("p"), 2)
    assert(both.clone().0 == "p")
}
