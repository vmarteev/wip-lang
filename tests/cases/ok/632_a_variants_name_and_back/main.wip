// An enum whose variants carry nothing answers `name()`, the name its
// variant is written with, and `fromName(text)`, the variant of that name
// or nothing: exactly, so a word in another case or a part of a name is
// nothing. Each name is a `str` the program keeps, so it outlives the value
// it was asked of. A generic enum of names has both, an enum with no
// variants reads nothing back, a program's own `name` is kept, and a
// constant may name a variant.
//
// Expected output:
// Push Pull Carry
// Carry none none none
// Push Pull Carry
// kept true
// Second true
// true
// Pull

import std::io

enum Rule {
    Push
    Pull
    Carry
}

enum Kept {
    One
    Two
}

extend Kept {
    fn name(): str = "kept"
}

enum Slot<T> {
    First
    Second
}

enum Nothing {}

@comptime
val PULLED: str = Rule::Pull.name()

fn label(rule: Rule): str = rule.name()

fn shown(rule: Option<Rule>): str = match rule {
    .Some(found) => found.name()
    .None => "none"
}

fn main() = {
    val labels = Rule::all().map((rule) => rule.name())
    io::println(labels.join(" "))
    io::println("\(shown(Rule::fromName("Carry"))) \(shown(Rule::fromName("carry"))) \(shown(Rule::fromName("Pul"))) \(shown(Rule::fromName("")))")
    // A name outlives the value it was asked of.
    var names: Vec<str> = Vec()
    for rule in Rule::all() {
        names.push(label(rule))
        assert(Rule::fromName(rule.name()) == rule)
    }
    io::println(names.join(" "))
    io::println("\(Kept::One.name()) \(Kept::fromName("Two") == .Two)")
    io::println("\(Slot<i64>::Second.name()) \(Slot<i64>::fromName("First") == .First)")
    io::println("\(Nothing::fromName("Anything").isNone())")
    io::println(PULLED)
}
