// `main` may take the program's arguments. `args[0]` is the
// program's name, as in C, and the test harness passes nothing else.
//
// Expected output: 1, 1.

import std::io

fn count(args: &[cstring]): i64 = args.len()

fn main(args: &[cstring]): i64 = {
    io::printInt(args.len())
    io::printInt(count(&args))
    0
}
