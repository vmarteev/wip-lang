// An opaque C type may be a type argument where the generic only points at
// it: a function over `ptr<T>`, its type argument written or inferred, and
// a struct that keeps pointers in a map. A type argument is inferred from
// a pointer, as from any type that holds it.
//
// Expected output: the handles made, found by name, and kept in an option.

import std::collections::{Map}
import std::io

extern "C" {
    type Handle
    fn handle_new(n: i64): ptr<Handle>
    fn handle_number(h: ptr<Handle>): i64
}

/// What C makes, through a function that writes it.
fn made<T>(make: &(out: &var ptr<T>) => void): ptr<T> = {
    var out: ptr<T> = null
    make(&var out)
    return out
}

/// The pointer it is given: its type argument inferred from a `ptr<T>`.
fn same<T>(p: ptr<T>): ptr<T> = p

/// What a program has made, by name.
struct Made<T> {
    byName: Map<String, ptr<T>>
}

fn main() = {
    val first = made<Handle>((out) => out = handle_new(1))
    val second: ptr<Handle> = made((out) => out = handle_new(2))
    io::println("made: \(handle_number(first)) \(handle_number(same(second)))")
    var table: Made<Handle> = Made(byName: Map())
    table.byName.put(String::of("second"), second)
    io::println("found: \(handle_number(table.byName.at(String::of("second"))))")
    val kept: Option<ptr<Handle>> = .Some(first)
    io::println("kept: \(kept.isSome())")
}
