// `var` takes a value apart into variables of their own:
// each holds its part, so writing one writes nothing else.

import std::io

struct Point {
    x: i64
    y: i64
}

struct Named {
    name: String
    at: Point
}

fn pair(): (i64, String) = (1, String::of("a"))

fn parse(text: str): Option<i64> = if text == "7" { .Some(7) } else { .None }

// With `else`, where the pattern can fail.
fn doubled(text: str): i64 = {
    var .Some(n) = parse(text) else {
        return -1
    }
    n *= 2
    return n
}

fn main() = {
    // A value made here: its parts are the variables'.
    var (n, s) = pair()
    n += 1
    s.push("b")
    io::println("\(n) \(s)")

    // Plain data from a place is copied, and the place keeps its own.
    val here = Point(x: 1, y: 2)
    var Point(x, y) = here
    x += y
    y = 0
    io::println("\(x) \(y) \(here.x) \(here.y)")

    // What owns memory is taken with `move`, at any depth; what `_` and
    // `..` leave is dropped.
    val named = Named(name: String::of("p"), at: here)
    var Named(name, at: Point(x: across, ..)) = move named
    name.push("q")
    across -= 10
    io::println("\(name) \(across)")
    var (count, _) = pair()
    count += 1

    // A place's plain parts, leaving what owns memory where it is.
    val kept = pair()
    var (first, _) = kept
    first += kept.1.len()
    io::println("\(count) \(first) \(kept.1)")

    io::println("\(doubled("7")) \(doubled("x"))")

    // A view is copied, and still borrows what it did.
    var (length, text) = (0, "word")
    length += text.len()
    text = "other"
    io::println("\(length) \(text)")
}
