// A struct with no fields written as its name alone: one that implements an
// interface, one that derives what it compares and prints with, and a
// generic one; each built, as any struct is, by a call with no arguments.
//
// Expected output: csv md, then Csv() true, then 0.

import std::io

interface Format {
	fn extension(): str
}

@derive(Eq, Text)
pub struct Csv

pub struct Markdown

struct Tag<T>

extend Csv: Format {
	fn extension(): str = "csv"
}

extend Markdown: Format {
	fn extension(): str = "md"
}

extend Tag<T> {
	fn count(): i64 = 0
}

fn main() = {
	io::println("\(Csv().extension()) \(Markdown().extension())")
	val csv = Csv()
	io::println("\(csv) \(csv == Csv())")
	val tag: Tag<String> = Tag()
	io::println("\(tag.count())")
}
