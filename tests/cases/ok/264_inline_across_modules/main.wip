// An `@inline` function of another module is spliced here, with its body,
// which calls a function and reads a table that module keeps to itself:
// those are the program's, so this module's code can reach them.
//
// Expected output: 1100, which is (1 + 10) × 100.

import counts
import std::io

fn main() = {
	io::println("\(counts::scaled(1))")
}
