// An `@inline` function whose body calls what its module keeps to itself:
// a private function, and a private constant table.

val STEPS: [i64; 3] = [1, 10, 100]

/// Spliced into its caller, in another module.
@inline
pub fn scaled(n: i64): i64 = step(n) * STEPS[2]

fn step(n: i64): i64 = n + STEPS[1]
