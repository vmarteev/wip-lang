// Trailing commas are accepted in every comma-separated list.
// In brace lists a `,` may also be written where a line break would do.

import std::io

struct Pair {
    a: i64,
    b: i64,
}

enum Choice {
    Left(value: i64,),
    Right(value: i64, extra: i64,),
}

fn add(x: i64, y: i64,): i64 = {
    x + y
}

fn pick(c: Choice): i64 = {
    return match c {
        .Left(value: v) => v,
        .Right(value: v, ..) => v,
    }
}

fn main(): i64 = {
    val p = Pair(a: 1, b: 2,)
    val xs = [1, 2, 3,]
    io::printInt(add(p.a, p.b,))
    io::printInt(pick(Choice::Right(value: 4, extra: 5,),))
    io::printInt(xs[2])
    0
}
