// `yield` hands a value to the list being built: among
// `own [ … ]`'s elements, an `if`, a `for` or a `match` is the statement it
// always is, and adds what it yields; `own for` is the list of what one
// loop yields. The list is an `own<[T]>`, built as it runs, its elements
// moved in; `Vec::fromBuffer` makes one into a vector that grows.

import std::io

fn show(xs: &[i64]): String = {
    var out = String()
    for x in xs {
        out.push("\(x) ")
    }
    move out
}

fn main() = {
    val loud = true
    val quiet = false
    val numbers: own<[i64]> = own [1, if loud { yield 2 }, if quiet { yield 3 }, for i in 10..13 { yield i * 2 }, 99]
    io::println(show(&numbers).toStr())

    val nested = own [
        for i in 0..6 {
            if i % 2 == 0 { yield i / 2 }
        },
        if loud { for j in 0..2 { yield j + 100 } },
        if quiet { yield 1 } else if loud { yield 2 },
    ]
    io::println(show(&nested).toStr())

    // `own for`, and a turn that yields twice or not at all.
    val pairs = own for i in 0..4 {
        if i == 2 {
            continue
        }
        yield i
        yield i * 10
    }
    io::println(show(&pairs).toStr())

    // A plain `if … else` is still one value.
    val chosen = own [if loud { 7 } else { 8 }, for i in 0..1 { yield i }]
    io::println(show(&chosen).toStr())

    // A match whose arms yield.
    val maybe: Option<i64> = .Some(5)
    val found = own [
        match maybe {
            .Some(v) => { yield v }
            .None => {}
        },
        0,
    ]
    io::println(show(&found).toStr())

    // Strings moved in, and a grid.
    val names: own<[String]> = own for i in 0..3 { yield String::of("n\(i)") }
    for name in names {
        io::print(name.toStr())
    }
    io::println("")
    val cells = own for y in 0..2 {
        for x in 0..3 { yield y * 10 + x }
    }
    io::println(show(&cells).toStr())

    // A list built inside a list's loop is a list of its own.
    val rows = own for r in 0..2 {
        val row: own<[i64]> = own for c in 0..2 { yield r * 2 + c }
        yield row[0] + row[1]
    }
    io::println(show(&rows).toStr())

    var growing = Vec::of(own for i in 0..2 { yield String::of("g\(i)") })
    growing.push(String::of("more"))
    io::println("\(growing.len())")
}
