// Slices. One function works on arrays of any length: an
// array passes as a slice, and `&xs[lo..hi]` passes part of one, with each
// bound optional. Inside the function a slice parameter is indexed, has a
// `len`, is written through `&var`, and is sliced again to pass on. Arrays
// held in an `own` and arrays of `own` values work too.
//
// Expected output: 6 36 12 15 3 36 0 10 21 30 9 4.

import std::io

struct Item {
    weight: i64
}

fn sum(xs: &[i64]): i64 = {
    var total = 0
    var i = 0
    while i < xs.len() {
        total = total + xs[i]
        i = i + 1
    }
    total
}

fn fill(xs: &var [i64], value: i64) = {
    var i = 0
    while i < xs.len() {
        xs[i] = value
        i = i + 1
    }
}

fn firstHalf(xs: &[i64]): i64 = sum(&xs[..xs.len() / 2])

fn heaviest(items: &[own<Item>]): i64 = {
    var best = 0
    var i = 0
    while i < items.len() {
        if items[i].weight > best {
            best = items[i].weight
        }
        i = i + 1
    }
    best
}

fn main(): i64 = {
    val small = [1, 2, 3]
    val large = [1, 2, 3, 4, 5, 6, 7, 8]
    io::printInt(sum(&small))
    io::printInt(sum(&large))
    io::printInt(sum(&large[2..5]))
    io::printInt(sum(&large[6..]))
    io::printInt(sum(&large[..2]))
    io::printInt(sum(&large[..]))
    io::printInt(sum(&large[4..4]))
    io::printInt(firstHalf(&large))

    var zeros = [0; 5]
    fill(&var zeros[1..4], 7)
    io::printInt(sum(&zeros))

    val boxed = own [10, 20]
    io::printInt(sum(&boxed))

    val items = [own Item(weight: 3), own Item(weight: 9), own Item(weight: 4)]
    io::printInt(heaviest(&items))
    io::printInt(heaviest(&items[2..]))
    0
}
