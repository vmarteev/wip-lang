// A method comes with its type: using `Rect` is enough to call its methods,
// and only what is `pub` is visible outside its module.
//
// Expected output: 25 (a `static fn` and a `var fn` of another module), 1
// (a `static fn` that calls another of its own type), and 5 (a method of a
// generic type of another module).

import std::io

import shapes
import shapes::{Rect as Box}

fn main() = {
    var r = shapes::Rect::square(3)
    r.grow(2)
    io::printInt(r.area())
    io::printInt(shapes::Rect::unit().area())
    val b = Box::square(2)
    io::printInt(b.area() + shapes::Counted<i64>::one(2).value())
}

