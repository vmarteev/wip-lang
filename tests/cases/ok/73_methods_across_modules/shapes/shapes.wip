pub struct Rect {
    width: i64
    height: i64

    pub static fn square(side: i64): Rect = Rect(width: side, height: side)
    pub static fn unit(): Rect = Rect::square(1)
    pub fn area(): i64 = self.width * self.height
    pub var fn grow(by: i64) = {
        self.width += by
        self.height += by
    }
}

pub struct Counted<T> {
    item: T
    count: i64

    pub static fn one(item: T): Counted<T> = Counted(item: move item, count: 1)
    pub fn value(): i64 = self.count
}
