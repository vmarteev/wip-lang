// A tuple written as a `match`'s scrutinee is not built: each element is
// matched where it is, as a `match` on it alone would match it.
// Two references are compared through what they refer to,
// a local is written through its binding, `move` takes, and what an arm
// leaves of a taken value is dropped.

import std::io

enum Shape {
    Circle(radius: i64)
    Named(name: String)
}

/// Neither is copied: `Shape` holds a `String`.
fn same(a: &Shape, b: &Shape): bool = match (a, b) {
    (.Circle(radius: x), .Circle(radius: y)) => x == y
    (.Named(name: x), .Named(name: y)) => x == y
    _ => false
}

/// Both taken: what an arm binds it owns, and the rest is dropped.
fn describe(a: Shape, b: Shape): String = match (move a, move b) {
    (.Named(name: n), .Circle(radius: r)) => "\(n) and \(r)"
    (.Named(name: n), .Named(name: m)) => "\(n) with \(m)"
    _ => String::of("other")
}

/// A guard reads the bindings of both.
fn larger(a: &Shape, b: &Shape): bool = match (a, b) {
    (.Circle(radius: x), .Circle(radius: y)) if x > y => true
    _ => false
}

fn main() = {
    val x = Shape::Named(name: String::of("x"))
    val y = Shape::Named(name: String::of("x"))
    val c = Shape::Circle(radius: 3)
    io::println("\(same(&x, &y)) \(same(&x, &c)) \(same(&c, &c))")
    io::println("\(larger(&c, Shape::Circle(radius: 1))) \(larger(&c, &x))")

    // A binding into a local writes the local.
    var p = Shape::Named(name: String::of("p"))
    val q = Shape::Circle(radius: 1)
    match (p, q) {
        (.Named(name: n), .Circle(radius: r)) => {
            n.push("!")
            io::println("\(n) \(r)")
        }
        _ => {}
    }
    io::println("\(p is .Named(name: n) && n == "p!")")

    io::println(describe(Shape::Named(name: String::of("left")), Shape::Circle(radius: 2)))
    io::println(describe(Shape::Named(name: String::of("left")), Shape::Named(name: String::of("right"))))
    io::println(describe(Shape::Circle(radius: 1), Shape::Circle(radius: 2)))

    // Three, of plain data and a call's result.
    val kind = match (1, c, String::of("abc").len()) {
        (1, .Circle(radius: r), 3) => r
        _ => 0
    }
    io::println("\(kind)")
}
