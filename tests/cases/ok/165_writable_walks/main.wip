// A `for` over a container in a `var` may write the elements it visits, as one
// over an array in a `var` always could: the loop takes the writing half of the
// container's lending pair. A container that cannot change is walked for
// reading.

import std::io

struct Ball {
    x: i64,
    age: i64
}

fn main() = {
    var numbers = Vec::of(own [1, 2, 3])
    for n in numbers {
        n = n * 10
    }
    io::println("\(numbers[0]) \(numbers[1]) \(numbers[2])")

    var balls: Vec<Ball> = Vec()
    balls.push(Ball(x: 1, age: 0))
    balls.push(Ball(x: 2, age: 0))
    for ball in balls {
        ball.age += 5
        ball.x += ball.age
    }
    for Ball(x, age) in balls {
        io::println("\(x) \(age)")
    }

    // Reading the rest of the vector while one element is written.
    for n in numbers {
        n += numbers.len()
    }
    io::println("\(numbers[0])")

    val fixed = Vec::of(own [1, 2])
    var total = 0
    for n in fixed {
        total += n
    }
    io::printInt(total)
}
