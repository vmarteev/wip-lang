// Calls that were found wrong while the iterator adapters were written:
//
// - a closure called inside a generic function answers a type parameter,
//   and each instance calls it with its own types — the type it was called through was left generic, and what it
//   answered read as zero;
// - a closure, or a `dyn` method, that answers a struct or a `String`
//   writes it where it goes — the compiler stopped at it;
// - an interface's default method, called on a type that implements it,
//   knows the interface's own types from that implementation.

import std::io

struct Holder<T, U> {
    f: own<(x: T) => U>
}

extend Holder<T, U> {
    fn wrapped(x: T): Option<U> = .Some(self.f(move x))

    fn bare(x: T): U = self.f(move x)
}

fn apply<T, U>(f: &(x: T) => U, x: T): Option<U> = .Some(f(move x))

struct Point {
    x: i64,
    y: i64
}

interface Maker {
    fn make(n: i64): Point
}

struct Doubler {
    k: i64
}

extend Doubler: Maker {
    fn make(n: i64): Point = Point(x: n * self.k, y: n)
}

fn build(maker: &dyn Maker): i64 = {
    val p = maker.make(3)
    p.x + maker.make(1).x
}

interface Source<T> {
    var fn take(): T

    /// A default that names the interface's own type.
    var fn twice(): (T, T) = {
        val first = self.take()
        (move first, self.take())
    }
}

struct Counter {
    at: i64
}

extend Counter: Source<i64> {
    var fn take(): i64 = {
        self.at += 1
        self.at
    }
}

fn main() = {
    val times = Holder(f: own (x: i64) => x * 10)
    match times.wrapped(3) {
        .Some(v) => io::printInt(v),
        .None => {}
    }
    io::printInt(times.bare(4))
    match apply((x: i64) => x + 1, 3) {
        .Some(v) => io::printInt(v),
        .None => {}
    }
    val named = Holder(f: own (n: i64) => String::of("n\(n)"))
    io::println(named.bare(7).toStr())

    val point = own (n: i64) => Point(x: n, y: n + 1)
    io::printInt(point(5).y)
    val doubler = Doubler(k: 2)
    io::printInt(build(&doubler))

    var counter = Counter(at: 0)
    val (a, b) = counter.twice()
    io::printInt(a + b * 10)
}
