// `extern union`: one value of several, over the same bytes, as C writes it.
// Every field is at offset 0, and the union is as large as
// its largest field rounded up to the largest alignment — the one C layout
// that is the same on every target Wip supports, which is why the compiler
// works it out rather than asking C.
//
// `Event {}` is every byte zero, the way a C program calls `memset` before
// it hands the event to the library. A literal that names a field zeroes
// the rest of the bytes and writes that one.
//
// Nothing says which field is live: a union has no tag, so reading one is a
// reinterpretation of whatever is there. A program that wants to be asked
// writes an enum, which is tagged and checked.
//
// Expected output: the size and alignment C agrees with; 0 from a zeroed
// event; what C filled in, read back through two different fields; and the
// bytes of the first field seen as bytes.

import std::io

extern struct KeyboardEvent {
    kind: u32,
    timestamp: u32,
    keysym: c_int
}

extern union Event {
    kind: u32,
    key: KeyboardEvent,
    padding: [u8; 24]
}

extern "C" {
    fn event_size(): i64
    fn event_align(): i64
    fn fill_key(event: &var Event, keysym: c_int)
}

fn main() = {
    io::println("size \(event_size()), align \(event_align())")

    var event = Event()
    io::println("zeroed \(event.kind)")

    // C fills it in, through the pointer a `&var` passes.
    fill_key(&var event, 65 as c_int)
    io::println("kind \(event.kind), keysym \(event.key.keysym)")

    // The same bytes, read as the other fields.
    io::println("first field again \(event.key.kind), byte \(event.padding[0])")

    // Written as one field, read as another: what a union is for.
    event = Event(key: KeyboardEvent(kind: 1024 as u32, timestamp: 0 as u32, keysym: 90 as c_int))
    io::println("kind now \(event.kind)")
}
