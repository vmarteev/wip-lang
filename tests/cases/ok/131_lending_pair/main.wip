// One name for the accessor that reads and the one that writes.
// A type may declare `fn at(…): &T` beside `var fn at(…): &var T`, and where
// the call sits says which is meant: the left of an assignment, an argument
// passed `&var`, or what a `&var` projection lends takes the writing one, and
// everything else the reading one.
//
// This is what `atVar`, `itemsVar` and `topVar` were: the caller saying
// what the callee should have worked out.
//
// Expected output: 1 (read), 9 (written through the pair), 7 (written two
// accessors deep), 3 (a vector's own pair, which the prelude now uses),
// and 12 (a slice lent `&var` and sorted in place).

import std::io

struct Card {
    rank: i64
}

struct Deck {
    cards: Vec<Card>

    pub fn at(index: i64): &Card = lend self.cards.at(index)
    pub var fn at(index: i64): &var Card = lend self.cards.at(index)
}

struct Table {
    deck: Deck

    pub fn top(): &Card = lend self.deck.at(0)
    pub var fn top(): &var Card = lend self.deck.at(0)
}

fn double(xs: &var [i64]) = {
    for x in xs {
        x = x * 2
    }
}

fn main() = {
    var deck = Deck(cards: Vec<Card>())
    deck.cards.push(Card(rank: 1))
    io::printInt(deck.at(0).rank)

    // The same name, where a write happens.
    deck.at(0).rank = 9
    io::printInt(deck.at(0).rank)

    var table = Table(deck: move deck)
    table.top().rank = 7
    io::printInt(table.top().rank)

    // The prelude's `Vec` has the pair too.
    var numbers = Vec<i64>()
    numbers.push(3)
    io::printInt(numbers.at(0))
    numbers.at(0) += 3
    double(&var numbers.items())
    io::printInt(numbers.at(0))
}
