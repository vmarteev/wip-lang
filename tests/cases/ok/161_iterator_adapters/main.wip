// Every iterator has adapters, which answer another iterator and keep an
// owned closure, and consumers, which walk it to its end and are lent one.
// An adapted view is a view, checked as one.

import std::io

/// Counts down to one: an iterator that is not a view.
struct Countdown {
    left: i64
}

extend Countdown: Iterator<i64> {
    var fn next(): Option<i64> = {
        if self.left == 0 {
            return .None
        }
        self.left -= 1
        .Some(self.left + 1)
    }
}

fn main() = {
    val text = "the quick brown fox"

    // Adapters.
    for (i, w) in text.split(" ").enumerate() {
        io::println("\(i): \(w)")
    }
    val lengths = text.split(" ").map(own (w) => w.len()).toVec()
    io::println("\(lengths.len()) words, the first \(lengths[0]) long")
    for w in text.split(" ").filter(own (w) => w.len() > 3) {
        io::println(w)
    }
    for w in text.split(" ").skip(1).take(2) {
        io::println(w)
    }
    for (w, n) in text.split(" ").zip(Countdown(left: 3)) {
        io::println("\(w) \(n)")
    }
    var shouted = String()
    for c in text.chars().map(own (c) => c.toAsciiUpper()) {
        shouted.pushChar(c)
    }
    io::println(shouted.toStr())

    // Consumers: a lent closure reads what is around it.
    io::println("\(text.chars().count()) characters")
    io::println("\(text.split(" ").fold(0, (sum, w) => sum + w.len())) letters")
    val prefix = "br"
    io::println("\(text.split(" ").find((w) => w.startsWith(prefix)))")
    io::println("\(text.split(" ").find((w) => w.startsWith("z")))")
    io::println("\(text.chars().any((c) => c == 'q')) \(text.chars().all((c) => c.isAsciiLetter()))")
    io::println("\(Countdown(left: 4).map(own (n) => n * n).fold(0, (sum, n) => sum + n))")

    // A consumer on an adapter whose element type is written out of the
    // type's parameters — `Zipped<I, T, J, V>: Iterator<(T, V)>` — is a
    // consumer like any other: the arguments are read with the type's own
    // before the constraint is answered.
    io::println("\(text.split(" ").zip(Countdown(left: 3)).count()) pairs")
    val pairs = text.split(" ").zip(Countdown(left: 2)).toVec()
    io::println("\(pairs.len()): \(pairs[0].0) \(pairs[0].1)")
}
