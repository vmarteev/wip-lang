// An index outside the elements panics with the index and the length.
//
// Expected output: 1 and 3 (the elements that are there), then the panic on
// standard error, and status 101.

import std::io

fn main() = {
    val xs = [1, 2, 3]
    var i = 0
    io::printInt(xs[i])
    i = 2
    io::printInt(xs[i])
    i = 5
    io::printInt(xs[i])
}
