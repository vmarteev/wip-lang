// A literal where a `&` of a template is expected builds the template, a
// temporary, and lends it, as a temporary is lent where it is used: a
// function that reads a page or a URL takes a literal as it takes one of
// its own locals.
//
// Expected output: the page, the URL with its holes encoded, and the same
// URL lent from a local.

import std::io
import std::markup::{Html}
import std::url::{Url}

fn show(page: &Html) = io::println(page.toStr())

fn visit(url: &Url) = io::println("\(url.host().unwrap()) \(url.path())")

fn main() = {
	val name = "<Ada>"
	show("<p>\(name)</p>")
	val user = "a b/c"
	visit("https://example.com/users/\(user)")
	val kept: Url = "https://example.com/users/\(user)"
	visit(&kept)
}
