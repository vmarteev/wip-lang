// What a bindings module exports, another module calls: the functions,
// the opaque type they hand back, and the constants beside them.
//
// Expected output: 10 (a counter opened at 4 and added to), 44 (a constant
// of that module), and 7 (what it reaches through a declaration it keeps
// to itself).

import std::io
import text

fn main() = {
    val c: ptr<text::counter> = text::counter_open(4)
    defer text::counter_close(c)
    io::println("\(text::counter_add(c, 6))")
    io::println("\(text::SEPARATOR)")
    io::println("\(text::hidden())")
}
