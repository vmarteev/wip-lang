// A module of bindings: `pub` exports a C declaration, so that the module
// is the unit people share rather than every program declaring the C
// functions it calls.

pub val SEPARATOR: c_int = 44

extern "C" {
    // An opaque C type is exported the same way, since a caller that names
    // it — `ptr<text::counter>` — needs the name.
    pub type counter

    pub fn counter_open(start: c_int): ptr<counter>
    pub fn counter_add(c: ptr<counter>, by: c_int): c_int
    pub fn counter_close(c: ptr<counter>)

    // Kept to this module: nothing outside it may call this one.
    fn counter_secret(): c_int
}

// The module can use what it keeps to itself.
pub fn hidden(): i64 = counter_secret() as i64
