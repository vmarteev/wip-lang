// A template may finish what a literal built: where it declares
// `move fn finished(): Self`, the literal's block ends by giving it what
// the pieces built, and its answer is the literal's value. A `Location` it
// takes is the literal's.
//
// Expected output: the line, trimmed and ended, and where it was written.

import std::io

struct Line {
	text: String
	at: String = String()
}

extend Line: Template {
	static fn withCapacity(capacity: i64): Line = Line(text: .withCapacity(capacity))

	var fn pushLiteral(text: str) = self.text.push(text)

	var fn pushBuilt(built: &Line, implicit at: Location) = self.text.push(built.text.toStr())
}

extend Line {
	var fn pushValue<T: Text>(value: &T) = value.appendTo(&var self.text)

	/// The text trimmed and ended with a line break, and the line it was
	/// written on.
	move fn finished(implicit at: Location): Line = Line(
		text: "\(self.text.trim())\n",
		at: "line \(at.line)",
	)
}

fn main() = {
	val name = "Ada"
	val line: Line = "  hello, \(name)  "
	io::print(line.text.toStr())
	io::println(line.at.toStr())
}
