// A constant takes the integer type expected of it in every function,
// whatever another function before it held: a byte literal, which is a
// `u8` alone, in one function is not taken for the constant at the same
// place in the next.
//
// Expected output: the byte, and the constant as a `u32`.

import std::io

val FLAG: i32 = 4

fn byte(): u8 = b'x'

fn flag(): u32 = FLAG

fn main() = io::println("\(byte()) \(flag())")
