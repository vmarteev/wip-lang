// A method says `keeps self` where it keeps what its receiver holds or
// borrows in a `&var` argument: a `fn` filling a list with views of its
// receiver's fields, through an interface, and the list filled again;
// `self` beside another name; a view's method keeping what the view
// borrows; and a `move fn` keeping its receiver.
//
// Expected output:
// 3 apple
// 2 cherry
// 1 banana
// 4 apple
// 2

import std::io

struct Shelf {
    names: Vec<String>
}

view struct Label {
    text: str
}

interface Labels {
    fn labelled(labels: &var Vec<Label>) keeps self
}

extend Shelf: Labels {
    /// A label for each name, into `labels`.
    fn labelled(labels: &var Vec<Label>) keeps self = {
        labels.clear()
        for name in self.names {
            labels.push(Label(text: name.toStr()))
        }
    }
}

extend Shelf {
    /// Its first name, and `extra`, into `labels`.
    fn firstAnd(extra: str, labels: &var Vec<Label>) keeps self, extra = {
        labels.clear()
        labels.push(Label(text: self.names[0].toStr()))
        labels.push(Label(text: extra))
    }
}

view struct Window {
    text: str
}

extend Window {
    /// What the window sees, which is what it borrows.
    fn seen(into: &var Vec<str>) keeps self = into.push(self.text)

    move fn into(all: &var Vec<Window>) keeps self = all.push(self)
}

fn countThrough<L: Labels>(labeller: &L, labels: &var Vec<Label>): i64 keeps labeller = {
    labeller.labelled(&var labels)
    return labels.len()
}

fn main() = {
    val shelf = Shelf(names: Vec::of(own [String::of("apple"), String::of("banana"), String::of("cherry")]))
    var labels: Vec<Label> = Vec()
    shelf.labelled(&var labels)
    io::println("\(labels.len()) \(labels[0].text)")
    shelf.firstAnd("cherry", &var labels)
    io::println("\(labels.len()) \(labels[1].text)")
    val text = String::of("banana")
    var seen: Vec<str> = Vec()
    Window(text: text.toStr()).seen(&var seen)
    io::println("\(seen.len()) \(seen[0])")
    var windows: Vec<Window> = Vec()
    Window(text: text.toStr()).into(&var windows)
    io::println("\(countThrough(&shelf, &var labels) + windows.len()) \(labels[0].text)")
    io::println("\(windows.len() + 1)")
}
