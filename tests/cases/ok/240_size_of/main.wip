// `c::sizeOf` and `c::alignOf` answer what C's `sizeof` and `_Alignof` do,
// padding and all.

import std::c
import std::io
import shapes

fn main() = {
	io::println("\(c::sizeOf<shapes::vertex>() == shapes::vertex_size())")
	io::println("\(c::sizeOf<shapes::mixed>() == shapes::mixed_size())")
	io::println("\(c::alignOf<shapes::mixed>() == shapes::mixed_align())")
	// An array is its elements, one after the other.
	io::println("\(c::sizeOf<[shapes::mixed; 3]>() == 3 * shapes::mixed_size())")
	io::println("\(c::sizeOf<u8>()) \(c::sizeOf<f64>()) \(c::alignOf<u16>())")
	// What C is told a buffer's size is.
	val count: size_t = 6
	io::println("\(count * c::sizeOf<shapes::vertex>())")
}
