// The prelude says one thing one way. An option's and a
// result's functions are lent closures, so they may read what is around
// them, and are asked with `any` and `all` as an iterator and a slice are.
// A named function is lent where a closure is expected. A 128-bit integer
// is written, compared and hashed as any other is. And a vector does what
// the slice it lends does, by the same names.

import std::io
import std::collections::{Set}

fn double(x: i64): i64 = x * 2

fn apply(f: &(x: i64) => i64): i64 = f(3)

fn main() = {
    // Closures that capture, and a named function lent as one.
    val k = 10
    val o: Option<i64> = .Some(2)
    val prefix = "a"
    val word: Option<str> = .Some("apple")
    io::println("\(o.map((x) => x + k)) \(o.map(double)) \(o.filter((x) => x > k))")
    io::println("\(word.any((w) => w.startsWith(prefix))) \(o.all((x) => x < k))")
    val r: Result<i64, str> = .Ok(5)
    io::println("\(r.map((x) => x * k)) \(r.any((x) => x > k)) \(r.fold((e) => 0, (x) => x + k))")
    io::printInt(apply(double))

    // 128-bit integers.
    val big: u128 = 340282366920938463463374607431768211455
    val small: i128 = -170141183460469231731687303715884105728
    io::println("\(big) \(small) \(-42 as i128) \(0 as u128)")
    var seen: Set<i128> = Set()
    val key: i128 = -42
    seen.add(key)
    io::println("\(seen.contains(&key)) \(big > 1) \(Vec::of(own [3 as i128, 1, 2]).minIndex())")

    // A vector does what its slice does.
    var v = Vec::of(own [1, 2, 3, 4])
    val limit = 2
    io::println("\(v.any((x) => x > limit)) \(v.all((x) => x > 0)) \(v.countWhere((x) => x > limit))")
    v.reverse()
    io::println("\(v[0]) \(v.walk().map(own (x) => x * 10).toVec())")
    v.fill(7)
    io::println("\(v)")
}
