// A list literal where a `Vec` is expected is one, and where a buffer,
// `own<[T]>`, is expected it is built on the heap: in a field, a variant's
// field, an argument, what a function answers, a variable declared or
// assigned as one, an `if`'s and a `match`'s branches, and beside a part
// that says the type. Text in a `Vec<String>` is a `String`, `[]` is an
// empty vector, a repeat and a list that yields are vectors too, and a
// generic `Vec<T>` takes its `T` from the elements.
//
// Expected output:
// 3 b
// 2
// 10
// 2 3
// 1 2
// x y z
// 0 4 3
// 3 20
// 2
// 4 6
// 3 2

import std::io

struct Call {
    args: Vec<i64>
    names: Vec<String>
}

enum Shape {
    Poly(points: Vec<i64>)
    Dot
}

val SIZE: i64 = 3

fn total(xs: Vec<i64>): i64 = {
    var sum = 0
    for x in xs {
        sum += x
    }
    return sum
}

fn count<T>(xs: Vec<T>): i64 = xs.len()

fn buffered<T>(xs: own<[T]>): i64 = xs.len()

fn heap(): own<[i64]> = [7, 8, 9]

fn listed(c: bool): Vec<i64> = if c then [1] else [2, 3]

fn beside(c: bool): i64 = {
    val v = if c then Vec::of(own [1]) else [2, 3]
    val w = match c {
        true => [4]
        false => Vec::of(own [5, 6])
    }
    val both = [Vec::of(own [1]), [2, 3]]
    return v.len() + w.len() + both[1].len()
}

fn main() = {
    val call = Call(args: [1, 2, 3], names: ["a", "b"])
    io::println("\(call.args.len()) \(call.names[1])")
    val shape = Shape::Poly(points: [4, 5])
    if shape is .Poly(points) then io::println("\(points.len())")
    io::println("\(total([1, 2, 3, 4]))")
    io::println("\(count([1.5, 2.5])) \(buffered([1, 2, 3]))")
    io::println("\(listed(true).len()) \(listed(false).len())")
    var names: Vec<String> = ["x", "y"]
    names.append(["z"])
    io::println(names.join(" "))
    val empty: Vec<i64> = []
    val zeros: Vec<i64> = [0; 4]
    val more: Vec<i64> = [1; SIZE]
    io::println("\(empty.len()) \(zeros.len()) \(more.len())")
    val rows = [10, 20]
    val built: Vec<i64> = [1, for r in rows { yield r }]
    io::println("\(built.len()) \(built[2])")
    val nested: Vec<Vec<i64>> = [[1], [2, 3]]
    io::println("\(nested[1].len())")
    io::println("\(beside(true)) \(beside(false))")
    var grow: Vec<i64> = []
    grow = [1, 2]
    grow.push(3)
    val numbers = Vec::of([1, 2])
    io::println("\(grow.len()) \(numbers.len())")
}
