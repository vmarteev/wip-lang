// A C function that takes more than it declares. Cranelift
// cannot make that call, and a front end that tries has to apply C's own
// promotions — `float` to `double`, small integers to `int` — which is
// where Odin and Zig both shipped bugs. So the compiler writes the call in
// C, of fixed arity, and lets `cc` promote:
//
//     extern int32_t printf(const char *a0, ...);
//
//     int32_t wip_shim_131(const char *a0, const char *a1, int32_t a2, double a3) {
//         return printf(a0, a1, a2, a3);
//     }
//
// One declaration per set of types the calls pass, so the two calls below
// that pass the same thing share one wrapper.
//
// Expected output: the four `printf` lines, then what `printf` returned.

import std::io

extern "C" {
    fn printf(fmt: cstring, ...): c_int
}

fn main() = {
    val name: cstring = "wip"
    val count = 3
    val ratio = 0.5

    printf("%s has %d items, %.2f full\n", name, count as c_int, ratio)
    printf("%s has %d items, %.2f full\n", "again", 7 as c_int, 0.25)
    printf("nothing follows the format\n")

    // An `f32` is a `float` parameter of the wrapper, and C promotes it
    // to `double` on the way into `printf` — which is the bug that Odin
    // and Zig both shipped by promoting in the front end.
    val fraction: f32 = 0.125
    printf("a float promotes to %.3f\n", fraction)

    val written = printf("%d\n", 12345 as c_int)
    io::println("printf wrote \(written) bytes")
}
