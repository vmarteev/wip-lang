// A default that is code: a field's, a variant field's
// or a parameter's default may call a function, and runs each time a
// literal or a call leaves it out — after what is written, in the order
// the fields or parameters are declared. It may be of a type that names a
// type parameter, and is then made for the literal's own. A default that
// is a constant is still one, so a `val` may leave its field out.

import std::collections::{Map}
import std::io

fn noted(what: str, value: i64): i64 = {
    io::println("made \(what)")
    return value
}

struct Pending {
    name: String = String::of("untitled")
    keys: Vec<i64> = Vec()
    seen: Map<String, i64> = Map()
    first: i64 = noted("first", 1)
    second: i64 = noted("second", 2)
    size: i64 = 1 + 1
}

struct Holder<T> {
    items: Vec<T> = Vec()
    count: i64 = 0
}

enum Shape {
    Circle(r: i64, labels: Vec<String> = Vec())
    Dot
}

fn greet(name: String = String::of("world"), times: i64 = noted("times", 1)): String = "\(name) x\(times)"

fn listed<T>(first: T, rest: Vec<T> = Vec()): i64 = rest.len() + 1

struct Counter {
    n: i64
}

extend Counter {
    fn plus(by: Vec<i64> = Vec::of(own [1, 2])): i64 = self.n + by.len()
}

struct Plain {
    a: i64 = 1
    b: i64 = 2
}

val PLAIN: Plain = Plain(b: 5)

fn main() = {
    var a = Pending(size: noted("size", 9))
    a.keys.push(1)
    val b = Pending()
    io::println("\(a.name) \(a.keys.len()) \(b.keys.len()) \(a.first) \(b.second) \(a.size) \(b.size)")

    val strings: Holder<String> = Holder()
    var numbers = Holder<i64>(count: 2)
    numbers.items.push(4)
    io::println("\(strings.items.len()) \(numbers.items.len()) \(numbers.count)")

    match Shape::Circle(r: 2) {
        .Circle(r, labels) => io::println("circle \(r), \(labels.len()) labels")
        .Dot => {}
    }

    io::println(greet(times: 2))
    io::println(greet())
    io::println("\(listed(1)) \(listed("a", rest: Vec::of(own ["b"]))) \(Counter(n: 1).plus())")
    io::println("\(PLAIN.a) \(PLAIN.b)")
}
