            arg: str "other "  @21:11..21:20
        expr  @21:20..21:25
          call  @21:20..21:25
            callee: field appendTo  @21:20..21:25
              name other  @21:20..21:25
            arg: unary &var  @21:20..21:25
              name text#  @21:20..21:25
        expr  @21:11..21:27
          unary move  @21:11..21:27
            name text#  @21:11..21:27
fn main  @24:1..41:2
  body: block  @24:13..41:2
    for  @25:2..27:3
      pattern: binding op  @25:6..25:8
      elements: array  @25:12..25:30
        cast  @25:13..25:20
          int 0  @25:13..25:14
          to: u8  @25:18..25:20
        int 1  @25:22..25:23
        int 7  @25:25..25:26
        int 9  @25:28..25:29
