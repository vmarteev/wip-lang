        arg: str "return"  @20:26..20:34
    arm  @21:2..21:27
      pattern: binding other  @21:2..21:7
      body: block  @21:11..21:27
        var text#  @21:11..21:27
          init: call  @21:11..21:27
            callee: path String::withCapacity  @21:11..21:27
            arg: int 14  @21:11..21:27
        expr  @21:11..21:20
          call  @21:11..21:20
            callee: field push  @21:11..21:20
