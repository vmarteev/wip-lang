// A constant's name in a pattern is the value it stands for, as a range's
// end is: a bytecode interpreter's opcodes, a character, a
// `bool` and text, this module's or imported. A name that is no constant
// still binds.
//
// Expected output: constant, add, return, other 9, while, letter, yes.

import std::io
import codes::{OP_RETURN, KEYWORD}

val OP_CONSTANT: u8 = 0
val OP_ADD: u8 = 1
val QUOTE: char = '"'
val LETTERS_END: char = 'z'
val ON: bool = true

fn name(op: u8): String = match op {
	OP_CONSTANT => String::of("constant")
	OP_ADD => String::of("add")
	OP_RETURN => String::of("return")
	other => "other \(other)"
}

fn main() = {
	for op in [0 as u8, 1, 7, 9] {
		io::println(name(op))
	}
	match "while" {
		KEYWORD => io::println(KEYWORD)
		_ => io::println("not a keyword")
	}
	match 'q' {
		QUOTE => io::println("quote")
		'a'..=LETTERS_END => io::println("letter")
		_ => io::println("other")
	}
	match true {
		ON => io::println("yes")
		_ => io::println("no")
	}
}
