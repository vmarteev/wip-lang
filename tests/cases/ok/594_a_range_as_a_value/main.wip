// A range is a value, a `Range` of the integers it counts and an
// iterator: walked with what an iterator has, kept in a variable, read for
// its ends, of any integer type, through the largest value of its type,
// empty where it ends before it starts; and a `for` still counts one, and
// a slice still takes one. It binds looser than every operator but
// assignment.
//
// Expected output:
// true false
// 55
// [0, 1, 2]
// 0 3 false
// 6
// 0
// [1, 4, 9, 16]
// 0
// 2
// 5
// 6 2 3

import std::io

fn main() = {
    val taken = [false, false, true, false]
    io::println("\((0..4).any((i) => taken[i])) \((0..2).any((i) => taken[i]))")
    io::println("\((1..=10).sum())")
    val r = 0..3
    io::println("\(r.toVec())")
    io::println("\(r.start) \(r.end) \(r.inclusive)")
    val small = (250 as u8)..=255
    io::println("\(small.count())")
    io::println("\((5..2).count())")
    io::println("\((1..=4).map((n) => n * n).toVec())")
    for i in (0..3).filter((i) => i != 1) {
        io::println("\(i)")
    }
    val n = 4
    io::println("\((0..n + 1).count())")
    var total = 0
    for i in 0..4 {
        total += i
    }
    val xs = [1, 2, 3, 4, 5]
    io::println("\(total) \(xs[1..3].len()) \(xs[1..=3].len())")
}
