// A value taken out of an enum is the taker's, and the enum it came from
// has nothing left to drop. Zeros say that for an
// `own`, whose pointer becomes null, but not for a type that cleans up
// after itself: its drop would run again, on a value of zeros. So the
// temporary a `match` or a `?` takes from carries a flag.
//
// Expected output: used 1 and dropped 1, then the same for 2 and 3, each
// dropped once and none of them at zero.

import std::io

struct Handle {
    id: i64
}

extend Handle: Destroy {
    var fn destroy() = io::println("dropped \(self.id)")
}

fn made(id: i64): Result<Handle, i64> = .Ok(Handle(id: id))

fn viaTry(id: i64): Result<void, i64> = {
    val held = made(id)?
    io::println("used \(held.id)")
    return .Ok()
}

fn viaMatch(id: i64) = match made(id) {
    .Ok(held) => io::println("used \(held.id)")
    .Err(code) => io::println("unreachable")
}

fn viaGuard(id: i64) = {
    val .Ok(held) = made(id) else {
        io::println("unreachable")
        return
    }
    io::println("used \(held.id)")
}

fn main() = {
    val first = viaTry(1)
    viaMatch(2)
    viaGuard(3)
}
