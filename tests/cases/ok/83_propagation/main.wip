// `expr?`: the value, or an early return of the other
// variant. It reads left to right, works on `Option` and on `Result`, and
// takes what it propagates, so a value that owns memory travels with it.
//
// Expected output: 66 (three calls that all work), 7 and 8 (a failure at the
// first step and at the second), 4 and 9 (`?` on an `Option`), 30 and 105
// (a value and an error that own memory), then 3 and 0 (a `defer` that runs
// where `?` returns, and the value the caller fell back to), with every
// allocation freed.

import std::io

enum OrderError {
    NotFound
    NoPrice
}

fn findOrder(id: i64): Result<i64, OrderError> = if id > 0 {
    .Ok(id * 2)
} else {
    .Err(.NotFound)
}

fn priceOf(order: i64): Result<i64, OrderError> = if order > 2 {
    .Ok(order * 10)
} else {
    .Err(.NoPrice)
}

fn total(id: i64): Result<i64, OrderError> = {
    val order = findOrder(id)?
    val price = priceOf(order)?
    .Ok(price + order)
}

fn firstPositive(value: Option<i64>): Option<i64> = {
    val n = value?
    if n > 0 { .Some(n) } else { .None }
}

struct Token {
    id: i64
}

enum Failure {
    Missing(what: own<Token>)
    Unknown
}

fn find(id: i64): Result<own<Token>, Failure> = if id > 0 {
    .Ok(own Token(id: id))
} else {
    .Err(.Missing(own Token(id: -id)))
}

fn idOf(id: i64): Result<i64, Failure> = {
    val token = find(id)?
    .Ok(token.id * 10)
}

fn describe(result: Result<i64, Failure>): i64 = match move result {
    .Ok(value) => value
    .Err(failure) => match move failure {
        .Missing(what) => 100 + what.id
        .Unknown => -1
    }
}

fn deferred(id: i64): Result<i64, OrderError> = {
    defer io::printInt(3)
    val order = findOrder(id)?
    .Ok(order)
}

fn main() = {
    io::printInt(total(3).unwrapOr(0))
    io::printInt(total(-1).unwrapOr(7))
    io::printInt(total(1).unwrapOr(8))

    io::printInt(firstPositive(.Some(4)).unwrapOr(0))
    io::printInt(firstPositive(.None).unwrapOr(9))

    io::printInt(describe(idOf(3)))
    io::printInt(describe(idOf(-5)))

    io::printInt(deferred(-1).unwrapOr(0))
}
