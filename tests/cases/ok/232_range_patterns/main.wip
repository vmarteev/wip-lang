// A pattern may be a range of integers or characters: `..=` takes its
// end and `..` leaves it out, either end may be left off, and an end may
// be a constant. A `match` whose ranges meet covers its type with no `_`.

import std::io

val LIMIT: i64 = 100

fn class(c: char): str = match c {
    '0'..='9' => "digit"
    'a'..='f' | 'A'..='F' => "hex"
    'g'..='z' => "letter"
    _ => "other"
}

fn size(n: i64): str = match n {
    ..0 => "negative"
    0 => "zero"
    1..=9 => "small"
    10..LIMIT => "medium"
    LIMIT.. => "large"
}

fn half(b: u8): str = match b {
    ..b'a' => "below"
    b'a'..=127 => "ascii"
    128..=255 => "high"
}

fn every(c: char): i64 = match c {
    ..'\u{D7FF}' => 1
    '\u{D7FF}'.. => 2
}

fn tiny(n: i8): str = match n {
    -128..=-1 => "negative"
    0..=127 => "not"
}

fn main() = {
    for c in ['5', 'b', 'Q', 'x', '#'] {
        io::println(class(c))
    }
    for n in [-5, 0, 7, 10, 99, 100, 1000] {
        io::println(size(n))
    }
    io::println("\(half(3)) \(half(b'z')) \(half(200))")
    io::println("\(every('a')) \(every('\u{10FFFF}'))")
    io::println("\(tiny(-3)) \(tiny(3))")
}
