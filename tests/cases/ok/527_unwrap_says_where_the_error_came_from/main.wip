// `unwrap` of an error panics, and in a debug build says after the panic's
// calls where the error came from: where it was made, and the way it came.
// The trace keeps where the error was made and the 31 places nearest the
// `unwrap`, and says how many it left out between, here 9 of the 40 calls
// that passed it on.
//
// Expected output: `ready` on standard output; on standard error, the
// panic, its calls, and the trace, made in `deeper` and passed on in it;
// exit code 101.

import std::io

fn deeper(depth: i64): Result<i64, str> = {
    if depth == 0 then return .Err("too deep")
    val n = deeper(depth - 1)?
    return .Ok(n + 1)
}

fn main() = {
    io::println("ready")
    val n = deeper(40).unwrap()
    io::println("\(n)")
}
