// An item may be for iOS, and a file too, as for a Mac or Linux: each
// target takes its own and drops the others, whose names are then free.
// `apple` is a Mac's and iOS's together, and `macos` a Mac's alone.
//
// Expected output:
// the screen is touched where the system is iOS: true
// Metal draws where the system is Apple's: true

import std::io

@target(os = "ios")
val TOUCHED: bool = true

@target(os = "macos")
@target(os = "linux")
val TOUCHED: bool = false

fn main() = {
	io::println("the screen is touched where the system is iOS: \(TOUCHED == (TARGET_OS == "ios"))")
	io::println("Metal draws where the system is Apple's: \(metal() == (TARGET_VENDOR == "apple"))")
}
