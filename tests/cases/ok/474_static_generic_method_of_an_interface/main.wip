// An interface's method may have type parameters of its own, and its
// implementations name them where the interface does: here a static
// method whose result names an associated type of its own parameter,
// `Result<Self, D::Error>`. Checking an implementation against the
// interface once read the method's parameter as one of the interface's,
// and stopped. Called by the type's name and through a constraint.
//
// Expected output:
// 10 20
// true
import std::io

interface Source<type Error> {
	var fn int(): Result<i64, Error>
	var fn count(): Result<i64, Error>
}

interface Readable {
	static fn read<D: Source>(from: &var D): Result<Self, D::Error>
}

extend i64: Readable {
	static fn read<D: Source>(from: &var D): Result<i64, D::Error> = from.int()
}

struct Pair<T> {
	a: T
	b: T
}

extend Pair<T: Readable>: Readable {
	static fn read<D: Source>(from: &var D): Result<Pair<T>, D::Error> = {
		val a = T::read(&var from)?
		val b = T::read(&var from)?
		return .Ok(Pair(a: move a, b: move b))
	}
}

struct Numbers {
	at: i64
}

extend Numbers: Source<String> {
	var fn int(): Result<i64, String> = {
		self.at += 1
		return if self.at > 3 then .Err(String::of("no more")) else .Ok(self.at * 10)
	}

	var fn count(): Result<i64, String> = .Ok(2)
}

fn read<T: Readable>(from: &var Numbers): Result<T, String> = T::read(&var from)

fn main() = {
	var numbers = Numbers(at: 0)
	val pair: Result<Pair<i64>, String> = read(&var numbers)
	match pair {
		.Ok(p) => io::println("\(p.a) \(p.b)")
		.Err(e) => io::println("error \(e)")
	}
	val again: Result<Pair<i64>, String> = Pair::read(&var numbers)
	io::println("\(again.isErr())")
}
