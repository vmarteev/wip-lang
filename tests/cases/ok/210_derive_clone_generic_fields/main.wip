// `@derive(Clone)` is written as code the checker checks, whose type
// parameters are bound by `Clone`: a `Vec<T>` and a
// `Map<K, V>` field clone where their parameters do, and a parameter keeps
// what its type asks of it — `K: Hash + Eq` — without the annotation
// saying so again.

import std::collections::{Map}
import std::io

@derive(Clone)
struct Table<K: Hash + Eq, V> {
	entries: Map<K, V>
	order: Vec<K>
}

@derive(Clone)
enum Tree<T> {
	Leaf(value: T)
	Node(children: Vec<T>, weight: i64)
	Empty
}

fn shown(tree: &Tree<String>): String = match tree {
	.Node(children, weight) => "node of \(children.len()), weight \(weight)"
	.Leaf(value) => "leaf \(value)"
	.Empty => "empty"
}

fn main() = {
	var table: Table<String, i64> = Table(entries: Map(), order: Vec())
	table.entries.put("a", 1)
	table.order.push("a")
	val copy = table.clone()
	table.entries.put("b", 2)
	table.order.push("b")
	io::println("table \(table.entries.len()) \(table.order.len()), copy \(copy.entries.len()) \(copy.order.len())")

	var children: Vec<String> = Vec()
	children.push("one")
	var tree: Tree<String> = .Node(children: move children, weight: 3)
	val kept = tree.clone()
	if tree is .Node(children, ..) {
		children.push("two")
	}
	io::println("\(shown(&tree)), \(shown(&kept))")
	val leaf: Tree<String> = .Leaf(value: "x")
	match leaf.clone() {
		.Leaf(value) => io::println("leaf \(value)")
		_ => {}
	}
}
