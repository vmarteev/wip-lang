// Struct literals are not allowed at the top level of a condition. Parentheses,
// brackets and call arguments lift the restriction.

struct Point {
    x: i64
    y: i64
}

fn same(a: &Point, b: &Point): bool = {
    a.x == b.x && a.y == b.y
}

fn xOf(p: Point): i64 = {
    p.x
}

fn main(): i64 = {
    val p = Point(x: 1, y: 2)
    if same(&p, Point(x: 1, y: 2)) {
        return 0
    }
    while xOf(Point(x: 0, y: 0)) > 0 {}
    if (Point(x: 1, y: 1)).x == p.x {
        return 1
    }
    if [Point(x: 5, y: 5)][0].y == 5 {
        return 2
    }
    3
}
