// A C string that is null has no text: reading it as text panics, with
// where it was read, rather than reading what is at address zero.
//
// Expected output: the panic, after the line before it.

import std::io

extern "C" {
    fn named(name: cstring): cstring
}

fn main() = {
    val none = named(null)
    io::println("asked")
    io::println(none.toStr())
}
