// A binding of a struct's field, taken apart by `match`, refers to the field,
// and writing through it writes the field, as a variant's binding writes its
// payload: in a local, a field inside a field, through a `&var` parameter,
// and in a `var fn` through `self`.
//
// Expected output:
// 11 2
// 7 9
// 0 0 0
// 2 4 6

import std::io

struct Point {
	x: i64
	y: i64
}

struct Line {
	from: Point
	to: Point
}

struct Vector {
	x: f64
	y: f64
	z: f64
}

extend Vector {
	var fn scale(by: f64) = match self {
		Vector(x, y, z) => {
			x *= by
			y *= by
			z *= by
		}
	}
}

fn zero(v: &var Vector) = match v {
	Vector(x, y, z) => {
		x = 0.0
		y = 0.0
		z = 0.0
	}
}

fn main() = {
	var p = Point(x: 1, y: 2)
	match p {
		Point(x, ..) => x += 10
	}
	io::println("\(p.x) \(p.y)")

	var line = Line(from: Point(x: 1, y: 2), to: Point(x: 3, y: 4))
	match line {
		Line(from: Point(x, ..), to) => {
			x = 7
			to.y = 9
		}
	}
	io::println("\(line.from.x) \(line.to.y)")

	var v = Vector(x: 1.0, y: 2.0, z: 3.0)
	zero(&var v)
	io::println("\(v.x) \(v.y) \(v.z)")
	v = Vector(x: 1.0, y: 2.0, z: 3.0)
	v.scale(2.0)
	io::println("\(v.x) \(v.y) \(v.z)")
}
