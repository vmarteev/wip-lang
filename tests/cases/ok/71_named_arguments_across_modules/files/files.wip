// Defaults are resolved where the function is declared, so a caller need not
// import the types they name.

pub enum Mode {
    Read
    Append
}

pub struct Options {
    pub var mode: Mode
    pub var size: i64
}

pub fn open(path: str, options: Options = Options(mode: Mode::Append, size: 10)): i64 =
    match options.mode {
        .Read => options.size
        .Append => options.size * 2
    }
