// Named arguments and defaults across modules: `open`'s
// default names `Mode` and `Options`, which this module does not import.
//
// Expected output: 20, 3.

import std::io

import files::{self, open}

fn main(): i64 = {
    io::printInt(open("log.txt"))
    io::printInt(open(options: files::Options(mode: files::Mode::Read, size: 3), path: "x"))
    0
}
