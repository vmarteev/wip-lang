// An enum whose variants carry nothing implements `Eq` and `Hash` without
// `@derive`: it compares with `==` and `!=`, and is a key of a map and a
// member of a set. One that writes `Eq` by hand keeps its own, and one
// that asks for `Ord` is ordered as well.
//
// Expected output:
// 2
// 1
// 1

import std::collections::{Map, Set}
import std::io

enum Mode {
    Fit
    Grow
}

@derive(Ord)
enum Size {
    Small
    Large
}

enum Hand {
    Left
    Right
}

// Every hand is as good as the other.
extend Hand: Eq {
    fn equals(other: &Hand): bool = true
}

fn main() = {
    val mode = Mode::Grow
    assert(mode == .Grow)
    assert(mode != .Fit)
    var counts: Map<Mode, i64> = Map()
    counts.put(.Grow, 2)
    counts.put(.Fit, 1)
    val grow = Mode::Grow
    assert(counts.get(&grow).isSome())
    io::printInt(counts.len())
    var seen: Set<Mode> = Set()
    seen.add(.Fit)
    seen.add(.Fit)
    io::printInt(seen.len())
    assert(Size::Small < .Large && Size::Small != .Large)
    assert(Hand::Left == Hand::Right)
    io::printInt(if Hand::Left == .Right then 1 else 0)
}
