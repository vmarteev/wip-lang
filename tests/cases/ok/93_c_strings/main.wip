// `s.toStr()`: a `cstring` is a pointer to bytes that end
// with a NUL, and a `str` is a pointer and a length, so
// turning one into the other means walking to the NUL, once, here. The bytes
// stay C's — nothing is copied, and nothing is freed by Wip.
//
// Expected output: 12 (the length of a string C returns), 12 again (the same
// `str` passed on to a function), 0 (an empty C string), 36 (a string C
// built at run time, freed by C), and hello from C (printed through the
// `cstring` the bytes came from).

import std::io

extern "C" {
    fn text_greeting(): cstring
    fn text_empty(): cstring
    fn text_repeat(s: cstring, times: i64): cstring
    fn text_free(s: cstring)
}

fn describe(text: str): i64 = text.len()

fn main() = {
    val greeting = text_greeting()
    val borrowed = greeting.toStr()
    io::printInt(borrowed.len())
    io::printInt(describe(borrowed))

    io::printInt(text_empty().toStr().len())

    val repeated = text_repeat(greeting, 3)
    defer text_free(repeated)
    io::printInt(repeated.toStr().len())

    io::printCstring(greeting)
}
