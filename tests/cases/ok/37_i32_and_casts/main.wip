// `i32` and `as` conversions. An integer literal takes
// the integer type its context expects. `as` converts between `i64`, `i32` and
// `f64`: narrowing keeps the low bits, and a float converts toward zero,
// saturating at the ends of the range. C's `getpid` returns a `pidT`, an
// `i32` here.

import std::io

extern "C" {
    fn getpid(): i32
}

struct Pair {
    small: i32
    big: i64
}

fn twice(x: i32): i32 = x * 2

fn main(): i64 = {
    val small: i32 = 21
    io::printInt(twice(small) as i64)       // 42
    val max: i32 = 2147483647
    io::printInt((max +% 1) as i64)         // wraps to -2147483648
    val q: i32 = -7
    io::printInt((q / 2) as i64)            // -3
    val big = 5000000000
    io::printInt(big as i32 as i64)         // 705032704
    io::printInt(-1 as i32 as i64)          // -1
    // A literal made another integer type is folded where it is compiled,
    // and must say what the instruction would have: extended by the
    // source's sign, then cut to the target's width.
    io::printInt(-1 as u8 as i64)           // 255
    io::printInt(-129 as i8 as i64)         // 127
    io::printUnsigned(-1 as i8 as u64)      // 18446744073709551615
    io::printInt(300 as u8 as i64)          // 44
    io::printInt('é' as u8 as i64)          // 233
    io::printInt('-' as u8 as i64)          // 45
    io::println("\(-1 as i64 as u128)")     // 340282366920938463463374607431768211455
    io::printFloat(7 as f64 / 2.0)            // 3.5
    io::printInt(-7.9 as i64)               // -7
    io::printInt(1e30 as i64)               // 9223372036854775807
    io::printInt(small as f64 as i32 as i64) // 21
    val pair = Pair(small: 3, big: 4)
    io::printInt(pair.small as i64 + pair.big) // 7
    val xs: [i32; 3] = [1, 2, 3]
    io::printInt(xs[1] as i64)              // 2
    val pid = getpid()
    io::printInt(if pid > 0 { 1 } else { 0 }) // 1
    0
}
