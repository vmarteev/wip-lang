// Walking: a container lends its elements as a slice, and
// `for x in c` walks that slice. One method is the whole protocol, and
// what it hands out is an ordinary `&[T]`, so everything written for a
// slice works on any container that implements it.
//
// Expected output: 7 (a vector walked), 15 and 7 (a deck of cards walked
// and its slice passed on), 9 (a chain: the table lends what the deck
// lends), 201 (a string's bytes), and 7 (the best of a part of a deck),
// with every allocation freed.

import std::io

struct Card {
    rank: i64
}

struct Deck {
    cards: Vec<Card>

    pub static fn of(ranks: &[i64]): Deck = {
        var cards = Vec<Card>()
        for rank in ranks {
            cards.push(Card(rank: rank))
        }
        return Deck(cards: move cards)
    }
}

// The deck is walked through what it lends, which is what its vector
// lends.
extend Deck: Items<Card> {
    fn items(): &[Card] = lend self.cards.items()
}

struct Table {
    deck: Deck
}

extend Table: Items<Card> {
    fn items(): &[Card] = lend self.deck.items()
}

// A slice is a slice, wherever it came from.
fn highest(cards: &[Card]): i64 = {
    var best = 0
    for card in cards {
        if card.rank > best {
            best = card.rank
        }
    }
    return best
}

fn main() = {
    // The prelude's `Vec` lends its elements.
    var numbers = Vec<i64>()
    numbers.push(3)
    numbers.push(4)
    var total = 0
    for n in numbers {
        total += n
    }
    io::printInt(total)

    val deck = Deck::of([2, 6, 7])
    var ranks = 0
    for card in deck {
        ranks += card.rank
    }
    io::printInt(ranks)
    io::printInt(highest(&deck.items()))

    val table = Table(deck: Deck::of([9, 1]))
    io::printInt(highest(&table.items()))

    // A `String` lends its bytes.
    var text = String()
    text.push("de")
    var bytes = 0
    for byte in text {
        bytes += byte as i64
    }
    io::printInt(bytes)

    // What a container lends is a slice, so it slices.
    io::printInt(highest(&deck.items()[1..3]))
}
