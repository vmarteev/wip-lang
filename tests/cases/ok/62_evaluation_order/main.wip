// Operands are evaluated in the order they are written: the
// fields of a struct literal, whatever order the struct declares them in.
// A field that owns memory, finished before a later one leaves the literal,
// is still freed.
//
// Expected output: 2, 1, then 20 and 10 (the fields as declared), 3, and
// every allocation freed.

import std::io

struct Pair {
    a: i64
    b: i64
}

struct Token {
    id: i64
}

struct Holder {
    first: own<Token>
    second: own<Token>
}

fn say(x: i64): i64 = {
    io::printInt(x)
    x * 10
}

fn early(n: i64): i64 = {
    for i in 0..n {
        val h = Holder(second: own Token(id: i), first: own Token(id: if i == 2 { break } else { i }))
    }
    n
}

fn main(): i64 = {
    val p = Pair(b: say(2), a: say(1))
    io::printInt(p.b)
    io::printInt(p.a)
    io::printInt(early(3))
    0
}
