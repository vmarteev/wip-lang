// Callbacks: C calls Wip.
//
// A plain function value is one address, which is what a C function pointer
// takes, so `ascending` goes to the sort as it is. Nothing captures
// anything: a closure is a pair, and C has nowhere to put the other half.
//
// `@export("C")` is the other direction — it gives a Wip function a plain
// symbol, `wip_scale` rather than `wip.<module>.wip_scale`, so that the C
// beside it can call the function by name. Its signature must be one C can
// write, which the checker holds it to.
//
// Expected output: 1 3 5 9, the numbers sorted by a Wip comparator; then
// 10, the smallest of them scaled by a Wip function C called; and 180,
// their total, which C worked out.

import std::io

extern "C" {
    fn sort_i64(values: &var [i64], compare: (a: &i64, b: &i64) => c_int)
    fn scale_all(values: &var [i64]): i64
}

fn ascending(a: &i64, b: &i64): c_int = if a < b {
    -1
} else if a > b {
    1
} else {
    0
}

@export("C")
fn wip_scale(value: i64): i64 = value * 10

fn main() = {
    var values = [5, 3, 9, 1]
    sort_i64(&var values, ascending)
    io::println("\(values[0]) \(values[1]) \(values[2]) \(values[3])")

    val total = scale_all(&var values)
    io::println("\(values[0])")
    io::println("\(total)")

    // A lambda that captures nothing is a plain function value too.
    var descending = [2, 8, 4]
    sort_i64(&var descending, (a, b) => if a > b { -1 } else { 1 })
    io::println("\(descending[0]) \(descending[1]) \(descending[2])")
}
