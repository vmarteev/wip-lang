// `@tailrec`: a function whose calls to itself are
// tail calls, each compiled as a jump back to the top, so the function runs
// in one frame however deep the recursion goes. Without it, a million steps
// end in SIGSEGV.
//
// Expected output: 500000500000 (a million steps in one frame), 5 (an owned
// value moved into each round), 10 (a list walked through references), 55
// (through `return`), 6 (through the arms of a `match`), 1000000 (a static
// method), and 500000 (a generic function's instance), with every
// allocation freed.

import std::io

struct Node {
    id: i64,
    rest: Option<own<Node>>
}

enum Shape {
    Leaf,
    Pair(a: i64, b: i64)
}

struct Counter {
    total: i64
}

extend Counter {
    @tailrec
    static fn walk(n: i64, acc: i64): i64 =
        if n == 0 { acc } else { Counter::walk(n - 1, acc + 1) }
}

@tailrec
fn sum(n: i64, acc: i64): i64 = if n == 0 { acc } else { sum(n - 1, acc + n) }

// What the closure owns moves into the call, so nothing of the frame is left
// to free where the jump happens.
@tailrec
fn carry(n: i64, node: own<Node>): i64 =
    if n == 0 { node.id } else { carry(n - 1, move node) }

// A reference the function was given may be passed on: it points into an
// older frame, not into this one.
@tailrec
fn count(list: &Option<own<Node>>, acc: i64): i64 = match list {
    .Some(node) => count(&node.rest, acc + node.id)
    .None => acc
}

@tailrec
fn viaReturn(n: i64, acc: i64): i64 = {
    if n == 0 {
        return acc
    }
    return viaReturn(n - 1, acc + n)
}

@tailrec
fn viaMatch(shape: Shape, acc: i64): i64 = match shape {
    .Leaf => acc
    .Pair(a, b) => viaMatch(.Leaf, acc + a + b)
}

@tailrec
fn countDown<T: copy>(n: i64, value: T, acc: i64): i64 =
    if n == 0 { acc } else { countDown(n - 1, value, acc + 1) }

fn main() = {
    io::printInt(sum(1000000, 0))

    val node = own Node(id: 5, rest: .None)
    io::printInt(carry(3, move node))

    val list: Option<own<Node>> =
        .Some(own Node(id: 4, rest: .Some(own Node(id: 6, rest: .None))))
    io::printInt(count(&list, 0))

    io::printInt(viaReturn(10, 0))
    io::printInt(viaMatch(.Pair(a: 2, b: 3), 1))
    io::printInt(Counter::walk(1000000, 0))
    io::printInt(countDown<i64>(500000, 7, 0))
}
