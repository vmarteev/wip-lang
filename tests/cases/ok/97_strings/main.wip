// What a `str` does with no memory of its own: a `str` is a
// pointer and a length, so indexing, slicing, comparing and searching are
// all views into bytes that live somewhere else. Everything below `main` is
// the prelude's, written in Wip on `extend str`.
//
// A `str` crosses into C as two arguments, a pointer and a length, which is
// how it is printed and how `text_sum` below reads it; a `&[T]` crosses the
// same way.
//
// Expected output: hello, world; hello; world; 104 and 111, the bytes `h`
// and `o`; three 1s, for the three searches that find what they look for; 7,
// where "world" begins; 1, since "bye" is not there; 1, since the empty text
// is empty; trimmed; 294, the bytes of "abc" added up by C; 1, for a slice
// that equals a literal; and 0, since the empty needle is found at the
// start. Then 10 and 5, from a slice and a part of one, added up by C.

import std::io

extern "C" {
    fn text_sum(s: str): i64
    fn elem_sum(xs: &[i64]): i64
}

fn yes(b: bool) = io::printInt(if b { 1 } else { 0 })

fn main() = {
    val text = "hello, world"
    io::println(text)
    io::println(text[0..5])
    io::println(text[7..12])

    // A byte is a `u8`, and a range of bytes is a `str`.
    io::printInt(text[0] as i64)
    io::printInt(text[4] as i64)

    yes(text.startsWith("hello"))
    yes(text.endsWith("world"))
    yes(text.contains(", "))

    io::printInt(text.find("world").unwrapOr(-1))
    yes(text.find("bye").isNone())
    yes("".isEmpty())

    val padded = "  trimmed \n"
    io::println(padded.trim())

    io::printInt(text_sum("abc"))
    yes(text[0..4] == "hell")
    io::printInt(text.find("").unwrapOr(-1))

    val numbers = [1, 2, 3, 4]
    io::printInt(elem_sum(&numbers))
    io::printInt(elem_sum(&numbers[1..3]))
}
