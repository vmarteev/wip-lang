// A module says what its C is compiled with defined:
// `@define("STEP=2")` is `-DSTEP=2`, for every C file of the module, and
// the header `@prefix` names is read after them, so it may build on them.
// Before this, a setting of one line needed a header of its own.
//
// Expected output: 43 and 45 — the tally starts at `BASE + HOST`, which
// the prefix header works out, and counts by `STEP` — then 1, since
// `LOUD` is defined without a value, which C reads as 1.

import std::io
import tally

fn main() = {
    io::printInt(tally::next())
    io::printInt(tally::next())
    io::printInt(tally::loud())
}
