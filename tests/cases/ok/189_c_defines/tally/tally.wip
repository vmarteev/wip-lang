// A module whose C is configured by what it defines, and by a header
// that reads those definitions.

@define("BASE=40", "STEP=2", "LOUD")
@prefix("settings.h")
extern "C" {
    fn tally_next(): i64
    fn tally_loud(): i64
}

// A setting that differs by target is a block of its own, which `@target`
// keeps or drops. Both say the same here, so that the
// case prints the same everywhere.
@target(vendor = "apple")
@define("HOST=1")
extern "C" {}

@target(os = "linux")
@define("HOST=1")
extern "C" {}

pub fn next(): i64 = tally_next()

pub fn loud(): i64 = tally_loud()
