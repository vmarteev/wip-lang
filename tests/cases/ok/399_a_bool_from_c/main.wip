// A `bool` that C hands over is read as C converts a byte to one: zero is
// false and anything else is true. C may leave any byte where it declares a
// `bool` — a struct filled from a file, a field it forgot, a flag declared
// as a `uint8_t` on its side — and a `bool` of 2 read as it is would be
// true, its `!` true too, `== true` false, and an `Option` holding it
// empty. Each place C hands one over is read here: a field and an array's
// element of a C struct, a pattern on it, the field lent and lent to be
// written, a struct C answers, a C variable, what a C function value
// answers, a callback's parameter and an exported function's, and a
// union's `bool` over a byte of 2. What a `ptr<bool>` points at is the
// program's to say, and is read as it is.
//
// Expected output: every place agrees, and the pointer reads its byte.

import std::c
import std::io

extern struct Rec {
    n: i32
    flag: bool
    flags: [bool; 2]
    answer: Option<() => bool>
}

extern union Either {
    flag: bool
    byte: u8
}

extern "C" {
    fn fill(r: &var Rec)
    fn filled(): Rec
    var shared_flag: bool
    fn set_shared_flag()
    fn call_with_two(f: (b: bool) => i32): i32
    fn call_export_with_two(): i32
}

fn agree(what: str, b: bool) = {
    val same = b && !(!b) && b == true && (if b then 1 else 0) == 1 && "\(b)" == "true"
    val held: Option<bool> = .Some(b)
    io::println("\(what): \(if same && held.isSome() then "agrees" else "does not agree")")
}

fn lent(b: &bool): bool = b == true

fn written(b: &var bool): bool = {
    val was = b == true && !b == false
    b = false
    return was
}

fn take(b: bool): i32 = if b == true && !b == false then 1 else 0

@export("C")
fn takes_flag(b: bool): i32 = if b == true && !b == false then 1 else 0

fn main() = {
    var r = Rec(n: 0, flag: false, flags: [false, false], answer: .None)
    fill(&var r)
    agree("a field", r.flag)
    agree("an array's element", r.flags[1])
    match r {
        Rec(flag: true, ..) => io::println("a pattern: agrees")
        _ => io::println("a pattern: does not agree")
    }
    io::println("lent: \(lent(&r.flag)), lent to be written: \(written(&var r.flag)), then \(r.flag)")
    if r.answer is .Some(f) then agree("a C function value", f())
    agree("a struct C answered", filled().flag)
    set_shared_flag()
    agree("a C variable", shared_flag)
    io::println("a callback: \(call_with_two(take)), an exported function: \(call_export_with_two())")
    val either = Either(byte: 2)
    agree("a union", either.flag)

    val bytes: [u8; 1] = [2]
    val p = c::pointerTo(&bytes) as usize as ptr<bool>
    io::println("a ptr<bool>, read as it is: \(p[0] == true)")
}
