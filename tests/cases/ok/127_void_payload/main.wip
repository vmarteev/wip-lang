// A variant whose payload is nothing may be written `.Ok()`. `return .Ok({})`
// stood in five files and read as "Ok of an empty block"; the parentheses
// already say there is a payload, so what it holds need not be written out.
//
// `{}` is still the unit value and may still be passed — the short form is
// an elision, not a second notation — and a variant with no field at all
// is `.None`, with no parentheses.
//
// Expected output: done, still done, done, none, and nothing.

import std::io

enum Step {
    Done(mark: void)
    Failed(why: String)
    Missing
}

fn finish(): Result<void, String> = {
    return .Ok()
}

fn theLongWay(): Result<void, String> = .Ok({})

fn describe(step: &Step): str = match step {
    .Done(..) => "done"
    .Failed(..) => "failed"
    .Missing => "none"
}

fn main() = {
    match finish() {
        .Ok(..) => io::println("done")
        .Err(why) => io::println(why.toStr())
    }
    match theLongWay() {
        .Ok(..) => io::println("still done")
        .Err(why) => io::println(why.toStr())
    }

    // A user's own enum, and a payload named where it is written.
    val step: Step = .Done()
    io::println(describe(&step))
    io::println(describe(Step::Missing))

    // Nothing is what it holds.
    val marked = Step::Done(mark: {})
    io::println(if marked is .Done(..) { "nothing" } else { "something" })
}
