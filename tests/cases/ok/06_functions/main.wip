// Function declarations: parameters, return types, recursion, early return.

import std::io

fn fib(n: i64): i64 = {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn gcd(a: i64, b: i64): i64 = {
    var x = a
    var y = b
    while y != 0 {
        val t = y
        y = x % y
        x = t
    }
    x
}

fn answer(): i64 = {
    42
}

fn report(value: i64) = {
    io::printInt(value)
    return
}

fn main(): i64 = {
    report(fib(10))     // 55
    report(gcd(84, 36)) // 12
    report(answer())    // 42
    0
}
