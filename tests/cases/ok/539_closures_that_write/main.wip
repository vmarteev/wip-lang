// A closure that writes what it captures: lent to what calls it one call
// at a time — a slice's `map`, an `Option`'s — writing `self` in a `var
// fn`; kept in a `val`, called twice and read after its last use, its type
// written `&var (…) => R` or not; a closure that reads given where one
// that writes is taken; and a kept closure that calls one that writes,
// which writes too.
//
// Expected output:
// 2 4 5 3
// 7 3
// 2 ab
// 11 21
// 4

import std::io

struct Interner {
    names: Vec<String>

    var fn intern(name: str): i64 = {
        self.names.push(name)
        return self.names.len()
    }

    var fn internAll(names: &[str]): Vec<i64> = names.map((name) => self.intern(name))

    var fn internSome(name: Option<str>): Option<i64> = name.map((n) => self.intern(n))
}

fn twice(f: &var (x: i64) => void) = {
    f(1)
    f(10)
}

fn main() = {
    var interner = Interner(names: [])
    val ids = interner.internAll(["a", "b"])
    val more = interner.internAll(["c", "d"])
    val third = interner.internSome(.Some("e"))
    io::println("\(ids[1]) \(more[1]) \(more.len() + interner.names.len() - 2) \(ids.len() + 1)")
    io::println("\(third.unwrap() + 2) \(interner.internSome(.None).unwrapOr(3))")

    var seen = 0
    var text = String()
    val note = (part: str) => {
        seen += 1
        text.push(part)
    }
    note("a")
    note("b")
    io::println("\(seen) \(text)")

    var total = 0
    val typed: &var (x: i64) => void = (x) => total += x
    twice(typed)
    val step = 10
    val reads = (x: i64) => io::print(if x > step then "" else "")
    twice(reads)
    val outer = (x: i64) => typed(x + step)
    outer(0)
    io::println("\(total - step) \(total)")

    var calls = 0
    val count = () => calls += 1
    val again = () => count()
    again()
    again()
    count()
    count()
    io::println("\(calls)")
}
