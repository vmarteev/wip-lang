// A list made from what is walked, without a loop: an
// iterator's `toVec()`, a slice's `map`, and a slice of values that clone
// made into a vector of their own — a part of one, a set's keys, an array.

import std::collections::{Set}
import std::io

struct Row {
    name: String
    size: i64
}

extend Row {
    fn label(): String = "\(self.name) (\(self.size))"
}

fn main() = {
    val parts = "usr/local/bin".split("/").toVec()
    io::println("\(parts.len()) parts: \(parts)")

    var rows: Vec<Row> = Vec()
    rows.push(Row(name: "a.txt", size: 3))
    rows.push(Row(name: "b.txt", size: 5))
    val labels = rows.map((row) => row.label())
    io::println("\(labels)")

    val names = rows.map((row) => row.name.clone())
    var rest = names.skip(1).toVec()
    rest.push("c.txt")
    io::println("\(names) \(rest)")

    var seen: Set<String> = Set()
    seen.add("x")
    seen.add("y")
    io::println("\(seen.items().toVec())")
    io::println("\([3, 1, 2].toVec())")
}
