// An implementation may hold only for some type arguments:
// `extend Vec<T: Eq>: Eq` says a vector compares when its elements do. The
// notation is the one every constraint uses, and it is what an `extend`
// block's parameters were always for — naming the type's own.
//
// It is what comparing a `Vec`, hashing one, keying a map by one, and a
// set of them need.
//
// Expected output: true and false (vectors compared), [1, 2] (one written
// as text), 7 (a map keyed by one), 2 (a set of them), and a bag written
// by a block of this program's own, which holds when its elements can be
// written.

import std::io
import std::collections::{Map, Set}

// A type of this program, with a condition of its own.
struct Bag<T> {
    items: Vec<T>
}

extend Bag<T: Text>: Text {
    fn appendTo(out: &var String) = {
        out.push("bag of ")
        self.items.appendTo(&var out)
    }
}

fn main() = {
    var a = Vec<i64>()
    a.push(1)
    a.push(2)
    var b = Vec<i64>()
    b.push(1)
    b.push(2)
    var c = Vec<i64>()
    c.push(1)
    io::println("\(a == b), \(a == c)")

    // Written as text, because `i64` can be.
    io::println("\(a)")

    // A map keyed by a vector, which needs both `Eq` and `Hash`.
    var seen = Map<Vec<i64>, i64>()
    seen.put(move a, 7)
    io::printInt(seen.at(&b))

    var sets = Set<Vec<i64>>()
    sets.add(move b)
    sets.add(move c)
    io::printInt(sets.len())

    var bag = Bag<i64>(items: Vec<i64>())
    bag.items.push(9)
    io::println("\(bag)")
}
