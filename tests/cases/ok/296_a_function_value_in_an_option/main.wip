// A function value inside an `Option`, a struct's field or a table, bound
// by a pattern and called: the binding is a copy, since a reference to a
// function value would be a closure lent for a call. The
// compiler once crashed binding one.
//
// Expected output: 8, 9, then 4.

import std::io

struct Rule {
	prefix: Option<(x: i64) => i64>
	infix: Option<(x: i64) => i64>
}

fn twice(x: i64): i64 = x * 2

fn thrice(x: i64): i64 = x * 3

fn ruleFor(which: i64): Rule = match which {
	0 => Rule(prefix: .Some(twice), infix: .None)
	_ => Rule(prefix: .None, infix: .Some(thrice))
}

fn main() = {
	if ruleFor(0).prefix is .Some(f) {
		io::printInt(f(4))
	}
	match ruleFor(1).infix {
		.Some(g) => io::printInt(g(3))
		.None => {}
	}
	val rules = [ruleFor(0), ruleFor(1)]
	for rule in rules {
		if rule.prefix is .Some(f) {
			io::printInt(f(2))
		}
	}
}
