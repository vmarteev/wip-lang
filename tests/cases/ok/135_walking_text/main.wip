// A `str` lends its bytes, so `for byte in text` walks them. A `str` is a
// pointer and a length, which is what a slice of bytes is; the compiler writes
// the one that says so, because a projection lends a place of one of its
// reference parameters and a `str` is not one — it is the borrow itself.
//
// Expected output: 3 (digits counted in a literal), 294 (the bytes of
// "abc"), 209 (the bytes of a `String`, through `toStr`), and 5 (a slice
// of what a `str` lends, which is `e`).
//
// A `String` walks its own bytes, which it holds; this is the other half,
// and it is what makes `for byte in text` mean the same thing whichever
// one is in hand.

import std::io

fn digits(text: str): i64 = {
    var n = 0
    for byte in text {
        if 48 <= byte && byte <= 57 {
            n += 1
        }
    }
    return n
}

fn total(bytes: &[u8]): i64 = {
    var sum = 0
    for b in bytes {
        sum += b as i64
    }
    return sum
}

fn main() = {
    io::printInt(digits("a1b22"))

    var sum = 0
    for b in "abc" {
        sum += b as i64
    }
    io::printInt(sum)

    val held = String::of("hi")
    io::printInt(total(&held.toStr().items()))

    // What it lends is an ordinary slice, so it slices.
    io::printInt(total(&"hello".items()[1..2]) - 96)
}
