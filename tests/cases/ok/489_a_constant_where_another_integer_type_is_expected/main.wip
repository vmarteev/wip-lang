// An integer constant is as the literal it stands for: where an integer of
// another type is expected — a field, an argument, a result, an element,
// an assignment — or beside one in an operator, it is that type, where its
// value fits. So are expressions of constants with the arithmetic, bitwise
// and shift operators. C's flags are `c_int` constants, and the fields
// that take them `uint32_t`.
//
// Expected output: the flags as each place took them.

import std::io

val GRAPHICS: c_int = 1
val TRANSFER: c_int = 4
val EXTERNAL: i64 = 4294967295
val MOST = 512

struct Info {
    flags: u32
    usage: u32
    pass: u32
}

fn takes(flags: u32): u32 = flags

fn answers(): u32 = GRAPHICS

fn main() = {
    val info = Info(flags: GRAPHICS, usage: GRAPHICS | TRANSFER, pass: EXTERNAL)
    io::println("fields: \(info.flags) \(info.usage) \(info.pass)")
    val queue: u32 = 5
    io::println("beside: \(queue & GRAPHICS != 0) \(TRANSFER & queue) \(queue + MOST * 2)")
    var count: u32 = MOST
    count += TRANSFER
    val words: [u32; 2] = [GRAPHICS, TRANSFER << 2]
    io::println("placed: \(count) \(takes(TRANSFER)) \(answers()) \(words[1])")
    val small: i8 = -GRAPHICS
    io::println("signed: \(small)")
}
