// `x !is P`, `!(x is P)`: in an expression, with
// alternatives, as a loop's condition, and with `_` for a field.
//
// Expected output: "true true 1 true".

import std::io

enum Status {
    Done
    NeedsMore
    Failed
}

fn main() = {
    val status: Status = .NeedsMore
    val unfinished = status !is .Done && status !is .Failed
    val waiting = !(status !is .NeedsMore | .Failed)
    var loops = 0
    var now: Status = .NeedsMore
    while now !is .Done {
        loops += 1
        now = .Done
    }
    val nothing: Option<i64> = .None
    io::println("\(unfinished) \(waiting) \(loops) \(nothing !is .Some(_))")
}
