=== main.wip ===
import std::io  @6:1..6:15
enum Status  @8:1..12:2
  variant Done  @9:5..9:9
  variant NeedsMore  @10:5..10:14
  variant Failed  @11:5..11:11
fn main  @14:1..26:2
  body: block  @14:13..26:2
    val status  @15:5..15:36
      type: Status  @15:17..15:23
      init: path .NeedsMore  @15:26..15:36
    val unfinished  @16:5..16:60
      init: binary &&  @16:22..16:60
        !is  @16:22..16:38
          scrutinee: name status  @16:22..16:28
          pattern: variant .Done  @16:33..16:38
        !is  @16:42..16:60
          scrutinee: name status  @16:42..16:48
          pattern: variant .Failed  @16:53..16:60
    val waiting  @17:5..17:53
      init: unary !  @17:19..17:53
        paren  @17:20..17:53
          !is  @17:21..17:52
            scrutinee: name status  @17:21..17:27
            pattern: variant .NeedsMore | variant .Failed  @17:32..17:52
    var loops  @18:5..18:18
      init: int 0  @18:17..18:18
    var now  @19:5..19:33
      type: Status  @19:14..19:20
      init: path .NeedsMore  @19:23..19:33
    while  @20:5..23:6
      cond: !is  @20:11..20:24
        scrutinee: name now  @20:11..20:14
        pattern: variant .Done  @20:19..20:24
      body: block  @20:25..23:6
        expr  @21:9..21:19
          assign +=  @21:9..21:19
            target: name loops  @21:9..21:14
            value: int 1  @21:18..21:19
        expr  @22:9..22:20
          assign  @22:9..22:20
            target: name now  @22:9..22:12
            value: path .Done  @22:15..22:20
    val nothing  @24:5..24:37
      type: Option  @24:18..24:29
        arg: i64  @24:25..24:28
      init: path .None  @24:32..24:37
    expr  @25:5..25:77
      call  @25:5..25:77
        callee: path io::println  @25:5..25:16
        arg: interpolation, room for 35  @25:17..25:76
          hole  @25:20..25:30
            value: name unfinished  @25:20..25:30
          text: str " "  @25:30..25:34
          hole  @25:34..25:41
            value: name waiting  @25:34..25:41
          text: str " "  @25:41..25:45
          hole  @25:45..25:50
            value: name loops  @25:45..25:50
          text: str " "  @25:50..25:54
          hole  @25:54..25:74
            value: !is  @25:54..25:74
              scrutinee: name nothing  @25:54..25:61
              pattern: variant .Some(field#: _)  @25:66..25:74
