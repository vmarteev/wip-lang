// An iterator's adapters hold their closure lent, and the chain is a view
// of what it captured: a closure reads a `str`, a reference and `self`, in
// a chain used up in its statement, kept in a `val`, and walked by a
// `for`; one that names nothing around it borrows nothing, and its chain
// leaves its function as far as what it walks may.
//
// Expected output:
// 2 alpha
// 30 4
// 6 7
// 4

import std::io
import std::iter::{Forwards, Mapped}

struct Scale {
    by: i64

    fn scaled(xs: &[i64]): i64 = xs.copies().map((x) => x * self.by).sum()
}

fn double(x: &i64): i64 = x * 2

fn doubled(xs: &[i64]): Mapped<Forwards<i64>, i64> from xs = xs.forwards().map(double)

fn main() = {
    val text = "alpha beta also"
    val prefix = "al"
    val words = text.split(" ").filter((w) => w.startsWith(prefix)).toVec()
    io::println("\(words.len()) \(words[0])")
    val scale = Scale(by: 10)
    val table = [1, 2, 3, 4]
    val lookup = &table
    val indices = [0, 2]
    var picked = indices.copies().map((i) => lookup[i])
    io::println("\(scale.scaled([1, 2])) \(picked.fold(0, (sum, x) => sum + x))")
    var total = 0
    for (i, x) in table.forwards().enumerate().filter((p) => p.1 > lookup[0]) {
        total += i
    }
    io::println("\(total) \(table.copies().takeWhile((x) => x < 3).count() + 5)")
    io::println("\(doubled([1, 1]).sum())")
}
