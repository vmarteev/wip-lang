// The prelude reserves only what the language needs, so a
// program may call its own types `Map`, `Set`, `Split`, `Lines`, `Walk` and
// `Chars`, and its own function `sort`, while the methods that answer the
// standard ones still work: `text.split(",")`, `text.lines()`,
// `values.walk()`, `text.chars()`, `values.sort()`. The standard `Map` is
// imported, here under another name.
//
// Expected output: a map of 2 by 2; set 3; 3 pieces, 2 lines; walked 6;
// 3 characters; sorted [1, 2, 3], by hand 7; 2 counted; é is 2 bytes.

import std::io
import std::collections::{Map as Table}

// A game's map, a set of cards: names a program wants.
struct Map {
    width: i64,
    height: i64
}

struct Set {
    cards: i64
}

struct Split {
    parts: i64
}

struct Lines {
    count: i64
}

struct Walk {
    steps: i64
}

struct Chars {
    count: i64
}

fn sort(n: i64): i64 = n + 6

fn main() = {
    val map = Map(width: 2, height: 2)
    io::println("a map of \(map.width) by \(map.height)")
    io::println("set \(Set(cards: 3).cards)")

    val text = "a,b,c"
    val pieces = Split(parts: text.split(",").count())
    val lines = Lines(count: "one\ntwo".lines().count())
    io::println("\(pieces.parts) pieces, \(lines.count) lines")

    val numbers = [1, 2, 3]
    val walk = Walk(steps: numbers.walk().fold(0, (sum, n) => sum + n))
    io::println("walked \(walk.steps)")
    io::println("\(Chars(count: "abc".chars().count()).count) characters")

    var values = Vec::of(own [3, 1, 2])
    values.sort()
    io::println("sorted \(values), by hand \(sort(1))")

    var table = Table<str, i64>()
    table.put("a", 1)
    table.put("b", 2)
    io::println("\(table.len()) counted")

    // One character, two bytes: where the next one starts.
    val (e, width) = "é!".charAt(0)
    io::println("\(e) is \(width) bytes")
}
