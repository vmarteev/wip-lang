// A `match move` on a box takes what the box holds, and the box is freed
// with nothing in it dropped again: a field an arm takes is the arm's, a
// field it leaves ends where it is left, and a value taken whole ends once,
// where its new owner does. Before, what was taken was dropped again with
// the box: a `destroy` ran on what the move left, and a `String` taken out
// of a box was freed twice.
//
// Expected output:
// a: ~2 ~1 got 1
// b: kept ~4 ~3
// c: kept ~5
// d: ~6
// e: word

import std::io

struct Loud {
    id: i64
}

extend Loud: Destroy {
    var fn destroy() = io::print(" ~\(self.id)")
}

enum Held {
    Two(first: Loud, second: Loud)
    One(only: Loud)
    Empty
}

enum Datum {
    Symbol(value: String)
    List(elements: Vec<Datum>)
}

fn box(held: Held): own<Held> = own held

// The first field taken, the second left.
fn first(boxed: own<Held>): i64 = match move boxed {
    .Two(first, ..) => first.id
    _ => 0
}

// The whole value taken through the box.
fn whole(boxed: own<Held>): Held = match move boxed {
    .One(only) => Held::One(only)
    other => other
}

// Nothing taken: the box is dropped whole.
fn looked(boxed: own<Held>): bool = match move boxed {
    .Empty => true
    _ => false
}

fn unboxed(boxed: own<Datum>): Datum = match move boxed {
    .Symbol(value) => Datum::Symbol(value)
    other => other
}

fn main() = {
    io::print("a:")
    val got = first(box(.Two(first: Loud(1), second: Loud(2))))
    io::println(" got \(got)")
    io::print("b:")
    {
        val kept = whole(box(.Two(first: Loud(3), second: Loud(4))))
        io::print(" kept")
    }
    io::println("")
    io::print("c:")
    {
        val kept = whole(box(.One(only: Loud(5))))
        io::print(" kept")
    }
    io::println("")
    io::print("d:")
    assert(!looked(box(.One(only: Loud(6)))))
    io::println("")
    val .Symbol(word) = unboxed(own .Symbol("word")) else panic("a symbol")
    io::println("e: \(word)")
}
