// `==` on a type a program declares. Until now it worked on
// numbers, `bool` and `str` alone, and the help said to compare the fields
// one by one — which blocked looking a value up, comparing results in a
// test, and every collection that finds things by what they are.
//
// `@derive(Eq)` says the type compares, and the compiler writes the comparison:
// field by field for a struct, and for an enum the variant first and then
// that variant's fields. `a == b` is `a.equals(&b)`, and `Eq` is an
// ordinary interface, so a generic function can ask for it.
//
// A type whose equality is not its fields writes `extend … : Eq` itself: `Ticket`
// below is the same ticket when its number is, whatever is written on it.
//
// Expected output: the comparisons, then the index a generic search found,
// then the ticket that matched by its number alone.

import std::io

@derive(Eq)
struct Cell { row: i64, column: i64 }

@derive(Eq)
enum Shape {
    Dot
    Line(from: Cell, to: Cell)
    Sized(code: i64)
}

@derive(Eq)
struct Board { cells: [i64; 3], tag: i64, origin: Cell }

// A generic type compares when its parameter does.
@derive(Eq)
struct Pair<T: Eq> { a: T, b: T }

struct Ticket { number: i64, note: i64 }

extend Ticket: Eq {
    fn equals(other: &Ticket): bool = self.number == other.number
}

// `Eq` is an interface, so this is written once for every type that has it.
fn indexOf<T: Eq>(xs: &[T], wanted: &T): i64 = {
    var i = 0
    while i < xs.len() {
        if xs[i] == wanted {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn main() = {
    val here = Cell(row: 1, column: 2)
    val same = Cell(row: 1, column: 2)
    val other = Cell(row: 3, column: 2)
    io::println("cells \(here == same), \(here == other), \(here != other)")

    // An enum: the variant first, then what it holds.
    val line = Shape::Line(from: here, to: other)
    val again = Shape::Line(from: here, to: other)
    val shorter = Shape::Line(from: here, to: here)
    io::println("shapes \(line == again), \(line == shorter), \(line == Shape::Dot)")
    io::println("units \(Shape::Dot == Shape::Dot), \(Shape::Sized(code: 2) == Shape::Sized(code: 2))")

    // An array field, and a struct inside a struct.
    val one = Board(cells: [1, 2, 3], tag: 7, origin: here)
    val two = Board(cells: [1, 2, 3], tag: 7, origin: here)
    val three = Board(cells: [1, 9, 3], tag: 7, origin: here)
    io::println("boards \(one == two), \(one == three)")

    val pair = Pair<i64>(a: 1, b: 2)
    val twin = Pair<i64>(a: 1, b: 2)
    io::println("pairs \(pair == twin)")

    val cells = [here, other, Cell(row: 9, column: 9)]
    io::println("found \(indexOf(&cells, &other))")

    // Equality that is not the fields: the note differs, the ticket does not.
    val ticket = Ticket(number: 5, note: 1)
    val reprinted = Ticket(number: 5, note: 2)
    io::println("tickets \(ticket == reprinted)")
}
