// An enum with one variant that holds a value, and others that hold none,
// keeps those others in values the one it holds cannot have: a
// reference's, an `own`'s or a function's null, a `bool`'s bytes past 1, a
// `char`'s numbers past the last, an enum's tags it does not use, a
// struct's field that has the most of them. Such an `Option` is as large as
// what it holds, and is matched, tested with `is`, moved, taken apart,
// dropped, held in a `Vec` and a `Map`, and read from a constant table as
// any enum is.
//
// Expected output:
// 8 8 8
// 1 1 1 1
// 4 true true
// yes no unsaid unasked
// off unknown on: false on: true
// found b, 2
// none past the last
// moved: ada
// 3 of 5 said, 2 of them true
// a: 'x', b: none
// 1, 3

import std::c
import std::collections::{Map}
import std::io

enum Light {
    Red
    Amber
    Green
}

enum Switch {
    Off
    Unknown
    On(level: bool)
}

struct Reading {
    at: i64
    value: f64
    taken: bool
}

struct Named {
    name: String
    count: i64
}

val SAID: [Option<bool>; 5] = [.Some(true), .None, .Some(false), .None, .Some(true)]

fn answer(asked: Option<Option<bool>>): str = match asked {
    .Some(.Some(true)) => "yes"
    .Some(.Some(false)) => "no"
    .Some(.None) => "unsaid"
    .None => "unasked"
}

fn shown(s: Switch): String = match s {
    .Off => "off"
    .Unknown => "unknown"
    .On(level) => "on: \(level)"
}

fn named(all: &[Named], name: str): Option<&Named> = {
    for n in all {
        if n.name == name then return .Some(n)
    }
    return .None
}

fn main() = {
    io::println("\(c::sizeOf<Option<&i64>>()) \(c::sizeOf<Option<own<i64>>>()) \(c::sizeOf<Option<() => void>>())")
    io::println(
        "\(c::sizeOf<Option<bool>>()) \(c::sizeOf<Option<Option<bool>>>()) \(c::sizeOf<Switch>()) \(c::sizeOf<Option<Light>>())",
    )
    io::println(
        "\(c::sizeOf<Option<char>>()) \(c::sizeOf<Option<Reading>>() == c::sizeOf<Reading>()) \(c::sizeOf<Option<(i64, bool)>>() == 16)",
    )

    val asked: [Option<Option<bool>>; 4] = [.Some(.Some(true)), .Some(.Some(false)), .Some(.None), .None]
    io::println("\(answer(asked[0])) \(answer(asked[1])) \(answer(asked[2])) \(answer(asked[3]))")
    io::println("\(shown(.Off)) \(shown(.Unknown)) \(shown(.On(level: false))) \(shown(.On(level: true)))")

    val all = [Named(name: "a", count: 1), Named(name: "b", count: 2)]
    if named(&all, "b") is .Some(n) then io::println("found \(n.name), \(n.count)")
    if named(&all, "c") is .None then io::println("none past the last")

    var held: Option<own<Named>> = .Some(own Named(name: "ada", count: 3))
    val taken = held.take()
    if held is .None && taken is .Some(n) then io::println("moved: \(n.name)")

    var said: Vec<Option<bool>> = Vec()
    for s in SAID {
        said.push(s)
    }
    var known = 0
    var yes = 0
    for s in said {
        if s is .Some(b) {
            known += 1
            if b then yes += 1
        }
    }
    io::println("\(known) of \(said.len()) said, \(yes) of them true")

    var letters: Map<String, Option<char>> = Map()
    letters.put("a", .Some('x'))
    letters.put("b", .None)
    val a = if letters.get("a") is .Some(.Some(c)) then "'\(c)'" else "none"
    val b = if letters.get("b") is .Some(.Some(c)) then "'\(c)'" else "none"
    io::println("a: \(a), b: \(b)")

    val readings = [
        Option::Some(Reading(at: 1, value: 0.5, taken: true)),
        .None,
        .Some(Reading(at: 3, value: 1.5, taken: false)),
    ]
    var ats: Vec<String> = Vec()
    for r in readings {
        if r is .Some((at, ..)) then ats.push("\(at)")
    }
    io::println(ats.join(", "))
}
