// Integer arithmetic, operator precedence, and unary minus.

import std::io

fn main(): i64 = {
    val a = 7
    val b: i64 = 3
    io::printInt(a + b)       // 10
    io::printInt(a - b)       // 4
    io::printInt(a * b)       // 21
    io::printInt(a / b)       // 2
    io::printInt(a % b)       // 1
    io::printInt(-a + b * 2)  // -1
    io::printInt((a + b) * 2) // 20
    io::printInt(- -a)        // 7
    0
}
