// What `@derive` writes asks of a type's parameters what its fields need of
// them, worked down through the fields' types: a handle that holds no `T`
// compares, orders, hashes, writes, clones and encodes whatever `T` is, so
// it keys a map of values that do not compare; a struct of handles named by
// what a GPU decides clones and compares in generic code, whatever the GPU
// is; a recursive enum asks what its values need; a view's `&T` field
// clones without asking `T`; and a field whose implementation asks another
// interface asks that.
//
// Expected output:
// true
// Tag(slot: 2, generation: 3)
// true true
// true
// .Branch(children: [.Leaf(value: 1), .Leaf(value: 2)])
// n
// true false

import std::collections::{Map}
import std::io

@derive(Eq, Ord, Hash, Text, Clone, Encode, Decode)
struct Tag<T> {
	slot: u32
	generation: u32
}

/// A value that does not compare.
struct Node {
	name: String
}

interface Gpu<type Texture> {
	fn frames(): i64
}

struct Device {
	count: i64
}

extend Device: Gpu<u32> {
	fn frames(): i64 = self.count
}

@derive(Clone, Eq)
struct Layer<G: Gpu> {
	name: String
	textures: Vec<Tag<G::Texture>>
}

/// Both of them, cloned in code that knows only that `G` is a GPU.
fn twice<G: Gpu>(layer: &Layer<G>): (Layer<G>, Layer<G>) = (layer.clone(), layer.clone())

@derive(Clone, Eq, Text)
enum Tree<T> {
	Leaf(value: T)
	Branch(children: Vec<Tree<T>>)
}

@derive(Clone)
view struct Seen<T> {
	at: &T
}

/// Values kept in order, equal where they hold the same values in it: its
/// equality asks `Ord` of them.
struct Sorted<T> {
	values: Vec<T>
}

extend Sorted<T: Ord>: Eq {
	fn equals(other: &Sorted<T>): bool = {
		if self.values.len() != other.values.len() then return false
		for i in 0..self.values.len() {
			if self.values[i].compare(&other.values[i]) != .Same then return false
		}
		return true
	}
}

@derive(Eq)
struct Kept<T> {
	sorted: Sorted<T>
}

fn main() = {
	var names: Map<Tag<Node>, String> = Map()
	names.put(Tag(slot: 1, generation: 1), "one")
	val key: Tag<Node> = Tag(slot: 1, generation: 1)
	io::println("\(names.get(&key).isSome())")
	io::println("\(Tag<Node>(slot: 2, generation: 3))")
	val layer: Layer<Device> = Layer(name: "ground", textures: [Tag<u32>(slot: 0, generation: 1)])
	val (a, b) = twice(&layer)
	io::println("\(a == b) \(a == layer)")
	val tree = Tree::Branch(children: [Tree::Leaf(value: 1), Tree::Leaf(value: 2)])
	io::println("\(tree.clone() == tree)")
	io::println("\(tree)")
	val node = Node(name: "n")
	val seen = Seen(at: &node)
	io::println(seen.clone().at.name)
	val one = Kept(sorted: Sorted(values: [1, 2]))
	val other = Kept(sorted: Sorted(values: [1, 3]))
	io::println("\(one == one) \(one == other)")
}
