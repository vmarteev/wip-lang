// Second-class references: `&T` may appear only as a parameter type. The caller
// writes `&x`; the reference cannot be stored, returned, or outlive the call.

import std::io

struct Stats {
    count: i64
    total: i64
}

fn mean(s: &Stats): i64 = {
    s.total / s.count
}

fn larger(a: &Stats, b: &Stats): i64 = {
    if a.total > b.total {
        return a.total
    }
    b.total
}

fn peek(boxed: &own<Stats>): i64 = {
    boxed.count
}

fn main(): i64 = {
    val s = Stats(count: 4, total: 20)
    val u = Stats(count: 2, total: 50)
    val t = own Stats(count: 1, total: 99)
    io::printInt(mean(&s))        // 5
    io::printInt(larger(&s, &u))  // 50
    io::printInt(peek(&t))        // 1
    0
}
