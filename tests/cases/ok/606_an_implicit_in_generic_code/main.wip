// An implicit's type may name type parameters, a function's own and those of
// the type a method extends. A call fills it as if it were written, after
// the arguments it writes, so the call's type arguments are inferred from
// it as from any argument: decided by the implicit alone, by the receiver,
// by another argument, or written, and passed on through three calls. A
// type parameter taken by value is one that is `copy`.
//
// Expected output:
// 5 draws, 65 wide
// by name: 1
// 7

import std::io

interface Gpu {
    fn name(): str
}

struct Metal {
    n: i64
}

extend Metal: Gpu {
    fn name(): str = "metal"
}

struct Draw<G> {
    width: i64
}

struct Writer<G> {
    scale: i64
}

extend Writer<G> {
    // `G` is the receiver's.
    fn drawn(text: str, implicit draws: &var Vec<Draw<G>>) = {
        draws.push(Draw(width: text.len() * self.scale))
    }
}

// `G` is decided by the implicit alone.
fn line<G: Gpu>(text: str, implicit draws: &var Vec<Draw<G>>) = {
    draws.push(Draw(width: text.len()))
}

// `G` is decided by the writer, and the implicit is checked against it.
fn written<G: Gpu>(writer: &Writer<G>, text: str, implicit draws: &var Vec<Draw<G>>) = {
    writer.drawn(text)
    line(text)
}

fn page<G: Gpu>(implicit draws: &var Vec<Draw<G>>) = {
    line("one")
    line<G>("two")
    val writer: Writer<G> = Writer(scale: 10)
    written(&writer, "three")
}

fn frame<G: Gpu>(implicit draws: &var Vec<Draw<G>>) = {
    page()
    line("four")
}

fn twice<T: copy>(implicit step: T): (T, T) = (step, step)

fn main() = {
    implicit var draws: Vec<Draw<Metal>> = Vec()
    frame()
    var wide = 0
    for d in draws {
        wide += d.width
    }
    io::println("\(draws.len()) draws, \(wide) wide")
    var other: Vec<Draw<Metal>> = Vec()
    line("a", draws: &var other)
    io::println("by name: \(other.len())")
    implicit val step: i64 = 7
    val (a, _) = twice()
    io::println("\(a)")
}
