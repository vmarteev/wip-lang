// `is` tests.
//
// Expected output: 5 (a test on a place), 7 (on a call's value), 1 and 0
// (`is` as a `bool`), 12 (a chain with `&&`), -1 (the chain fails), 20 (a
// write through an alias binding), 3 and 6 (`while` over a list, then its
// sum), 30 and 30 (owned bindings taken with `move`), 4 (a `break` out of a
// loop whose condition binds), 99 (`return` from inside the block), and
// every allocation freed.

import std::io

enum Maybe<T> {
    Some(value: T)
    None
}

struct Token {
    id: i64
}

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

fn find(n: i64): Maybe<own<Token>> = if n > 0 { .Some(own Token(id: n)) } else { .None }

fn push(list: own<List>, head: i64): own<List> = own .Cons(head, tail: move list)

fn firstId(n: i64): i64 = {
    if find(n) is .Some(token) {
        return token.id + 90
    }
    -1
}

fn main(): i64 = {
    val a: Maybe<i64> = .Some(5)
    if a is .Some(x) {
        io::printInt(x)
    }
    if find(7) is .Some(token) {
        io::printInt(token.id)
    }
    val none: Maybe<i64> = .None
    val isNone = none is .None
    io::printInt(if isNone { 1 } else { 0 })
    io::printInt(if a is .None { 1 } else { 0 })
    if a is .Some(x) && x > 3 {
        io::printInt(x + 7)
    }
    if a is .Some(x) && x > 10 {
        io::printInt(x)
    } else {
        io::printInt(-1)
    }
    var counter: Maybe<i64> = .Some(10)
    if counter is .Some(n) {
        n = n * 2
    }
    if counter is .Some(n) {
        io::printInt(n)
    }

    var list = push(push(push(own .Nil, 1), 2), 3)
    io::printInt(count(&list))
    io::printInt(total(&list))

    var owned: Maybe<own<Token>> = .Some(own Token(id: 30))
    if move owned is .Some(token) {
        io::printInt(token.id)
    }
    var again = find(30)
    while move again is .Some(token) {
        io::printInt(token.id)
        again = .None
    }
    var i = 0
    while find(i + 1) is .Some(token) {
        i = i + 1
        if token.id == 4 {
            break
        }
        if token.id == 2 {
            continue
        }
    }
    io::printInt(i)
    io::printInt(firstId(9))
    0
}

fn count(list: &List): i64 = match list {
    .Cons(tail, ..) => 1 + count(&tail)
    .Nil => 0
}

fn total(list: &List): i64 = {
    if list is .Cons(head, tail) {
        return head + total(&tail)
    }
    0
}
