// A constraint may name another type parameter — `J: Iterator<V>` — and what it
// names is found wherever the constraint is written: on a function, on a method
// of a type or of an interface, whose own parameters come after the ones it is
// given, and as the condition of an implementation, which is read with the
// type's arguments. A call through the constraint goes to the type's own
// method, which is no instance of anything when the type is not generic.

import std::io
import std::text::{Chars}

fn firstFree<J: Iterator<V>, V>(other: J): Option<V> = {
    var walked = move other
    walked.next()
}

struct Box<T> {
    value: T
}

extend Box<T> {
    fn firstOf<J: Iterator<V>, V>(other: J): Option<V> = {
        var walked = move other
        walked.next()
    }
}

interface Named<T> {
    fn name(): T

    fn firstWith<J: Iterator<V>, V>(other: J): Option<V> = {
        var walked = move other
        walked.next()
    }
}

struct Num {
    n: i64
}

extend Num: Named<i64> {
    fn name(): i64 = self.n
}

/// Walks what it holds, when that walks: a condition that names the
/// type's other parameter.
struct Wrapped<I, T> {
    inner: I
}

extend Wrapped<I: Iterator<T>, T>: Iterator<T> {
    var fn next(): Option<T> = self.inner.next()
}

fn main() = {
    io::println("\(firstFree("ab".chars()))")
    val b = Box(value: 1)
    io::println("\(b.firstOf("cd".chars()))")
    val n = Num(n: 3)
    io::println("\(n.firstWith("ef".split(",")))")
    var wrapped: Wrapped<Chars, char> = Wrapped(inner: "gh".chars())
    for c in wrapped {
        io::println("\(c)")
    }
}
