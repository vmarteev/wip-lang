// Types an implementation decides: `type` before an interface's parameter.
// A constraint leaves it out, or names it to pin it; generic code reads it
// as `I::Item`, and a concrete type's is what its implementation says.
//
// Expected output:
// 1
// 3
// x
// 6
// 2
// 10
// 4

import std::io
import std::text::{Chars}

interface Shelf<type Book> {
	fn first(): Book
	fn count(): i64
}

struct Library {
	titles: Vec<String>
}

extend Library: Shelf<String> {
	fn first(): String = self.titles[0].clone()
	fn count(): i64 = self.titles.len()
}

struct Range {
	from: i64
	to: i64
}

extend Range: Shelf<i64> {
	fn first(): i64 = self.from
	fn count(): i64 = self.to - self.from
}

// The element is left out, and read as the shelf's.
fn firstOf<S: Shelf>(shelf: &S): S::Book = shelf.first()

// The element is pinned, and asked something of.
fn firstPlusOne<S: Shelf<i64>>(shelf: &S): i64 = shelf.first() + 1

// Any iterator's element, passed on without being named.
fn secondOf<I: Iterator>(it: I): Option<I::Item> = {
	var walking = move it
	walking.next()
	return walking.next()
}

// A struct that holds an iterator's element, named through the iterator.
struct Last<I: Iterator> {
	seen: Option<I::Item>
}

fn lastOf<I: Iterator>(it: I): Last<I> = {
	var last: Last<I> = Last(seen: .None)
	for x in move it {
		last.seen = .Some(move x)
	}
	return move last
}

fn main() = {
	val range = Range(from: 1, to: 4)
	io::println("\(firstOf(&range))")
	io::println("\(range.count())")
	val library = Library(titles: Vec::of(own ["x".toString()]))
	io::println("\(firstOf(&library))")
	// A concrete type's decided type is its implementation's.
	val letter: Chars::Item = 'a'
	val number: Range::Book = 6
	assert(letter == 'a')
	io::println("\(number)")
	io::println("\(firstPlusOne(&range))")
	io::println("\(secondOf("9 10 11".split(" ")).unwrap())")
	io::println("\(lastOf(Vec::of(own [1, 2, 3, 4]).intoIterator()).seen.unwrap())")
}
