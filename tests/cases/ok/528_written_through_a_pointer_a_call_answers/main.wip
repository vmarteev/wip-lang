// An element written through a C pointer that a call answers, `slots()[i] =
// x`: the call is made once, where the place is worked out, and the place
// is that pointer's element. The compiler worked the call out early and
// then made it again, and stopped on the value it had not used.
//
// Expected output: 0 5 7 1

import std::c
import std::io

fn slots(values: &[i64]): ptr<i64> = c::pointerTo(values)

fn main() = {
    var values = [0, 0, 0, 0]
    slots(&values)[2] = 7
    c::pointerTo(&values)[1] = 5
    slots(&values)[3] += 1
    io::println("\(values[0]) \(values[1]) \(values[2]) \(values[3])")
}
