// `type Id = i64`: another name for a type. It is the
// same type everywhere — no new type, no methods of its own — so a value
// of one is a value of the other, and a `static fn` of the type the alias
// names is called through the alias.
//
// An alias may take type parameters, which the type it names gets where
// they are written.
//
// Expected output: 42 (a name for a number), [(1, 2)] (a name for a
// container, built through the alias), Point { x: 1, y: 2 } (a map keyed
// by an alias), true (a name for a function type), and 3 (a name that
// names another name).

import std::io
import std::collections::{Map}

type Id = i64
type Pairs<T> = Vec<(T, T)>
type Ids = Pairs<Id>
type Check<E> = (event: &E, least: Id) => bool
type Grid = Map<Id, Point>

@derive(Text)
struct Point {
    x: Id
    y: Id
}

// An alias stands for its type in a signature, and a caller need not know
// which spelling was used.
fn doubled(id: Id): i64 = id * 2

fn main() = {
    val n: Id = 21
    io::printInt(doubled(n))

    var pairs = Ids()
    pairs.push((1, 2))
    io::println("\(pairs)")

    var grid = Grid()
    grid.put(1, Point(x: 1, y: 2))
    io::println("\(grid.at(1))")

    val bigger: Check<i64> = (event: &i64, least: Id) => event > least
    val three = 3
    io::println("\(bigger(&three, 1))")

    // A struct may hold a type whose arguments are constrained, which the
    // alias makes no harder.
    val held = Holder(grid: Grid(), size: 3)
    io::printInt(held.size)
}

struct Holder {
    grid: Grid
    size: Id
}
