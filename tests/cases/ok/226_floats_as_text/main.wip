// A float is written with as many digits as it takes to read back as the
// same value, and six at the least; text is read as the nearest float.

import std::io

fn main() = {
    // Six digits or fewer, as `%g` always wrote them.
    io::println("\(0.1) \(2.5) \(100000.0) \(1000000.0) \(1e20) \(1e-7) \(-0.0)")
    // More, where six do not read back.
    io::println("\(3.141592653589793) \(0.1 + 0.2) \(1.7976931348623157e308)")
    // An `f32` takes the digits an `f32` needs.
    io::println("\(1.1 as f32) \(3.14159274 as f32) \(16777217.0 as f32)")
    io::println("\(1.0 / 0.0) \(-1.0 / 0.0)")

    // Every value above reads back as itself.
    val values = [0.1, 3.141592653589793, 0.1 + 0.2, 1.7976931348623157e308, 5e-324, 123456.789e-30]
    for value in values {
        val back = "\(value)".toFloat()
        if back != .Ok(value) {
            io::println("\(value) read back as \(back)")
        }
    }

    // The nearest float to what is written, however many digits.
    io::println("\("2.2250738585072014e-308".toFloat()) \("0.30000000000000004".toFloat() == .Ok(0.1 + 0.2))")
    io::println("\("9007199254740993".toFloat()) \("1e-400".toFloat())")
    // What `toFloat` refuses, which C would read.
    io::println("\("1e400".toFloat()) \("inf".toFloat()) \("0x10".toFloat()) \(" 1".toFloat()) \("1e".toFloat())")
}
