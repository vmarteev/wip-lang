// `..=` takes the end too, in a loop, a list, a generator and a slice.

import std::io

fn total(values: &[i64]): i64 = {
	var sum = 0
	for value in values {
		sum += value
	}
	return sum
}

fn upTo(n: i64): Iterator<i64> = for i in 1..=n {
	yield i
}

fn main() = {
	var sum = 0
	for i in 1..=4 {
		sum += i
	}
	// The top of a type counts, and the loop ends there.
	var bytes = 0
	for b in 0 as u8..=255 {
		bytes += 1
	}
	var none = 0
	for i in 3..=2 {
		none += 1
	}
	io::println("\(sum) \(bytes) \(none)")

	val xs = [1, 2, 3, 4, 5]
	io::println("\(total(&xs[1..=3])) \(total(&xs[..=1])) \(total(&xs[4..=4]))")
	io::println("hello"[1..=3])

	val evens = own for i in 0..=10 {
		if i % 2 == 0 {
			yield i
		}
	}
	var counted = 0
	for i in upTo(3) {
		counted += i
	}
	io::println("\(evens.len()) \(counted)")
}
