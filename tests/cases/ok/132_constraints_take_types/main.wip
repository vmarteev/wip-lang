// A constraint carries the types its interface takes.
// `C: Items<Card>` and `E: From<i64>` say which implementation a call through
// the constraint means — and it is what lets an algorithm be written once for
// every container that lends its elements.
//
// Expected output: 9 (a deck walked through a constraint), 9 again (a
// vector walked by the same function), 12 (a conversion named in a
// signature), 2 and 4 (an element type the container alone decides), and 5
// (the same over a vector).

import std::io

struct Card {
    rank: i64
}

struct Deck {
    cards: Vec<Card>
}

extend Deck: Items<Card> {
    fn items(): &[Card] = lend self.cards.items()
}

// One algorithm, for anything that lends cards.
fn total<C: Items<Card>>(c: &C): i64 = {
    var sum = 0
    for card in c {
        sum += card.rank
    }
    return sum
}

struct Meters {
    value: i64
}

extend Meters: From<i64> {
    static fn from(value: i64): Meters = Meters(value: value)
}

// The conversion is said out loud in the signature.
fn measure<M: From<i64>>(n: i64): M = M::from(n)

fn cards(): Vec<Card> = {
    var cards = Vec<Card>()
    cards.push(Card(rank: 4))
    cards.push(Card(rank: 5))
    return move cards
}

// The element is named by a parameter, and the container says what it is.
fn count<T, C: Items<T>>(c: &C): i64 = {
    var n = 0
    for _ in c {
        n += 1
    }
    return n
}

fn first<T: copy, C: Items<T>>(c: &C, ifEmpty: T): T = {
    for x in c {
        return x
    }
    return ifEmpty
}

fn main() = {
    val deck = Deck(cards: cards())
    io::printInt(total(&deck))

    // The prelude's `Vec` lends the same elements.
    io::printInt(total(cards()))

    val far: Meters = measure<Meters>(12)
    io::printInt(far.value)

    io::printInt(count(&deck))
    io::printInt(first(&deck, Card(rank: 0)).rank)

    var numbers = Vec<i64>()
    numbers.push(5)
    io::printInt(first(&numbers, 0))
}
