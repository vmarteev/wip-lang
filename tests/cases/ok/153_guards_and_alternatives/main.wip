// An arm may ask more than what the value is: `if …`
// after the pattern is a guard, and `|` between patterns matches any one
// of them. The three together — a value, a guard, alternatives — are one
// change to the matcher.
//
// An arm with a guard covers nothing, since it may not match: a `match`
// whose only arm for a variant is guarded is still missing that variant.
//
// Expected output: a big circle, a circle, not a circle twice
// (alternatives over variants), small middling negative large (guards
// beside values), 9 (a guard that reads a binding), even (alternatives
// over numbers), and 2 (a guard on a `match move` whose bindings copy).

import std::io

enum Shape {
    Round(radius: i64)
    Square(side: i64)
    Empty
}

fn describe(s: &Shape): str = match s {
    .Round(radius) if radius > 10 => "a big circle"
    .Round(..) => "a circle"
    .Square(..) | .Empty => "not a circle"
}

fn size(n: i64): str = match n {
    0 | 1 | 2 => "small"
    3 | 4 => "middling"
    n if n < 0 => "negative"
    _ => "large"
}

fn parity(n: i64): str = match n % 2 {
    0 => "even"
    1 | -1 => "odd"
    _ => "impossible"
}

// A guard may read what the pattern bound.
fn biggest(s: &Shape): i64 = match s {
    .Round(radius) if radius > 100 => 100
    .Round(radius) => radius
    _ => 0
}

fn pick(o: Option<i64>): i64 = match move o {
    .Some(n) if n > 5 => n
    .Some(n) => 0 - n
    .None => -1
}

fn main() = {
    io::println(describe(Shape::Round(radius: 20)))
    io::println(describe(Shape::Round(radius: 2)))
    io::println(describe(Shape::Square(side: 1)))
    io::println(describe(Shape::Empty))

    io::println("\(size(1)) \(size(4)) \(size(-5)) \(size(99))")

    io::printInt(biggest(Shape::Round(radius: 9)))
    io::println(parity(4))
    io::printInt(0 - pick(Option<i64>::Some(2)))
}
