// A parameter that is not used is written `_`: in a lambda,
// a function, a function type and a method, as many as there are.

import std::io

fn first(a: i64, _: i64): i64 = a
fn neither(_: i64, _: str): i64 = 0
fn apply(f: &(x: i64, _: i64) => i64): i64 = f(3, 4)

struct Counter {
    n: i64 = 0
}

extend Counter {
    // What it is given owns memory, and is dropped where the call ends.
    fn ignoring(_: String): i64 = self.n
}

fn main() = {
    val r: Result<i64, String> = .Err(String::of("no"))
    io::println("\(r.unwrapOrElse((_) => 7))")
    io::println("\(first(1, 2)) \(neither(5, "x")) \(apply((x, _) => x * 10))")
    io::println("\(Counter(n: 9).ignoring(String::of("y")))")
}
