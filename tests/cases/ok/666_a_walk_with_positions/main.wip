// `indexed()` walks a slice, an array or a `Vec` from the first element,
// each lent where it lies with its position from 0: in a `for`, taken
// apart as a pair, and through the iterator's adapters. Elements that own
// memory are lent, not copied, and the walk leaves the list as it was.
//
// Expected output:
// 0 ann
// 1 
// 2 bo
// 0 3
// 1 4
// 2 5
// blank at 1
// 2 past 3
// 3 names

import std::io

fn blank(names: &[String]): Option<i64> = {
    for (i, name) in names.indexed() {
        if name.isEmpty() then return i
    }
    return .None
}

fn main() = {
    val names: Vec<String> = ["ann", "", "bo"]
    for (i, name) in names.indexed() do
        io::println("\(i) \(name)")

    val sizes = [3, 4, 5]
    for (i, size) in sizes.indexed() do
        io::println("\(i) \(size)")

    io::println("blank at \(blank(&names).unwrap())")
    val lent: &[i64] = &sizes
    io::println("\(lent.indexed().filter((entry) => entry.1 > 3).count()) past 3")
    io::println("\(names.len()) names")
}
