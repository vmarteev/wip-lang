// An integer's bits, and a fused multiply-add: what the
// processor counts, turns and reorders of an integer, as methods of every
// integer type, and `x * a + b` rounded once.
//
// Expected output: the counts of 0b1011_0000 — 3 ones, 4 zeros after and 56
// before; its bytes and bits the other way; a hash's rotation; the counts
// at each width for 0; the fused answer beside the one rounded twice; and
// the same from a constant worked out while compiling.

import std::io

@comptime
val AT_COMPILE_TIME: [u64; 3] = [
	(0b1011_0000 as u64).countOnes(),
	(0b1011_0000 as u64).rotateRight(4),
	(0x0102 as u64).swapBytes(),
]

@comptime
val FUSED: f64 = (0.1).mulAdd(10.0, -1.0)

fn mixed(state: u64, word: u64): u64 = (state ^ word).rotateLeft(23) *% 0x9E3779B97F4A7C15

fn main() = {
	val set: u64 = 0b1011_0000
	io::println("\(set.countOnes()) \(set.trailingZeros()) \(set.leadingZeros())")
	io::println("\(set.swapBytes()) \(set.reverseBits())")
	io::println("\(mixed(1, 2))")
	io::println("\((0 as u8).leadingZeros()) \((0 as i16).trailingZeros()) \((0 as u32).leadingZeros()) \((0 as i128).leadingZeros())")
	io::println("\((-1 as i8).countOnes()) \((0x81 as u8).rotateLeft(9)) \((1 as i128).rotateRight(1) < 0)")
	io::println("\((0.1).mulAdd(10.0, -1.0)) \(0.1 * 10.0 - 1.0) \((0.1 as f32).mulAdd(10.0, -1.0))")
	io::println("\(AT_COMPILE_TIME[0]) \(AT_COMPILE_TIME[1]) \(AT_COMPILE_TIME[2]) \(FUSED)")
}
