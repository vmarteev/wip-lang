// The maths a program reaches for, as methods of `f64` and `f32`:
// roots, trigonometry, logarithms, rounding, `min`,
// `max` and `clamp`, and `%` through `Remainder`. `std::math` has `PI`,
// `TAU` and `E`.

import std::io
import std::math

fn main() = {
    val x: f64 = 2.0
    io::printFloat(x.sqrt())
    io::printFloat((math::PI / 2.0).sin())
    io::printFloat((0.0).cos())
    io::printFloat((1.0).atan2(1.0) * 4.0)
    io::printFloat(math::E.ln())
    io::printFloat(x.pow(10.0))
    io::printFloat((7.5).floor())
    io::printFloat((7.2).ceil())
    io::printFloat((-2.5).round())
    io::printFloat((-2.7).trunc())
    io::printFloat((-3.0).abs())
    io::printFloat(7.5 % 2.0)
    io::printFloat((-7.5) % 2.0)

    // `f32` has the same, in its own width.
    val y: f32 = 3.7
    io::printFloat(y.clamp(0.0, 1.0) as f64)
    io::printFloat(y.min(2.0) as f64)
    io::printFloat(y.max(5.0) as f64)
    io::printFloat((y * 2.0).floor() as f64)
    val half: f32 = (math::PI as f32) / 2.0
    io::printFloat(half.sin() as f64)

    // An `i64` clamps the same way.
    io::printInt((15).clamp(0, 10))

    // NaN is not finite, and is not equal even to itself.
    val nan = 0.0 / 0.0
    io::println("\((1.0 / 0.0).isFinite()) \(nan.isNaN()) \(x.isFinite()) \(nan.min(1.0))")
}
