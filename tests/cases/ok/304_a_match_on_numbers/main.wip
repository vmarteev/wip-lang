// A `match` on a number whose arms are numbers is one switch, which the
// code generator makes a jump table where the cases are close together: an
// interpreter's opcodes, bytes, characters. A negative number, or one too
// large for a case, is tested in order as before; a constant worked out
// while the program is checked takes the same arms.
//
// Expected output: 10, 11, 0, 12, 1, 2, 3, 99, 7, 8, 9, 5.

import std::io

val OP_A: u8 = 0
val OP_B: u8 = 1
val OP_C: u8 = 40

fn opcode(op: u8): i64 = match op {
	OP_A => 10
	OP_B => 11
	OP_C => 12
	_ => 0
}

fn letter(c: char): i64 = match c {
	'a' | 'b' => 1
	'c' => 2
	other if other == 'z' => 26
	_ => 3
}

fn signed(n: i64): i64 = match n {
	-1 => 99
	0 => 7
	4294967297 => 8
	_ => 9
}

// Worked out before the program runs: 2^32 + 1 is not the case for 1.
@comptime
val FOLDED: i64 = match 4294967297 as i64 {
	1 => 4
	_ => 5
}

fn main() = {
	for op in [0 as u8, 1, 2, 40] {
		io::printInt(opcode(op))
	}
	for c in ['a', 'c', 'q'] {
		io::printInt(letter(c))
	}
	for n in [-1, 0, 4294967297, 1] {
		io::printInt(signed(n))
	}
	io::printInt(FOLDED)
}
