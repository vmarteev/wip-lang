// `Result<T, E>`: a value, or why there is none. It is in
// the prelude beside `Option`, with the same vocabulary of methods.
//
// Expected output: 1 and 0 (`isOk` and `isErr`), 3 and 7 (`unwrapOr` with a
// value and with an error), 6 and 7 (`map`, which leaves an error alone),
// 6 (a chain through `flatMap`), 200 (`fold` of the error), 300 (`mapErr`),
// 1 and 1
// (`any` and `all`), 8 (`orElse`), 5 (`unwrap`), 4 and 9 (`toOption`
// and `toResult` the other way), 2 (`swap`), 5 (`flatten`), and 3 (an error
// that owns memory, taken apart), with every allocation freed.

import std::io

fn double(value: i64): i64 = value * 2

fn half(value: i64): Result<i64, i64> = if value % 2 == 0 {
    .Ok(value / 2)
} else {
    .Err(1)
}

fn hundredTimes(error: i64): i64 = error * 100

fn positive(value: &i64): bool = value > 0

struct Token {
    id: i64
}

fn main() = {
    val ok: Result<i64, i64> = .Ok(3)
    val err: Result<i64, i64> = .Err(2)
    io::printInt(if ok.isOk() { 1 } else { 0 })
    io::printInt(if ok.isErr() { 1 } else { 0 })

    io::printInt(ok.unwrapOr(7))
    io::printInt(err.unwrapOr(7))
    io::printInt(ok.map(double).unwrapOr(0))
    io::printInt(err.map(double).unwrapOr(7))
    io::printInt(ok.map(double).flatMap(half).map(double).unwrapOr(0))

    io::printInt(err.fold(hundredTimes, double))
    io::printInt(err.mapErr(hundredTimes).swap().unwrapOr(0) + 100)

    io::printInt(if ok.any(positive) { 1 } else { 0 })
    io::printInt(if err.all(positive) { 1 } else { 0 })

    val fallback: Result<i64, i64> = .Ok(8)
    io::printInt(err.or(fallback).unwrap())

    val five: Result<i64, i64> = .Ok(5)
    io::printInt(five.unwrap())

    val some: Option<i64> = .Some(4)
    io::printInt(some.toResult(1).unwrapOr(0))
    val none: Option<i64> = .None
    io::printInt(none.toResult(9).swap().unwrapOr(0))

    io::printInt(ok.swap().unwrapOr(2))

    val nested: Result<Result<i64, i64>, i64> = .Ok(.Ok(5))
    io::printInt(Result::flatten(nested).unwrapOr(0))

    val owned: Result<i64, own<Token>> = .Err(own Token(id: 3))
    io::printInt(match move owned {
        .Ok(value) => value
        .Err(token) => token.id
    })
}
