// Comparison and boolean operators. `&&` and `||` short-circuit.

import std::io

fn toInt(b: bool): i64 = {
    if b {
        return 1
    }
    0
}

fn main(): i64 = {
    val x = 4
    val y = 9
    io::printInt(toInt(x < y))             // 1
    io::printInt(toInt(x <= 4 && y >= 10)) // 0
    io::printInt(toInt(x == 4 || y != 9))  // 1
    io::printInt(toInt(!(x > y)))          // 1
    io::printInt(toInt(true && !false))    // 1
    0
}
