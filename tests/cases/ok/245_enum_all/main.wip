// An enum whose variants carry nothing answers all of them, in order, as
// an array; one that declares its own `all` keeps it.

import std::io

@derive(Eq)
enum Ghost {
	Blinky
	Pinky
	Inky
	Clyde
}

enum Maybe<T> {
	Yes
	No
}

enum Own {
	One
	Two
}

extend Own {
	static fn all(): i64 = 42
}

fn main() = {
	var names = 0
	for ghost in Ghost::all() {
		names = names * 10 + ghost as i64 + 1
	}
	val every = Ghost::all()
	io::println("\(names) \(every.len()) \(every[2] == .Inky)")
	io::println("\(Maybe<i64>::all().len()) \(Own::all())")
}
