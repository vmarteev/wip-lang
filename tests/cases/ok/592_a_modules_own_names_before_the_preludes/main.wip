// A module's own names come before the prelude's: it declares its own
// `Text`, `Index` and `Encoder`, and imports an `Option`, and what the
// compiler writes — interpolation, a tuple, `x[i]`, a `for`, `+`, `?` and
// the derives — is still the prelude's, which the program reaches by its
// path where it has its own of that name.
//
// Expected output:
// glyphs: 3
// zone 2 at (4, 5)
// 24
// 60
// true
// 1
// 8
// true
// {"zone":2,"x":4,"z":5}

import std::io
import std::json
import zones::{Option}

/// The module's own text: a line of glyphs.
struct Text {
    glyphs: i64
}

/// The module's own index: where a zone is.
@derive(Eq, Clone, Encode, Decode)
struct Index {
    zone: i64
    x: i64
    z: i64
}

/// The module's own encoder, which encodes nothing.
struct Encoder {
    count: i64
}

extend Index: std::prelude::Text {
    fn appendTo(out: &var String) = out.push("zone \(self.zone) at (\(self.x), \(self.z))")
}

fn found(at: i64): std::prelude::Option<i64> = if at > 0 then .Some(at) else .None

fn doubled(at: i64): std::prelude::Option<i64> = {
    val value = found(at)?
    return .Some(value * 2)
}

fn main() = {
    val text = Text(glyphs: 3)
    io::println("glyphs: \(text.glyphs)")
    val index = Index(zone: 2, x: 4, z: 5)
    io::println("\(index)")
    val pair = (index.x, index.z)
    val xs = [10, 20, 30]
    io::println("\(xs[1] + pair.0)")
    var sum = 0
    for x in xs {
        sum += x
    }
    io::println("\(sum)")
    io::println("\(index.clone() == index)")
    io::println("\(Encoder(count: 1).count)")
    io::println("\(doubled(4).unwrapOr(0))")
    val zone = Option::Unknown
    io::println("\(zone is .Unknown)")
    io::println(json::encode(&index))
}
