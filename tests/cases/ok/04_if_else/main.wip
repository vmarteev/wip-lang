// `if` / `else if` / `else` chains. `if` is a statement, not an expression.

import std::io

fn classify(n: i64) = {
    if n < 0 {
        io::println("negative")
    } else if n == 0 {
        io::println("zero")
    } else if n < 10 {
        io::println("small")
    } else {
        io::println("large")
    }
}

fn main(): i64 = {
    classify(-5)
    classify(0)
    classify(7)
    classify(100)
    0
}
