// A pattern that moves one field out of a value drops the fields it does
// not take, as `.Edits(changes, ..)` drops what `..` leaves. The case runs
// with the leak check on.
//
// Expected output: what each pattern took, one to a line.

import std::io

enum Dialog {
    Closed,
    Edits(listing: String, changes: String),
}

struct Pair {
    kept: String,
    left: String,
}

enum Wrapped {
    Inner(dialog: Dialog, note: String),
    Nothing,
}

fn edits(): Dialog = .Edits(listing: String::of("the listing"), changes: String::of("the changes"))

fn byMatch(): String = match edits() {
    .Edits(changes, ..) => move changes
    .Closed => String()
}

fn byElse(): String = {
    val .Edits(listing, ..) = edits() else {
        return String()
    }
    return move listing
}

fn byIs(): String = {
    if edits() is .Edits(changes, ..) {
        return move changes
    }
    return String()
}

fn nested(): String = match Wrapped::Inner(dialog: edits(), note: String::of("a note")) {
    .Inner(dialog: .Edits(changes, ..), ..) => move changes
    _ => String()
}

fn fields(): String = {
    val Pair(kept, ..) = Pair(kept: String::of("kept"), left: String::of("left"))
    return move kept
}

// A variable moved into the match, as a temporary is.
fn fromVariable(): String = {
    val dialog = edits()
    return match move dialog {
        .Edits(listing, ..) => move listing
        .Closed => String()
    }
}

fn main() = {
    io::println(byMatch())
    io::println(byElse())
    io::println(byIs())
    io::println(nested())
    io::println(fields())
    io::println(fromVariable())
}
