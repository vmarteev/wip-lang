// A value holding views changed in calls that also write a context:
// a parser whose source is a view of the text, stepped
// with the machine it fills, which every step writes. What a `&var`
// argument reaches is not kept by another argument, so the parser does not
// borrow the machine, and goes on being used.
//
// Expected output: 3, "abc".

import std::io

struct Vm {
	names: Vec<String>
}

view struct Parser {
	source: str
	at: i64
}

extend Parser {
	var fn step(vm: &var Vm) = {
		vm.names.push(String::of(self.source[self.at..self.at + 1]))
		self.at += 1
	}

	fn done(): bool = self.at >= self.source.len()
}

fn main() = {
	var vm = Vm(names: Vec())
	val text = String::of("abc")
	var parser = Parser(source: text.toStr(), at: 0)
	while !parser.done() {
		parser.step(&var vm)
	}
	io::printInt(vm.names.len())
	var joined = String()
	for name in vm.names {
		joined.push(name)
	}
	io::println("\"\(joined)\"")
}
