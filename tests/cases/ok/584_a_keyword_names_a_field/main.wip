// A keyword names a field where only a field's name can stand: declared,
// in a struct, a C struct and a variant; after `.`; before the `:` of a
// literal's value; and before the `:` of a pattern's, which binds it under
// a name of its own. A derived `Decode` reads a format whose keys are
// keywords, and `Encode` writes them.
//
// Expected output:
// 2 hi go
// 3 5
// 7 true
// 8
// {"when":[3,4],"say":"hi","then":["go"],"var":1}
// 9 2

import std::io
import std::json

@derive(Clone, Encode, Decode)
struct Talk {
	pub when: Vec<i64> = Vec()
	pub say: String
	pub then: Vec<String> = Vec()
	var: i64 = 0
}

extern struct Event {
	pub var type: c_int
	static: c_int
}

enum Shape {
	Opening(type: i64, in: bool)
	Rock
}

fn main() = {
	val talk = Talk(
		when: Vec::of([3, 4]),
		say: String::of("hi"),
		then: Vec::of([String::of("go")]),
		var: 1,
	)
	io::println("\(talk.when.len()) \(talk.say) \(talk.then[0])")

	var event = Event(type: 2, static: 5)
	event.type += 1
	io::println("\(event.type) \(event.static)")

	val shape = Shape::Opening(type: 7, in: true)
	match shape {
		.Opening(type: t, in: inside) => io::println("\(t) \(inside)")
		.Rock => {}
	}
	if shape is .Opening(type: var t, ..) {
		t += 1
		io::println("\(t)")
	}

	io::println(json::encode(&talk))
	val back = json::decode<Talk>(
		"{\"when\": [9], \"say\": \"x\", \"then\": [\"a\", \"b\"]}",
	).unwrap()
	io::println("\(back.when[0]) \(back.then.len())")
}
