// `b'x'`: the byte of an ASCII character, a `u8`. What a
// parser compares a text's bytes with, in an expression, a constant and a
// pattern, with the escapes a character has.

import std::io

val SLASH: u8 = b'/'

fn kind(byte: u8): str = match byte {
    b'/' => "a slash"
    b'a' | b'e' | b'i' | b'o' | b'u' => "a vowel"
    b'\n' => "a line's end"
    b'\'' => "a quote"
    b'\u{7F}' => "delete"
    _ => "something else"
}

fn main() = {
    val path = "usr/local/bin"
    var slashes = 0
    for i in 0..path.len() {
        if path[i] == SLASH {
            slashes += 1
        }
    }
    io::println("\(slashes) slashes")
    io::println("\(b'A') \(b'A' + 1) \(b'\\' as i64) \(b'\0') \(b'z' > b'a')")
    io::println("\(kind(path[0])) \(kind(path[3])) \(kind(10)) \(kind(39)) \(kind(127)) \(kind(b'z'))")
    // A letter's case, by its distance from `a`.
    val upper = path[0] - b'a' + b'A'
    io::println("\(upper as char)")
}
