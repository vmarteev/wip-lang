// Temporaries that own memory are freed at the end of their statement:
// a discarded result, a field read from a returned `own`, an
// `own` created only to be borrowed, and one made in a loop condition. The run
// test checks that nothing leaks.

import std::io

struct Buffer {
    len: i64
}

fn make(len: i64): own<Buffer> = {
    own Buffer(len: len)
}

fn length(b: &Buffer): i64 = {
    b.len
}

fn main(): i64 = {
    make(1)
    io::printInt(make(2).len)      // 2
    io::printInt(length(make(3))) // 3
    own 4
    var i = 0
    while make(i).len < 3 {
        i = i + 1
    }
    io::printInt(i)                // 3
    0
}
