// A range of what a pointer points at is checked to be a range: a start
// after its end panics, as it does for an array, though nothing says how
// many elements there are.
//
// Expected output: the panic, after the line before it.

import std::c
import std::io

fn main() = {
    val values: [u8; 4] = [1, 2, 3, 4]
    val p = c::pointerTo(&values)
    val start = 3
    io::println("ranging")
    val backwards = &p[start..1]
    io::println("\(backwards.len())")
}
