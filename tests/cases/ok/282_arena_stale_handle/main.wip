// A handle to a value removed from an arena panics where it is used,
// even once another value has taken its slot: the slot's
// generation has moved on.
//
// Expected output: 1, then the panic on standard error, and status 101.

import std::io
import std::collections::{Arena}

fn main() = {
	var numbers: Arena<i64> = Arena()
	val first = numbers.add(1)
	io::printInt(numbers[first])
	numbers.remove(first)
	numbers.add(2)
	io::printInt(numbers[first])
}
