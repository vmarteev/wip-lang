// A sequence is anything with positions from 0 and a length: a vector, a slice,
// an array through the slice it lends, a set's keys in the order they went in,
// a map's values, and a container of a program's own. One constraint takes all
// of them, and `c[i]`, `c.len()` and `for` work on each.
//
// Expected output: 10 from a vector, 6 from an array, 5 from a slice of it,
// 30 from the values of a map, 12 from a ring buffer of the program's own,
// and 9 from a set; then the first and last of each, 1 4, 1 3, 3 4 and
// 7 2, and the set's second key read by position, 2.

import std::io
import std::collections::{Map, Set}

fn total<C: Sequence<i64>>(c: &C): i64 = {
    var sum = 0
    for x in c {
        sum += x
    }
    sum
}

fn ends<C: Sequence<i64>>(c: &C): String = "\(c[0]) \(c[c.len() - 1])"

fn tail(values: &[i64]): i64 = total(&values[1..values.len()])

struct Ring {
    slots: [i64; 3],
    start: i64
}

extend Ring: Sequence<i64> {
    fn len(): i64 = 3

    fn at(i: i64): &i64 = lend self.slots[(self.start + i) % 3]
}

fn main() = {
    val vector = Vec::of(own [1, 2, 3, 4])
    val numbers = [1, 2, 3]
    var map = Map<str, i64>()
    map.put("a", 10)
    map.put("b", 20)
    val ring = Ring(slots: [5, 4, 3], start: 2)
    var set = Set<i64>()
    set.add(7)
    set.add(2)

    io::println("\(total(&vector)) \(total(&numbers)) \(tail(&numbers)) \(total(&map.values())) \(total(&ring)) \(total(&set))")
    io::println("\(ends(&vector)), \(ends(&numbers)), \(ends(&ring)), \(ends(&set)), \(set[1])")
}
