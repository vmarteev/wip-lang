// `for` walks what implements the prelude's `Iterator`, by calling
// `next()` until it answers nothing. An iterator made
// where the loop is written is walked in a variable of the loop's own; a
// variable is walked where it is, so after a `break` it carries on from
// there. `break`, `continue` and a loop's name mean what they mean in any
// loop, and a constraint says a type parameter can be walked.

import std::io

/// The words of a text, one at a time.
view struct Words {
    text: str,
    at: i64
}

extend Words {
    static fn of(text: str): Words = Words(text: text, at: 0)
}

extend Words: Iterator<str> {
    var fn next(): Option<str> = {
        while self.at < self.text.len() && self.text[self.at] == 32 {
            self.at += 1
        }
        if self.at == self.text.len() {
            return .None
        }
        val start = self.at
        while self.at < self.text.len() && self.text[self.at] != 32 {
            self.at += 1
        }
        .Some(self.text[start..self.at])
    }
}

/// Counts down to one: an iterator that is not a view.
struct Countdown {
    left: i64
}

extend Countdown: Iterator<i64> {
    var fn next(): Option<i64> = {
        if self.left == 0 {
            return .None
        }
        self.left -= 1
        .Some(self.left + 1)
    }
}

fn count<I: Iterator<T>, T>(it: I): i64 = {
    var walked = move it
    var n = 0
    for _ in walked {
        n += 1
    }
    n
}

fn main() = {
    val owned = String::of("one two  three four")
    for w in Words::of(owned.toStr()) {
        io::println(w)
    }

    var words = Words::of(owned.toStr())
    for w in words {
        if w == "two" {
            break
        }
    }
    for w in words {
        io::println(w)                          // three, four
    }

    outer: for n in (Countdown(left: 3)) {
        for w in Words::of("a b") {
            if n == 2 {
                continue outer
            }
            io::printInt(n)
            io::println(w)
        }
    }

    io::printInt(count(Words::of("x y z")))
    io::printInt(count(Countdown(left: 5)))
}
