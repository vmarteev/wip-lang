// A C struct a function answers borrows what the function's signature
// lends to what its pointers point at, as a view holding a `&` does: one
// pointing into an argument, a vector of them, one through `from`, a
// method's pointing into its receiver, and one pointing at another. One
// that comes in through a type parameter — made inside `onHeap` — borrows
// nothing, as one from C does.
//
// Expected output:
// 6
// 21
// 6
// 10
// 6
// 0

import std::io
import std::mem

@header("parts.h")
extern "C" {
    struct Part {
        values: ptr<i32>
        count: i64
    }

    struct Pair {
        first: ptr<Part>
        tag: ptr<void>
    }

    fn total(parts: &[Part]): i64
    fn first_total(pair: &Pair): i64
}

/// A part over all of `values`.
fn partOf(values: &[i32]): Part = Part(values: &values, count: values.len())

/// A part over each list.
fn partsOf(lists: &[Vec<i32>]): Vec<Part> = {
    var parts: Vec<Part> = Vec()
    for list in lists {
        parts.push(Part(values: &list.items(), count: list.len()))
    }
    return parts
}

/// A part over `a`, which is all it borrows.
fn firstPart(a: &[i32], b: &[i32]): Part from a = Part(values: &a, count: a.len() + 0 * b.len())

struct Numbers {
    values: Vec<i32>
}

extend Numbers {
    fn part(): Part = Part(values: &self.values.items(), count: self.values.len())
}

/// A pair whose first part is `part`, tagged with `tag`.
fn pairOf(part: &Part, tag: &i64): Pair = Pair(first: &part, tag: &tag)

fn main() = {
    val small: [i32; 3] = [1, 2, 3]
    val part = partOf(&small)
    io::println("\(total([part]))")
    val lists: Vec<Vec<i32>> = Vec::of(own [Vec::of(own [1, 2, 3]), Vec::of(own [4, 5, 6])])
    val parts = partsOf(&lists.items())
    io::println("\(total(&parts.items()))")
    var other: [i32; 2] = [9, 9]
    val first = firstPart(&small, &other)
    other[0] = 1
    io::println("\(total([first]))")
    val numbers = Numbers(values: Vec::of(own [1, 2, 3, 4]))
    io::println("\(total([numbers.part()]))")
    val tag: i64 = 7
    val pair = pairOf(&part, &tag)
    io::println("\(first_total(&pair))")
    val kept = mem::onHeap(() => Part(count: 0))
    io::println("\(kept.count + other[1] as i64 - 9)")
}
