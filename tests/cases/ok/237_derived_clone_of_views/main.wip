// `@derive(Clone)` clones each field as a value of its own type, so a
// field that is a reference — written `&T` or through an alias of one —
// is the reference copied, and what the view owns is cloned.

import std::io

type Seen = &String

@derive(Clone)
view struct Row {
    name: &String
    also: Seen
    tags: Vec<String>
}

@derive(Clone)
view enum Piece {
    Named(name: &String, parts: Vec<String>)
    Plain
}

fn main() = {
    val owner = String::of("row")
    var tags: Vec<String> = Vec()
    tags.push("a")
    val row = Row(name: &owner, also: &owner, tags: move tags)
    var copy = row.clone()
    copy.tags.push("b")
    io::println("\(copy.name) \(copy.also) \(row.tags.len()) \(copy.tags.len())")

    var parts: Vec<String> = Vec()
    parts.push("p")
    val piece = Piece::Named(name: &owner, parts: move parts)
    if piece.clone() is .Named(name, parts) {
        io::println("\(name) \(parts.len())")
    }
    io::println("\(cloneOf(&owner)) \(cloneOf(3))")
}
