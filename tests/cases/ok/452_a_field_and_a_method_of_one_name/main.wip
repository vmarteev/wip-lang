// A field and a method may share a name: `x.name` is the field, read where
// it may be, and `x.name()` the method. Another module sees a private
// field's method alone; where both are `pub`, it reads either. A `var fn`,
// a `static fn`, a lending pair and an interface's method may each take a
// field's name, and so may a field whose type is a type parameter.
//
// Expected output: "90 UTC 2 120", the moment read through its methods and
// its `pub` field; "5 10", a counter stepped twice; "8", a card written
// through a lending pair; "3 3", a batch's length through its interface,
// directly and in a generic function; and "7 7", a local type's field and
// method.

import std::io

import clock
import clock::{Batch, Card, Counter, Moment, Sized, Slot}

fn sizeOf<T: Sized>(value: &T): i64 = value.len()

struct Tally {
    total: i64

    fn total(): i64 = self.total
}

fn main() = {
    val moment = Moment::of(90, "UTC", 2)
    io::println("\(moment.seconds()) \(moment.zone()) \(moment.offset) \(moment.offset())")

    var counter = Counter::step(5)
    val first = counter.count()
    io::println("\(first) \(counter.count())")

    var slot = Slot::holding(Card(rank: 7))
    slot.value().rank += 1
    io::println("\(slot.value().rank)")

    val batch = Batch::of(3)
    io::println("\(batch.len()) \(sizeOf(&batch))")

    val tally = Tally(total: 7)
    io::println("\(tally.total) \(tally.total())")
}
