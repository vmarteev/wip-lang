// Types whose fields are named as the methods that read them.

pub struct Moment {
    seconds: i64
    zone: String
    pub offset: i64

    pub static fn of(seconds: i64, zone: str, offset: i64): Moment =
        Moment(seconds: seconds, zone: zone, offset: offset)

    pub fn seconds(): i64 = self.seconds
    pub fn zone(): str = self.zone.toStr()
    // Both `pub`: `m.offset` is the field, `m.offset()` the method, which
    // does more than read it.
    pub fn offset(): i64 = self.offset * 60
}

pub struct Counter {
    count: i64
    step: i64

    // A `static fn` of a field's name, called through the type.
    pub static fn step(by: i64): Counter = Counter(count: 0, step: by)

    // A `var fn` of a field's name, which writes the field.
    pub var fn count(): i64 = {
        self.count += self.step
        return self.count
    }
}

pub struct Card {
    pub var rank: i64
}

pub struct Slot<T> {
    value: T

    pub static fn holding(value: T): Slot<T> = Slot(value: value)

    // A lending pair of the name of a field whose type is a parameter.
    pub fn value(): &T = lend self.value
    pub var fn value(): &var T = lend self.value
}

pub interface Sized {
    fn len(): i64
}

pub struct Batch {
    len: i64

    pub static fn of(len: i64): Batch = Batch(len: len)
}

// An interface's method of a field's name.
extend Batch: Sized {
    fn len(): i64 = self.len
}
