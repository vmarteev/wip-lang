// A `val … else` binding of plain data takes a copy, so the place it came
// from is free for the rest of the block: the value is
// taken out and the place can be cleared in the same breath. A payload
// that owns memory still refers to the place, which is why it may not
// change while the binding lives.
//
// Expected output: took 7, left .None; the copy keeps what it had, 7 after
// the place became .Some(9); and a String payload read through its
// binding, 2.

import std::io

struct Board {
    selected: Option<i64>,
    moves: i64
}

extend Board {
    var fn take(): i64 = {
        val .Some(id) = self.selected else {
            return -1
        }
        // The place is the board's again: the binding holds a copy.
        self.selected = .None
        self.moves += 1
        id
    }
}

struct Holder {
    text: Option<String>
}

fn length(h: &Holder): i64 = {
    val .Some(text) = h.text else {
        return 0
    }
    text.len()
}

fn main() = {
    var board = Board(selected: .Some(7), moves: 0)
    io::println("took \(board.take()), left \(board.selected)")

    var other = Board(selected: .Some(7), moves: 0)
    val .Some(kept) = other.selected else {
        return
    }
    other.selected = .Some(9)
    io::println("\(kept) after \(other.selected)")

    val holder = Holder(text: .Some(String::of("hi")))
    io::println("\(length(&holder))")
}
