// A loop that yields where a value stands is a generator:
// it runs as its values are asked for, and borrows what it names. Walked
// by `for`, taken by adapters, left half-run, nested, asked after it
// ended, and made in a generic function. The case runs with the leak
// check on, so what a generator holds where it stopped is dropped.

import std::io

fn firstOf<T: copy>(xs: &[T], count: i64): Vec<T> = (for x in xs { yield x }).take(count).toVec()

fn apply(f: &(x: i64) => i64, x: i64): i64 = f(x)

struct Env {
    offset: i64,
}

extend Env {
    fn subst(t: i64): i64 = t + self.offset

    // What an adapter's owned closure cannot capture, a generator reads:
    // `self` is a name around it.
    fn all(types: &Vec<i64>): Vec<i64> = (for t in types { yield self.subst(t) }).toVec()
}

fn main() = {
    val xs = [1, 2, 3, 4, 5, 6]

    // Nothing runs until it is asked.
    var evens = for x in xs {
        io::println("looking at \(x)")
        if x % 2 == 0 { yield x }
    }
    io::println("made")
    assert(evens.next() == .Some(2))
    io::println("asked once")
    var rest = 0
    for e in evens {
        rest += e
    }
    assert(rest == 10)

    // Adapters take the generator.
    val squares = (for x in xs { yield x * x }).filter(own (n) => n > 4).take(2).toVec()
    assert(squares == Vec::of(own [9, 16]))

    // Owned values, made one at a time.
    var joined = String()
    for w in (for x in xs { yield String::of("w\(x)") }) {
        joined.push(w.toStr())
    }
    assert(joined == "w1w2w3w4w5w6")

    // Left where it stopped, holding a `String` in scope, and dropped.
    var half = for x in xs {
        val held = String::of("held \(x)")
        yield held.len()
    }
    assert(half.next() == .Some(6))
    assert(half.next() == .Some(6))

    // A generator in a generator's loop, which captures what the outer one
    // did.
    var pairs = for x in xs {
        if x < 3 {
            for y in (for z in xs { if z > 4 { yield z } }) {
                yield x * 10 + y
            }
        }
    }
    assert(pairs.toVec() == Vec::of(own [15, 16, 25, 26]))

    // A captured `String`, walked by what it lends.
    val text = String::of("a bb ccc")
    assert((for w in text.split(" ") { yield w.len() }).toVec() == Vec::of(own [1, 2, 3]))

    // `break` ends it.
    var small = for x in xs {
        if x > 2 { break }
        yield x
    }
    assert(small.toVec() == Vec::of(own [1, 2]))

    // Asked after it ended, it answers nothing again.
    var once = for x in [7] { yield x }
    assert(once.next() == .Some(7))
    assert(once.next().isNone())
    assert(once.next().isNone())

    assert(firstOf(&xs, 2) == Vec::of(own [1, 2]))

    // What captures a name the body around it captured copies that
    // body's reference: a lambda in a lambda, too.
    val base = 10
    assert(apply((x) => apply((y) => y + base, x) * 2, 1) == 22)
    val env = Env(offset: 100)
    assert(env.all(Vec::of(own [1, 2])) == Vec::of(own [101, 102]))
    io::println("done")
}
