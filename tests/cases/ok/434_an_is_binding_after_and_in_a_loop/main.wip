// An `is` test after `&&`, in a loop, whose binding the `if` moves out: each
// pass binds it afresh where the test runs and matches, and nothing names it
// where the left operand was false. The pass where the test did not run once
// kept the move of the pass before, and the move read as one made on every
// pass.
//
// Expected output: taken 2, then taken 3.

import std::io

fn found(n: i64): Option<String> = if n > 1 then .Some("taken \(n)") else .None

fn main() = {
	var all: Vec<String> = Vec()
	for n in 0..4 {
		if n > 0 && found(n) is .Some(text) {
			all.push(move text)
		}
	}
	for text in all {
		io::println(text)
	}
}
