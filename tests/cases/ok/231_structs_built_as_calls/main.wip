// A struct is built as a variant is, with a call's arguments: with two or
// more fields each is named, a variable with a field's name standing for
// `name: name`; one field may be given by position; a field left out takes
// its default, and `..base` comes last.

import std::io
import shapes::{Size}

view struct Row {
    name: str
    size: i64 = 0
}

struct Pair<A, B> {
    first: A
    second: B
}

@derive(Text)
struct Point {
    x: i64
    y: i64
}

/// One field, which is given by position.
struct Metres {
    value: f64
}

extend Row {
    /// `Self(…)` builds the type the method belongs to.
    fn grown(): Row = Self(size: self.size + 1, ..self)
}

fn main() = {
    val a = Row(name: "a.txt", size: 3)
    val b = Row(name: "b.txt", size: 4)
    val c = Row(name: "c.txt")
    val d = Row(name: "d.txt", ..a)
    io::println("\(a.name) \(a.size), \(b.name) \(b.size), \(c.name) \(c.size), \(d.name) \(d.size), \(a.grown().size)")

    // Type arguments written, or inferred from the fields.
    val p = Pair<i64, str>(first: 1, second: "one")
    val q = Pair(first: 2, second: true)
    io::println("\(p.second) \(q.second)")

    // Of another module, by its imported name or by its path.
    val s = Size(width: 5)
    val t = shapes::Size(width: 2, height: 3)
    io::println("\(s.width)x\(s.height) \(t.width)x\(t.height)")

    // A variable with a field's name is that field, in any order, as a
    // pattern binds by name; one field is given by position.
    val x = 1
    val y = 2
    val swapped = Point(y, x)
    val tall = Metres(1.8)
    io::println("\(swapped) \(tall.value)")

    // In a condition, with no parentheses around it.
    if a.size == Row(name: "x", size: 3).size {
        io::println("a condition builds one too")
    }
}
