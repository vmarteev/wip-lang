// What depends on how a page was built is refused as it is written, not
// while the program is compiled. A literal that ends inside a tag is not
// refused, since a tag may be written in steps; where it is joined to a
// page, the page refuses it.
//
// Expected output: the tag written in steps, then a panic where the open
// tag is joined.

import std::io
import std::markup::{Html}

/// A link's opening tag, which leaves the tag open for its attributes.
fn opening(href: str): Html = "<a href=\"\(href)\""

fn main() = {
	var link = opening("/a")
	link.pushLiteral(" class=\"x\">a</a>")
	io::println(link.toStr())
	val open = opening("/b")
	val page: Html = "<p>\(open)</p>"
	io::println(page.toStr())
}
