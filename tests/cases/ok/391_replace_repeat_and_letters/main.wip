// Text made from text and characters as Unicode classes them: each
// occurrence of a pattern replaced, left to right and none overlapping,
// from a `str` and a `String`, or the first so many; text repeated; and a
// letter or a number of any script, apart from `isDigit`'s `0` to `9`.
//
// Expected output: a+b+c ba one 2 2 héllo world, then a+b-c a-b-c, then
// ababab [], then
// true true true false, then true false, then false false.

import std::io

fn main() = {
	val owned = String::of("one two two")
	io::println("\("a-b-c".replace("-", by: "+")) \("aaa".replace("aa", by: "b")) \(owned.replace("two", by: "2")) \("héllo wörld".replace("ö", by: "o"))")
	io::println("\("a-b-c".replace("-", by: "+", count: .Some(1))) \("a-b-c".replace("-", by: "+", count: .Some(0)))")
	io::println("\("ab".repeat(3)) [\("x".repeat(0))]")
	io::println("\('é'.isLetter()) \('中'.isLetter()) \('я'.isAlphanumeric()) \('_'.isLetter())")
	io::println("\('٣'.isNumeric()) \('٣'.isDigit())")
	io::println("\('\u{301}'.isLetter()) \(' '.isAlphanumeric())")
}
