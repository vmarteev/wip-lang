// `defer` and drops share one stack per block. `search` opens a C file handle
// and defers closing it, allocates `own` values, and returns early from inside
// a loop. The runtime traces every allocation and free, so the output shows the
// whole cleanup, in order:
//
//   alloc #1                  `header`
//   alloc #2                  `record` in the first iteration
//   loop: end of iteration    the iteration ends: its `defer` runs...
//   free #2                   ...then `record`, declared before it, is freed
//   alloc #3
//   search: found, returning
//   loop: end of iteration    the `return` unwinds the loop body first,
//   free #3
//   free #1                   then the function body: `header`,
//   search: file closed       then the first `defer`
//   20
//
// The C `FILE *` is held in an `i64`, which a 64-bit target can do.

import std::io

extern "C" {
    fn fopen(path: cstring, mode: cstring): i64
    fn fputs(s: cstring, file: i64): i32
    fn fclose(file: i64): i32
    fn wip_trace_allocs()
}

struct Record {
    id: i64
}

fn search(target: i64): i64 = {
    val file = fopen("/dev/null", "w")
    defer {
        fclose(file)
        io::println("search: file closed")
    }
    val header = own Record(id: 0)
    var i = 1
    while i < 10 {
        val record = own Record(id: i)
        defer io::println("loop: end of iteration")
        fputs("record\n", file)
        if record.id == target {
            io::println("search: found, returning")
            return record.id * 10
        }
        i = i + 1
    }
    -1
}

fn main(): i64 = {
    wip_trace_allocs()
    io::printInt(search(2))
    0
}
