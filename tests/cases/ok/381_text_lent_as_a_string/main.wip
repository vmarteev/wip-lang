// Text is lent as a `String` where a `&String` is taken: a map keyed by
// `String` is looked up, changed and emptied by a literal or a `str`, and so
// is a set, and so is a program's own function. The `String` is made over the
// text's own bytes, so nothing is allocated, copied or dropped for it, which
// the leak check confirms.
//
// Expected output: 2 0, then true false, then hello, world, then 3.

import std::collections::{Map, Set}
import std::io

fn greet(name: &String): String = "hello, \(name)"

fn main() = {
	var counts: Map<String, i64> = Map()
	for word in "the cat and the hat".split(" ") {
		counts.atOrPut(String::of(word), 0) += 1
	}
	val missing = if counts.get("dog") is .Some(n) then n else 0
	io::println("\(counts.at("the")) \(missing)")
	assert(counts.remove("and") == .Some(1) && !counts.contains("and"))

	var names: Set<String> = Set()
	names.add(String::of("ada"))
	io::println("\(names.contains("ada")) \(names.contains("bob"))")

	io::println(greet("world"))

	var total = 0
	for word in "the cat dog".split(" ") {
		if counts.get(word) is .Some(n) then total += n
	}
	io::println("\(total)")
}
