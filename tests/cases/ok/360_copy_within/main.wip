// `copyWithin`: elements copied inside one slice in one
// copy of the memory: forward and backward, overlapping both ways, where
// what is read is what was there before; nothing; the whole slice onto
// itself; and a `Vec`.
//
// Expected output:
// [0, 1, 2, 3, 0, 1, 2, 7]
// [0, 1, 0, 1, 2, 3, 4, 7]
// [0, 1, 2, 3, 4, 7, 4, 7]
// [20, 30, 30] [5, 6, 7]

import std::io

fn main() = {
    var apart = own [0 as u8, 1, 2, 3, 4, 5, 6, 7]
    apart.copyWithin(from: 0, to: 4, count: 3)
    io::println("\(apart)")
    var shifted = own [0 as u16, 1, 2, 3, 4, 5, 6, 7]
    shifted.copyWithin(from: 0, to: 2, count: 5)
    io::println("\(shifted)")
    shifted.copyWithin(from: 3, to: 1, count: 5)
    io::println("\(shifted)")
    var list = Vec::of(own [10, 20, 30])
    list.copyWithin(from: 1, to: 0, count: 2)
    list.copyWithin(from: 0, to: 3, count: 0)
    var whole: [i64; 3] = [5, 6, 7]
    whole.copyWithin(from: 0, to: 0, count: 3)
    io::println("\(list) \(whole)")
}
