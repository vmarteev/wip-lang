// Bitwise operators, and integer literals in other bases.
//
// Expected output: 8, 14, 6, 40, -3, 4611686018427387901, 250, -1, 2, 2, 1,
// 1, 4, -1, 1000000, 493, 170, 255.

import std::io

fn main(): i64 = {
    val a = 12
    val b = 10
    io::printInt(a & b)
    io::printInt(a | b)
    io::printInt(a ^ b)
    io::printInt(5 << 3)

    // `>>` keeps the sign of a signed integer, and fills an unsigned one with
    // zeros.
    io::printInt(-12 >> 2)
    val wide: u64 = 0xFFFF_FFFF_FFFF_FFF4
    io::printUnsigned(wide >> 2)

    // `!` flips every bit of an integer.
    val low: u8 = 0b0000_0101
    io::printInt(!low as i64)
    io::printInt(!0)

    // The shift amount is taken modulo the width: 65 is 1 for `i64`, and 9 is
    // 1 for `u8`.
    io::printInt(1 << 65)
    val one: u8 = 1
    io::printInt((one << 9) as i64)

    // Bitwise operators bind tighter than comparisons, unlike in C.
    io::printInt(if a & 4 == 4 { 1 } else { 0 })
    val read: u32 = 0b01
    val write: u32 = 0b10
    val mode = read | write
    io::printInt(if mode & write != 0 { 1 } else { 0 })

    val one128: i128 = 1
    val huge = one128 << 100
    io::printInt((huge >> 98) as i64)
    val negative: i128 = -1
    io::printInt((negative >> 127) as i64)

    io::printInt(1_000_000)
    io::printInt(0o755)
    io::printInt(0b1010_1010)
    io::printInt(0xFf)
    0
}
