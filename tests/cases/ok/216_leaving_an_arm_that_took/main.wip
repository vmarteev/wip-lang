// Leaving a `match` arm by `break` or `continue` after it took the value
// out of a temporary: what the arm took is dropped once,
// as the arm's, and the temporary it came from is not dropped again. A
// `match` whose every arm leaves has nothing after it to drop.

import std::io

struct Noisy {
    name: String
}

extend Noisy: Destroy {
    var fn destroy() = io::println("dropped \(self.name)")
}

fn named(name: str): Option<Noisy> = .Some(Noisy(name: String::of(name)))

fn main() = {
    var n = 0
    while true {
        match named("a") {
            .Some(x) => {
                n += 1
                if n == 2 {
                    break
                }
                continue
            }
            .None => {
                break
            }
        }
    }
    while true {
        match named("b") {
            .Some(x) => {
                break
            }
            .None => {
                break
            }
        }
    }
    io::println("end")
}
