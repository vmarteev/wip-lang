// A literal takes the type of the branch beside it, as it takes the other
// operand's: in an `if`'s branches, a `match`'s arms and an array's
// elements, where nothing outside says the type, a part that takes the
// type expected of it — a number, a negated one, `.None`, a constant — is
// checked after the first part that says its own, and takes that type.
// Where every part takes it, the first decides, as before.
//
// Expected output: each value, with its type shown by what it is given to.

import std::io

val LIMIT = 200

enum Side {
    Left
    Right
}

fn take<T: copy>(value: T): T = value

fn f32s(a: f32, b: f32, c: f32, d: f32, e: f32): f32 = a + b + c + d + e

fn u8s(a: u8, b: u8, c: u8): i64 = a as i64 + b as i64 + c as i64

fn main() = {
    val width: i64 = 3
    val height: i64 = 2
    val wide = width > 1
    val x: f32 = 2.5
    val n: u8 = 7
    val aspect = if height == 0 then 1.0 else width as f32 / height as f32
    val scale = match Side::Right {
        .Left => -1.0
        .Right => x
    }
    val pair = [1.0, x]
    val chain = if !wide then 1.0 else if height > 5 then 2.0 else x
    val block = if wide {
        1.0
    } else {
        x * 2.0
    }
    io::println("floats: \(f32s(aspect, scale, pair[0], chain, block))")
    val bound = if wide then 0 else n
    val limited = if wide then LIMIT else n
    val generic = take(if wide then 1 else n)
    io::println("bytes: \(u8s(bound, limited, generic))")
    val found = if wide then .None else .Some(x)
    val first = if wide then 1.0 else 2.0
    io::println("rest: \(found) \(first)")
}
