// A pointer as the integer that is its address, and back:
// what a C library's handle is passed as, and what two handles are told
// apart by. Only an integer as wide as a pointer holds one.

import std::collections::{Set}
import std::io
import std::libc::{free, malloc}

fn main() = {
    val first = malloc(8)
    val second = malloc(8)
    val address = first as usize
    val back = address as ptr<u8>
    io::println("\(back == first) \(first as i64 == address as i64) \(address != 0)")

    // Addresses are numbers, so a set keeps each handle once.
    var seen: Set<usize> = Set()
    seen.add(first as usize)
    seen.add(second as usize)
    seen.add(back as usize)
    io::println("\(seen.len()) handles")

    io::println("\((null as ptr<u8>) as usize)")
    free(first)
    free(second)
}
