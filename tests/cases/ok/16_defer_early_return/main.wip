// `defer` and destructors share one LIFO stack, including on an early return
// from inside a loop.

import std::io

struct Token {
    id: i64
}

fn find(limit: i64): i64 = {
    defer io::println("find: cleanup")
    val guard = own Token(id: 0)
    var i = 0
    while i < limit {
        defer io::println("loop: iteration done")
        val t = own Token(id: i)
        if t.id == 3 {
            // Frees `t`, runs the loop's defer, frees `guard`, runs find's
            // defer: newest first.
            return t.id
        }
        i = i + 1
    }
    -1
}

fn main(): i64 = {
    io::printInt(find(10)) // 3
    0
}
