// A binder may take its field apart instead of naming it.
// `from: Point(x, y)` is a binder with a pattern where a new name may stand,
// and a bare name is still a binding, so `from: start` means what it always
// meant.
//
// Expected output: 4 (a struct inside a struct), 6 (the same, renamed), 1
// (a field ignored with `_`), 3 (a struct inside a variant), 7 (a walk
// that takes each element apart twice), 12 (a binding that refers into a
// place it can write), and 5 (a binder that is still just a name).

import std::io

struct Point {
    x: i64
    y: i64
}

struct Line {
    from: Point
    to: Point
}

enum Shape {
    Round(centre: Point, radius: i64)
    Square(corner: Point, side: i64)
}

fn main() = {
    val line = Line(from: Point(x: 1, y: 2), to: Point(x: 3, y: 4))

    val Line(from: Point(x, y), ..) = line
    io::printInt(x + y + 1)

    val Line(from: Point(x: fromX, ..), to: Point(x: toX, ..)) = line
    io::printInt(fromX * 3 + toX)

    // `_` nests where `..` would say it for all the rest.
    val Line(from: Point(x: here, y: _), ..) = line
    io::printInt(here)

    val shape = Shape::Round(centre: Point(x: 1, y: 2), radius: 5)
    io::printInt(match shape {
        .Round(centre: Point(x, y), ..) => x + y
        .Square(corner: Point(x, ..), side) => x + side
    })

    val lines = [
        Line(from: Point(x: 1, y: 1), to: Point(x: 2, y: 2)),
        Line(from: Point(x: 2, y: 3), to: Point(x: 0, y: 0)),
    ]
    var total = 0
    for Line(from: Point(x, y), ..) in lines {
        total += x * y
    }
    io::printInt(total)

    // A binding refers into the place it was matched from, at whatever
    // depth.
    var here = Line(from: Point(x: 5, y: 0), to: Point(x: 7, y: 0))
    val Line(from: Point(x: left, ..), to: Point(x: right, ..)) = here
    io::printInt(left + right)

    val Line(from: start, ..) = line
    io::printInt(start.x + start.y + 2)
}
