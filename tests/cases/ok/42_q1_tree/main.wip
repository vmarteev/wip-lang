// A tree whose nodes know their parent. A node cannot
// hold a reference to its parent (E0410, err/48), and an `own` has a single
// owner, so a parent cannot be owned by its children as well as own them. The
// workaround is an arena: the nodes live in one array and refer to each other
// by index.
//
// Expected output: 2 (depth of the leaf), 4 2 1 (the path to the root), 10.

import std::io

struct Node {
    value: i64
    parent: i64       // -1 for the root
    firstChild: i64  // -1 for none
    nextSibling: i64 // -1 for none
}

struct Tree {
    nodes: [Node; 16]
    count: i64
}

fn add(tree: &var Tree, parent: i64, value: i64): i64 = {
    val id = tree.count
    tree.nodes[id] = Node(value: value, parent: parent, firstChild: -1, nextSibling: -1)
    if parent >= 0 {
        tree.nodes[id].nextSibling = tree.nodes[parent].firstChild
        tree.nodes[parent].firstChild = id
    }
    tree.count = id + 1
    id
}

fn depth(tree: &Tree, id: i64): i64 = {
    var d = 0
    var at = tree.nodes[id].parent
    while at >= 0 {
        d = d + 1
        at = tree.nodes[at].parent
    }
    d
}

fn printPath(tree: &Tree, id: i64) = {
    var at = id
    while at >= 0 {
        io::printInt(tree.nodes[at].value)
        at = tree.nodes[at].parent
    }
}

fn sum(tree: &Tree, id: i64): i64 = {
    var total = tree.nodes[id].value
    var child = tree.nodes[id].firstChild
    while child >= 0 {
        total = total + sum(&tree, child)
        child = tree.nodes[child].nextSibling
    }
    total
}

fn main(): i64 = {
    val empty = Node(value: 0, parent: -1, firstChild: -1, nextSibling: -1)
    var tree = Tree(nodes: [empty; 16], count: 0)
    val root = add(&var tree, -1, 1)
    val left = add(&var tree, root, 2)
    add(&var tree, root, 3)
    val leaf = add(&var tree, left, 4)
    io::printInt(depth(&tree, leaf))
    printPath(&tree, leaf)
    io::printInt(sum(&tree, root))
    0
}
