// What an `is` test in a guard binds is seen by the rest of the guard and
// by the arm, as what an `if`'s condition binds is seen by its block: a
// copy of plain data, a reference into a place, a name read later in the
// same chain, beside alternatives, and a name the pattern binds, bound
// again. A value the guard owns ends once: where the guard fails, before
// the next arm is tried, and where it holds, with the arm.
//
// Expected output:
// quote other end
// 7 -1 -1
// 420 0
// 200 100 0
// 3 0
// fails: ~3
// holds: ~8

import std::io

struct Loud {
    id: i64
}

extend Loud: Destroy {
    var fn destroy() = io::print(" ~\(self.id)")
}

enum Mark {
    Quote
    Other
}

enum Shape {
    Round(size: i64)
    Square(size: i64)
}

fn named(mark: Mark): Option<str> = match mark {
    .Quote => "quote"
    .Other => .None
}

fn made(id: i64): Option<Loud> = Loud(id)

fn word(token: Option<Mark>): str = match token {
    .Some(mark) if named(mark) is .Some(name) => name
    .Some(_) => "other"
    .None => "end"
}

fn looked(table: &Vec<Option<i64>>, at: Option<i64>): i64 = match at {
    .Some(i) if table.get(i) is .Some(.Some(found)) => found
    _ => -1
}

fn big(value: Option<i64>): i64 = match value {
    .Some(n) if n is 10..=99 && n % 2 == 0 => n * 10
    _ => 0
}

fn side(shape: Shape, sizes: &Vec<i64>): i64 = match shape {
    .Round(size) | .Square(size) if sizes.get(size) is .Some(s) => s
    _ => 0
}

fn again(value: Option<Option<i64>>): i64 = match value {
    .Some(x) if x is .Some(x) => x
    _ => 0
}

fn owned(id: i64): i64 = match id {
    n if made(n) is .Some(loud) && loud.id > 5 => loud.id
    _ => 0
}

fn main() = {
    io::println("\(word(.Some(.Quote))) \(word(.Some(.Other))) \(word(.None))")
    val table: Vec<Option<i64>> = [7, .None]
    io::println("\(looked(&table, 0)) \(looked(&table, 1)) \(looked(&table, 5))")
    io::println("\(big(42)) \(big(43))")
    val sizes: Vec<i64> = [100, 200]
    io::println("\(side(.Round(1), &sizes)) \(side(.Square(0), &sizes)) \(side(.Round(9), &sizes))")
    io::println("\(again(.Some(.Some(3)))) \(again(.Some(.None)))")
    io::print("fails:")
    assert(owned(3) == 0)
    io::println("")
    io::print("holds:")
    assert(owned(8) == 8)
    io::println("")
}
