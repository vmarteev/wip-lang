// Extern declarations: several blocks, return types, and scalar types at the C
// boundary.

import std::io

extern "C" {
    fn labs(x: i64): i64
}

// C's maths are a library of their own on a Unix but Apple's, which a
// program that calls them links itself; Apple's and Windows' C libraries
// hold them.
@target(os = "linux")
@link("m")
extern "C" {}

extern "C" {
    fn sqrt(x: f64): f64
}

fn main(): i64 = {
    io::printInt(labs(-12)) // 12
    io::printFloat(sqrt(2.0))
    io::printCstring("ok")
    0
}
