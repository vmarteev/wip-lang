// Extern declarations: several blocks, return types, and scalar types at the C
// boundary.

import std::io

extern "C" {
    fn labs(x: i64): i64
}

// C's maths are a library of their own outside Apple's systems, which a
// program that calls them links itself.
@link("m")
extern "C" {
    fn sqrt(x: f64): f64
}

fn main(): i64 = {
    io::printInt(labs(-12)) // 12
    io::printFloat(sqrt(2.0))
    io::printCstring("ok")
    0
}
