// Fields are private by default. A module that declares
// a struct sees all of its fields; another sees the ones that say `pub`,
// and reaches the rest through the methods the type gives it.
//
// The prelude follows the same rule: `v.len()` is `pub` because reading a
// length is what every program does, and a `Vec`'s slots are not.
//
// Expected output: 0 then 2 (a count read through a method), 5 (an
// exported field), 2 (a value the module built from what it could see),
// 3 (the same value taken apart by a pattern), 3 again (a vector's
// length, which is exported), and 7 (a tuple's element).

import counter::{Counter, rewound}
import std::io

fn main() = {
    var c = Counter::upTo(5)
    io::printInt(c.count())
    c.step()
    c.step()
    io::printInt(c.count())

    // `limit` says `pub`, so it is read like any field.
    io::printInt(c.limit)

    val back = rewound(&c)
    io::printInt(back.limit)

    // A pattern takes apart what it can see: `limit` is exported, and the
    // rest is left to `..`.
    val Counter(limit, ..) = back
    io::printInt(limit + 1)

    var v = Vec<i64>()
    v.push(1)
    v.push(2)
    v.push(3)
    io::printInt(v.len())

    val pair = (7, 8)
    io::printInt(pair.0)
}
