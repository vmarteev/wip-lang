// A struct's fields belong to the module that declares it unless they
// say `pub`, so this counter can promise that its count
// never goes down: nothing outside can write it.

pub struct Counter {
    // Not `pub`: nothing outside this module may write it, which is
    // what lets `step` promise the count never goes down.
    n: i64
    pub limit: i64
}

extend Counter {
    pub static fn upTo(limit: i64): Counter = Counter(n: 0, limit: limit)

    /// The count, which nothing outside this module may write. A field
    /// and a method may not share a name, so the field is `n`.
    pub fn count(): i64 = self.n

    pub var fn step() = {
        if self.n < self.limit {
            self.n += 1
        }
    }
}

// Inside the module, a field is a field: this reads and writes one.
pub fn rewound(counter: &Counter): Counter = Counter(
    n: 0,
    limit: counter.n,
)
