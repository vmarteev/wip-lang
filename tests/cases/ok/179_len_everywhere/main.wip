// How many is `x.len()` for everything that has a length:
// an array, a slice, a `str`, a buffer, a `Vec`, a `String`, a map, a set,
// and a container's `Sequence`. One spelling, so nothing is guessed.
//
// Expected output: 3 3 5 2 4 6 2 1 2, and 6 bytes for 5 characters: a
// text's length is its bytes.

import std::io
import std::collections::{Map, Set}

fn counted(values: &[i64]): i64 = values.len()

fn main() = {
    val array = [1, 2, 3]
    val text = "hello"
    val buffer = own [0; 2]
    var vector = Vec::of(own [1, 2, 3, 4])
    var string = String::of("abcdef")
    var map = Map<str, i64>()
    map.put("a", 1)
    map.put("b", 2)
    var set = Set<i64>()
    set.add(7)
    io::println("\(array.len()) \(counted(&array)) \(text.len()) \(buffer.len()) \(vector.len()) \(string.len()) \(map.len()) \(set.len()) \(map.values().len())")
    io::println("\("naïve".len()) bytes for \("naïve".chars().count()) characters")
}
