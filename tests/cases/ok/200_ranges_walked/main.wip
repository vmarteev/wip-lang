// Walking a range of elements: `for x in xs[a..b]` lends
// the range to the loop for as long as it runs, as a container lends its
// slice, and writes through it where the whole could be written. The case
// runs with the leak check on.
//
// Expected output: 9 and 14, from an array's middle and a slice
// parameter's tail; 0 7 7 0, written through a range of a `var` array;
// "two three", from a range of a temporary vector's items; 19, from ranges
// that move along an array; and 2, the bytes of a range of a `str`.

import std::io

fn tail(values: &[i64]): i64 = {
    var sum = 0
    for v in values[1..values.len()] {
        sum += v
    }
    return sum
}

fn names(): Vec<String> = {
    var all: Vec<String> = Vec()
    for word in ["one", "two", "three", "four"] {
        all.push(String::of(word))
    }
    return move all
}

fn main() = {
    val numbers = [1, 2, 3, 4, 5]
    var middle = 0
    for n in numbers[1..4] {
        middle += n
    }
    io::println("\(middle) \(tail(&numbers))")

    var cells = [0, 0, 0, 0]
    for cell in cells[1..3] {
        cell = 7
    }
    io::println("\(cells[0]) \(cells[1]) \(cells[2]) \(cells[3])")

    var line = String()
    for name in names().items()[1..3] {
        if !line.isEmpty() {
            line.push(" ")
        }
        line.push(name.toStr())
    }
    io::println(line.toStr())

    val squares = [0, 1, 4, 9, 16]
    var total = 0
    for i in 0..3 {
        for s in squares[i..i + 2] {
            total += s
        }
    }
    io::println("\(total)")

    var bytes = 0
    for b in "hello"[1..3] {
        bytes += 1
    }
    io::println("\(bytes)")
}
