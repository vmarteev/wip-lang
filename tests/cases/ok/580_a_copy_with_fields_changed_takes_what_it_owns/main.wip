// `Name(field: value, ..base)` takes each field it does not name from
// `base`, as that field written out would: plain data is copied, and a
// field that owns memory is moved out of `base`, whose other fields stay.
// `base` may be a value that is no place, `..m.clone()`, which the literal
// holds while it takes from it. A variant is built the same way where an
// arm or an `is` test matched `base` as that variant.
//
// Expected output:
// false 2 parser true
// clear d
// c kept
// prop lamp 10
// opening door 90 1
// opening door 0 1
// plain 5 2
// prop b 1
// spot 3 4

import std::io

@derive(Clone)
struct Moved {
    definite: bool
    spans: Vec<i64>
    name: String
}

fn defaults(): Moved = Moved(definite: true, spans: Vec::of([1, 2]), name: String::of("d"))

@derive(Clone)
enum Thing {
    Prop(name: String, turn: i64, tags: Vec<String>)
    Opening(name: String, turn: i64, wired: Vec<i64>)
    Plain(x: i64, z: i64)
}

extend Thing {
    /// Each variant that turns, turned: the variant's other fields are
    /// `self`'s, given up.
    move fn turned(degrees: i64): Thing = match self {
        .Prop(turn, ..) => .Prop(turn: (turn + degrees) % 360, ..self)
        .Opening(turn, ..) => .Opening(turn: (turn + degrees) % 360, ..self)
        _ => self
    }

    /// Plain data is copied, so `self` is only read.
    fn moved(x: i64): Thing = match self {
        .Plain(..) => .Plain(x: x, ..self)
        _ => self.clone()
    }

    move fn renamed(name: String): Thing = {
        if self is .Prop(..) {
            return .Prop(name: name, ..self)
        }
        return self
    }

    fn label(): String = match self {
        .Prop(name, turn, ..) => "prop \(name) \(turn)"
        .Opening(name, turn, wired) => "opening \(name) \(turn) \(wired.len())"
        .Plain(x, z) => "plain \(x) \(z)"
    }
}

struct Spot {
    x: i64
    y: i64 = 0
    z: i64 = 0
}

fn main() = {
    var m = defaults()
    m.name = String::of("parser")
    val uncertain = Moved(definite: false, ..m)
    // `m.definite` was copied, and stays.
    io::println("\(uncertain.definite) \(uncertain.spans.len()) \(uncertain.name) \(m.definite)")

    val cleared = Moved(definite: false, spans: Vec(), ..defaults())
    io::println("clear \(cleared.name)")
    val kept = Moved(definite: true, spans: Vec(), name: String::of("kept"))
    val copy = Moved(name: String::of("c"), ..kept.clone())
    io::println("\(copy.name) \(kept.name)")

    val prop = Thing::Prop(name: String::of("lamp"), turn: 350, tags: Vec())
    io::println(prop.turned(20).label())
    val door = Thing::Opening(name: String::of("door"), turn: 0, wired: Vec::of([1]))
    io::println(door.clone().turned(90).label())
    io::println(door.label())
    io::println(Thing::Plain(x: 1, z: 2).moved(5).label())
    io::println(Thing::Prop(name: String::of("a"), turn: 1, tags: Vec()).renamed(String::of("b")).label())

    // What `base` gives comes before a default.
    val first = Spot(x: 1, y: 3, z: 4)
    val second = Spot(x: 9, ..first)
    io::println("spot \(second.y) \(second.z)")
}
