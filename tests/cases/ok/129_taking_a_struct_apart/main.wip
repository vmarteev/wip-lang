// A struct may be taken apart where it is bound. Its binders are a
// variant's: by field name, renamed with `name: newName`,
// and `..` for the rest. It always matches, so a `val` needs no `else` and
// a `match` on it is one arm.
//
// Expected output: 3 (a match), 2 and 1 (a `val`, and one that renames and
// ignores), one = 1 and two = 2 (a map walked), 14 (an array of structs
// walked), 7 (a binding that refers into a place it can
// write).

import std::io
import std::collections::{Map, MapEntry}

struct Point {
    x: i64
    y: i64
}

fn main() = {
    val p = Point(x: 1, y: 2)

    match p {
        Point(x, y) => io::printInt(x + y)
    }

    val Point(x, y) = p
    io::printInt(y)

    val Point(x: across, ..) = p
    io::printInt(across)

    // What this was written for.
    var counts = Map<String, i64>()
    counts.put(String::of("one"), 1)
    counts.put(String::of("two"), 2)
    for MapEntry(key, value) in counts {
        io::println("\(key.toStr()) = \(value)")
    }

    val points = [Point(x: 1, y: 2), Point(x: 3, y: 4)]
    var total = 0
    for Point(x, y) in points {
        total += x * y
    }
    io::printInt(total)

    // A binding refers into the place it was matched from, so it can be
    // written when that can.
    var here = Point(x: 5, y: 0)
    val Point(x: sideways, ..) = here
    io::printInt(sideways + 2)
}
