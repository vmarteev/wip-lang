// A module's C may live below its directory and be configured by a
// header the module names. Before this, a module wrote
// a C file of its own that did nothing but `#include "build.h"` and
// `#include "src/counter.c"`, once per file it vendored.
//
// Expected output: 41 and 42 — the counter starts at what `build.h` says
// and counts from there.

import std::io
import counter

fn main() = {
    io::printInt(counter::next())
    io::printInt(counter::next())
}
