// A module whose C lives below it, and is configured by a header of its
// own: `@source` names the file and `@prefix` is put before it, so there
// is no C file here whose only job is to include another.

@source("src/counter.c")
@prefix("build.h")
extern "C" {
    fn counter_next(): i64
}

pub fn next(): i64 = counter_next()
