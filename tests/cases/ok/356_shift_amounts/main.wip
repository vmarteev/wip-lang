// A shift's amount of any integer type, taken modulo the
// width of what is shifted as before: by a `u32`, a `u8`,
// a negative `i8` (63 of a `u64`), past the width (257 of a `u8` is 1), and
// in `<<=` and `>>=`. A literal shifted is of the type expected, or an
// `i64`, never the amount's: a mask of 32 bits of a `u64`, and `1 << n`.
//
// Expected output: "8 2 9223372036854775808 120 496", then
// "4294967295 4294967296".

import std::io

fn main() = {
    val buffer: u64 = 1
    val count: u32 = 3
    val small: u8 = 4
    val minus: i8 = -1
    val byte: u8 = 0xF0
    val wide: u64 = 257
    var gathered: u64 = 0xFF
    gathered >>= count
    gathered <<= small
    io::println("\(buffer << count) \((buffer << small) >> count) \(buffer << minus) \(byte >> wide) \(gathered)")
    val bits: u32 = 32
    val whole: u64 = 0xFFFFFFFFFFFF
    io::println("\(whole & ((1 << bits) - 1)) \(1 << bits)")
}
