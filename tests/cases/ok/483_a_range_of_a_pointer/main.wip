// A range of what a C pointer points at is a slice of C's memory, as many
// elements as the range says: read with `&`, written with `&var` however
// the pointer is held, walked by a `for`, and lent by a type that holds the
// pointer. Two ranges of one pointer may be lent to one call: what a
// pointer points at is C's memory, which is not followed. A null pointer's
// empty range is the empty slice.
//
// Expected output: what C's memory holds, what was written into it and
// what C then reads, a sum over part of it, what a struct lends of it, two
// of its elements exchanged, and the empty slice of a null pointer.

import std::io

extern "C" {
    fn numbers(): ptr<i32>
    fn summed(count: i32): i32
}

/// Memory C keeps, and how much of it the program may use.
struct Shared {
    at: ptr<i32>
    count: i64
}

extend Shared {
    lend fn items(): &[i32] = lend self.at[0..self.count]
}

/// The first elements of `a` and `b`, each where the other was.
fn exchanged(a: &var [i32], b: &var [i32]) = {
    val first = a[0]
    a[0] = b[0]
    b[0] = first
}

fn main() = {
    val p = numbers()
    val first = &p[0..3]
    io::println("read: \(first[0]) \(first[1]) \(first[2])")
    val given: [i32; 2] = [10, 20]
    p[0..2].copyFrom(&given)
    io::println("written: \(p[0]) \(p[1]), C reads \(summed(3))")
    var total = 0
    for n in p[1..=2] {
        total += n as i64
    }
    io::println("total: \(total)")
    val shared = Shared(at: p, count: 4)
    val items = shared.items()
    io::println("shared: \(items.len()) \(items[3])")
    exchanged(&var p[0..1], &var p[3..4])
    io::println("exchanged: \(p[0]) \(p[3])")
    val none: ptr<i32> = null
    val empty = &none[0..0]
    io::println("empty: \(empty.len())")
}
