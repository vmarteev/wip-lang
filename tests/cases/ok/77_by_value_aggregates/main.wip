// A parameter taken by value belongs to the callee, which may move out of
// it. An aggregate is passed by the address of its place, so a place the
// caller keeps is copied first.
//
// Expected output: 3 (the callee's view), then 3 and 4 (the caller's value,
// unchanged), 7 (a value the caller moved), and 12 (a copy taken apart field
// by field), with every allocation freed.

import std::io

struct Pair {
    a: i64
    b: i64
}

struct Chest {
    gold: own<i64>
}

fn firstOf(p: Pair): i64 = {
    val taken = move p
    taken.a
}

fn sumOf(p: Pair): i64 = {
    val a = move p.a
    val b = move p.b
    a + b
}

fn open(chest: Chest): i64 = {
    val gold = move chest.gold
    gold + 0
}

fn main() = {
    val pair = Pair(a: 3, b: 4)
    io::printInt(firstOf(pair))
    io::printInt(pair.a)
    io::printInt(pair.b)
    val chest = Chest(gold: own 7)
    io::printInt(open(move chest))
    io::printInt(sumOf(pair) + firstOf(pair) + pair.b - 2)
}
