// A closure written inside an owned closure may read what the owned closure
// captured: it is lent from the owned closure's own environment, for as long
// as that closure's call. It was reported as a name that could not be found.
//
// Expected output: 2 and 3, a line each, the numbers above the limit.

import std::io

fn each(xs: &[i64], visit: &(x: i64) => void) = {
    for x in xs {
        visit(x)
    }
}

fn main() = {
    val xs = Vec::of(own [1, 2, 3])
    val limit = 1
    val work = own () => {
        each(&xs, (x) => { if x > limit then io::printInt(x) })
        return xs.countWhere((x) => x > limit)
    }
    assert(work() == 2)
}
