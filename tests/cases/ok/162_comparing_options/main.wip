// An option and a result compare, order and hash when what they hold does:
// two options are equal when both hold nothing or both
// hold equal values, and nothing comes before every value.

import std::io
import std::collections::{Set}
@derive(Eq, Hash)
struct BallId { v: u64 }
fn main() = {
    val a: Option<BallId> = .Some(BallId(v: 1))
    val b: Option<BallId> = .None
    val xs = [a, b]
    io::println("\(xs.indexOf(&b)) \(a == .None) \(a == .Some(BallId(v: 1))) \(a != b)")
    io::println("\(Option::Some(3) < .None) \(Option::Some(3) > Option::Some(2))")
    val r: Result<i64, str> = .Ok(2)
    val bad: Result<i64, str> = .Err("x")
    io::println("\(r == .Ok(2)) \(r == bad)")
    var seen: Set<Option<BallId>> = Set()
    seen.add(a)
    io::println("\(seen.contains(&a)) \(seen.contains(&b))")
}
