// A loop that takes its elements: `for x in move c` walks
// `c.intoIterator()`, and each element is the loop's to keep — moved on,
// or dropped where the iteration ends. What a loop that stops early leaves
// is dropped with the iterator. A temporary is the loop's already, so a
// `Vec` made where the loop is written is taken too; a place without
// `move` is lent, as before.

import std::collections::{Deque, Map, MapEntry, Set}
import std::io

struct Noisy {
    name: String
}

extend Noisy: Destroy {
    var fn destroy() = io::println("dropped \(self.name)")
}

fn noisy(names: &[str]): Vec<Noisy> = names.map((name) => Noisy(name: String::of(name)))

/// What any container that gives up its elements holds, each taken.
fn counted<C: IntoIterator<I>, I: Iterator<i64>>(values: C): i64 = {
    var sum = 0
    for value in move values {
        sum += value
    }
    return sum
}

fn main() = {
    var kept: Vec<Noisy> = Vec()
    val list = noisy(["a", "b"])
    for x in move list {
        kept.push(move x)
    }
    io::println("kept \(kept.len())")

    for x in noisy(["c", "d", "e"]) {
        io::println("took \(x.name)")
        if x.name == "d" {
            break
        }
    }
    io::println("after the break")

    var seen: Set<String> = Set()
    seen.add("x")
    seen.add("y")
    var keys: Vec<String> = Vec()
    for key in move seen {
        keys.push(move key)
    }
    io::println("\(keys)")

    var ages: Map<String, i64> = Map()
    ages.put("ann", 31)
    ages.put("bo", 27)
    for MapEntry(key, value) in move ages {
        io::println("\(key) \(value)")
    }

    var queue: Deque<String> = Deque()
    queue.pushBack("second")
    queue.pushFront("first")
    for item in move queue {
        io::println(item)
    }

    io::println("\(counted(Vec::of(own [1, 2, 3])))")
    val lent = Vec::of(own [4, 5])
    for n in lent {
        io::println("lent \(n)")
    }
    io::println("still \(lent.len())")
    io::println("end")
}
