// Named arguments, default values, and named variant fields.
//
// Expected output: 32 (named, any order), 2 then 1 (evaluated as written),
// 4096, 2048, 1, 7 (defaults, one of a variant and one of a struct), -3, 5
// (a C function called with a name), 15, 7, 8 (variants with named fields,
// in any order, and one positional field), 9 and 0 (one-field patterns), 10
// (a generic function with a name and a default), then 12 and 4 (a `&var`
// argument given by name), with every allocation freed.

import std::io

enum Mode {
    Read
    Write
}

struct Limits {
    low: i64
    high: i64
}

enum Shape {
    Rect(width: i64, height: i64)
    Circle(radius: i64)
}

enum Maybe<T> {
    Some(value: T)
    None
}

struct Token {
    id: i64
}

fn area(width: i64, height: i64): i64 = width * height

fn say(x: i64): i64 = {
    io::printInt(x)
    x
}

fn open(mode: Mode = .Read, buffer: i64 = 4096, limits: Limits = Limits(low: -3, high: 7)): i64 = match mode {
    .Read => buffer
    .Write => limits.high
}

fn low(limits: Limits = Limits(low: -3, high: 7)): i64 = limits.low

fn measure(shape: &Shape): i64 = match shape {
    .Rect(width, height) => width * height
    .Circle(r) => r
}

fn unwrapOr<T>(option: Maybe<T>, default: T): T = match move option {
    .Some(x) => move x
    .None => move default
}

fn scaled<T>(value: T, factor: i64 = 2): i64 = factor * 5

fn grow(total: &var i64, by: i64 = 1) = total = total + by

fn main(): i64 = {
    io::printInt(area(height: 4, width: 8))
    val ignored = area(height: say(2), width: say(1))
    io::printInt(open())
    io::printInt(open(buffer: 2048))
    io::printInt(open(.Write, limits: Limits(low: 0, high: 1)))
    io::printInt(open(mode: .Write))
    io::printInt(low())
    io::printInt(value: 5)
    io::printInt(measure(Shape::Rect(height: 3, width: 5)))
    val width = 7
    val height = 1
    io::printInt(measure(Shape::Rect(width: width, height: height)))
    io::printInt(measure(Shape::Circle(8)))
    io::printInt(unwrapOr(Maybe::Some(value: 9), 0))
    io::printInt(unwrapOr(default: 0, option: Maybe::None))
    io::printInt(scaled(value: own Token(id: 1)))
    var total = 10
    grow(by: 2, total: &var total)
    io::printInt(total)
    grow(&var total)
    io::printInt(total - 9)
    0
}
