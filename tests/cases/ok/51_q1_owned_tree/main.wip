// Structures whose links own what they point to. An enum
// with an `own` payload expresses a search tree and a linked list without an
// arena; parent and `prev` links still need one (ok/42, ok/44). What stays
// awkward:
// - `insert` takes the tree by value, so it takes it apart with `match move`
//   and builds the path again. ok/53 inserts in place through writable
//   bindings.
// - `incrementAll` takes each node apart and refills its `&var` parameter,
//   so every node is freed and allocated again, as the trace shows; ok/53
//   updates the list in place.
// - A loop can walk a list only by consuming it (`sumConsuming`), because no
//   variable can refer to the current node (err/55). Reading a list without
//   consuming it takes recursion (`sumList`), one stack frame per node.
//
// Expected output: 16 (the tree), 3 (the list 2, 1), then the trace of
// `incrementAll` freeing and allocating each of its three nodes, 5 (the list
// 3, 2), and 5 again from `sumConsuming`, which frees the list as it goes.
// The tree is freed at the end.

import std::io

extern "C" {
    fn wip_trace_allocs()
}

enum List {
    Cons(head: i64, tail: own<List>)
    Nil
}

enum Tree {
    Node(value: i64, left: own<Tree>, right: own<Tree>)
    Leaf
}

fn insert(tree: own<Tree>, value: i64): own<Tree> = match move tree {
    .Node(value: v, left, right) => if value < v {
        own .Node(value: v, left: insert(move left, value), right: move right)
    } else {
        own .Node(value: v, left: move left, right: insert(move right, value))
    }
    .Leaf => own .Node(value, left: own .Leaf, right: own .Leaf)
}

fn sumTree(tree: &Tree): i64 = match tree {
    .Node(value: v, left, right) => v + sumTree(&left) + sumTree(&right)
    .Leaf => 0
}

fn sumList(list: &List): i64 = match list {
    .Cons(head, tail) => head + sumList(&tail)
    .Nil => 0
}

fn incrementAll(list: &var own<List>) = match move list {
    .Cons(head, tail) => {
        var rest = move tail
        incrementAll(&var rest)
        list = own List::Cons(head: head + 1, tail: move rest)
    }
    .Nil => list = own List::Nil
}

fn sumConsuming(list: own<List>): i64 = {
    var total = 0
    var rest = move list
    var done = false
    while !done {
        match move rest {
            .Cons(head, tail) => {
                total = total + head
                rest = move tail
            }
            .Nil => {
                done = true
                rest = own List::Nil
            }
        }
    }
    total
}

fn main(): i64 = {
    var tree = own Tree::Leaf
    tree = insert(move tree, 5)
    tree = insert(move tree, 3)
    tree = insert(move tree, 8)
    io::printInt(sumTree(&tree))
    var list = own List::Nil
    list = own List::Cons(head: 1, tail: move list)
    list = own List::Cons(head: 2, tail: move list)
    io::printInt(sumList(&list))
    wip_trace_allocs()
    incrementAll(&var list)
    io::printInt(sumList(&list))
    io::printInt(sumConsuming(move list))
    0
}
