// A range of a container whose `x[i]` is a position and which lends its
// elements as one slice — a `Sequence` and an `Items` of one element — is a
// range of that slice: `v[a..b]` is `v.items()[a..b]`. It is read, passed,
// walked, compared, written where the container may be, and bounds-checked,
// as a slice's range is. A `Vec` is one, a `Set`, whose keys are read by
// position, and a container of the program's own that implements both.
//
// Expected output: the sums of four ranges, the elements a loop walks, the
// vector after two of its elements are written, a comparison, a range lent
// to a variable, two keys of a set, and a range of a ring.

import std::collections::{Set}
import std::io

struct Ring {
    cells: Vec<i64>
}

extend Ring: Items<i64> {
    lend fn items(): &[i64] = lend self.cells.items()
}

extend Ring: Sequence<i64> {
    fn len(): i64 = self.cells.len()

    lend fn at(i: i64): &i64 = lend self.cells.at(i)
}

fn total(values: &[i64]): i64 = values.sum()

fn main() = {
    var v: Vec<i64> = Vec::of(own [1, 2, 3, 4])
    io::println("\(total(&v[1..3])) \(total(&v[2..])) \(total(&v[..2])) \(total(&v[1..=2]))")

    for x in v[1..] {
        io::print("\(x) ")
    }
    io::println("")

    v[0..2].fill(9)
    io::println("\(v) \(v[1..3] == [9, 3]) \(v[1..3].len())")

    val part = &v[2..4]
    io::println("\(part)")

    var seen: Set<String> = Set()
    seen.add(String::of("a"))
    seen.add(String::of("b"))
    seen.add(String::of("c"))
    io::println("\(seen[1..3])")

    val ring = Ring(Vec::of(own [5, 6, 7]))
    io::println("\(total(&ring[1..]))")
}
