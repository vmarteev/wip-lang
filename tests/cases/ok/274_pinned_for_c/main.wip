// A value C holds the address of for longer than a call:
// a `Pinned` is given to a C library that keeps it and calls back with it
// later, from two threads at once; the callback reads it through a `&` and
// adds to the `Atomic` in it; the program reads the same through
// `value()`; and C is told to let go before the `Pinned` ends.
//
// Expected output: 6000, what 2000 calls added, and 3.

import std::io
import std::c
import std::future
import std::sync::{Atomic}

extern "C" {
	fn keep(data: ptr<void>, callback: (data: ptr<void>) => void)
	fn fire(times: c_int)
	fn let_go()
}

struct Watched {
	count: Atomic<i64>
	step: i64
}

// What C calls, with the address it kept.
fn told(data: ptr<void>) = c::pinnedAt<Watched, void>(data, (watched) => {
	watched.count.add(watched.step)
})

fn main() = {
	val shared = c::Pinned::of(Watched(count: Atomic::of(0 as i64), step: 3))
	keep(shared.address(), told)
	future::together(() => fire(1000), () => fire(1000))
	io::println("\(shared.value().count.load()) \(shared.value().step)")
	let_go()
}
