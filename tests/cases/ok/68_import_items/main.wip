// Imports that name items: `self` binds the module as
// well, `as` renames an item, and a module imports from a module below it.
//
// Expected output: 7, 3, 25, 12, 1, 314, 1.

import std::io::{printInt}
import std::math::{self}
import geometry::{Line, Kind, length as lengthOf, unitLength}
import geometry::shapes::{Square, perimeter}

// An imported type in a signature, and a renamed function.
fn longer(a: &Line, b: &Line): i64 = lengthOf(&a).max(lengthOf(&b))

fn main(): i64 = {
    val short = Line(from: 1, to: 4)
    val long = Line(from: 0, to: 7)
    printInt(longer(&short, &long))
    printInt(lengthOf(&short).min(5))
    val square = Square(side: 5)
    printInt(square.side * square.side)
    printInt(perimeter(Square(side: 3)))
    // An imported enum, matched by its name and with a leading dot.
    val kind: Kind = Kind::Vertical
    printInt(match kind {
        Kind::Horizontal => 0
        .Vertical => 1
    })
    // `self` bound `math`, so the rest of the module is a prefix away.
    printInt((math::TAU / 2.0 * 100.0) as i64)
    printInt(unitLength())
    0
}
