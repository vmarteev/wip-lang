// Module `geometry`. It imports from `geometry::shapes`, the module below
// it, by the full path: paths are absolute.

import geometry::shapes::{Square}

pub struct Line {
    pub var from: i64
    pub var to: i64
}

pub enum Kind {
    Horizontal
    Vertical
}

pub fn length(line: &Line): i64 = line.to - line.from

pub fn unitLength(): i64 = unit().side

// A private function with an imported type in its signature.
fn unit(): Square = Square(side: 1)
