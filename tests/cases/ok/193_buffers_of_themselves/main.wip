// A type may hold a buffer of itself, `own<[Tree]>`, as a tree's node holds
// its children. Dropping one drops each element where it
// lies, by a function of the element's type, so the drop of a node is a
// call and not a drop written inside itself without end. A view enum may
// too, and a buffer of `String`s drops each one.

enum Tree {
    Leaf(value: i64),
    Node(children: own<[Tree]>),
}

fn count(t: &Tree): i64 = match t {
    .Leaf(..) => 1
    .Node(children) => {
        var n = 0
        for child in children {
            n += count(&child)
        }
        n
    }
}

fn main() = {
    val named = Tree::Node(own [Tree::Leaf(5)])
    assert(count(&named) == 1)
    val t = Tree::Node(own [Tree::Leaf(1), Tree::Node(own [Tree::Leaf(2), Tree::Leaf(3)])])
    assert(count(&t) == 3)
    val text = own [String::of("a"), String::of("b")]
    assert(text.len() == 2)
    val owned = String::of("x")
    val names: Names = .Many(own [.One(owned.toStr()), .Many(own [.One("y")])])
    assert(depth(&names) == 3)
}

view enum Names {
    One(name: str),
    Many(names: own<[Names]>),
}

fn depth(n: &Names): i64 = match n {
    .One(..) => 1
    .Many(names) => {
        var most = 0
        for inner in names {
            most = most.max(depth(&inner))
        }
        most + 1
    }
}
