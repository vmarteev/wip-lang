// A C struct's pointer field takes `&x` in its literal, as a C function's
// pointer parameter does: one value, an array, a vector's slice, anything
// for a `void *`, and `&var x` for one C writes through. The struct then
// borrows what it points at, through structs that point at structs, as a
// value holding a C string made from a `String` borrows the `String`.
//
// Expected output: what C read through each pointer, and what it wrote.

import std::io

@header("pointing.h")
extern "C" {
    struct Span {
        values: ptr<i32>
        count: i64
    }

    struct Job {
        span: ptr<Span>
        label: ptr<u8>
        total: ptr<i64>
        tag: ptr<void>
    }

    fn run(job: &Job): i64
}

fn main() = {
    val values: [i32; 3] = [1, 2, 3]
    val span = Span(values: &values, count: 3)
    val label: Vec<u8> = Vec::of(own [119, 105, 112, 0])
    var total: i64 = 0
    val tag: i64 = 40
    val job = Job(span: &span, label: &label.items(), total: &var total, tag: &tag)
    io::println("read: \(run(&job)), wrote: \(total)")
}
