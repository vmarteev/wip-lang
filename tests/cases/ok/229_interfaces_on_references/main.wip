// A `&T` answers what `T` answers about itself — `Eq`, `Ord`, `Hash`,
// `Text` — by `T`'s implementation, given what it points to, and is
// `Clone` as every view is: a clone is the reference.

import std::io
import std::collections::{Set}

@derive(Eq, Hash)
struct Node {
    size: i64
}

extend Node: Text {
    fn appendTo(out: &var String) = out.push("node \(self.size)")
}

extend Node: Ord {
    fn compare(other: &Node): Ordering = self.size.compare(&other.size)
}

/// Generic code given `T = &Node` calls the node's `equals`.
fn same<T: Eq>(a: &T, b: &T): bool = a == b

fn main() = {
    val a = Node(size: 1)
    val b = Node(size: 1)
    val c = Node(size: 2)

    // Two references to equal values are equal, wherever they point.
    val ra: &Node = &a
    val rb: &Node = &b
    val found: Option<&Node> = .Some(&a)
    val other: Option<&Node> = .Some(&b)
    io::println("\(same<&Node>(&ra, &rb)) \(found == other) \(found == .None)")

    // Written, sorted, searched and hashed as the nodes are.
    var refs: Vec<&Node> = Vec()
    refs.push(&c)
    refs.push(&a)
    io::println("\(found) \(refs) \(refs.contains(&b))")
    refs.sort()
    io::println("\(refs)")
    var seen = Set<&Node>()
    seen.add(&a)
    seen.add(&b)
    seen.add(&c)
    io::println("\(seen.len()) distinct")

    // A clone of a reference is the reference.
    val copies = refs.clone()
    io::println("\(copies[1].size)")
}
