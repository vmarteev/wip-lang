// A pattern's bindings refer into the value where it is a place, and what
// a reference points to is one wherever the reference came from: a call
// that lends it, as a projection does, too. `val .Some(x) = p.at(0).field
// else { … }` took the value out instead, leaving zeroes behind a shared
// reference.
//
// Expected output: "[jpg] true", then "[jpg] true".

import std::io

struct Searched {
    text: String
    running: bool = true
}

struct Panel {
    searched: Option<Searched> = .None
}

struct Panels {
    left: Panel
    right: Panel
}

extend Panels {
    fn at(index: i64): &Panel = if index == 0 { lend self.left } else { lend self.right }

    fn text(index: i64): String = {
        val .Some(searched) = self.at(index).searched else {
            return String()
        }
        return String::of(searched.text.toStr())
    }
}

fn shown(panels: &Panels): String = match panels.left.searched {
    .Some(searched) => "[\(searched.text)] \(searched.running)"
    .None => String::of("none")
}

fn main() = {
    val panels = Panels(left: Panel(searched: .Some(Searched(text: "jpg"))), right: Panel())
    io::println(shown(&panels))
    assert(panels.text(0) == "jpg" && panels.text(1) == "")
    io::println(shown(&panels))
}
