// `?` takes a value apart with bindings named as the variants' fields are
// — `value` and `error` — and they used to be declared where the `?`
// stood, so a program's own `value` after it was the `?`'s: a `void`,
// where the `?` was on a `Result<void, E>`. They are the `?`'s own now.
//
// Expected output: 42, then 7, then "kept".

import std::io

fn nothing(): Result<void, str> = .Ok()

fn found(): Option<i64> = .Some(7)

fn answer(): Result<i64, str> = {
    val value = 42
    nothing()?
    return .Ok(value)
}

fn inOption(): Option<i64> = {
    val value = found()?
    found()?
    return .Some(value)
}

fn named(): Result<String, str> = {
    val error = String::of("kept")
    nothing()?
    return .Ok(move error)
}

fn main() = {
    io::println("\(answer().unwrapOr(0))")
    io::println("\(inOption().unwrapOr(0))")
    io::println(named().unwrapOr(String()))
}
