// A box clones where what it holds does, into a box of its own, so
// `@derive(Clone)` clones a recursive type: a list whose tail is boxed and
// a tree whose children are, each copy changed and its original not, a box
// cloned through a constraint, and a box of plain data, whose clone is a
// copy of what it holds.
//
// Expected output:
// a a!
// 2 3
// x
// 7

import std::io

@derive(Clone)
enum List {
	Cons(head: String, tail: own<List>)
	Nil
}

struct Wide {
	value: i128
}

@derive(Clone)
enum Number {
	Small(n: i64)
	Big(wide: own<Wide>)
}

@derive(Clone)
struct Tree {
	value: i64
	children: Vec<own<Tree>>
}

fn main() = {
	val list = List::Cons(
		head: String::of("a"),
		tail: own List::Cons(head: String::of("b"), tail: own List::Nil),
	)
	var copy = list.clone()
	match copy {
		.Cons(head, ..) => head.push("!")
		.Nil => {}
	}
	val .Cons(head: first, ..) = list else return
	val .Cons(head: changed, ..) = copy else return
	io::println("\(first) \(changed)")
	val tree = Tree(value: 1, children: Vec::of(own [own Tree(value: 2, children: Vec())]))
	var grown = tree.clone()
	grown.children[0].value = 3
	io::println("\(tree.children[0].value) \(grown.children[0].value)")
	val boxed = own String::of("x")
	val again = cloneOf(&boxed)
	io::println(again)
	val big = Number::Big(wide: own Wide(value: 7))
	if big.clone() is .Big(wide) then io::println("\(wide.value)")
}
