// A slice's address, for C to read: `c::pointerTo` gives
// the first element's address, which a binding that takes a pointer and a
// count is given with the slice's length; the pointer is indexed in Wip as
// well, where a copy of it stays the `ptr<T>` it is.
//
// Expected output: 24 (the bytes' sum as C adds it), then 8 and 9.

import std::c
import std::io

extern "C" {
    fn sum_bytes(bytes: ptr<u8>, count: c_int): c_int
}

fn second(values: &[i64]): i64 = {
    val first = c::pointerTo(&values)
    return first[1]
}

fn main() = {
    val bytes: [u8; 3] = [7, 8, 9]
    io::printInt(sum_bytes(c::pointerTo(&bytes), bytes.len() as c_int) as i64)
    val values: [i64; 3] = [7, 8, 9]
    io::printInt(second(&values))
    io::printInt(c::pointerTo(&values)[2])
}
