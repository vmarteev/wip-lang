// `defer` runs an expression when the enclosing block exits, last in, first out.
//
// Expected output:
//   main: start
//   inner: body
//   inner: first
//   inner: second
//   main: end
//   main: last

import std::io

fn main(): i64 = {
    defer io::println("main: last")
    io::println("main: start")
    if true {
        defer io::println("inner: second")
        defer io::println("inner: first")
        io::println("inner: body")
    }
    io::println("main: end")
    0
}
