// Two C strings are equal when their text is (once, `==` on a `cstring`
// called itself until the stack ran out).

import std::io

fn label(menu: bool): cstring = if menu { "Menu" } else { "Back" }

fn main() = {
    var built = String::of("Me")
    built.push("nu")
    io::println("\(label(true) == "Menu") \(label(true) == "Back") \(label(false) != "Menu")")
    io::println("\(label(true) == built.toCstring())")
}
