// A binding of plain data that is only read is a copy, so the place it came
// from may change; but one borrowed where the borrow may be kept — in a view
// an arm answers, or what a method answers that borrows its receiver — is
// the place, which the borrow points into after the arm. A binding lent to
// a call that answers nothing that borrows is still a copy.
//
// Expected output: "0.5 at 3", a material reached through a view answered
// from inside a `match` on `self`; "0.25 at 5", through a method's answer;
// and "7 then none", a copy lent to a call while its place changed.

import std::io

enum Material {
    Matte(albedo: f64)
    Mirror(fuzz: f64)
}

struct Sphere {
    center: f64
    material: Material
}

view struct Hit {
    t: f64
    material: &Material
}

enum Shape {
    Ball(sphere: Sphere)
    Polished(sphere: Sphere)
}

extend Sphere {
    fn hit(): Hit = Hit(t: self.center, material: &self.material)
}

extend Shape {
    fn hit(): Hit = match self {
        .Ball(sphere) => Hit(t: sphere.center, material: &sphere.material)
        .Polished(sphere) => sphere.hit()
    }
}

fn describe(hit: Hit): String = match hit.material {
    .Matte(albedo) => "\(albedo) at \(hit.t)"
    .Mirror(fuzz) => "\(fuzz) at \(hit.t)"
}

fn show(value: &i64) = io::print("\(value)")

fn main() = {
    val ball = Shape::Ball(Sphere(center: 3.0, material: .Matte(albedo: 0.5)))
    io::println(describe(ball.hit()))
    val polished = Shape::Polished(Sphere(center: 5.0, material: .Mirror(fuzz: 0.25)))
    io::println(describe(polished.hit()))
    var slot: Option<i64> = .Some(7)
    if slot is .Some(value) {
        show(&value)
        slot = .None
    }
    io::println(if slot.isNone() then " then none" else " then some")
}
