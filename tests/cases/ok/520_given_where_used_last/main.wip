// A place that owns memory, used as a value, is moved there without `move`:
// an argument, a named argument, a field, a payload, an element, `own`,
// `return`, a block's and an arm's value, a `val`, an assignment, a `var`
// pattern; a value of a type parameter, an atomic, a field, and `self` in a
// `move fn`. A value moved on one path and not the other ends once, where
// it was given or where its block ends, and a loop that gives a variable
// and assigns it again gives a new value each time. The run test checks
// that nothing leaks.
//
// Expected output:
// 3 b
// 2 2
// kept 1 0
// given 8
// dropped 8
// 3 rounds
// done
// dropped 7

import std::io
import std::sync::{Atomic}

struct Loud {
    id: i64
}

extend Loud: Destroy {
    var fn destroy() = io::println("dropped \(self.id)")
}

struct Pair {
    left: String
    right: String
}

extend Pair {
    move fn right(): String = self.right
}

struct Counted {
    count: Atomic<i64>
}

enum Held {
    Text(text: String)
    Nothing
}

fn length(text: String): i64 = text.len()

fn joined(left: String, right: String): String = "\(left)\(right)"

fn keep<T>(value: T): T = value

fn give(loud: Loud) = io::println("given \(loud.id)")

fn chosen(first: bool, a: String, b: String): String = {
    val picked = if first {
        a
    } else {
        b
    }
    return picked
}

fn main() = {
    val text = String::of("abc")
    val named = String::of("b")
    io::println("\(length(text)) \(joined(left: String(), right: named))")
    val left = String::of("l")
    val right = String::of("r")
    val pair = Pair(left: left, right: right)
    val list = [pair.left, String::of("x")]
    val payload = String::of("p")
    val held = Held::Text(payload)
    val boxed = own (held)
    val other = Pair(left: String(), right: String::of("rr"))
    io::println("\(list.len()) \(chosen(false, String::of("a"), other.right()).len())")
    var slot = String()
    val next = String::of("n")
    slot = next
    var (count, label) = (1, slot)
    val kept = keep(label)
    val number = Atomic::of(0)
    val counted = Counted(count: number)
    io::println("kept \(count) \(counted.count.load())")
    // Given on one path only: it ends where it is given, or at the block's
    // end.
    val seven = Loud(7)
    val eight = Loud(8)
    if count > 5 then give(seven)
    if count > 0 then give(eight)
    var line = String::of("r")
    var rounds = 0
    for i in 0..3 {
        rounds += length(line)
        line = String::of("s")
    }
    io::println("\(rounds) rounds")
    if boxed is Held::Text(t) then io::println(if kept == "n" && t == "p" then "done" else "wrong")
}
