// Alternatives that bind the same names, each of one type: whichever
// matched gives the arm its fields. A field renamed in each, a `match` on a
// reference, one written through on a place, a `match move` that takes an
// owned field from either and drops the rest, a guard that reads the
// binding, a nested alternative, an `is` test and a `val … else`, and
// seven alternatives that do not fit on a line, as many to a line as fit,
// broken before a `|`. The case runs with the leak check on.
//
// Expected output: `bound from whichever matched`.

import std::io

enum Shape {
	Circle(radius: i64)
	Square(side: i64)
	Point
}

enum Item {
	Text(size: i64, text: String)
	Label(size: i64, text: String)
	Gap(size: i64)
	Over
}

enum View {
	Text(size: i64)
	Label(size: i64)
	Column(size: i64)
	Row(size: i64)
	Block(size: i64)
	List(size: i64)
	Space(size: i64)
	Over
}

enum Ty {
	Named(name: String)
	Tag(name: String)
	Int
}

fn measure(shape: &Shape): i64 = match shape {
	.Circle(radius: n) | .Square(side: n) => n * 2
	.Point => 0
}

fn sizeOf(item: &Item): i64 = match item {
	.Text(size, ..) | .Label(size, ..) | .Gap(size) => size
	.Over => -1
}

fn viewSize(view: &View): i64 = match view {
	.Text(size) | .Label(size) | .Column(size) | .Row(size) | .Block(size) | .List(size)
	| .Space(size) => size
	.Over => 1
}

fn textOf(item: Item): String = match move item {
	.Text(text, ..) | .Label(text, ..) => move text
	_ => String()
}

fn grow(item: &var Item) = {
	match item {
		.Text(size, ..) | .Label(size, ..) | .Gap(size) => size += 1
		.Over => {}
	}
}

fn big(item: &Item): bool = match item {
	.Text(size, ..) | .Gap(size) if size > 5 => true
	_ => false
}

fn nested(ty: Option<Ty>): String = match move ty {
	.Some(.Named(name) | .Tag(name)) => move name
	_ => "none"
}

fn named(ty: &Ty): i64 = {
	if ty is .Named(name) | .Tag(name) then return name.len()
	return 0
}

fn tagged(ty: &Ty): i64 = {
	val .Named(name) | .Tag(name) = ty else {
		return -1
	}
	return name.len()
}

fn main() = {
	assert(measure(Shape::Circle(radius: 3)) == 6 && measure(Shape::Square(side: 4)) == 8)
	val text = Item::Text(size: 2, text: "abc")
	val label = Item::Label(size: 5, text: "label")
	assert(sizeOf(&text) == 2 && sizeOf(&label) == 5 && sizeOf(Item::Gap(size: 9)) == 9)
	assert(textOf(Item::Label(size: 1, text: "taken")) == "taken")
	assert(textOf(Item::Text(size: 1, text: "first")) == "first")
	assert(textOf(Item::Over).isEmpty())
	var gap = Item::Gap(size: 1)
	grow(&var gap)
	var lab = Item::Label(size: 7, text: "x")
	grow(&var lab)
	assert(sizeOf(&gap) == 2 && sizeOf(&lab) == 8)
	assert(big(Item::Gap(size: 9)) && !big(Item::Gap(size: 2)) && !big(&label))
	assert(nested(.Some(Ty::Tag(name: "tag"))) == "tag" && nested(.Some(Ty::Int)) == "none")
	assert(named(Ty::Named(name: "four")) == 4 && named(Ty::Int) == 0)
	assert(tagged(Ty::Tag(name: "ab")) == 2 && tagged(Ty::Int) == -1)
	assert(viewSize(View::Block(size: 4)) == 4 && viewSize(View::Over) == 1)
	io::println("bound from whichever matched")
}
