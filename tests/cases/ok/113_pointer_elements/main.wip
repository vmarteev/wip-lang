// What a C pointer does besides being passed along: `p[i]` reads and writes the
// element it points at, counted from it, and `p.field` reaches a field of what
// it points at — C's `p->field`.
// There is no other pointer arithmetic.
//
// Nothing is checked. A C pointer says how far apart its elements are, by
// its type, and nothing at all about how many there are, so `p[i]` is the
// one place in Wip where reading past the end is not a panic but whatever
// the memory holds. That is what a `ptr<T>` is for, and why the types Wip
// has for its own memory — slices, arrays and `Vec` — are checked instead.
//
// Expected output: 1,2 then 2,3 from an array C allocated; 41 through a
// pointer a struct holds and a function raised; and the bytes of a block
// read back as `u8`.

import std::io

extern struct Point {
    x: c_int,
    y: c_int
}

struct Holder {
    numbers: ptr<c_int>
}

extern "C" {
    fn malloc(bytes: size_t): ptr<void>
    fn free(p: ptr<void>)
}

fn raise(n: &var c_int) = { n = n + 1 as c_int }

fn main() = {
    // Two `Point`s, written through the pointer and read back.
    val points = malloc(32 as size_t) as ptr<Point>
    points[0].x = 1 as c_int
    points[0].y = 2 as c_int
    points[1].x = points[0].y
    points[1].y = points[0].x + points[0].y
    io::println("first \(points[0].x),\(points[0].y)")
    io::println("second \(points[1].x),\(points[1].y)")

    // A pointer a struct holds, and an element of it lent to a function
    // that writes it: C's memory is writable however the pointer is held.
    val holder = Holder(numbers: malloc(8 as size_t) as ptr<c_int>)
    holder.numbers[0] = 40 as c_int
    raise(&var holder.numbers[0])
    io::println("held \(holder.numbers[0])")

    // The same block seen as bytes, which is what a cast is for.
    val bytes = points as ptr<u8>
    io::println("first byte \(bytes[0]), fifth \(bytes[4])")

    free(points as ptr<void>)
    free(holder.numbers as ptr<void>)
}
