// `assert`: the condition holds, or the program prints what
// was asked of it and ends. The message is the condition's own text, since
// the lexer, which holds the interner, makes it while it reads the file; a
// note written at the call stands before it.
//
// Expected output: 4 and 9 (asserts that hold cost nothing but the test),
// then the failure of the last one on standard error, and status 101.

import std::io

struct Board {
    balls: i64
}

extend Board {
    var fn place(count: i64) = {
        assert(count > 0, "a placement places something")
        self.balls += count
    }
}

fn main() = {
    var board = Board(balls: 0)
    board.place(4)
    assert(board.balls == 4)
    io::printInt(board.balls)

    // A condition written over several lines reads as one in the message.
    board.place(5)
    assert(
        board.balls
            == 9
    )
    io::printInt(board.balls)

    // A note says what the condition is for; the condition says the rest.
    assert(board.balls == 10, "the board fills up")
    io::printInt(0)
}
