// Projections: a function whose result is a reference lends a
// place to its caller instead of returning a value. `lend` names the place,
// which must belong to one of the projection's reference parameters, so the
// lent address is the caller's own memory and needs no lifetime.
//
// Wip has no overloading, so reading and writing are two functions, as
// Swift's `_read` and `_modify` accessors are two coroutines. A call is a
// place: it can be read, written and passed on as `&var`.
//
// A branch may choose the place, as long as every path lends and they all
// lend a place in the same parameter.
//
// Expected output: 9 (the heaviest), 5 (after lightening 9 to 8 and setting
// it to 3, the heaviest is the 5), then 10 (after writing through the
// projection that picks the heavier of two items).

import std::io

struct Item {
    weight: i64
}

struct Bag {
    items: [own<Item>; 3]
}

fn bestIndex(bag: &Bag): i64 = {
    var best = 0
    var i = 1
    while i < bag.items.len() {
        if bag.items[i].weight > bag.items[best].weight {
            best = i
        }
        i = i + 1
    }
    best
}

// The element is an `own<Item>`; lending `&Item` looks through it, as the
// `&own<T>` to `&T` coercion does for an argument.
fn heaviest(bag: &Bag): &Item = lend bag.items[bestIndex(&bag)]

fn heaviestVar(bag: &var Bag): &var Item = lend bag.items[bestIndex(&bag)]

// A projection of a field, with work before the `lend`.
fn first(bag: &var Bag): &var Item = {
    val i = 0
    lend bag.items[i]
}

// The place is chosen by a branch; both paths lend part of `bag`.
fn heavierOf(bag: &var Bag, i: i64, j: i64): &var Item =
    if bag.items[i].weight > bag.items[j].weight {
        lend bag.items[i]
    } else {
        lend bag.items[j]
    }

fn lighten(item: &var Item) = {
    item.weight = item.weight - 1
}

fn main(): i64 = {
    var bag = Bag(items: [own Item(weight: 5), own Item(weight: 9), own Item(weight: 2)])
    io::printInt(heaviest(&bag).weight)
    lighten(&var heaviestVar(&var bag))
    heaviestVar(&var bag).weight = 3
    first(&var bag).weight = 5
    io::printInt(heaviest(&bag).weight)
    heavierOf(&var bag, 1, 2).weight = 10
    io::printInt(heaviest(&bag).weight)
    0
}
