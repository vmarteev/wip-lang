// Each collection is made from an iterator by `collect`, named in full or
// from the type expected, and from a list written where it is expected: of
// values, and of what a loop yields. A set keeps the first of equals, a
// map the later value of a key. A type of a program's own that implements
// `Collect` is made the same way, and a generic function's parameter
// learns its element from the list.
//
// Expected output:
// set 3 b
// map 2 3
// deque 1 3
// queue 2
// text ac
// vec 4 5
// primes 4
// adults 1 30
// letters abc
// total 3 6
// generic 2
// empty 0

import std::collections::{Deque, Map, PriorityQueue, Set}
import std::io

struct Person {
    name: String
    age: i64
}

struct Total {
    count: i64
    sum: i64
}

extend Total: Collect<i64> {
    static fn collect<I: Iterator<i64>>(items: I): Total = {
        var total = Total(count: 0, sum: 0)
        for x in move items {
            total.count += 1
            total.sum += x
        }
        return total
    }
}

fn distinct<T: Hash + Eq>(values: Set<T>): i64 = values.len()

fn main() = {
    val words = ["b", "a", "b", "c"]
    val seen: Set<str> = .collect(words.copies())
    io::println("set \(seen.len()) \(seen[0])")
    val pairs = [("a", 1), ("b", 2), ("a", 3)]
    val lengths = Map::collect(pairs.copies())
    io::println("map \(lengths.len()) \(lengths.at("a"))")
    val deque = Deque::collect([1, 2, 3].copies())
    io::println("deque \(deque[0]) \(deque[2])")
    val jobs = [("later", 2), ("sooner", 1)]
    var queue: PriorityQueue<str, i64> = .collect(jobs.copies())
    queue.push("last", 3)
    io::println("queue \(queue.len() - 1)")
    val text: String = .collect("abc".chars().filter((c) => c != 'b'))
    io::println("text \(text)")
    val all: Vec<i64> = .collect([4, 5].copies())
    io::println("vec \(all[0]) \(all[1])")

    val primes: Set<i64> = [2, 3, 5, 7, 3]
    io::println("primes \(primes.len())")
    val people = [Person(name: "ann", age: 30), Person(name: "bo", age: 12)]
    val adults: Map<String, i64> = [
        for p in people { if p.age >= 18 then yield (p.name.clone(), p.age) },
    ]
    io::println("adults \(adults.len()) \(adults.at("ann"))")
    val letters: String = [for c in "a-b-c".chars() { if c != '-' then yield c }]
    io::println("letters \(letters)")
    val total: Total = [1, 2, 3]
    io::println("total \(total.count) \(total.sum)")
    io::println("generic \(distinct([1, 2, 2]))")
    val empty: Set<i64> = []
    io::println("empty \(empty.len())")
}
