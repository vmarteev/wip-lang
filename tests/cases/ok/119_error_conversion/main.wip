// `?` converts one error into another where the program said how.
// A function that reads a file and then parses what it
// read has two error types, and until now could use `?` for neither:
// every call was written `fs::readFile(path).mapErr(ConfigError::Io)?`.
//
// The conversion is an implementation of `From`, which is the first
// interface that takes types. Nothing is implicit: `?` only finds what a
// program wrote down, and a reader who asks what happened to the error
// finds an `extend` block with a name in it.
//
// A type may implement it once per type it converts from, which is the
// point: `ConfigError` is made from two of them. Which `from` a call means
// is decided by what is passed.
//
// Expected output: the port a good file holds; then what the two failures
// print, each converted on its way out.

import std::io
import std::fs

enum ConfigError {
    Io(error: io::IoError)
    Empty
    NotANumber(text: String)
}

extend ConfigError: From<io::IoError> {
    static fn from(value: io::IoError): ConfigError = .Io(value)
}

extend ConfigError: From<String> {
    static fn from(value: String): ConfigError = .NotANumber(move value)
}

extend ConfigError: Text {
    fn appendTo(out: &var String) = match self {
        .Io(error) => {
            out.push("cannot read it: ")
            error.appendTo(&var out)
        }
        .Empty => out.push("it is empty")
        .NotANumber(text) => {
            out.push("not a number: ")
            out.push(text.toStr())
        }
    }
}

// Every `?` here converts: the first from `io::IoError`, the second from
// the `String` the parse gives back.
fn port(path: str): Result<i64, ConfigError> = {
    val text = fs::readFile(path)?
    if text.len() == 0 {
        return .Err(.Empty)
    }
    val number = parse(text.toStr())?
    return .Ok(number)
}

fn parse(text: str): Result<i64, String> = {
    var total = 0
    var i = 0
    while i < text.len() {
        val byte = text[i]
        if byte < 48 as u8 || byte > 57 as u8 {
            var said = String()
            said.push(text)
            return .Err(move said)
        }
        total = total * 10 + (byte as i64 - 48)
        i = i + 1
    }
    return .Ok(total)
}

fn report(path: str) = match port(path) {
    .Ok(number) => io::println("port \(number)")
    .Err(error) => {
        var said = String()
        error.appendTo(&var said)
        io::println("failed: \(said.toStr())")
    }
}

fn main(): Result<void, ConfigError> = {
    // The files are beside this one, so the case writes nothing.
    report("../../tests/cases/ok/119_error_conversion/port.txt")
    report("../../tests/cases/ok/119_error_conversion/bad.txt")
    report("/definitely/not/here")

    // The conversion is an ordinary function, and may be called by name:
    // what is passed says which implementation is meant.
    val made = ConfigError::from(io::IoError::NotFound)
    var said = String()
    made.appendTo(&var said)
    io::println("made: \(said.toStr())")
    return .Ok()
}
