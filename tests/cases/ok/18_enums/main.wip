// Enums with payload and unit variants. Variants are always written
// `Enum::Variant`. An enum with no variants is allowed.

enum Shape {
    Circle(radius: f64)
    Rect(w: f64, h: f64)
    Point
}

enum Never {}

fn main(): i64 = {
    val a = Shape::Circle(1.5)
    val b = Shape::Rect(w: 2.0, h: 3.0)
    val c = Shape::Point
    0
}
