// The tree whose nodes know their parent (ok/42), in an arena:
// the nodes are named by `Handle<Node>`, which says what it
// names, grows with the tree, and is `.None` where there is no parent rather
// than -1.
//
// Expected output: 2 (depth of the leaf), 4 2 1 (the path to the root), 10.

import std::io
import std::collections::{Arena, Handle}

struct Node {
	value: i64
	parent: Option<Handle<Node>>
	children: Vec<Handle<Node>>
}

fn add(tree: &var Arena<Node>, parent: Option<Handle<Node>>, value: i64): Handle<Node> = {
	val node = tree.add(Node(value: value, parent: parent, children: Vec()))
	if parent is .Some(above) {
		tree[above].children.push(node)
	}
	return node
}

fn depth(tree: &Arena<Node>, node: Handle<Node>): i64 = {
	var count = 0
	var at = tree[node].parent
	while at is .Some(up) {
		count = count + 1
		at = tree[up].parent
	}
	return count
}

fn printPath(tree: &Arena<Node>, node: Handle<Node>) = {
	var at: Option<Handle<Node>> = .Some(node)
	while at is .Some(here) {
		io::printInt(tree[here].value)
		at = tree[here].parent
	}
}

fn sum(tree: &Arena<Node>, node: Handle<Node>): i64 = {
	var total = tree[node].value
	for child in tree[node].children {
		total = total + sum(&tree, child)
	}
	return total
}

fn main() = {
	var tree: Arena<Node> = Arena()
	val root = add(&var tree, .None, 1)
	val left = add(&var tree, .Some(root), 2)
	add(&var tree, .Some(root), 3)
	val leaf = add(&var tree, .Some(left), 4)
	io::printInt(depth(&tree, leaf))
	printPath(&tree, leaf)
	io::printInt(sum(&tree, root))
}
