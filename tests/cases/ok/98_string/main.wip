// `String`: text that owns its bytes. It is a `Vec<u8>` with the operations
// text wants, written in Wip in the prelude, and it is what a `str` cannot be —
// something a program builds at run time.
//
// `toStr()` looks at the bytes it holds, so everything written against `str`
// works on a `String` without being written twice; `toCstring()` writes a
// NUL past the end and hands C what it expects.
//
// A `String` is read as the text it holds wherever text is read:
// the methods of `str`, indexing and slicing, and
// comparing all work on it without a `toStr()` written out.
//
// Expected output: read 12 rows; the same text through C; 12, its length; 1,
// since it starts with "read"; rows, a slice of it; 1, since it equals the
// literal; 3.5 and -9223372036854775808 and false, which are the other
// things a `String` takes; and 0, an empty `String` that was cleared.

import std::io

fn main() = {
    var message = String()
    message.push("read ")
    message.pushInt(12)
    message.push(" rows")
    io::println(message)
    io::printCstring(message.toCstring())
    io::printInt(message.len())
    io::printInt(if message.startsWith("read") { 1 } else { 0 })
    io::println(message[8..12])
    io::printInt(if message == "read 12 rows" { 1 } else { 0 })

    var numbers = String::withCapacity(64)
    numbers.pushFloat(3.5)
    numbers.pushByte(32)
    numbers.pushInt(-9223372036854775808)
    numbers.pushByte(32)
    numbers.pushBool(false)
    io::println(numbers)

    numbers.clear()
    io::printInt(numbers.len())
}
