// A `val` among a type's members is a constant of the type, reached
// through it: written in a struct's body, an enum's, or an `extend` block;
// a table; worked out from another, or run where it says `@comptime`;
// used by a top-level constant that is an array's length; and exported
// with `pub`, to be used through the type from another module.
//
// Expected output:
// 100 10 200
// 201 50
// red
// 8
// 25

import coins::{Coin}
import std::io

struct Money {
	cents: i64

	/// None at all.
	pub val ZERO: Money = Money(cents: 0)

	pub fn plus(other: Money): Money = Money(cents: self.cents + other.cents)
}

enum Light {
	Red
	Green

	val FIRST: Light = Light::Red
}

extend Money {
	val DOLLAR: Money = Money(cents: 100)
	val TABLE: [i64; 3] = [1, 5, 10]
	val CENTS: i64 = 100
	val TWICE: i64 = Money::CENTS * 2

	@comptime
	val HALF: i64 = Money::DOLLAR.cents / 2
}

val WIDTH: i64 = Money::TWICE + 1
val SIZE: i64 = Money::CENTS / 20 + 3
val ROW: [u8; SIZE] = [0; SIZE]

fn main() = {
	val total = Money::ZERO.plus(Money::DOLLAR)
	io::println("\(total.cents) \(Money::TABLE[2]) \(Money::TWICE)")
	io::println("\(WIDTH) \(Money::HALF)")
	io::println(if Light::FIRST is .Red then "red" else "green")
	io::println("\(ROW.len())")
	io::println("\(Coin::QUARTER.cents)")
}
