// Sorting: `sort` puts the elements of a slice or a vector in the order the
// type has, `sortBy` in the order the caller gives, and `values.swap(i, j)` is
// what both are built on — a swap is not a move out, so it works for elements
// that own memory.
//
// The containers have an order of their own here too: a vector, a
// `String` and a tuple compare by their elements, the first they differ
// at deciding.
//
// Expected output: [1, 1, 3, 4, 5] (numbers), apple fig pear (strings that
// own their bytes), [(1, 9), (2, 3), (2, 7)] (pairs), [[1], [1, 2], [2]]
// (vectors of vectors), 5 4 1 (an order of the caller's), true (one vector
// before another), true (a String before another), and `a p` (two
// elements that own memory, swapped).

import std::io

fn numbers(): Vec<i64> = {
    var v = Vec<i64>()
    v.push(5)
    v.push(1)
    v.push(4)
    v.push(1)
    v.push(3)
    return move v
}

fn words(): Vec<String> = {
    var v = Vec<String>()
    v.push(String::of("pear"))
    v.push(String::of("apple"))
    v.push(String::of("fig"))
    return move v
}

fn holding(values: &[i64]): Vec<i64> = {
    var v = Vec<i64>()
    for x in values {
        v.push(x)
    }
    return move v
}

fn main() = {
    var v = numbers()
    v.sort()
    io::println("\(v)")

    var text = words()
    // The slice a vector lends sorts the vector's elements.
    text.items().sort()
    for word in text {
        io::println(word.toStr())
    }

    var pairs = Vec<(i64, i64)>()
    pairs.push((2, 7))
    pairs.push((1, 9))
    pairs.push((2, 3))
    pairs.sort()
    io::println("\(pairs)")

    // A vector of vectors: the shorter comes first where it is the start
    // of the longer.
    var rows = Vec<Vec<i64>>()
    rows.push(holding([2]))
    rows.push(holding([1, 2]))
    rows.push(holding([1]))
    rows.sort()
    io::println("\(rows)")

    // The order the caller hands it: the largest first.
    var falling = numbers()
    falling.sortBy((a: &i64, b: &i64) => a > b)
    io::printInt(falling.at(0))
    io::printInt(falling.at(1))
    io::printInt(falling.at(4))

    io::println("\(holding([1, 2]) < holding([1, 3]))")
    io::println("\(String::of("apple") < String::of("fig"))")

    // A swap leaves no hole, so it works where a move out is refused.
    var two = words()
    two.items().swap(0, 1)
    io::println("\(two.at(0).toStr()[0..1]) \(two.at(1).toStr()[0..1])")
}
