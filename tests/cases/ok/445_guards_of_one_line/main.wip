// A guard's `else` of one jump or expression, without braces, as an `if`'s
// `then` branch is: `return` with a value and without, `continue`,
// `break`, `panic`, a function that never returns, after `var`, and with
// `else` at the start of the line below. Braces stay for more than one
// statement.
//
// Expected output: 3, -1, 6, 4, 7, 9, then "nothing", then 10 and 11.

import std::io

fn firstOf(values: &[i64]): i64 = {
	val [head, ..] = values else return -1
	return head
}

fn sumSome(values: &[Option<i64>]): i64 = {
	var total = 0
	for value in values {
		val .Some(n) = value else continue
		total += n
	}
	return total
}

fn untilNone(values: &[Option<i64>]): i64 = {
	var total = 0
	for value in values {
		val .Some(n) = value else break
		total += n
	}
	return total
}

fn stop(why: str): never = panic(why)

fn report(value: Option<i64>) = {
	val .Some(n) = value else return
	io::println("\(n)")
}

fn main() = {
	val none: [i64; 0] = []
	io::println("\(firstOf([3, 4]))")
	io::println("\(firstOf(&none))")
	io::println("\(sumSome([.Some(1), .None, .Some(5)]))")
	io::println("\(untilNone([.Some(4), .None, .Some(5)]))")
	val .Some(seven) = Option::Some(7)
	else panic("seven is there")
	io::println("\(seven)")
	var .Some(nine) = Option::Some(8) else stop("eight is there")
	nine += 1
	io::println("\(nine)")
	val nothing: Option<i64> = .None
	val .Some(missing) = nothing else {
		io::println("nothing")
		report(.Some(10))
		report(.None)
		report(.Some(11))
		return
	}
	io::println("\(missing)")
}
