// A pattern tests what a box holds wherever it meets one, at any depth, as
// it tests what a reference refers to: a variant, a number, alternatives,
// in a `match`, an `is` and a `val … else`, and a `match` with no `_`
// covers what the box holds. What it binds there is bound as a field's
// binding is: an alias that writes into the box in place, and, under
// `match move`, the value taken, while what the arm leaves is dropped where
// it binds and the emptied box is freed. Before, any pattern below a box
// was refused as not matching the box.
//
// Expected output:
// sums: 3 1 700 40
// kinds: leaf-left not a node
// taken: ann
// a: ~6 ~5 got 5
// b: ~9 got -1
// either: ~3 3
// both: ~5 ~4 4
// bumped: 2 -2

import std::io

struct Loud {
    id: i64
}

extend Loud: Destroy {
    var fn destroy() = io::print(" ~\(self.id)")
}

enum E {
    Leaf(n: i64)
    Named(name: String)
    Held(loud: Loud)
    Node(left: own<E>, right: own<E>)
    Maybe(child: Option<own<E>>)
}

fn sum(e: &E): i64 = match e {
    .Node(left: .Leaf(n), right: .Leaf(m)) => n + m
    .Node(left: .Leaf(n), ..) => n
    .Node(left: .Node(left: .Leaf(n), ..), ..) => n * 100
    .Maybe(.Some(.Leaf(n))) => n * 10
    _ => 0
}

// Every case of what the box holds, and no `_`.
fn kind(e: &E): str = match e {
    .Node(left: .Leaf(..), ..) => "leaf-left"
    .Node(left: .Named(..) | .Held(..) | .Node(..) | .Maybe(..), ..) => "other-left"
    .Leaf(..) | .Named(..) | .Held(..) | .Maybe(..) => "not a node"
}

fn takeName(e: E): String = match move e {
    .Node(left: .Named(name), ..) => name
    _ => String()
}

fn takeLoud(e: E): i64 = match move e {
    .Node(left: .Held(loud), ..) => loud.id
    _ => -1
}

fn either(e: E): i64 = match move e {
    .Node(left: .Held(loud), ..) | .Node(right: .Held(loud), ..) => loud.id
    _ => -1
}

fn bump(e: &var E) = match e {
    .Node(left: .Leaf(n), ..) => n += 1
    _ => {}
}

fn guarded(e: &E): i64 = match e {
    .Node(left: .Leaf(n), ..) if n > 5 => n
    .Node(left: .Leaf(n), ..) => -n
    _ => 0
}

fn leaf(n: i64): own<E> = own .Leaf(n)

fn main() = {
    val e = E::Node(left: leaf(1), right: leaf(2))
    val deep = E::Node(left: own .Node(left: leaf(7), right: leaf(8)), right: leaf(0))
    val one = E::Node(left: leaf(1), right: own .Named("x"))
    io::println("sums: \(sum(&e)) \(sum(&one)) \(sum(&deep)) \(sum(E::Maybe(own .Leaf(4))))")
    assert(e is .Node(left: .Leaf(1), right: .Leaf(2)) && !(e is .Node(left: .Leaf(2), ..)))
    assert(if e is .Node(left: .Leaf(n), ..) then n == 1 else false)
    val boxed: own<E> = own .Node(left: leaf(9), right: leaf(0))
    assert(boxed is .Node(left: .Leaf(9), ..))
    io::println("kinds: \(kind(&e)) \(kind(E::Leaf(1)))")
    io::println("taken: \(takeName(E::Node(left: own .Named("ann"), right: leaf(0))))")

    io::print("a:")
    val id = takeLoud(E::Node(left: own .Held(Loud(5)), right: own .Held(Loud(6))))
    io::println(" got \(id)")
    io::print("b:")
    val none = takeLoud(E::Node(left: leaf(0), right: own .Held(Loud(9))))
    io::println(" got \(none)")
    io::print("either:")
    io::println(" \(either(E::Node(left: leaf(0), right: own .Held(Loud(3)))))")
    io::print("both:")
    io::println(" \(either(E::Node(left: own .Held(Loud(4)), right: own .Held(Loud(5)))))")

    var tree = E::Node(left: leaf(1), right: leaf(2))
    bump(&var tree)
    val .Node(left: .Leaf(n), ..) = tree else panic("a node")
    io::println("bumped: \(n) \(guarded(&tree))")
}
