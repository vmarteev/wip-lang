// An enum whose variants carry nothing is a number:
// `colour as i64` is which variant it holds, counted from zero in the
// order they are written; `Colour::count()` is how many there are; and
// `Colour::fromIndex(n)` is the variant with that number, or nothing.
//
// It is what choosing one at random needs, and what a table indexed by a
// variant needs, neither of which a `match` in each direction says well.
//
// Expected output: 0 1 2 (each variant as a number), 3 (how many), blue (a
// number back to a variant), true true (a number no variant has, and a
// negative one), 321 (a table indexed by a variant), 2 (a generic enum),
// and 99 (a program's own `count`, which the compiler leaves alone).

import std::io

enum Colour { Red, Green, Blue }

enum Maybe<T> { Yes, No }

enum Step {
    First
    Second

    pub static fn count(): i64 = 99
}

fn name(c: Colour): str = match c {
    .Red => "red"
    .Green => "green"
    .Blue => "blue"
}

fn main() = {
    io::println("\(Colour::Red as i64) \(Colour::Green as i64) \(Colour::Blue as i64)")
    io::printInt(Colour::count())

    val .Some(chosen) = Colour::fromIndex(2) else {
        io::println("no such colour")
        return
    }
    io::println(name(chosen))

    io::println("\(Colour::fromIndex(7).isNone()) \(Colour::fromIndex(-1).isNone())")

    // A table with one entry per variant, read by the variant's number.
    val weights = [10, 200, 3000]
    var total = 0
    var i = 0
    while i < Colour::count() {
        val colour = Colour::fromIndex(i).unwrap()
        total += weights[colour as i64] / 10
        i += 1
    }
    io::printInt(total)

    io::printInt(Maybe<i64>::count())
    io::printInt(Step::count())
}
