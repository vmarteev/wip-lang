// `pair` lends two values of an arena to write at once, so
// it will not lend one value twice: the two would be one place written
// through two names.
//
// Expected output: 3, then the panic on standard error, and status 101.

import std::io
import std::collections::{Arena}

fn main() = {
	var numbers: Arena<i64> = Arena()
	val first = numbers.add(1)
	val second = numbers.add(2)
	io::printInt(numbers.pair(first, second, (a, b) => a + b))
	numbers.pair(first, first, (a, b) => { a += b })
}
