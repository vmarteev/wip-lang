// `+%=`, `-%=` and `*%=`: compound assignments that wrap,
// as `+%` does, on a variable and on an element, the place worked out
// once.
//
// Expected output: "4 4294967295 24464 0 1".

import std::io

fn main() = {
    var byte: u8 = 250
    for _ in 0..10 {
        byte +%= 1
    }
    var word: u32 = 1
    word -%= 2
    var half: u16 = 300
    half *%= 300
    var counts: [u16; 2] = [65535, 0]
    var at = 0
    counts[at] +%= 1
    at += 1
    counts[at] +%= 1
    io::println("\(byte) \(word) \(half) \(counts[0]) \(counts[1])")
}
