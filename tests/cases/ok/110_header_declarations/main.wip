// A declaration whose C is in a header, not in a library. A `static inline`
// function has no symbol to link against, and a function-like macro is not even
// a function — but both are a call the C compiler can make, so a declaration's
// own `@header` puts the header at the top of the C the compiler writes, and
// each call goes through a wrapper there:
//
//     #include "shapes.h"
//
//     int32_t wip_shim_131(int32_t a0) { return doubled(a0); }
//     int32_t wip_shim_132(int32_t a0, int32_t a1) { return LARGER(a0, a1); }
//
// Nothing is declared above them, because the header has declared them
// already, and a second declaration of a macro is not C. A system header is
// written with its brackets, `@header("<math.h>")`. A block's `@header`
// says where its types are; it does not put a call behind a wrapper, so
// what is declared beside the two is called directly.
//
// Expected output: 42, then 9, then 4 from the `<math.h>` macro-or-function
// that C picks.

import std::io

// `sqrt` is in C's maths library, linked by name.
@link("m")
extern "C" {
    @header("shapes.h")
    fn doubled(value: c_int): c_int
    @header("shapes.h")
    fn LARGER(a: c_int, b: c_int): c_int
    @header("<math.h>")
    fn sqrt(of: f64): f64
}

fn main() = {
    io::println("\(doubled(21))")
    io::println("\(LARGER(9 as c_int, 4 as c_int))")
    io::println("\(sqrt(16.0))")
}
