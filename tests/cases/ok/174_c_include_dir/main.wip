// A C library carried as its source: its headers are in a
// directory of the module's own, named with `@include`, and the file the
// module compiles says what the library's build would have defined.

import std::io
import vendor::{tally_add, tally_scale}

fn main() = {
    io::println("\(tally_add(2, 3)) \(tally_scale())")
}
