// Walking one place at a time: a container that cannot lend
// its elements as one slice lends them by position, and `for` walks them,
// writing them in a `var`.
//
// Expected output: the balls stepped in the map's order, 11 21 31; a ring
// buffer that wraps, read from its oldest, 3 4 5 6; the same written, 30 40
// 50 60; `continue` and `break` in such a walk, 40 50; the elements taken
// apart where they are, 3 steps; and a key and its value by position,
// b = 21, c.

import std::io
import std::collections::{Map, Set}

struct Ball {
    x: i64,
    steps: i64
}

extend Ball {
    var fn step() = {
        self.x += 1
        self.steps += 1
    }
}

// Four slots, used round and round: its elements are not in one run once
// it has wrapped, so it lends them one at a time.
struct Ring {
    slots: [i64; 4],
    start: i64,
    count: i64
}

extend Ring {
    static fn new(): Ring = Ring(slots: [0, 0, 0, 0], start: 0, count: 0)

    var fn push(value: i64) = {
        if self.count < 4 {
            self.slots[(self.start + self.count) % 4] = value
            self.count += 1
        } else {
            self.slots[self.start] = value
            self.start = (self.start + 1) % 4
        }
    }

    var fn at(i: i64): &var i64 = lend self.slots[(self.start + i) % 4]
}

extend Ring: Sequence<i64> {
    fn len(): i64 = self.count

    fn at(i: i64): &i64 = lend self.slots[(self.start + i) % 4]
}

fn show(ring: &Ring) = {
    for value in ring {
        io::print("\(value) ")
    }
    io::println("")
}

fn main() = {
    var balls = Map<str, Ball>()
    balls.put("a", Ball(x: 10, steps: 0))
    balls.put("b", Ball(x: 20, steps: 0))
    balls.put("c", Ball(x: 30, steps: 0))
    for ball in balls.values() {
        ball.step()
    }
    for entry in balls {
        io::print("\(entry.value.x) ")
    }
    io::println("")

    var ring = Ring::new()
    for n in 1..7 {
        ring.push(n)
    }
    show(&ring)
    for value in ring {
        value *= 10
    }
    show(&ring)

    var seen = 0
    for value in ring {
        seen += 1
        if seen == 1 {
            continue
        }
        io::print("\(value) ")
        if seen == 3 {
            break
        }
    }
    io::println("")

    // A binding may take the element apart, as a `match` on it may.
    for Ball(steps, ..) in balls.values() {
        seen += steps
    }
    io::println("\(seen - 3) steps")

    io::println("\(balls.keyAt(1)) = \(balls.valueAt(1).x), \(balls.keyAt(2))")
    var letters = Set<str>()
    letters.add("x")
    letters.add("y")
    io::println("\(letters[1])")
}
