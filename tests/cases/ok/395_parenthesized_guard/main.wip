// A match arm's guard that ends in parentheses: the `=>` after them is the
// arm's, so `(…)` is the condition, not a lambda's parameters, even where
// it holds one name. A lambda inside the guard, an argument of a call, is
// still one.
//
// Expected output: small, then pair, then ten, then positive.

import std::io

fn main() = {
	val loud = true
	val n = 3
	val size = match n {
		m if (m < 5) => "small"
		_ => "large"
	}
	io::println(size)
	val kind = match n {
		m if loud && (m == 2 || m == 3) => "pair"
		_ => "other"
	}
	io::println(kind)
	val name = match 10 {
		m if (loud) => if m == 10 then "ten" else "?"
		_ => "quiet"
	}
	io::println(name)
	val values = [1, 2, 3]
	val sign = match values.len() {
		_ if values.any((value) => value > 0) => "positive"
		_ => "none"
	}
	io::println(sign)
}
