// Tuples: `(A, B)` is a type, `(a, b)` a value and
// `(x, y)` a pattern, so two values come back from a call without a struct
// declared for them. A tuple is the prelude's `TupleN`, which is why it is
// held, moved, dropped, compared, hashed and written like any other struct.
//
// Expected output: 3 and 1 (two values back from one call), 1 (an element
// by position), (1, true) (a tuple written), true (two compared), one = 1
// and two = 2 (a vector of pairs walked), 3 (a map keyed by a pair), 6 (a
// tuple inside a tuple), 2 (two positions at once), 10 (an element
// written through), 9 (a tuple of
// three), and hello (a tuple that owns its bytes).

import std::io
import std::collections::{Map}

fn divide(a: i64, b: i64): (i64, i64) = (a / b, a % b)

struct Segment {
    ends: ((i64, i64), (i64, i64))
}

fn main() = {
    val (quotient, remainder) = divide(7, 2)
    io::printInt(quotient)
    io::printInt(remainder)

    val pair = (1, true)
    io::printInt(pair.0)
    io::println("\(pair)")
    io::println("\(pair == (1, true))")

    var pairs = Vec<(String, i64)>()
    pairs.push((String::of("one"), 1))
    pairs.push((String::of("two"), 2))
    for (word, n) in pairs.items() {
        io::println("\(word.toStr()) = \(n)")
    }

    var counts = Map<(i64, i64), i64>()
    counts.put((1, 2), 3)
    io::printInt(counts.at((1, 2)))

    // A tuple holds tuples, and a pattern takes them apart at any depth.
    val segment = Segment(ends: ((1, 2), (0, 3)))
    val Segment(ends: ((x, y), (_, toY))) = segment
    io::printInt(x + y + toY)
    // `.0.1` is one token to the lexer, since `0.1` is a number anywhere
    // else; it reads here as the two positions it is.
    io::printInt(segment.ends.0.1)

    // An element is a field, so it is a place that can be written.
    var point = (4, 5)
    point.0 = 5
    io::printInt(point.0 + point.1)

    val three = (1, 3, 5)
    io::printInt(three.0 + three.1 + three.2)

    // A tuple owns what its elements own, and drops them where it ends.
    val greeting = (String::of("hello"), 1)
    io::println(greeting.0.toStr())
}
