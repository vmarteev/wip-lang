// A field moved out of a field of a local: dropping the
// local drops what is left of it, and not what was moved; putting a whole
// value back where the outer field was drops only what was left there.

import std::io

struct Noisy {
    name: String
}

extend Noisy: Destroy {
    var fn destroy() = io::println("dropped \(self.name)")
}

struct Inner {
    kept: Noisy
    left: Noisy
}

struct Outer {
    inner: Inner
    other: Noisy
}

fn noisy(name: str): Noisy = Noisy(name: String::of(name))

fn main() = {
    val first = Outer(inner: Inner(kept: noisy("kept"), left: noisy("left")), other: noisy("other"))
    val taken = move first.inner.kept
    io::println("taken \(taken.name)")
    var second = Outer(inner: Inner(kept: noisy("k2"), left: noisy("l2")), other: noisy("o2"))
    val gone = move second.inner.kept
    second.inner = Inner(kept: noisy("k3"), left: noisy("l3"))
    io::println("replaced")
}
