// Struct declarations, struct literals, field access, nested structs, and
// the field shorthand `Point { x, y }`.

import std::io

struct Point {
    x: i64
    y: i64
}

struct Rect {
    origin: Point
    size: Point
}

fn area(r: &Rect): i64 = {
    r.size.x * r.size.y
}

fn main(): i64 = {
    val x = 1
    val y = 2
    val p = Point(x: x, y: y)
    val size = Point(x: 3, y: 4)
    val r = Rect(
        origin: p,
        size: size,
    )
    io::printInt(r.origin.y) // 2
    io::printInt(area(&r))   // 12
    0
}
