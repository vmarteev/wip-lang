// `@derive` on a type whose field's type derives the same interface in a
// file read after it: what every type asks for is known
// before any derive is checked, so the order of the files does not matter.
// And a `Vec` says whether it is empty, as a slice does.

import std::io
import shapes::{State, Id}

fn main() = {
    val moving: State = .Moving(id: Id(value: 1))
    val same: State = .Moving(id: Id(value: 1))
    io::println("\(moving == same) \(moving == .Done) \(moving)")
    val nothing: Vec<i64> = Vec()
    io::println("\(nothing.isEmpty())")
}
