// `_` for a variant's one field, which it matches whatever it holds:
// in a `match`, an `is`, a `val … else`, a struct of one
// field, and beside a named field's `_`.

import std::io

enum Shape {
    Round(radius: i64)
    Rect(width: i64, height: i64)
    Dot
}

struct Wrapper {
    inner: i64
}

fn kind(shape: &Shape): str = match shape {
    .Round(_) => "round"
    .Rect(width: _, ..) => "rect"
    .Dot => "dot"
}

fn main() = {
    val found: Option<i64> = .Some(3)
    if found is .Some(_) {
        io::println("some")
    }
    val .Some(_) = found else {
        return
    }
    val Wrapper(_) = Wrapper(inner: 1)
    io::println("\(kind(Shape::Round(radius: 1))) \(kind(Shape::Rect(width: 1, height: 2))) \(kind(Shape::Dot))")
    val r: Result<i64, str> = .Err("no")
    match r {
        .Ok(_) => io::println("ok")
        .Err(_) => io::println("err")
    }
}
