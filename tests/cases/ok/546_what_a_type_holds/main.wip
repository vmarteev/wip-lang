// Whether a type borrows is read from what its fields hold: a generic type
// given a `str` borrows only where its fields hold the parameter. A
// `Handle<str>` is a slot and a generation, and a type of handles is plain
// data, kept in a struct that is not a view. A body that removes by handle
// and keeps what it removed keeps nothing of the handle, so says no
// `keeps`; nor does one whose call answers what the callee's signature says
// borrows nothing of an argument.
//
// Expected output:
// pear
// 1 taken, 1 left
// 2 handles

import std::collections::{Arena, Handle}
import std::io

struct Named {
	at: Handle<str>
}

// Names a value of `T` without holding one.
struct Picked<T> {
	at: Handle<T>
	count: i64
}

struct Picks {
	first: Picked<str>
}

struct Shelf<T> {
	items: Arena<T> = Arena()
	taken: Vec<T> = Vec()
}

extend Shelf<T> {
	var fn put(item: T): Handle<T> keeps item = self.items.add(item)

	var fn take(handle: Handle<T>) = {
		if self.items.remove(handle) is .Some(item) then self.taken.push(item)
	}
}

fn picked<T>(at: Handle<T>): Picked<T> = Picked(at: at, count: 1)

fn listed<T>(shelf: &Shelf<T>, at: Handle<T>, into: &var Vec<Picked<T>>) = {
	into.push(picked(at))
}

fn main() = {
	var names: Arena<str> = Arena()
	val named = Named(at: names.add("pear"))
	val picks = Picks(first: Picked(at: named.at, count: 0))
	io::println(names[picks.first.at])

	var shelf: Shelf<str> = Shelf()
	val apple = shelf.put("apple")
	val plum = shelf.put("plum")
	shelf.take(apple)
	io::println("\(shelf.taken.len()) taken, \(shelf.items.len()) left")

	var list: Vec<Picked<str>> = Vec()
	listed(&shelf, plum, &var list)
	listed(&shelf, apple, &var list)
	io::println("\(list.len()) handles")
}
