// `var` before a name in a pattern makes it a variable of its own, holding
// its part: in an arm of a value, an arm of a place (plain data copied, the
// place keeping its own), an `is`, a `val` pattern, a `for` by parts and
// whole, and a `for` over a range. A part that owns memory is taken, and
// the place it was in given up.
//
// Expected output:
// ran 2
// square 5
// still 4
// more 2
// 2 seen twice
// sum 274 1
// triangle

import std::io

struct Point {
	x: i64
	y: i64
}

enum Shape {
	Circle(radius: i64)
	Named(label: String, sides: i64)
}

fn opened(n: i64): Result<Vec<i64>, str> = if n > 0 then .Ok([n]) else .Err("none")

fn grow(list: &var Vec<i64>) = list.push(list.len())

fn main() = {
	val ran = match opened(3) {
		.Ok(var list) => {
			grow(&var list)
			list.len()
		}
		.Err(..) => 0
	}
	io::println("ran \(ran)")

	val shape = Shape::Named(label: String::of("square"), sides: 4)
	match shape {
		.Named(label, var sides) => {
			sides += 1
			io::println("\(label) \(sides)")
		}
		_ => {}
	}
	if shape is .Named(sides, ..) then io::println("still \(sides)")

	if opened(2) is .Ok(var more) {
		more.push(9)
		io::println("more \(more.len())")
	}

	val (count, var label) = (2, String::of("seen"))
	label.push(" twice")
	io::println("\(count) \(label)")

	val points = [Point(x: 1, y: 2), Point(x: 3, y: 4)]
	var sum = 0
	for (x, var y) in points {
		y *= 10
		sum += x + y
	}
	for var p in points {
		p.x += 100
		sum += p.x
	}
	for var i in 0..3 {
		i *= 2
		sum += i
	}
	io::println("sum \(sum) \(points[0].x)")

	val named = Shape::Named(label: String::of("tri"), sides: 3)
	match named {
		.Named(var label, ..) => {
			label.push("angle")
			io::println(label)
		}
		_ => {}
	}
}
