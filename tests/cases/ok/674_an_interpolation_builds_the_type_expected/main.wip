// An interpolated literal builds the type expected of it: `Html` where
// `Html` is expected, its text as written and each value escaped, a value
// of `Html` joined as it is and a number written as text; a literal with no
// holes where `Html` is expected; `Html` built in steps and joined with a
// separator; `Xml` for a plist; a `String` where nothing else is expected,
// widths and precisions as they were; and an `Option` of `Html`, whose
// success is built.
//
// Expected output:
// <li><a href="/users/7">&lt;Ada&gt; &amp; co</a> <b>2</b> items</li>
// <ul></ul>
// <a href="/a">a</a>, <a href="javascript%3Ax">b</a>
// <key>a&lt;b</key>
// [   7] [2.50] [Ada   ]
// <p>maybe</p>

import std::io
import std::markup::{Html, Xml}

fn bold(count: i64): Html = "<b>\(count)</b>"

fn row(id: i64, name: str, count: i64): Html =
	"<li><a href=\"/users/\(id)\">\(name)</a> \(bold(count)) items</li>"

fn link(href: str, text: str): Html = "<a href=\"\(href)\">\(text)</a>"

fn maybe(): Option<Html> = "<p>maybe</p>"

fn main() = {
	io::println(row(7, "<Ada> & co", 2).toStr())
	var list = Html()
	list.push("<ul>")
	list.push("</ul>")
	io::println(list.toStr())
	val links = [link("/a", "a"), link("javascript:x", "b")]
	io::println(Html::joined(&links, ", ").toStr())
	val plist: Xml = "<key>\("a<b")</key>"
	io::println("\(plist)")
	val name = "Ada"
	io::println("[\(7, width: 4)] [\(2.5, precision: 2)] [\(name, width: 6)]")
	if maybe() is .Some(page) then
		io::println(page.toStr())
}
