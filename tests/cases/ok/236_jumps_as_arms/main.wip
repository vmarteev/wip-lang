// An arm's value may be `return`, `break` or `continue`, with what each
// takes: the case ends the function or the loop, and the arm's type is
// `never`.

import std::io

fn doubled(text: str): Result<i64, str> = {
    val n = match text.toInt() {
        .Ok(n) => n
        .Err(..) => return .Err("not a number")
    }
    return .Ok(n * 2)
}

fn firstComment(lines: &[str]): Option<str> = {
    for line in lines {
        val rest = match line.stripPrefix("#") {
            .Some(rest) => rest
            .None => continue
        }
        return .Some(rest)
    }
    return .None
}

fn counted(lines: &[str]): i64 = {
    var n = 0
    rows: for line in lines {
        for _ in 0..1 {
            match line {
                "end" => break rows
                "" => continue rows
                _ => n += 1
            }
        }
    }
    return n
}

fn stops(early: bool) = {
    match early {
        true => return
        false => io::println("went on")
    }
}

fn main() = {
    io::println("\(doubled("21")) \(doubled("x"))")
    io::println("\(firstComment(["a", "#b"])) \(firstComment(["a"]))")
    io::println("\(counted(["a", "", "b", "end", "c"]))")
    stops(true)
    stops(false)
}
