// A drop a program writes: a type that implements the
// prelude's `Destroy` cleans up after itself, and the compiler calls its method
// where a value ends — at the end of a scope, at a reassignment, at an early
// return, and as part of dropping whatever holds it. The body runs first and
// the fields after, last first.
//
// Expected output: 1 and 9 (a value ended early by `destroy(move …)`), 0, 9 and
// 1 (the same function where nothing moves it), 2 and 100 (an early return),
// 2 and 5, 40 twice (the drop of a parameter, then the value it returned),
// 60 (a reassignment dropping the old value), 99, then this scope's values,
// newest first: 70 (inside a generic type), 32 and 31 (an array), 20 (on the
// heap), 12 and 11 (a struct's two fields), 4 then 3 (a type whose drop runs
// before the `own` it holds), and 61 last, since its variable was declared
// first.

import std::io

struct Guard {
    id: i64
}

extend Guard: Destroy {
    var fn destroy() = io::printInt(self.id)
}

struct Pair {
    left: Guard,
    right: Guard
}

struct Holder {
    inner: own<Guard>,
    id: i64
}

extend Holder: Destroy {
    var fn destroy() = io::printInt(self.id)
}

struct Boxed<T> {
    value: T
}

fn consume(guard: Guard): i64 = guard.id

fn maybe(take: bool) = {
    val guard = Guard(id: 1)
    if take { destroy(move guard) } else { io::printInt(0) }
    io::printInt(9)
}

fn early(n: i64): i64 = {
    val guard = Guard(id: 2)
    if n == 0 {
        return 100
    }
    n
}

fn main() = {
    maybe(true)
    maybe(false)
    io::printInt(early(0))
    io::printInt(early(5))

    // Moved into a call: the callee drops it, once.
    io::printInt(consume(Guard(id: 40)))

    // A reassignment drops what was there.
    var slot = Guard(id: 60)
    slot = Guard(id: 61)

    val holder = Holder(inner: own Guard(id: 3), id: 4)
    val pair = Pair(left: Guard(id: 11), right: Guard(id: 12))
    val owned = own Guard(id: 20)
    val many = [Guard(id: 31), Guard(id: 32)]
    val boxed = Boxed<Guard>(value: Guard(id: 70))
    io::printInt(99)
}
