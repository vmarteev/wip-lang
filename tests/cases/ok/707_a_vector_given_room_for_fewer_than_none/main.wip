// A vector given room for fewer than no values panics where it is made: the
// room is a count of slots, and a negative one said its block was full
// before anything was in it, so the first push wrote past the end. `filled`
// with a count of zero or less is an empty vector, as before.
//
// Expected output: 0, then a panic naming the room asked for, and the exit
// code 101.

import std::io

fn main() = {
    val none: Vec<String> = Vec::filled(-3, "x")
    io::printInt(none.len())
    var lines: Vec<String> = Vec::withCapacity(-1)
    lines.push("one")
}
