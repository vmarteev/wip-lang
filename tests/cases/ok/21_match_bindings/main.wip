// Pattern forms: wildcard `_`, ignored payload fields, and a catch-all binding.
// A bare name in a pattern is always a binding, never a variant.

import std::io

enum Event {
    Key(code: i64, shift: bool)
    Click(x: i64, y: i64)
    Resize(w: i64, h: i64)
    Quit
}

fn codeOf(e: &Event): i64 = {
    return match e {
        .Key(code, ..) => code
        .Click(..) => -1
        _ => 0
    }
}

fn describe(e: Event): i64 = {
    return match e {
        .Quit => 1
        other => codeOf(&other)
    }
}

fn main(): i64 = {
    io::printInt(codeOf(Event::Key(code: 65, shift: true))) // 65
    io::printInt(describe(Event::Click(x: 1, y: 2)))   // -1
    io::printInt(describe(Event::Quit))          // 1
    0
}
