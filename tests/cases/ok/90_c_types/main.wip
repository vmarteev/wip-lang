// C's type names: `c_int`, `c_long`, `size_t` and the rest
// are built-in names fixed per target, so a binding never writes `i64` for
// `long` — which is 64 bits on a Unix and 32 bits on Windows, as C's own
// `sizeof` says. They are ordinary integer types, so they do arithmetic and
// cross into C.
//
// Expected output: 12 (`int` multiplied in C), 3000000000 (a `long long`,
// which would not fit in an `int`), true (a `long` as wide as C says), 5
// (a `size_t` length) and 101 (an `unsigned char`).

import std::c
import std::io

extern "C" {
    fn area(width: c_int, height: c_int): c_int
    fn widen(x: c_int): c_longlong
    fn long_bytes(): c_int
    fn count_bytes(text: cstring): size_t
    fn byte_at(text: cstring, i: size_t): c_uchar
}

fn main() = {
    io::printInt(area(3, 4) as i64)
    io::printInt(widen(3) as i64)
    io::println("\(long_bytes() as i64 == c::sizeOf<c_long>() as i64)")
    val length = count_bytes("hello")
    io::printInt(length as i64)
    io::printInt(byte_at("hello", 1) as i64)
}
