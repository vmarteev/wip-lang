// Quicksort (Lomuto partition) over slices: one `quicksort`
// sorts arrays of any length in place, recursing on the two halves as
// sub-slices. Two elements of one slice cannot both be passed as `&var`
// (E0413), so elements are exchanged by index.
//
// Expected output: the ten numbers in ascending order, 1 (sorted), then the
// sixteen numbers in ascending order, 1.

import std::io

fn swapAt(xs: &var [i64], i: i64, j: i64) = {
    val t = xs[i]
    xs[i] = xs[j]
    xs[j] = t
}

fn partition(xs: &var [i64]): i64 = {
    val last = xs.len() - 1
    val pivot = xs[last]
    var i = 0
    var j = 0
    while j < last {
        if xs[j] < pivot {
            swapAt(&var xs, i, j)
            i = i + 1
        }
        j = j + 1
    }
    swapAt(&var xs, i, last)
    i
}

fn quicksort(xs: &var [i64]) = {
    if xs.len() > 1 {
        val p = partition(&var xs)
        quicksort(&var xs[..p])
        quicksort(&var xs[p + 1..])
    }
}

fn isSorted(xs: &[i64]): bool = {
    var i = 1
    while i < xs.len() {
        if xs[i - 1] > xs[i] {
            return false
        }
        i = i + 1
    }
    true
}

fn printAll(xs: &[i64]) = {
    var i = 0
    while i < xs.len() {
        io::printInt(xs[i])
        i = i + 1
    }
    io::printInt(if isSorted(&xs) { 1 } else { 0 })
}

fn main(): i64 = {
    var small = [38, 27, 43, 3, 9, 82, 10, 3, -5, 0]
    var large = [5, -1, 17, 4, 4, 100, 0, 23, 8, -30, 12, 7, 64, 2, 9, 1]
    quicksort(&var small)
    quicksort(&var large)
    printAll(&small)
    printAll(&large)
    0
}
