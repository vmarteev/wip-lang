// A variable that holds a function value, captured as any variable is: a
// closure lent for a call calls it, and sees it changed; a closure kept in a
// `val` calls it; a closure that writes may assign it; a closure inside a
// closure reaches it through the one around it; a generator and an owned
// closure call it too.
//
// Expected output: 2 4, then 30 after the closure changed it, 6 kept, 6 from
// the closure inside, 0 2 4 from the generator, and 8 from the owned one.

import std::io

fn each(n: i64, visit: &(x: i64) => void) = {
	for i in 1..n + 1 {
		visit(i)
	}
}

fn change(apply: &var () => void) = apply()

fn triple(x: i64): i64 = x * 10

fn main() = {
	var scale = (x: i64) => x * 2
	// A closure lent for one call reads the variable where it is.
	each(2, (x) => io::print("\(scale(x)) "))
	io::println("")
	// One that writes may assign it, and the variable is changed.
	change(() => {
		scale = triple
	})
	each(1, (x) => io::println("\(scale(3))"))
	scale = (x: i64) => x * 2

	// Kept in a `val`, reading it where it is.
	val doubled = (x: i64) => scale(x)
	io::println("\(doubled(3)) kept")

	// A closure inside a closure, which reaches it through the one around it.
	each(1, (x) => each(1, (y) => io::println("\(scale(x + y + 1)) from the closure inside")))

	// A generator reads what it names.
	var numbers = own for i in 0..3 {
		yield scale(i)
	}
	for n in numbers {
		io::print("\(n) ")
	}
	io::println("from the generator")

	// An owned closure copies it.
	val owned = own (x: i64) => scale(x)
	io::println("\(owned(4)) from the owned one")
}
