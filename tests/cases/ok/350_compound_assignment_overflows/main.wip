// A compound assignment is checked as its operator is: `+=` past what a `u8`
// holds panics, where it once wrapped.
//
// Expected: "250", then a panic, "the sum does not fit".

import std::io

fn main() = {
    var byte: u8 = 250
    io::println("\(byte)")
    for _ in 0..10 {
        byte += 1
    }
    io::println("not reached \(byte)")
}
