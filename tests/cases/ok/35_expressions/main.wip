// Blocks and `if` are expressions. A block's value is its last
// expression, a function body is any expression, and a branch that returns
// fits any type. `else` and `.` continue an expression on the next line.

import std::io

struct Point {
    x: i64
    y: i64
}

fn abs(x: i64): i64 = if x < 0 { -x } else { x }

fn sign(x: i64): i64 =
    if x < 0 { -1 }
    else if x > 0 { 1 }
    else { 0 }

fn origin(): Point = Point(x: 0, y: 0)

fn corner(far: bool): Point = if far { Point(x: 9, y: 9) } else { origin() }

fn parity(n: i64): cstring = {
    val name: cstring = if n % 2 == 0 { "even" } else { "odd" }
    name
}

fn report(n: i64) = if n > 0 { io::println("positive") } else { io::println("not positive") }

fn clamp(n: i64): i64 = {
    val limited = if n > 100 { return 100 } else { n }
    limited + 0
}

fn main(): i64 = {
    io::printInt(abs(-5))          // 5
    io::printInt(sign(-3))         // -1
    io::printInt(sign(0))          // 0
    io::printInt(corner(true).y)   // 9
    io::printInt(corner(false)
        .x)                         // 0
    io::printCstring(parity(7))        // odd
    report(-1)                      // not positive
    io::printInt(clamp(250))       // 100
    io::printInt(clamp(7))         // 7
    val area = {
        val w = 2
        val h = 3
        w * h
    }
    io::printInt(area)             // 6
    var steps = 0
    while steps < 3 {
        steps = steps + 1
    }
    if steps == 3 {
        io::println("three")
    }
    else {
        io::println("not three")
    }
    0
}
