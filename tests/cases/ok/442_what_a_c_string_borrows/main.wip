// A C string made from a `String` borrows its bytes, and is used while they
// are there: given to C in its statement, kept in a variable while the
// `String` lives, held in a struct and in a list, and made again after the
// `String` changes. One from C, a literal, or one of the program's
// arguments borrows nothing of the program's, and goes anywhere.
//
// Expected output:
// 5 5 5 5
// 12
// 2 1 true

import std::io

extern "C" {
	fn strlen(s: cstring): size_t
	fn getenv(name: cstring): cstring
}

struct Request {
	name: cstring
	size: i64
}

/// What C answers is C's to keep, so it may be returned, and held in what
/// is returned.
fn home(): Request = Request(name: getenv("HOME"), size: 0)

/// A literal lives as long as the program.
fn greeting(): cstring = "hello"

fn length(request: &Request): size_t = strlen(request.name)

fn main(args: &[cstring]) = {
	var text = String::of("hello")
	val kept = text.toCstring()
	val request = Request(name: kept, size: 5)
	var names: Vec<cstring> = Vec()
	names.push(kept)
	io::println("\(strlen(String::of("hello").toCstring())) \(strlen(kept)) \(length(&request)) \(strlen(names[0]))")
	text.push(", again")
	io::println("\(strlen(text.toCstring()))")
	val fromC = home()
	val said = greeting()
	io::println("\(strlen(said) - 3) \(args.len()) \(strlen(args[0]) > 0 && fromC.size == 0)")
}
