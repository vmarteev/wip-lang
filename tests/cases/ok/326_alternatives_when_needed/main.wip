// `or` and `unwrapOr` evaluate their alternative at the call; `orElse` and
// `unwrapOrElse` make it only where it is needed, and a `Result`'s are given
// the error. They are lent for the call, so an alternative
// may change what it captures: each here counts that it was made.

import std::io

struct Made {
    count: i64 = 0
}

extend Made {
    var fn some(value: i64): Option<i64> = {
        self.count += 1
        return .Some(value)
    }

    var fn number(value: i64): i64 = {
        self.count += 1
        return value
    }
}

fn main() = {
    var made = Made()
    val found: Option<i64> = .Some(1)
    val missing: Option<i64> = .None

    // Eager: made for both, used by one.
    val a = found.or(made.some(2))
    val b = missing.or(made.some(3))
    io::println("\(a) \(b) made \(made.count)")

    made.count = 0
    val c = found.orElse(() => made.some(2))
    val d = missing.orElse(() => made.some(3))
    val e = found.unwrapOrElse(() => made.number(4))
    val f = missing.unwrapOrElse(() => made.number(5))
    io::println("\(c) \(d) \(e) \(f) made \(made.count)")

    // A `Result`'s alternative is made from the error.
    val good: Result<i64, String> = .Ok(6)
    val bad: Result<i64, String> = .Err(String::of("seven"))
    val worse: Result<i64, String> = .Err(String::of("eight!"))
    io::println("\(good.unwrapOrElse((error) => error.len()))")
    val retried = bad.orElse((error) => if error == "seven" { .Ok(7) } else { .Err(move error) })
    io::println("\(retried.unwrapOr(0)) \(worse.unwrapOrElse((error) => error.len()))")

    // What owns memory is taken by the alternative, and dropped once.
    val name: Option<String> = .None
    io::println(name.unwrapOrElse(() => String::of("nobody")).toStr())

    // A function by its name is an alternative too.
    io::println("\(missing.unwrapOrElse(fortyTwo))")
}

fn fortyTwo(): i64 = 42
