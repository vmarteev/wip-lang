// Each branch of an `if` is written in the form it needs, and the branches
// of one `if` may differ: one expression after `then` or `else`, statements
// in braces. An early answer beside a body; a block beside a short value;
// a `match` after `else`; and a chain whose branches take three forms.
//
// Expected output: 4 6 5 4 1 2

import std::io

fn first(xs: &[i64]): Option<i64> = {
    if xs.isEmpty() then return .None else {
        val n = xs[0]
        return .Some(n * 2)
    }
}

fn size(cached: bool): i64 = {
    val size = if cached {
        val entry = 3
        entry * 2
    } else 0
    return size
}

fn pick(diverges: bool, value: Option<i64>): i64 =
    if diverges then 0
    else match value {
        .Some(v) => v
        .None => 1
    }

fn chain(x: i64): i64 = if x < 0 then -1 else if x == 0 {
    val doubled = x * 2
    doubled + 4
} else if x == 1 { 1 } else 2

fn main() = {
    val f = first([2]).unwrapOr(0)
    io::println("\(f) \(size(true)) \(pick(false, .Some(5))) \(chain(0)) \(chain(1)) \(chain(9))")
}
