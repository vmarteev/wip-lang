// A lambda whose result nothing expects answers what it first returns, or
// else its body's value; the two must agree.

import std::io

fn apply<R>(f: &() => R): R = f()

fn main() = {
	val size = apply(() => {
		val sides = 4
		return sides * 2
	})
	val word = apply(() => {
		if size > 5 {
			return "big"
		}
		"small"
	})
	// A bare `return` answers nothing.
	apply(() => {
		if size > 100 {
			return
		}
		io::println("\(size) \(word)")
	})
}
