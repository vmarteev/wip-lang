// Methods: declared inside a struct or an enum, with an
// implicit receiver. `fn` reads it, `var fn` writes it, `move fn` takes it,
// and `static fn` has none and is called through the type.
//
// Expected output:
// - 0, 6 and 8 (a static function, a `var fn` with a default argument, and
//   a `fn` that reads);
// - 8 (a `move fn`, which takes the receiver);
// - 1, 6, 7 and 12 (methods of a generic enum, one with a type parameter of
//   its own);
// - 9 and 3 (a projection as a method, written through and read);
// - 2 (a method of another type with the same name);
// - 4 and 4 (a method called through `&var`, and one called through `own`);
// - 30 (a method that calls another through `self`), and every allocation
//   freed.

import std::io

struct Counter {
    count: i64

    static fn new(): Counter = Counter(count: 0)
    static fn at(count: i64): Counter = Counter(count: count)

    fn get(): i64 = self.count
    var fn add(by: i64 = 1) = self.count = self.count + by
    var fn twice(by: i64) = {
        self.add(by: by)
        self.add(by: by)
    }
    move fn intoCount(): i64 = self.count
}

enum Maybe<T> {
    Some(value: T)
    None

    fn isSome(): bool = self is .Some(..)
    move fn unwrapOr(default: T): T = match move self {
        .Some(x) => move x
        .None => move default
    }
    move fn map<U>(f: (value: T) => U): Maybe<U> = match move self {
        .Some(x) => .Some(f(move x))
        .None => .None
    }
    static fn none(): Maybe<T> = .None
}

struct Grid {
    cells: own<[i64]>

    static fn zero(size: i64): Grid = Grid(cells: own [0; size])
    var fn at(i: i64): &var i64 = lend self.cells[i]
    fn sum(): i64 = {
        var total = 0
        for c in self.cells {
            total += c
        }
        total
    }
}

// A method of another type may have the same name.
struct Pair {
    a: i64
    b: i64

    fn sum(): i64 = self.a + self.b
}

struct Boxed {
    inner: own<Counter>
}

fn double(value: i64): i64 = value * 2

fn bump(c: &var Counter) = c.add(by: 4)

fn main() = {
    var c = Counter::new()
    io::printInt(c.get())
    c.add()
    c.add(by: 5)
    io::printInt(c.get())
    c.add(2)
    io::printInt(c.get())
    io::printInt(c.intoCount())

    val some = Maybe<i64>::Some(3)
    io::printInt(if some.isSome() { 1 } else { 0 })
    io::printInt(some.map(double).unwrapOr(0))
    io::printInt(Maybe<i64>::none().unwrapOr(7))
    io::printInt(Maybe<i64>::Some(6).map(double).unwrapOr(0))

    var grid = Grid::zero(4)
    grid.at(2) = 5
    grid.at(2) += 4
    io::printInt(grid.sum())
    io::printInt(grid.at(2) - 6)

    io::printInt(Pair(a: 1, b: 1).sum())

    var owner = Counter::at(0)
    bump(&var owner)
    val boxed = Boxed(inner: own Counter::at(4))
    io::printInt(owner.get())
    io::printInt(boxed.inner.get())

    var chain = Counter::new()
    chain.twice(15)
    io::printInt(chain.get())
}
