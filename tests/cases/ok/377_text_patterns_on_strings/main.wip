// A text pattern matches a `String` by the text it holds, as it matches a
// `str`: at the top of a `match`, in an `is`, in a variant's field and a
// tuple's element, through a constant of type `str`, and while the program
// is compiled.
//
// Expected output: 1 2 0 -1, then x 3, then 2.

import std::io

enum ArgumentError {
	NotANumber(option: String, text: String)
	Missing
}

val ADD = "add"

fn command(word: String): i64 = match word {
	ADD => 1
	"remove" => 2
	"" => 0
	_ => -1
}

@comptime
val REMOVE = command(String::of("remove"))

fn main() = {
	val words = [String::of("add"), String::of("remove"), String(), String::of("other")]
	io::println("\(command(words[0].clone())) \(command(words[1].clone())) \(command(words[2].clone())) \(command(words[3].clone()))")

	val error = ArgumentError::NotANumber(option: String::of("-n"), text: String::of("x"))
	assert(error is .NotANumber(option: "-n", ..))
	assert(!(error is .NotANumber(option: "-m", ..)))

	val pair = (String::of("x"), 3)
	match pair {
		("x", n) => io::println("x \(n)")
		_ => io::println("other")
	}

	io::println("\(REMOVE)")
}
