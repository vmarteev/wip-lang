// A full path names an item with no import, and the module it starts with
// is read as an imported one is, wherever the path is written: a type, a
// call, a type argument, a module below another, a constant, and the
// standard library's. Nothing here imports anything.
//
// Expected output:
// 4
// 9
// 2 1
// 6.28

fn main() = {
    val square: shapes::Square = shapes::Square(side: 2)
    std::io::println("\(shapes::area(square))")
    std::io::println("\(shapes::sizes::biggest())")
    val squares: Vec<shapes::Square> = Vec::of(own [square, shapes::Square(side: 1)])
    std::io::println("\(squares.len()) \(shapes::sizes::ONE)")
    std::io::println("\(std::math::PI_F32 * 2.0, precision: 2)")
}
