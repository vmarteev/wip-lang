// In a debug build, an error that ends the program is followed by where it
// was made and each place that passed it on: a `?`, a `?` that converts it
// through `From`, a `match` that hands it back, and `mapErr`, each of which
// keeps where it was made. An error made and handled before it is not in
// the trace, which begins again where an error is made.
//
// Expected output: `parsed -1` on standard output; on standard error,
// `error: cannot read settings.conf: not found`, then the trace from
// `readFile` through `main`; exit code 1.

import std::io

enum ReadError {
    NotFound
}

enum ConfigError {
    Read(path: String, error: ReadError)
}

extend ConfigError: Text {
    fn appendTo(out: &var String) = match self {
        .Read(path, ..) => out.push("cannot read \(path): not found")
    }
}

extend ConfigError: From<ReadError> {
    static fn from(error: ReadError): ConfigError = .Read(path: "settings.conf", error: error)
}

fn readFile(path: str): Result<String, ReadError> = {
    if path.isEmpty() then return .Ok(String())
    return .Err(.NotFound)
}

fn readConfig(path: str): Result<String, ReadError> = {
    val text = readFile(path)?
    return .Ok(text)
}

fn load(path: str): Result<String, ConfigError> = {
    val text = readConfig(path)?
    return .Ok(text)
}

fn loadAgain(path: str): Result<String, ConfigError> = match load(path) {
    .Ok(text) => .Ok(text)
    .Err(error) => .Err(error)
}

fn settings(): Result<String, ConfigError> = loadAgain("settings.conf").mapErr((e) => e)

fn main(): Result<void, ConfigError> = {
    val parsed = "x2".toInt().unwrapOr(-1)
    io::println("parsed \(parsed)")
    val text = settings()?
    io::println(text)
    return .Ok({})
}
