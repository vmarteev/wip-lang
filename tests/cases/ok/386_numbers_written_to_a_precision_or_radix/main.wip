// A float written to a precision and an integer in a radix: rounded once,
// a tie to the even digit, with no point at none; in lower case after a
// sign, as `toInt(radix:)` reads it back; with a width and zeros after the
// sign; the smallest and largest 128-bit integers; and the same values
// made by `withPrecision` and `inRadix`.
//
// Expected output: 0.057 s, then 2 4 1.00, then 0f -ff 11111111, then
// [-0001.50] [0.1000000015], then the smallest i128 and the largest u128 in
// hexadecimal, then 1.50 73.

import std::io

fn main() = {
	val seconds = 0.0567
	io::println("\(seconds, precision: 3) s")
	io::println("\(2.5, precision: 0) \(3.5, precision: 0) \(1.005, precision: 2)")
	val byte: u8 = 15
	io::println("\(byte, radix: 16, width: 2, fill: '0') \(-255, radix: 16) \(255 as u8, radix: 2)")
	io::println("[\(-1.5, precision: 2, width: 8, fill: '0')] [\(0.1 as f32, precision: 10)]")
	val smallest: i128 = -170141183460469231731687303715884105728
	val largest: u128 = 340282366920938463463374607431768211455
	io::println("\(smallest, radix: 16)")
	io::println("\(largest, radix: 16)")
	assert("ff".toInt(radix: 16) == .Ok(255) && "\(255, radix: 16)" == "ff")
	io::println("\(1.5.withPrecision(2)) \(255.inRadix(36))")
}
