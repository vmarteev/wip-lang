// A `for` over a value made for it, such as the vector a call answers, whose
// body moves a variable out and returns: the next element never comes, so
// the variable is not moved by the next iteration. A body that always leaves
// once read as one that went on, and the move as a move made on every pass.
//
// Expected output: found 2, then nothing found.

import std::io

fn numbers(): Vec<i64> = Vec::of(own [1, 2, 3])

fn first(over: i64): Option<String> = {
	val found = String::of("found")
	for n in numbers() {
		if n <= over then continue
		return .Some("\(found) \(n)")
	}
	return .None
}

fn kept(over: i64): String = {
	val answer = String::of("nothing found")
	for n in numbers() {
		if n > over then return move answer
	}
	return move answer
}

fn main() = {
	if first(1) is .Some(text) then io::println(text)
	if first(5) is .None then io::println(kept(5))
}
