// `&var` references. A reference parameter stands for the
// caller's variable, and through `&var` the function writes it. A `&var`
// parameter may be moved out of if it holds a value again before the
// function returns, which is how `swap` works for `own` values. Different
// fields of one struct can be borrowed `&var` in one call; two `&` to the
// same place are fine.
//
// Expected output: 2 1 (integers swapped), 20 10 (boxes swapped), 3, 5 7,
// 30, 99, 30, 42, and the three boxes freed at the end.

import std::io

extern "C" {
    fn wip_trace_allocs()
}

struct Counter {
    hits: i64
}

struct Pair {
    a: i64
    b: i64
}

struct Node {
    value: i64
}

fn swap(a: &var i64, b: &var i64) = {
    val t = a
    a = b
    b = t
}

fn swapNodes(a: &var own<Node>, b: &var own<Node>) = {
    val t = move a
    a = move b
    b = move t
}

fn bump(c: &var Counter) = {
    c.hits = c.hits + 1
}

fn bumpTwice(c: &var Counter) = {
    bump(&var c)
    bump(&var c)
}

fn setBoth(a: &var i64, b: &var i64) = {
    a = 5
    b = 7
}

fn reset(p: &var Pair) = {
    p = Pair(a: 10, b: 20)
}

fn set(v: &var i64) = {
    v = 99
}

fn total(x: &Pair, y: &Pair): i64 = x.a + y.b

fn main(): i64 = {
    wip_trace_allocs()
    var x = 1
    var y = 2
    swap(&var x, &var y)
    io::printInt(x)
    io::printInt(y)

    var m = own Node(value: 10)
    var n = own Node(value: 20)
    swapNodes(&var m, &var n)
    io::printInt(m.value)
    io::printInt(n.value)

    var c = Counter(hits: 1)
    bumpTwice(&var c)
    io::printInt(c.hits)

    var p = Pair(a: 0, b: 0)
    setBoth(&var p.a, &var p.b)
    io::printInt(p.a)
    io::printInt(p.b)
    reset(&var p)
    io::printInt(p.a + p.b)

    var xs = [1, 2, 3]
    set(&var xs[1])
    io::printInt(xs[1])
    io::printInt(total(&p, &p))

    var boxed = own Counter(hits: 41)
    bump(&var boxed)
    io::printInt(boxed.hits)
    0
}
