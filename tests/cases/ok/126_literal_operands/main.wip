// A literal takes the type of the other operand, whichever side of the
// operator it is on: `48 <= byte` as well as `byte >= 48`, as a `for`
// range's bound takes its type from the other bound.
//
// Expected output: 2 (digits counted with the literal on the left), true
// twice (a byte and a float compared from both sides), 6 and 6 (arithmetic
// that keeps its type), and -1 compared against a signed number.

import std::io

fn digits(text: str): i64 = {
    var n = 0
    var i = 0
    while i < text.len() {
        // The literals are on the left here, and are `u8` because the
        // other side is.
        if 48 <= text[i] && 57 >= text[i] {
            n += 1
        }
        i += 1
    }
    return n
}

fn main() = {
    io::printInt(digits("a1b2"))

    var byte: u8 = 60
    io::println("\(48 < byte), \(byte > 48)")

    val half: f32 = 1.5
    io::println("\(2.0 > half), \(half < 2.0)")

    var count: u64 = 3
    count = count * 2
    io::println("\(2 * 3), \(count)")

    // A negated literal is a literal too.
    val step: i8 = 2
    io::println("\(-1 < step)")
}
