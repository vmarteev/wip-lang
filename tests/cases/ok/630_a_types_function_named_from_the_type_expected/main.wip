// Where a type is expected, `.name(…)` calls that type's function `name`,
// one without a receiver that answers the type: in a field, an annotated
// `val`, an assignment, a result, a branch beside a typed one, an element
// beside a typed one, through `own`, and an argument lent where a reference
// is taken. A generic type's arguments are the type expected's, an
// implementation's function is chosen by its argument as `Type::from(…)`
// is, an enum's function stands beside its variants, and where an `Option`
// of the type is expected, the type's function makes its success.
//
// Expected output:
// 120 2 60
// true 1
// 3.048 3
// 5 true 9
// 7 4

import std::io

struct Axis {
    size: f32 = 0
    growing: bool = false

    static fn grow(): Axis = Axis(growing: true)
    static fn fixed(size: f32): Axis = Axis(size:)
}

struct Sizing {
    width: Axis
    height: Axis
}

struct Meters {
    value: f64
}

struct Feet {
    value: f64
}

extend Meters: From<Feet> {
    static fn from(feet: Feet): Meters = Meters(value: feet.value * 0.3048)
}

extend Meters: From<i64> {
    static fn from(n: i64): Meters = Meters(value: n as f64)
}

enum Shade {
    Light
    Dark

    static fn fromBit(bit: bool): Shade = if bit then .Dark else .Light
}

fn area(s: &Sizing): f32 = s.width.size * s.height.size

fn pick(on: bool): Axis = if on then .grow() else .fixed(3)

fn chosen(): Option<Axis> = .fixed(7)

fn boxed(): own<Axis> = own .fixed(4)

fn main() = {
    val s = Sizing(width: .fixed(2), height: .fixed(60))
    io::println("\(area(&s)) \(s.width.size) \(s.height.size)")

    val shade: Shade = .fromBit(true)
    var samples: Vec<f32> = .withCapacity(4)
    samples.push(1)
    io::println("\(shade == .Dark) \(samples.len())")

    val m: Meters = .from(Feet(value: 10))
    val n: Meters = .from(3)
    io::println("\(m.value) \(n.value)")

    val axes = [Axis::grow(), .fixed(5)]
    var later = Axis::grow()
    later = .fixed(9)
    io::println("\(axes[1].size) \(pick(true).growing) \(later.size)")

    val lent = area(Sizing(width: .grow(), height: .fixed(1)))
    assert(lent == 0)
    io::println("\(chosen().unwrap().size) \(boxed().size)")
}
