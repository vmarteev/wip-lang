// A struct declared in an `extern "C"` block has C's layout, and asks
// `@derive` for what it compares, orders, hashes, writes and clones as any
// struct does: a type a C library and the program share is compared and
// printed without a block written by hand. A union is none of these, since
// its fields lie over one another.
//
// Expected output:
// Point(x: 1, y: 2) true false
// .Less 2

import std::collections::{Set}
import std::io

extern "C" {
	@derive(Eq, Ord, Hash, Text, Clone)
	pub struct Point {
		pub var x: i32
		pub var y: i32
	}
}

fn main() = {
	val a = Point(x: 1, y: 2)
	val b = a.clone()
	io::println("\(a) \(a == b) \(a == Point(x: 2, y: 1))")
	var seen: Set<Point> = Set()
	seen.add(a)
	seen.add(b)
	seen.add(Point(x: 2, y: 1))
	io::println("\(a.compare(Point(x: 2, y: 1))) \(seen.len())")
}
