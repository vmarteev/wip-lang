// `@derive(Text)`: the writing the compiler writes. A type that
// asks for it is written as the literal that would make it — the fields
// between braces, a variant after its dot, an array between brackets — so
// `"\(world)"` says what a program has without a `match` per variant or an
// `appendTo` written by hand.
//
// It is the fourth of the annotations that write a body, beside `@derive(Eq)`,
// `@derive(Ord)` and `@derive(Hash)`.
//
// Expected output: a point, a world of four fields, a variant with fields,
// a variant without, a struct with none, a generic type at two type
// arguments, and a type that writes itself its own way.

import std::io

@derive(Text)
struct Point {
    x: i64
    y: i64
}

@derive(Text)
struct World {
    ticks: i64 = 0
    running: bool = true
    at: Point = Point(x: 1, y: 2)
    counts: [i64; 3] = [1, 2, 3]
}

@derive(Text)
enum Shape {
    Round(centre: Point, radius: i64)
    Quit
}

@derive(Text)
struct Empty {}

@derive(Text)
struct Holder<T: Text> {
    value: T
}

// A type that says how it is written says it for itself, and `@derive(Text)` is
// the other answer: a type has one.
struct Secret {
    code: i64
}

extend Secret: Text {
    fn appendTo(out: &var String) = out.push("a secret")
}

fn main() = {
    io::println("\(Point(x: 7, y: 8))")
    io::println("\(World())")
    io::println("\(Shape::Round(centre: Point(x: 0, y: 3), radius: 5))")
    io::println("\(Shape::Quit)")
    io::println("\(Empty())")
    io::println("\(Holder<i64>(value: 1)) \(Holder<bool>(value: true))")
    io::println("\(Secret(code: 1))")
}
