// What a program reaches for in a vector and a slice:
// removing and inserting in place with the order kept, truncating,
// keeping what a test says, a vector from an array or a value repeated,
// asking a slice whether any, all or how many elements pass a test,
// filling it, and walking it with the iterator adapters.

import std::io

fn main() = {
    var v = Vec::of(own [10, 20, 30, 40])
    io::printInt(v.remove(1))
    v.insert(0, 5)
    v.insert(v.len(), 50)
    for x in v { io::printInt(x) }
    v.retain((x) => x % 20 != 0)
    io::println("\(v.len()) left")
    v.truncate(1)
    io::printInt(v[0])
    var grid: Vec<Option<i64>> = Vec::filled(4, .None)
    grid[2] = .Some(7)
    io::println("\(grid.items().countWhere((c) => c.isSome())) \(grid.items().any((c) => c == .Some(7))) \(grid.items().all((c) => c.isNone()))")
    grid.items().fill(.None)
    io::println("\(grid.items().all((c) => c.isNone()))")
    val doubled = v.items().walk().map(own (x) => x * 2).toVec()
    io::printInt(doubled[0])
    val words: Vec<str> = Vec::of(own ["a", "bb", "ccc"])
    io::printInt(words.items().walk().fold(0, (sum, w) => sum + w.len()))
    var names: Vec<String> = Vec()
    names.push(String::of("x"))
    names.push(String::of("yy"))
    names.retain((n) => n.len() > 1)
    io::println(names[0].toStr())
}
