// A constant worked out while the program is compiled may pass a lambda to
// the function that works it out: a value from a function given a lambda,
// and a table each of whose entries a lambda gives.
//
// Expected output: 4, then 0 1 4 9.

import std::io

fn applied(f: (x: i64) => i64): i64 = f(2)

fn table(f: (i: i64) => i64): [i64; 4] = {
	var out = [0; 4]
	for i in 0..4 {
		out[i] = f(i)
	}
	return out
}

@comptime
val TWICE = applied((x) => x * 2)

@comptime
val SQUARES = table((i) => i * i)

fn main() = {
	io::println("\(TWICE)")
	io::println("\(SQUARES[0]) \(SQUARES[1]) \(SQUARES[2]) \(SQUARES[3])")
}
