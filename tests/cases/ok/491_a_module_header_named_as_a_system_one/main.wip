// A module's own directory is searched for `#include "…"` alone: a module
// may have a header named as the system's, `math.h`, and its C still finds
// the system's with `#include <math.h>`, and its own with quotes.
//
// Expected output: a square root from the system's header, scaled by the
// module's.

import geometry::{scaled}
import std::io

fn main() = {
    io::println("\(scaled(16.0))")
}
