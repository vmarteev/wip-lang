// An array, a slice and a buffer of one element type compare with each
// other, either way round, as the slices of their elements; and a range of
// elements is an operand as it stands.
//
// Expected output: "true true true true true true true".

import std::io

fn main() = {
    val want: [u8; 3] = [1, 2, 3]
    val list = Vec::of(own [1 as u8, 2, 3])
    val heap = own [1 as u8, 2, 3]
    val other = own [1 as u8, 2, 4]
    val a = list.items() == want && want == list.items()
    val b = list.items() == heap && heap == list.items()
    val c = heap == want && want == heap
    val d = heap != other && heap < other && other > want
    val e = list.items()[0..2] == [1 as u8, 2]
    val f = want[1..3] == heap[1..3]
    val g = want == [1 as u8, 2, 3]
    io::println("\(a) \(b) \(c) \(d) \(e) \(f) \(g)")
}
