// Owned closures: `own<(…) => R>` holds what it
// captured on the heap, so it can be returned, stored in a field, moved and
// dropped like any other value that owns memory. Plain data is copied into
// it; a value that owns memory moves in, and is freed with the closure.
//
// Expected output: 7 and 13 (a closure returned from the function that made
// it, called twice), 42 and 45 (a closure that owns what it captured, called
// and then lent to a function that takes `&(…) => R`), 9 (one stored in a
// field), 15 and 8 (one chosen by an `if`), 8 and 9 (a variable of closures,
// assigned again and then moved into a call), 5 and 12 (closures inside
// generic types), with every allocation freed.

import std::io

struct Token {
    id: i64
}

struct Cell {
    step: own<(x: i64) => i64>
}

struct Keep<T> {
    value: T
}

fn adder(n: i64): own<(x: i64) => i64> = own (x) => x + n

fn holder(t: own<Token>): own<(bump: i64) => i64> = own (bump) => t.id + bump

fn apply(f: &(x: i64) => i64, n: i64): i64 = f(n)

fn run(f: own<(x: i64) => i64>, n: i64): i64 = f(n)

fn pick(big: bool, n: i64): own<(x: i64) => i64> =
    if big { own (x) => x * n } else { own (x) => x + n }

fn keep<T>(value: T): Keep<T> = Keep(value: move value)

fn main() = {
    val add3 = adder(3)
    io::printInt(add3(4))
    io::printInt(add3(10))

    val token = own Token(id: 40)
    val bump = holder(move token)
    io::printInt(bump(2))
    io::printInt(apply(&bump, 5))

    val cell = Cell(step: own (x) => x - 1)
    io::printInt(cell.step(10))

    io::printInt(pick(true, 3)(5))
    io::printInt(pick(false, 3)(5))

    var f = own (x: i64) => x
    val counted = own Token(id: 7)
    f = own (x) => x + counted.id
    io::printInt(f(1))
    io::printInt(run(move f, 2))

    val n = 4
    val kept = keep(own (x: i64) => x + n)
    io::printInt(kept.value(1))

    var maybe: Option<own<(x: i64) => i64>> = .None
    maybe = .Some(own (x) => x * n)
    match maybe {
        .Some(times) => io::printInt(times(3))
        .None => io::printInt(0)
    }
}
