// The operators a type answers. `a + b` on a type of a
// program's own is `a.add(&b)`, `-a` is `a.negate()` and `!a` is
// `a.not()`, through the prelude's `Add`, `Subtract`, `Multiply`,
// `Divide`, `Remainder`, `Negate` and `Not` — the way `==` goes through
// `Eq`. `a += b` is `a = a + b`.
//
// Expected output: the sum, the difference and the negation of two
// vectors; the vector after `+=` and `-=`; a field added to in place;
// flags with every bit turned; true (an operator and `==` together); a
// sum written once for any type that adds; and 33 and 22 (a type that
// owns memory, added and added to).

import std::io

@derive(Eq, Text)
struct Vec2 {
    x: i64
    y: i64
}

extend Vec2: Add {
    fn add(other: &Vec2): Vec2 = Vec2(x: self.x + other.x, y: self.y + other.y)
}

extend Vec2: Subtract {
    fn subtract(other: &Vec2): Vec2 = Vec2(x: self.x - other.x, y: self.y - other.y)
}

extend Vec2: Negate {
    fn negate(): Vec2 = Vec2(x: -self.x, y: -self.y)
}

@derive(Text)
struct Flags {
    bits: i64
}

extend Flags: Not {
    fn not(): Flags = Flags(bits: !self.bits)
}

struct Body {
    at: Vec2
}

// Written once, for anything that adds.
fn sum<T: Add>(a: T, b: T): T = a + b

// A type that owns memory adds by building a new value; `+=` puts it in
// place of the old one, which is destroyed.
struct Series {
    values: Vec<i64>
}

extend Series: Add {
    fn add(other: &Series): Series = {
        var values = Vec<i64>()
        var i = 0
        while i < self.values.len() {
            values.push(self.values[i] + other.values[i])
            i += 1
        }
        return Series(values: move values)
    }
}

fn series(a: i64, b: i64): Series = {
    var values = Vec<i64>()
    values.push(a)
    values.push(b)
    return Series(values: move values)
}

fn main() = {
    val a = Vec2(x: 1, y: 2)
    val b = Vec2(x: 3, y: 5)
    io::println("\(a + b) \(b - a) \(-a)")

    var c = a
    c += b
    c -= Vec2(x: 1, y: 1)
    io::println("\(c)")

    var body = Body(at: a)
    body.at += b
    io::println("\(body.at)")

    io::println("\(!Flags(bits: 0))")
    io::println("\(-(a + b) == Vec2(x: -4, y: -7))")
    io::println("\(sum(a, b))")

    val s = series(1, 2) + series(10, 20)
    io::printInt(s.values[0] + s.values[1])
    var running = series(0, 0)
    running += series(1, 2)
    running += series(10, 20)
    io::printInt(running.values[1])
}
