// Line breaks and separators. A line break ends a statement or
// a brace-list item; on one line, `;` separates statements and `,` separates
// items. Inside `(` and `[` line breaks are ignored, and an expression that is
// not finished at the end of a line continues on the next one.

import std::io

extern "C" { fn labs(x: i64): i64; fn abs(x: c_int): c_int }

struct Point { x: i64, y: i64 }

struct Size {
    w: i64, h: i64
    depth: i64
}

fn add(a: i64, b: i64): i64 = a + b

fn sum3(
    a: i64,
    b: i64,
    c: i64,
): i64 = a + b + c

fn early(flag: bool) = {
    if flag {
        io::printCstring("returning")
        return
    }
    io::printCstring("not returning")
}

fn main(): i64 = {
    val a = 1; val b = 2; io::printInt(labs(a + b))   // 3
    var total = add(
        10,
        20,
    )
    io::printInt(total)                         // 30
    total = total +
        5
    io::printInt(total)                         // 35
    io::printInt(sum3(1, 2,
        3))                                      // 6
    val xs = [
        1, 2,
        3,
    ]
    io::printInt(xs[0] + xs[2])                 // 4
    val long = (1
        + 2
        + 3)
    io::printInt(long)                          // 6
    val p = Point(x: 1, y: 2)
    val q = Point(
        x: 3,
        y: 4,
    )
    val s = Size(w: 1, h: 2, depth: 3)
    io::printInt(p.x + q.y + s.depth)           // 8
    if a < b { io::printCstring("less") } else { io::printCstring("not less") }
    early(true)
    early(false);
    0
}
