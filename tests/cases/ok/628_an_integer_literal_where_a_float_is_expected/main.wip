// An integer literal where a float is expected is that float: an argument,
// a field, a `val` with its type said, a result, an operand on either side
// of a float, a branch, an arm, a tuple's place, an element, an `Option`'s
// success, and a local that takes its type from its first use, in `f32`
// and in `f64`. Arithmetic of literals is of the type expected, so `1 / 3`
// of an `f32` is a third. Among literals that take their type from each
// other, a float makes the integers beside it floats. Where nothing
// expects a float, an integer literal is an `i64`.
//
// Expected output:
// 255 140 0
// 127.5 20 0.5
// 1 0 0.33333334
// 2.5 0.5 -3
// 0.5 1 2.5
// 16777216 16777218 9007199254740992
// 2.5 1 7
// 3

import std::io

struct Color {
    r: f32
    g: f32
    b: f32
}

enum Shade {
    Light
    Dark
}

fn half(x: f64): f64 = x / 2

fn corner(): (f32, i64) = (1, 2)

fn inPlace(held: bool): f32 = if held then 1 else 0

fn level(shade: Shade): f32 = match shade {
    .Light => 1
    .Dark => 0
}

fn main() = {
    val c = Color(r: 255, g: 140, b: 0)
    io::println("\(c.r) \(c.g) \(c.b)")

    val width: f32 = 10
    io::println("\(c.r / 2) \(2 * width) \(if width > 20 then 1 else 0.5)")

    val third: f32 = 1 / 3
    io::println("\(inPlace(true)) \(level(.Dark)) \(third)")

    // A local of a literal takes the float its first use says.
    val parts = 4
    val step = width / parts
    val ratios = [0, 0.5, 1]
    val down: f64 = -3
    io::println("\(step) \(ratios[1]) \(down)")

    val table = [(0, 0.5), (1.5, 2)]
    val chosen: Option<f32> = 2.5
    io::println("\(table[0].1) \(corner().0) \(chosen.unwrap())")

    val limit: f32 = 16_777_216
    val even: f32 = 16_777_218
    val exact: f64 = 9_007_199_254_740_992
    io::println("\(limit) \(even) \(exact)")

    val count = 7
    io::println("\(half(5)) \(width == 10) \(count)")
    io::println("\(7 / 2)")
}
