// A projection may lend what another projection lends. The
// place `Vec::at` hands out belongs to the vector it was called on, so a
// type that holds a vector may pass that borrow on, and a container can at
// last be written on top of another one.
//
// Expected output: 1 and 2 read through two projections deep, 9 written
// through a `&var` one, the whole slice walked, and every allocation freed.

import std::io

struct Card { rank: i64 }

struct Deck {
    cards: Vec<Card>

    pub static fn new(): Deck = {
        var cards = Vec<Card>()
        cards.push(Card(rank: 1))
        cards.push(Card(rank: 2))
        return Deck(cards: move cards)
    }

    // Each of these forwards to `Vec`, which indexes its slots.
    pub fn at(index: i64): &Card = lend self.cards.at(index)
    pub var fn at(index: i64): &var Card = lend self.cards.at(index)
    pub fn all(): &[Card] = lend self.cards.items()
}

// And a chain: the table lends what the deck lends, which is what the
// vector lends.
struct Table {
    deck: Deck

    pub fn top(): &Card = lend self.deck.at(0)
    pub var fn top(): &var Card = lend self.deck.at(0)
}

fn rankOf(card: &Card): i64 = card.rank

fn main() = {
    var table = Table(deck: Deck::new())
    io::printInt(table.top().rank)
    io::printInt(table.deck.at(1).rank)

    // What a projection lends is a place: it may be written, and passed on.
    table.top().rank = 9
    io::printInt(rankOf(&table.top()))

    var total = 0
    for card in table.deck.all() {
        total += card.rank
    }
    io::printInt(total)
}
