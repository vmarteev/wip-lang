// Generic functions, structs and enums. Each use with new
// type arguments makes an instance, so plain data and values that own memory
// go through the same code: `swap` of numbers and of `own` values, an
// `Maybe` holding either, a generic projection, a buffer of any `copy`
// type, and a typed index whose parameter no field uses. Type arguments are
// inferred from arguments and from the expected type, or written after the
// name, as in `identity<i64>(70)`; a comparison in an argument list still
// compares.
//
// Expected output: 2, 2, 7, 7, 1, 9, 20, 30, 50, 60, 70 (the basics, with a
// type whose `>` is glued to a following `=`), 9, 11, 12, 2
// and 1 (`copy`, buffers and slots), 6 (a typed index), 3 and 6 (a generic
// list), then 7 and 1 (type arguments after a name, and comparisons), with
// every allocation freed.

import std::io

struct Pair<A, B> {
    first: A
    second: B
}

enum Maybe<T> {
    Some(value: T)
    None
}

struct Token {
    id: i64
}

struct Slot<T> {
    item: Maybe<T>
    count: i64
}

// `Index` is the prelude's now, so this one is a
// `Position`: where a value is in a list, typed by what the list holds.
struct Position<T> {
    at: i64
}

struct Node {
    value: i64
}

enum List<T> {
    Cons(head: T, tail: own<List<T>>)
    Nil
}

fn swap<T>(a: &var T, b: &var T) = {
    val t = move a
    a = move b
    b = move t
}

fn unwrapOr<T>(option: Maybe<T>, default: T): T = match move option {
    .Some(value) => move value
    .None => move default
}

fn first<T>(xs: &var [T]): &var T = lend xs[0]

fn identity<T>(x: T): T = move x

// A `copy` parameter is read without `move`.
fn largest<T: copy>(xs: &[T], weights: &[i64]): T = {
    var best = xs[0]
    var heaviest = weights[0]
    for i in 0..xs.len() {
        if weights[i] > heaviest {
            best = xs[i]
            heaviest = weights[i]
        }
    }
    best
}

fn fill<T: copy>(value: T, n: i64): own<[T]> = own [value; n]

fn put<T>(slot: &var Slot<T>, value: T) keeps value = {
    slot.item = .Some(move value)
    slot.count = slot.count + 1
}

fn take<T>(slot: &var Slot<T>): Maybe<T> = {
    val item = move slot.item
    slot.item = .None
    move item
}

fn countSome<T>(slots: &[Slot<T>]): i64 = {
    var n = 0
    for slot in slots {
        match slot.item {
            .Some(..) => n = n + 1
            .None => {}
        }
    }
    n
}

fn nodeAt(nodes: &[Node], index: Position<Node>): i64 = nodes[index.at].value

fn push<T>(list: own<List<T>>, value: T): own<List<T>> = own List::Cons(head: move value, tail: move list)

fn length<T>(list: &List<T>): i64 = match list {
    .Cons(tail, ..) => 1 + length(&tail)
    .Nil => 0
}

fn sum(list: &List<i64>): i64 = match list {
    .Cons(head, tail) => head + sum(&tail)
    .Nil => 0
}

fn both(a: bool, b: bool): i64 = if a && b { 1 } else { 0 }

fn main(): i64 = {
    var x = 1
    var y = 2
    swap(&var x, &var y)
    io::printInt(x)
    val p = Pair(first: x, second: true)
    io::printInt(p.first)
    val none: Maybe<i64> = .None
    // A type's `>` closes its arguments even where `>=` is one token.
    val tight: Maybe<i64>= .None
    val nested: Maybe<Maybe<i64>>= .None
    io::printInt(unwrapOr(none, 7))
    io::printInt(unwrapOr(tight, 7))
    io::printInt(if nested is .None { 1 } else { 0 })
    io::printInt(unwrapOr(Maybe::Some(9), 7))
    var a = own Token(id: 10)
    var b = own Token(id: 20)
    swap(&var a, &var b)
    io::printInt(a.id)
    val t = unwrapOr(.Some(own Token(id: 30)), own Token(id: 40))
    io::printInt(t.id)
    var xs = [5, 6, 7]
    first(&var xs) = 50
    io::printInt(xs[0])
    val q = Pair<i64, own<Token>>(first: 1, second: own Token(id: 60))
    io::printInt(q.second.id)
    io::printInt(identity<i64>(70))

    io::printInt(largest([3, 9, 4], [1, 5, 2]))
    val buffer = fill(1, 4)
    io::printInt(buffer.len() + buffer[3] * 7)
    var slot = Slot<own<Token>>(item: .None, count: 0)
    put(&var slot, own Token(id: 11))
    put(&var slot, own Token(id: 12))
    match take(&var slot) {
        .Some(value: token) => io::printInt(token.id)
        .None => io::printInt(-1)
    }
    io::printInt(slot.count)
    val slots = [Slot(item: Maybe::Some(1), count: 1), Slot(item: .None, count: 0)]
    io::printInt(countSome(&slots))

    val nodes = [Node(value: 5), Node(value: 6)]
    io::printInt(nodeAt(&nodes, Position<Node>(at: 1)))

    var numbers: own<List<i64>> = own .Nil
    numbers = push(move numbers, 1)
    numbers = push(move numbers, 2)
    numbers = push(move numbers, 3)
    io::printInt(length(&numbers))
    io::printInt(sum(&numbers))

    val nothing = Maybe<i64>::None
    io::printInt(unwrapOr(nothing, 7))
    val lo = 1
    val hi = 2
    io::printInt(both(lo < hi, hi > lo))
    0
}
