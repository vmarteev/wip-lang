// A generic function that keeps what a closure answers, given one that
// answers nothing: a vector of `void`, pushed to and dropped. Dropping it
// calls `destroy` on each element, whose argument is a `void` the code
// generator could not pass.
//
// Expected output: ran 1, ran 2, ran 3, then kept 3.

import std::io

fn each<T, R>(items: &[T], work: &(item: &T) => R): Vec<R> = {
	var answers: Vec<R> = Vec()
	for item in items {
		answers.push(work(&item))
	}
	return move answers
}

fn main() = {
	val numbers = [1, 2, 3]
	val done = each(&numbers, (n) => io::println("ran \(n)"))
	io::println("kept \(done.len())")
}
