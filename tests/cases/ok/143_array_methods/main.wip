// An array has a slice's methods: what they take is `&[T]`, and an array lends
// a slice of all of it — the same coercion an argument already had. So a
// slice's methods are there for an array as well as for a `Vec`.
//
// A `var` array may call a `var fn`, and a `val` array may not, which is
// the rule for a borrow anywhere else.
//
// Expected output: 3 false (the length and whether it is empty), 1 2 3
// (sorted), 3 2 1 (turned around), true .Some(1) (searching), true (a
// `val` array searched), and 6 (an array of structs, by a method of its
// own).

import std::io

@derive(Text)
struct Cell {
    weight: i64
}

fn main() = {
    var n = [3, 1, 2]
    io::println("\(n.len()) \(n.isEmpty())")

    n.sort()
    io::println("\(n[0]) \(n[1]) \(n[2])")

    n.reverse()
    io::println("\(n[0]) \(n[1]) \(n[2])")

    io::println("\(n.contains(2)) \(n.indexOf(2))")

    val fixed = [9, 8]
    io::println("\(fixed.contains(9))")

    // The elements may be anything the method's constraint allows.
    var cells = [Cell(weight: 4), Cell(weight: 2)]
    cells.swap(0, 1)
    io::printInt(cells[0].weight + cells[1].weight)
}
