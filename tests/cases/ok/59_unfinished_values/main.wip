// Leaving a value before it is finished. An argument, a
// field, an element or a payload that owns memory may be complete when a
// later one jumps away with `return`, `break` or `continue`; the jump drops
// it, and an `own` whose value could jump is not allocated until the value is
// complete. Every allocation is freed, which the leak check verifies.
//
// Expected output: 24.

import std::io

struct Token {
    id: i64
}

struct Pair {
    a: own<Token>
    b: i64
}

enum Slot {
    Two(a: own<Token>, b: own<Token>)
    None
}

fn take(t: own<Token>, n: i64): i64 = t.id + n

fn f(i: i64): i64 = {
    val p = Pair(a: own Token(id: i), b: if i == 3 { return 0 } else { 1 })
    p.b
}

fn g(i: i64): i64 = {
    val xs = [own Token(id: i), if i == 3 { return 0 } else { own Token(id: 1) }]
    1
}

fn h(i: i64): i64 = {
    val p = own Pair(a: own Token(id: i), b: 1 + if i == 3 { return 0 } else { 1 })
    p.b
}

fn k(i: i64): i64 = {
    val s = Slot::Two(a: own Token(id: i), b: if i == 3 { return 0 } else { own Token(id: 1) })
    2
}

fn main(): i64 = {
    var total = 0
    for i in 0..5 {
        total = total + f(i) + g(i) + h(i) + k(i)
        total = total + take(own Token(id: i), if i == 4 { continue } else { 1 })
        val p = Pair(a: own Token(id: i), b: if i == 2 { break } else { 1 })
    }
    io::printInt(total)
    0
}
