// A slice read through a reference — a constant's, or a parameter's — is
// held as the reference where a type parameter takes it, since a slice has
// no size of its own: `Some(bytes)` is an `Option<&[u8]>`, a vector it is
// pushed onto holds references, and a tuple holds the reference, alone or
// in an array of them, which a loop takes apart.
//
// Expected output:
// some 3
// same 3
// pushed 3 3
// pair 1 3
// a 3
// b 2
// paired 2 0
// x 0
// y 2

import std::io

val THREE: &[u8] = &[1, 2, 3]
val TWO: &[u8] = &[4, 5]

fn same<T>(value: T): T = value

/// Pairs made of a parameter's slice, and an array of them taken apart.
fn pairs(empty: &[u8], two: &[u8]) = {
	val pair = (2, empty)
	io::println("paired \(pair.0) \(pair.1.len())")
	for (name, bytes) in [("x", empty), ("y", two)] {
		io::println("\(name) \(bytes.len())")
	}
}

fn main() = {
	val some = Option::Some(THREE)
	io::println("some \(some.unwrap().len())")
	io::println("same \(same(THREE).len())")
	var pushed = Vec()
	pushed.push(THREE)
	pushed.push(THREE)
	io::println("pushed \(pushed[0].len()) \(pushed[1].len())")
	val pair = (1, THREE)
	io::println("pair \(pair.0) \(pair.1.len())")
	for (name, bytes) in [("a", THREE), ("b", TWO)] {
		io::println("\(name) \(bytes.len())")
	}
	val empty: Vec<u8> = Vec()
	pairs(&empty.items(), TWO)
}
