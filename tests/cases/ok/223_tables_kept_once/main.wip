// A constant table is kept once, in read-only data, and a use of it is
// the place it is kept in: read, indexed, searched,
// walked and lent where it lies, and copied to be changed. Each kind of
// part is laid out as it is anywhere else — numbers of each width, a
// `bool`, floats, a `char`, a `str` whose bytes are data of their own,
// structs, tuples, variants and arrays of arrays — and a table of another
// module is read from there, as is a private one an inlined function
// reads.

import std::io
import tables

view struct Known {
    key: str
    glyph: char
    colour: i64
}

enum Shape {
    Dot
    Round(radius: i64)
    Box(w: i32, h: i32)
}

view struct Mixed {
    flag: bool
    small: u8
    ratio: f32
    big: f64
    name: str
}

val NUMBERS: [i64; 5] = [1, 3, 5, 7, 9]
val TABLE: [Known; 3] = [
    Known(key: "c", glyph: 'é', colour: 0x111111),
    Known(key: "rs", glyph: 'π', colour: 0xDEA584),
    Known(key: "zig", glyph: 'z', colour: -1),
]
val SHAPES: [Shape; 3] = [.Dot, .Round(radius: 4), .Box(w: -2, h: 3)]
val PAIRS: [(i64, i64); 2] = [(0, 1), (-1, 0)]
val GRID: [[u8; 3]; 2] = [[1, 2, 3], [4, 5, 6]]
val ONE: Mixed = Mixed(flag: true, small: 200, ratio: 1.5, big: -2.25, name: "mixed")
val MAYBE: Option<i64> = .Some(42)
val FOR_C: [cstring; 2] = ["ab", "cde"]
// A bare variant is not a table: it is written where it is used.
val FIRST: Shape = .Dot

fn area(shape: &Shape): i64 = match shape {
    .Dot => 0
    .Round(radius) => radius * radius * 3
    .Box(w, h) => (w * h) as i64
}

fn main() = {
    io::println("\(NUMBERS) \(NUMBERS.len()) \(NUMBERS[2]) \(NUMBERS.binarySearch(7))")
    for known in TABLE {
        io::println("\(known.key) \(known.glyph) \(known.colour)")
    }
    val sought = "rs"
    val found = TABLE.binarySearchBy((k: &Known) => k.key.compare(&sought))
    io::println("\(found)")
    io::println("\(area(FIRST))")
    for shape in SHAPES {
        io::println("\(area(&shape))")
    }
    io::println("\(PAIRS[1].0) \(PAIRS[1].1) \(GRID[1][2]) \(GRID)")
    io::println("\(ONE.flag) \(ONE.small) \(ONE.ratio) \(ONE.big) \(ONE.name)")
    io::println("\(MAYBE) \(FOR_C[1])")
    var copy = NUMBERS
    copy[0] = 100
    io::println("\(copy) \(NUMBERS)")
    io::println("\(total(&NUMBERS[1..3]))")
    io::println("\(tables::SQUARES[3]) \(tables::square(2)) \(tables::side(1)) \(tables::SQUARES)")
}

fn total(values: &[i64]): i64 = values.fold(0, (sum, v) => sum + v)
