// A module of bindings that nobody wrote by hand: `shapes/shapes.wip` was
// written by `wip bindgen` from `shapes/shapes.h` and committed beside it,
// which is how bindings to a real library would arrive:
//
//     wip bindgen shapes.h --module shapes -o shapes/shapes.wip
//
// What it read from the header is every shape the tool writes: a struct, a
// union, a handle whose contents C keeps to itself, a struct with bitfields
// that only C can lay out, an enum, three macro constants, a variable, a
// variadic function, a `static inline` one and one that takes a function
// pointer, which C calls back — and the constants clang
// works out: a float, arithmetic, an enumerator's second name and two
// structs. What it could not write — a function's second
// name — it says so at the end of the file rather than leaving it out
// quietly.
//
// Expected output: what C computed from a struct Wip lent it; the sum of a
// struct passed by value to an inline function; the constants; and the
// bitfields of a style C made, read and written through C.

import shapes
import std::io

/// What C's `canvas_sort` compares with: two `int`s it points to.
fn compare(a: ptr<void>, b: ptr<void>): c_int = {
    val left = (a as ptr<c_int>)[0]
    val right = (b as ptr<c_int>)[0]
    return if left < right { -1 as c_int } else if left > right { 1 as c_int } else { 0 as c_int }
}

fn main() = {
    val canvas = shapes::canvas_new(10 as c_int, 4 as c_int)
    val at = shapes::Point(x: 1 as c_int, y: 2 as c_int)
    io::println("drew \(shapes::canvas_draw(canvas, &at, 2.0))")
    io::println("sum \(shapes::point_sum(at))")
    io::println("version \(shapes::SHAPES_VERSION), name \(shapes::SHAPES_NAME), mask \(shapes::SHAPES_MASK)")
    io::println("corner \(shapes::BOTTOM_LEFT), errors \(shapes::shapes_errors)")
    io::println("scale \(shapes::SHAPES_SCALE), half \(shapes::SHAPES_HALF), first \(shapes::SHAPES_FIRST), last \(shapes::SHAPES_LAST)")
    val corner = shapes::SHAPES_CORNER
    io::println("origin \(shapes::SHAPES_ORIGIN.x), corner \(corner.x) \(corner.y), sum \(shapes::point_sum(corner))")

    val style = shapes::style_new()
    io::println("weight \(style.weight), family \(style.family.toStr())")
    style.weight = 5 as c_uint
    io::println("weight now \(style.weight)")

    io::println("sorted \(shapes::canvas_sort(canvas, compare))")
    shapes::canvas_free(canvas)
}
