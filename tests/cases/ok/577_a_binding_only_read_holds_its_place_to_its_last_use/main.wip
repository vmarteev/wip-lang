// A binding of a pattern on a place that owns memory, and is only read,
// holds the place to its last use: after that, the place may be assigned,
// or lent as `&var`, in the same arm or block. Each form: a `match`, an
// `is` test in a condition, in a chain and in a `while`, and `val … else`.
//
// Expected output:
// talking to Ada, row 2
// saving to slot1.json
// said: saved
// 3 letters
// cleared: true
// 2 left

import std::io

struct Talk {
    who: String
    at: i64
}

struct Game {
    talking: Option<Talk>
    said: String
    savesTo: Option<String>
}

extend Game {
    var fn say(text: str) = {
        self.said = String::of(text)
    }

    var fn step() = {
        if self.talking is .Some(talk) {
            io::println("talking to \(talk.who), row \(talk.at + 1)")
            self.say("row")
        }
        val .Some(path) = self.savesTo else return
        io::println("saving to \(path)")
        self.say("saved")
        io::println("said: \(self.said)")
        match self.talking {
            .Some(talk) => {
                val letters = talk.who.len()
                self.talking = .None
                io::println("\(letters) letters")
            }
            .None => {}
        }
    }
}

fn main() = {
    var game = Game(
        talking: .Some(Talk(who: String::of("Ada"), at: 1)),
        said: String::of(""),
        savesTo: .Some(String::of("slot1.json")),
    )
    game.step()
    assert(game.talking.isNone())

    var named: Option<String> = .Some(String::of("x"))
    val cleared = named is .Some(w) && w.len() == 1 && {
        named = .None
        true
    }
    io::println("cleared: \(cleared)")

    var queue: Vec<String> = Vec::of([String::of("a"), String::of("b"), String::of("c")])
    var first: Option<String> = .Some(String::of("a"))
    while first is .Some(name) {
        val wanted = name.len() == 1
        first = .None
        if wanted then queue.remove(0)
    }
    io::println("\(queue.len()) left")
}
