// An operator may have another type on the other side.
// `Multiply<f32>` scales a vector, and `f32`'s implementation for it,
// written in the vector's module, scales it from the left; a number beside
// the vector is what the implementation takes. What the answer is, is the
// implementation's to say: metres over seconds is a speed. Arguments left
// out are what the interface's defaults say, so `extend Vec2: Add` is
// `Add<Vec2, Vec2>`, and so is the constraint `T: Add`; a constraint may
// name the other side, `T: Multiply<f32>`. `a *= b` asks for the
// implementation that takes the type of `b` and answers the type of `a`.
//
// Expected output: the vector halved and doubled; scaled by 3 from either
// side, and multiplied by itself; added to itself doubled, summed, and
// scaled twice through a constraint; scaled in place by 4 and added to; and
// 100 metres in 8 seconds as 12.5.

import std::io

@derive(Text)
struct Vec2 {
    x: f32
    y: f32
}

extend Vec2: Add {
    fn add(other: &Vec2): Vec2 = Vec2(x: self.x + other.x, y: self.y + other.y)
}

extend Vec2: Multiply<f32> {
    fn multiply(other: &f32): Vec2 = Vec2(x: self.x * other, y: self.y * other)
}

extend Vec2: Multiply {
    fn multiply(other: &Vec2): Vec2 = Vec2(x: self.x * other.x, y: self.y * other.y)
}

extend f32: Multiply<Vec2, Vec2> {
    fn multiply(other: &Vec2): Vec2 = other * self
}

struct Meters {
    n: f64
}

struct Seconds {
    n: f64
}

struct Speed {
    n: f64
}

extend Meters: Divide<Seconds, Speed> {
    fn divide(other: &Seconds): Speed = Speed(n: self.n / other.n)
}

fn sum<T: Add>(a: T, b: T): T = a + b

fn scaledTwice<T: Multiply<f32>>(v: T): T = v * 2.0 * 2.0

fn main() = {
    val v = Vec2(x: 1.0, y: 2.0)
    io::println("\(v * 0.5) \(2.0 * v)")
    val scale: f32 = 3.0
    io::println("\(v * scale) \(scale * v) \(v * v)")
    io::println("\(v + v * 2.0) \(sum(v, v)) \(scaledTwice(v))")
    var w = v
    w *= 4.0
    w += v
    io::println("\(w)")
    val speed = Meters(n: 100.0) / Seconds(n: 8.0)
    io::println("\(speed.n)")
}
