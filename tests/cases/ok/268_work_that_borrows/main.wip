// Work on threads that borrows: `together` runs two
// closures at once and answers once both are done, so each may borrow what
// is around it; `each` and `map` split a slice among the processors;
// `Atomic` and `Mutex` are what several threads may change at once.
//
// Expected output: the halves' sums, 10 and 26; every cell doubled and
// counted once, 20000 and 10000; the squares; the mailbox's 5050, taken by
// a worker that waited for it; a slice changed in two parts; and 15, an
// atomic added to while the program was compiled.

import std::io
import std::future
import std::sync::{Atomic, Mutex}

fn sum(values: &[i64]): i64 = {
	var total = 0
	for value in values {
		total += value
	}
	return total
}

struct Mailbox {
	pending: Vec<i64>
	closed: bool
}

// Takes what is sent until the mailbox is closed and empty.
fn worker(mailbox: &Mutex<Mailbox>): i64 = {
	var total = 0
	var open = true
	while open {
		mailbox.lockWhen(
			(box) => !box.pending.isEmpty() || box.closed,
			(box) => {
				while box.pending.pop() is .Some(value) {
					total += value
				}
				open = !box.closed
			},
		)
	}
	return total
}

fn sender(mailbox: &Mutex<Mailbox>) = {
	for value in 1..=100 {
		mailbox.lock((box) => box.pending.push(value))
	}
	mailbox.lock((box) => { box.closed = true })
}

@comptime
val COUNTED: i64 = counted()

fn counted(): i64 = {
	val count = Atomic::of(5 as i64)
	count.add(10)
	return count.load()
}

fn main() = {
	val numbers = [1, 2, 3, 4, 5, 6, 7, 8]
	val (low, high) = future::together(() => sum(&numbers[0..4]), () => sum(&numbers[4..]))
	io::println("\(low) \(high)")

	val counter = Atomic::of(0 as i64)
	var cells = Vec::filled(10000, 1 as i64)
	future::each(&var cells.items(), (cell) => {
		cell *= 2
		counter.add(1)
	})
	io::println("\(sum(&cells.items())) \(counter.load())")

	val squares = future::map(&numbers, (n) => n * n)
	io::println("\(squares[0]) \(squares[7]) \(squares.len())")

	val mailbox = Mutex::of(Mailbox(pending: Vec(), closed: false))
	val (total, _) = future::together(() => worker(&mailbox), () => sender(&mailbox))
	io::println("\(total)")

	var parts = [1, 2, 3, 4]
	parts.split(2, (first, second) => {
		first[0] = 10
		second[1] = 40
	})
	io::println("\(parts[0]) \(parts[1]) \(parts[2]) \(parts[3]) \(COUNTED)")
}
