// The formats a table is written in, and the one this module gives.

pub interface Format {
	fn row(cells: &[str]): String
}

pub struct Plain

extend Plain: Format {
	fn row(cells: &[str]): String = cells.join(" ")
}

/// Each row, in the format given, a line each.
pub fn render(format: &dyn Format, rows: &[[str; 2]]): String = {
	var out = String()
	for cells in rows {
		out.push(format.row(&cells))
		out.push("\n")
	}
	return move out
}
