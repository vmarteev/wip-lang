// An interface another module exports is imported by name, as a type is,
// and named by its path where an interface is named: a constraint, `dyn`,
// and the interface an `extend` block implements. A type of this module
// implements it, and is given where the other module asks for one. The
// import once found every kind of item but an interface, and a path took
// one name there.
//
// Expected output: the two rows with spaces, then with commas; the first
// row with commas, then with spaces; then 7 and 2.

import std::io
import std::sync::{Atomic, AtomicInteger, AtomicValue}
import formats
import formats::{Format, Plain}
import formats::{Format as Layout}

struct Csv

extend Csv: formats::Format {
	fn row(cells: &[str]): String = cells.join(",")
}

val ROWS: [[str; 2]; 2] = [["Wip", "2026"], ["C", "1972"]]

/// The first row, in any format: a constraint on an imported interface.
fn heading<F: Format>(format: &F): String = format.row(&ROWS[0])

/// The same, through the interface's path and behind `dyn`.
fn heading2(format: &dyn formats::Format): String = format.row(&ROWS[0])

/// And under the name it was imported as.
fn width<L: Layout>(layout: &L): i64 = layout.row(&ROWS[1]).len()

/// `std::sync`'s own interfaces, which say what an atomic may hold.
fn current<T: AtomicValue + copy>(cell: &Atomic<T>): T = cell.load()

fn bumped<T: AtomicValue + AtomicInteger + copy>(cell: &Atomic<T>, by: T): T = {
	cell.add(by)
	return cell.load()
}

fn main() = {
	io::print(formats::render(Plain(), &ROWS))
	io::print(formats::render(Csv(), &ROWS))
	io::println(heading(Csv()))
	io::println(heading2(Plain()))
	assert(width(Csv()) == 6)
	// A method of an implemented interface is found without an import.
	assert(Csv().row(&ROWS[1]) == "C,1972")
	val hits = Atomic::of(5)
	io::printInt(bumped(&hits, 2))
	val flag = Atomic::of(2)
	io::printInt(current(&flag))
}
