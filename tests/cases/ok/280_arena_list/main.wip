// The doubly linked list of ok/44, in an arena: the
// arena keeps the free slots, and a handle to a node removed is caught,
// where ok/44's index `two` read the node that took its slot.
//
// Expected output: 1 3 4 forwards, then 4 3 1 backwards, then 0, since
// `two` names nothing once its node is removed.

import std::io
import std::collections::{Arena, Handle}

struct Node {
	value: i64
	prev: Option<Handle<Node>>
	next: Option<Handle<Node>>
}

struct List {
	nodes: Arena<Node> = Arena()
	head: Option<Handle<Node>> = .None
	tail: Option<Handle<Node>> = .None
}

extend List {
	var fn pushBack(value: i64): Handle<Node> = {
		val node = self.nodes.add(Node(value: value, prev: self.tail, next: .None))
		match self.tail {
			.Some(last) => self.nodes[last].next = .Some(node)
			.None => self.head = .Some(node)
		}
		self.tail = .Some(node)
		return node
	}

	var fn remove(node: Handle<Node>) = {
		val .Some(gone) = self.nodes.remove(node) else {
			return
		}
		match gone.prev {
			.Some(before) => self.nodes[before].next = gone.next
			.None => self.head = gone.next
		}
		match gone.next {
			.Some(after) => self.nodes[after].prev = gone.prev
			.None => self.tail = gone.prev
		}
	}

	fn printForwards() = {
		var at = self.head
		while at is .Some(node) {
			io::printInt(self.nodes[node].value)
			at = self.nodes[node].next
		}
	}

	fn printBackwards() = {
		var at = self.tail
		while at is .Some(node) {
			io::printInt(self.nodes[node].value)
			at = self.nodes[node].prev
		}
	}
}

fn main() = {
	var list = List()
	list.pushBack(1)
	val two = list.pushBack(2)
	list.pushBack(3)
	list.remove(two)
	list.pushBack(4)
	list.printForwards()
	list.printBackwards()
	io::printInt(if list.nodes.contains(two) { 1 } else { 0 })
}
