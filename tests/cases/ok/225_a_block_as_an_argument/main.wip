// A block that is a call's argument answers the argument's value: once it has
// left the block, it is lent as a `str` where a `String` is given, and for the
// call where a `&` is taken, as the argument would be. An interpolated literal
// is such a block, and so is one a program writes.

import std::io

struct Point {
    x: i64
}

fn across(p: &Point): i64 = p.x

fn main() = {
    val n = 3
    io::println("\(n) points")
    io::println({
        val made = String::of("made in a block")
        move made
    })
    val x = across({
        val step = 2
        Point(x: step * 5)
    })
    io::println("\(x)")
}
