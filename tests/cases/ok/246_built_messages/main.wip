// A panic's message and an assert's note may be built, and are built only
// when the check fails.

import std::io

fn described(n: i64): String = {
	io::println("described \(n)")
	return "n is \(n)"
}

fn main() = {
	val tick = 1300
	// These hold, so their notes are never built.
	assert(tick > 0, described(tick))
	assert(tick > 0, "tick \(tick)")
	val fixed: str = "a note in a variable"
	assert(tick > 0, fixed)
	io::println("every check held")
	assert(tick < 1000, "the replay parts by tick \(tick)")
}
