// What a move leaves is zeroes, and a value that cleans up after itself
// with a `destroy` of its own must not be dropped as those zeroes: it
// would run on nothing. Three places did:
//
// - a local moved away and then assigned to: the assignment dropped the
//   old value, which was gone;
// - `self` moved out and put back in a `var fn`, as `Option.take` does:
//   `take` on an `Option<Sender<T>>` ran a sender's `destroy` on nothing;
// - a field moved out of a local, `going.work.get()`: the local's drop
//   dropped the field again.
//
// Each drops now only what is there.
//
// Expected output, one a line: "moved", "assigned", "destroy 1",
// "destroy 2", "took", "destroy 5", "destroy 6", "destroy 10",
// "consumed 10", "destroy 20", "destroy 21", "destroy 11", "done",
// "destroy 3" — each value once, the newest local first, and `consume`'s
// before the line that prints what it answered.

import std::io

struct Loud {
    n: i64
}

extend Loud: Destroy {
    var fn destroy() = io::println("destroy \(self.n)")
}

extend Loud {
    move fn consume(): i64 = self.n
}

struct Pair {
    a: Loud
    b: Loud
}

fn assignedAfterMove() = {
    var o: Option<Loud> = .Some(Loud(n: 1))
    val t = move o
    io::println("moved")
    o = .Some(Loud(n: 2))
    io::println("assigned")
}

fn takenAndReplaced() = {
    var empty: Option<Loud> = .None
    val nothing = empty.take()
    io::println("took")
    var held: Option<Loud> = .Some(Loud(n: 5))
    val old = held.replace(Loud(n: 6))
    assert(nothing.isNone() && old.isSome())
}

fn fieldsMovedOut() = {
    var i = 0
    while i < 2 {
        val pair = Pair(a: Loud(n: 10 + i), b: Loud(n: 20 + i))
        if i == 0 {
            io::println("consumed \(pair.a.consume())")
        }
        i += 1
    }
}

fn main() = {
    assignedAfterMove()
    takenAndReplaced()
    fieldsMovedOut()
    val last = Loud(n: 3)
    io::println("done")
}
