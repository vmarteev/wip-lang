// A method that says `empties` leaves its receiver holding no view, so a
// list of views kept from one line to the next is emptied and filled again
// while the line it borrowed changes. The body is held to it: a field
// assigned a value that borrows nothing, a field of a field, the whole
// receiver given a new value, and a call to a method that empties, on one
// path or every path; and an interface's method that says it, called
// through the interface.
//
// Expected output:
// 6 6 6 6
// 6

import std::io

view struct Words {
	words: Vec<str> = Vec()
	count: i64 = 0
}

extend Words {
	var fn add(word: str) keeps word = {
		self.words.push(word)
		self.count += 1
	}

	var fn clear() empties = {
		self.words = Vec()
		self.count = 0
	}

	var fn takeAll(): Vec<str> empties = {
		val all = self.words
		self.words = Vec()
		self.count = 0
		return all
	}
}

view struct Row {
	entries: Vec<str> = Vec()
}

view struct Table {
	row: Row = Row()
	rounds: i64 = 0
}

extend Table {
	var fn clear() empties = {
		self.rounds += 1
		self.row.entries = Vec()
	}
}

view struct Pair {
	left: Words = Words()
	right: Words = Words()
}

extend Pair {
	var fn clear() empties = {
		self.left.clear()
		if self.right.count > 0 then self.right.clear() else self = Pair()
	}
}

interface Emptying {
	var fn clear() empties
	var fn put(word: str) keeps word
	fn size(): i64
}

view struct Bag {
	items: Vec<str> = Vec()
}

extend Bag: Emptying {
	var fn clear() empties = {
		self.items = Vec()
	}

	var fn put(word: str) keeps word = self.items.push(word)

	fn size(): i64 = self.items.len()
}

fn refill<E: Emptying>(into: &var E, line: str): i64 keeps line = {
	into.clear()
	for word in line.split(" ") {
		into.put(word)
	}
	return into.size()
}

fn main() = {
	val lines = ["a b c", "d e", "f"]
	var line = String()
	var words = Words()
	var table = Table()
	var pair = Pair()
	var taken = 0
	var counts = [0, 0, 0, 0]
	for text in lines {
		words.clear()
		table.clear()
		pair.clear()
		line.clear()
		line.push(text)
		for word in line.toStr().split(" ") {
			words.add(word)
			table.row.entries.push(word)
			pair.left.add(word)
			pair.right.add(word)
		}
		counts[0] += words.count
		counts[1] += table.row.entries.len()
		counts[2] += pair.left.count
		counts[3] += pair.right.count
		taken += words.takeAll().len()
	}
	io::println("\(counts[0]) \(counts[1]) \(counts[2]) \(counts[3])")

	var generic = Bag()
	var total = 0
	for text in lines {
		line.clear()
		line.push(text)
		total += refill(&var generic, line.toStr())
	}
	assert(taken == 6)
	io::println("\(total)")
}
