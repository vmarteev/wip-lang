// A set of keys: `Map` without the values. Its keys lie one after another in
// the order they were added, so `for key in set` walks a slice, and `add`
// answers whether the key was new — which is what deduplicating is written
// with.
//
// Expected output: true and false (a key added twice), 50 keys with 7 among
// them and 99 not, 49 after a removal, 1218 (the rest walked and added up),
// three words kept out of five, and an empty set, with every allocation
// freed.

import std::io
import std::collections::{Set}

@derive(Eq, Hash)
struct Cell {
    row: i64
    column: i64
}

fn main() = {
    var seen = Set<i64>()
    io::println("added \(seen.add(1)), again \(seen.add(1))")

    var i = 0
    while i < 50 {
        seen.add(i)
        i += 1
    }
    io::println("\(seen.len()) keys, has 7 \(seen.contains(7)), has 99 \(seen.contains(99))")

    io::println("removed \(seen.remove(7)), again \(seen.remove(7)), left \(seen.len())")
    var total = 0
    for key in seen {
        total += key
    }
    io::printInt(total)

    // Keys that own memory, and what a set is for.
    val words = ["one", "two", "one", "three", "two"]
    var distinct = Set<String>()
    for word in words {
        distinct.add(String::of(word))
    }
    var listed = String()
    for word in distinct {
        listed.push(word.toStr())
        listed.push(" ")
    }
    io::println("\(distinct.len()): \(listed.toStr())")

    // A struct of its own as a key, hashed by `@derive(Hash)`.
    var board = Set<Cell>()
    board.add(Cell(row: 1, column: 2))
    io::println("cell \(board.contains(Cell(row: 1, column: 2))), \(board.contains(Cell(row: 2, column: 1)))")

    distinct.clear()
    io::println("cleared \(distinct.len()), empty \(distinct.isEmpty())")
}
