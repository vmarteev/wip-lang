// `extern struct`: a layout C writes too. Its fields are the types C can hold,
// it has no type parameters, and it crosses behind `&` or `&var`, which pass
// `const T *` and `T *`. By value it waits for the shims of item 7, since
// Cranelift would pass a pointer where C passes the fields.
//
// The C beside it computes `sizeof` and `offsetof` itself, so the case
// fails if the two ever disagree about the layout.
//
// Expected output: area 12; then 5 by 6 and area 30, after C grew it; then
// size 16 and offset 12, which is what C says of its own struct.

import std::io

extern struct Rect {
    x: c_int,
    y: c_int,
    width: c_int,
    height: c_int
}

extern "C" {
    fn area(r: &Rect): i64
    fn grow(r: &var Rect, by: c_int)
    fn size_of_rect(): i64
    fn offset_of_height(): i64
}

fn main() = {
    var r = Rect(x: 1, y: 2, width: 3, height: 4)
    io::println("area \(area(&r))")

    grow(&var r, 2)
    io::println("\(r.width) by \(r.height), area \(area(&r))")

    io::println("size \(size_of_rect()) offset \(offset_of_height())")
}
