// Methods on built-in types. The prelude declares what `i64`,
// `str` and `[T]` can do — `extend i64 { … }`, `extend [T] { … }` — and a
// program may implement its own interface for one, since the interface is
// its own and no two modules can disagree about what the method means.
//
// Expected output: 7, -7 and 3 (the prelude's `abs`, `min` and `max`), 1 and
// 0 (`isEmpty` on a string and on a slice, through a reference), 42 (a
// program's own interface, called directly), 42 again (through `&dyn`), and
// 6 (through a type parameter that asks for it).

import std::io

interface Doubled {
    fn twice(): i64
}

extend i64: Doubled {
    fn twice(): i64 = self * 2
}

fn empty(xs: &[i64]): bool = xs.isEmpty()

fn through(value: &dyn Doubled): i64 = value.twice()

fn constrained<T: Doubled>(value: T): i64 = value.twice()

fn main() = {
    val n = -7
    io::printInt(n.abs())
    io::printInt(n.min(3))
    io::printInt(n.max(3))

    val text = "hello"
    if text.isEmpty() { io::printInt(0) } else { io::printInt(1) }

    val nothing: [i64; 0] = []
    if empty(&nothing) { io::printInt(0) } else { io::printInt(1) }

    val value = 21
    io::printInt(value.twice())
    io::printInt(through(&value))
    io::printInt(constrained<i64>(3))
}
