// `c::fieldsOf<T>()` is each field of a struct, in the order it is
// declared, as C lays it out: its name, where it lies, how many bytes it
// takes, and the numbers it is made of where it is numbers of one kind
// with no bytes between them. A number, a vector, an array of numbers and a
// struct of them are numbers; a struct with padding, a `bool`, an enum and
// what owns memory are not. `@align` moves a field, and in a `@packed`
// struct each lies right after the one before. The program keeps one table
// a struct, which a top-level `assert` reads while the program is built.
//
// Expected output:
// position 0 12 3 F32
// count 16 8 1 I64
// colour 24 4 4 U8
// pair 28 8 -
// shown 36 1 -
// name 40 24 -
// normal 64 8 2 F32
// kind 0 1 1 U8
// length 1 4 1 U32
// flags 5 2 1 U16
// the same table: true

import std::c
import std::io
import std::math::{Vec2, Vec3}

struct Padded {
    small: u8
    large: u32
}

struct Kinds {
    position: Vec3
    count: i64
    colour: [u8; 4]
    pair: Padded
    shown: bool
    name: String
    @align(16) normal: Vec2
}

@packed
struct Header {
    kind: u8
    length: u32
    flags: u16
}

assert(c::fieldsOf<Kinds>().len() == 7, "every field, in order")
assert(c::fieldsOf<Kinds>()[6].offset == 64, "`@align` moves a field")

fn shown(fields: &[c::Field]) = {
    for field in fields {
        val numbers = match field.numbers {
            .Some((scalar, count)) => "\(count) \(scalar.name())"
            .None => "-"
        }
        io::println("\(field.name) \(field.offset) \(field.size) \(numbers)")
    }
}

fn main() = {
    shown(&c::fieldsOf<Kinds>())
    shown(&c::fieldsOf<Header>())
    val once = c::fieldsOf<Header>()
    val again = c::fieldsOf<Header>()
    io::println("the same table: \(c::pointerTo(&once) == c::pointerTo(&again))")
}
