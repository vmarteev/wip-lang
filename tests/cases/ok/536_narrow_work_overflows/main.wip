// An operation is done in its operands' type: a sum of two `u8`s widened
// to a `u32` is added as `u8`s first, and panics where it does not fit, as
// any `u8` sum does; one operand widened first adds as `u32`s.
//
// Expected output: 300, then the panic, on standard error, with status
// 101.

import std::io

fn main() = {
    val a: u8 = 200
    val b: u8 = 100
    val wide: u32 = (a as u32) + b
    io::println("\(wide)")
    val narrow: u32 = (a + b) as u32
    io::println("\(narrow)")
}
