// An owned `dyn`: values of several types, each known by an interface it
// implements, kept where an `own` is — a vector, a field, an `Option`, a
// map — called through, written through by a `var fn`, lent as a `&dyn`
// and a `&var dyn`, moved, returned, assigned over, ended early, and
// worked out in a constant. Each value ends where an `own` of its type
// would, its `Destroy` run through the table its `dyn` carries.
//
// Expected output: 3, 2, square 12, a, ended early, after destroy, 9,
// ended map, ended a, ended a, ended popped.

import std::collections::{Map}
import std::io

interface Shape {
    fn area(): i64
    fn name(): String
    var fn grow(by: i64)
}

struct Square {
    side: i64
}

extend Square: Shape {
    fn area(): i64 = self.side * self.side
    fn name(): String = "square \(self.side)"
    var fn grow(by: i64) = self.side += by
}

struct Tagged {
    tags: Vec<String>
    width: i64
}

extend Tagged: Shape {
    fn area(): i64 = self.width
    fn name(): String = self.tags.join("+")
    var fn grow(by: i64) = self.tags.push("grown")
}

extend Tagged: Destroy {
    var fn destroy() = io::println("ended \(self.tags.join(","))")
}

struct Scene {
    main: own<dyn Shape>
    extra: Option<own<dyn Shape>> = .None
}

/// Either kind, as an owned `dyn`.
fn make(big: bool, tag: str): own<dyn Shape> =
    if big then own Square(side: 10) else own Tagged(tags: [tag], width: 1)

fn consume(shape: own<dyn Shape>): i64 = shape.area()

fn total(shapes: &Vec<own<dyn Shape>>): i64 = {
    var sum = 0
    for shape in shapes do
        sum += shape.area()

    return sum
}

fn areaOf(shape: &dyn Shape): i64 = shape.area()

fn growIt(shape: &var dyn Shape) = shape.grow(2)

fn areaOfThree(): i64 = {
    val shape: own<dyn Shape> = own Square(side: 3)
    return shape.area()
}

@comptime
val AREA: i64 = areaOfThree()

fn main() = {
    var shapes: Vec<own<dyn Shape>> = Vec()
    shapes.push(own Square(side: 1))
    shapes.push(own Tagged(tags: ["popped"], width: 2))
    io::printInt(total(&shapes))
    io::printInt(areaOf(&shapes[1]))
    var scene = Scene(main: make(true, ""))
    growIt(&var scene.main)
    io::println(scene.main.name())
    scene.extra = make(false, "a")
    if scene.extra is .Some(extra) then
        io::println(extra.name())

    scene.main = make(false, "a")
    var named: Map<String, own<dyn Shape>> = Map()
    named.put("s", own Square(side: 2))
    named.put("t", own Tagged(tags: ["map"], width: 7))
    assert(named.at("s").area() == 4)
    assert(consume(make(true, "")) == 100)
    val early: own<dyn Shape> = own Tagged(tags: ["early"], width: 3)
    destroy(early)
    io::println("after destroy")
    io::printInt(AREA)
}
