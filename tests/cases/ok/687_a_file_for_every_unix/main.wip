// A file may be for every Unix, `.unix.wip`, beside one for Windows, and
// an item may say its family: `@target(family = "unix")`. A Mac, iOS and
// Linux are each a Unix, and Windows is not.
//
// Expected output:
// the family is the target's: true
// the calls are the family's: true

import std::io

@target(family = "unix")
val FAMILY: str = "unix"

@target(family = "windows")
val FAMILY: str = "windows"

fn main() = {
	io::println("the family is the target's: \(FAMILY == TARGET_FAMILY)")
	io::println("the calls are the family's: \(calls() == (TARGET_FAMILY == "unix"))")
}
