// `@derive(Text)` written as code the checker checks: the
// value as the literal that would make it, each field written by whatever
// implementation its type has — a `Vec<i64>`, an array, a parameter's
// type — so a `Free<T>` is written where `T` is.

import std::io

@derive(Text)
struct Holder {
    items: Vec<i64>
    cells: [u8; 2]
    on: bool
    ratio: f64
    letter: char
}

@derive(Text)
enum Shape {
    Circle(r: i64, labels: Vec<String>)
    Dot
}

@derive(Text)
struct Free<T> {
    value: T
}

@derive(Text)
struct Empty {}

@derive(Text)
struct Nested {
    shape: Shape
    free: Free<Shape>
    grid: [[i64; 2]; 2]
}

fn main() = {
    val holder = Holder(items: Vec::of(own [1, 2]), cells: [3, 4], on: true, ratio: 0.5, letter: 'q')
    io::println("\(holder)")
    var labels: Vec<String> = Vec()
    labels.push("big")
    io::println("\(Shape::Dot) \(Shape::Circle(r: 2, labels: move labels))")
    io::println("\(Free(value: "x")) \(Free(value: 7)) \(Empty())")
    io::println("\(Nested(shape: .Dot, free: Free(value: .Dot), grid: [[1, 2], [3, 4]]))")
    io::println("\([1, 2, 3]) \(Vec::of(own [[1], [2]]))")
}
