// Text where a `String` is expected is copied into a new `String`, as a
// literal is: a struct's field, a variant's, an argument by position and
// by name, what a function answers, an element pushed, a map's key, a
// variable declared or assigned, `Some` of an `Option<String>`, and each
// branch of an `if` and a `match`, beside a literal in another. The text
// may be a parameter, a call's answer or a range. The copy owns its bytes,
// so the `String` it was taken from may change while the copy is kept;
// where nothing expects a `String`, text stays a `str`. The case runs with
// the leak check on.
//
// Expected output: each value, one to a line, then `kept abc`, `4`, and
// `str`.

import std::collections::{Map}
import std::io

struct Dialog {
	title: String
	width: i64
}

enum Shown {
	Problem(title: String, text: String)
	Nothing
}

fn named(name: String): String = move name

fn answered(text: str): String = text

fn trimmed(text: str): String = {
	return text.trim()
}

fn either(first: bool, text: str): String = if first then "first" else text

fn chosen(n: i64, text: str): String = match n {
	0 => "zero"
	_ => text
}

fn kindOf(text: str): str = "str"

fn show(words: str) = {
	val dialog = Dialog(title: words, width: 3)
	io::println(dialog.title)
	val shown: Shown = .Problem(title: words, text: words[0..2])
	if shown is .Problem(title, text) {
		io::println("\(title) \(text)")
	}
	io::println(named(words))
	io::println(named(name: words))
	io::println(answered(words))
	io::println(trimmed("  trimmed  "))
	io::println(either(false, words))
	io::println(chosen(1, words))
	var list: Vec<String> = Vec()
	for word in words.split(" ") {
		list.push(word)
	}
	io::println(list[1])
	var counts: Map<String, i64> = Map()
	counts.put(list[0].toStr()[0..3], 1)
	io::println("\(counts.at("for"))")
	var later: String = words
	io::println(later)
	later = words[4..7]
	io::println(later)
	val maybe: Option<String> = .Some(words)
	if maybe is .Some(text) {
		io::println(text)
	}
}

fn main() = {
	show("for the copy")
	var source: String = "abcdef"
	val kept: String = source.toStr()[0..3]
	source.push("!")
	io::println("kept \(kept)")
	val plain = "a view"
	io::println("\(plain.len() - 2)")
	io::println(kindOf(plain))
}
