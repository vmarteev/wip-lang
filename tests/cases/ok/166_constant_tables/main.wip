// A top-level `val` may be a table: an array, a struct or
// a tuple, or a variant, of constants. Each use is the value, made where
// it is used, as a number's is.

import std::io

enum BallColor {
    Red
    Green
    Blue
}

val COLORS = [BallColor::Red, BallColor::Green, BallColor::Blue]
val FILES = ["balls/red.png", "balls/green.png", "balls/blue.png"]
val DIRECTIONS: [(i64, i64); 4] = [(0, 1), (1, 0), (1, 1), (1, -1)]
val PRECEDENCE: [i64; 3] = [1, 2, 3]
val SIZE: i64 = 3
val ZEROS: [i64; SIZE] = [0; 3]
val MAYBE: Option<i64> = .Some(4)

fn main() = {
    for (dr, dc) in DIRECTIONS {
        io::println("\(dr) \(dc)")
    }
    io::println("\(COLORS[1] as i64) \(FILES[2]) \(PRECEDENCE[0] + ZEROS[2]) \(MAYBE)")
    io::printInt(COLORS.len())
}
