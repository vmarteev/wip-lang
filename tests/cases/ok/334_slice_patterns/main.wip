// The elements of an array or a slice taken apart from either end:
// `[a, b]` is exactly two, `[first, ..rest]` one or more,
// and `..rest` binds those between as a slice.

import std::io

val LIMIT: i64 = 10

fn describe(xs: &[i64]): String = match xs {
    [] => String::of("empty")
    [only] => "one: \(only)"
    [first, second] => "two: \(first) \(second)"
    [first, ..rest, last] => "\(first), \(rest.len()) between, \(last)"
}

fn sum(xs: &[i64]): i64 = match xs {
    [] => 0
    [first, ..rest] => first + sum(rest)
}

// Text, nested variants, and a constant after `..`, which is a range.
fn command(words: &[str]): str = match words {
    ["wip", "run", ..] => "runs"
    ["wip", ..] => "another of wip's"
    _ => "not wip"
}

fn firstSome(xs: &[Option<i64>]): i64 = match xs {
    [.Some(n), ..] => n
    [.None, .Some(n), ..] => n * 10
    _ => -1
}

fn small(xs: &[i64]): str = match xs {
    [..LIMIT] => "one below the limit"
    _ => "other"
}

fn main() = {
    val none: [i64; 0] = []
    io::println(describe(&none))
    io::println(describe([7]))
    io::println(describe([1, 2]))
    io::println(describe([1, 2, 3, 4, 5]))
    io::println("\(sum([1, 2, 3, 4]))")
    io::println("\(command(["wip", "run", "x"])) \(command(["wip", "fmt"])) \(command(["cargo"]))")
    val one: [Option<i64>; 2] = [.Some(1), .None]
    val two: [Option<i64>; 2] = [.None, .Some(2)]
    val neither: [Option<i64>; 1] = [.None]
    io::println("\(firstSome(&one)) \(firstSome(&two)) \(firstSome(&neither))")
    io::println("\(small([3])) \(small([30])) \(small([3, 4]))")

    // An array always has its length, so `val` needs no `else`.
    val pair = [3, 4]
    val [a, b] = pair
    io::println("\(a + b)")

    // A `var` array's elements are written through the bindings.
    var grid = [1, 2, 3]
    match grid {
        [first, ..rest] => {
            first = 10
            rest[0] = 20
        }
    }
    io::println("\(grid[0]) \(grid[1]) \(grid[2])")

    // What a `Vec` lends; with `else` where the pattern can fail.
    val words = Vec::of(own [String::of("a"), String::of("b"), String::of("c")])
    match words.items() {
        [head, .., tail] => io::println("\(head)\(tail)")
        _ => {}
    }
    val [.., last] = words.items() else {
        return
    }
    io::println(last)

    // An array made here is taken apart: what is bound is taken, the
    // rest dropped.
    val [first, _, .., final] = [String::of("w"), String::of("x"), String::of("y"), String::of("z")]
    io::println("\(first)\(final)")

    // An `is` test, a `var` pattern, and a `for` over arrays.
    val xs = [1, 2, 3]
    if xs is [1, ..rest] {
        io::println("\(rest.len())")
    }
    var [head, ..tail] = xs
    head += tail[0]
    tail = &tail[1..]
    io::println("\(head) \(tail.len())")
    val pairs = [[1, 2], [3, 4]]
    var total = 0
    for [p, q] in pairs {
        total += p * q
    }
    io::println("\(total)")
}
