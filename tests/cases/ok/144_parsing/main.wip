// Reading a number from text. `String` could write an
// integer and a float and nothing could read one back, so a program that
// read its input could not do anything with it.
//
// What comes back is a `Result`, whose error says what was wrong with the
// text — so `?` carries it up, and a message can name the position.
//
// Expected output: 42 and -7 (whole numbers), 255 and 5 and 35 (other
// radixes), the four ways text is not a number, the largest and the
// smallest `i64`, 3.5 and -0.25 and 2000 (fractions and a power of ten),
// 42 (a line read through `?`), and 7 (a `String` rather than a `str`).

import std::io
import std::text::{ParseError}

fn doubled(line: str): Result<i64, ParseError> = {
    val n = line.trim().toInt()?
    return .Ok(n * 2)
}

fn main() = {
    io::println("\("42".toInt()) \("-7".toInt())")
    io::println("\("ff".toInt(radix: 16)) \("101".toInt(radix: 2)) \("z".toInt(radix: 36))")

    io::println("\("".toInt())")
    io::println("\("12x".toInt())")
    io::println("\("9223372036854775808".toInt())")
    io::println("\("1".toInt(radix: 1))")

    io::println("\("9223372036854775807".toInt()) \("-9223372036854775808".toInt())")

    io::println("\("3.5".toFloat()) \("-0.25".toFloat()) \("2e3".toFloat())")

    io::println("\(doubled(" 21 "))")
    io::println("\(String::of("7").toInt())")
}
