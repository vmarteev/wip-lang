// Valid moves: a field moved out while the rest of the struct
// stays usable and is later refilled, a move out of a field of an `own`, a
// variable reassigned before every move in a loop, and a move on every
// branch. The run test also checks that nothing leaks.

import std::io

struct Engine {
    power: i64
}

struct Car {
    engine: own<Engine>
    seats: i64
}

fn power(e: own<Engine>): i64 = {
    e.power
}

fn pick(flag: bool, e: own<Engine>): i64 = {
    if flag {
        return power(move e)
    } else {
        return power(move e) + 1
    }
}

fn main(): i64 = {
    var car = Car(engine: own Engine(power: 150), seats: 4)
    io::printInt(power(move car.engine))   // 150
    io::printInt(car.seats)                // 4
    car.engine = own Engine(power: 90)
    io::printInt(car.engine.power)         // 90

    val boxed = own Car(engine: own Engine(power: 7), seats: 2)
    io::printInt(power(move boxed.engine)) // 7

    var e = own Engine(power: 0)
    var total = 0
    var i = 0
    while i < 3 {
        e = own Engine(power: i)
        total = total + power(move e)
        i = i + 1
    }
    io::printInt(total)                    // 3

    io::printInt(pick(false, own Engine(power: 5))) // 6
    0
}
