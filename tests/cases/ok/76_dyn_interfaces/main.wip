// `&dyn Interface`: a reference to a value of some type that
// implements the interface, as a pointer and the type's table of methods.
// The call is indirect, so one function serves every implementation.
//
// Expected output: 6 and 6 (the same method through a value and through a
// `&dyn`), 106 and 1 (a default and an implementation that replaces it),
// 112 and 7 (a function over any shape), 3 (a `&var dyn` that writes), 30
// (a `&dyn` of a generic type's implementation), and 9 (a method with
// parameters), with every allocation freed.

import std::io

interface Shape {
    fn area(): i64
    fn label(): i64 = self.area() + 100
    fn scaledArea(by: i64, extra: i64): i64 = self.area() * by + extra
}

struct Rect {
    width: i64
    height: i64
}

struct Circle {
    radius: i64
}

struct Boxed<T> {
    value: T
    size: i64
}

extend Rect: Shape {
    fn area(): i64 = self.width * self.height
}

extend Circle: Shape {
    fn area(): i64 = self.radius * 3
    fn label(): i64 = 1
}

extend Boxed<V>: Shape {
    fn area(): i64 = self.size
}

interface Counter {
    fn get(): i64
    var fn bump(by: i64)
}

struct Cell {
    n: i64
}

extend Cell: Counter {
    fn get(): i64 = self.n
    var fn bump(by: i64) = self.n += by
}

fn areaOf(shape: &dyn Shape): i64 = shape.area()

fn describe(shape: &dyn Shape): i64 = shape.area() + shape.label()

fn tick(c: &var dyn Counter) = c.bump(2)

fn scale(shape: &dyn Shape, by: i64, extra: i64): i64 = shape.scaledArea(by, extra)

fn main() = {
    val r = Rect(width: 2, height: 3)
    val c = Circle(radius: 2)
    io::printInt(r.area())
    io::printInt(areaOf(&r))
    io::printInt(r.label())
    io::printInt(areaOf(&c) - 5)
    io::printInt(describe(&r))
    io::printInt(describe(&c))

    var cell = Cell(n: 1)
    tick(&var cell)
    io::printInt(cell.get())

    val boxed = Boxed(value: r, size: 30)
    io::printInt(areaOf(&boxed))

    io::printInt(scale(&r, 1, 3))
}
