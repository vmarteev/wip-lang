// A named function where an owned closure is expected: an iterator's
// adapters, which keep the function they are given, take a module's
// function and a type's as a slice's do, and an owned closure is kept from
// one. Its environment holds only what drops it, which the leak check sees
// freed.
//
// Expected output: [a bc def] [a, bc, def], then [4, 9], then 42, then
// [2, 4, 6].

import std::io

struct Shape {
	side: i64

	fn area(): i64 = self.side * self.side
	static fn square(side: i64): Shape = Shape(side: side)
}

fn double(x: i64): i64 = x * 2

fn main() = {
	val owned = "a bc def".lines().map(String::of).toVec()
	val words = "a bc def".split(" ").map(String::of).toVec()
	io::println("\(owned) \(words)")
	val shapes = Vec::of(own [2, 3]).intoIterator().map(Shape::square).toVec()
	io::println("\(shapes.map(Shape::area))")
	val keep: own<(x: i64) => i64> = double
	io::println("\(keep(21))")
	val doubled = Vec::of(own [1, 2, 3]).intoIterator().map(double).toVec()
	io::println("\(doubled)")
}
