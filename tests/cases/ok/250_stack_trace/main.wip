// A panic's calls: after where it happened, each
// call that led there, innermost first, with its function and line. The
// runtime's own frames and the code the compiler writes on its own — here
// the drop of a `Vec` — are passed over; a method is named after its type,
// and a generic function after what it was given.
//
// Expected output: nothing on standard output; the panic on standard error,
// from `Tally.destroy`, through the prelude's destroying of a `Vec`'s items,
// `settle` and `main`; and status 101. A release build prints the same.

struct Tally {
    count: i64
}

extend Tally: Destroy {
    var fn destroy() = assert(self.count >= 0, "a tally ended below zero")
}

fn settle<T>(items: Vec<T>) = {
    return
}

fn main() = {
    var tallies: Vec<Tally> = Vec()
    tallies.push(Tally(count: -1))
    settle(move tallies)
}
