// `void` is the type of no value. A function without a return
// type returns `void`, and `: void` may be written to say so. It is a real
// type: a variable can have it.
//
// Expected output: 7 7 1, and exit code 0 from a `main` that returns `void`.

import std::io

fn log(x: i64): void = io::printInt(x)

fn twice(x: i64): void = {
    log(x)
    log(x)
}

fn nothing() = {}

fn main(): void = {
    twice(7)
    val v: void = nothing()
    log(1)
}
