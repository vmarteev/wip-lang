// `when { … }` chooses among conditions: the first arm whose condition
// holds runs, and the rest are not tested. As a statement, no arm need
// run; as a value, `else` is the last arm. An `is` in a condition binds for
// its arm; arms of one expression and of a block mix; an arm may leave
// the function or the loop; and a `when` may be another's `else`.
//
// Expected output:
// letter digit quote other
// big
// 7 none
// first
// tested 1
// 3
// small

import std::io

fn kind(c: char): str = when {
    c.isAsciiLetter() || c == '_' => "letter"
    c.isDigit() => "digit"
    c == '"' => {
        val word = "quote"
        word
    }
    else => "other"
}

fn found(values: &[i64], wanted: i64): Option<i64> = {
    for v in values {
        when {
            v == wanted => return .Some(v)
            v > wanted => break
        }
    }
    return .None
}

fn main() = {
    io::println("\(kind('a')) \(kind('7')) \(kind('"')) \(kind('+'))")
    val size = 12
    when {
        size > 10 => io::println("big")
        size > 5 => io::println("middling")
    }
    val maybe: Option<i64> = .Some(7)
    val described = when {
        maybe is .Some(n) && n > 5 => "\(n)"
        else => "few"
    }
    val nothing: Option<i64> = .None
    val other = when {
        nothing is .Some(n) => "\(n)"
        else => "none"
    }
    io::println("\(described) \(other)")
    var tested = 0
    val first = when {
        true => "first"
        { tested += 1
          true } => "second"
        else => "neither"
    }
    io::println(first)
    when {
        false => {}
        else => tested += 1
    }
    io::println("tested \(tested)")
    io::println("\(found([1, 3, 5], 3).unwrapOr(0))")
    val n = 4
    val said = when {
        n > 10 => "large"
        else => when {
            n > 2 => "small"
            else => "tiny"
        }
    }
    io::println(said)
}
