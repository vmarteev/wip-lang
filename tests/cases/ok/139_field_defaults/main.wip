// A field may say what a literal that leaves it out puts there.
// It is a parameter's default, written where the field is: a constant, checked
// where the struct is declared and evaluated at each literal.
//
// Expected output: 0 0 true 1 (a world that named one field), 7 (one that
// named two), 765 (every field left out), 255 (a colour with two named),
// none (a variant as a default), 3 (a constant as a default), and 6 (an
// array as one).

import std::io

val START = 3

struct World {
    ticks: i64 = 0
    score: i64 = 0
    running: bool = true
    label: i64
}

struct Colour {
    r: u8 = 255
    g: u8 = 255
    b: u8 = 255
}

struct Slot {
    held: Option<i64> = .None
    since: i64 = START
    counts: [i64; 3] = [1, 2, 3]
}

fn name(held: &Option<i64>): str = match held {
    .Some(..) => "some"
    .None => "none"
}

fn main() = {
    val quiet = World(label: 1)
    io::println("\(quiet.ticks) \(quiet.score) \(quiet.running) \(quiet.label)")

    val busy = World(label: 2, ticks: 7)
    io::printInt(busy.ticks)

    val white = Colour()
    io::printInt(white.r as i64 + white.g as i64 + white.b as i64)

    val red = Colour(g: 0, b: 0)
    io::printInt(red.r as i64 + red.g as i64)

    val slot = Slot()
    io::println(name(&slot.held))
    io::printInt(slot.since)
    io::printInt(slot.counts[0] + slot.counts[1] + slot.counts[2])
}
