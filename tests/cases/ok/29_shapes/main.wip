// A tour of the whole subset: structs, an enum with payloads, `own`, `move`,
// `&` parameters, `match`, `defer`, arrays, and extern calls.

import std::io

struct Point {
    x: f64
    y: f64
}

enum Shape {
    Circle(center: Point, radius: f64)
    Rect(min: Point, max: Point)
    Triangle(a: Point, b: Point, c: Point)
}

fn triangleArea(a: &Point, b: &Point, c: &Point): f64 = {
    val twice = (b.x - a.x) * (c.y - a.y) - (c.x - a.x) * (b.y - a.y)
    if twice < 0.0 {
        return -twice / 2.0
    }
    twice / 2.0
}

fn area(s: &Shape): f64 = {
    return match s {
        .Circle(radius: r, ..) => 3.141592653589793 * r * r
        .Rect(min: lo, max: hi) => (hi.x - lo.x) * (hi.y - lo.y)
        .Triangle(a, b, c) => triangleArea(&a, &b, &c)
    }
}

fn totalArea(shapes: &[Shape; 3]): f64 = {
    var total = 0.0
    var i = 0
    while i < 3 {
        total = total + area(&shapes[i])
        i = i + 1
    }
    total
}

fn discard(s: own<Shape>) = {
    io::printFloat(area(&s))
}

fn main(): i64 = {
    defer io::println("done")
    val origin = Point(x: 0.0, y: 0.0)
    val shapes = [
        Shape::Circle(center: origin, radius: 1.0),
        Shape::Rect(min: Point(x: 0.0, y: 0.0), max: Point(x: 2.0, y: 3.0)),
        Shape::Triangle(
            a: Point(x: 0.0, y: 0.0),
            b: Point(x: 4.0, y: 0.0),
            c: Point(x: 0.0, y: 3.0),
        ),
    ]
    io::printFloat(totalArea(&shapes))
    val boxed = own Shape::Circle(center: Point(x: 1.0, y: 1.0), radius: 2.0)
    discard(move boxed)
    0
}
