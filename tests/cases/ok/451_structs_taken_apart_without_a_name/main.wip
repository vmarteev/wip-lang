// A struct taken apart in parentheses, without its name, by its fields'
// names, wherever a pattern stands: `val`, `var`, a method's `self`, a
// `for` over a map's entries, a `match` arm inside a variant, `is`;
// nested, renamed, with `..`, a struct of one field, a generic struct.
// A tuple beside it is taken apart by position, in the same parentheses.
//
// Expected output: the fields as bound, "1 2 1 1 2 5 6 3 three 9 11 2 3";
// then the shapes, "round at 1, 2, 3" and "square from x 1, 4"; "found 1";
// the tuple, "10 ten"; the map's entry, "ann 31"; and "one then 2".

import std::io
import std::collections::{Map}

struct Point {
    x: i64
    y: i64
}

struct Line {
    from: Point
    to: Point
}

struct Pair<A, B> {
    first: A
    second: B
}

struct Wrapped {
    value: i64
}

enum Shape {
    Round(centre: Point, radius: i64)
    Square(corner: Point, side: i64)
}

fn describe(shape: &Shape): String = match shape {
    .Round(centre: (x, y), radius) => "round at \(x), \(y), \(radius)"
    .Square(corner: (x, ..), side) => "square from x \(x), \(side)"
}

extend Point {
    fn sum(): i64 = {
        val (x, y) = self
        return x + y
    }
}

fn main() = {
    val here = Point(x: 1, y: 2)
    val (x, y) = here
    val (x: across, ..) = here
    val line = Line(from: here, to: Point(x: 5, y: 6))
    val (from: (x: fx, y: fy), to: (x: toX, y: toY)) = line
    val pair = Pair(first: 3, second: "three")
    val (first, second) = pair
    val (value) = Wrapped(value: 9)
    var (x: vx, y: vy) = here
    vx += 10
    io::println("\(x) \(y) \(across) \(fx) \(fy) \(toX) \(toY) \(first) \(second) \(value) \(vx) \(vy) \(here.sum())")
    io::println(describe(.Round(centre: here, radius: 3)))
    io::println(describe(.Square(corner: here, side: 4)))
    val found: Option<Point> = .Some(here)
    if found is .Some((x, ..)) then io::println("found \(x)")
    val (a, b) = (10, "ten")
    io::println("\(a) \(b)")
    var ages: Map<String, i64> = Map()
    ages.put("ann", 31)
    for (key, value) in move ages {
        io::println("\(key) \(value)")
    }
    match (1, 2) {
        (1, n) => io::println("one then \(n)")
        _ => io::println("other")
    }
}
