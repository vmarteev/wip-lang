// A named argument written `name:`, before a `,` or the `)`, is the
// argument `name: name`: in a build of a struct and of a variant, and in a
// call, in any order after positional arguments, beside arguments of
// another name; its value a local, a parameter, a variable a lambda
// captured, or a constant; and a `String` moved where it is the last use.
// A bare variable is still an argument by position.
//
// Expected output:
// 3 4
// 4 3
// 12 9
// vk 2 8
// moved ann
// 6 8

import std::io

val limit = 8

struct Point {
    x: i64
    y: i64
}

struct Device {
    instance: String
    queue: i64
    limit: i64
}

enum Shape {
    Rect(width: i64, height: i64)
}

fn area(width: i64, height: i64, scale: i64 = 1): i64 = width * height * scale

fn device(instance: String, queue: i64): Device = Device(instance:, queue:, limit:)

fn named(name: String): String = "moved \(name)"

fn main() = {
    val x = 3
    val y = 4
    val p = Point(x:, y:)
    val q = Point(y: x, x: y)
    io::println("\(p.x) \(p.y)")
    io::println("\(q.x) \(q.y)")

    val width = 3
    val height = 4
    val (w, h) = match Shape::Rect(height:, width:) {
        .Rect(width, height) => (width, height)
    }
    io::println("\(area(width:, height:)) \(area(w, h - 1, scale: 1))")

    val d = device("vk", queue: 2)
    io::println("\(d.instance) \(d.queue) \(d.limit)")

    val name: String = "ann"
    io::println(named(name:))

    val shown = [2, 3].map((x) => Point(x:, y:))
    io::println("\(shown[1].x + y - 1) \(shown[0].y + y)")
}
