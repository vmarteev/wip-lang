// A text block: the lines between two `"""`s, less the closing one's
// indentation.

import std::io

val SHADER: cstring = """
	#include <metal_stdlib>
	struct vs_in {
	  float4 pos [[attribute(0)]];
	};
	"""

fn main() = {
	io::println(SHADER.toStr())
	io::println("--")
	// Quotes need no escape, a blank line is empty, space at the end of a
	// line is dropped unless an escape wrote it, and `\(…)` works as in a
	// string.
	val name = "pacman"
	val json = """
		{
		  "name": "\(name)",   

		  "lives": \(1 + 2)\t
		}
		"""
	io::println(json)
	io::println("\(json.len())")
	val empty = """
		"""
	io::println("[\(empty)]")
}
