// Comments can appear anywhere whitespace can. Empty bodies are allowed.
//// Extra slashes are still a comment.

extern "C" {
    // no functions declared
}

struct Unit {}

fn nothing() = {}

fn alsoNothing() = {
    // a comment is not a statement
}

fn main(): i64 = { // trailing comment after a brace
    nothing() // after a statement
    alsoNothing()
    val u = Unit() // an empty struct literal
    val two = 1 + // between tokens: the expression is not finished yet
        1
    two - 2
}
// a comment on the last line, with no newline after it