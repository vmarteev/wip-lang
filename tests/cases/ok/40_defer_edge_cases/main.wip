// `defer` edge cases. The run test also checks that nothing
// leaks and that every allocation is freed once, in the traced order.
//
// Expected output:
//   `movesInLoop`: each iteration moves its box into the `defer`, which
//   hands it to `take`, so `free #n` comes before the printed value; the
//   early `return` in the third iteration still runs that iteration's `defer`.
//   `discardedResult`: the box `make(99)` returns is freed right away.
//   `copies`: 30 then 102, newest first: `xs[i]` and `p` as they are at the
//   end, not when each `defer` was reached.
//   `paramBorrow`: the inner block's `defer` after its value is computed,
//   then 21 through the borrow, then the parameter is freed.

import std::io

extern "C" {
    fn wip_trace_allocs()
}

struct Point {
    x: i64
    y: i64
}

struct Box {
    value: i64
}

fn make(v: i64): own<Box> = own Box(value: v)

fn take(b: own<Box>): i64 = b.value

fn peek(b: &own<Box>): i64 = b.value

fn showPoint(p: Point) = io::printInt(p.x + p.y)

fn movesInLoop(stop: i64): i64 = {
    var i = 0
    while i < 5 {
        val b = make(i)
        defer io::printInt(take(move b))
        if i == stop {
            return i
        }
        i = i + 1
    }
    -1
}

fn discardedResult() = {
    defer make(99)
    io::println("discarded: body")
}

fn copies() = {
    var p = Point(x: 1, y: 2)
    val xs = [10, 20, 30]
    var i = 1
    defer showPoint(p)
    defer io::printInt(xs[i])
    p.x = 100
    i = 2
}

fn paramBorrow(b: own<Box>): i64 = {
    defer io::printInt(peek(&b))
    val doubled = {
        defer io::println("param: inner block done")
        b.value * 2
    }
    doubled
}

fn main(): i64 = {
    wip_trace_allocs()
    io::printInt(movesInLoop(2))
    discardedResult()
    copies()
    io::printInt(paramBorrow(make(21)))
    0
}
