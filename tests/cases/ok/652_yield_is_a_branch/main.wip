// `yield` is a branch, as `return` is: after `then` and `else`, and as an
// arm's body, in a list and in a generator. A list that yields, where
// nothing expects a collection, is a `Vec`, which grows; with `own` it is
// a buffer, as before. `yield if … then … else …` yields either value.
//
// Expected output:
// [2, 4, 6]
// [2, 4, 6, 8]
// [title, small, small, big]
// 1 3
// [-1, -1, 1, 1]
// 3

import std::io

enum Tree {
    Leaf(value: i64)
    Branch(weight: i64)
}

fn leaves(trees: &[Tree]): Iterator<i64> = for tree in trees {
    match tree {
        .Leaf(value) => yield value
        .Branch(..) => {}
    }
}

fn sizes(xs: &[i64]): Iterator<str> = for x in xs {
    if x > 2 then yield "big" else yield "small"
}

fn main() = {
    val xs = [1, 2, 3, 4, 5, 6]
    val evens = [for x in xs { if x % 2 == 0 then yield x }]
    io::println("\(evens)")
    var grown = evens
    grown.push(8)
    io::println("\(grown)")

    val names = ["title", for size in sizes([1, 2, 3]) { yield size }]
    io::println("\(names)")

    val trees = [Tree::Leaf(value: 1), Tree::Branch(weight: 2), Tree::Leaf(value: 3)]
    val found = [for value in leaves(&trees) { yield value }]
    io::println("\(found[0]) \(found[1])")

    val signs = [for x in [-2, -1, 1, 2] { yield if x < 0 then -1 else 1 }]
    io::println("\(signs)")

    val buffer = own for x in xs { if x > 3 then yield x }
    io::println("\(buffer.len())")
}
