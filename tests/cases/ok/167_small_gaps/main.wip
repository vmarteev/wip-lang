// Three small gaps closed: a constant is imported by name,
// as a function or a type is; `[x; N]` may name its count, as `[T; N]`
// could; and every integer type has `min`, `max` and `clamp`, and a signed
// one `abs`, as `i64` did.

import std::io
import std::math::{PI, TAU as turn}
import lib::{SIZE}

val COUNT: i64 = 4

fn main() = {
    io::println("\((PI * 100.0) as i64) \((turn * 100.0) as i64)")

    val sevens = [7; COUNT]
    val ones: [i64; SIZE] = [1; SIZE]
    io::println("\(sevens.len()) \(ones.len()) \(sevens[3])")
    // A variable is not a constant: its count is known only as the
    // program runs, so the buffer is on the heap.
    val n = 5
    val zeros = own [0; n]
    io::println("\(zeros.len())")

    val a: i32 = -7
    val b: u8 = 200
    val c: usize = 3
    val d: i128 = -12
    io::println("\(a.abs()) \(a.min(2)) \(b.max(250)) \(b.clamp(0, 100)) \(c.clamp(5, 9)) \(d.abs() as i64)")
}
