// Variables C owns. `val` reads what C holds, `var` writes it as well. A
// variable is a symbol, so the compiler loads from it and stores to it where it
// is used, and C sees every write, since it is C's own variable that is
// written.
//
// A name may not be a symbol at all: `errno` is a macro over thread-local
// storage on every platform Wip targets. Its own `@header` says so, and
// the compiler then writes the C that reads and writes it, and a use is a
// call:
//
//     int32_t wip_shim_99(void)        { return errno; }
//     void    wip_shim_100(int32_t a0) { errno = a0; }
//
// Expected output: 7 and C's greeting; then 10, which C agrees is 20 when
// doubled; then the `errno` a failed `open` left, and 0 once cleared.

import std::io

extern "C" {
    var counter: c_int
    val greeting: cstring
    fn doubled_counter(): c_int
}

// `errno` is a macro, so it is read through the header that defines it.
extern "C" {
    @header("<errno.h>")
    var errno: c_int
}

extern "C" {
    fn open(path: cstring, flags: c_int): c_int
}

fn main() = {
    io::println("counter \(counter), greeting \(greeting.toStr())")

    counter = 9 as c_int
    counter += 1 as c_int
    io::println("counter \(counter), doubled \(doubled_counter())")

    errno = 0
    val fd = open("/definitely/not/here", 0 as c_int)
    io::println("fd \(fd), errno \(errno)")
    errno = 0
    io::println("errno cleared to \(errno)")
}
