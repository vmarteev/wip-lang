// A `main` that hands back an error. The error writes
// itself through `Text`, the program prints `error: ` and the message on
// standard error, and the exit code is 1 — a program working as written,
// where the 101 of a panic means a program that is wrong.
//
// The `?` here is what propagates it: nothing in `main` matches on the
// result at all.
//
// Expected output: started, on standard output; then
// `error: no such file: nope.txt` on standard error, and exit code 1.

import std::io

enum ReadError {
    NotFound(path: String)
    Empty
}

extend ReadError: Text {
    fn appendTo(out: &var String) = match self {
        .NotFound(path) => {
            out.push("no such file: ")
            out.push(path)
        }
        .Empty => out.push("the file is empty")
    }
}

fn rowsIn(name: str): Result<i64, ReadError> = {
    var path = String()
    path.push(name)
    return .Err(.NotFound(move path))
}

fn main(): Result<i64, ReadError> = {
    io::println("started")
    val rows = rowsIn("nope.txt")?
    .Ok(rows)
}
