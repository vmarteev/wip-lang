// A function that takes `implicit at: Location` is told where it was
// called: where no implicit of that name is, the place of the call fills
// it, where the call's name is written. A helper that takes one hands its
// own on, so the place is the first call into the chain; one given by name
// is that one. `panic(message, at: at)` reports the caller's line.
//
// Expected output: four places, each the line of a call in `main`, then the
// panic at the second call of `expectEqual` on standard error, and status
// 101.

import std::io

fn whereFrom(implicit at: Location): Location = at

fn handedOn(implicit at: Location): Location = whereFrom()

fn givenByName(implicit here: Location): Location = whereFrom(at: here)

struct Counter {
    count: i64
}

extend Counter {
    fn place(implicit at: Location): Location = at
}

fn expectEqual(actual: i64, expected: i64, implicit at: Location) = {
    if actual != expected then panic("expected \(expected), found \(actual)", at: at)
}

fn main() = {
    val filled = whereFrom()
    io::println("\(filled) in \(filled.function)")
    io::println("\(handedOn())")
    io::println("\(givenByName())")
    val counter = Counter(count: 1)
    val method = counter
        .place()
    io::println("\(method.line):\(method.column)")
    expectEqual(2 + 2, 4)
    expectEqual(2 + 3, 4)
}
