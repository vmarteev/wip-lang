// `.Some` and `.None` with nothing expected are the prelude's `Option`:
// `.Some(x)` says the type argument, and an `if`'s or a
// `match`'s other branch is checked against it.
//
// Expected output: "true true true".

import std::io

enum Style {
    Bold
    Plain
}

fn pick(bold: bool): Style = if bold { .Bold } else { .Plain }

fn main() = {
    val selected = 2
    val here = if selected == 2 { .Some(pick(true)) } else { .None }
    val size = match selected {
        1 => .Some(10)
        _ => .None
    }
    val alone = .Some("one")
    io::println("\(here is .Some(.Bold)) \(size is .None) \(alone == .Some("one"))")
}
