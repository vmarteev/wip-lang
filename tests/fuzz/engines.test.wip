// What `--engines` reads of what the checker says, and the program it
// writes.

import std::random::{Random}

@test
fn anErrorIsReadWithTheLineOfItsLabel() = {
	val dumped = """
		file main.wip
		error E0441 working out `COMPUTED3` panicked: the sum does not fit
		  primary main.wip:19:5-19:15 panicked while the program was compiled
		  note in case3 (main.wip:16)
		error E0310 this constant is 300, which does not fit in `u8`
		  primary main.wip:22:40-22:43 does not fit
		2 errors
		"""
	val errors = errorsOf(dumped)
	assert(errors.len() == 2)
	assert(errors[0].code == "E0441" && errors[0].line == 19)
	assert(errors[0].message == "working out `COMPUTED3` panicked: the sum does not fit")
	assert(errors[1].code == "E0310" && errors[1].line == 22)
}

@test
fn aLineIsTheCaseAboveIt() = {
	val program = String::of(
		"import std::io\n\nfn case4(a: i64, b: u64, c: f64, d: u8): i8 = 1 as i8\n\n@comptime\nval COMPUTED4: i8 = case4(0, 0, 0.0, 0)\n\nfn case9(a: i64, b: u64, c: f64, d: u8): u8 = 2 as u8\n",
	)
	assert(engineCaseAt(&program, 1).isNone())
	assert(engineCaseAt(&program, 3) == 4)
	assert(engineCaseAt(&program, 6) == 4)
	assert(engineCaseAt(&program, 8) == 9)
}

@test
fn aCaseWhoseConstantPanickedIsAskedForEachCallApart() = {
	val case = EngineCase(index: 2, ty: .U8, body: "d +% (1 as u8)", inputs: [
		"1",
		"2",
		"0.5",
		"255",
	])
	val answered = engineProgram([case.clone()], [Compiled::Answered])
	assert(answered.contains("val COMPUTED2: u8 = case2(1, 2, 0.5, 255)"))
	assert(answered.contains("if which == \"2\" then"))
	val panicked = engineProgram([case], [Compiled::Panicked("the sum does not fit")])
	assert(!panicked.contains("COMPUTED2"))
	assert(panicked.contains("if which == \"2+\" then"))
}

@test
fn theSameSeedWritesTheSameCases() = {
	var one = Writer(random: Random::seeded(7))
	var two = Writer(random: Random::seeded(7))
	for index in 0..20 do
		assert(one.case(index).body == two.case(index).body)
}
