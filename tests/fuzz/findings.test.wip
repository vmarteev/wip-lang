// What says two findings are one, and how a case is made smaller.

@test
fn aKeyHasNoNumbers() = {
	assert(
		keyOf("arena reset with 4 values still alive, at `sum += v12.len()`") ==
			"arena reset with N values still alive, at `sum += vN.len()`",
	)
}

@test
fn aFailureNamesTheStatementOfItsLine() = {
	val batch = "@test\nfn case3() = {\n\tvar sum = limited()\n\tdestroy(v7)\n}\n"
	assert(
		statementNamed(
			"panicked: dropped\n  in case3 (target/fuzz/batch/cases.test.wip:4)",
			batch,
		) ==
			"destroy(v7)",
	)
	assert(statementNamed("a report with no line", batch).isEmpty())
}

@test
fn aVariablesUseIsTriedAsAPlainValue() = {
	val body = [
		Stmt::Line("val v1: Tracked = Tracked::of(1)"),
		.Line("var v2: String = made(2)"),
		.Line("sum += given(v1)"),
		.Block(heads: ["if sum > v2.len() {"], bodies: [[.Line("v2 = made(3)")]], end: "}"),
	]
	val kinds = declaredKinds(&body)
	assert(kinds.get("v1") is .Some(.Tag) && kinds.get("v2") is .Some(.Text))
	// Where each is declared or given a new value, it is not a use.
	val first = replacedUse(&body, 0, &kinds).unwrap()
	assert(texts(&first)[2] == "sum += given(Tracked::of(0))")
	val second = replacedUse(&body, 1, &kinds).unwrap()
	assert(texts(&second)[3] == "if sum > (made(0)).len() {")
	assert(replacedUse(&body, 2, &kinds).isNone())
}

@test
fn kindsAreCountedOnceEach() = {
	var groups = Groups()
	assert(!groups.again("a leak"))
	groups.first("a leak", "findings/1-2")
	assert(groups.again("a leak"))
	assert(groups.again("a leak"))
	assert(groups.kinds() == 1 && groups.found() == 3)
}

@test
fn twoStatementsOfOneFormAreOne() = {
	assert(formOf("v5 = Pair(a: made(0), b: [made(1)], tag: v5.tag)") == "v5 = …")
	assert(formOf("destroy(v7)") == "destroy(…)")
	assert(formOf("sum += given(v1)") == "sum += given(…)")
	assert(formOf("sum += v2.id") == "sum += v2.id")
}

@test
fn aBlockIsTriedAsEachOfItsBodies() = {
	val body = [
		Stmt::Line("var v1: Tracked = Tracked::of(1)"),
		.Block(
			heads: ["if sum % 2 == 0 {", "} else {"],
			bodies: [[.Line("destroy(v1)")], []],
			end: "}",
		),
	]
	assert(choices(&body) == 2)
	val first = unwrapped(&body, 0).unwrap()
	assert(texts(&first) == ["var v1: Tracked = Tracked::of(1)", "destroy(v1)"])
	val second = unwrapped(&body, 1).unwrap()
	assert(texts(&second) == ["var v1: Tracked = Tracked::of(1)"])
	assert(unwrapped(&body, 2).isNone())
}
