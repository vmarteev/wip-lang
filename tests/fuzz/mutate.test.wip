// What `--mutate` reads of the programs it changes and of what the check
// says.

import std::fs
import std::path

@test
fn everyProgramsTokensAreItsTextAgain() = {
	var files = 0
	for place in PLACES {
		val walked = fs::walk(place).unwrap()
		for entry in walked {
			if !entry.name.endsWith(".wip") then
				continue

			val .Ok(text) = fs::readFile(path::join(place, entry.name)) else continue
			assert(joined(tokens(text)) == text)
			files += 1
		}
	}
	assert(files > 800)
}

@test
fn aRangeIsTwoNumbersAndAFractionIsOne() = {
	val cut = tokens("0..5 + 1.5")
	val texts: Vec<str> = [
		for token in cut do
			yield token.text.toStr()
	]
	assert(texts == ["0", "..", "5", " ", "+", " ", "1.5"])
	assert(cut[0].class == .Number && cut[1].class == .Mark && cut[6].class == .Number)
}

@test
fn keywordsTextsAndCommentsAreTheirOwn() = {
	val cut = tokens("val x = \"a \\\" b\" // c\n")
	assert(cut[0].class == .Keyword)
	assert(cut[2].class == .Name)
	assert(cut[6].text == "\"a \\\" b\"" && cut[6].class == .Quoted)
	assert(cut[8].class == .Blank && cut[8].text == "// c")
}

@test
fn aRefusalsCodeIsItsFirstErrorsNotAWarnings() = {
	val said = "[E0469] Warning: … \n[E0101] Error: expected an expression"
	assert(codeOf(said) == .Some("E0101"))
	assert(codeOf("[E0469] Warning: only that").isNone())
}

@test
fn aPanicIsNamedByItsFirstPlaceInTheCompiler() = {
	val said = """
		panicked: index 0 is out of bounds for length 0
		  at std/prelude/vec.wip:90:4
		  in hir::resolveVariadicCalls (compiler/hir/lower_variadic.wip:47)
		  in hir::lower (compiler/hir/lower.wip:664)
		"""
	assert(
		panicOf(said) ==
			"index 0 is out of bounds for length 0, in hir::resolveVariadicCalls (compiler/hir/lower_variadic.wip:47), from hir::lower (compiler/hir/lower.wip:664)",
	)
}

@test
fn aHelpersPanicIsNamedByItsCallerToo() = {
	val said = """
		panicked: index 1 is out of bounds for length 0
		  at compiler/hir/ty.wip:545:31
		  in hir::Types.subst (compiler/hir/ty.wip:545)
		  in hir::Types.subst (compiler/hir/ty.wip:547)
		  in hir::Lowerer.collectedInto (compiler/hir/lower_lists.wip:496)
		"""
	assert(
		panicOf(said) ==
			"index 1 is out of bounds for length 0, at compiler/hir/ty.wip:545:31, from hir::Lowerer.collectedInto (compiler/hir/lower_lists.wip:496)",
	)
}

@test
fn aChangesPlaceIsItsLineAndCharacterFromNothing() = {
	val cut = tokens("fn f() = {\n\tval é = 1\n}\n")
	// `1`, after a tab and four characters, one of them two bytes.
	var at = 0
	while cut[at].text != "1" do
		at += 1

	assert(placeOf(&cut, at) == (1, 9))
	assert(placeOf(&cut, 0) == (0, 0))
}

@test
fn theSourcesAreTheToolAndWhatTheListOfPortsNames() = {
	val root = "target/fuzz-sources-test"
	fs::makeDirs(path::join(root, "scripts")).unwrap()
	fs::writeFile(
		path::join(root, "scripts/ports.txt"),
		"# A comment.\n\n../one .\n  ../two/inner -  \n../three\n",
	).unwrap()
	val places = sourcesOf(root)
	assert(places.len() == 4 && places[0] == "tools/bindgen" && places[1] == "../one")
	assert(places[2] == "../two/inner" && places[3] == "../three")
	assert(sourcesOf("target/fuzz-no-such-checkout").len() == 1)
}

@test
fn aTextBlocksLinesAreItsTokensWithoutTheSpaceThatEndsThem() = {
	// The formatter takes the space off the end of a line, which is not part
	// of the text, and indents the block where it stands.
	val written = "val x = \"\"\"\n\t\t\"name\": \"\\(name)\",   \n\t\t\"\"\"\n"
	val formatted = "val x = \"\"\"\n\t\"name\": \"\\(name)\",\n\t\"\"\"\n"
	assert(solidTexts(written) == solidTexts(formatted))
	// An escape that ends a line is text, and is kept.
	val escaped = "val x = \"\"\"\n\ta\\t\n\t\"\"\"\n"
	val plain = "val x = \"\"\"\n\ta\n\t\"\"\"\n"
	assert(solidTexts(escaped) != solidTexts(plain))
}
