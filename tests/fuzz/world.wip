// The world every generated case is written in: types that own memory in
// each way a program's do — a `String`, a `Vec`, an `Option`, a struct of
// two, an enum, a box and a node that holds one — a view that borrows, and
// the functions and methods that take them by value, take them apart, lend
// them, give them new values through a reference, and lend out of them; and
// `Tracked`, which a pair and a node hold, whose every end is written down,
// and `mark`, which writes where a block ends and what must end with it.
// It is the program's `main.wip`; the cases are its tests.

/// The signal that ends a case once its time is out, as the world's
/// `limited` sets it: `SIGALRM`, numbered the same on a Mac and on Linux.
pub val ALARMED: i64 = 14

/// The text of the program's root, which the cases' file is beside.
pub val WORLD: str = """
	// What the generated cases are written in.

	import std::io

	extern "C" {
		fn alarm(seconds: u32): u32
	}

	/// What a case's sum starts at, once the time the case has is set, ten
	/// seconds, far more than one takes: a cut that leaves a loop without its
	/// step would run it for ever.
	fn limited(): i64 = {
		alarm(10)
		return 0
	}

	/// A value whose end is seen: it owns memory, as most values do, and has
	/// a `destroy` of its own, which says it ended. Each is made at a place
	/// of the case, its number; a clone is numbered apart.
	struct Tracked {
		id: i64
		held: own<i64>
	}

	extend Tracked {
		static fn of(id: i64): Tracked = {
			io::println("made \\(id)")
			return Tracked(id:, held: own id)
		}
	}

	extend Tracked: Destroy {
		var fn destroy() = io::println("ended \\(self.id)")
	}

	extend Tracked: Clone {
		fn clone(): Tracked = Tracked::of(self.id + 100000)
	}

	/// The end of block `block`, and the ends that must follow it: the values
	/// it declared and kept, newest first, each a group whose own ends may
	/// come in any order.
	fn mark(block: i64, expected: str) = io::println("end of \\(block): \\(expected)")

	/// A tracked value given, which ends here.
	fn given(tag: Tracked): i64 = tag.id

	/// What the case worked out, which a debug build and a release one must
	/// both say.
	fn finished(sum: i64) = io::println("sum \\(sum)")

	@derive(Clone)
	struct Pair {
		a: String
		b: Vec<String>
		tag: Tracked
	}

	extend Pair {
		/// Taken apart: its first text, and every text of its list after it.
		move fn joined(): String = {
			var out = self.a
			for text in move self.b do
				out.push(text)

			return out
		}

		/// Its first text replaced, through `self`.
		var fn refreshed(text: String) = {
			self.a = text
		}
	}

	@derive(Clone)
	enum Shape {
		Text(s: String)
		Many(v: Vec<String>)
		Empty
	}

	@derive(Clone)
	struct Node {
		name: String
		next: Option<own<Node>>
		tag: Tracked
	}

	view struct Seen {
		pair: &Pair
	}

	fn made(n: i64): String = "s\\(n)"

	fn taken(text: String): i64 = text.len()

	fn size(text: &String): i64 = text.len()

	fn grown(text: &var String) = text.push("+")

	fn summed(pair: Pair): i64 = pair.a.len() + pair.b.len()

	fn first(pair: &Pair): &String = lend pair.a

	fn firstOf(list: &Vec<String>): Option<&String> = if list.isEmpty() then .None else &list[0]

	/// The text given a new value through the reference, which drops what
	/// it held.
	fn replaced(text: &var String, n: i64) = {
		text = made(n)
	}

	/// The pair given a new value whole through the reference.
	fn cycled(pair: &var Pair) = {
		pair = Pair(a: made(1), b: Vec(), tag: Tracked::of(0))
	}

	/// An owned closure called once and ended.
	fn calledOnce(f: own<() => i64>): i64 = f()

	fn emptied(list: &var Vec<String>): Vec<String> = {
		val out = list.clone()
		list.clear()
		return out
	}

	/// A value given and given back, of any type.
	fn back<T>(value: T): T = value

	/// A value given, of any type, which ends here.
	fn dropped<T>(value: T) = {}

	/// The first text's length and the tag's number, or nothing where it is
	/// not wanted: its `?` leaves with the pair's first text moved out of it,
	/// and the rest dropped.
	fn tagged(pair: Pair, wanted: bool): Option<i64> = {
		val text = pair.a
		val found: Option<i64> = if wanted then text.len() else .None
		val length = found?
		return length + pair.tag.id
	}

	/// The texts of a list, one at a time, each lent from it.
	fn each(list: &Vec<String>): Iterator<&String> = {
		for text in list do
			yield &text
	}

	fn main() = {}

	"""

/// What the cases' file imports, before its cases: each file says its own.
pub val HEADER: str = """
	import std::collections::{Map, Set}
	import std::mem
	import std::mem::{Arena}


	"""
