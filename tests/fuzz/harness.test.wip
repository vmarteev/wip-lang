// The log of a case's `Tracked` values, read as the harness reads it: each
// way it can go wrong found, and a right one passed.

@test
fn aLogInOrderPasses() = {
	val log = "made 1\nmade 2\nmade 3\nend of 1: 3 | 2,1\nended 3\nended 1\nended 2\n"
	assert(misended(log).isNone(), "every value ended once, in its block's order")
}

@test
fn aValueEndedTwiceIsFound() = {
	val .Some((what, _)) = misended("made 1\nended 1\nended 1\n") else panic("not found")
	assert(what == "a value ended more often than it was made")
}

@test
fn aValueThatNeverEndedIsFound() = {
	val .Some((what, _)) = misended("made 1\nmade 2\nended 2\n") else panic("not found")
	assert(what == "a value never ended")
}

@test
fn valuesOutOfOrderAreFound() = {
	val .Some((what, _)) = misended("made 1\nmade 2\nend of 1: 2 | 1\nended 1\nended 2\n") else {
		panic("not found")
	}
	assert(what == "values ended out of their block's order")
}

@test
fn aValueThatDidNotEndWithItsBlockIsFound() = {
	val .Some((what, _)) = misended(
		"made 1\nmade 2\nend of 1: 2 | 1\nended 2\nmade 3\nended 1\nended 3\n",
	) else {
		panic("not found")
	}
	assert(what == "a value did not end with its block")
}

@test
fn whatAMarkNamesThatIsNotAliveIsPassedOver() = {
	// A case made smaller may no longer make what its mark names; and an
	// end the mark does not name is another value's.
	val log = "made 2\nmade 5\nend of 1: 9 | 2\nended 5\nended 2\n"
	assert(misended(log).isNone(), "only what is alive is looked for")
}
