	),
	(
		"fmt",
		"Lay `.wip` files out in one way, from their syntax tree. Files named, and every `.wip` file under a directory named; with none, the current directory. `-` formats standard input to standard output, as an editor wants. A file whose leading comments include `// wip fmt: off` is left as written",
		"[PATHS]...",
	),
	("lsp", "Serve an editor: the Language Server Protocol on standard input and output", ""),
	(
		"bindgen",
