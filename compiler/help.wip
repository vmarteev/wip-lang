	),
	(
		"cache",
		"What `wip` keeps between builds, in `WIP_CACHE_DIR` or the platform's cache directory",
		"<COMMAND>",
	),
	("run", "Compile a source file and run it, exiting with its exit code", "<FILE> [ARGS]..."),
	("help", "Print this message or the help of the given command", "[COMMAND]"),
]

