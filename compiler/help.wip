// What `wip --help` and each command's `--help` say: the commands, their
// arguments and their options, each with what it is for.

import lang::{described}

/// What `wip` is, as its help begins.
val ABOUT = "The compiler for the Wip language"

/// Each command: its name, what it does, and its arguments as its usage
/// line writes them.
val COMMANDS: [(str, str, str); 14] = [
