		"--scripts",
		"Print where the scripts are, for an editor's debugger to load; start nothing",
	),
]

/// The help of `wip`, or of one of its commands: none where there is no
/// such command.
fn helpOf(command: Option<str>): Option<String> = {
	val .Some(name) = command else {
		return .Some(mainHelp())
	}
	for (named, about, arguments) in COMMANDS {
		if named == name then return .Some(commandHelp(name, about, arguments))
	}
	return .None
}

/// `wip --help`: the commands, and the options every one takes.
fn mainHelp(): String = {
	var text = "\(ABOUT)\n\nUsage: wip [OPTIONS] <COMMAND>\n\nCommands:\n"
	var rows: Vec<(String, str)> = Vec()
	for (name, about, _) in COMMANDS {
		rows.push((name, about))
	}
	text.push(table(&rows))
	text.push("\nOptions:\n")
	var options: Vec<(String, str)> = Vec()
	for (commands, short, long, about) in OPTIONS {
		if commands == "*" then options.push((optionName(short, long), about))
	}
	options.push((optionName("-h", "--help"), "Print help"))
	options.push((optionName("-V", "--version"), "Print version"))
	text.push(table(&options))
	return move text
}

/// A command's help: what it does, its usage, its arguments and its options.
fn commandHelp(name: str, about: str, arguments: str): String = {
	var text = "\(about)\n\nUsage: wip \(name) [OPTIONS] \(arguments)\n"
	if name == "cache" then
		text.push(
			"\nCommands:\n  clean  Remove everything `wip` keeps in its cache — what it compiled, and what it wrote out — and nothing else there. A build afterwards compiles it all again\n",
		)
	var explained: Vec<(String, str)> = Vec()
	for (command, argument, said) in ARGUMENTS {
		if command == name then explained.push((argument, said))
	}
	if !explained.isEmpty() {
		text.push("\nArguments:\n")
		text.push(table(&explained))
	}
	var options: Vec<(String, str)> = Vec()
	for (commands, short, long, said) in OPTIONS {
		if commands == "*" || takes(commands, name) then
			options.push((optionName(short, long), said))
	}
	options.push((optionName("-h", "--help"), "Print help"))
	text.push("\nOptions:\n")
	text.push(table(&options))
	return move text
}

/// Whether `name` is one of the space-separated `commands`.
fn takes(commands: str, name: str): bool = {
	for command in commands.split(" ") {
		if command == name then return true
	}
	return false
}

/// An option as its row begins: `-o, --output <OUTPUT>`, or a long form
/// alone, set where a short one would be.
fn optionName(short: str, long: str): String =
	if short.isEmpty() then "    \(long)" else "\(short), \(long)"

/// Rows of a name and what it is, the second column where the longest name
/// ends.
fn table(rows: &[(String, str)]): String = {
	var width = 0
	for (name, _) in rows {
		if name.len() > width then width = name.len()
	}
	var text = String()
	for (name, about) in rows {
		val line = "  \(name, width: width)  \(about)"
		text.push(line.toStr().trimEnd())
		text.push("\n")
	}
	return move text
}

/// What `wip --version` says.
fn versionText(): String = "wip \(described())\n"
