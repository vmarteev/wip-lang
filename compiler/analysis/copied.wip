// A value copied where it could have been moved.
//
// Text given where a `String` is expected is copied into one, and so is
// `String::of(name.toStr())`; `clone()` copies any value. Where the copy is
// of a variable the function owns, or of a field of one, and nothing reads
// that variable after the copy on some path, the variable itself could have
// been given, and moved: the copy is a warning (E0448). A copy stays unread
// until a use of the variable — a read, a borrow, a move — reads it;
// assigning the whole of it a new value does not, since the old one could
// have been moved first, and assigning a field of it does.

import hir::{ExprId, FnId, KnownFn, LocalId}
import syntax::{COPIED_AT_LAST_USE, Diagnostic, Edit, Span}

/// A copy of a variable's value, or of a field of it: where, of which
/// variable, and for a `clone()`, where its receiver ends, so that the fix
/// takes the call away.
pub struct Copied {
	span: Span
	local: LocalId
	cloned: Option<u32>
	/// A field of the variable, not the whole of it.
	part: bool
}

extend Checker {
	/// Notes the call `id` where it copies the whole text of a `String`
	/// variable the function owns, `String::of(name.toStr())`, or clones a
	/// variable the function owns or a field of one, `spot.clone()`.
	var fn recordCopy(id: ExprId, callee: FnId, args: &[ExprId], state: &var State) = {
		if args.len() != 1 then return
		val body = self.body
		val known = &self.program.preludeItems
		val (local, cloned, part) = if known.function(.StringOf) == callee {
			val .Call(callee: toStr, args: inner, ..) = body.exprs[args[0]].kind else return
			if inner.len() != 1 then return
			if known.function(.StringToStr) != toStr then return
			val receiver = match body.exprs[inner[0]].kind {
				.Ref(e) => e
				_ => inner[0]
			}
			val .Local(local) = body.exprs[receiver].kind else return
			if !self.program.isString(body.locals[local].ty) then return
			(local, Option<u32>::None, false)
		} else {
			if !self.isCloneMethod(callee) then return
			val .Ref(receiver) = body.exprs[args[0]].kind else return
			// What owns memory and is the function's to give: plain data is
			// E0464's, where the call is written, and a type parameter's value
			// may be either.
			val ty = body.exprs[receiver].ty
			if self.program.types.isGeneric(ty) || !self.program.ownsMemory(ty) then return
			// The variable it is part of, through fields that may be moved
			// out: none of a type with a `destroy`.
			var at = receiver
			while body.exprs[at].kind is .Field(base, ..) {
				if self.program.dropMethod(body.exprs[base].ty).isSome() then return
				at = base
			}
			val .Local(local) = body.exprs[at].kind else return
			if self.program.types.kind(body.locals[local].ty) is .Ref(..) | .Ptr(..) then return
			(local, Option::Some(body.exprs[receiver].span.hi), at != receiver)
		}
		if body.locals[local].kind !is .Param | .Let(..) | .Var then return
		// Something kept borrows it, and would be left with nothing.
		for paths in state.roots.values() {
			for path in paths {
				if path.local == local then return
			}
		}
		val span = body.exprs[id].span
		val copy = Copied(span: span, local: local, cloned: cloned, part: part)
		if !self.copies.any((c) => c.span == span) then self.copies.push(copy)
		val at = state.copied.slot(local, Vec())
		if !state.copied.values()[at].contains(&span) then state.copied.valueAt(at).push(span)
	}

	/// Whether `callee` is an implementation of `Clone`'s `clone`, or an
	/// instance of one.
	fn isCloneMethod(callee: FnId): bool = {
		val def = &self.program.fns[callee]
		if self.interner.resolve(def.name) != "clone" then return false
		val origin = match def.instanceOf {
			.Some((of, _)) => of
			.None => callee
		}
		for i in self.program.impls {
			if self.program.isClone(i.interfaceId) && i.methods.contains(&origin) then return true
		}
		return false
	}

	/// `local` is used: its copies were not its last use. Where it is
	/// assigned, they were, and the old value could have been moved.
	var fn readAfterCopy(local: LocalId, assigned: bool, state: &var State) = {
		val .Some(spans) = state.copied.remove(&local) else return
		if !assigned {
			for span in spans {
				self.copiesRead.add(span)
			}
		}
	}

	/// Warns of each copy that nothing read its variable after.
	var fn reportCopies() = {
		for copy in self.copies.clone() {
			if self.copiesRead.contains(&copy.span) then continue
			val name = self.interner.resolve(self.body.locals[copy.local].name)
			val diagnostic = match copy.cloned {
				.Some(end) => {
					val message =
						if copy.part then
							"a field of `\(name)` is copied here, and `\(name)` is not used again"
						else "`\(name)` is copied here, and not used again"
					Diagnostic::warning(
						COPIED_AT_LAST_USE,
						message,
						copy.span,
						"a copy",
					).withFix("remove `.clone()`, which moves it", [
						Edit::replace(Span::new(end, copy.span.hi), ""),
					]).withNote(
						"a value that owns memory is moved where it is given, and is copied only where it is still wanted",
					)
				}
				.None => Diagnostic::warning(
					COPIED_AT_LAST_USE,
					"`\(name)` is copied here, and not used again",
					copy.span,
					"a copy of `\(name)`'s text",
				).withFix(
					"give `\(name)` itself, which moves it",
					[Edit::replace(copy.span, name)],
				).withNote(
					"a `String` given where one is kept is moved, and its text is copied only where the `String` is still wanted",
				)
			}
			self.diagnostics.push(diagnostic)
		}
	}
}
