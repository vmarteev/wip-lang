// A `String` copied where it could have been moved.
//
// Text given where a `String` is expected is copied into one, and so is
// `String::of(name.toStr())`. Where the text is the whole of a `String` the
// function owns, and nothing reads that variable after the copy on some
// path, the variable itself could have been given, and moved: the copy is a
// warning (E0448). A copy stays unread until a use of the variable — a read,
// a borrow, a move — reads it; assigning it a new value does not, since the
// old one could have been moved first.

import hir::{ExprId, FnId, KnownFn, LocalId}
import syntax::{Diagnostic, Edit, STRING_COPIED}

extend Checker {
	/// Notes the call `id` where it copies the whole text of a `String`
	/// variable the function owns: `String::of(name.toStr())`.
	var fn recordCopy(id: ExprId, callee: FnId, args: &[ExprId], state: &var State) = {
		val known = &self.program.preludeItems
		if known.function(.StringOf) != .Some(callee) then return
		val body = self.body
		if args.len() != 1 then return
		val .Call(callee: toStr, args: inner, ..) = body.exprs[args[0]].kind else {
			return
		}
		if inner.len() != 1 then return
		if known.function(.StringToStr) != .Some(toStr) then return
		val receiver = match body.exprs[inner[0]].kind {
			.Ref(e) => e
			_ => inner[0]
		}
		val .Local(local) = body.exprs[receiver].kind else {
			return
		}
		val owned = body.locals[local].kind is .Param | .Let(..) | .Var
		if !owned || !self.program.isString(body.locals[local].ty) then return
		// Something kept borrows it, and would be left with nothing.
		for paths in state.roots.values() {
			for path in paths {
				if path.local == local then return
			}
		}
		val span = body.exprs[id].span
		val copy = (span, local)
		if !self.copies.contains(&copy) then self.copies.push(copy)
		val at = state.copied.slot(local, Vec())
		if !state.copied.values()[at].contains(&span) then state.copied.valueAt(at).push(span)
	}

	/// `local` is used: its copies were not its last use. Where it is
	/// assigned, they were, and the old value could have been moved.
	var fn readAfterCopy(local: LocalId, assigned: bool, state: &var State) = {
		val .Some(spans) = state.copied.remove(&local) else {
			return
		}
		if !assigned {
			for span in spans {
				self.copiesRead.add(span)
			}
		}
	}

	/// Warns of each copy that nothing read its variable after.
	var fn reportCopies() = {
		for (span, local) in self.copies.clone() {
			if self.copiesRead.contains(&span) then continue
			val name = self.interner.resolve(self.body.locals[local].name)
			self.diagnostics.push(
				Diagnostic::warning(
					STRING_COPIED,
					"`\(name)` is copied here, and not used again",
					span,
					"a copy of `\(name)`'s text",
				).withFix(
					"give `\(name)` itself, which moves it",
					own [Edit::replace(span, "move \(name)")],
				).withNote(
					"a `String` given where one is kept is moved, and its text is copied only where the `String` is still wanted",
				),
			)
		}
	}
}
