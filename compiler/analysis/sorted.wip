// Maps and sets kept in the order of their keys, for what the analysis
// tracks at each point of a body. Which moved place a use meets first, and
// which root a view is reported by, are the first in that order; and two
// states are compared entry by entry where a loop is iterated to its fixed
// point. The library's `Map` and `Set` keep the order their keys went in,
// which is the order the paths through a body were checked in.

/// Keys and the values under them, in the order of the keys.
@derive(Eq, Clone)
struct SortedMap<K: Ord, V> {
	keyList: Vec<K> = Vec()
	valueList: Vec<V> = Vec()
}

extend SortedMap<K, V> {
	/// The keys, in order.
	fn keys(): &[K] = lend self.keyList.items()

	/// The values, in the order of their keys.
	fn values(): &[V] = lend self.valueList.items()

	fn len(): i64 = self.keyList.len()

	fn isEmpty(): bool = self.keyList.isEmpty()

	/// The value at position `at`, to read or to write.
	lend fn valueAt(at: i64): &V = lend self.valueList[at]

	fn contains(key: &K): bool = self.keyList.items().binarySearch(&key).isOk()

	/// The value under `key`, or nothing where the map does not hold it.
	fn get(key: &K): Option<&V> = match self.keyList.items().binarySearch(&key) {
		.Ok(at) => .Some(&self.valueList[at])
		.Err(_) => .None
	}

	/// Puts `value` under `key`, dropping the value that was there.
	var fn put(key: K, value: V) keeps key, value = match self.keyList.items().binarySearch(&key) {
		.Ok(at) => self.valueList[at] = move value
		.Err(at) => {
			self.keyList.insert(at, move key)
			self.valueList.insert(at, move value)
		}
	}

	/// Where `key`'s entry is, put there first with `value` where there was
	/// none: the value is then written with `valueAt`.
	var fn slot(key: K, value: V): i64 keeps key, value = match self.keyList.items().binarySearch(
		&key,
	) {
		.Ok(at) => at
		.Err(at) => {
			self.keyList.insert(at, move key)
			self.valueList.insert(at, move value)
			at
		}
	}

	/// Takes `key` out, with the value it held.
	var fn remove(key: &K): Option<V> = match self.keyList.items().binarySearch(&key) {
		.Ok(at) => {
			self.keyList.remove(at)
			Option::Some(self.valueList.remove(at))
		}
		.Err(_) => .None
	}

	/// Keeps the entries `keep` answers `true` for, in their order.
	var fn retain(keep: &(key: &K, value: &V) => bool) = {
		var at = 0
		while at < self.keyList.len() {
			if keep(&self.keyList[at], &self.valueList[at]) {
				at += 1
			} else {
				self.keyList.remove(at)
				self.valueList.remove(at)
			}
		}
	}
}

/// Keys, each held once, in their order.
@derive(Eq, Clone)
struct SortedSet<K: Ord> {
	keyList: Vec<K> = Vec()
}

extend SortedSet<K>: Items<K> {
	// The keys, in order, which is what `for key in set` walks.
	fn items(): &[K] = lend self.keyList.items()
}

extend SortedSet<K> {
	fn len(): i64 = self.keyList.len()

	fn isEmpty(): bool = self.keyList.isEmpty()

	fn contains(key: &K): bool = self.keyList.items().binarySearch(&key).isOk()

	/// Adds `key`, and says whether it was not there already.
	var fn add(key: K): bool keeps key = match self.keyList.items().binarySearch(&key) {
		.Ok(_) => false
		.Err(at) => {
			self.keyList.insert(at, move key)
			true
		}
	}
}
