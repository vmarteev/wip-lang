// A field of a packed struct may lie at an address its type's alignment
// does not promise, and a reference is always aligned. It is plain data, so
// a `&` of it lends a copy, which nothing can tell from the field; a
// `&var`, or a `lend`, would write where no reference can point, and is
// refused.

import hir::{ExprId}
import syntax::{Diagnostic, PACKED_FIELD_LENT}

extend Checker {
	/// Reports each `&var`, and each `lend`, of a place inside a packed struct.
	var fn checkPackedLends() = {
		val body = self.body
		for expr in body.exprs {
			val place = match expr.kind {
				.Ref(inner) if self.program.types.kind(expr.ty) is .Ref(kind: .Var, ..) => inner
				.Lend(place: inner) => inner
				_ => continue
			}
			val .Some(field) = self.packedField(place) else continue
			val name = self.interner.resolve(self.fieldName(field))
			self.report(
				Diagnostic::error(
					PACKED_FIELD_LENT,
					"`\(name)` lies in a packed struct, so it is not lent to be written",
					expr.span,
					"lent here",
				).withNote("a field of a `@packed` struct may lie at an address no reference can point at; copy it out, `var \(name) = …`, lend the copy, and write it back"),
			)
		}
	}

	/// The field of a packed struct that `place` lies in, if it lies in
	/// one before a reference is followed.
	fn packedField(place: ExprId): Option<ExprId> = {
		val body = self.body
		var at = place
		while true {
			match body.exprs[at].kind {
				.Field(base, ..) => {
					if self.program.types.kind(body.exprs[base].ty) is .Struct(id, ..) &&
						self.program.structs[id].packed {
						return .Some(at)
					}
					at = base
				}
				.Index(base, ..) | .SubSlice(base, ..) => at = base
				_ => return .None
			}
		}
		return .None
	}

	/// The name of the field a `Field` expression reads.
	fn fieldName(field: ExprId): syntax::Symbol = {
		val body = self.body
		val .Field(base, index) = body.exprs[field].kind else panic("a field")
		val .Struct(id, ..) = self.program.types.kind(body.exprs[base].ty) else panic("a struct")
		return self.program.structs[id].fields[index as i64].name
	}
}
