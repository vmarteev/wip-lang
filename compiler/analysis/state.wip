// The move state: which places are moved out of, and how states merge where
// control flow joins.

import hir::{LocalId}
import std::collections::{SortedMap, SortedSet}
import syntax::{Span}

extend Path {
	/// Whether `self` is `other` or lies inside it.
	fn within(other: &Path): bool = {
		if self.local != other.local || self.projs.len() < other.projs.len() then
			return false

		for i in 0..other.projs.len() do
			if self.projs[i] != other.projs[i] then
				return false

		return true
	}

	/// Whether it stands for what a parameter borrows, which nothing the call
	/// does changes.
	fn isLent(): bool = !self.projs.isEmpty() && self.projs[0] == .Lent

	/// Whether a root and a place overlap, so that changing the place changes
	/// what borrows the root.
	fn overlaps(place: &Path): bool = !self.isLent() && (self.within(&place) || place.within(&self))
}

extend State {
	/// The first moved place that overlaps `path`: one that `path` lies
	/// inside, or one inside `path`. Its position in `moved`.
	fn conflict(path: &Path): Option<i64> = {
		for (i, entry) in self.moved.items().indexed() do
			if path.within(&entry.key) || entry.key.within(&path) then
				return i

		return .None
	}

	var fn recordMove(path: Path, span: Span, name: String, byDefer: bool) = {
		self.moved.retain((moved, _) => !moved.within(&path))
		self.moved.put(path, Moved(definite: true, spans: [span], name:, byDefer:))
	}

	/// `path` has been assigned: it, and everything inside it, holds a value.
	var fn reinit(path: &Path) = self.moved.retain((moved, _) => !moved.within(&path))

	/// The state where control flow from `self` and `other` joins.
	fn merge(other: &State): State = {
		var moved: SortedMap<Path, Moved> = SortedMap()
		for entry in self.moved {
			val path = &entry.key
			val m = &entry.value
			val merged = match other.moved.get(&path) {
				.Some(o) => {
					var spans = m.spans.clone()
					for s in o.spans do
						spans.push(s)

					spans.sortBy((a, b) => a.lo < b.lo || (a.lo == b.lo && a.hi < b.hi))
					spans.dedup()
					Moved(
						definite: m.definite && o.definite,
						spans:,
						name: m.name.clone(),
						byDefer: m.byDefer || o.byDefer,
					)
				}
				.None => Moved(
					definite: false,
					spans: m.spans.clone(),
					name: m.name.clone(),
					byDefer: m.byDefer,
				)
			}
			moved.put(path.clone(), merged)
		}
		for entry in other.moved {
			if !self.moved.contains(&entry.key) {
				val o = &entry.value
				moved.put(
					entry.key.clone(),
					Moved(
						definite: false,
						spans: o.spans.clone(),
						name: o.name.clone(),
						byDefer: o.byDefer,
					),
				)
			}
		}
		// A variable borrows whatever it borrows on any path here.
		var roots = self.roots.clone()
		for entry in other.roots do
			addPaths(&var roots.atOrPut(entry.key, SortedSet()), &entry.value)

		// Stale on every path, or only on some, as a move is.
		var stale: SortedMap<LocalId, Stale> = SortedMap()
		for entry in self.stale {
			val local = entry.key
			val s = &entry.value
			val definite =
				s.definite &&
				match other.stale.get(&local) {
					.Some(o) => o.definite
					.None => false
				}
			stale.put(local, Stale(definite:, change: s.change, how: s.how, root: s.root.clone()))
		}
		for entry in other.stale {
			if !stale.contains(&entry.key) {
				val o = &entry.value
				stale.put(entry.key, Stale(
					definite: false,
					change: o.change,
					how: o.how,
					root: o.root.clone(),
				))
			}
		}
		// A closure writes whatever it writes on any path here.
		var writes = self.writes.clone()
		for entry in other.writes do
			addPaths(&var writes.atOrPut(entry.key, SortedSet()), &entry.value)

		// A copy is unread where it is unread on any path.
		var copied = self.copied.clone()
		for entry in other.copied do
			addSpans(&var copied.atOrPut(entry.key, Vec()), &entry.value)

		// A place may still hold what it held where it may on any path.
		var filled = self.filled.clone()
		for path in other.filled do
			filled.add(path.clone())

		return State(moved:, roots:, stale:, writes:, copied:, filled:)
	}
}

/// Each of `from`'s paths added to `into`.
fn addPaths(into: &var SortedSet<Path>, from: &SortedSet<Path>) = {
	for path in from do
		into.add(path.clone())
}

/// Each of `from`'s spans added to `into`, where it is not there already.
fn addSpans(into: &var Vec<Span>, from: &Vec<Span>) = {
	for span in from do
		if !into.contains(&span) then
			into.push(span)
}
