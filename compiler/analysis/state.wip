// The move state: which places are moved out of, and how states merge where
// control flow joins.

import hir::{LocalId}
import syntax::{Span}

extend Path {
	/// Whether `self` is `other` or lies inside it.
	fn within(other: &Path): bool = {
		if self.local != other.local || self.projs.len() < other.projs.len() then return false
		for i in 0..other.projs.len() {
			if self.projs[i] != other.projs[i] then return false
		}
		return true
	}

	/// Whether it stands for what a parameter borrows, which nothing the call
	/// does changes.
	fn isLent(): bool = !self.projs.isEmpty() && self.projs[0] == .Lent

	/// Whether a root and a place overlap, so that changing the place changes
	/// what borrows the root.
	fn overlaps(place: &Path): bool = !self.isLent() && (self.within(&place) || place.within(&self))
}

extend State {
	/// The first moved place that overlaps `path`: one that `path` lies
	/// inside, or one inside `path`. Its position in `moved`.
	fn conflict(path: &Path): Option<i64> = {
		for (i, moved) in self.moved.keys().forwards().enumerate() {
			if path.within(&moved) || moved.within(&path) then return .Some(i)
		}
		return .None
	}

	var fn recordMove(path: Path, span: Span, name: String, byDefer: bool) = {
		self.moved.retain((moved, _) => !moved.within(&path))
		self.moved.put(
			move path,
			Moved(definite: true, spans: Vec::of(own [span]), name: move name, byDefer: byDefer),
		)
	}

	/// `path` has been assigned: it, and everything inside it, holds a value.
	var fn reinit(path: &Path) = self.moved.retain((moved, _) => !moved.within(&path))

	/// The state where control flow from `self` and `other` joins.
	fn merge(other: &State): State = {
		var moved: SortedMap<Path, Moved> = SortedMap()
		for (i, path) in self.moved.keys().forwards().enumerate() {
			val m = &self.moved.values()[i]
			val merged = match other.moved.get(&path) {
				.Some(o) => {
					var spans = m.spans.clone()
					for s in o.spans {
						spans.push(s)
					}
					spans.sortBy((a, b) => a.lo < b.lo || (a.lo == b.lo && a.hi < b.hi))
					spans.dedup()
					Moved(
						definite: m.definite && o.definite,
						spans: move spans,
						name: m.name.clone(),
						byDefer: m.byDefer || o.byDefer,
					)
				}
				.None => Moved(
					definite: false,
					spans: m.spans.clone(),
					name: m.name.clone(),
					byDefer: m.byDefer,
				)
			}
			moved.put(path.clone(), move merged)
		}
		for (i, path) in other.moved.keys().forwards().enumerate() {
			if !self.moved.contains(&path) {
				val o = &other.moved.values()[i]
				moved.put(
					path.clone(),
					Moved(
						definite: false,
						spans: o.spans.clone(),
						name: o.name.clone(),
						byDefer: o.byDefer,
					),
				)
			}
		}
		// A variable borrows whatever it borrows on any path here.
		var roots = self.roots.clone()
		for (i, local) in other.roots.keys().forwards().enumerate() {
			val at = roots.slot(local, SortedSet())
			for path in other.roots.values()[i] {
				roots.valueAt(at).add(path.clone())
			}
		}
		// Stale on every path, or only on some, as a move is.
		var stale: SortedMap<LocalId, Stale> = SortedMap()
		for (i, local) in self.stale.keys().forwards().enumerate() {
			val s = &self.stale.values()[i]
			val definite =
				s.definite &&
				match other.stale.get(&local) {
					.Some(o) => o.definite
					.None => false
				}
			stale.put(local, Stale(
				definite: definite,
				change: s.change,
				how: s.how,
				root: s.root.clone(),
			))
		}
		for (i, local) in other.stale.keys().forwards().enumerate() {
			if !stale.contains(&local) {
				val o = &other.stale.values()[i]
				stale.put(local, Stale(
					definite: false,
					change: o.change,
					how: o.how,
					root: o.root.clone(),
				))
			}
		}
		// A copy is unread where it is unread on any path.
		var copied = self.copied.clone()
		for (i, local) in other.copied.keys().forwards().enumerate() {
			val at = copied.slot(local, Vec())
			for span in other.copied.values()[i] {
				if !copied.values()[at].contains(&span) then copied.valueAt(at).push(span)
			}
		}
		return State(moved: move moved, roots: move roots, stale: move stale, copied: move copied)
	}
}
