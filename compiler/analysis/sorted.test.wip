// Maps and sets kept in the order of their keys, whatever order the keys
// went in.

@test
fn aMapKeepsItsKeysInOrder() = {
	var map: SortedMap<i64, String> = SortedMap()
	map.put(3, "three")
	map.put(1, "one")
	map.put(2, "two")
	assert(map.keys() == [1, 2, 3])
	assert(map.values()[0] == "one")
	// A key put again keeps its place, with the new value.
	map.put(1, "uno")
	assert(map.len() == 3)
	assert(map.get(1) is .Some(value) && value == "uno")
	assert(map.get(4).isNone())
}

@test
fn aSlotIsWhereAKeyIs() = {
	var map: SortedMap<i64, Vec<i64>> = SortedMap()
	val at = map.slot(5, Vec())
	map.valueAt(at).push(50)
	// The key is there now, and its value is kept.
	assert(map.slot(5, Vec()) == at)
	assert(map.slot(2, Vec()) == 0)
	assert(map.keys() == [2, 5])
	assert(map.values()[1].items() == [50])
}

@test
fn entriesAreRemovedAndKept() = {
	var map: SortedMap<i64, i64> = SortedMap()
	for key in 0..6 {
		map.put(key, key * 10)
	}
	assert(map.remove(2) == .Some(20))
	assert(map.remove(2) == .None)
	map.retain((key, _) => key % 2 == 1)
	assert(map.keys() == [1, 3, 5])
	assert(map.contains(3) && !map.contains(4))
}

@test
fn aSetHoldsEachKeyOnceInOrder() = {
	var set: SortedSet<i64> = SortedSet()
	assert(set.add(3))
	assert(set.add(1))
	assert(!set.add(3))
	var keys: Vec<i64> = Vec()
	for key in set {
		keys.push(key)
	}
	assert(keys.items() == [1, 3])
	assert(set.contains(1) && !set.contains(2))
}

@test
fn twoMapsAreEqualWhereTheirEntriesAre() = {
	var first: SortedMap<i64, i64> = SortedMap()
	var second: SortedMap<i64, i64> = SortedMap()
	first.put(1, 10)
	first.put(2, 20)
	second.put(2, 20)
	second.put(1, 10)
	assert(first == second)
	second.put(1, 11)
	assert(first != second)
}
