// Where a byte offset is, as a line and a column.

@test
fn columnsCountCharsNotBytes() = {
	val src = "ab\n\"é\" x\n"
	val index = LineIndex::new(src)
	assert(index.lineCol(src, 0) == (1, 1))
	assert(index.lineCol(src, 2) == (1, 3))
	assert(index.lineCol(src, 3) == (2, 1))
	// `é` is two bytes, so `x` is at byte 8 but column 5.
	assert(index.lineCol(src, 8) == (2, 5))
	assert(index.lineCol(src, src.len() as u32) == (3, 1))
}
