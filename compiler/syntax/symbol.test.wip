// The well-known symbols are where the parser, which has no interner, names
// them.

@test
fn wellKnownSymbolsAreWhereTheParserExpects() = {
	val interner = Interner::new()
	assert(interner.resolve(Symbol::text()) == "text#")
	assert(interner.resolve(Symbol::stringType()) == "String")
	assert(interner.resolve(Symbol::withCapacity()) == "withCapacity")
	assert(interner.resolve(Symbol::push()) == "push")
	assert(interner.resolve(Symbol::appendTo()) == "appendTo")
	assert(interner.resolve(Symbol::intoBuffer()) == "intoBuffer")
	assert(interner.resolve(Symbol::generator()) == "generator#")
	assert(interner.resolve(Symbol::defaultCode()) == "default#")
	assert(interner.resolve(Symbol::state()) == "state#")
	assert(interner.resolve(Symbol::next()) == "next")
	assert(interner.resolve(Symbol::of()) == "of")
	assert(interner.resolve(Symbol::ignored()) == "_")
	assert(interner.resolve(Symbol::appendFitted()) == "appendFitted")
	val [width, fill, align] = Symbol::fittingOptions()
	assert(interner.resolve(width) == "width")
	assert(interner.resolve(fill) == "fill")
	assert(interner.resolve(align) == "align")
	assert(interner.resolve(Symbol::some()) == "Some")
	val [precision, radix, withPrecision, inRadix] = Symbol::written()
	assert(interner.resolve(precision) == "precision" && interner.resolve(radix) == "radix")
	assert(
		interner.resolve(withPrecision) == "withPrecision" &&
			interner.resolve(inRadix) == "inRadix",
	)
	assert(interner.resolve(Symbol::upper()) == "upper")
	assert(interner.resolve(Symbol::fromWord()) == "from")
	val [unsigned, signed] = Symbol::indexOf()
	assert(interner.resolve(unsigned) == "indexOfUnsigned")
	assert(interner.resolve(signed) == "indexOfSigned")
}

// A string interned twice is one symbol, and another interner's strings are
// numbered here as if they had been interned here.
@test
fn absorbingNumbersAsOneInterner() = {
	var first = Interner::new()
	val a = first.intern("alpha")
	assert(first.intern("alpha") == a)
	var second = Interner::new()
	val b = second.intern("beta")
	val map = first.absorb(&second)
	assert(first.resolve(map[b.index()]) == "beta")
	assert(map[Symbol::text().index()] == Symbol::text())
}
