// The table of codes: each names one rule, and says what it is.

/// A code names one rule: no number is taken twice, none is one that
/// was retired, and the table is in the order of the numbers, as a
/// reader looks one up.
@test
fn everyNumberNamesOneRule() = {
	for i in 1..ALL.len() {
		assert(ALL[i - 1].number < ALL[i].number, "\(ALL[i - 1]) before \(ALL[i])")
	}
	for code in ALL {
		assert(code.number > 0 && code.number < 10000, "\(code) is not E and four digits")
		for retired in RETIRED {
			assert(code.text() != retired, "\(code) was retired")
		}
	}
}

/// Each says what it is, in a sentence.
@test
fn everyCodeSaysWhatItIs() = {
	for code in ALL {
		assert(code.meaning().endsWith("."), "\(code): \(code.meaning())")
		assert(Code::named(code.text().toStr()) == .Some(code))
	}
	assert(Code::named("E0110") == .None, "a retired code is no code")
}
