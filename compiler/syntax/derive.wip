// What `@derive` writes: for each struct and enum of a module that asks, an
// `extend Type: Interface` whose method is ordinary code, built as
// syntax-tree nodes after the module is parsed and checked as the
// program's own code is. A field then compares or clones by whatever
// implementation its type has, generic or not.
//
// Every node is placed at the `@derive` argument that asked for it, in the
// programmer's own source, and the block says so (`ExtendBlock.derived`):
// the checker reports what keeps a derive from applying where the field is
// written, and an editor passes over what the programmer did not write.
//
// All seven are written here: `Eq` and `Ord`, `Hash`, `Text`, `Clone`,
// `Encode` and `Decode`.

import std::mem

/// What `@derive` writes for the types of one module, whose files are
/// `files`: one more syntax tree of the module, with an `extend` block for
/// each interface a type asks for. Empty where no type asks.
pub fn expand(files: &[Parsed], interner: &var Interner): Ast = {
	val names = Names::new(&var interner)
	// The builder holds the interner while it runs, and gives it back.
	var builder = Builder(
		out: Ast(),
		interner: mem::replace(&var interner, Interner::new()),
		names: names,
		at: Span::new(0, 0),
	)
	// The imports copied so far, each by its path and the name it binds.
	var imported: Vec<String> = Vec()
	for file in files {
		val decodes = builder.decodes
		for item in file.ast.items {
			match item {
				// An `extern union`'s fields lie over the same bytes, so
				// none of them is the value to compare or to clone.
				.Struct(decl) if !decl.isUnion => builder.derives(
					&decl.annotations,
					decl.name.sym,
					&decl.generics,
					&item,
					&file.ast,
				)
				.Enum(decl) => builder.derives(
					&decl.annotations,
					decl.name.sym,
					&decl.generics,
					&item,
					&file.ast,
				)
				// A struct inside an `extern "C"` block is C's layout, and asks
				// for what it compares, writes and clones as any struct does.
				.Extern(block) => {
					for decl in block.structs {
						if decl.isUnion then continue
						val inside = Item::Struct(decl.clone())
						builder.derives(
							&decl.annotations,
							decl.name.sym,
							&decl.generics,
							&inside,
							&file.ast,
						)
					}
				}
				_ => {}
			}
		}
		// `Decode` names each field's type, as the file that asked imports
		// it: the file's imports, one name at a time, are the derived code's
		// too.
		if builder.decodes > decodes then builder.copyImports(&file.ast, &var imported)
	}
	interner = builder.interner
	return builder.out
}

/// The interfaces written here.
@derive(Eq, Clone)
enum Derive {
	Eq
	Ord
	Hash
	Text
	Clone
	Encode
	Decode
}

extend Derive {
	fn interfaceOf(names: &Names): Symbol = match self {
		.Eq => names.eq
		.Ord => names.ord
		.Hash => names.hash
		.Text => names.text
		.Clone => names.cloneInterface
		.Encode => names.encodeInterface
		.Decode => names.decodeInterface
	}
}

/// The names the expansion writes: the prelude's, which no program can
/// declare again (E0345), `derive` to find what asks, and the names its
/// methods bind, which hold a `#` no program can write.
struct Names {
	derive: Symbol
	eq: Symbol
	equals: Symbol
	ord: Symbol
	compare: Symbol
	ordering: Symbol
	less: Symbol
	same: Symbol
	more: Symbol
	hash: Symbol
	hashInto: Symbol
	hasher: Symbol
	writeInt: Symbol
	out: Symbol
	text: Symbol
	appendTo: Symbol
	string: Symbol
	push: Symbol
	cloneInterface: Symbol
	clone: Symbol
	cloneOf: Symbol
	boolType: Symbol
	other: Symbol
	order: Symbol
	/// `Self`, which names the type without looking its name up: a type
	/// whose name was refused is still the one that asked.
	selfType: Symbol
	encodeInterface: Symbol
	decodeInterface: Symbol
	encode: Symbol
	decode: Symbol
	encoder: Symbol
	decoder: Symbol
	/// The derived methods' own type parameters, `E#` and `D#`, which no
	/// type's parameter can be called.
	encoderParam: Symbol
	decoderParam: Symbol
	into: Symbol
	from: Symbol
	result: Symbol
	error: Symbol
	ok: Symbol
	err: Symbol
	none: Symbol
	beginRecord: Symbol
	field: Symbol
	endRecord: Symbol
	beginVariant: Symbol
	endVariant: Symbol
	missing: Symbol
	unknown: Symbol
	toStr: Symbol
	option: Symbol
	made: Symbol
	variantName: Symbol
}

extend Names {
	static fn new(interner: &var Interner): Names = Names(
		derive: interner.intern("derive"),
		eq: interner.intern("Eq"),
		equals: Symbol::equalsMethod(),
		ord: interner.intern("Ord"),
		compare: Symbol::compareMethod(),
		ordering: interner.intern("Ordering"),
		less: interner.intern("Less"),
		same: interner.intern("Same"),
		more: interner.intern("More"),
		hash: interner.intern("Hash"),
		hashInto: Symbol::hashIntoMethod(),
		hasher: interner.intern("Hasher"),
		writeInt: interner.intern("writeInt"),
		out: interner.intern("out"),
		text: interner.intern("Text"),
		appendTo: Symbol::appendTo(),
		string: Symbol::stringType(),
		push: Symbol::push(),
		cloneInterface: interner.intern("Clone"),
		clone: interner.intern("clone"),
		cloneOf: interner.intern("cloneOf"),
		boolType: interner.intern("bool"),
		other: interner.intern("other"),
		order: interner.intern("order#"),
		selfType: interner.selfTypeSymbol(),
		encodeInterface: interner.intern("Encode"),
		decodeInterface: interner.intern("Decode"),
		encode: interner.intern("encode"),
		decode: interner.intern("decode"),
		encoder: interner.intern("Encoder"),
		decoder: interner.intern("Decoder"),
		encoderParam: interner.intern("E#"),
		decoderParam: interner.intern("D#"),
		into: interner.intern("into"),
		from: interner.intern("from"),
		result: interner.intern("Result"),
		error: interner.intern("Error"),
		ok: interner.intern("Ok"),
		err: interner.intern("Err"),
		none: interner.intern("None"),
		beginRecord: interner.intern("beginRecord"),
		field: interner.intern("field"),
		endRecord: interner.intern("endRecord"),
		beginVariant: interner.intern("beginVariant"),
		endVariant: interner.intern("endVariant"),
		missing: interner.intern("missing"),
		unknown: interner.intern("unknown"),
		toStr: interner.intern("toStr"),
		option: interner.intern("Option"),
		made: interner.intern("made#"),
		variantName: interner.intern("variant#"),
	)
}

/// Where `@derive` names `interface`, if it does: the argument's span.
fn asks(annotations: &[Annotation], names: &Names, wanted: Symbol): Option<Span> = {
	for annotation in annotations {
		if annotation.name.sym != names.derive then continue
		for arg in annotation.args {
			if arg.value == .Name(wanted) then return .Some(arg.span)
		}
	}
	return .None
}

/// A piece of what `Text` writes: text as it is, or a value that writes
/// itself.
enum TextPiece {
	Text(text: String)
	Value(value: ExprId)
}

/// Which side of a comparison a variant's fields are bound for: `self`'s,
/// or the other value's.
@derive(Eq, Clone)
enum Side {
	This
	Other
}

/// Builds the nodes of one derived block into `out`, each placed at `at`.
struct Builder {
	out: Ast
	interner: Interner
	names: Names
	at: Span
	/// How many `decode`s it has written.
	decodes: i64 = 0
}

extend Builder {
	/// The blocks a struct or an enum asks for, each placed at the argument
	/// of `@derive` that names its interface, into `out`.
	var fn derives(
		annotations: &[Annotation],
		name: Symbol,
		generics: &[GenericParam],
		item: &Item,
		source: &Ast,
	) = {
		for derive in [
			Derive::Eq,
			Derive::Ord,
			Derive::Hash,
			Derive::Text,
			Derive::Clone,
			Derive::Encode,
			Derive::Decode,
		] {
			// An enum with no variants has no value to clone from.
			if derive == .Clone && item is .Enum(decl) && decl.variants.isEmpty() then continue
			val .Some(at) = asks(&annotations, &self.names, derive.interfaceOf(&self.names)) else {
				continue
			}
			self.at = at
			val block = self.block(derive, name, &generics, &item, &source)
			self.out.items.push(.Extend(block))
		}
	}

	/// `extend Type<T: Interface>: Interface { fn method(…): … = body }`:
	/// the type's parameters are bound by the interface, so each field of a
	/// parameter's type has it, and keep what the type binds them by, as in
	/// any `extend` of it.
	var fn block(
		derive: Derive,
		ty: Symbol,
		generics: &[GenericParam],
		item: &Item,
		source: &Ast,
	): ExtendBlock = {
		val names = self.names
		// What the method takes that the other derives' do not: type
		// parameters of its own, and no receiver.
		var ownGenerics: Vec<GenericParam> = Vec()
		var receiver = Receiver::Read
		val made: (Symbol, Vec<Param>, Option<TypeId>, ExprId) = match derive {
			// `fn equals(other: &Self): bool`
			.Eq => {
				val body = match item {
					.Struct(decl) => {
						val pairs = self.fieldPairs(&decl.fields)
						self.allEqual(pairs)
					}
					.Enum(decl) => self.eqVariants(&decl.variants)
					_ => panic("a struct or an enum")
				}
				val ret = self.namedType(names.boolType)
				(names.equals, [self.otherParam()], .Some(ret), body)
			}
			// `fn compare(other: &Self): Ordering`
			.Ord => {
				val body = match item {
					.Struct(decl) => {
						val pairs = self.fieldPairs(&decl.fields)
						self.firstDifference(pairs)
					}
					.Enum(decl) => self.ordVariants(&decl.variants)
					_ => panic("a struct or an enum")
				}
				val ret = self.namedType(names.ordering)
				(names.compare, [self.otherParam()], .Some(ret), body)
			}
			// `fn hashInto(out: &var Hasher)`
			.Hash => {
				val body = match item {
					.Struct(decl) => {
						var parts: Vec<ExprId> = Vec()
						for field in decl.fields {
							val this = self.expr(.SelfRef)
							parts.push(self.field(this, field.name.sym))
						}
						self.hashParts(.None, parts)
					}
					.Enum(decl) => self.hashVariants(&decl.variants)
					_ => panic("a struct or an enum")
				}
				(names.hashInto, [self.outParam(names.hasher)], .None, body)
			}
			// `fn appendTo(out: &var String)`
			.Text => {
				val body = match item {
					.Struct(decl) => self.textStruct(ty, &decl.fields)
					.Enum(decl) => self.textVariants(&decl.variants)
					_ => panic("a struct or an enum")
				}
				(names.appendTo, [self.outParam(names.string)], .None, body)
			}
			// `fn clone(): Self`
			.Clone => {
				val body = match item {
					.Struct(decl) => self.cloneStruct(&decl.fields)
					.Enum(decl) => self.cloneVariants(&decl.variants)
					_ => panic("a struct or an enum")
				}
				val ret = self.namedType(names.selfType)
				(names.clone, Vec(), .Some(ret), body)
			}
			// `fn encode<E#: Encoder>(into: &var E#)`
			.Encode => {
				val body = match item {
					.Struct(decl) => self.encodeStruct(ty, &decl.fields)
					.Enum(decl) => self.encodeVariants(ty, &decl.variants)
					_ => panic("a struct or an enum")
				}
				ownGenerics.push(self.ownParam(names.encoderParam, names.encoder))
				(names.encode, [self.lentParam(names.into, names.encoderParam)], .None, body)
			}
			// `static fn decode<D#: Decoder>(from: &var D#): Result<Self, D#::Error>`
			.Decode => {
				val body = match item {
					.Struct(decl) => self.decodeStruct(ty, &decl.fields, &source)
					.Enum(decl) => self.decodeVariants(ty, &decl.variants, &source)
					_ => panic("a struct or an enum")
				}
				ownGenerics.push(self.ownParam(names.decoderParam, names.decoder))
				receiver = .Static
				self.decodes += 1
				val decoded = self.namedType(names.selfType)
				val failed = self.out.types.add(Type(
					kind: .Path(
						segments: [self.name(names.decoderParam), self.name(names.error)],
						args: Vec(),
					),
					span: self.at,
				))
				val ret = self.out.types.add(Type(
					kind: .Named(name: names.result, args: [decoded, failed]),
					span: self.at,
				))
				(names.decode, [self.lentParam(names.from, names.decoderParam)], .Some(ret), body)
			}
		}
		val (method, params, ret, body) = move made
		val implemented = derive.interfaceOf(&names)
		var bound: Vec<GenericParam> = Vec()
		for param in generics {
			bound.push(GenericParam(
				decided: .None,
				name: self.name(param.name.sym),
				bounds: [
					Bound(module: Vec(), name: self.name(implemented), args: Vec(), span: self.at),
				],
				default: .None,
				span: self.at,
			))
		}
		val declared = FnDecl(
			annotations: Vec(),
			sig: FnSig(
				name: self.name(method),
				generics: ownGenerics,
				params: params,
				variadic: .None,
				ret: ret,
				lendsFrom: Vec(),
				keeps: Vec(),
				span: self.at,
			),
			body: .Some(body),
			isPub: false,
			pubSpan: .None,
			receiver: .Some((receiver, self.at)),
			span: self.at,
		)
		return ExtendBlock(
			annotations: Vec(),
			sliceOf: .None,
			boxed: .None,
			interfaceName: .Some(self.name(implemented)),
			interfaceModule: Vec(),
			interfaceArgs: .None,
			path: [self.name(ty)],
			generics: bound,
			methods: [declared],
			derived: .Some(self.at),
			span: self.at,
		)
	}

	// ---- Eq ----

	/// `a == c && b == d`, and `true` where there is nothing to compare.
	var fn allEqual(pairs: Vec<(ExprId, ExprId)>): ExprId = {
		var all: Option<ExprId> = .None
		for (this, other) in pairs {
			val equal = self.binary(.Eq, this, other)
			all = .Some(
				match all {
					.Some(before) => self.binary(.And, before, equal)
					.None => equal
				},
			)
		}
		return match all {
			.Some(all) => all
			.None => self.expr(.Bool(true))
		}
	}

	/// `match self { .Circle(r: self#r) => match other { .Circle(r: other#r) => self#r == other#r  _ => false } … }`.
	var fn eqVariants(variants: &[Variant]): ExprId = {
		var arms: Vec<Arm> = Vec()
		for variant in variants {
			val (inner, pairs) = self.boundPairs(&variant)
			val same = self.allEqual(pairs)
			var inside = Vec::of([self.arm(inner, same)])
			if variants.len() > 1 {
				val differ = self.expr(.Bool(false))
				inside.push(self.arm(self.wildcard(), differ))
			}
			val other = self.other()
			val body = self.expr(.Match(scrutinee: other, arms: inside))
			val outer = self.bound(&variant, .This)
			arms.push(self.arm(outer, body))
		}
		val this = self.expr(.SelfRef)
		return self.expr(.Match(scrutinee: this, arms: arms))
	}

	// ---- Ord ----

	/// The first of `a.compare(&c)`, `b.compare(&d)`, … that is not `.Same`,
	/// and `.Same` where every one is:
	/// `match a.compare(&c) { .Same => b.compare(&d)  order# => order# }`.
	var fn firstDifference(pairs: Vec<(ExprId, ExprId)>): ExprId = {
		if pairs.isEmpty() then return self.variant(self.names.same)
		val (lastThis, lastOther) = pairs[pairs.len() - 1]
		var rest = self.compareCall(lastThis, lastOther)
		var i = pairs.len() - 1
		while i > 0 {
			i -= 1
			val (this, other) = pairs[i]
			val order = self.compareCall(this, other)
			val same = self.variantPattern(self.names.same, .None)
			val differs = Pattern(kind: .Binding(self.names.order), span: self.at)
			val answer = self.expr(.Name(self.names.order))
			val arms = Vec::of([self.arm(same, rest), self.arm(differs, answer)])
			rest = self.expr(.Match(scrutinee: order, arms: arms))
		}
		return rest
	}

	/// `match self { .Dot => match other { .Dot => .Same  .Circle(..) => .More  _ => .Less } … }`:
	/// two values of one variant by their fields, and of two by the order
	/// the variants are written in.
	var fn ordVariants(variants: &[Variant]): ExprId = {
		var arms: Vec<Arm> = Vec()
		for (i, variant) in variants.forwards().enumerate() {
			val (inner, pairs) = self.boundPairs(&variant)
			val order = self.firstDifference(pairs)
			var inside = Vec::of([self.arm(inner, order)])
			// A variant written before this one: `self` comes after it.
			if i > 0 {
				var before: Vec<Pattern> = Vec()
				for j in 0..i {
					before.push(self.anyOf(&variants[j]))
				}
				val pattern =
					if before.len() == 1 then before.remove(0)
					else Pattern(kind: .Any(before), span: self.at)
				val more = self.variant(self.names.more)
				inside.push(self.arm(pattern, more))
			}
			// One written after it: `self` comes first.
			if i + 1 < variants.len() {
				val less = self.variant(self.names.less)
				inside.push(self.arm(self.wildcard(), less))
			}
			val other = self.other()
			val body = self.expr(.Match(scrutinee: other, arms: inside))
			val outer = self.bound(&variant, .This)
			arms.push(self.arm(outer, body))
		}
		val this = self.expr(.SelfRef)
		return self.expr(.Match(scrutinee: this, arms: arms))
	}

	/// `this.compare(&other)`.
	var fn compareCall(this: ExprId, other: ExprId): ExprId = {
		val callee = self.field(this, self.names.compare)
		val lent = self.expr(.Unary(op: .Ref, opSpan: self.at, operand: other))
		return self.expr(.Call(callee: callee, args: [lent], names: [Option::None], rest: .None))
	}

	// ---- Hash ----

	/// `{ out.writeInt(1)  self#x.hashInto(&var out)  … }`: a variant's
	/// number, where there is one, and then each part in turn.
	var fn hashParts(number: Option<i64>, parts: Vec<ExprId>): ExprId = {
		var stmts: Vec<StmtId> = Vec()
		if number is .Some(number) {
			val out = self.expr(.Name(self.names.out))
			val callee = self.field(out, self.names.writeInt)
			val n = self.expr(.Int(number as u128))
			val written = self.expr(.Call(
				callee: callee,
				args: [n],
				names: [Option::None],
				rest: .None,
			))
			stmts.push(self.stmt(written))
		}
		for part in parts {
			val callee = self.field(part, self.names.hashInto)
			val lent = self.lentOut()
			val hashed = self.expr(.Call(
				callee: callee,
				args: [lent],
				names: [Option::None],
				rest: .None,
			))
			stmts.push(self.stmt(hashed))
		}
		return self.expr(.Block(Block(stmts: stmts, span: self.at)))
	}

	/// `match self { .Circle(r: self#r) => { out.writeInt(0)  self#r.hashInto(&var out) } … }`:
	/// which variant it is, as the number it is written as, then what it
	/// holds.
	var fn hashVariants(variants: &[Variant]): ExprId = {
		var arms: Vec<Arm> = Vec()
		for (i, variant) in variants.forwards().enumerate() {
			var parts: Vec<ExprId> = Vec()
			for field in variant.fields {
				val bound = self.binding(field.name.sym, .This)
				parts.push(self.expr(.Name(bound)))
			}
			val body = self.hashParts(.Some(i), parts)
			val pattern = self.bound(&variant, .This)
			arms.push(self.arm(pattern, body))
		}
		val this = self.expr(.SelfRef)
		return self.expr(.Match(scrutinee: this, arms: arms))
	}

	// ---- Text ----

	/// `{ out.push("Point(x: ")  self.x.appendTo(&var out)  out.push(")") }`:
	/// the call that would make the value.
	var fn textStruct(ty: Symbol, fields: &[Field]): ExprId = {
		val name = String::of(self.interner.resolve(ty))
		if fields.isEmpty() then return self.written([TextPiece::Text("\(name)()")])
		var pieces = Vec::of([TextPiece::Text("\(name)(")])
		for (i, field) in fields.forwards().enumerate() {
			val fieldName = String::of(self.interner.resolve(field.name.sym))
			val before = if i == 0 then "" else ", "
			pieces.push(.Text("\(before)\(fieldName): "))
			val this = self.expr(.SelfRef)
			pieces.push(.Value(self.field(this, field.name.sym)))
		}
		pieces.push(.Text(")"))
		return self.written(pieces)
	}

	/// `match self { .Circle(r: self#r) => { out.push(".Circle(r: ")  self#r.appendTo(&var out)  out.push(")") } … }`:
	/// the variant as a program writes it.
	var fn textVariants(variants: &[Variant]): ExprId = {
		var arms: Vec<Arm> = Vec()
		for variant in variants {
			val name = String::of(self.interner.resolve(variant.name.sym))
			var pieces: Vec<TextPiece> = Vec()
			if variant.fields.isEmpty() then pieces.push(.Text(".\(name)")) else {
				pieces.push(.Text(".\(name)("))
				for (i, field) in variant.fields.forwards().enumerate() {
					val fieldName = String::of(self.interner.resolve(field.name.sym))
					val before = if i == 0 then "" else ", "
					pieces.push(.Text("\(before)\(fieldName): "))
					val bound = self.binding(field.name.sym, .This)
					pieces.push(.Value(self.expr(.Name(bound))))
				}
				pieces.push(.Text(")"))
			}
			val body = self.written(pieces)
			val pattern = self.bound(&variant, .This)
			arms.push(self.arm(pattern, body))
		}
		val this = self.expr(.SelfRef)
		return self.expr(.Match(scrutinee: this, arms: arms))
	}

	/// `{ out.push("…")  value.appendTo(&var out)  … }`.
	var fn written(pieces: Vec<TextPiece>): ExprId = {
		var stmts: Vec<StmtId> = Vec()
		for piece in move pieces {
			val call = match move piece {
				.Text(text) => {
					val out = self.expr(.Name(self.names.out))
					val callee = self.field(out, self.names.push)
					val symbol = self.interner.intern(text)
					val literal = self.expr(.Str(symbol))
					self.expr(.Call(
						callee: callee,
						args: [literal],
						names: [Option::None],
						rest: .None,
					))
				}
				.Value(value) => {
					val callee = self.field(value, self.names.appendTo)
					val lent = self.lentOut()
					self.expr(.Call(
						callee: callee,
						args: [lent],
						names: [Option::None],
						rest: .None,
					))
				}
			}
			stmts.push(self.stmt(call))
		}
		return self.expr(.Block(Block(stmts: stmts, span: self.at)))
	}

	// ---- Clone ----

	/// `Self(x: self.x.clone(), …)`.
	var fn cloneStruct(fields: &[Field]): ExprId = {
		var names: Vec<Option<Name>> = Vec()
		var args: Vec<ExprId> = Vec()
		for field in fields {
			val this = self.expr(.SelfRef)
			val place = self.field(this, field.name.sym)
			val value = self.cloned(place)
			names.push(.Some(self.name(field.name.sym)))
			args.push(value)
		}
		val callee = self.expr(.Name(self.names.selfType))
		return self.expr(.Call(callee: callee, args: args, names: names, rest: .None))
	}

	/// `match self { .Circle(r: self#r) => .Circle(r: self#r.clone()) … }`.
	var fn cloneVariants(variants: &[Variant]): ExprId = {
		var arms: Vec<Arm> = Vec()
		for variant in variants {
			val path = self.expr(.Path(
				leadingDot: true,
				segments: [self.name(variant.name.sym)],
				typeArgs: .None,
			))
			val body = if variant.fields.isEmpty() then path else {
				var args: Vec<ExprId> = Vec()
				for field in variant.fields {
					val bound = self.binding(field.name.sym, .This)
					val named = self.expr(.Name(bound))
					args.push(self.cloned(named))
				}
				val names: Vec<Option<Name>> = variant.fields.map((field) => .Some(
					self.name(field.name.sym),
				))
				self.expr(.Call(callee: path, args: args, names: names, rest: .None))
			}
			val pattern = self.bound(&variant, .This)
			arms.push(self.arm(pattern, body))
		}
		val this = self.expr(.SelfRef)
		return self.expr(.Match(scrutinee: this, arms: arms))
	}

	/// A field's value in the clone: `cloneOf(&value)`, the prelude's clone
	/// of a value of the field's own type. A method call, `value.clone()`,
	/// would look through a field that is a `&T` to what it refers to; this
	/// clones the `&T`, which is the reference copied.
	var fn cloned(value: ExprId): ExprId = {
		val callee = self.expr(.Name(self.names.cloneOf))
		val lent = self.expr(.Unary(op: .Ref, opSpan: self.at, operand: value))
		return self.expr(.Call(callee: callee, args: [lent], names: [Option::None], rest: .None))
	}

	// ---- Encode ----

	/// `{ into.beginRecord("Name", 2)  into.field("x")  self.x.encode(&var into)  …  into.endRecord() }`.
	var fn encodeStruct(ty: Symbol, fields: &[Field]): ExprId = {
		var stmts: Vec<StmtId> = Vec()
		val typeName = self.text(ty)
		val count = self.expr(.Int(fields.len() as u128))
		stmts.push(
			self.stmt(self.callOn(self.names.into, self.names.beginRecord, [typeName, count])),
		)
		for field in fields {
			val this = self.expr(.SelfRef)
			val value = self.field(this, field.name.sym)
			self.encodeField(field.name.sym, value, &var stmts)
		}
		stmts.push(self.stmt(self.callOn(self.names.into, self.names.endRecord, Vec())))
		return self.expr(.Block(Block(stmts: stmts, span: self.at)))
	}

	/// `match self { .Letter(char: self#char) => { into.beginVariant("Key", "Letter", 1)  into.beginRecord("Letter", 1)  …  into.endRecord()  into.endVariant() } … }`:
	/// a variant's fields as a record of its name, inside the variant.
	var fn encodeVariants(ty: Symbol, variants: &[Variant]): ExprId = {
		var arms: Vec<Arm> = Vec()
		for variant in variants {
			var stmts: Vec<StmtId> = Vec()
			val count = variant.fields.len()
			val typeName = self.text(ty)
			val variantName = self.text(variant.name.sym)
			val counted = self.expr(.Int(count as u128))
			stmts.push(
				self.stmt(
					self.callOn(self.names.into, self.names.beginVariant, [
						typeName,
						variantName,
						counted,
					]),
				),
			)
			if count > 0 {
				val recordName = self.text(variant.name.sym)
				val fieldCount = self.expr(.Int(count as u128))
				stmts.push(
					self.stmt(
						self.callOn(self.names.into, self.names.beginRecord, [
							recordName,
							fieldCount,
						]),
					),
				)
				for field in variant.fields {
					val bound = self.binding(field.name.sym, .This)
					val value = self.expr(.Name(bound))
					self.encodeField(field.name.sym, value, &var stmts)
				}
				stmts.push(self.stmt(self.callOn(self.names.into, self.names.endRecord, Vec())))
			}
			stmts.push(self.stmt(self.callOn(self.names.into, self.names.endVariant, Vec())))
			val body = self.expr(.Block(Block(stmts: stmts, span: self.at)))
			val pattern = self.bound(&variant, .This)
			arms.push(self.arm(pattern, body))
		}
		val this = self.expr(.SelfRef)
		return self.expr(.Match(scrutinee: this, arms: arms))
	}

	/// `into.field("x")  value.encode(&var into)`.
	var fn encodeField(name: Symbol, value: ExprId, stmts: &var Vec<StmtId>) = {
		val named = self.text(name)
		stmts.push(self.stmt(self.callOn(self.names.into, self.names.field, [named])))
		val callee = self.field(value, self.names.encode)
		val into = self.expr(.Name(self.names.into))
		val lent = self.expr(.Unary(op: .RefVar, opSpan: self.at, operand: into))
		stmts.push(self.stmt(self.call(callee, [lent])))
	}

	// ---- Decode ----

	/// `{ from.beginRecord("Name")?  val made#: Self = Self(x: …, …)  from.endRecord()?  return .Ok(move made#) }`.
	var fn decodeStruct(ty: Symbol, fields: &[Field], source: &Ast): ExprId = {
		var stmts: Vec<StmtId> = Vec()
		val typeName = self.text(ty)
		stmts.push(
			self.stmt(self.tried(self.callOn(self.names.from, self.names.beginRecord, [typeName]))),
		)
		var args: Vec<ExprId> = Vec()
		var names: Vec<Option<Name>> = Vec()
		for field in fields {
			args.push(self.fieldRead(&field, .None, &source))
			names.push(.Some(self.name(field.name.sym)))
		}
		val callee = self.expr(.Name(self.names.selfType))
		val literal = self.expr(.Call(callee: callee, args: args, names: names, rest: .None))
		self.finishDecoded(literal, &var stmts, true, false)
		return self.expr(.Block(Block(stmts: stmts, span: self.at)))
	}

	/// `{ val variant#: String = from.beginVariant("Key")?  match variant#.toStr() { "Letter" => { … } … _ => return .Err(from.unknown("Key", variant#)) } }`:
	/// a variant by its name, its fields a record of that name.
	var fn decodeVariants(ty: Symbol, variants: &[Variant], source: &Ast): ExprId = {
		var stmts: Vec<StmtId> = Vec()
		val typeName = self.text(ty)
		val begun = self.tried(self.callOn(self.names.from, self.names.beginVariant, [typeName]))
		stmts.push(
			self.out.stmts.add(Stmt(
				kind: .Let(
					mutable: false,
					isImplicit: false,
					name: self.name(self.names.variantName),
					ty: .None,
					init: begun,
				),
				span: self.at,
			)),
		)
		var arms: Vec<Arm> = Vec()
		for variant in variants {
			var armStmts: Vec<StmtId> = Vec()
			val path = self.variant(variant.name.sym)
			var made = path
			if !variant.fields.isEmpty() {
				val recordName = self.text(variant.name.sym)
				armStmts.push(
					self.stmt(
						self.tried(
							self.callOn(self.names.from, self.names.beginRecord, [recordName]),
						),
					),
				)
				var args: Vec<ExprId> = Vec()
				var names: Vec<Option<Name>> = Vec()
				for field in variant.fields {
					args.push(self.fieldRead(&field, .Some(variant.name.sym), &source))
					names.push(.Some(self.name(field.name.sym)))
				}
				made = self.expr(.Call(callee: path, args: args, names: names, rest: .None))
			}
			self.finishDecoded(made, &var armStmts, !variant.fields.isEmpty(), true)
			val body = self.expr(.Block(Block(stmts: armStmts, span: self.at)))
			arms.push(self.arm(Pattern(kind: .Str(variant.name.sym), span: self.at), body))
		}
		// Another name is the format's error.
		val typeAgain = self.text(ty)
		val found = self.expr(.Name(self.names.variantName))
		val unknown = self.callOn(self.names.from, self.names.unknown, [typeAgain, found])
		arms.push(self.arm(self.wildcard(), self.returned(self.result(self.names.err, unknown))))
		val held = self.expr(.Name(self.names.variantName))
		val text = self.call(self.field(held, self.names.toStr), Vec())
		stmts.push(self.stmt(self.expr(.Match(scrutinee: text, arms: arms))))
		return self.expr(.Block(Block(stmts: stmts, span: self.at)))
	}

	/// `val made#: Self = value  from.endRecord()?  from.endVariant()?  return .Ok(move made#)`:
	/// the record ended where there is one, and the variant where the value
	/// is one.
	var fn finishDecoded(value: ExprId, stmts: &var Vec<StmtId>, record: bool, variant: bool) = {
		val selfTy = self.namedType(self.names.selfType)
		stmts.push(
			self.out.stmts.add(Stmt(
				kind: .Let(
					mutable: false,
					isImplicit: false,
					name: self.name(self.names.made),
					ty: .Some(selfTy),
					init: value,
				),
				span: self.at,
			)),
		)
		if record then
			stmts.push(
				self.stmt(self.tried(self.callOn(self.names.from, self.names.endRecord, Vec()))),
			)
		if variant then
			stmts.push(
				self.stmt(self.tried(self.callOn(self.names.from, self.names.endVariant, Vec()))),
			)
		val made = self.expr(.Name(self.names.made))
		val moved = self.expr(.Unary(op: .Move, opSpan: self.at, operand: made))
		stmts.push(
			self.out.stmts.add(Stmt(
				kind: .Return(value: .Some(self.result(self.names.ok, moved))),
				span: self.at,
			)),
		)
	}

	/// A field's value as decoding reads it: `if from.field("x")? { T::decode(&var from)? } else { … }`,
	/// what is not there its default, `.None` where it is an `Option`, and
	/// otherwise the format's error, `return .Err(from.missing("x"))`.
	var fn fieldRead(field: &Field, variant: Option<Symbol>, source: &Ast): ExprId = {
		val named = self.text(field.name.sym)
		val asked = self.tried(self.callOn(self.names.from, self.names.field, [named]))
		val read = self.decodeOf(field.ty, &source)
		val thenBlock = Block(stmts: [self.stmt(read)], span: self.at)
		val isOption = source.types[field.ty].kind is .Named(name, ..) && name == self.names.option
		val missing: ExprId = when {
			field.default.isSome() => {
				val inVariant: Option<Name> = variant.map((v) => self.name(v))
				self.expr(.FieldDefault(variant: inVariant, field: self.name(field.name.sym)))
			}
			isOption => self.variant(self.names.none)
			else => {
				val absent = self.text(field.name.sym)
				val error = self.callOn(self.names.from, self.names.missing, [absent])
				self.returned(self.result(self.names.err, error))
			}
		}
		return self.expr(.If(
			cond: asked,
			thenBlock: thenBlock,
			elseBranch: .Some(missing),
			form: .Written,
		))
	}

	/// `T::decode(&var from)?` for a field of type `T`, written as the
	/// field's type is, `Map<String, Key>::decode`, and `own` around the
	/// decoding of what an `own<T>` holds. A type with no name to call it by
	/// — an array, a reference — has none, which the checker reports at the
	/// field as one that does not decode.
	var fn decodeOf(ty: TypeId, source: &Ast): ExprId = match source.types[ty].kind {
		.Named(name, args) => self.decodeCall([self.name(name)], &args, &source)
		.Path(segments, args) => self.decodeCall(segments.clone(), &args, &source)
		.Own(inner) => {
			val held = self.decodeOf(inner, &source)
			self.expr(.Unary(op: .Own, opSpan: self.at, operand: held))
		}
		_ => self.expr(.Error)
	}

	/// `segments<args>::decode(&var from)?`.
	var fn decodeCall(segments: Vec<Name>, args: &[TypeId], source: &Ast): ExprId = {
		var path: Vec<Name> = segments.map((segment) => self.name(segment.sym))
		// After the type's own segment, which the type arguments are of.
		val after = path.len() - 1
		path.push(self.name(self.names.decode))
		val copied: Vec<TypeId> = args.map((arg) => self.copyType(arg, &source))
		val typeArgs: Option<TypeArgs> =
			if copied.isEmpty() then .None
			else .Some(TypeArgs(after: after as i64, args: copied, span: self.at))
		val callee = self.expr(.Path(leadingDot: false, segments: path, typeArgs: typeArgs))
		val from = self.expr(.Name(self.names.from))
		val lent = self.expr(.Unary(op: .RefVar, opSpan: self.at, operand: from))
		return self.tried(self.call(callee, [lent]))
	}

	/// The type `ty` of `source`, written again in what is derived.
	var fn copyType(ty: TypeId, source: &Ast): TypeId = {
		val kind: TypeKind = match source.types[ty].kind {
			.Named(name, args) => .Named(name: name, args: self.copyTypes(&args, &source))
			.Path(segments, args) => .Path(
				segments: segments.map((segment) => self.name(segment.sym)),
				args: self.copyTypes(&args, &source),
			)
			.Own(inner) => .Own(self.copyType(inner, &source))
			.Ref(isVar, inner) => .Ref(isVar: isVar, inner: self.copyType(inner, &source))
			.Slice(elem) => .Slice(self.copyType(elem, &source))
			_ => .Error
		}
		return self.out.types.add(Type(kind: kind, span: self.at))
	}

	var fn copyTypes(types: &[TypeId], source: &Ast): Vec<TypeId> = {
		val copied: Vec<TypeId> = types.map((t) => self.copyType(t, &source))
		return copied
	}

	/// The imports of `source` not already copied, one name each.
	var fn copyImports(source: &Ast, imported: &var Vec<String>) = {
		for item in source.items {
			val .Import(decl) = item else continue
			var path: Vec<String> = Vec()
			for segment in decl.path {
				path.push(String::of(self.interner.resolve(segment.sym)))
			}
			val module = path.join("::")
			match decl.items {
				.Some(names) => {
					for name in names {
						val bound = match name.alias {
							.Some(alias) => alias.sym
							.None => match name.name {
								.Some(n) => n.sym
								.None => decl.path[decl.path.len() - 1].sym
							}
						}
						val key = "\(module) \(self.interner.resolve(bound))"
						if imported.contains(&key) then continue
						imported.push(key)
						self.out.items.push(
							.Import(ImportDecl(
								path: decl.path.clone(),
								alias: .None,
								items: .Some([name.clone()]),
								span: decl.span,
							)),
						)
					}
				}
				.None => {
					val key = "\(module) \(if decl.alias is .Some(a) then self.interner.resolve(a.sym) else "")"
					if imported.contains(&key) then continue
					imported.push(key)
					self.out.items.push(.Import(decl.clone()))
				}
			}
		}
	}

	// ---- what Encode and Decode share ----

	/// `"text"`, a literal of a name: the symbol is the text.
	var fn text(sym: Symbol): ExprId = self.expr(.Str(sym))

	/// `receiver.method(args)`, the receiver a name.
	var fn callOn(receiver: Symbol, method: Symbol, args: Vec<ExprId>): ExprId = {
		val named = self.expr(.Name(receiver))
		return self.call(self.field(named, method), args)
	}

	/// `callee(args)`, each by position.
	var fn call(callee: ExprId, args: Vec<ExprId>): ExprId = {
		var names: Vec<Option<Name>> = Vec()
		for _ in args {
			names.push(.None)
		}
		return self.expr(.Call(callee: callee, args: args, names: names, rest: .None))
	}

	/// `value?`.
	var fn tried(value: ExprId): ExprId = self.expr(.Try(value))

	/// `.Ok(value)` or `.Err(value)`.
	var fn result(which: Symbol, value: ExprId): ExprId = self.call(self.variant(which), [value])

	/// `{ return value }`.
	var fn returned(value: ExprId): ExprId = {
		val leave = self.out.stmts.add(Stmt(kind: .Return(value: .Some(value)), span: self.at))
		return self.expr(.Block(Block(stmts: [leave], span: self.at)))
	}

	/// `E#: Encoder`: a derived method's own type parameter.
	var fn ownParam(name: Symbol, bound: Symbol): GenericParam = GenericParam(
		decided: .None,
		name: self.name(name),
		bounds: [Bound(module: Vec(), name: self.name(bound), args: Vec(), span: self.at)],
		default: .None,
		span: self.at,
	)

	/// `into: &var E#`.
	var fn lentParam(name: Symbol, ty: Symbol): Param = {
		val inner = self.namedType(ty)
		val lent = self.out.types.add(Type(kind: .Ref(isVar: true, inner: inner), span: self.at))
		return Field(
			isPub: false,
			isVar: false,
			name: self.name(name),
			ty: lent,
			default: .None,
			span: self.at,
		)
	}

	/// `other: &Self`.
	var fn otherParam(): Param = {
		val inner = self.namedType(self.names.selfType)
		val ty = self.out.types.add(Type(kind: .Ref(isVar: false, inner: inner), span: self.at))
		return Field(
			isPub: false,
			isVar: false,
			name: self.name(self.names.other),
			ty: ty,
			default: .None,
			span: self.at,
		)
	}

	/// `out: &var Hasher`, or `out: &var String`: what is written into.
	var fn outParam(into: Symbol): Param = {
		val inner = self.namedType(into)
		val ty = self.out.types.add(Type(kind: .Ref(isVar: true, inner: inner), span: self.at))
		return Field(
			isPub: false,
			isVar: false,
			name: self.name(self.names.out),
			ty: ty,
			default: .None,
			span: self.at,
		)
	}

	/// `&var out`.
	var fn lentOut(): ExprId = {
		val out = self.expr(.Name(self.names.out))
		return self.expr(.Unary(op: .RefVar, opSpan: self.at, operand: out))
	}

	var fn stmt(value: ExprId): StmtId = self.out.stmts.add(Stmt(kind: .Expr(value), span: self.at))

	var fn other(): ExprId = self.expr(.Name(self.names.other))

	/// `(self.x, other.x)` for each field.
	var fn fieldPairs(fields: &[Field]): Vec<(ExprId, ExprId)> = {
		var pairs: Vec<(ExprId, ExprId)> = Vec()
		for field in fields {
			val this = self.expr(.SelfRef)
			val thisField = self.field(this, field.name.sym)
			val other = self.other()
			val otherField = self.field(other, field.name.sym)
			pairs.push((thisField, otherField))
		}
		return pairs
	}

	/// The variant as `other` is matched against it, its fields bound, and
	/// each field of `self`'s beside the same field of `other`'s.
	var fn boundPairs(variant: &Variant): (Pattern, Vec<(ExprId, ExprId)>) = {
		val pattern = self.bound(&variant, .Other)
		var pairs: Vec<(ExprId, ExprId)> = Vec()
		for field in variant.fields {
			val this = self.binding(field.name.sym, .This)
			val other = self.binding(field.name.sym, .Other)
			val thisName = self.expr(.Name(this))
			val otherName = self.expr(.Name(other))
			pairs.push((thisName, otherName))
		}
		return (pattern, pairs)
	}

	/// `self#field` or `other#field`: a name no program can write, so it
	/// shadows nothing.
	var fn binding(field: Symbol, side: Side): Symbol = {
		val prefix = if side == .This then "self" else "other"
		val text = "\(prefix)#\(self.interner.resolve(field))"
		return self.interner.intern(text)
	}

	/// `.Circle(r: self#r)`, or `.Dot` for a variant that carries nothing.
	var fn bound(variant: &Variant, side: Side): Pattern = {
		var binders: Option<Vec<Binder>> = .None
		if !variant.fields.isEmpty() {
			var listed: Vec<Binder> = Vec()
			for field in variant.fields {
				val bound = self.binding(field.name.sym, side)
				listed.push(Binder(
					field: self.name(field.name.sym),
					pattern: .Some(Pattern(kind: .Binding(bound), span: self.at)),
					span: self.at,
				))
			}
			binders = .Some(listed)
		}
		return self.variantPattern(variant.name.sym, binders)
	}

	/// `.Circle(..)`, or `.Dot`: the variant, whatever it holds.
	fn anyOf(variant: &Variant): Pattern = {
		val rest = !variant.fields.isEmpty()
		return Pattern(
			kind: .Variant(
				leadingDot: true,
				segments: [self.name(variant.name.sym)],
				binders: if rest then .Some(Vec()) else .None,
				rest: rest,
			),
			span: self.at,
		)
	}

	fn variantPattern(name: Symbol, binders: Option<Vec<Binder>>): Pattern = Pattern(
		kind: .Variant(
			leadingDot: true,
			segments: [self.name(name)],
			binders: binders,
			rest: false,
		),
		span: self.at,
	)

	fn wildcard(): Pattern = Pattern(kind: .Wildcard, span: self.at)

	fn arm(pattern: Pattern, body: ExprId): Arm = Arm(
		pattern: pattern,
		guard: .None,
		body: body,
		span: self.at,
	)

	/// `.Same`, of the type expected where it stands.
	var fn variant(name: Symbol): ExprId = self.expr(.Path(
		leadingDot: true,
		segments: [self.name(name)],
		typeArgs: .None,
	))

	var fn binary(op: BinaryOp, lhs: ExprId, rhs: ExprId): ExprId = self.expr(.Binary(
		op: op,
		opSpan: self.at,
		lhs: lhs,
		rhs: rhs,
		wrapping: false,
	))

	var fn namedType(name: Symbol): TypeId = self.out.types.add(Type(
		kind: .Named(name: name, args: Vec()),
		span: self.at,
	))

	fn name(sym: Symbol): Name = Name(sym: sym, span: self.at)

	var fn expr(kind: ExprKind): ExprId = self.out.exprs.add(Expr(kind: kind, span: self.at))

	/// `base.name`.
	var fn field(base: ExprId, name: Symbol): ExprId = {
		val named = self.name(name)
		return self.expr(.Field(base: base, name: named))
	}
}
