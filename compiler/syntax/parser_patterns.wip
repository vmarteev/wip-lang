// `match` arms and patterns.

/// One element inside a variant pattern's parentheses.
enum BinderElem {
	Field(binder: Binder)
	/// `..`: the fields the pattern does not name are ignored.
	Rest(span: Span)
}

fn startsBinder(kind: TokenKind): bool =
	kind is .Ident(..) | .DotDot | .Underscore || canStartPattern(kind)

extend Parser {
	var fn arm(): Arm = {
		val pattern = self.pattern()
		// `if …` between the pattern and `=>`: a guard.
		// The condition holds no struct literal, since a `{` there would
		// read as the arm's body (grammar R1), and no lambda, since its
		// `=>` is the arm's.
		val guard: Option<ExprId> = if self.eat(.If) then .Some(self.guardCond()) else .None
		val body = self.arrowBody()
		return Arm(
			span: pattern.span.to(self.exprSpan(body)),
			pattern: pattern,
			guard: guard,
			body: body,
		)
	}

	/// An arm's `=>` and its body: an expression, or a jump — `=> return
	/// x`, `=> break`, `=> continue` — which ends the function or the loop,
	/// and is a block of that one statement. A `match`'s arm and a `when`'s.
	var fn arrowBody(): ExprId = {
		if !self.eat(.FatArrow) {
			val diagnostic = self.expected("`=>`")
			self.report(diagnostic)
			// `->` and `=` are the likely typos; treat them as `=>`.
			if self.peek() is .Arrow | .Eq then self.bump()
		}
		// The arm's value stands among the arms: a line that starts with `.`
		// and reads as the next arm is that, not a chain on this value.
		val saved = self.arms
		self.arms = true
		val body = if self.peek() is .Return | .Become | .Break | .Continue {
			val start = self.span()
			var stmts: Vec<StmtId> = Vec()
			if self.stmt() is .Some(stmt) then stmts.push(stmt)
			val span = start.to(self.prevSpan())
			self.allocExpr(.Block(block: Block(stmts: stmts, span: span)), span)
		} else self.expr()
		self.arms = saved
		return body
	}

	/// A pattern, or several separated by `|`: the value matches where it
	/// matches any one of them.
	var fn pattern(): Pattern = {
		val first = self.onePattern()
		if !self.at(.Pipe) then return first
		val start = first.span
		var alternatives = Vec::of([first])
		while self.eat(.Pipe) {
			alternatives.push(self.onePattern())
		}
		return Pattern(kind: .Any(alternatives: alternatives), span: start.to(self.prevSpan()))
	}

	var fn onePattern(): Pattern = {
		val start = self.span()
		// `..0`, `'a'..='z'`, `MIN..`: a range.
		if self.peek() is .DotDot | .DotDotEq || self.startsRange() {
			val lo: Option<RangeBound> =
				if self.peek() is .DotDot | .DotDotEq then .None else self.rangeBound()
			val kind = self.rangeRest(lo)
			return Pattern(kind: kind, span: start.to(self.prevSpan()))
		}
		val kind: PatternKind = match self.peek() {
			// A number, a `bool` or text the value must equal.
			.Int | .Float | .Minus => self.numberPattern()
			.True => {
				self.bump()
				PatternKind::Bool(value: true)
			}
			.False => {
				self.bump()
				PatternKind::Bool(value: false)
			}
			.Str(symbol) => {
				self.bump()
				PatternKind::Str(symbol: symbol)
			}
			// A character the value must equal.
			.Char(value) => {
				self.bump()
				PatternKind::Char(value: value)
			}
			// A byte the value must equal.
			.Byte(value) => {
				self.bump()
				PatternKind::Byte(value: value)
			}
			.Underscore => {
				self.bump()
				PatternKind::Wildcard
			}
			// `var name`: a variable of its own.
			.Var => match self.varName() {
				.Some(name) => PatternKind::Binding(symbol: name.sym, isVar: true)
				.None => .Error
			}
			// `.Variant`, whose enum is the type being matched.
			.Dot => {
				self.bump()
				match self.name("a variant name") {
					.Some(variant) => self.variantPattern(true, [variant])
					.None => .Error
				}
			}
			.Ident(symbol) => match self.nth(1) {
				.ColonColon => {
					var segments = Vec::of([Name(sym: symbol, span: self.bump())])
					var broken = false
					while self.eat(.ColonColon) {
						match self.name("a name after `::`") {
							.Some(name) => segments.push(name)
							.None => {
								broken = true
								break
							}
						}
					}
					if broken then PatternKind::Error else self.variantPattern(false, segments)
				}
				// `Point(x, y)`: a struct taken apart, or a variant whose
				// enum was left out — which one is a question for the
				// checker.
				.LParen => {
					val name = Name(sym: symbol, span: self.bump())
					self.variantPattern(false, [name])
				}
				_ => {
					self.bump()
					PatternKind::Binding(symbol: symbol, isVar: false)
				}
			}
			// `(x, y)`: a tuple taken apart by position, or a struct by its
			// fields' names, which the checker tells apart by the type.
			.LParen => {
				val (binders, rest) = self.binders()
				PatternKind::Parens(binders: binders, rest: rest)
			}
			// `[first, ..rest]`: the elements of an array or a slice.
			.LBracket => self.slicePattern()
			_ => {
				val diagnostic = self.expected("a pattern").withNote(
					"a pattern is `_`, a name, `(x, y)`, `[a, ..]`, or `.Variant(…)`",
				)
				self.report(diagnostic)
				return Pattern(kind: .Error, span: Span::at(self.prevSpan().hi))
			}
		}
		return Pattern(kind: kind, span: start.to(self.prevSpan()))
	}

	/// The name after `var` in a pattern, at the `var`: only a name may
	/// follow it, since only a name is a variable.
	var fn varName(): Option<Name> = {
		self.bump()
		if self.peek() is .Ident(symbol) && self.nth(1) !is .LParen | .ColonColon then
			return .Some(Name(sym: symbol, span: self.bump()))
		val diagnostic = self.expected("a name after `var`").withNote(
			"`var` before a name in a pattern makes it a variable; a pattern taken apart is `var` where it is declared, `var (a, b) = value`",
		)
		self.report(diagnostic)
		if self.peek() is .Ident(..) then self.bump()
		return .None
	}

	/// Reports each `var` before a name in a `var` pattern, whose names are
	/// all variables already, with the fix that takes it out.
	var fn varInVarPattern(pattern: &Pattern) = match pattern.kind {
		.Binding(isVar: true, ..) => self.varSaidTwice(pattern.span)
		.Variant(binders: .Some(binders), ..) | .Parens(binders, ..) => {
			for b in binders {
				if b.isVar then self.varSaidTwice(b.span)
				if b.pattern is .Some(inner) then self.varInVarPattern(&inner)
			}
		}
		.Any(alternatives) => {
			for alternative in alternatives {
				self.varInVarPattern(&alternative)
			}
		}
		.Slice(elements) => {
			for element in elements {
				if element is .Pattern(inner) then self.varInVarPattern(&inner)
			}
		}
		_ => {}
	}

	var fn varSaidTwice(span: Span): void = {
		// `var` and the space after it, up to the name.
		val written = self.text(span)
		val end = written.len() - written[3..].trimStart().len()
		val keyword = Span::new(span.lo, span.lo + 3)
		self.report(
			Diagnostic::error(
				VAR_IN_VAR_PATTERN,
				"every name of a `var` pattern is a variable already",
				keyword,
				"said again here",
			).withFix("take it out", [Edit::replace(Span::new(span.lo, span.lo + end as u32), "")]),
		)
	}

	/// `[a, b]`, `[first, ..rest]`, `[.., last]`, at the `[`. `..` with a name
	/// after it binds the elements between; with a number, a character or a
	/// path after it, it is a range, as anywhere else. A name that is a
	/// constant is a range too, which the checker decides, as it decides any
	/// name in a pattern.
	var fn slicePattern(): PatternKind = {
		val open = self.bump()
		val (elements, _) = self.list(
			open,
			.RBracket,
			"a pattern or `..`",
			(kind) => canStartPattern(kind),
			(p) => {
				val restHere =
					p.at(.DotDot) &&
					match p.nth(1) {
						.Ident(..) => p.nth(2) != .ColonColon
						next => !canStartBound(next)
					}
				if !restHere then return .Some(SliceElement::Pattern(pattern: p.pattern()))
				val dots = p.bump()
				var name: Option<Name> = .None
				if p.peek() is .Ident(symbol) then name = .Some(Name(sym: symbol, span: p.bump()))
				return .Some(SliceElement::Rest(name: name, span: dots.to(p.prevSpan())))
			},
		)
		return .Slice(elements: elements)
	}

	/// Whether a range starts here: a bound, then `..` or `..=`.
	var fn startsRange(): bool = {
		var i = 0
		match self.nth(i) {
			.Minus => {
				if self.nth(1) != .Int then return false
				i = 2
			}
			.Int | .Char(..) | .Byte(..) => i = 1
			.Ident(..) => {
				i = 1
				while self.nth(i) == .ColonColon && isIdent(self.nth(i + 1)) {
					i += 2
				}
			}
			_ => return false
		}
		return self.nth(i) is .DotDot | .DotDotEq
	}

	/// One end of a range: a number, a character, a byte, or a constant.
	var fn rangeBound(): Option<RangeBound> = {
		val start = self.span()
		val kind: RangeBoundKind = match self.peek() {
			.Int | .Minus => match self.numberPattern() {
				.Int(negative, magnitude) => .Int(negative: negative, magnitude: magnitude)
				_ => return .None
			}
			.Char(value) => {
				self.bump()
				RangeBoundKind::Char(value: value)
			}
			.Byte(value) => {
				self.bump()
				RangeBoundKind::Byte(value: value)
			}
			.Ident(..) => {
				var path = Vec::of([self.name("a constant")?])
				while self.eat(.ColonColon) {
					path.push(self.name("a name after `::`")?)
				}
				.Const(path: path)
			}
			_ => {
				val diagnostic = self.expected("a number, a character or a constant")
				self.report(diagnostic)
				return .None
			}
		}
		return .Some(RangeBound(kind: kind, span: start.to(self.prevSpan())))
	}

	/// A range from `lo`, at its `..` or `..=`: the end after it, which
	/// `..=` must have and `..` may leave off, as `..` must where `lo` is
	/// off too.
	var fn rangeRest(lo: Option<RangeBound>): PatternKind = {
		val inclusive = self.at(.DotDotEq)
		self.bump()
		val hi: Option<RangeBound> = if canStartBound(self.peek()) then self.rangeBound() else .None
		if hi.isNone() && (inclusive || lo.isNone()) {
			val diagnostic = self.expected("the end of the range").withNote(
				"`lo..=hi` takes its end and must have one; `lo..` has none, and runs to the type's greatest value",
			)
			self.report(diagnostic)
			return .Error
		}
		return .Range(lo: lo, hi: hi, inclusive: inclusive)
	}

	/// A number in a pattern, with the `-` before it where it has one.
	/// A float is reported: two of them may be equal and
	/// have different bytes, and a pattern is an equality.
	var fn numberPattern(): PatternKind = {
		val negative = self.at(.Minus)
		val minus: Option<Span> = if negative then .Some(self.bump()) else .None
		val span = self.span()
		if self.at(.Float) {
			val text = String::of(self.text(span))
			self.bump()
			val diagnostic = Diagnostic::error(
				FLOAT_PATTERN,
				"a pattern cannot be a float",
				match minus {
					.Some(m) => m.to(span)
					.None => span
				},
				"not a pattern",
			).withHelp("test it with `==` or a range: `if x == \(text)`").withNote(
				"two floats may be equal and hold different bytes, and a pattern asks whether a value is one thing",
			)
			self.report(diagnostic)
			return .Error
		}
		return match self.intLiteral("a number") {
			.Some(magnitude) => .Int(negative: negative, magnitude: magnitude)
			.None => .Error
		}
	}

	/// A variant pattern after its name: its binders, if it has parentheses.
	var fn variantPattern(leadingDot: bool, segments: Vec<Name>): PatternKind = {
		if !self.at(.LParen) then
			return .Variant(leadingDot: leadingDot, segments: segments, binders: .None, rest: false)
		val (binders, rest) = self.binders()
		return .Variant(
			leadingDot: leadingDot,
			segments: segments,
			binders: .Some(binders),
			rest: rest,
		)
	}

	/// The binders in parentheses, at the `(`, and whether they end with
	/// `..`: a variant's, a struct's or a tuple's.
	var fn binders(): (Vec<Binder>, bool) = {
		val open = self.bump()
		val (elems, _) = self.list(
			open,
			.RParen,
			"a field name or `..`",
			// A keyword alone, a field's name with no name to bind it under,
			// is reported by the binder.
			(kind) => startsBinder(kind) || isKeyword(kind),
			(p) => p.binderElem(),
		)
		var binders: Vec<Binder> = Vec()
		var rest: Option<Span> = .None
		var misplaced = false
		for elem in move elems {
			match move elem {
				.Field(binder) => {
					if rest is .Some(dots) && !misplaced {
						misplaced = true
						val diagnostic = Diagnostic::error(
							BINDER_AFTER_REST,
							"`..` must come last in a pattern",
							binder.span,
							"named after `..`",
						).withSecondary(dots, "the remaining fields").withHelp(
							"`..` stands for every field the pattern does not name",
						)
						self.report(diagnostic)
					}
					binders.push(binder)
				}
				.Rest(span) => if rest.isNone() then rest = .Some(span)
			}
		}
		return (binders, rest.isSome())
	}

	/// A field name, `field: name`, `..`, or a pattern where no name is
	/// written.
	var fn binderElem(): Option<BinderElem> = match self.peek() {
		.DotDot if !canStartBound(self.nth(1)) => .Some(.Rest(span: self.bump()))
		// `MIN..0`: a range, whose first end may be a constant's name.
		_ if self.startsRange() => {
			val start = self.span()
			val pattern = self.pattern()
			val span = pattern.span
			return .Some(.Field(binder: Binder(
				field: Name(sym: Symbol::positional(), span: start),
				pattern: .Some(pattern),
				span: span,
			)))
		}
		// `_` alone stands for the one field, as any pattern there does;
		// the checker refuses it where the variant has more.
		.Underscore if self.nth(1) is .Comma | .RParen => {
			val span = self.bump()
			return .Some(.Field(binder: Binder(
				field: Name(sym: Symbol::positional(), span: span),
				pattern: .Some(Pattern(kind: .Wildcard, span: span)),
				span: span,
			)))
		}
		.Underscore => {
			val span = self.bump()
			val diagnostic = Diagnostic::error(
				UNDERSCORE_BINDER,
				"`_` is not a binder",
				span,
				"a field name is expected here",
			).withHelp(
				"binders name their fields: leave a field out, and end the pattern with `..`",
			)
			self.report(diagnostic)
			return .None
		}
		// A name followed by `(` or `::` begins a pattern, a struct
		// taken apart or a variant by its path, and is not a field's.
		.Ident(symbol) if self.nth(1) !is .LParen | .ColonColon => {
			val field = Name(sym: symbol, span: self.bump())
			// `field: name` binds it under that name, and a bare name
			// in a pattern is a binding, so one rule covers both.
			val pattern: Option<Pattern> = if self.eat(.Colon) then .Some(self.pattern()) else .None
			return .Some(.Field(binder: Binder(
				field: field,
				pattern: pattern,
				span: field.span.to(self.prevSpan()),
			)))
		}
		// A keyword names a field before `:`, `when: w`, and binds nothing
		// itself.
		_ if self.keywordField() => {
			val field = self.fieldName("a field name")?
			self.bump()
			val pattern = self.pattern()
			return .Some(.Field(binder: Binder(
				field: field,
				pattern: .Some(pattern),
				span: field.span.to(self.prevSpan()),
			)))
		}
		// `var field`: the field, bound to a variable of its own.
		.Var => {
			val start = self.span()
			val field = self.varName()?
			return .Some(.Field(binder: Binder(
				field: field,
				pattern: .None,
				span: start.to(self.prevSpan()),
				isVar: true,
			)))
		}
		// A pattern where a field name could stand: the one field the
		// variant has is the one it tests, as a bare name binds it.
		kind if canStartPattern(kind) => {
			val start = self.span()
			val pattern = self.pattern()
			val span = pattern.span
			return .Some(.Field(binder: Binder(
				field: Name(sym: Symbol::positional(), span: start),
				pattern: .Some(pattern),
				span: span,
			)))
		}
		_ => {
			var diagnostic = self.expected("a field name or `..`")
			// A field a keyword names is bound under a name of its own.
			if isKeyword(self.peek()) &&
				self.nth(1) is .Comma | .RParen &&
				self.peek().text() is .Some(word) {
				diagnostic = diagnostic.withNote("`\(word)` is a keyword, which names a field only before `:`, and a binding cannot have its name").withHelp("bind it under a name of its own: `\(word): name`")
			}
			self.report(diagnostic)
			return .None
		}
	}
}
