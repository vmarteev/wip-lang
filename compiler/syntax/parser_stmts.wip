// Blocks and statements.

extend Parser {
	var fn block(): Block = {
		if !self.at(.LBrace) {
			val diagnostic = self.expected("`{`")
			self.report(diagnostic)
			return Block(stmts: Vec(), span: .at(self.prevSpan().hi))
		}
		val open = self.bump()
		return self.inBraces((p) => p.blockBody(open))
	}

	var fn blockBody(open: Span): Block = {
		var stmts: Vec<StmtId> = Vec()
		while true {
			while self.eat(.Semi) {}
			val kind = self.peek()
			if kind == .RBrace {
				val close = self.bump()
				self.bracePairs.push((open, close))
				return Block(stmts:, span: open.to(close))
			}
			if kind == .Eof || isItemStart(kind) {
				self.unclosedBrace(open)
				return Block(stmts:, span: open.to(self.prevSpan()))
			}
			self.beginRegion()
			if self.leadingOperator() then
				continue

			// A `-` that begins a line below a statement may be one cut short.
			val negGap =
				if !stmts.isEmpty() && kind == .Minus && self.lineBreak() then
					.Some(Span::new(lo: self.prevSpan().hi, hi: self.span().lo))
				else .None
			val before = self.pos
			if self.stmt() is .Some(stmt) {
				stmts.push(stmt)
				if negGap is .Some(gap) then
					self.ast.negLines.put(stmt, NegLine(
						gap:,
						comment: self.text(gap).contains("//"),
					))
			}
			if self.pos == before {
				self.bump()
				continue
			}
			self.stmtSeparator()
		}
		return Block(stmts:, span: open.to(self.prevSpan()))
	}

	/// After a statement: `;`, a line break or `}` must follow (E0112).
	var fn stmtSeparator() = {
		val kind = self.peek()
		if kind is .Semi | .RBrace | .Eof || isItemStart(kind) || self.lineBreak() then
			return

		val diagnostic = Diagnostic::error(
			SEPARATOR,
			"missing `;` between statements on one line",
			self.span(),
			"starts another statement on the same line",
		).withNote("statements on one line are separated by `;`").withFix("add `;`", [
			Edit::insert(self.prevSpan().hi, ";"),
		])
		self.report(diagnostic)
	}

	/// `val pattern = value else { … }`, after the keyword,
	/// or `var`, whose names are variables. The `else` takes a block, or one
	/// jump or expression, as a `then` form's branch is, held as a block of
	/// that one statement.
	var fn guardStmt(mutable: bool, start: Span, refutable: bool): StmtId = {
		val pattern = self.pattern()
		if mutable then
			self.varInVarPattern(&pattern)

		val value = if self.expect(.Eq) then self.expr() else self.errorExpr()
		var elseBlock: Option<Block> = .None
		if self.at(.Else) {
			val elseSpan = self.bump()
			elseBlock = .Some(
				if self.at(.LBrace) then self.block()
				else self.oneExpressionBranch(elseSpan, "`else`"),
			)
		} else if refutable {
			val diagnostic = Diagnostic::error(
				GUARD_SYNTAX,
				if mutable then "a pattern in `var` needs `else`"
				else "a pattern in `val` needs `else`",
				Span::at(self.prevSpan().hi),
				"expected `else { … }` here",
			).withNote(
				"`val pattern = value else { … }` runs the `else` block when the value does not match; the block must leave",
			).withHelp("to test without leaving, write `if value is pattern { … }`")
			self.report(diagnostic)
		}
		val kind = StmtKind::Guard(mutable:, pattern:, value:, elseBlock:)
		val span = start.to(self.prevSpan())
		return self.allocStmt(kind, span)
	}

	/// `break outer`: which loop the jump leaves, where it is not the
	/// innermost. It is on the same line as the keyword.
	var fn jumpLabel(): Option<Name> = {
		if !isIdent(self.peek()) || self.lineBreak() then
			return .None

		return self.name("a loop's name")
	}

	var fn stmt(): Option<StmtId> = {
		val start = self.span()
		// `implicit val` and `implicit var`; anywhere else `implicit` is a
		// name.
		var isImplicit = false
		if isIdent(self.peek()) && self.nthText(0) == "implicit" && self.nth(1) is .Val | .Var {
			self.bump()
			isImplicit = true
		}
		val kind: StmtKind = match self.peek() {
			.Let | .Val | .Var => {
				if self.at(.Let) {
					val span = self.span()
					val diagnostic = Diagnostic::error(
						LET,
						"immutable variables are declared with `val`",
						span,
						"`let` is not used in Wip",
					).withFix("write `val`", [Edit::replace(span, "val")])
					self.report(diagnostic)
				}
				val mutable = self.at(.Var)
				self.bump()
				// `val .Some(x) = value else { … }`, and `val (x, y) =
				// value`, which cannot fail; `var` for each. `val Point(x, y)`
				// is parsed too, for the checker to refuse with its fix.
				val refutable =
					self.at(.Dot) || (isIdent(self.peek()) && self.nth(1) == .ColonColon)
				// `val [a, b] = pair`, or `val [first, ..] = xs else { … }`,
				// which the checker says needs `else`.
				val takesApart =
					self.at(.LParen) ||
					self.at(.LBracket) ||
					(isIdent(self.peek()) && self.nth(1) == .LParen)
				if refutable || takesApart {
					if isImplicit {
						val diagnostic = Diagnostic::error(
							IMPLICIT_NOT_ONE_NAME,
							"an implicit is one name",
							Span::new(start.lo, start.lo + 8),
							"`implicit` before a pattern",
						).withNote(
							"a call fills an implicit parameter from the binding of its name, so an implicit binds one name and nothing else",
						)
						self.report(diagnostic)
					}
					return self.guardStmt(mutable, start, refutable)
				}
				val .Some(name) = self.name("a variable name") else {
					self.skipStmt()
					return .None
				}
				val ty: Option<TypeId> = if self.eat(.Colon) then self.ty() else .None
				val init = if self.expect(.Eq) then self.expr() else self.errorExpr()
				StmtKind::Let(mutable:, isImplicit:, name:, ty:, init:)
			}
			.Defer => {
				self.bump()
				StmtKind::Defer(value: self.expr())
			}
			.Return => {
				self.bump()
				// A line break after `return` means it returns nothing.
				val value: Option<ExprId> =
					if canStartExpr(self.peek()) && !self.lineBreak() then self.expr() else .None
				StmtKind::Return(value:)
			}
			.Become => {
				self.bump()
				StmtKind::Become(call: self.expr())
			}
			// `yield value`: to the list being built.
			.Yield => {
				self.bump()
				StmtKind::Yield(value: self.expr())
			}
			.While => {
				self.bump()
				val cond = self.cond()
				val body = self.loopBody()
				StmtKind::While(label: .None, cond:, body:)
			}
			// `outer: while …`, `outer: for …`: a loop with a name, which
			// `break outer` leaves.
			.Ident(..) if self.nth(1) == .Colon && self.nth(2) is .While | .For => {
				val label = self.name("a name for the loop")?
				self.bump()
				val id = self.stmt()?
				val labelled = match self.ast.stmts[id].kind {
					.While(cond, body, ..) => StmtKind::While(label:, cond:, body: body.clone())
					.For(binding, source, body, ..) => StmtKind::For(
						label:,
						binding: binding.clone(),
						source:,
						body: body.clone(),
					)
					_ => panic("a label is followed by a loop")
				}
				self.ast.stmts[id] = Stmt(kind: labelled, span: start.to(self.prevSpan()))
				return id
			}
			// `for x in xs { … }` or `for i in lo..hi { … }`.
			.For => {
				self.bump()
				val .Some((binding, source)) = self.forHeader() else {
					self.skipStmt()
					return .None
				}
				val body = self.loopBody()
				StmtKind::For(label: .None, binding:, source: move source, body:)
			}
			// `break`, or `break outer`: the loop of that name.
			.Break => {
				self.bump()
				StmtKind::Break(label: self.jumpLabel())
			}
			.Continue => {
				self.bump()
				StmtKind::Continue(label: self.jumpLabel())
			}
			kind if canStartExpr(kind) => .Expr(value: self.expr())
			_ => {
				val diagnostic = self.expected("a statement")
				self.report(diagnostic)
				self.bump()
				self.skipStmt()
				return .None
			}
		}
		val span = start.to(self.prevSpan())
		return self.allocStmt(kind, span)
	}

	/// A loop's body: statements in braces, or one statement after `do`.
	var fn loopBody(): Block = {
		if !self.at(.Do) then
			return self.block()

		val doSpan = self.bump()
		return self.doBody(doSpan)
	}

	/// What follows a loop's `do`: one statement, held as a block of it, as
	/// a braced body of one would be. A block after it is told to drop the
	/// `do`; a binding, a loop, an `if` with an `else` or in braces, a
	/// `match` and a block are each refused with the fix that writes the
	/// loop's braces, since a line holds one statement, and the words of two
	/// loops on one would not say which is the outer.
	var fn doBody(doSpan: Span): Block = {
		val start = self.span()
		if self.at(.LBrace) {
			val diagnostic = Diagnostic::error(
				EXPECTED,
				"`do` is followed by one statement, not a block",
				start,
				"a block",
			).withFix("drop `do`, for the braced form", [Edit::replace(doSpan, "")]).withNote(
				"a loop's body is one statement after `do`, or statements in braces with no `do`",
			)
			self.report(diagnostic)
			return self.block()
		}
		var stmts: Vec<StmtId> = Vec()
		var refused: Option<str> = .None
		val loopAhead =
			self.at(.For) ||
			self.at(.While) ||
			(isIdent(self.peek()) && self.nth(1) == .Colon && self.nth(2) is .While | .For)
		match self.peek() {
			.Return | .Become | .Break | .Continue | .Yield => {
				if self.stmt() is .Some(stmt) then stmts.push(stmt)
			}
			.Val | .Var => {
				refused = "a binding, which would bind for nothing after it"
				if self.stmt() is .Some(stmt) then
					stmts.push(stmt)
			}
			_ if loopAhead => {
				refused = "a loop, and the line would not say which loop is the outer"
				if self.stmt() is .Some(stmt) then
					stmts.push(stmt)
			}
			kind if canStartExpr(kind) => {
				val value = self.expr()
				refused = match self.ast.exprs[value].kind {
					.If(elseBranch: .Some(_), ..) => "an `if` with an `else`"
					.If(thenBlock, ..) if !self.isThenBranch(&thenBlock) => "an `if` in braces"
					.Match(..) => "a `match`"
					.Block(..) => "a block"
					_ => .None
				}
				val span = self.exprSpan(value)
				stmts.push(self.allocStmt(.Expr(value:), span))
			}
			_ => {
				val diagnostic = self.expected("a statement after `do`")
				self.report(diagnostic)
			}
		}
		val span = start.to(self.prevSpan())
		if refused is .Some(what) then
			self.report(
				Diagnostic::error(
					EXPECTED,
					"a loop's body after `do` is one statement, and this is \(what)",
					span,
					"more than `do` takes",
				).withFix("write the body in braces", [
					Edit::replace(doSpan, "{"),
					Edit::insert(span.hi, " }"),
				]).withNote(
					"`do` takes a call, an assignment, a `yield`, a jump, or an `if … then` without an `else`; more is written in braces",
				),
			)

		return Block(stmts:, span:)
	}

	/// Whether a branch was written after `then`: it starts where its one
	/// statement does, where a block in braces starts at its `{`.
	fn isThenBranch(block: &Block): bool =
		!block.stmts.isEmpty() && self.ast.stmts[block.stmts[0]].span.lo == block.span.lo

	/// What follows `for`: what each element is bound to, `in`, and what
	/// is walked — a statement's and a list literal's element's alike.
	/// `None` where there is no binding.
	var fn forHeader(): Option<(Pattern, ForSource)> = {
		// `for x in …`, `for _ in …`, or a value taken apart,
		// `for (key, value) in …`; `for MapEntry(key, value)` is parsed
		// too, for the checker to refuse with its fix.
		// An array's elements too, `for [a, b] in pairs`.
		var binding = Pattern(kind: .Wildcard, span: self.span())
		when {
			self.at(.LParen) ||
				self.at(.LBracket) ||
				self.at(.Var) ||
				(isIdent(self.peek()) && self.nth(1) == .LParen) => binding = self.pattern()
			self.at(.Underscore) => {
				val span = self.bump()
				binding = Pattern(kind: .Wildcard, span:)
			}
			else => {
				val name = self.name("a name for each element")?
				binding = Pattern(kind: .Binding(symbol: name.sym, isVar: false), span: name.span)
			}
		}
		self.expect(.In)
		// A condition, as `cond` reads one, whose `..` is the loop's.
		val first = self.inContext(false, true, false, (p) => p.bound((q) => q.expr()))
		var source = ForSource::Elements(source: first)
		if self.at(.DotDot) || self.at(.DotDotEq) {
			val inclusive = self.at(.DotDotEq)
			self.bump()
			source = .Range(lo: first, hi: self.cond(), inclusive:)
		}
		return (binding, move source)
	}
}
