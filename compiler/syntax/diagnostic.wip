// Diagnostics as structured data.
//
// Every phase reports problems as `Diagnostic` values; only the driver turns
// them into text. Every code is declared in `codes.wip`, grouped by phase,
// and never reused:
//
// | Range   | Phase                      |
// |---------|----------------------------|
// | `E00xx` | lexer                      |
// | `E01xx` | parser                     |
// | `E02xx` | name resolution            |
// | `E03xx` | types                      |
// | `E04xx` | ownership and references   |
// | `E05xx` | `defer` and drop order     |
// | `E09xx` | code generation            |

@derive(Eq, Clone)
pub enum Severity {
	Error
	Warning
}

@derive(Eq, Clone)
pub struct Label {
	pub var span: Span
	pub var message: String
}

/// One text replacement. An empty span inserts; an empty replacement deletes.
@derive(Eq, Clone)
pub struct Edit {
	pub var span: Span
	pub var replacement: String
}

extend Edit {
	pub static fn insert(pos: u32, text: String): Edit = Edit(
		span: Span::at(pos),
		replacement: text,
	)

	pub static fn replace(span: Span, text: String): Edit = Edit(span: span, replacement: text)
}

/// A machine-applicable suggestion: applying every edit fixes the problem the
/// diagnostic describes.
@derive(Eq, Clone)
pub struct Fix {
	pub var message: String
	pub var edits: Vec<Edit>
}

extend Fix {
	/// Returns `src` with the edits applied. Edits must not overlap.
	pub fn apply(src: str): String = {
		var order: Vec<i64> = Vec()
		for i in 0..self.edits.len() {
			order.push(i)
		}
		order.sortByKey((i) => (self.edits[i].span.lo, self.edits[i].span.hi))
		var out = String::withCapacity(src.len())
		var pos = 0
		for i in order.copies() {
			val edit = &self.edits[i]
			assert(edit.span.lo >= pos, "overlapping edits in fix")
			out.push(src[pos..edit.span.lo])
			out.push(edit.replacement)
			pos = edit.span.hi
		}
		out.push(src[pos..src.len()])
		return out
	}
}

@derive(Eq, Clone)
pub struct Diagnostic {
	pub var severity: Severity
	pub var code: Code
	pub var message: String
	/// What the diagnostic is about. There is always exactly one.
	pub var primary: Label
	/// Related locations, such as where an unclosed delimiter was opened.
	pub var secondary: Vec<Label>
	/// Background that explains the rule.
	pub var notes: Vec<String>
	/// Advice that is not a mechanical edit.
	pub var help: Vec<String>
	pub var fix: Option<Fix>
}

extend Diagnostic {
	pub static fn error(
		code: Code,
		message: String,
		span: Span,
		label: String,
	): Diagnostic = Diagnostic(
		severity: .Error,
		code: code,
		message: message,
		primary: Label(span: span, message: label),
		secondary: Vec(),
		notes: Vec(),
		help: Vec(),
		fix: .None,
	)

	pub static fn warning(code: Code, message: String, span: Span, label: String): Diagnostic = {
		var diagnostic = Diagnostic::error(code, message, span, label)
		diagnostic.severity = .Warning
		return diagnostic
	}

	pub move fn withSecondary(span: Span, label: String): Diagnostic = {
		var diagnostic = self
		diagnostic.secondary.push(Label(span: span, message: label))
		return diagnostic
	}

	pub move fn withNote(note: String): Diagnostic = {
		var diagnostic = self
		diagnostic.notes.push(note)
		return diagnostic
	}

	pub move fn withHelp(help: String): Diagnostic = {
		var diagnostic = self
		diagnostic.help.push(help)
		return diagnostic
	}

	pub move fn withFix(message: String, edits: own<[Edit]>): Diagnostic = {
		var diagnostic = self
		diagnostic.fix = .Some(Fix(message: message, edits: Vec::of(edits)))
		return diagnostic
	}

	pub fn isError(): bool = self.severity == .Error
}
