// Places in a file: a span of bytes, and the line and column a byte is at.

/// A half-open byte range `lo..hi` into the source file.
///
/// A span does not name its file: what holds it says which file it is in.
/// Offsets are `u32`; the driver rejects files larger than 4 GiB.
@derive(Eq, Hash, Clone)
pub struct Span {
	pub lo: u32
	pub hi: u32
}

extend Span {
	pub static fn new(lo: u32, hi: u32): Span = Span(lo: lo, hi: hi)

	/// An empty span at `pos`, for "expected X here" diagnostics and insertions.
	pub static fn at(pos: u32): Span = Span(lo: pos, hi: pos)

	/// The smallest span covering both `self` and `other`.
	pub fn to(other: Span): Span = Span::new(self.lo.min(other.lo), self.hi.max(other.hi))

	pub fn len(): u32 = self.hi - self.lo

	pub fn isEmpty(): bool = self.lo == self.hi
}

/// Maps byte offsets to 1-based line and column numbers.
///
/// Columns count Unicode scalar values, not bytes, which is also how the
/// diagnostics renderer numbers them — so `wip lex` and rendered
/// diagnostics agree.
pub struct LineIndex {
	lineStarts: Vec<u32>
}

extend LineIndex {
	pub static fn new(src: str): LineIndex = {
		var lineStarts: Vec<u32> = Vec()
		lineStarts.push(0)
		var i = 0
		while i < src.len() {
			if src[i] == b'\n' then lineStarts.push((i + 1) as u32)
			i += 1
		}
		return LineIndex(lineStarts: move lineStarts)
	}

	pub fn lineCol(src: str, pos: u32): (u32, u32) = {
		// The last line that starts at or before `pos`: line 0 starts at
		// offset 0, so there is one.
		val line = match self.lineStarts.items().binarySearch(&pos) {
			.Ok(at) => at
			.Err(at) => at - 1
		}
		val start = self.lineStarts[line] as i64
		val col = src[start..pos as i64].chars().count()
		return ((line + 1) as u32, (col + 1) as u32)
	}
}
