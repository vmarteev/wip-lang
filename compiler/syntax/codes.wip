	UNKNOWN_VARIANT,
	VARIANT_WITH_DOT,
	BUILTIN_REDEFINED,
	BINDING_SHADOWS_VARIANT,
	NOT_A_VALUE,
	UNKNOWN_MODULE,
	PRIVATE_ITEM,
	TYPE_ARGUMENT_COUNT,
	UNKNOWN_CONSTRAINT,
	CANNOT_BE_GENERIC,
