/// An item of another module that is not `pub`, or a field it may not write.
pub val PRIVATE_ITEM: Code = Code(number: 210)

/// The wrong number of type arguments, or type arguments where none are taken.
pub val TYPE_ARGUMENT_COUNT: Code = Code(number: 211)

/// A constraint on a type parameter that names nothing a parameter can be required to be.
pub val UNKNOWN_CONSTRAINT: Code = Code(number: 212)

/// A generic item that cannot be generic: an extern function, or `main`.
