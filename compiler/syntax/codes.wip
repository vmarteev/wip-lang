// Every diagnostic code, in one place. A code names one rule, and says so
// here in a line; the note a diagnostic carries says why the rule is there.
//
// Only this module makes a `Code`, so two parts of the compiler cannot take
// one number, and a code that is retired is listed in `RETIRED` and never
// taken again.

/// A stable diagnostic code such as `E0002`. Its field is this module's,
/// so a code is made here and nowhere else.
@derive(Eq, Hash, Clone)
pub struct Code {
	number: i64
}

extend Code {
	/// The code as it is printed: `E0002`.
	pub fn text(): String = "E\(self.number, width: 4, fill: '0')"

	/// The code printed as `number`, if there is one.
	pub static fn named(number: str): Option<Code> = {
		val .Some(digits) = number.stripPrefix("E") else {
			return .None
		}
		if digits.len() != 4 then return .None
		val .Ok(value) = digits.toInt() else {
			return .None
		}
		val code = Code(number: value)
		return if code.meaning().isEmpty() then .None else .Some(code)
	}
}

extend Code: Text {
	fn appendTo(out: &var String) = out.push(self.text())
}

/// Codes once given and since retired, which are never given again.
pub val RETIRED: [str; 9] = [
	"E0006",
	"E0102",
	"E0103",
	"E0107",
	"E0110",
	"E0116",
	"E0327",
	"E0502",
	"E0503",
]

// The lexer's.

/// A character that is not part of the language.
pub val UNEXPECTED_CHAR: Code = Code(number: 1)

/// A string literal with no closing quote.
pub val UNTERMINATED_STRING: Code = Code(number: 2)

/// An escape sequence Wip does not have, or a `\u{…}` that is not a Unicode scalar value.
pub val UNKNOWN_ESCAPE: Code = Code(number: 3)

/// A decimal point with no digit after it.
pub val FLOAT_MISSING_FRACTION: Code = Code(number: 4)

/// A number literal that starts with a zero.
pub val LEADING_ZERO: Code = Code(number: 5)

/// A suffix on a number literal that names no number type.
pub val NUMBER_SUFFIX: Code = Code(number: 7)

/// A character literal that is not closed, or holds more than one character.
pub val SINGLE_QUOTES: Code = Code(number: 8)

/// `~`, which Wip writes `!`.
pub val TILDE: Code = Code(number: 9)

/// A `_` in a number that is not a single separator between digits.
pub val DIGIT_SEPARATOR: Code = Code(number: 10)

/// `0x`, `0o` or `0b` without the digits its base allows.
pub val NUMBER_BASE: Code = Code(number: 11)

/// A byte literal that is not one ASCII character.
pub val BYTE_LITERAL: Code = Code(number: 12)

/// A text block whose opening, closing or lines are not as a text block has them.
///
/// Text on the line of its opening `"""`, a line indented less than its
/// closing one, a `"""` inside it, or a backslash ending a line.
pub val TEXT_BLOCK: Code = Code(number: 13)

// The parser's.

/// Something other than what the grammar allows here.
pub val EXPECTED: Code = Code(number: 101)

/// Two `match` arms on one line with no `,` between them.
pub val MATCH_ARM_SEPARATOR: Code = Code(number: 104)

/// An `extern` block with an ABI other than `\"C\"`.
pub val UNSUPPORTED_ABI: Code = Code(number: 105)

/// A function with no body, or a body not introduced by `=`.
pub val FUNCTION_BODY: Code = Code(number: 106)

/// A `{` that is never closed.
pub val UNCLOSED_BRACE: Code = Code(number: 108)

/// `&&` where a reference to a reference was meant.
pub val DOUBLE_BORROW: Code = Code(number: 109)

/// An integer literal too large for any integer type.
pub val INTEGER_TOO_LARGE: Code = Code(number: 111)

/// Two statements or members on one line with nothing between them.
pub val SEPARATOR: Code = Code(number: 112)

/// A line that starts with a binary operator.
pub val LEADING_OPERATOR: Code = Code(number: 113)

/// `let`, which Wip writes `val`.
pub val LET: Code = Code(number: 114)

/// A return type after `->`, which Wip writes after `:`.
pub val ARROW_RETURN_TYPE: Code = Code(number: 115)

/// A binding after `..` in a pattern.
pub val BINDER_AFTER_REST: Code = Code(number: 117)

/// `_` used as a name to bind.
pub val UNDERSCORE_BINDER: Code = Code(number: 118)

/// An import list that names nothing, or is renamed as a whole.
pub val IMPORT_LIST: Code = Code(number: 119)

/// `::<…>` before type arguments, which are written `<…>`.
pub val TYPE_ARGS_COLONS: Code = Code(number: 120)

/// `fn(A, B): R`, where a function type is written `(a: A, b: B) => R`.
pub val FN_TYPE_SYNTAX: Code = Code(number: 121)

/// A positional argument after a named one.
pub val POSITIONAL_AFTER_NAMED: Code = Code(number: 122)

/// A guard, `val pattern = value else { … }`, written without `else`.
pub val GUARD_SYNTAX: Code = Code(number: 123)

/// A struct's field or an enum's variant written wrongly.
///
/// `pub` on a field, or `var`, `move` or `static` without `fn`.
pub val MEMBER_SYNTAX: Code = Code(number: 124)

/// An annotation with no declaration after it, or on one that cannot carry it.
pub val ANNOTATION_SYNTAX: Code = Code(number: 125)

/// A variant at the start of a line, under a statement a `.` could have continued.
///
/// It reads as a method call on the line above. A warning, since it means
/// what it says.
pub val VARIANT_UNDER_EXPRESSION: Code = Code(number: 126)

/// `impl`, which Wip writes `extend`.
pub val IMPL_KEYWORD: Code = Code(number: 127)

/// `yield` where a value is expected, or where a projection's `lend` was meant.
pub val YIELD_KEYWORD: Code = Code(number: 128)

/// A tuple of too few or too many elements.
pub val TUPLE_ARITY: Code = Code(number: 129)

/// `..value` written twice, not last, or in a call that builds no struct.
pub val REST_NOT_LAST: Code = Code(number: 130)

/// A float literal as a pattern.
pub val FLOAT_PATTERN: Code = Code(number: 131)

/// An `assert` given something other than a condition and a note.
pub val ASSERT_ARGUMENTS: Code = Code(number: 132)

/// A struct built with braces, which is written `Row(…)`.
pub val BRACE_LITERAL: Code = Code(number: 133)

/// A piece of an interpolation with an option it does not take, one given twice, a fill with no width, or a precision or radix its value cannot be written to.
pub val INTERPOLATION_OPTION: Code = Code(number: 134)

/// A struct written without the braces it needs, or with its body on the next line.
///
/// A `view` or `extern` struct, or a union, written without braces, or a
/// struct whose `{` is on the line after its name.
pub val STRUCT_BODY: Code = Code(number: 135)

// Names, modules and packages: the checker's.

/// A name defined, or imported, twice.
pub val DUPLICATE_DEFINITION: Code = Code(number: 201)

/// A type name that names no type.
pub val UNKNOWN_TYPE: Code = Code(number: 202)

/// A name that names nothing where it is looked up.
pub val UNKNOWN_NAME: Code = Code(number: 203)

/// A variant the enum does not have, or a variant of what is not an enum.
pub val UNKNOWN_VARIANT: Code = Code(number: 204)

/// A variant written `Enum.Variant`, where Wip writes `Enum::Variant`.
pub val VARIANT_WITH_DOT: Code = Code(number: 205)

/// A built-in type's name declared again, or given to a type parameter.
pub val BUILTIN_REDEFINED: Code = Code(number: 206)

/// A pattern's name that binds, where the variant of that name was probably meant.
pub val BINDING_SHADOWS_VARIANT: Code = Code(number: 207)

/// A type, or a projection, used as a value.
pub val NOT_A_VALUE: Code = Code(number: 208)

/// A path whose first segment names no module.
