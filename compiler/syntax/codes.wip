	NAMED_ARGUMENT_TO_VALUE,
	IS_BINDING_OUTSIDE_CONDITION,
	GUARD_ELSE_FALLS_THROUGH,
	SHADOWED_TYPE_PARAMETER,
	SELF_OUTSIDE_METHOD,
	NOT_A_METHOD,
	IMPL_TARGET,
	UNKNOWN_INTERFACE,
	DUPLICATE_IMPL,
	IMPL_METHODS,
	UNSATISFIED_CONSTRAINT,
	NOT_DISPATCHABLE,
	UNSIZED_DYN,
	PRELUDE_NAME,
	PANIC_ARGUMENT,
	NEVER_VALUE,
	CANNOT_PROPAGATE,
	LAMBDA_PARAMS,
	LAMBDA_CAPTURE,
	YIELD_OUTSIDE_LIST,
	ELEMENT_ADDS_NOTHING,
