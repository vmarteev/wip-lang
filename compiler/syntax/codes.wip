	EXTENSION,
	AMBIGUOUS_METHOD,
	LENDS_FROM,
	DECIDED_TYPE,
	USE_OF_MOVED_VALUE,
	USE_OF_POSSIBLY_MOVED_VALUE,
	MOVED_IN_PREVIOUS_ITERATION,
	CANNOT_COPY_OWN,
	CANNOT_MOVE_OUT_OF_BORROW,
