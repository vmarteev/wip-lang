extend Code {
	/// What the code means, in a line.
	pub fn meaning(): str = match self.number {
		1 => "A character that is not part of the language."
		2 => "A string literal with no closing quote."
		3 =>
			"An escape sequence Wip does not have, or a `\\u{…}` that is not a Unicode scalar value."
		4 => "A decimal point with no digit after it."
		5 => "A number literal that starts with a zero."
		7 => "A suffix on a number literal that names no number type."
		8 => "A character literal that is not closed, or holds more than one character."
		9 => "`~`, which Wip writes `!`."
		10 => "A `_` in a number that is not a single separator between digits."
		11 => "`0x`, `0o` or `0b` without the digits its base allows."
		12 => "A byte literal that is not one ASCII character."
		13 => "A text block whose opening, closing or lines are not as a text block has them."
		101 => "Something other than what the grammar allows here."
		104 => "Two `match` arms on one line with no `,` between them."
		105 => "An `extern` block with an ABI other than `\\\"C\\\"`."
		106 => "A function with no body, or a body not introduced by `=`."
		108 => "A `{` that is never closed."
		109 => "`&&` where a reference to a reference was meant."
		111 => "An integer literal too large for any integer type."
		112 => "Two statements or members on one line with nothing between them."
		113 => "A line that starts with a binary operator."
		114 => "`let`, which Wip writes `val`."
		115 => "A return type after `->`, which Wip writes after `:`."
		117 => "A binding after `..` in a pattern."
		118 => "`_` used as a name to bind."
		119 => "An import list that names nothing, or is renamed as a whole."
		120 => "`::<…>` before type arguments, which are written `<…>`."
		121 => "`fn(A, B): R`, where a function type is written `(a: A, b: B) => R`."
		122 => "A positional argument after a named one."
		123 => "A guard, `val pattern = value else { … }`, written without `else`."
		124 => "A struct's field or an enum's variant written wrongly."
		125 => "An annotation with no declaration after it, or on one that cannot carry it."
		126 => "A variant at the start of a line, under a statement a `.` could have continued."
		127 => "`impl`, which Wip writes `extend`."
		128 => "`yield` where a value is expected, or where a projection's `lend` was meant."
		129 => "A tuple of too few or too many elements."
		130 => "`..value` written twice, not last, or in a call that builds no struct."
		131 => "A float literal as a pattern."
		132 => "An `assert` given something other than a condition and a note."
		133 => "A struct built with braces, which is written `Row(…)`."
		134 =>
			"A piece of an interpolation with an option it does not take, one given twice, a fill with no width, or a precision or radix its value cannot be written to."
		135 => "A struct written without the braces it needs, or with its body on the next line."
		201 => "A name defined, or imported, twice."
		202 => "A type name that names no type."
		203 => "A name that names nothing where it is looked up."
		204 => "A variant the enum does not have, or a variant of what is not an enum."
		205 => "A variant written `Enum.Variant`, where Wip writes `Enum::Variant`."
		206 => "A built-in type's name declared again, or given to a type parameter."
		207 => "A pattern's name that binds, where the variant of that name was probably meant."
		208 => "A type, or a projection, used as a value."
		209 => "A path whose first segment names no module."
		210 => "An item of another module that is not `pub`, or a field it may not write."
		211 => "The wrong number of type arguments, or type arguments where none are taken."
		212 =>
			"A constraint on a type parameter that names nothing a parameter can be required to be."
		213 => "A generic item that cannot be generic: an extern function, or `main`."
		214 =>
			"A `package.wip` that says something wrong, or a dependency that is not what it says."
		215 => "A module under `internal/` imported from another package."
		216 =>
			"A default type argument on what is not a struct or an enum, before a parameter with none, or naming a parameter after it."
		301 => "A value of one type where another is expected."
		302 => "A call with too few or too many arguments."
		303 => "An operator applied to what it does not take."
		304 => "An assignment to what cannot be assigned."
		305 => "A function that can reach its end without the value it answers."
		306 => "A call of what is not a function."
		307 => "A field the type does not have."
		308 => "A struct literal whose fields do not fit the struct."
		309 => "An index into what cannot be indexed, or a constant index out of bounds."
		310 => "An integer literal out of range for its type."
		311 => "A `match` that leaves a value uncovered."
		312 => "A `match` arm no value can reach."
		313 => "A pattern that cannot match the type it is tested against."
		314 => "A type or a call C cannot take as it is written."
		315 => "A type that cannot be worked out from what is written."
		316 => "A type that holds itself directly, and so has no size."
		317 => "`move` of what is not a variable, a field or an element."
		318 => "No `main`, or a `main` whose parameters or result a program cannot start with."
		319 => "An `as` between types it does not convert."
		320 => "A warning: a value computed with no side effect and never used."
		321 => "A pattern that names a field twice, or leaves fields out without `..`."
		322 => "`break` or `continue` outside a loop."
		323 => "`for` over what cannot be walked."
		324 => "A length known only at run time, outside `own`."
		325 => "A type argument that owns memory, where `copy` is required."
		326 => "Instances of generic items that would never end."
		328 => "A named argument for a parameter or a field that does not exist."
		329 => "A parameter or a field given two values."
		330 => "A default where there can be none, or one that cannot be a default."
		331 => "A variant or a struct with two or more fields, built without naming them."
		332 => "A named argument in a call through a function value."
		333 => "An `is` test that binds a name nothing after it can use."
		334 => "A guard's `else` block that can reach its end."
		335 => "A method's type parameter with the name of one of its type's."
		336 => "`self` outside a method, or in a `static fn`."
		337 =>
			"A method the type does not have, or a method or a type's function named without a call."
		338 =>
			"An `extend` block for a type it may not extend, or that names the type's parameters wrongly."
		339 => "An interface name that names no interface."
		340 => "A type that implements one interface twice."
		341 => "An implementation that leaves out, adds or changes one of the interface's methods."
		342 => "A type argument that does not implement what its parameter requires."
		343 => "`&dyn` of an interface with a method that cannot be called through it."
		344 => "A `dyn` type that is not behind `&`."
		345 => "A name the prelude declares, declared or imported again."
		346 => "`panic` called with something other than one message in text."
		347 => "`never` where a value would have to exist."
		348 =>
			"`?` on what is not an `Option` or a `Result`, or where the function cannot carry it."
		349 =>
			"A lambda whose parameters do not match what is expected, or whose types are not known."
		350 => "A lambda that captures a name, where a plain function is expected."
		351 => "`yield` with no list being built and no generator around it."
		352 => "An element of a list that adds nothing to it."
		353 => "A list whose length its `yield`s decide, where no `own` builds it."
		354 => "A variable given an `if` without `else`, which has no value."
		355 => "`f(name = value)`, where a named argument, `name: value`, was meant."
		356 => "A generator that yields nothing."
		357 => "`return` in a loop that is a generator."
		358 => "A function that yields and takes a `&var`."
		359 => "A generator that holds itself."
		360 => "A slice pattern with more than one `..`."
		361 => "A warning: arguments that are the parameters' own names, in each other's places."
		362 => "An `extend` of an interface that may not be written."
		363 => "A method of one name that two interfaces give a type."
		364 => "A `from` naming what a result cannot borrow from."
		365 =>
			"A type an implementation decides, declared where it cannot be, or read where which one is in question."
		401 => "A value used after it was moved."
		402 => "A value used after it may have been moved."
		403 => "A value moved in one iteration of a loop and used in the next."
		404 => "A value that owns memory, used where it would be copied."
		405 => "A move out of what is only borrowed."
		406 => "A move of an array's element that owns memory."
		407 => "`[x; n]` of a value that owns memory."
		408 => "An assignment to part of a value that was moved."
		409 => "A move out of a temporary."
		410 => "A `&var` inside a type, or a reference where none may stand."
		411 => "`&var` outside a call's argument, or `&` where no reference is expected."
		412 => "`&var` of what cannot be written."
		413 => "A `&var` argument whose place another argument of the call refers to too."
		414 => "A place changed while a binding, or an earlier argument, refers to it."
		415 => "A `&var` parameter left without a value when the function returns."
		416 => "A slice not behind a reference, or kept in a variable."
		417 => "A range of elements that is not borrowed."
		418 => "A projection whose body does not keep the rules of a projection."
		419 => "`lend` outside a projection."
		420 =>
			"An annotation that is unknown, misplaced, given the wrong arguments or written twice."
		421 => "A `@tailrec` function whose call to itself cannot be a jump."
		422 =>
			"A `@tailrec` function's call to itself with something of the frame still to clean up."
		423 => "A top-level `val` whose value is not known where it is written."
		424 => "`null` where no pointer type is expected."
		425 => "A C type whose contents Wip does not know, used as a value."
		426 => "`destroy` called by a program, or a field moved out of a type that has one."
		427 => "A `str`, a `&` reference or a view kept where it would outlive what it borrows."
		428 => "`...` on a declaration that is not C's."
		429 => "A named argument to a C function that takes more than it declares."
		430 => "An `@inline` function that cannot be spliced into its callers."
		431 => "A field that cannot be compared, in a type that asks for `@derive(Eq)`."
		432 => "`&` of a value that has no place of its own."
		433 => "`pub` where visibility is not the declaration's to give."
		434 => "A `val` pattern with an `else` that cannot run, or without one where it can fail."
		435 => "A type alias that takes constraints, or one that names itself."
		436 =>
			"A `str`, a C string made from a `String`, a `&` reference or a view used after what it borrows changed."
		437 =>
			"A `str`, a C string made from a `String`, a `&` reference or a view that would outlive what it borrows."
		438 => "An assert whose note is not text."
		439 => "A generator's own local borrowed across a `yield`."
		440 => "A field that cannot be cloned, in a type that asks for `@derive(Clone)`."
		441 => "A constant whose code panicked while the program was compiled."
		442 => "A constant whose code does what cannot be done while the program is compiled."
		443 => "A constant whose code ran past the steps or the memory it may take."
		444 =>
			"A constant that runs code without `@comptime`, or is marked `@comptime` and runs nothing."
		445 => "A top-level `assert` whose condition does not hold."
		446 => "A file embedded where it cannot be, or one that cannot be read as asked."
		447 => "What a `&var` parameter reaches, kept in another parameter past the call."
		448 => "A warning: a `String` copied where nothing reads it again, so it could be moved."
		449 =>
			"A call that keeps an argument its signature does not say it keeps, or a `keeps` that names what cannot be kept."
		450 => "`&` of a function value, which would have a closure's type and is not a closure."
		501 => "`return` inside a deferred expression."
		504 => "`break` or `continue` leaving a deferred expression."
		901 => "A construct the code generator does not handle."
		_ => ""
	}
}
