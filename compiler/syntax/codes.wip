// The code generator's.

/// A construct the code generator does not handle.
///
/// None is left; the code stays reserved.
pub val UNSUPPORTED: Code = Code(number: 901)

/// Every code, in the order of their numbers.
pub val ALL: [Code; 175] = [
	UNEXPECTED_CHAR,
	UNTERMINATED_STRING,
	UNKNOWN_ESCAPE,
	FLOAT_MISSING_FRACTION,
	LEADING_ZERO,
