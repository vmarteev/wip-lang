// Recursive-descent parser for the grammar in `docs/grammar.md` §2.
//
// Line breaks: every token records whether it starts a line, and the parser
// tracks whether line breaks are significant where it is (grammar §1.1): at
// the top level and inside `{ }` they are, inside `( )`, `[ ]` and
// conditions they are not. Where they are significant, a line break
// separates statements and list items, and a complete expression does not
// continue across one.
//
// Error recovery: a parse error never stops the parse. Every production
// returns a node even when its input is malformed — an `Error` node if
// nothing better fits — and after an error the parser resynchronizes: at the
// next separator or closing delimiter inside a list, at the next line break,
// `;` or statement keyword inside a block, and at the next item keyword at
// the top level. An item keyword inside a block means the block was never
// closed.
//
// One mistake should produce one error. A diagnostic is therefore dropped
// when another was already reported at the same position, or when the lexer
// skipped text earlier in the same statement (see `Lexed.gaps`).

pub struct Parsed {
	pub var ast: Ast
	pub diagnostics: Vec<Diagnostic>
}

/// A `package.wip`: the package's name and what it says of itself.
pub struct ParsedPackage {
	/// `@version(…)`, `@depends(…)` and whatever else was written, checked
	/// by the loader, which knows what each means.
	pub annotations: Vec<Annotation>
	/// The name after `package`, where one was written.
	pub name: Option<Name>
	pub diagnostics: Vec<Diagnostic>
}

/// Parses a `package.wip`, whose spans start at `base`: annotations, then
/// `package NAME`, and nothing else. `package` is a word
/// only here, so a program may still write `package::VERSION`.
pub fn parsePackageAt(src: str, base: u32, lexed: &Lexed): ParsedPackage = {
	var parser = Parser::over(src, base, &lexed)
	val (annotations, name) = parser.packageFile()
	return ParsedPackage(
		annotations: move annotations,
		name: name,
		diagnostics: move parser.diagnostics,
	)
}

pub fn parse(src: str, lexed: &Lexed): Parsed = parseAt(src, 0, &lexed)

/// Parses a file whose spans start at `base`.
pub fn parseAt(src: str, base: u32, lexed: &Lexed): Parsed = {
	var parser = Parser::over(src, base, &lexed)
	parser.program()
	return Parsed(ast: move parser.ast, diagnostics: move parser.diagnostics)
}

/// Binding powers for `Parser.exprBp`, as (left, right). Left below right
/// makes an operator left-associative; `=` is the only right-associative one.
/// Infix `&` sits where Rust puts bitwise-and; it is parsed only to report it.
fn infixBindingPower(kind: TokenKind): Option<(i64, i64)> = match kind {
	.Eq => .Some(ASSIGN_BINDING_POWER)
	.PipePipe => .Some((3, 4))
	.AmpAmp => .Some((5, 6))
	.EqEq | .BangEq => .Some((7, 8))
	.Lt | .LtEq | .Gt | .GtEq => .Some((9, 10))
	// Bitwise operators bind tighter than comparisons, as in Rust and
	// unlike C.
	.Pipe => .Some((11, 12))
	.Caret => .Some((13, 14))
	.Amp => .Some((15, 16))
	// `<<` and `>>` are two tokens; see `Parser.shift`.
	.Plus | .Minus | .PlusPercent | .MinusPercent => .Some((19, 20))
	.Star | .Slash | .Percent | .StarPercent => .Some((21, 22))
	_ => .None
}

/// `=` and the compound assignments: the loosest, and
/// right-associative.
val ASSIGN_BINDING_POWER: (i64, i64) = (2, 1)
/// `<<` and `>>`: tighter than `&`, looser than `+`.
val SHIFT_BINDING_POWER: (i64, i64) = (17, 18)
/// `is` binds as a comparison does, looser than `|` and tighter than `==`.
val IS_BINDING_POWER: i64 = 9
/// `as` binds tighter than `*` and looser than the prefix operators.
val CAST_BINDING_POWER: i64 = 22
val PREFIX_BINDING_POWER: i64 = 23

fn binaryOp(kind: TokenKind): BinaryOp = match kind {
	.PipePipe => .Or
	.AmpAmp => .And
	.EqEq => .Eq
	.BangEq => .Ne
	.Lt => .Lt
	.LtEq => .Le
	.Gt => .Gt
	.GtEq => .Ge
	// `+%`, `-%` and `*%` are the same operators, wrapping.
	.Plus | .PlusPercent => .Add
	.Minus | .MinusPercent => .Sub
	.Star | .StarPercent => .Mul
	.Slash => .Div
	.Percent => .Rem
	.Amp => .BitAnd
	.Pipe => .BitOr
	.Caret => .BitXor
	_ => panic("not a binary operator: \(kind.describe())")
}

fn isItemStart(kind: TokenKind): bool =
	kind is .Import | .Pub | .Fn | .Struct | .Enum | .Extern | .Impl | .Interface

fn isStmtKeyword(kind: TokenKind): bool =
	kind is .Let | .Val | .Var | .Defer | .Return | .While | .For | .Break | .Continue

/// Operators that can only continue an expression, never begin one. A line
/// that starts with one is E0113.
fn isBinaryOnly(kind: TokenKind): bool =
	kind is .Plus | .Star | .Slash | .Percent | .EqEq | .BangEq | .Lt | .LtEq | .Gt | .GtEq
	| .AmpAmp | .PipePipe | .Pipe | .Caret | .Eq | .PlusEq | .MinusEq | .StarEq | .SlashEq
	| .PercentEq | .AmpEq | .PipeEq | .CaretEq | .As

fn isIdent(kind: TokenKind): bool = kind is .Ident(..)

fn canStartExpr(kind: TokenKind): bool =
	kind is .Int | .Float | .Str(..) | .Char(..) | .Byte(..) | .StrStart(..) | .True | .False
	| .Null | .Ident(..) | .LBracket | .LBrace | .If | .Assert(..) | .Match | .LParen | .Minus
	| .Bang | .Amp | .AmpAmp | .Move | .Own | .SelfKw | .Lend | .Yield | .Dot
// The first piece of an interpolated literal.
// `.Variant`, whose enum comes from the expected type.

fn canStartPattern(kind: TokenKind): bool =
	kind is .Ident(..) | .Underscore | .Dot | .LParen | .LBracket | .Int | .Float | .Minus | .True
	| .False | .Str(..) | .Char(..) | .Byte(..) | .DotDot | .DotDotEq
// The elements of an array or a slice.
// A value the scrutinee must equal.
// A range with no lower end.

/// What a bound of a range pattern may start with: a number, a
/// character, a byte, or a constant's name.
fn canStartBound(kind: TokenKind): bool = kind is .Int | .Minus | .Char(..) | .Byte(..) | .Ident(..)

fn canStartType(kind: TokenKind): bool =
	kind is .Ident(..) | .Own | .Amp | .AmpAmp | .LBracket | .LParen | .Fn

fn canStartParam(kind: TokenKind): bool = kind is .Ident(..) | .Underscore | .DotDotDot

/// Tokens a parenthesized list never skips past while recovering: they end
/// the statement or item the list is part of.
fn endsList(kind: TokenKind): bool =
	kind is .Semi | .LBrace | .Eof || isItemStart(kind) || isStmtKeyword(kind)

/// How a brace list separates its items (grammar §1.1).
view struct BraceList {
	/// `,` for lists, `;` for extern blocks.
	sep: TokenKind
	/// What one item is called: "a field".
	what: str
	/// What the items are called together, for E0112/E0104: "fields".
	items: str
	code: Code
}

view struct Parser {
	src: str
	/// Where this file's spans start.
	base: u32
	tokens: &[Token]
	gaps: &[Span]
	pos: i64
	ast: Ast
	diagnostics: Vec<Diagnostic>
	/// Where the statement or item being parsed begins, counting the
	/// whitespace before it. See `report`.
	regionStart: u32
	/// Line breaks separate statements and end expressions here (grammar
	/// §1.1): true at the top level and inside `{ }`.
	newlines: bool
	/// Set while parsing a condition, where struct literals are not allowed
	/// (grammar R1). Parentheses, brackets, braces and argument lists clear it.
	noStruct: bool
	/// Set while parsing a match arm's guard, which the arm's `=>` follows:
	/// `( … ) =>` at its top level is a parenthesized condition, not a
	/// lambda, since a lambda is no condition. Cleared where `noStruct` is.
	guard: bool
	/// Every matched `{` … `}` so far, for guessing which brace is missing.
	bracePairs: Vec<(Span, Span)>
	lastErrorAt: Option<u32>
	/// `...` in the parameter list being read, where it was written.
	variadic: Option<Span>
	/// Lookahead calls since the parser last consumed a token. A parser bug
	/// that loops without consuming trips the check in `nth`, which is why
	/// the methods that look ahead are `var fn`.
	fuel: i64
	/// Nonzero inside a list of type arguments or parameters, where a `>=`
	/// closes the list with its first character: `val x: Option<i64>= y`.
	/// `>` and `>=` are one token each, as `>>` is two.
	typeArgs: i64
	/// The `=` left over where a `>=` closed a list of type arguments.
	halfEq: Option<Span>
}

extend Parser {
	/// A parser at the start of `lexed`'s tokens of `src`, whose spans
	/// start at `base`.
	static fn over(src: str, base: u32, lexed: &Lexed): Parser = Parser(
		src: src,
		base: base,
		tokens: &lexed.tokens,
		gaps: &lexed.gaps,
		pos: 0,
		ast: Ast(),
		diagnostics: Vec(),
		regionStart: 0,
		newlines: true,
		noStruct: false,
		guard: false,
		bracePairs: Vec(),
		lastErrorAt: .None,
		variadic: .None,
		fuel: 0,
		typeArgs: 0,
		halfEq: .None,
	)

	// ---- tokens ----

	var fn nth(n: i64): TokenKind = {
		val fuel = self.fuel + 1
		if fuel >= 50000 then panic("parser made no progress at token \(self.pos)")
		self.fuel = fuel
		val kind =
			if self.pos + n < self.tokens.len() then self.tokens[self.pos + n].kind
			else TokenKind::Eof
		if n > 0 then return kind
		// What is left of a `>=` that closed a list of type arguments, and
		// the `>` of one that is about to.
		if self.halfEq.isSome() then return .Eq
		if kind == .GtEq && self.typeArgs > 0 then return .Gt
		return kind
	}

	var fn peek(): TokenKind = self.nth(0)

	/// The text of the token `n` ahead, for the words that are keywords
	/// only where they are written: `union` after `extern`.
	fn nthText(n: i64): str from self.src =
		if self.pos + n < self.tokens.len() then self.text(self.tokens[self.pos + n].span) else ""

	var fn at(kind: TokenKind): bool = self.peek() == kind

	fn span(): Span = match self.halfEq {
		.Some(span) => span
		.None => self.tokens[self.pos].span
	}

	fn prevSpan(): Span =
		if self.pos == 0 then Span::at(self.base) else self.tokens[self.pos - 1].span

	var fn bump(): Span = {
		// The `=` of a `>=` whose `>` closed a list of type arguments.
		if self.halfEq is .Some(span) {
			self.halfEq = .None
			self.pos += 1
			self.fuel = 0
			return span
		}
		val token = self.tokens[self.pos]
		if token.kind == .GtEq && self.typeArgs > 0 {
			self.halfEq = .Some(Span::new(token.span.lo + 1, token.span.hi))
			self.fuel = 0
			return Span::new(token.span.lo, token.span.lo + 1)
		}
		val span = self.span()
		if token.kind != .Eof {
			self.pos += 1
			self.fuel = 0
		}
		return span
	}

	/// Parses a list of type arguments or parameters, where a `>=` closes the
	/// list with its first character.
	var fn inTypeArgs<R>(f: &var (p: &var Parser) => R): R = {
		self.typeArgs += 1
		val result = f(&var self)
		self.typeArgs -= 1
		return move result
	}

	var fn eat(kind: TokenKind): bool = {
		val found = self.at(kind)
		if found then self.bump()
		return found
	}

	/// Whether a significant line break comes before the token `n` ahead.
	fn lineBreakAt(n: i64): bool =
		self.newlines && (self.pos + n >= self.tokens.len() || self.tokens[self.pos + n].lineStart)

	/// Whether a significant line break comes before the current token.
	fn lineBreak(): bool = self.lineBreakAt(0)

	/// A span's offset within this file's own text.
	fn local(pos: u32): i64 = (pos - self.base) as i64

	fn text(span: Span): str from self.src = self.src[self.local(span.lo)..self.local(span.hi)]

	var fn found(): String = match self.peek() {
		.Eof => String::of("end of file")
		_ => "`\(self.text(self.span()))`"
	}

	/// Whether the current token starts on a later line than the previous
	/// token ends (or is the end of file).
	var fn onLaterLine(): bool =
		self.at(.Eof) ||
		self.src[self.local(self.prevSpan().hi)..self.local(self.span().lo)].contains("\n")

	// ---- node construction ----

	var fn allocExpr(kind: ExprKind, span: Span): ExprId = self.ast.exprs.add(Expr(
		kind: move kind,
		span: span,
	))

	var fn allocStmt(kind: StmtKind, span: Span): StmtId = self.ast.stmts.add(Stmt(
		kind: move kind,
		span: span,
	))

	var fn allocType(kind: TypeKind, span: Span): TypeId = self.ast.types.add(Type(
		kind: move kind,
		span: span,
	))

	/// An `Error` expression where something was expected but nothing was
	/// consumed.
	var fn errorExpr(): ExprId = {
		val span = Span::at(self.prevSpan().hi)
		return self.allocExpr(.Error, span)
	}

	fn exprSpan(id: ExprId): Span = self.ast.exprs[id].span

	/// Runs `f` with line breaks significant or not, struct literals
	/// allowed or not, and in a guard or not, restoring all three
	/// afterwards.
	var fn inContext<R>(
		newlines: bool,
		noStruct: bool,
		guard: bool,
		f: &var (p: &var Parser) => R,
	): R = {
		val saved = (self.newlines, self.noStruct, self.guard)
		self.newlines = newlines
		self.noStruct = noStruct
		self.guard = guard
		val result = f(&var self)
		self.newlines = saved.0
		self.noStruct = saved.1
		self.guard = saved.2
		return move result
	}

	/// Inside `( )` and `[ ]`: line breaks are whitespace, struct literals are
	/// allowed.
	var fn inParens<R>(f: &var (p: &var Parser) => R): R = self.inContext(false, false, false, f)

	/// Inside `{ }`: line breaks are significant, struct literals are allowed.
	var fn inBraces<R>(f: &var (p: &var Parser) => R): R = self.inContext(true, false, false, f)

	/// Parses a condition: line breaks are whitespace up to its `{`, and a
	/// struct literal may not appear at its top level.
	var fn cond(): ExprId = self.inContext(false, true, false, (p) => p.expr())

	/// Parses a match arm's guard: a condition, before the arm's `=>`.
	var fn guardCond(): ExprId = self.inContext(false, true, true, (p) => p.expr())

	/// A parameter's name, or `_` for one that is not used.
	var fn paramName(what: str): Option<Name> = {
		if self.at(.Underscore) {
			val span = self.bump()
			return .Some(Name(sym: Symbol::ignored(), span: span))
		}
		return self.name(what)
	}

	var fn name(what: str): Option<Name> = {
		if self.peek() is .Ident(symbol) {
			val span = self.bump()
			return .Some(Name(sym: symbol, span: span))
		}
		var diagnostic = self.expected(what)
		if self.peek().text() is .Some(keyword) && isWord(keyword) then
			diagnostic = diagnostic.withHelp("`\(keyword)` is a keyword and cannot be used as a name")
		self.report(move diagnostic)
		return .None
	}
}

/// Whether `text` is letters alone, as a keyword is and punctuation is not.
fn isWord(text: str): bool = {
	for b in text {
		if !(b is b'a'..=b'z' | b'A'..=b'Z') then return false
	}
	return true
}
