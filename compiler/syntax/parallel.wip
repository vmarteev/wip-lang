// Splitting a phase's work across threads.
//
// Work is split into contiguous ranges, in order, and the results come back
// in the same order: `future::map` over the ranges answers in their order. A
// phase that merges them range by range therefore makes what one pass over
// all the work would, whatever the number of threads: the same symbols, the
// same types, the same diagnostics.

/// Splits items of the given weights into at most `parts` contiguous ranges
/// of about equal weight, each the index of its first item and of the one
/// after its last. There is always at least one range.
pub fn split(weights: &[i64], parts: i64): Vec<(i64, i64)> = {
	val most = if parts < 1 then 1 else parts
	var total = 0
	for weight in weights {
		total += weight
	}
	var ranges: Vec<(i64, i64)> = Vec()
	var start = 0
	var sum = 0
	for (i, weight) in weights.forwards().enumerate() {
		sum += weight
		// Close the range once it holds its share of the whole.
		if ranges.len() + 1 < most && sum * most >= total * (ranges.len() + 1) {
			ranges.push((start, i + 1))
			start = i + 1
		}
	}
	if start < weights.len() || ranges.isEmpty() then ranges.push((start, weights.len()))
	return move ranges
}
