// `wip fmt`: what it writes, and that it never writes a different program.
// That every file of the repository formats as itself is the gate's
// comparison of the two formatters, which formats each of them.

fn spaces(width: i64): Style = Style(width: width, tabs: false, size: 4)

fn formatted(src: str, style: Style): String = match format(src, style, false) {
	.Ok(out) => move out
	.Err(.Parse(diagnostics)) => panic("does not parse: \(diagnostics[0].message)")
	.Err(.Bug(message)) => panic(message.toStr())
}

/// Fails, showing both, where `got` is not `want`.
fn same(got: String, want: str) = {
	assert(got == want, "wrote:\n\(got)\nwanted:\n\(want)")
}

@test
fn tabsByDefaultAndSpacesWhenAsked() = {
	val src = "fn main() = {\n  val x = 1\n}\n"
	same(formatted(src, Style()), "fn main() = {\n\tval x = 1\n}\n")
	same(formatted(src, spaces(120)), "fn main() = {\n    val x = 1\n}\n")
}

@test
fn spacingIsTheSameEverywhere() = {
	val src = "fn area( s:&Shape ):f64=match s{\n  .Circle(r)=>3.14*r*r\n    .Rect(w,h) => w*h\n}\n"
	same(
		formatted(src, spaces(120)),
		"fn area(s: &Shape): f64 = match s {\n    .Circle(r) => 3.14 * r * r\n    .Rect(w, h) => w * h\n}\n",
	)
}

/// An arm whose block only leaves is written as the jump, as it may be
/// written; one with a comment in it keeps its block.
@test
fn anArmThatOnlyLeavesIsTheJump() = {
	val src =
		"fn f(n: i64): i64 = match n {\n    0 => { return 1 }\n    1 => {\n        // why\n        return 2\n    }\n    _ => n\n}\n"
	same(
		formatted(src, spaces(100)),
		"fn f(n: i64): i64 = match n {\n    0 => return 1\n    1 => {\n        // why\n        return 2\n    }\n    _ => n\n}\n",
	)
}

@test
fn aListThatDoesNotFitIsOneToALine() = {
	val src = "fn main() = compute(alpha, beta, gamma, delta)\n"
	same(
		formatted(src, spaces(30)),
		"fn main() = compute(\n    alpha,\n    beta,\n    gamma,\n    delta,\n)\n",
	)
}

@test
fn aChainBreaksAfterItsOperators() = {
	val src = "fn main() = {\n    val total = first + second + third + fourth\n}\n"
	same(
		formatted(src, spaces(30)),
		"fn main() = {\n    val total =\n        first +\n        second +\n        third +\n        fourth\n}\n",
	)
}

/// A line break separates a struct's fields and an enum's variants, as it
/// does a match's arms, so none is written with a comma; a variant's own
/// fields are a list, and keep theirs.
@test
fn declarationsHaveNoCommas() = {
	val src =
		"struct Point {\n    x: i64,\n    y: i64 = 0,\n}\n\nenum Shape { Circle(r: f64, at: Point), Dot, }\n"
	same(
		formatted(src, spaces(120)),
		"struct Point {\n    x: i64\n    y: i64 = 0\n}\n\nenum Shape {\n    Circle(r: f64, at: Point)\n    Dot\n}\n",
	)
}

@test
fn anIfOfOneExpressionEachIsWrittenWithThen() = {
	// A branch of one expression, a call, a value or a jump, needs no
	// braces; a branch of two statements keeps them, and so does one with a
	// comment in it.
	val src =
		"fn f(a: i64): i64 = {\n    if a > 0 { g() }\n    if a > 9 {\n        return 0\n    }\n    if a > 5 {\n        g()\n        h()\n    }\n    if a > 3 {\n        // why\n        return 1\n    }\n    if a < 0 { 1 } else { 2 }\n}\n"
	same(
		formatted(src, spaces(80)),
		"fn f(a: i64): i64 = {\n    if a > 0 then g()\n    if a > 9 then return 0\n    if a > 5 {\n        g()\n        h()\n    }\n    if a > 3 {\n        // why\n        return 1\n    }\n    if a < 0 then 1 else 2\n}\n",
	)
}

@test
fn aLongThenChainBreaksBeforeEachElse() = {
	val src =
		"fn d(count: i64): String = if count == 0 { \"nothing\" } else if count == 1 { \"one item\" } else { \"many items, more than the line holds\" }\n"
	val want =
		"fn d(count: i64): String =\n    if count == 0 then \"nothing\"\n    else if count == 1 then \"one item\"\n    else \"many items, more than the line holds\"\n"
	same(formatted(src, spaces(80)), want)
	same(formatted(want, spaces(80)), want)
}

@test
fn aConditionThatMustBeBrokenKeepsTheBraces() = {
	// A `then` after a broken condition would leave the branch under the
	// condition's lines, looking like more of it.
	val src =
		"fn main() = {\n    if index < 0 || index >= occupants.len() || occupants[index].isSome() then panic(\"distinct\")\n    if a then b()\n}\n"
	val want =
		"fn main() = {\n    if index < 0 ||\n        index >= occupants.len() ||\n        occupants[index].isSome() {\n        panic(\"distinct\")\n    }\n    if a then b()\n}\n"
	same(formatted(src, spaces(40)), want)
	same(formatted(want, spaces(40)), want)

	// One condition of a chain that must be broken takes the whole chain.
	val chain =
		"fn f(x: i64): i64 = if x < 0 then 1 else if x == firstLimit || x == secondLimit then 2 else 3\n"
	val broken =
		"fn f(x: i64): i64 = if x < 0 {\n    1\n} else if x == firstLimit ||\n    x == secondLimit {\n    2\n} else {\n    3\n}\n"
	same(formatted(chain, spaces(40)), broken)
	same(formatted(broken, spaces(40)), broken)
}

@test
fn aLongChainBreaksAfterItsDots() = {
	// A line that ends in `.` goes on; one that starts with `.` would begin
	// a variant. Fields stay with the call after them.
	val src =
		"fn main() = {\n    val n = self.words.walk().filter(own (w) => w.len() > 2).map(own (w) => w.len()).count()\n}\n"
	val want =
		"fn main() = {\n    val n = self.words.walk().\n        filter(own (w) => w.len() > 2).\n        map(own (w) => w.len()).\n        count()\n}\n"
	same(formatted(src, spaces(60)), want)
	same(formatted(want, spaces(60)), want)

	// A chain that fits is one line, and one of two calls is laid out as any
	// call is.
	val short = "fn main() = {\n    val n = words.walk().count()\n}\n"
	same(formatted(short, spaces(60)), short)
	val two =
		"fn main() = {\n    val n = self.items().copyWithin(from: first, to: second, count: n)\n}\n"
	same(
		formatted(two, spaces(60)),
		"fn main() = {\n    val n = self.items().copyWithin(\n        from: first,\n        to: second,\n        count: n,\n    )\n}\n",
	)
}

@test
fn theLastArgumentHugsTheParentheses() = {
	// A struct built with named fields breaks inside its own parentheses, as
	// braces did.
	val src =
		"fn main() = {\n    list.push(Entry(name: firstValueHere, kind: secondValueHere))\n}\n"
	same(
		formatted(src, spaces(40)),
		"fn main() = {\n    list.push(Entry(\n        name: firstValueHere,\n        kind: secondValueHere,\n    ))\n}\n",
	)
}

@test
fn aTupleIsWrittenAsOne() = {
	val src = "fn main() = {\n    val pair = (1,   \"one\")\n}\n"
	same(formatted(src, spaces(120)), "fn main() = {\n    val pair = (1, \"one\")\n}\n")
}

@test
fn commentsAndBlankLinesAreKept() = {
	val src =
		"// A file.\n\nimport std::io\n\n\n\nfn main() = {\n    // First.\n    val x = 1 // one\n\n    // Then.\n    io::printInt(x)\n    // At the end.\n}\n"
	same(
		formatted(src, spaces(120)),
		"// A file.\n\nimport std::io\n\nfn main() = {\n    // First.\n    val x = 1 // one\n\n    // Then.\n    io::printInt(x)\n    // At the end.\n}\n",
	)
}

@test
fn aLongImportPutsANameOnEachLine() = {
	// On one line where it fits; otherwise one name to a line, one deeper,
	// with no comma after the last.
	val short = "import std::libc::{free, malloc}\n"
	same(formatted(short, spaces(40)), short)
	val long = "import std::libc::{Hidden, hidden, pthread_cond_init, pthread_cond_wait as wait}\n"
	same(
		formatted(long, spaces(40)),
		"import std::libc::{\n    Hidden,\n    hidden,\n    pthread_cond_init,\n    pthread_cond_wait as wait\n}\n",
	)
}

@test
fn literalsAreWrittenAsTheyWere() = {
	val src =
		"fn main() = {\n    val a = 0xFF_00\n    val b = \"tab\\there \\(a) and \\u{e9}\"\n    val c = 1_000.5\n}\n"
	same(formatted(src, spaces(120)), src)
}

@test
fn tuplesAndPositionalPatternsAreWrittenAsTuples() = {
	val src =
		"fn f(p: (i64, i64)): i64 = match p {\n    (a, b) => a + b\n}\nfn g(o: Option<i64>): i64 = match o {\n    .Some(x) => x\n    .None => 0\n}\nfn h(): (i64, i64) = (1, 2).0\n"
	same(formatted(src, spaces(120)), src)
}

@test
fn aFileThatDoesNotParseIsLeftAlone() = {
	assert(format("fn main( = {}\n", Style(), false) is .Err(.Parse(..)))
}

@test
fn aPackageWipIsFormattedToo() = {
	val src = "@version( \"1.4.0\" )\n@depends(\"engine\",path=\"../engine\")\npackage   game\n"
	val .Ok(out) = format(src, Style(), true) else {
		panic("formats")
	}
	same(
		move out,
		"@version(\"1.4.0\")\n@depends(\"engine\", path = \"../engine\")\npackage game\n",
	)
}

/// A text block is re-indented one deeper than the line it starts on, and
/// what each line has past the closing `"""`'s indentation stays.
@test
fn textBlocksMoveWithTheirCode() = {
	val src =
		"fn main() = {\n  if true {\n val s = \"\"\"\n     one  \n\n       two\n     \"\"\"\n  }\n}\n"
	val want =
		"fn main() = {\n\tif true {\n\t\tval s = \"\"\"\n\t\t\tone\n\n\t\t\t  two\n\t\t\t\"\"\"\n\t}\n}\n"
	same(formatted(src, Style()), want)
}

/// A text block as the last argument hugs the parentheses, plain or
/// interpolated, so a call prints a block of lines as it reads.
@test
fn aTextBlockHugsTheParentheses() = {
	for body in ["one\n\t\ttwo", "one \\(x)\n\t\ttwo"] {
		val src = "fn main() = {\n\tio::println(\"\"\"\n\t\t\(body)\n\t\t\"\"\")\n}\n"
		same(formatted(src.toStr(), Style()), src.toStr())
		val opened = src.replace("println(\"", "println(\n\t\t\"")
		same(formatted(opened.toStr(), Style()), src.toStr())
	}
}

/// An arm too long for its line moves its body to the next, and keeps its
/// pattern on one; a text block stays on the arrow's line.
@test
fn aLongArmBreaksAfterItsArrow() = {
	val src =
		"fn f(p: P): String = match p {\n\t.Nested(parent, child) => \"\\(parent) and \\(child), which is inside it, cannot both be chosen for one move\"\n\t.Twice(path) => \"\\(path) twice\"\n}\n"
	val want =
		"fn f(p: P): String = match p {\n\t.Nested(parent, child) =>\n\t\t\"\\(parent) and \\(child), which is inside it, cannot both be chosen for one move\"\n\t.Twice(path) => \"\\(path) twice\"\n}\n"
	same(formatted(src, Style()), want)
	same(formatted(want, Style()), want)
	val block =
		"fn f(p: P): String = match p {\n\t.Long(path) => \"\"\"\n\t\t\\(path) is a very long name that goes on and on past the width of a line\n\t\t\"\"\"\n}\n"
	same(formatted(block, Style()), block)
}

/// An array of numbers too long for a line fills its lines, as Prettier
/// fills one, rather than taking a line for each number; anything else in
/// it, or a comment, and each element has its line again.
@test
fn tablesOfNumbersFillTheirLines() = {
	val digits = "0123456789ABCDEF"
	var numbers = String()
	for n in 0..40 {
		if n > 0 then numbers.push(", ")
		numbers.push("0x\(digits[n / 16..n / 16 + 1])\(digits[n % 16..n % 16 + 1])")
	}
	val src = "val TABLE: [u8; 40] = [\(numbers)]\n"
	same(
		formatted(src.toStr(), spaces(40)),
		"val TABLE: [u8; 40] = [\n    0x00, 0x01, 0x02, 0x03, 0x04, 0x05,\n    0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B,\n    0x0C, 0x0D, 0x0E, 0x0F, 0x10, 0x11,\n    0x12, 0x13, 0x14, 0x15, 0x16, 0x17,\n    0x18, 0x19, 0x1A, 0x1B, 0x1C, 0x1D,\n    0x1E, 0x1F, 0x20, 0x21, 0x22, 0x23,\n    0x24, 0x25, 0x26, 0x27,\n]\n",
	)
	val mixed = "val MIXED: [i64; 3] = [1, -2, 3]\n"
	same(formatted(mixed, spaces(100)), mixed)
	val named = "val NAMED = [first, second, third]\n"
	same(formatted(named, spaces(20)), "val NAMED = [\n    first,\n    second,\n    third,\n]\n")
}

/// A file is left as written where one of its leading comments is the line
/// that says so: before anything else, blank lines between them allowed,
/// whether or not the file parses. The same words below the code, in a doc
/// comment, or with more after them do not count.
@test
fn aLeadingCommentLeavesAFileAsWritten() = {
	assert(switchedOff("// wip fmt: off\nfn main() = {}\n"))
	assert(switchedOff("// Written by a tool.\n\n// wip fmt: off   \n\nfn main( = {\n"))
	assert(switchedOff("\n  // wip fmt: off\n"))
	assert(!switchedOff("fn main() = {}\n// wip fmt: off\n"))
	assert(!switchedOff("/// wip fmt: off\nfn main() = {}\n"))
	assert(!switchedOff("// wip fmt: off, mostly\nfn main() = {}\n"))
	assert(!switchedOff("// wip fmt: on\nfn main() = {}\n"))
	assert(!switchedOff(""))
}

/// A struct with no fields and no methods is written as its name alone,
/// however it was written; one whose braces hold a comment keeps them, and
/// so do a `view` and an `extern` one, which are refused without them.
@test
fn anEmptyStructIsItsNameAlone() = {
	val style = spaces(80)
	same(
		formatted("pub struct Csv {}\n@derive(Eq)\nstruct Tag<T> {\n}\n", style),
		"pub struct Csv\n@derive(Eq)\nstruct Tag<T>\n",
	)
	same(formatted("struct Csv\n", style), "struct Csv\n")
	same(
		formatted("struct Kept {\n// nothing yet\n}\n", style),
		"struct Kept {\n    // nothing yet\n}\n",
	)
	same(
		formatted("view struct Seen {}\nextern struct Opaque {}\n", style),
		"view struct Seen {}\nextern struct Opaque {}\n",
	)
}

/// An `if` whose branch holds a comment keeps its braces as a value after
/// `=` and after `=>`, and keeps the comment where it was: the forms it may
/// take are asked for once, since printing it writes its comments.
@test
fn aCommentInABranchKeepsItsBraces() = {
	val style = spaces(80)
	val assigned =
		"fn pick(key: i64): i64 = {\n    val named = if key == 1 {\n        .Some(1)\n    } else if key == 2 {\n        // Two is said at once.\n        return 2\n    } else {\n        .None\n    }\n    // The rest are zero.\n    return 0\n}\n"
	same(formatted(assigned, style), assigned)
	val arm =
		"fn pick(key: i64): i64 = match key {\n    1 => if key > 0 {\n        // Said at once.\n        return 1\n    } else {\n        2\n    }\n    _ => 0\n}\n"
	same(formatted(arm, style), arm)
}

@test
fn alternativesThatDoNotFitFillLinesBrokenBeforeABar() = {
	val src =
		"fn f(v: &View): i64 = match v {\n    .Text(size, ..) | .Label(size, ..) | .Column(size, ..) | .Row(size, ..) | .Block(size, ..) => size\n    _ => 0\n}\n"
	same(
		formatted(src, spaces(60)),
		"fn f(v: &View): i64 = match v {\n    .Text(size, ..) | .Label(size, ..) | .Column(size, ..)\n    | .Row(size, ..) | .Block(size, ..) => size\n    _ => 0\n}\n",
	)
	val short =
		"fn f(v: &View): i64 = match v {\n    .Text(size, ..) | .Row(size, ..) => size\n    _ => 0\n}\n"
	same(formatted(short, spaces(60)), short)
}

/// `keeps` follows the result type and `from`, its names separated as a
/// list's are.
@test
fn keepsFollowsTheResultAndFrom() = {
	val src = "fn longer(a:str,b:str,into:&var Vec<str>):str from a keeps a,b=a\n"
	same(
		formatted(src, spaces(120)),
		"fn longer(a: str, b: str, into: &var Vec<str>): str from a keeps a, b = a\n",
	)
	val void = "fn fill(into:&var Vec<str>,text:str)keeps text={}\n"
	same(formatted(void, spaces(120)), "fn fill(into: &var Vec<str>, text: str) keeps text = {}\n")
}
