// Comments, which the lexer passes over: they are found again in the text
// between the tokens, and handed to the printer in order, so that each is
// written where it was — on a line of its own before what followed it, or
// at the end of the line it ended.

import syntax::{Token}

@derive(Eq, Clone)
pub struct Comment {
	/// Where it starts in the file.
	pub at: u32
	/// `// …`, without what trails it.
	pub text: String
	/// It has a line of its own, rather than ending a line of code.
	pub ownLine: bool
	/// A blank line comes before it.
	pub blankBefore: bool
}

/// Every `//` comment of a file, in order. Only the text between tokens is
/// looked at, so a `//` inside a string is not one.
pub fn comments(src: str, tokens: &[Token]): Vec<Comment> = {
	var found: Vec<Comment> = Vec()
	var from = 0
	for token in tokens {
		val to = token.span.lo as i64
		if to > from then gap(src, from, to, &var found)
		if token.span.hi as i64 > from then from = token.span.hi as i64
	}
	if from < src.len() then gap(src, from, src.len(), &var found)
	return move found
}

/// The comments in `src[from..to]`, which holds nothing but space and
/// comments.
fn gap(src: str, from: i64, to: i64, found: &var Vec<Comment>) = {
	val text = src[from..to]
	var offset = 0
	while text[offset..text.len()].find("//") is .Some(start) {
		val at = offset + start
		val end = match text[at..text.len()].find("\n") {
			.Some(n) => at + n
			.None => text.len()
		}
		val before = src[0..from + at]
		val lineStart = match before.findLast("\n") {
			.Some(n) => n + 1
			.None => 0
		}
		val ownLine = isBlank(withoutMarks(before[lineStart..before.len()]))
		// A blank line before it: two line breaks with nothing but space
		// between them and the comment.
		var blankBefore = false
		if ownLine {
			var upto = lineStart
			while upto > 0 && before[upto - 1] is b'\n' | b'\r' {
				upto -= 1
			}
			var newlines = 0
			for b in before[upto..before.len()] {
				if b == b'\n' then newlines += 1
			}
			blankBefore = newlines >= 2 && upto > 0
		}
		found.push(Comment(
			at: (from + at) as u32,
			text: trimEndSpace(text[at..end]),
			ownLine: ownLine,
			blankBefore: blankBefore,
		))
		offset = end
	}
}

/// `text` without the byte order marks it starts with.
fn withoutMarks(text: str): str = {
	var at = 0
	while text[at..text.len()].startsWith("\u{feff}") {
		at += 3
	}
	return text[at..text.len()]
}

/// Whether `text` is white space alone, as Unicode counts it.
fn isBlank(text: str): bool = {
	for c in text.chars() {
		if !c.isWhitespace() then return false
	}
	return true
}

/// Whether `src[from..to]` holds a blank line: two line breaks with only
/// space between them. Comments count as something, so a blank line after
/// a comment is found where it is.
pub fn blankBetween(src: str, from: i64, to: i64): bool = {
	val text = src[if from < to then from else to..to]
	var newlines = 0
	var inComment = false
	var at = 0
	while at < text.len() {
		val c = text[at]
		at += 1
		if c == b'\n' {
			inComment = false
			newlines += 1
			if newlines >= 2 then return true
		} else if c == b'/' && !inComment && at < text.len() && text[at] == b'/' {
			inComment = true
			newlines = 0
		} else if c is b' ' | b'\t' | b'\r' {} else if !inComment {
			newlines = 0
		}
	}
	return false
}
