// Sizes, alignments and field offsets, computed once per program and shared
// by every backend. Struct layouts are C-like.

import std::collections::{Map}

/// The size and alignment of a type, in bytes.
@derive(Eq)
pub struct Layout {
	pub size: u32
	pub align: u32
}

struct StructLayout {
	layout: Layout
	offsets: Vec<u32>
}

/// Struct layouts are C-like: fields in declaration order, each at the next
/// offset that satisfies its alignment. Each instance of a generic struct or
/// enum has a layout of its own, so layouts are kept by type, and computed
/// when first asked for.
pub struct Layouts {
	structs: Map<Ty, StructLayout> = Map()
	enums: Map<Ty, EnumLayout> = Map()
}

/// Where an enum records which variant it holds.
@derive(Eq, Clone)
pub enum Tag {
	/// The variant's index, in the first `size` bytes.
	Byte(size: u32)
	/// No tag: the variant `payload` holds, in the `size` bytes at `offset`,
	/// `count` values it never holds from `first` on — a null pointer, a
	/// `bool` past 1, a `char` past the last, an enum's tag past its last
	/// variant — and the variants `empties`, which hold nothing, are the
	/// first of them, in order.
	Niche(payload: u32, offset: u32, size: u32, first: u64, count: u64, empties: Vec<u32>)
}

extend Tag {
	/// The value the niche holds for `variant`, where it is one of those
	/// the niche stands for.
	pub fn nicheValue(variant: u32): Option<u64> = match self {
		.Niche(first, empties, ..) => match empties.indexOf(&variant) {
			.Some(k) => first + k as u64
			.None => .None
		}
		.Byte(..) => .None
	}
}

/// Values a type never holds: `count` of them from `first`, in the `size`
/// bytes at `offset` of a value of it.
struct NicheBytes {
	offset: u32
	size: u32
	first: u64
	count: u64
}

extend NicheBytes {
	/// A pointer's null, at `offset`.
	static fn pointer(offset: u32): NicheBytes = NicheBytes(offset:, size: 8, first: 0, count: 1)

	/// The same bytes, `by` further into what holds them.
	fn at(by: u32): NicheBytes = NicheBytes(
		offset: self.offset + by,
		size: self.size,
		first: self.first,
		count: self.count,
	)
}

/// An enum's layout: its tag, and the offsets of each variant's fields from
/// the start of the value.
struct EnumLayout {
	layout: Layout
	tag: Tag
	offsets: Vec<Vec<u32>>
}

extend Layout {
	/// Distance between consecutive array elements.
	pub fn stride(): u32 = nextMultiple(self.size, self.align)
}

extend Layouts {
	pub static fn new(): Layouts = Layouts()

	pub var fn structLayout(program: &Program, ty: Ty): Layout = {
		if self.structs.get(&ty) is .Some(s) then
			return s.layout

		// A union's fields are all at 0, over the same bytes, and it is as
		// large as the largest of them. `@packed` puts each field right after
		// the one before, and `@align` raises the alignment of a field or of
		// the struct, never lowering one below its own.
		var union = false
		var packed = false
		var raised: u32 = 1
		var fieldAligns: Vec<Option<u32>> = Vec()
		if program.types.kind(ty) is .Struct(id, ..) {
			val def = &program.structs[id]
			union = def.isUnion
			packed = def.packed
			if def.align is .Some(n) then
				raised = n

			for f in def.fields do
				fieldAligns.push(f.align)
		}
		var size: u32 = 0
		var align: u32 = 1
		var offsets: Vec<u32> = Vec()
		val fieldTys = program.fieldTys(ty)
		for (i, fieldTy) in fieldTys.indexed() {
			val field = self.of(&program, fieldTy)
			var fieldAlign = if packed then 1 else field.align
			if fieldAligns.get(i) is .Some(.Some(n)) then
				fieldAlign = fieldAlign.max(n)

			if union {
				offsets.push(0)
				size = size.max(field.size)
			} else {
				size = nextMultiple(size, fieldAlign)
				offsets.push(size)
				size += field.size
			}
			align = align.max(fieldAlign)
		}
		align = align.max(raised)
		val layout = Layout(size: nextMultiple(size, align), align:)
		self.structs.put(ty, StructLayout(layout:, offsets:))
		return layout
	}

	pub var fn of(program: &Program, ty: Ty): Layout = match program.types.kind(ty) {
		// A length is no value's type, and an array of a length parameter is
		// laid out in each instance, where its length is known.
		.Unit | .Never | .Error | .Count(..) | .ArrayOf(..) => Layout(size: 0, align: 1)
		// Integers are aligned to their size: `i128` to 16 bytes, as C
		// compilers align `__int128`.
		.Int(int) => {
			val size = int.bits() / 8
			Layout(size:, align: size)
		}
		.Float(float: .F32) => Layout(size: 4, align: 4)
		// A slice is known by a pointer and a length, and so are a reference
		// to one and a buffer. A `&dyn` is a pointer and a table of methods.
		.Slice(..) | .Dyn(..) => Layout(size: 16, align: 8)
		// A closure lent for one call is what it captured and its code.
		.Ref(inner: e, ..) | .Own(inner: e) if program.types.kind(e) is .Slice(..) | .Dyn(..)
		| .Fn(..) => Layout(size: 16, align: 8)
		// A C pointer is one word, like every other pointer.
		.Float(float: .F64) | .Cstring | .Fn(..) | .Own(..) | .Ptr(..) | .Ref(..) => Layout(
			size: 8,
			align: 8,
		)
		// No value of an opaque C type exists; only `ptr<T>` of one.
		.Opaque(..) => Layout(size: 0, align: 1)
		// A block of slots is a pointer and how many there are.
		.Slots(..) => Layout(size: 16, align: 8)
		// A pointer and a length.
		.Str => Layout(size: 16, align: 8)
		.Bool => Layout(size: 1, align: 1)
		// A Unicode scalar value, in 32 bits.
		.Char => Layout(size: 4, align: 4)
		.Struct(..) => self.structLayout(&program, ty)
		.Array(elem, len) => {
			val element = self.of(&program, elem)
			val size = element.stride() * len
			if size > 0xFFFF_FFFF then
				panic("arrays larger than 4 GiB are not supported")

			Layout(size: size as u32, align: element.align)
		}
		.Enum(..) => self.enumLayout(&program, ty)
		.Param(..) | .Assoc(..) => panic("only instances of generic items are laid out")
	}

	/// Whether a place inside a value of `ty` at field `index` may lie at an
	/// address its type's alignment does not promise: a field of a packed
	/// struct.
	pub fn packedAt(program: &Program, ty: Ty): bool = match program.types.kind(ty) {
		.Struct(id, ..) => program.structs[id].packed
		_ => false
	}

	pub var fn fieldOffset(program: &Program, ty: Ty, index: u32): u32 = {
		self.structLayout(&program, ty)
		return match self.structs.get(&ty) {
			.Some(s) => s.offsets[index]
			.None => panic("laid out above")
		}
	}

	/// An enum's layout: a tag and then each variant's fields over the same
	/// bytes, or no tag at all where values the one variant with fields
	/// never holds can stand for the others.
	pub var fn enumLayout(program: &Program, ty: Ty): Layout = {
		if self.enums.get(&ty) is .Some(e) then
			return e.layout

		val variants = program.variantFieldTys(ty)
		var fields: Vec<Vec<Layout>> = [for variant in variants {
			val layouts: Vec<Layout> = variant.map((f) => self.of(&program, f))
			yield layouts
		}]
		val niche = self.nicheOf(&program, &variants)
		val enumLayout = match niche {
			.Some((payload, bytes)) => {
				val (offsets, end) = sequential(&fields[payload], 0)
				var align: u32 = 1
				for f in fields[payload] do
					align = align.max(f.align)

				var empties: Vec<u32> = Vec()
				var all: Vec<Vec<u32>> = Vec()
				for i in 0..variants.len() {
					if i != payload then
						empties.push(i as u32)

					all.push(if i == payload then offsets.clone() else Vec())
				}
				EnumLayout(
					layout: Layout(size: nextMultiple(end, align), align:),
					tag: .Niche(
						payload: payload as u32,
						offset: bytes.offset,
						size: bytes.size,
						first: bytes.first,
						count: bytes.count,
						empties:,
					),
					offsets: all,
				)
			}
			.None => {
				val tagSize: u32 = if variants.len() <= 256 then 1 else 4
				var payloadAlign: u32 = 1
				for variant in fields {
					for f in variant do
						payloadAlign = payloadAlign.max(f.align)
				}
				val start = nextMultiple(tagSize, payloadAlign)
				var size = tagSize
				var offsets: Vec<Vec<u32>> = Vec()
				for variant in fields {
					val (variantOffsets, end) = sequential(&variant, start)
					size = size.max(end)
					offsets.push(variantOffsets)
				}
				val align = tagSize.max(payloadAlign)
				EnumLayout(
					layout: Layout(size: nextMultiple(size, align), align:),
					tag: .Byte(tagSize),
					offsets:,
				)
			}
		}
		val layout = enumLayout.layout
		self.enums.put(ty, enumLayout)
		return layout
	}

	/// Of an enum whose one variant carries fields and the rest nothing, the
	/// variant, and values its fields never hold, enough for the rest. A
	/// variant that owns memory takes only an `own`'s null, where nothing
	/// else in it owns memory: a move out of it leaves zeros, which must
	/// read as an empty variant, and a type with a `destroy` of its own is
	/// poisoned rather than zeroed where moves are checked, so the way to
	/// the `own` passes through none.
	var fn nicheOf(program: &Program, variants: &[Vec<Ty>]): Option<(i64, NicheBytes)> = {
		if variants.len() < 2 then
			return .None

		var payload: Option<i64> = .None
		for (i, fields) in variants.indexed() {
			if fields.isEmpty() then
				continue

			if payload.isSome() then
				return .None

			payload = i
		}
		val .Some(carrier) = payload else return .None
		val fields = &variants[carrier]
		val widths: Vec<Layout> = [
			for f in fields do
				yield self.of(&program, f)
		]
		val (offsets, _) = sequential(&widths, 0)
		val empties = (variants.len() - 1) as u64
		val owning: Vec<i64> = [
			for (i, f) in fields.indexed() do
				if program.ownsMemory(f) then
					yield i
		]
		var best: Option<NicheBytes> = .None
		if owning.isEmpty() {
			for (i, f) in fields.indexed() {
				val .Some(bytes) = self.nicheIn(&program, f) else continue
				if best is .Some(known) && known.count >= bytes.count then
					continue

				best = bytes.at(offsets[i])
			}
		} else if owning.len() == 1 && empties == 1 {
			val i = owning[0]
			if self.ownedNicheIn(&program, fields[i]) is .Some(bytes) then
				best = bytes.at(offsets[i])
		}
		val .Some(bytes) = best else return .None
		if bytes.count < empties then
			return .None

		return (carrier, bytes)
	}

	/// The values a value of `ty` never holds, where it has some: a null
	/// pointer — an `own`, a reference, a function, a closure's code, a
	/// `&dyn`'s table — a `bool` past 1, a `char` past the last, an enum's
	/// tag past its last variant or what its own niche leaves, a struct's
	/// field's with the most, an array's first element's. Integers, floats
	/// and `ptr<T>` hold every value; a `str`, a slice and a buffer are made
	/// from C's pointers too, which nothing checks; and what C lays out, an
	/// `extern struct` or a union, keeps none of Wip's rules.
	var fn nicheIn(program: &Program, ty: Ty): Option<NicheBytes> = match program.types.kind(ty) {
		.Bool => NicheBytes(offset: 0, size: 1, first: 2, count: 254)
		.Char => NicheBytes(offset: 0, size: 4, first: 0x110000, count: 0x1_0000_0000 - 0x110000)
		.Fn(..) => NicheBytes::pointer(0)
		.Own(inner) | .Ref(inner, ..) => match program.types.kind(inner) {
			.Slice(..) => .None
			// A closure's code, and a `&dyn`'s table of methods, are never
			// null.
			.Fn(..) | .Dyn(..) => NicheBytes::pointer(8)
			_ => NicheBytes::pointer(0)
		}
		.Struct(id, ..) => {
			val def = &program.structs[id]
			if def.isExtern || def.isUnion || def.isOpaque || def.isIntrinsic then
				return .None

			var best: Option<NicheBytes> = .None
			for (i, f) in program.fieldTys(ty).indexed() {
				val .Some(bytes) = self.nicheIn(&program, f) else continue
				if best is .Some(known) && known.count >= bytes.count then
					continue

				best = bytes.at(self.fieldOffset(&program, ty, i as u32))
			}
			best
		}
		.Enum(..) => match self.enumTag(&program, ty) {
			.Byte(size) => {
				val variants = program.variantFieldTys(ty).len() as u64
				val all: u64 = if size == 1 then 256 else 0x1_0000_0000
				if variants >= all then
					return .None

				Option::Some(NicheBytes(offset: 0, size:, first: variants, count: all - variants))
			}
			.Niche(offset, size, first, count, empties, ..) => {
				val used = empties.len() as u64
				if count <= used then
					return .None

				Option::Some(NicheBytes(offset:, size:, first: first + used, count: count - used))
			}
		}
		.Array(elem, len) if len > 0 => self.nicheIn(&program, elem)
		_ => .None
	}

	/// In a value of `ty` that owns memory, the `own` whose null may stand
	/// for an empty variant: one that is not a buffer, alone or the one
	/// thing that owns memory in a struct with no `destroy` of its own.
	var fn ownedNicheIn(program: &Program, ty: Ty): Option<NicheBytes> = match program.types.kind(
		ty,
	) {
		.Own(inner) => match program.types.kind(inner) {
			.Slice(..) | .Dyn(..) => .None
			_ => NicheBytes::pointer(0)
		}
		.Struct(id, ..) => {
			val def = &program.structs[id]
			if def.isExtern || def.isUnion || def.isIntrinsic || program.dropFns.contains(&ty) then
				return .None

			var found: Option<NicheBytes> = .None
			var owners = 0
			for (i, f) in program.fieldTys(ty).indexed() {
				if !program.ownsMemory(f) then
					continue

				owners += 1
				if self.ownedNicheIn(&program, f) is .Some(bytes) then
					found = bytes.at(self.fieldOffset(&program, ty, i as u32))
			}
			if owners == 1 then
				found
			else
				.None
		}
		_ => .None
	}

	pub var fn enumTag(program: &Program, ty: Ty): Tag = {
		self.enumLayout(&program, ty)
		return match self.enums.get(&ty) {
			.Some(e) => e.tag.clone()
			.None => panic("laid out above")
		}
	}

	pub var fn variantOffset(program: &Program, ty: Ty, variant: u32, field: u32): u32 = {
		self.enumLayout(&program, ty)
		return match self.enums.get(&ty) {
			.Some(e) => e.offsets[variant][field]
			.None => panic("laid out above")
		}
	}
}

/// Offsets for fields laid out one after another from `start`, each at the
/// next multiple of its alignment, and where the last one ends.
fn sequential(fields: &[Layout], start: u32): (Vec<u32>, u32) = {
	var end = start
	var offsets: Vec<u32> = Vec()
	for f in fields {
		val offset = nextMultiple(end, f.align)
		end = offset + f.size
		offsets.push(offset)
	}
	return (offsets, end)
}

/// The smallest multiple of `align` that is `n` or more.
pub fn nextMultiple(n: u32, align: u32): u32 = if n % align == 0 then n else n + (align - n % align)

/// Whether values of type `ty` live in memory and are passed by address:
/// structs, enums, arrays, `str`, slices, references to slices and buffers.
pub fn isAggregate(program: &Program, ty: Ty): bool =
	program.types.kind(ty) is .Struct(..) | .Enum(..) | .Array(..) | .Str | .Slice(..) ||
	isSlicePointer(&program, ty) ||
	isDynPointer(&program, ty) ||
	isClosurePointer(&program, ty)

/// Whether a value of type `ty` is one machine value: an integer, a float, a
/// `bool`, a `cstring`, or an `own` or reference to anything but a slice.
pub fn isScalar(program: &Program, ty: Ty): bool =
	program.types.kind(
		// A C pointer is a scalar: one word, copied.
		ty,
	) is .Int(..) | .Float(..) | .Bool | .Char | .Cstring | .Fn(..) | .Own(..) | .Ptr(..) | .Ref(..) &&
	!isSlicePointer(&program, ty) &&
	!isDynPointer(&program, ty) &&
	!isClosurePointer(&program, ty)

/// A reference to a `dyn Interface`: a pointer to the value, and the address
/// of its type's table of methods.
pub fn isDynPointer(program: &Program, ty: Ty): bool = match program.types.kind(ty) {
	.Ref(inner, ..) => program.types.kind(inner) is .Dyn(..)
	_ => false
}

/// A closure lent for one call: what it captured, and the address of its
/// code.
pub fn isClosurePointer(program: &Program, ty: Ty): bool = match program.types.kind(ty) {
	.Ref(inner: e, ..) | .Own(inner: e) => program.types.kind(e) is .Fn(..)
	_ => false
}

/// A reference to a slice or a buffer: a pointer to the elements, and their
/// number. A block of slots is the same two words.
pub fn isSlicePointer(program: &Program, ty: Ty): bool = match program.types.kind(ty) {
	.Slots(..) => true
	.Ref(inner: e, ..) | .Own(inner: e) => program.types.kind(e) is .Slice(..)
	_ => false
}
