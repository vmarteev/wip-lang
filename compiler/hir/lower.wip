// Name resolution and type checking: syntax tree to `Program`.
//
// Checking is bidirectional. An expected type flows down where the context
// knows it (annotated `let`, arguments, `return`, field initializers) and is
// checked with `Lowerer.check`; everywhere else the type is synthesized
// bottom-up by `Lowerer.infer`. There is no inference beyond that.
//
// The bodies are checked on several threads, each on a copy of the
// declarations, and what each found is merged in order: the types each
// interned are absorbed, and its bodies renumbered, so the program is the
// same at any number of threads.

import std::collections::{Map, Set}
import std::future
import std::mem
import syntax as ast
import syntax::{DUPLICATE_DEFINITION, Diagnostic, Interner, Span, Symbol, split}

pub struct Lowered {
	pub var program: Program
	pub var diagnostics: Vec<Diagnostic>
}

/// One module's files, as the driver found them.
pub view struct ModuleAst {
	/// `a::b::c`, and empty for the root module. A module of a dependency is
	/// named with the dependency's name first, `engine::render`, which is how
	/// every other package writes it.
	pub var path: String
	pub var files: Vec<&ast::Ast>
	/// What the module's own paths are written from: empty for the program's
	/// package and the standard library, and the package's name for a
	/// dependency, so that `render` written in `engine` is `engine::render`.
	pub var prefix: String
	/// The names of the packages the module's package depends on, which its
	/// paths may begin with as they may begin with `std`.
	pub var depends: Vec<String>
	/// Where its files are, which the files it embeds are read relative to,
	/// and its package's root, which they may not leave. Nothing for the
	/// standard library, which is in the compiler, and for a file checked on
	/// its own.
	pub var dir: Option<String>
	pub var root: Option<String>
	/// What the module's package names with `@files`, which a literal path
	/// given to `package::besideProgram` is checked against.
	pub var packageFiles: Vec<String> = Vec()
	/// For each of `files`, the test file whose names it declares, by its
	/// number among the module's test files; none for the module's own,
	/// which share theirs. Empty where every file is the module's own.
	pub var tests: Vec<Option<i64>> = Vec()
}

extend ModuleAst {
	/// The files whose declarations a file of test file `test` sees by name —
	/// the module's own, and that test file's, where it is one — and, apart,
	/// the other test files, whose `pub` items it sees too.
	fn seenFiles(test: Option<i64>): (Vec<&ast::Ast>, Vec<&ast::Ast>) from self = {
		var seen: Vec<&ast::Ast> = Vec()
		var others: Vec<&ast::Ast> = Vec()
		for j in 0..self.files.len() {
			val its = if j < self.tests.len() then self.tests[j] else .None
			if its.isNone() || its == test then seen.push(self.files[j])
			else if test.isSome() then others.push(self.files[j])
		}
		return (seen, others)
	}
}

/// What one file sees beyond its module's names: what its imports bind,
/// and, for a test file, the scope of the names it declares.
@derive(Clone)
struct FileImports {
	/// The scope of a test file's own names, among the lowerer's scopes;
	/// none for a module's own file, whose names are its module's.
	names: Option<i64> = .None
	/// Modules, by the name the file gave them.
	modules: Map<Symbol, i64> = Map()
	/// Items of other modules, by the name the file gave them.
	items: Map<Symbol, ImportedItem> = Map()
}

@derive(Clone)
enum ImportedItem {
	/// The item's module, and its name there.
	Item(module: i64, name: ast::Name)
	/// An import already reported as wrong: its uses stay quiet.
	Broken
}

/// `type Id = i64`: another name for a type. The body is resolved once,
/// with the alias's own parameters standing in it, and each use substitutes
/// the arguments it was given.
@derive(Clone)
struct AliasDef {
	/// Nothing until something asks for it, and its body is resolved.
	ty: Option<Ty>
	generics: Vec<GenericParamDef>
	isPub: bool
	span: Span
}

/// How far the checker has come through a program, in order: what it learns
/// in one phase it knows in every later one, and a check that needs what it
/// does not know yet waits for the phase that tells it.
@derive(Eq, Ord, Clone)
enum Phase {
	/// Names are declared and types resolved: whether a type owns memory is
	/// not known yet.
	Declaring
	/// Every type's body is resolved; what implements what is not known yet.
	TypesResolved
	/// Every `extend` block is declared, and bodies are checked.
	ImplsDeclared
}

/// Where an alias is written, to resolve its body there.
@derive(Clone)
view struct AliasSource {
	decl: &ast::TypeAlias
	ast: &ast::Ast
	imports: FileImports
}

/// Where a type whose fields have defaults is declared, with what its file
/// sees: its defaults are checked there, when a literal first needs them or
/// in their turn, whichever comes first.
@derive(Clone)
view struct DefaultSource {
	item: Declared
	module: i64
	ast: &ast::Ast
	imports: FileImports
	lambdas: Map<ast::ExprId, FnId>
	lambdaEnvs: Map<FnId, StructId>
	generators: Map<ast::ExprId, StructId>
}

/// The names one module declares, and what it exports; or, where it has a
/// scope it is inside, the names one test file declares, which that file
/// alone sees, inside the scope of what its module's test files mark
/// `pub`, which they all see, inside the module's own.
@derive(Clone)
struct ModuleScope {
	path: String
	/// The scope a test's scope is inside: none for a module's own.
	inside: Option<i64> = .None
	/// For one test file's own names, which of its module's test files it
	/// is, as `ModuleAst::tests` numbers them.
	test: Option<i64> = .None
	/// The module's package, as `ModuleAst` says.
	prefix: String
	depends: Vec<String>
	/// Where its files are, and its package's root.
	dir: Option<String>
	root: Option<String>
	packageFiles: Vec<String> = Vec()
	types: Map<Symbol, (TypeDef, Span)> = Map()
	/// The type aliases the module declares.
	aliases: Map<Symbol, AliasDef> = Map()
	/// The opaque C types the module declares.
	opaques: Map<Symbol, OpaqueId> = Map()
	/// The interfaces the module declares.
	interfaces: Map<Symbol, (InterfaceId, Span)> = Map()
	fns: Map<Symbol, FnId> = Map()
	/// The constants the module declares.
	consts: Map<Symbol, ConstId> = Map()
	/// The variables C owns that the module declares.
	globals: Map<Symbol, GlobalId> = Map()
}

/// A scope of test files' names inside the scope `inside`, of `module`'s,
/// named for messages as `what` of it, a name no import can write.
fn testScope(module: &ModuleAst, inside: i64, what: str): ModuleScope = ModuleScope(
	path: "\(module.path) (\(what))",
	inside: .Some(inside),
	prefix: module.prefix.clone(),
	depends: module.depends.clone(),
	dir: module.dir.clone(),
	root: module.root.clone(),
	packageFiles: module.packageFiles.clone(),
)

/// Lowers a program of one file, in the root module.
pub fn lowerFile(file: &ast::Ast, interner: &Interner): Lowered = lower(
	[
		ModuleAst(
			path: String(),
			files: [&file],
			prefix: String(),
			depends: Vec(),
			dir: .None,
			root: .None,
		),
	],
	&interner,
	future::cores(),
	Vec(),
)

/// Lowers a program, checking its bodies on up to `threads` threads, with
/// the constants a build defines set as `defines` says.
pub fn lower(
	modules: &[ModuleAst],
	interner: &Interner,
	threads: i64,
	defines: Vec<Define>,
): Lowered = {
	// Every file, with the module it belongs to.
	var files: Vec<(i64, &ast::Ast)> = Vec()
	for index in 0..modules.len() {
		for file in modules[index].files {
			files.push((index, file))
		}
	}
	var paths: Vec<String> = Vec()
	for module in modules {
		paths.push(module.path.clone())
	}
	val program = Program::new(paths)
	if files.isEmpty() then return Lowered(program: program, diagnostics: Vec())
	var scopes: Vec<ModuleScope> = Vec()
	for module in modules {
		scopes.push(ModuleScope(
			path: module.path.clone(),
			prefix: module.prefix.clone(),
			depends: module.depends.clone(),
			dir: module.dir.clone(),
			root: module.root.clone(),
			packageFiles: module.packageFiles.clone(),
		))
	}
	// Each module's test files: a scope their `pub` names share, inside the
	// module's, and inside that a scope of each one's own; and what each file
	// sees beyond its module before its imports are read, which for a test
	// file is its scope.
	var seen: Vec<FileImports> = Vec()
	for index in 0..modules.len() {
		val module = &modules[index]
		var shared: Option<i64> = .None
		var ownScopes: Map<i64, i64> = Map()
		for f in 0..module.files.len() {
			val test = if f < module.tests.len() then module.tests[f] else .None
			val .Some(k) = test else {
				seen.push(FileImports())
				continue
			}
			if shared.isNone() {
				shared = .Some(scopes.len())
				scopes.push(testScope(&module, index, "tests"))
			}
			if !ownScopes.contains(&k) {
				ownScopes.put(k, scopes.len())
				var scope = testScope(&module, shared.unwrap(), "test \(k)")
				scope.test = .Some(k)
				scopes.push(scope)
			}
			seen.push(FileImports(names: ownScopes.get(&k).map((scope) => scope.clone())))
		}
	}
	var lowerer = Lowerer::new(files[0].1, &interner, program, scopes)
	// The prelude is declared before anything else, so that a module that
	// declares one of its names is reported.
	var prelude: Option<i64> = .None
	for (i, module) in modules.forwards().enumerate() {
		if prelude.isNone() && module.path == PRELUDE then prelude = .Some(i)
	}
	var declarationOrder: Vec<i64> = Vec()
	for i in 0..files.len() {
		if prelude == .Some(files[i].0) then declarationOrder.push(i)
	}
	for i in 0..files.len() {
		if prelude != .Some(files[i].0) then declarationOrder.push(i)
	}
	// Imports are resolved once, so their errors are reported once.
	var imports: Vec<FileImports> = Vec()
	for i in 0..files.len() {
		lowerer.enter(files[i].0, files[i].1, seen[i].clone())
		imports.push(lowerer.resolveImports())
	}

	// Names first, so that a type may be used before it is declared and by
	// any module that imports it. Interfaces come before types, since a
	// type's parameters may be constrained by one.
	var interfaces: Vec<Vec<(&ast::InterfaceDecl, InterfaceId)>> = Vec()
	var types: Vec<Vec<(Declared, TypeDef)>> = Vec()
	for _ in files {
		interfaces.push(Vec())
		types.push(Vec())
	}
	for i in declarationOrder {
		lowerer.enter(files[i].0, files[i].1, seen[i].clone())
		interfaces[i] = lowerer.collectInterfaces()
	}
	for i in declarationOrder {
		lowerer.enter(files[i].0, files[i].1, seen[i].clone())
		types[i] = lowerer.collectTypes()
	}
	// The type aliases' names, before any body names one.
	for i in declarationOrder {
		lowerer.enter(files[i].0, files[i].1, seen[i].clone())
		lowerer.collectAliases()
	}
	// With every type named, the items a file imports can be checked before
	// anything uses them.
	var checkedImports: Vec<FileImports> = Vec()
	for i in 0..files.len() {
		checkedImports.push(seen[i].clone())
	}
	for i in declarationOrder {
		lowerer.enter(files[i].0, files[i].1, mem::replace(&var imports[i], FileImports()))
		checkedImports[i] = lowerer.checkImportedItems(&modules)
	}
	imports = checkedImports
	// The constraints of the types' and the interfaces' parameters, which may
	// name an interface or a type the file imports.
	for i in declarationOrder {
		lowerer.enter(files[i].0, files[i].1, imports[i].clone())
		lowerer.constrainDeclared(&types[i], &interfaces[i])
	}
	// A function for every lambda, before the bodies are checked, and before
	// the constants, whose values may hold one too.
	var lambdas: Vec<Map<ast::ExprId, FnId>> = Vec()
	var envs: Vec<Map<FnId, StructId>> = Vec()
	// And a struct and its `next` for every loop that is a generator.
	var generators: Vec<Map<ast::ExprId, StructId>> = Vec()
	for _ in files {
		lambdas.push(Map())
		envs.push(Map())
		generators.push(Map())
	}
	for i in declarationOrder {
		lowerer.enter(files[i].0, files[i].1, imports[i].clone())
		val (fileLambdas, fileEnvs) = lowerer.collectLambdas()
		lambdas[i] = fileLambdas
		envs[i] = fileEnvs
		generators[i] = lowerer.collectGenerators()
	}
	val files = files
	val lambdas = lambdas
	val envs = envs
	val generators = generators
	// Constants are declared before type bodies, since an array's length may
	// be one; each is worked out where it is first needed, with its file's
	// lambdas and generators.
	for i in declarationOrder {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.declareConsts()
		lowerer.declareTypeConsts()
	}
	lowerer.matchDefines(&defines)
	lowerer.defineList = defines
	// The environment a named function lent as a closure carries, which holds
	// nothing.
	lowerer.program.fnClosureEnv = .Some(
		lowerer.program.structs.add(StructDef(
			isExtern: false,
			isUnion: false,
			isOpaque: false,
			isIntrinsic: false,
			header: .None,
			accessors: Vec(),
			name: interner.lambdaSymbol(),
			generics: Vec(),
			fields: Vec(),
			methods: Vec(),
			isTuple: false,
			generator: .None,
			isEnv: true,
			isView: false,
			module: 0,
			isPub: false,
			span: Span::at(0),
		)),
	)
	// And the one a named function made an owned closure carries, which holds
	// nothing but the function that drops it, as every owned closure's
	// environment begins with.
	val address = lowerer.program.types.internList([PTR_U8])
	val dropTy = lowerer.intern(.Fn(params: address, ret: UNIT))
	lowerer.program.fnOwnedClosureEnv = .Some(
		lowerer.program.structs.add(StructDef(
			isExtern: false,
			isUnion: false,
			isOpaque: false,
			isIntrinsic: false,
			header: .None,
			accessors: Vec(),
			name: interner.lambdaSymbol(),
			generics: Vec(),
			fields: [
				FieldDef(
					isPub: false,
					isVar: false,
					name: interner.lambdaSymbol(),
					ty: dropTy,
					span: Span::at(0),
					default: .None,
				),
			],
			methods: Vec(),
			isTuple: false,
			generator: .None,
			isEnv: true,
			isView: false,
			module: 0,
			isPub: false,
			span: Span::at(0),
		)),
	)
	// An alias's body, once the imports are known: each where it is written,
	// and one another names when that one is resolved, which says where an
	// alias names itself.
	for i in declarationOrder {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.recordAliasSources()
	}
	// The defaults of type parameters, before any alias or type body leaves
	// an argument out. One may leave out another's, so they are read in
	// rounds until a round reads none; what is left rests on itself.
	while true {
		var read = false
		for i in declarationOrder {
			lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
			if lowerer.resolveDefaults(&types[i], false) then read = true
		}
		if !read then break
	}
	for i in declarationOrder {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.resolveDefaults(&types[i], true)
	}
	// An interface's defaults may name a type whose own were read above, and
	// `Self`.
	for i in declarationOrder {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.resolveInterfaceDefaults(&interfaces[i])
	}
	for i in declarationOrder {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.resolveAliases()
	}
	for i in 0..files.len() {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.resolveTypeBodies(&types[i])
	}
	// Whether a field borrows is a question of what the types it names
	// hold, known once every type's fields are.
	lowerer.program.findHeldParams()
	for i in 0..files.len() {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.checkStoredFields(&types[i])
	}
	for i in 0..files.len() {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.checkPackedStructs(&types[i])
	}
	lowerer.checkRecursiveTypes()
	lowerer.flushCopyChecks()
	// An interface's methods before anything implements it.
	var fns: Vec<Vec<BodyWork>> = Vec()
	// The parameters with defaults, by file, which are checked once every
	// function is declared.
	var paramDefaults: Vec<Vec<(FnId, i64, ast::ExprId)>> = Vec()
	for _ in files {
		fns.push(Vec())
		paramDefaults.push(Vec())
	}
	for i in declarationOrder {
		lowerer.enter(files[i].0, files[i].1, imports[i].clone())
		lowerer.declareInterfaceMethods(&interfaces[i], &var fns[i])
		for d in mem::replace(&var lowerer.paramDefaults, Vec()) {
			paramDefaults[i].push(d)
		}
	}
	// What every type asks `@derive` for, before any is declared: a field of
	// a type declared in a later file is counted too, and what `@derive`
	// wrote is for the type that asked.
	for i in declarationOrder {
		lowerer.noteDerives(&types[i])
	}
	for i in declarationOrder {
		lowerer.enter(files[i].0, files[i].1, imports[i].clone())
		for work in lowerer.collectFns() {
			fns[i].push(work)
		}
		for d in mem::replace(&var lowerer.paramDefaults, Vec()) {
			paramDefaults[i].push(d)
		}
	}
	lowerer.checkTestNames()
	// Every generator is an `Iterator`, with the interface's other methods.
	for i in declarationOrder {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.declareGeneratorImpls()
	}
	// An enum whose variants carry nothing gets `count` and `fromIndex`,
	// unless the program declared methods of those names.
	for i in 0..files.len() {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.declareEnumNumbers(&types[i])
	}
	// With every implementation declared, what each one `@derive` wrote asks
	// of the type's parameters is worked out from the fields, and then the
	// fields are checked.
	lowerer.deriveConditions(&types)
	for i in declarationOrder {
		lowerer.enter(files[i].0, files[i].1, imports[i].clone())
		lowerer.declareEquality(&types[i])
	}
	// With every implementation declared, the constraints on the types
	// written before them can be checked.
	lowerer.flushConstraintChecks()
	// Defaults, once every function is declared, since one may be code that
	// calls one; a field's first, since a parameter's may be a literal that
	// leaves one out.
	for i in 0..files.len() {
		for (item, def) in types[i] {
			if item.hasFieldDefaults() then
				lowerer.defaultSources.put(def, DefaultSource(
					item: item,
					module: files[i].0,
					ast: files[i].1,
					imports: imports[i].clone(),
					lambdas: lambdas[i].clone(),
					lambdaEnvs: envs[i].clone(),
					generators: generators[i].clone(),
				))
		}
	}
	for declared in types {
		for (_, def) in declared {
			lowerer.ensureDefaults(def)
		}
	}
	for i in 0..files.len() {
		lowerer.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
		lowerer.checkParamDefaults(&paramDefaults[i])
	}
	// Every constant that was not needed by a type is worked out here, and
	// each top-level `assert` checked, to be run once the program is.
	for i in declarationOrder {
		lowerer.enter(files[i].0, files[i].1, imports[i].clone())
		lowerer.checkConsts()
		lowerer.checkAsserts()
	}

	// Bodies last. Every signature is known by now, so no body waits for
	// another. They are split by the size of what was written, each range
	// checked by a worker of its own where there is more than one.
	var work: Vec<(i64, BodyWork)> = Vec()
	var weights: Vec<i64> = Vec()
	for i in 0..fns.len() {
		for one in fns[i] {
			if lowerer.withheld.contains(&one.id) then continue
			work.push((i, one.clone()))
			weights.push((one.span.hi - one.span.lo) as i64)
		}
	}
	val ranges = split(&weights.items(), threads)
	if ranges.len() == 1 {
		lowerer.checkBodies(
			&work.items(),
			&files.items(),
			&imports.items(),
			&lambdas.items(),
			&envs.items(),
			&generators.items(),
		)
	} else {
		val mark = lowerer.program.types.mark()
		// What each worker starts from: the declarations as they are now, and
		// how far the checker has come, taken before the threads begin, so
		// that the workers borrow these and not the lowerer, which takes back
		// what they checked.
		val declared = lowerer.program.clone()
		val scopes = lowerer.modules.clone()
		val phase = lowerer.phase.clone()
		val workers = future::map(
			&ranges.items(),
			(range) => {
				// A lowerer that checks bodies on another thread, from a copy of the
				// declarations, interning types of its own, which `intoChecked`
				// hands back. It checks a constraint where it is written rather than
				// putting it off, the implementations being all declared, and what
				// it records is its own, joining the lowerer's afterwards.
				var worker = Lowerer::new(files[0].1, &interner, declared.clone(), scopes.clone())
				worker.phase = phase.clone()
				worker.program.names.clear()
				worker.program.implicitFills.clear()
				worker.checkBodies(
					&work[range.0..range.1],
					&files.items(),
					&imports.items(),
					&lambdas.items(),
					&envs.items(),
					&generators.items(),
				)
				return worker
			},
		)
		// The types each worker added, numbered in order, as one lowerer would
		// have numbered them. There are few, so this is quick.
		var taken: Vec<Taken> = Vec()
		var at = 0
		for worker in move workers {
			val map = lowerer.program.types.absorb(&worker.program.types, &mark)
			taken.push(Taken(
				worker: .Some(worker),
				map: map,
				start: ranges[at].0,
				end: ranges[at].1,
				checked: .None,
			))
			at += 1
		}
		// Renumbering the bodies, and freeing each worker's copy of the
		// declarations, is not: that happens on threads again.
		future::each(&var taken, (piece) => {
			var done = match piece.worker.take() {
				.Some(worker) => worker
				.None => return
			}
			piece.checked = .Some(done.intoChecked(&work[piece.start..piece.end], &piece.map))
		})
		for piece in move taken {
			if move piece.checked is .Some(checked) then lowerer.takeChecked(checked)
		}
	}
	// A projection that forwards to another lends what that one lends, which
	// is known only now that every body is checked.
	lowerer.resolveForwarded()
	// The code of the closures made from named functions.
	lowerer.makeFnClosures()
	// A generator that holds itself would be endlessly large.
	lowerer.checkGeneratorCycles()
	// An `@inline` function that reaches itself could never be spliced.
	lowerer.checkInlineCycles()
	// With every body checked, each call to a C function that takes more
	// than it declares is pointed at a declaration of what it passes.
	resolveVariadicCalls(&var lowerer.program)
	// Later phases share the types read-only, so the field types of every
	// instance are interned now. A program with errors goes no further, and
	// its types may be the endless ones reported.
	var errors = false
	for d in lowerer.diagnostics {
		if d.isError() then errors = true
	}
	if !errors then lowerer.completeTypes(0)
	return Lowered(program: lowerer.program, diagnostics: lowerer.diagnostics)
}

/// What a worker did, taken back in the order of the ranges: the worker,
/// until its bodies are taken out of it; where its types are in the
/// lowerer's; the range it checked; and what it checked, renumbered.
view struct Taken {
	worker: Option<Lowerer>
	map: TyMap
	start: i64
	end: i64
	checked: Option<CheckedBodies>
}

/// The bodies one worker checked, with what their projections lend, and
/// what it reported.
struct CheckedBodies {
	bodies: Vec<(FnId, Option<Body>, Option<Lent>)>
	/// The functions of the lambdas this worker checked: their signatures are
	/// known only once their bodies are.
	lambdas: Vec<(FnId, FnDef)>
	/// What each closure it checked captured.
	envStructs: Vec<(StructId, StructDef)>
	/// The generators it checked: each one's `next`, its struct, and what its
	/// implementation of `Iterator` yields and when it holds.
	generators: Vec<GeneratorChecked>
	/// The names it read that left no expression.
	names: Vec<(Span, Named)>
	/// The implicits its calls filled.
	implicitFills: Vec<(u32, String)>
	diagnostics: Vec<Diagnostic>
}

/// A generator a worker checked: its `next`, its struct, and the index of its
/// implementation of `Iterator` with what that yields and when it holds.
struct GeneratorChecked {
	next: FnId
	def: FnDef
	id: StructId
	strukt: StructDef
	implementation: Option<(i64, TyList, Vec<GenericParamDef>)>
}

/// A body to check: the expression, the function it belongs to, and the span
/// of what was written.
@derive(Clone)
struct BodyWork {
	body: ast::ExprId
	id: FnId
	span: Span
}

/// A method being declared: how it takes its receiver, the span of the word
/// that says so, the type it belongs to, and that type's parameters as this
/// declaration names them.
@derive(Clone)
struct Member {
	receiver: ast::Receiver
	keyword: Span
	owner: MemberOwner
	typeParams: Vec<GenericParamDef>
	/// Written in an `extend` of an interface that takes types: `From<i64>`
	/// and `From<Feet>` both declare `from`, and which is meant is decided by
	/// what is passed.
	overloaded: bool
	/// The writing half of a `lend fn`, whose `&T` result it lends as
	/// `&var T`.
	lent: bool
}

/// What a method belongs to: a type, or an interface, whose methods are
/// checked with `Self` as their type parameter.
@derive(Eq, Clone)
enum MemberOwner {
	Type(def: TypeDef)
	Interface(id: InterfaceId)
}

/// What an assignment target ultimately writes to.
@derive(Eq, Clone)
enum PlaceRoot {
	Local(local: LocalId)
	/// Behind a `&` parameter, which only reads.
	ThroughRef
	/// Through a `ptr<T>`: C's memory, which Wip writes whatever the pointer
	/// was declared.
	ThroughPointer
	/// Behind a `&var` parameter, which writes the caller's variable.
	ThroughVarRef
	/// In a constant table, which nothing writes.
	Table(id: ConstId)
	NotAPlace
}

/// A constraint check that waits for the implementations: the type given,
/// what it must implement, the parameter's name and where it was declared,
/// and where the type was written.
@derive(Clone)
struct PendingConstraint {
	ty: Ty
	constraint: Constraint
	written: Symbol
	declared: Span
	span: Span
	/// The type parameters in scope where it was written, which a type that
	/// mentions one is checked with.
	params: Vec<GenericParamDef>
}

/// Why a place must be writable.
@derive(Eq, Clone)
enum Writing {
	/// `place = value`.
	Assign
	/// `&var place`.
	Borrow
}

view struct Lowerer {
	ast: &ast::Ast
	interner: &Interner
	program: Program
	diagnostics: Vec<Diagnostic>
	/// Every module, in the order the driver found them; 0 is the root.
	modules: Vec<ModuleScope>
	/// The module whose file is being lowered.
	current: i64
	/// The scope the current file's names are declared in and looked for
	/// in first: its module's, or a test file's own.
	names: i64
	/// What the current file's imports bind: names for modules, and for items
	/// of other modules. Imports are file-scoped, as they are in Go and Odin.
	imports: FileImports
	/// The body being checked, with everything that belongs to it.
	state: BodyState
	/// How far the checker has come, which says what it can know yet.
	phase: Phase
	/// The bodies being checked around it, outermost first: a lambda's body
	/// is checked in the middle of the body that writes it, and a name it
	/// does not declare is looked for in these.
	outer: Vec<BodyState>
	/// Where each alias is written, by its module and name.
	aliasSources: Map<(i64, Symbol), AliasSource>
	/// The aliases being resolved, innermost last: one asked for again names
	/// itself.
	aliasStack: Vec<(i64, Symbol)>
	/// Set where a type leaves out an argument whose default is not read yet,
	/// while the defaults are read.
	defaultWaits: bool
	/// The types whose field defaults are not checked yet. One is taken out
	/// as its defaults are checked, so a default that needs its own type's
	/// finds none.
	defaultSources: Map<TypeDef, DefaultSource>
	/// The constraint checks that are waiting: the type given, what it must
	/// implement, the parameter's name and where it was declared, and where
	/// the type was written.
	pendingConstraints: Vec<PendingConstraint>
	/// The function of each lambda of the current file, and the struct its
	/// captures go in.
	lambdas: Map<ast::ExprId, FnId>
	lambdaEnvs: Map<FnId, StructId>
	/// The struct of each loop of the current file that is a generator.
	generators: Map<ast::ExprId, StructId>
	/// Whether what is being lowered is what `@derive` wrote. It is placed at
	/// the annotation, so it names nothing for an editor.
	derived: bool
	/// The parameters with a default, as `declareFn` finds them: checked once
	/// every function is declared.
	paramDefaults: Vec<(FnId, i64, ast::ExprId)>
	/// The bodies `@derive` wrote for a type with a field that keeps it from
	/// applying, which is reported where the field is written: they are not
	/// checked, and say nothing more.
	withheld: Set<FnId>
	/// The type each `@derive` argument was written on, which what it wrote
	/// is for.
	deriveOwners: Map<Span, TypeDef>
	/// Where each constant was written, which constant it is being worked
	/// out, and which have been worked out already.
	constSources: Map<ConstId, ConstSource>
	constStack: Vec<ConstId>
	constsDone: Set<ConstId>
	/// The constants that say `@define`; the build's defines; and which
	/// define sets each constant a build sets.
	definable: Vec<ConstId>
	defineList: Vec<Define>
	defines: Map<ConstId, i64>
	/// Whether a top-level `assert` is being checked, where a file may be
	/// embedded as in a constant.
	checkingAssert: bool
	/// The files embedded so far, each kept once: by where it is and whether
	/// it is text.
	embedded: Map<(String, bool), ConstId>
	/// The type parameters of the item being lowered.
	typeParams: Vec<GenericParamDef>
	/// The type whose method is being lowered, which `Self` names.
	selfTy: Option<Ty>
	/// The module whose `pub` items every file sees without an import.
	prelude: Option<i64>
	pendingCopy: Vec<(Ty, Symbol, Span)>
}

/// Everything about one body being checked. A lambda's body is checked in the
/// middle of the body around it, so the whole of this is put aside and taken
/// up again as one value: a field that belonged to the body and was left
/// behind would be a body checked against another one's locals.
struct BodyState {
	body: Body = Body()
	/// The byte literals, `b'x'`: a `u8`, compared with a `u8` alone, which
	/// a constant of another type is not.
	byteLiterals: Set<ExprId> = Set()
	/// Expressions checked ahead of where they are written, for what their
	/// type says of the parts beside them, with what checking them answered:
	/// the part of an array's tuples that decides a position's type. Taken
	/// out where the expression is reached in order, so that nothing is
	/// checked twice.
	early: Map<ast::ExprId, ExprId> = Map()
	/// The names in scope, innermost last.
	scopes: Vec<Map<Symbol, LocalId>> = Vec()
	/// The places an arm or an `is` test around the code being checked
	/// matched as a variant, innermost last: where a variant's literal may
	/// take the fields it does not name from one, `.V(x: 1, ..place)`.
	matched: Vec<MatchedPlace> = Vec()
	/// The result type, and where it was written.
	ret: Ty = UNIT
	retSpan: Option<Span> = .None
	/// Checking a constant's value, where an array written for a slice,
	/// outside any block, is kept with the constant.
	constant: bool = false
	/// The keywords of the `defer`s being checked, innermost last.
	defers: Vec<(Span, i64)> = Vec()
	/// The loops around the statement being lowered, innermost last: the name
	/// each was given, if any, and whether it has a `break`. A `defer`
	/// records how many there were, since a jump may not leave it.
	loops: Vec<(Option<Symbol>, bool)> = Vec()
	/// While a projection is checked: how often its body lends, and the
	/// parameter the yielded place belongs to.
	lends: u32 = 0
	lentParam: Option<u32> = .None
	/// A `lend` in the projection lends a constant table.
	lentTable: bool = false
	/// Checking the writing half of a `lend fn`.
	lentHalf: bool = false
	/// While a lambda's body is checked: what it has captured so far, and how
	/// a closure holds it — nothing for a plain function value, which may
	/// capture nothing.
	captures: Vec<Capture> = Vec()
	captureKind: Option<CaptureKind> = .None
	/// The lists being built, innermost last, which `yield` hands its value
	/// to.
	lists: Vec<ListBuild> = Vec()
	/// While a generator's body is checked: what it yields.
	generator: Option<GeneratorBuild> = .None
	/// Arguments written `name = value` where `name: value` was meant,
	/// reported, and checked as their values.
	namedByEquals: Set<ast::ExprId> = Set()
	/// An index handed to a type's `at` as its argument: an integer of any
	/// type there, as anywhere a position is.
	indexOperands: Set<ast::ExprId> = Set()
	/// Calls of generic defaults waiting for the type arguments of the
	/// literal or the call that uses them.
	unsettledDefaults: Vec<ExprId> = Vec()
	/// The lambda about to be checked is a `val`'s whole value, which may
	/// keep what it captures by `&` for as long as the `val` is used.
	keepingClosure: bool = false
	/// The bindings of plain data that are aliases while the body is lowered,
	/// and copies after it where nothing writes through them.
	settling: Vec<LocalId> = Vec()
	/// How each element of a tuple matched in place binds: set while an arm's
	/// pattern is checked, and taken by the tuple pattern at its top.
	placeBinds: Option<Vec<Binds>> = .None
	/// The `|`s being checked, innermost last: what each alternative binds,
	/// so that the next binds the same locals.
	alternatives: Vec<Alternatives> = Vec()
	/// How many `|`s that bind the body has numbered.
	bindingAlternatives: u32 = 0
	/// The `&place`s that are a `val`'s or a `var`'s whole value, by their
	/// operands: the value itself, or what a branch of an `if` or a `match`
	/// that is the whole value ends in. Each gives the variable its type.
	localReferences: Vec<ast::ExprId> = Vec()
	/// A lambda whose result nothing expected, and no `return` has said yet:
	/// the first `return value` says it.
	inferringRet: bool = false
	/// What a call is wanted for, by the call, while what it is the receiver
	/// or the operand of is checked: taken by the call when it is reached.
	wanted: Map<ast::ExprId, Wanted> = Map()
	/// The `?`s met while `inferringRet`, which wait for the result to be
	/// said to be checked against it.
	pendingTries: Vec<PendingTry> = Vec()
	/// Whether the body is a lambda's, which a message names as one.
	lambda: bool = false
	/// The locals declared with a value that leaves type arguments
	/// undecided, waiting for the first place that names them.
	pendingLocals: Map<LocalId, PendingLocal> = Map()
	/// The number literals whose first use said nothing of their type, and
	/// kept their own, by where that use was: a later use their own does
	/// not fit says so.
	keptOwn: Map<LocalId, KeptOwn> = Map()
	/// What the `move`s are written on where a `match`, an `is`, a `for` or
	/// a `val` pattern takes the value apart, which the place alone would be
	/// looked into: no `move` the checker would infer.
	taking: Set<ast::ExprId> = Set()
	/// The function whose body is being checked; nothing for a lambda's,
	/// a default's or a constant's.
	function: Option<FnId> = .None
	/// The fields whose `.` began a line under a block's last statement,
	/// reported as the variant they were meant to be (E0126): each is
	/// checked as what it was put after, so nothing else is said of it.
	variantTails: Set<ast::ExprId> = Set()
	/// The type arguments being checked are those of a call of the
	/// prelude's `copies`, whose refusal names the walk that lends.
	copiesCalled: bool = false
}

extend Lowerer {
	static fn new(
		file: &ast::Ast,
		interner: &Interner,
		program: Program,
		modules: Vec<ModuleScope>,
	): Lowerer = {
		var prelude: Option<i64> = .None
		for (i, module) in modules.forwards().enumerate() {
			if prelude.isNone() && module.path == PRELUDE then prelude = .Some(i)
		}
		return Lowerer(
			ast: &file,
			interner: &interner,
			program: program,
			diagnostics: Vec(),
			modules: modules,
			current: 0,
			names: 0,
			imports: FileImports(),
			state: BodyState(),
			phase: .Declaring,
			outer: Vec(),
			aliasSources: Map(),
			aliasStack: Vec(),
			defaultWaits: false,
			defaultSources: Map(),
			pendingConstraints: Vec(),
			lambdas: Map(),
			lambdaEnvs: Map(),
			generators: Map(),
			derived: false,
			paramDefaults: Vec(),
			withheld: Set(),
			deriveOwners: Map(),
			constSources: Map(),
			constStack: Vec(),
			constsDone: Set(),
			definable: Vec(),
			defineList: Vec(),
			defines: Map(),
			checkingAssert: false,
			embedded: Map(),
			typeParams: Vec(),
			selfTy: .None,
			prelude: prelude,
			pendingCopy: Vec(),
		)
	}

	// ---- helpers ----

	fn text(sym: Symbol): str from self.interner = self.interner.resolve(sym)

	fn kind(ty: Ty): TyKind = self.program.types.kind(ty)

	var fn intern(kind: TyKind): Ty = self.program.types.intern(kind)

	/// The type in backticks, for messages.
	fn tyName(ty: Ty): String = "`\(self.program.tyName(ty, self.interner))`"

	var fn report(diagnostic: Diagnostic) = self.diagnostics.push(diagnostic)

	/// The scopes a bare name in the current file is looked for in, nearest
	/// first: a test file's own, then its module's tests' shared; and its
	/// module's, which a module's own file looks in alone.
	fn here(): Vec<i64> = {
		var scopes: Vec<i64> = Vec()
		var at: Option<i64> = .Some(self.names)
		while at is .Some(scope) {
			scopes.push(scope)
			at = self.modules[scope].inside
		}
		return scopes
	}

	/// The scope a name the current file declares goes in: a module's own
	/// file's, its module's; a test file's, its own, or, where it is `pub`,
	/// the one its module's test files share.
	fn declaring(isPub: bool): i64 =
		if self.names == self.current then self.current
		else if isPub then self.modules[self.names].inside.unwrapOr(self.current)
		else self.names

	/// The module a scope is of: itself, for a module's own.
	fn moduleOf(scope: i64): i64 = {
		var at = scope
		while self.modules[at].inside is .Some(outer) {
			at = outer
		}
		return at
	}

	/// Where the current file finds `sym` written with no path: the nearest
	/// of its scopes that declares it — a test file's own, its module's
	/// tests' shared — or else its module's, which declares it or not.
	fn holding(sym: Symbol): i64 = {
		for scope in self.here() {
			val names = &self.modules[scope]
			if names.types.contains(&sym) ||
				names.aliases.contains(&sym) ||
				names.fns.contains(&sym) ||
				names.consts.contains(&sym) ||
				names.globals.contains(&sym) ||
				names.opaques.contains(&sym) ||
				names.interfaces.contains(&sym) {
				return scope
			}
		}
		return self.current
	}

	/// Whether the current file is a test file.
	fn inTest(): bool = self.names != self.current

	/// The type the current file sees by `sym`, and where it was declared.
	fn typeHere(sym: Symbol): Option<(TypeDef, Span)> = {
		for scope in self.here() {
			if self.modules[scope].types.get(&sym) is .Some(found) then return .Some(found.clone())
		}
		return .None
	}

	/// The scope holding the type alias the current file sees by `sym`.
	fn aliasScope(sym: Symbol): Option<i64> = {
		for scope in self.here() {
			if self.modules[scope].aliases.contains(&sym) then return .Some(scope)
		}
		return .None
	}

	/// The type alias the current file sees by `sym`.
	fn aliasHere(sym: Symbol): Option<AliasDef> = {
		val scope = self.aliasScope(sym)?
		return .Some(self.modules[scope].aliases.get(&sym)?.clone())
	}

	fn interfaceHere(sym: Symbol): Option<(InterfaceId, Span)> = {
		for scope in self.here() {
			if self.modules[scope].interfaces.get(&sym) is .Some(found) then
				return .Some(found.clone())
		}
		return .None
	}

	fn fnHere(sym: Symbol): Option<FnId> = {
		for scope in self.here() {
			if self.modules[scope].fns.get(&sym) is .Some(found) then return .Some(found.clone())
		}
		return .None
	}

	fn opaqueHere(sym: Symbol): Option<OpaqueId> = {
		for scope in self.here() {
			if self.modules[scope].opaques.get(&sym) is .Some(found) then
				return .Some(found.clone())
		}
		return .None
	}

	fn constHere(sym: Symbol): Option<ConstId> = {
		for scope in self.here() {
			if self.modules[scope].consts.get(&sym) is .Some(found) then return .Some(found.clone())
		}
		return .None
	}

	fn globalHere(sym: Symbol): Option<GlobalId> = {
		for scope in self.here() {
			if self.modules[scope].globals.get(&sym) is .Some(found) then
				return .Some(found.clone())
		}
		return .None
	}

	/// Whether the module being lowered is the standard library's, which
	/// alone may name what holds memory that holds nothing, or turn an `own`
	/// into an address.
	fn inStd(): bool = {
		val path = &self.modules[self.current].path
		return path == "std" || path.startsWith("std::")
	}

	/// Moves to a file of `module`, with the imports that file wrote.
	var fn enter(module: i64, file: &ast::Ast, imports: FileImports) keeps file = {
		self.current = module
		self.names = imports.names.unwrapOr(module)
		self.ast = &file
		self.imports = imports
	}

	/// Moves to the `i`th file, with its imports, lambdas and generators.
	/// Checks the bodies of `work`, each in its file.
	var fn checkBodies(
		work: &[(i64, BodyWork)],
		files: &[(i64, &ast::Ast)],
		imports: &[FileImports],
		lambdas: &[Map<ast::ExprId, FnId>],
		envs: &[Map<FnId, StructId>],
		generators: &[Map<ast::ExprId, StructId>],
	) keeps files = {
		var file: Option<i64> = .None
		for (i, one) in work {
			if file != .Some(i) {
				self.enterFile(i, &files, &imports, &lambdas, &envs, &generators)
				file = .Some(i)
			}
			self.checkFn(one.body, one.id)
		}
	}

	/// What a worker checked: the bodies of `fns`, with its types renumbered
	/// through `map`, and its diagnostics.
	var fn intoChecked(fns: &[(i64, BodyWork)], map: &TyMap): CheckedBodies = {
		val renumber = !map.isIdentity()
		var bodies: Vec<(FnId, Option<Body>, Option<Lent>)> = Vec()
		for (_, one) in fns {
			var body = self.program.fns[one.id].body.take()
			if renumber && body is .Some(checked) then
				checked.mapTypes((ty) => map.get(ty), (list) => map.getList(list))
			bodies.push((one.id, body, self.program.fns[one.id].projects.clone()))
		}
		// A closure's environment is a struct the worker filled in: what it
		// captured, or the type parameters of the generic function it was
		// written in, which a worker gives it too.
		var envStructs: Vec<(StructId, StructDef)> = Vec()
		for id in self.program.structs.ids() {
			val def = &self.program.structs[id]
			if !def.isEnv || (def.fields.isEmpty() && def.generics.isEmpty()) then continue
			var copy = def.clone()
			if renumber {
				for field in copy.fields {
					field.ty = map.get(field.ty)
				}
			}
			envStructs.push((id, copy))
		}
		// A lambda's function was declared before the bodies were checked, and
		// filled in by the worker that checked the body around it.
		var lambdas: Vec<(FnId, FnDef)> = Vec()
		for id in self.program.fns.ids() {
			val def = &self.program.fns[id]
			if !def.isLambda || def.body.isNone() then continue
			var copy = def.clone()
			if renumber {
				for param in copy.params {
					param.ty = map.get(param.ty)
				}
				copy.ret = map.get(copy.ret)
				if copy.body is .Some(body) then
					body.mapTypes((ty) => map.get(ty), (list) => map.getList(list))
			}
			lambdas.push((id, copy))
		}
		// A generator's `next`, struct and implementation were declared empty,
		// and filled in by the worker that checked its loop.
		var generators: Vec<GeneratorChecked> = Vec()
		for next in self.program.fns.ids() {
			val def = &self.program.fns[next]
			val .Some(id) = def.generator else continue
			if def.body.isNone() then continue
			var copy = def.clone()
			var strukt = self.program.structs[id].clone()
			val owner = TypeDef::Struct(id)
			var implementation: Option<(i64, TyList, Vec<GenericParamDef>)> = .None
			for (index, i) in self.program.impls.forwards().enumerate() {
				if implementation.isNone() && i.ty == owner then
					implementation = .Some(
						(
							index,
							if renumber then map.getList(i.args) else i.args,
							i.conditions.clone(),
						),
					)
			}
			if renumber {
				for param in copy.params {
					param.ty = map.get(param.ty)
				}
				copy.ret = map.get(copy.ret)
				if copy.body is .Some(body) then
					body.mapTypes((ty) => map.get(ty), (list) => map.getList(list))
				for field in strukt.fields {
					field.ty = map.get(field.ty)
				}
				if strukt.generator is .Some(generator) then
					generator.elem = map.get(generator.elem)
			}
			generators.push(GeneratorChecked(
				next: next,
				def: copy,
				id: id,
				strukt: strukt,
				implementation: implementation,
			))
		}
		var names: Vec<(Span, Named)> = Vec()
		for (span, named) in mem::replace(&var self.program.names, Vec()) {
			names.push(
				(
					span,
					match named {
						.Type(ty) if renumber => Named::Type(map.get(ty))
						other => move other
					},
				),
			)
		}
		return CheckedBodies(
			bodies: bodies,
			lambdas: lambdas,
			envStructs: envStructs,
			generators: generators,
			names: names,
			implicitFills: mem::replace(&var self.program.implicitFills, Vec()),
			diagnostics: mem::replace(&var self.diagnostics, Vec()),
		)
	}

	/// What a worker checked, put in its place.
	var fn takeChecked(checked: CheckedBodies) = {
		for (id, body, projects) in move checked.bodies {
			self.program.fns[id].body = body
			self.program.fns[id].projects = move projects
		}
		for (id, def) in move checked.lambdas {
			self.program.fns[id] = def
		}
		for (id, def) in move checked.envStructs {
			self.program.structs[id] = def
		}
		for generator in move checked.generators {
			self.program.fns[generator.next] = generator.def
			self.program.structs[generator.id] = generator.strukt
			if generator.implementation is .Some((index, args, conditions)) {
				self.program.impls[index].args = args
				self.program.impls[index].conditions = conditions.clone()
			}
		}
		self.program.names.append(checked.names)
		self.program.implicitFills.append(checked.implicitFills)
		self.diagnostics.append(checked.diagnostics)
	}

	var fn enterFile(
		i: i64,
		files: &[(i64, &ast::Ast)],
		imports: &[FileImports],
		lambdas: &[Map<ast::ExprId, FnId>],
		envs: &[Map<FnId, StructId>],
		generators: &[Map<ast::ExprId, StructId>],
	) keeps files = {
		self.enter(files[i].0, files[i].1, imports[i].clone())
		self.lambdas = lambdas[i].clone()
		self.lambdaEnvs = envs[i].clone()
		self.generators = generators[i].clone()
	}

	/// What the test files declare, once all of them have: a name of one
	/// test file's own that another's `pub` item has, which that file would
	/// see two of; and two tests of one module of the same name, wherever
	/// they are written, since a test is run and reported by its module and
	/// its name.
	var fn checkTestNames() = {
		var tests: Map<(u32, Symbol), Span> = Map()
		for id in self.program.fns.ids() {
			val def = &self.program.fns[id]
			if def.test.isNone() then continue
			val key = (def.module, def.name)
			val span = def.nameSpan
			match tests.get(&key) {
				.Some(first) => self.duplicate(ast::Name(sym: key.1, span: span), first.clone())
				.None => tests.put(key, span)
			}
		}
		for scope in 0..self.modules.len() {
			val .Some(outer) = self.modules[scope].inside else continue
			// A test file's own scope is inside the tests' shared one, which is
			// inside its module.
			if self.modules[outer].inside.isNone() then continue
			val mine = self.modules[scope].clone()
			val shared = &self.modules[outer]
			var clashes: Vec<(ast::Name, Span)> = Vec()
			for i in 0..mine.fns.len() {
				val sym = mine.fns.keyAt(i).clone()
				if shared.fns.get(&sym) is .Some(first) then
					clashes.push(
						(
							ast::Name(
								sym: sym,
								span: self.program.fns[mine.fns.valueAt(i).clone()].nameSpan,
							),
							self.program.fns[first].nameSpan,
						),
					)
			}
			for i in 0..mine.types.len() {
				val sym = mine.types.keyAt(i).clone()
				if shared.types.get(&sym) is .Some((_, first)) then
					clashes.push(
						(ast::Name(sym: sym, span: mine.types.valueAt(i).1), first.clone()),
					)
			}
			for i in 0..mine.consts.len() {
				val sym = mine.consts.keyAt(i).clone()
				if shared.consts.get(&sym) is .Some(first) then
					clashes.push(
						(
							ast::Name(
								sym: sym,
								span: self.program.consts[mine.consts.valueAt(i).clone()].span,
							),
							self.program.consts[first].span,
						),
					)
			}
			for (name, first) in clashes {
				self.duplicate(name, first)
			}
		}
	}

	var fn duplicate(name: ast::Name, first: Span) = {
		// Parameters written `_` are as many as are written, and none is
		// named.
		if name.sym == Symbol::ignored() then return
		self.report(
			Diagnostic::error(
				DUPLICATE_DEFINITION,
				"`\(self.text(name.sym))` is defined more than once",
				name.span,
				"defined again here",
			).withSecondary(first, "first defined here"),
		)
	}
}
