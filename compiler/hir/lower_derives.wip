// What `@derive` asks for, and what an enum whose variants carry nothing
// gets without asking: its numbering, and `Eq` and `Hash`.
//
// What `@derive` writes is code of the module's own, expanded before the
// module is checked; here what each implementation asks of the type's
// parameters is worked out from what its fields need, and a field that
// cannot have the interface is reported where it is written. `count`,
// `fromIndex`, `all`, `name` and `fromName` are declared here as methods of
// the type, with `FnDef::generated` saying which body the code generator is
// to write.

import syntax as ast
import syntax::{
	Code,
	Diagnostic,
	Edit,
	NEEDLESS_DERIVE,
	Receiver,
	NOT_CLONEABLE,
	NOT_COMPARABLE,
	NOT_DECODABLE,
	NOT_ENCODABLE,
	Span,
	Symbol
}

/// How a field that lacks what `@derive` asks of it is reported: the code,
/// what the field cannot do, the label, what `@derive` writes, and the rule.
view struct Lacking {
	code: Code
	lacks: str
	label: str
	writes: str
	note: str
}

/// A condition said of one of the type parameters in scope, as what a type
/// needs of them to implement an interface: `T: Clone`, as the parameter's
/// index, the interface, and the types it takes.
@derive(Eq, Clone)
struct Need {
	param: i64
	interfaceId: InterfaceId
	args: Vec<Ty>
}

extend Lowerer {
	/// Where `@derive` names this interface on a declaration, if it does.
	/// What it may name was checked when the type was collected; this only
	/// asks what is there.
	fn derives(written: &[ast::Annotation], wanted: Derived): Option<Span> = {
		for a in written {
			if self.text(a.name.sym) != "derive" then
				continue

			for arg in a.args do
				if arg.value is .Name(sym) && self.text(sym) == wanted.name() then
					return arg.span
		}
		return .None
	}

	/// Records which type each argument of `@derive` was written on, which
	/// what it wrote is for.
	var fn noteDerives(types: &[(Declared, TypeDef)]) = {
		for (item, def) in types {
			val annotations = item.annotationsOf()
			for a in annotations {
				if self.text(a.name.sym) != "derive" then
					continue

				for arg in a.args do
					self.deriveOwners.put(arg.span, def)
			}
			// What an enum of names is given without asking is placed at its
			// name.
			if item is .Item(.Enum(e)) && ast::namesOnly(&e) then
				self.deriveOwners.put(e.name.span, def)
		}
	}

	/// Warns of what a `@derive` names that `owner` has without it: `Eq` and
	/// `Hash` on an enum of names, and `Clone` on plain data, which is its
	/// own clone. One warning for each `@derive`, whose fix takes the names
	/// away, and the `@derive` where nothing else is left in it.
	var fn needlessDerives(annotations: &[ast::Annotation], owner: TypeDef, names: bool) = {
		// Plain data for every argument the type may take: a parameter that
		// may own memory is taken to.
		var plain = !self.owns(self.ownSelfTy(owner))
		for (_, ty, _) in self.fieldsOf(owner) do
			if self.hasError(ty) then
				plain = false

		if !names && !plain then
			return

		val typeName = self.typeName(owner)
		for annotation in annotations {
			if self.text(annotation.name.sym) != "derive" then
				continue

			var needless: Vec<(String, Span)> = Vec()
			var kept: Vec<String> = Vec()
			var compares = false
			var clones = false
			for arg in annotation.args {
				val .Name(sym) = arg.value else continue
				val text = String::of(self.text(sym))
				if names && text.toStr() is "Eq" | "Hash" {
					compares = true
					needless.push((text, arg.span))
				} else if plain && text == "Clone" {
					clones = true
					needless.push((text, arg.span))
				} else
					kept.push(text)
			}
			if needless.isEmpty() then
				continue

			val quoted: Vec<String> = [
				for (text, _) in needless do
					yield "`\(text)`"
			]
			val (fixed, edit) =
				if kept.isEmpty() then
					(String::of("remove `@derive`"), Edit::replace(annotation.removal, ""))
				else (
					"remove \(allOf(&quoted))",
					Edit::replace(annotation.parens.unwrap(), "(\(kept.join(", ")))"),
				)
			val message =
				if compares && clones then
					"`\(typeName)` compares, hashes and clones without being told"
				else if compares then
					String::of("an enum of names compares and hashes without being told")
				else "`\(typeName)` is plain data, its own clone without being told"
			var diagnostic = Diagnostic::warning(NEEDLESS_DERIVE, message, needless[0].1, "`\(needless[0].0)` says nothing here")
			for (text, span) in needless[1..] do
				diagnostic = diagnostic.withSecondary(span, "nor does `\(text)`")

			diagnostic = diagnostic.withFix(fixed, [edit])
			if compares then
				diagnostic = diagnostic.withNote(
					"an enum whose variants carry nothing implements `Eq` and `Hash` by which name it is",
				)

			if clones then
				diagnostic = diagnostic.withNote(
					"plain data owns no memory — no `own`, no `String`, no `Vec`, nothing with a `destroy` — and its clone is a copy, taken wherever `Clone` is asked for",
				)

			self.report(diagnostic)
		}
	}

	/// What each implementation `@derive` wrote asks of the type's
	/// parameters: what its fields need of them, worked down through their
	/// types' implementations until it is said of a parameter. A `Vec<T>`
	/// field asks `T: Clone` of a clone, a `Handle<T>` field nothing, and a
	/// parameter no field needs anything of is asked nothing. A type may hold
	/// itself, directly or through others, so every derived implementation
	/// starts asking nothing more than the type's own constraints, and asks
	/// more as its fields do, until none asks more: what is asked only grows,
	/// and there are finitely many parameters and interfaces to ask. The
	/// methods it wrote are then given the same conditions, which their
	/// bodies are checked with. A field that needs what cannot be said of a
	/// parameter is reported as the fields are checked, after this.
	var fn deriveConditions(types: &[Vec<(Declared, TypeDef)>]) = {
		var derivedImpls: Vec<(i64, TypeDef, Derived, InterfaceId)> = Vec()
		for declared in types {
			for (item, def) in declared {
				val annotations = item.annotationsOf()
				if annotations.isEmpty() then
					continue

				for wanted in Derived::all() {
					if self.derives(&annotations, wanted).isNone() then
						continue

					val known = wanted.known()
					val .Some(interfaceId) = self.program.preludeItems.interfaceOf(known) else {
						continue
					}
					// Nothing was written where the implementation was refused.
					val .Some(at) = self.derivedImplAt(def, interfaceId) else continue
					derivedImpls.push((at, def, wanted, interfaceId))
				}
			}
		}
		var growing = true
		while growing {
			growing = false
			for (at, def, wanted, interfaceId) in derivedImpls {
				self.typeParams = self.typeGenerics(def)
				for (name, ty, span) in self.fieldsOf(def) {
					val .Some(needs) = self.fieldNeeds(wanted, interfaceId, ty) else continue
					for need in needs {
						val param = need.param
						val constraint = Constraint(
							interfaceId: need.interfaceId,
							args: self.program.types.internList(&need.args),
						)
						if self.program.impls[at].conditions[param].interfaces.contains(
							&constraint,
						) {
							continue
						}
						self.program.impls[at].conditions[param].interfaces.push(constraint)
						self.program.derivedAsks.push(DerivedAsk(
							at: at,
							param: param,
							constraint: constraint,
							field: name,
							ty: ty,
							span: span,
						))
						growing = true
					}
				}
			}
		}
		self.typeParams.clear()
		// The methods are checked with what the implementation asks, and a
		// call that does not meet it is shown the field that asks it.
		for (at, _, _, _) in derivedImpls {
			val conditions = self.program.impls[at].conditions.clone()
			for m in self.program.impls[at].methods.clone() {
				if !self.program.derived.contains(&m) then
					continue

				for param in 0..conditions.len() {
					if param >= self.program.fns[m].generics.len() then
						break

					self.program.fns[m].generics[param].interfaces = conditions[param].interfaces.clone()
					if self.firstAsk(at, param) is .Some(span) then
						self.program.fns[m].generics[param].span = span
				}
			}
		}
	}

	/// Where the first field to ask anything of the parameter is written, of
	/// what `@derive` wrote as the implementation at `at`.
	fn firstAsk(at: i64, param: i64): Option<Span> = {
		for ask in self.program.derivedAsks do
			if ask.at == at && ask.param == param then
				return ask.span

		return .None
	}

	/// The field that asks a parameter for `interfaceId`, where the
	/// parameter is declared at `declared` and is one of the type's in what
	/// `@derive` wrote: its methods' parameters are placed at the first
	/// field that asks anything of them.
	fn askingAt(declared: Span, interfaceId: InterfaceId): Option<&DerivedAsk> = {
		for first in self.program.derivedAsks {
			if first.span != declared then
				continue

			for ask in self.program.derivedAsks {
				if ask.at == first.at &&
					ask.param == first.param &&
					ask.constraint.interfaceId == interfaceId {
					return &ask
				}
			}
		}
		return .None
	}

	/// The field of `outer` that asks `inside`, one of its arguments, for
	/// `condition`, where `outer`'s implementation of `wanted` is one
	/// `@derive` wrote: `` `first: T` ``.
	fn askedBy(outer: Ty, wanted: Constraint, inside: Ty, condition: Constraint): Option<String> = {
		val owner = self.implOwner(outer)?
		val args = self.ownerArgs(outer)
		for (at, i) in self.program.impls.forwards().enumerate() {
			if i.interfaceId != wanted.interfaceId ||
				i.ty != owner ||
				!argsMatch(&self.program.types, i.args, &args, wanted.args) {
				continue
			}
			for ask in self.program.derivedAsks {
				if ask.at == at &&
					ask.param < args.len() &&
					args[ask.param] == inside &&
					ask.constraint.interfaceId == condition.interfaceId {
					return self.askedField(&ask)
				}
			}
			return .None
		}
		return .None
	}

	/// A field that asks something, as it is declared: `` `first: T` ``.
	fn askedField(
		ask: &DerivedAsk,
	): String = "`\(self.text(ask.field)): \(self.program.tyName(ask.ty, self.interner))`"

	/// What one field needs of the type's parameters for what `@derive`
	/// writes of `wanted`; `None` where it cannot have it, which the field
	/// is reported for. An `own<T>` has what the prelude implements for it,
	/// as what it holds has. What a reference points at may have it, which
	/// a call looks through to; the field itself does not. A clone is asked
	/// of the field's own type, whose `clone` a `&T` has; so is decoding,
	/// which a reference cannot be read into.
	var fn fieldNeeds(wanted: Derived, interfaceId: InterfaceId, ty: Ty): Option<Vec<Need>> = {
		val kind = self.kind(ty)
		val none: Vec<Need> = Vec()
		val nothing: [Ty; 0] = []
		// Whether it is plain data is read from its fields' types.
		completeType(&var self.program, ty)
		if self.isPoisoned(ty) then
			return none

		// Two pointers compare by where they point.
		if wanted == .Eq && kind is .Ptr(..) then
			return none

		return match wanted {
			// A format is given an `own<T>` as the prelude's implementation for
			// it says, and a reference as what it refers to.
			.Encode => match self.conditionsFor(ty, interfaceId, &nothing) {
				.Some(asked) => asked
				.None => match kind {
					.Ref(inner, ..) => self.conditionsFor(inner, interfaceId, &nothing)
					_ => .None
				}
			}
			.Decode | .Clone => self.conditionsFor(ty, interfaceId, &nothing)
			_ => if kind is .Ref(..) then .None else self.conditionsFor(ty, interfaceId, &nothing)
		}
	}

	/// The types that asked for `@derive`, once every implementation is
	/// declared: only then can a field's type be asked whether it compares.
	var fn declareEquality(types: &[(Declared, TypeDef)]) = {
		for (item, def) in types {
			val annotations = item.annotationsOf()
			if annotations.isEmpty() then
				continue

			val eq = self.derives(&annotations, .Eq)
			val ord = self.derives(&annotations, .Ord)
			val hash = self.derives(&annotations, .Hash)
			val text = self.derives(&annotations, .Text)
			val clone = self.derives(&annotations, .Clone)
			val encode = self.derives(&annotations, .Encode)
			val decode = self.derives(&annotations, .Decode)
			if eq.isNone() &&
				ord.isNone() &&
				hash.isNone() &&
				text.isNone() &&
				clone.isNone() &&
				encode.isNone() &&
				decode.isNone() {
				continue
			}
			self.typeParams = self.typeGenerics(def)
			val names = item is .Item(.Enum(e)) && ast::namesOnly(&e)
			self.needlessDerives(&annotations, def, names)
			// An enum of names has the equality the compiler writes without
			// being asked, unless the program writes its own.
			val fieldsEqual =
				eq.isSome() ||
				(self.program.preludeItems.interfaceOf(.Eq) is .Some(eqId) &&
					self.derivedImpl(def, eqId).isSome())
			if eq is .Some(at) then
				self.checkDerivedFields(def, at, .Eq)

			if ord is .Some(at) then
				self.checkOrderable(def, at, fieldsEqual)

			if hash is .Some(at) then
				self.checkHashable(def, at, fieldsEqual)

			if text is .Some(at) then
				self.checkDerivedFields(def, at, .Text)

			if clone is .Some(at) then
				self.checkDerivedFields(def, at, .Clone)

			if encode is .Some(at) then
				self.checkDerivedFields(def, at, .Encode)

			if decode is .Some(at) then
				self.checkDerivedFields(def, at, .Decode)
		}
		self.typeParams.clear()
	}

	/// What `@derive` wrote for `owner` — an `equals`, a `compare` or a
	/// `clone`, as code of the module's own — asks each field for the
	/// interface. This says which field keeps it from applying, where the
	/// field is written rather than at the annotation the code is placed at,
	/// and then leaves the code unchecked. A field whose need can be said of
	/// the type's parameters has it, as its implementation's conditions.
	var fn checkDerivedFields(owner: TypeDef, at: Span, wanted: Derived) = {
		val .Some(interfaceId) = self.program.preludeItems.interfaceOf(wanted.known()) else return
		// Nothing was written where the implementation was refused, as a
		// second one of the type's, and reported.
		val .Some(written) = self.derivedImpl(owner, interfaceId) else return
		var applies = true
		for (name, ty, span) in self.fieldsOf(owner) {
			if self.fieldNeeds(wanted, interfaceId, ty).isSome() then
				continue

			applies = false
			val diagnostic = self.fieldLacks(wanted, interfaceId, name, ty, span, at)
			self.report(diagnostic)
		}
		if !applies {
			for id in written do
				self.withheld.add(id)
		}
	}

	/// The report of a field whose type lacks what `@derive` asks of it.
	fn fieldLacks(
		wanted: Derived,
		interfaceId: InterfaceId,
		name: Symbol,
		ty: Ty,
		span: Span,
		at: Span,
	): Diagnostic = {
		val field = String::of(self.text(name))
		val typeName = self.tyName(ty)
		val words: Lacking = match wanted {
			.Eq => Lacking(
				code: NOT_COMPARABLE,
				lacks: "cannot be compared",
				label: "not a comparable field",
				writes: "`@derive(Eq)` writes the comparison field by field",
				note: "a field is comparable when it is a number, a `bool`, a `str`, a `cstring`, a `ptr<T>`, an array of those, or a type that implements `Eq`",
			)
			.Ord => Lacking(
				code: NOT_COMPARABLE,
				lacks: "has no order",
				label: "not an ordered field",
				writes: "`@derive(Ord)` writes the comparison field by field",
				note: "a field is ordered when it is a number, a `bool`, a `str`, an array of those, or a type that implements `Ord`",
			)
			.Text => Lacking(
				code: NOT_COMPARABLE,
				lacks: "cannot be written",
				label: "not a writable field",
				writes: "`@derive(Text)` writes the value field by field",
				note: "a field is writable when it is a number, a `bool`, a `str`, a `cstring`, an array of those, or a type that implements `Text`",
			)
			.Hash => Lacking(
				code: NOT_COMPARABLE,
				lacks: "is not hashed",
				label: "not a hashable field",
				writes: "`@derive(Hash)` writes the hashing part by part",
				note: "a field is hashed when it is an integer, a `bool`, a `str`, a `cstring`, an array of those, or a type that implements `Hash`; the floats are left out, since `0.0` and `-0.0` are equal and their bytes are not",
			)
			.Clone => Lacking(
				code: NOT_CLONEABLE,
				lacks: "cannot be cloned",
				label: "not a field that clones",
				writes: "`@derive(Clone)` writes the clone field by field",
				note: "a field clones when its type implements `Clone`: plain data, which owns no memory, is its own clone, and so are a `String`, a `Vec`, an `Option` or a tuple of what clones, and a type that asks for `@derive(Clone)` or writes `extend …: Clone`",
			)
			.Encode => Lacking(
				code: NOT_ENCODABLE,
				lacks: "does not encode",
				label: "not a field that encodes",
				writes: "`@derive(Encode)` writes the value field by field",
				note: "a field encodes when its type implements `Encode`: the numbers, `bool`, `char`, the text types, a `Vec`, a `Map`, a `Set`, an `Option`, an `own` or a tuple of what encodes, and a type that asks for `@derive(Encode)` or writes `extend …: Encode`",
			)
			.Decode => Lacking(
				code: NOT_DECODABLE,
				lacks: "does not decode",
				label: "not a field that decodes",
				writes: "`@derive(Decode)` reads the value field by field",
				note: "a field decodes when its type implements `Decode`, as the types that encode do but a reference and a view, whose borrowed value would have nowhere to come from",
			)
		}
		var diagnostic = Diagnostic::error(
			words.code,
			"`\(field)` is \(typeName), which \(words.lacks)",
			span,
			words.label,
		).withSecondary(at, words.writes).withNote(words.note)
		val named = wanted.name()
		// A type that has it where its arguments do is told which does not:
		// `Vec<T>` compares where `T` does.
		val constraint = Constraint(interfaceId: interfaceId, args: .empty())
		val chain = self.unmetChain(ty, constraint)
		if !chain.isEmpty() {
			val arg = chain[chain.len() - 1].0
			val inside = self.tyName(arg)
			diagnostic = diagnostic.withHelp(self.unmetHelp(ty, constraint, &chain))
			if self.declaresFields(arg) && self.stdModuleOf(arg).isNone() then
				diagnostic = diagnostic.withHelp("write `@derive(\(named))` on \(inside) too, or an `extend` block that implements `\(named)` for it")
		} else if self.declaresFields(ty) then
			diagnostic = diagnostic.withHelp("write `@derive(\(named))` on \(typeName) too, or an `extend` block that implements `\(named)` for it")

		// A type an implementation decides is not one of the type's
		// parameters, so what it needs cannot be asked of them.
		val innermost = if chain.isEmpty() then ty else chain[chain.len() - 1].0
		if self.kind(innermost) is .Assoc(..) then
			diagnostic = diagnostic.withHelp("what `@derive` writes asks its conditions of the type's parameters, and \(self.tyName(innermost)) is decided by one; write the implementation by hand, or take it as a parameter of the type's own, which a condition can name")

		return diagnostic
	}

	/// Whether a type is a struct or an enum, which `@derive` may be written
	/// on.
	fn declaresFields(ty: Ty): bool = self.kind(ty) is .Struct(..) | .Enum(..)

	/// Every field of a struct, or of each variant of an enum, with its type
	/// and where it was written.
	fn fieldsOf(owner: TypeDef): Vec<(Symbol, Ty, Span)> = {
		var fields: Vec<(Symbol, Ty, Span)> = Vec()
		match owner {
			.Struct(id) => {
				for f in self.program.structs[id].fields do
					fields.push((f.name, f.ty, f.span))
			}
			.Enum(id) => {
				for v in self.program.enums[id].variants {
					for f in v.fields do
						fields.push((f.name, f.ty, f.span))
				}
			}
			.Builtin(_) => {}
		}
		return fields
	}

	/// Leaves what `@derive` wrote for `owner`'s implementation of
	/// `interfaceId` unchecked, where it has been refused and reported.
	var fn withholdDerived(owner: TypeDef, interfaceId: Option<InterfaceId>) = {
		val .Some(id) = interfaceId else return
		val .Some(written) = self.derivedImpl(owner, id) else return
		for m in written do
			self.withheld.add(m)
	}

	/// The methods of `owner`'s implementation of `interfaceId` where
	/// `@derive` wrote it: those it wrote first, then the interface's
	/// defaults the implementation has with them.
	fn derivedImpl(owner: TypeDef, interfaceId: InterfaceId): Option<Vec<FnId>> = {
		val derived = &self.program.derived
		val i = &self.program.impls[self.derivedImplAt(owner, interfaceId)?]
		var methods: Vec<FnId> = Vec()
		for m in i.methods do
			if derived.contains(&m) then
				methods.push(m)

		for m in i.methods do
			if !derived.contains(&m) then
				methods.push(m)

		return methods
	}

	/// Where among the program's implementations is `owner`'s of
	/// `interfaceId`, where `@derive` wrote it. An interface's default
	/// methods are the implementation's too, and nothing derived them, as
	/// `Text`'s: the implementation is the derived one where `@derive` wrote
	/// any of it.
	fn derivedImplAt(owner: TypeDef, interfaceId: InterfaceId): Option<i64> = {
		val derived = &self.program.derived
		for (at, i) in self.program.impls.forwards().enumerate() {
			if i.ty != owner || i.interfaceId != interfaceId then
				continue

			for m in i.methods do
				if derived.contains(&m) then
					return at
		}
		return .None
	}

	/// An enum whose variants carry nothing gets `count`, `fromIndex`, `all`,
	/// `name` and `fromName`, whose bodies the compiler writes. A program
	/// that declares a method of one of those names keeps its own.
	var fn declareEnumNumbers(types: &[(Declared, TypeDef)]) = {
		for (item, def) in types {
			val .Some(e) = item.enumDecl() else continue
			val .Enum(id) = def else continue
			var carries = false
			for v in self.program.enums[id].variants do
				if !v.fields.isEmpty() then
					carries = true

			if carries then
				continue

			self.typeParams = self.typeGenerics(def)
			val at = e.name.span
			if !self.enumDeclares(id, "count") {
				val none: Vec<(Symbol, Ty)> = Vec()
				self.generatedFn(def, Symbol::count(), .Static, none, I64, .VariantCount, at)
			}
			if !self.enumDeclares(id, "fromIndex") &&
				self.program.preludeItems.enumeration(.Option) is .Some(option) {
				val selfTy = self.ownSelfTy(def)
				val args = self.program.types.internList([selfTy])
				val ret = self.intern(.Enum(id: option, args: args))
				self.generatedFn(
					def,
					Symbol::fromIndex(),
					.Static,
					[(Symbol::indexParam(), I64)],
					ret,
					.FromIndex,
					at,
				)
			}
			if !self.enumDeclares(id, "all") {
				val selfTy = self.ownSelfTy(def)
				val count = self.program.enums[id].variants.len() as u64
				val ret = self.intern(.Array(elem: selfTy, len: count))
				val none: Vec<(Symbol, Ty)> = Vec()
				self.generatedFn(def, Symbol::all(), .Static, none, ret, .AllVariants, at)
			}
			if !self.enumDeclares(id, "name") {
				val none: Vec<(Symbol, Ty)> = Vec()
				self.generatedFn(def, Symbol::variantName(), .Read, none, STR, .VariantName, at)
			}
			if !self.enumDeclares(id, "fromName") &&
				self.program.preludeItems.enumeration(.Option) is .Some(option) {
				val selfTy = self.ownSelfTy(def)
				val args = self.program.types.internList([selfTy])
				val ret = self.intern(.Enum(id: option, args: args))
				self.generatedFn(
					def,
					Symbol::fromName(),
					.Static,
					[(Symbol::textParam(), STR)],
					ret,
					.FromName,
					at,
				)
			}
			self.typeParams.clear()
		}
	}

	/// Why an enum whose variants carry values has no `count`, `fromIndex`,
	/// `all`, `name` or `fromName`, where one of them is asked of it.
	fn carriesValuesNote(owner: TypeDef, asked: str): Option<String> = {
		val .Enum(id) = owner else return .None
		if !["count", "fromIndex", "all", "name", "fromName"].contains(&asked) then
			return .None

		var carries = false
		for v in self.program.enums[id].variants do
			if !v.fields.isEmpty() then
				carries = true

		if !carries then
			return .None

		val typeName = self.text(self.program.enums[id].name)
		return .Some("an enum whose variants carry nothing has `count`, `fromIndex`, `all`, `name` and `fromName`, since a number or a name says all of such a value; `\(typeName)`'s variants carry values")
	}

	/// Whether an enum declares a method of this name.
	fn enumDeclares(id: EnumId, name: str): bool = {
		return self.program.enums[id].methods.any((m) =>
			self.text(self.program.fns[m].name) == name)
	}

	/// A function whose body the compiler writes: a static one, or a method
	/// that reads its receiver, `self`, which comes before `params`.
	var fn generatedFn(
		owner: TypeDef,
		name: Symbol,
		receiver: Receiver,
		params: Vec<(Symbol, Ty)>,
		ret: Ty,
		generated: Generated,
		at: Span,
	): FnId = {
		val generics = self.typeGenerics(owner)
		var defs: Vec<ParamDef> = Vec()
		if receiver is .Read {
			val selfTy = self.intern(.Ref(inner: self.ownSelfTy(owner), kind: .Shared))
			defs.push(ParamDef(
				name: Symbol::receiver(),
				nameSpan: at,
				ty: selfTy,
				span: at,
				default: .None,
			))
		}
		for (paramName, ty) in params do
			defs.push(ParamDef(name: paramName, nameSpan: at, ty: ty, span: at, default: .None))

		val id = self.program.fns.add(
			FnDef(
				name: name,
				nameSpan: at,
				symbol: .None,
				receiver: receiver,
				owner: owner,
				interfaceId: .None,
				generics: generics,
				instanceOf: .None,
				params: defs,
				ret: ret,
				retSpan: .None,
				isExtern: false,
				exportsC: false,
				header: .None,
				accesses: .None,
				isVariadic: false,
				variadicOf: .None,
				// What a method of these answers, a variant's name, is text the
				// program keeps, and borrows nothing of `self`.
				lendsFrom: if receiver is .Static then .None else Vec(),
				keeps: Vec(),
				keepsAt: .None,
				isLambda: false,
				generator: .None,
				isTailrec: false,
				test: .None,
				isInline: false,
				generated: generated,
				intrinsic: .None,
				body: .None,
				projects: .None,
				compileTime: false,
				module: self.current as u32,
				isPub: true,
				span: at,
			),
		)
		match owner {
			.Struct(s) => self.program.structs[s].methods.push(id)
			.Enum(e) => self.program.enums[e].methods.push(id)
			.Builtin(_) => {}
		}
		return id
	}

	/// `@derive(Ord)`: `Eq` beside it, and each field ordered.
	var fn checkOrderable(owner: TypeDef, at: Span, hasEq: bool) = {
		// Two values that compare `Same` and are not equal would make every
		// algorithm that uses both wrong.
		var equal = false
		if self.program.preludeItems.interfaceOf(.Eq) is .Some(eq) {
			for i in self.program.impls do
				if i.interfaceId == eq && i.ty == owner then
					equal = true
		}
		if !hasEq && !equal {
			val typeName = self.typeName(owner)
			self.report(
				Diagnostic::error(
					NOT_COMPARABLE,
					"`\(typeName)` is ordered and does not say when two of it are equal",
					at,
					"`Ord` derived without `Eq`",
				).withHelp("name `Eq` in the `@derive` as well").withNote(
					"two values that compare `Same` and are not equal would make every algorithm that uses both wrong",
				),
			)
			self.withholdDerived(owner, self.program.preludeItems.interfaceOf(.Ord))
			return
		}
		self.checkDerivedFields(owner, at, .Ord)
	}

	/// `@derive(Hash)`: `Eq` beside it, and each field hashed.
	var fn checkHashable(owner: TypeDef, at: Span, hasEq: bool) = {
		// A map is wrong the moment two equal values hash differently, and a
		// hashing written from the fields only matches an equality written
		// from the fields.
		if !hasEq {
			val typeName = self.typeName(owner)
			self.report(
				Diagnostic::error(
					NOT_COMPARABLE,
					"`\(typeName)` is hashed and does not say when two of it are equal",
					at,
					"`Hash` derived without `Eq`",
				).withHelp(
					"name `Eq` in the `@derive` as well, or write `extend …: Hash` by hand",
				).withNote(
					"a map is wrong the moment two equal values hash differently, and the compiler will not guess that a type whose equality is written by hand should be hashed the same way",
				),
			)
			self.withholdDerived(owner, self.program.preludeItems.interfaceOf(.Hash))
			return
		}
		self.checkDerivedFields(owner, at, .Hash)
	}
}
