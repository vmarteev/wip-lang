// What a program declares and never uses, said once every body is checked:
// a `var` that nothing writes, which is a `val`; a local, a name a pattern
// binds and a parameter that nothing reads; an imported name the file never
// writes; and a function of a module's own that nothing calls. Each is a
// warning, with the fix that says the same in fewer words where there is
// one.
//
// A program with errors is not told of these: what it has not finished
// writing is often what would use them. A local or a binding that owns
// memory or has a `destroy` is not warned of when nothing reads it, since
// being bound is what keeps it to the end of its block. A parameter is warned of only where
// renaming it `_` changes nothing for a caller: not a `pub` function's, an
// interface's method's, C's, an implicit, or one a call gives by name.
//
// What another target's code, or a test the build leaves out, names is
// used: the parser keeps every name a file writes before any item is dropped
// for the target, and the loader the words of the files it does not read.

import std::collections::{Map, Set}
import syntax as ast
import syntax::{
	BINDING_NEVER_READ,
	Diagnostic,
	Edit,
	IMPORT_NEVER_USED,
	NEVER_CALLED,
	NEVER_READ,
	NEVER_WRITTEN,
	PARAMETER_NEVER_READ,
	Span
}

extend Lowerer {
	/// The warnings of what each function declares and never uses, of the
	/// imports nothing names, and of the functions nothing calls.
	var fn reportUnused(files: &[(i64, &ast::Ast)], modules: &[ModuleAst]) = {
		for (_, file) in files do
			if !file.derived then
				self.unusedImports(&file)

		self.uncalled(&files, &modules)
		// The parameters a call gives by name, in any body, and the methods
		// that implement an interface's.
		var named: Set<(FnId, u32)> = Set()
		var implementing: Set<FnId> = Set()
		for i in self.program.impls {
			for m in i.methods do
				implementing.add(m)
		}
		for id in self.program.fns.ids() {
			if self.program.fns[id].body is .Some(body) {
				for n in body.namedArguments do
					named.add(n)
			}
		}
		// A `lend fn` is two functions of one body, which say the same.
		var said: Set<(u32, String)> = Set()
		for id in self.program.fns.ids() {
			for d in self.unusedIn(id, &named, &implementing) do
				if said.add((d.primary.span.lo, d.message.clone())) then
					self.report(d)
		}
	}

	/// Each name `file` imports and never writes. Where nothing an import
	/// names is written, the import is the warning, and its fix removes it.
	var fn unusedImports(file: &ast::Ast) = {
		for item in file.items {
			val .Import(decl) = item else continue
			val modulePath = self.pathText(&decl.path)
			val .Some(items) = decl.items else {
				val bound = decl.alias.unwrapOr(decl.path[decl.path.len() - 1])
				if !file.written.contains(&bound.sym) then
					self.reportImport(self.text(bound.sym), decl.span, decl.span)

				continue
			}
			var unused: Vec<i64> = [for (i, named) in items.indexed() {
				val bound = match named.alias {
					.Some(alias) => alias
					.None => match named.name {
						.Some(name) => name
						.None => decl.path[decl.path.len() - 1]
					}
				}
				if !file.written.contains(&bound.sym) then
					yield i
			}]
			if unused.isEmpty() then
				continue

			if unused.len() == items.len() {
				self.reportImport(modulePath.toStr(), decl.span, decl.span)
				continue
			}
			for i in unused {
				// The name and the comma after it, or before it where it is
				// the last.
				val cut =
					if i + 1 < items.len() then Span::new(items[i].span.lo, items[i + 1].span.lo)
					else Span::new(items[i - 1].span.hi, items[i].span.hi)
				val name = self.text(
					match items[i].alias {
						.Some(alias) => alias.sym
						.None => match items[i].name {
							.Some(n) => n.sym
							.None => decl.path[decl.path.len() - 1].sym
						}
					},
				)
				self.reportImport(name, items[i].span, cut)
			}
		}
	}

	/// The warning of an import nothing names, at `span`, whose fix removes
	/// what `cut` covers.
	var fn reportImport(name: str, span: Span, cut: Span) = self.report(
		Diagnostic::warning(
			IMPORT_NEVER_USED,
			"`\(name)` is imported, and nothing in this file names it",
			span,
			"never named",
		).withFix("remove it", [Edit::replace(cut, "")]),
	)

	/// A module's path as written: `std::collections`.
	fn pathText(path: &[ast::Name]): String = {
		var text = String()
		for (i, name) in path.indexed() {
			if i > 0 then
				text.push("::")

			text.push(self.text(name.sym))
		}
		return text
	}

	/// Each function of a module's own that nothing calls: not `pub`, not an
	/// interface's, not what the compiler or C calls by name.
	var fn uncalled(files: &[(i64, &ast::Ast)], modules: &[ModuleAst]) = {
		var called: Set<FnId> = Set()
		for id in self.program.fns.ids() {
			if self.program.fns[id].body is .Some(body) then
				calledIn(&body.exprs, id, &var called)

			for p in self.program.fns[id].params do
				if p.default is .Some(.Constant(exprs, ..)) then
					calledIn(&exprs, id, &var called)
		}
		for s in self.program.structs.ids() {
			for f in self.program.structs[s].fields do
				if f.default is .Some(.Constant(exprs, ..)) then
					calledIn(&exprs, .None, &var called)
		}
		for which in KnownFn::all() do
			if self.program.preludeItems.function(which) is .Some(known) then
				called.add(known)

		// Both halves of a `lend fn` are its one declaration.
		var calledAt: Set<u32> = Set()
		for id in called do
			calledAt.add(self.program.fns[id].nameSpan.lo)

		// What another target's items name, by module.
		var withheld: Vec<Set<ast::Symbol>> = [
			for _ in 0..modules.len() do
				yield Set()
		]
		for (module, file) in files {
			for symbol in file.withheld do
				withheld[module].add(symbol)
		}
		var implementing: Set<FnId> = Set()
		for i in self.program.impls {
			for m in i.methods do
				implementing.add(m)
		}
		// The code that works out a constant is the constant's, and a
		// top-level `assert`'s is the compiler's to run.
		for c in self.program.consts.ids() do
			if self.program.consts[c].code is .Some(code) then
				implementing.add(code)

		for a in self.program.asserts do
			implementing.add(a)

		for id in self.program.fns.ids() {
			val def = &self.program.fns[id]
			// The compiler calls the prelude's functions by their names.
			if self.program.modules[def.module as i64] == PRELUDE then
				continue

			if def.isPub ||
				def.isExtern ||
				def.exportsC ||
				def.isLambda ||
				def.test.isSome() ||
				def.intrinsic.isSome() ||
				def.generated.isSome() ||
				def.instanceOf.isSome() ||
				def.assertOf.isSome() ||
				def.variadicOf.isSome() ||
				def.interfaceId.isSome() ||
				implementing.contains(&id) ||
				calledAt.contains(&def.nameSpan.lo) {
				continue
			}
			val name = self.text(def.name)
			if name == "main" || name.contains("#") || def.module as i64 >= modules.len() then
				continue

			if withheld[def.module as i64].contains(&def.name) ||
				modules[def.module as i64].elsewhere.contains(String::of(name)) {
				continue
			}
			self.report(
				Diagnostic::warning(
					NEVER_CALLED,
					"`\(name)` is never called",
					def.nameSpan,
					"never called",
				).withNote(
					"a function that is not `pub` is its module's own, and nothing in the module calls it",
				).withHelp("call it, or remove it"),
			)
		}
	}

	/// What `id`'s body declares and never uses.
	fn unusedIn(id: FnId, named: &Set<(FnId, u32)>, implementing: &Set<FnId>): Vec<Diagnostic> = {
		var found: Vec<Diagnostic> = Vec()
		val def = &self.program.fns[id]
		if def.instanceOf.isSome() || def.generated.isSome() || def.assertOf.isSome() then
			return found

		val .Some(body) = def.body else return found
		val (reads, written) = self.usesIn(&body)
		// Each `var` a statement declares, with where its `var` is written: a
		// `var x = …`, and the names a `var` pattern before `else` binds, all
		// of which a `val` would bind. A `var` inside a pattern, `.Some(var
		// x)`, is the binding's own, and is not told to be a `val`.
		var keywords: Map<LocalId, Span> = Map()
		var guarded: Map<LocalId, Vec<LocalId>> = Map()
		for s in body.stmts.ids() {
			match body.stmts[s].kind {
				// A `var` the program wrote has its name after the word; one the
				// checker made holds what a statement it stands for computes.
				.Let(local, ..) if body.locals[local].kind == .Var &&
					body.locals[local].span.lo > body.stmts[s].span.lo => {
					val at = body.stmts[s].span.lo + (if body.locals[local].implicit then 9 else 0)
					keywords.put(local, Span::new(at, at + 3))
				}
				.Guard(pattern, ..) if body.varGuards.contains(&s) => {
					var bound: Vec<LocalId> = Vec()
					pattern.locals(&var bound)
					val vars = bound.filter((b) => body.locals[b].kind == .Var)
					if vars.isEmpty() then
						continue

					val at = body.stmts[s].span.lo
					keywords.put(vars[0], Span::new(at, at + 3))
					guarded.put(vars[0], vars)
				}
				_ => {}
			}
		}
		// The first parameter of a lambda is what it captured, and of a method
		// that takes one, `self`.
		val hidden = def.isLambda || (def.receiver is .Some(receiver) && receiver != .Static)
		for local in body.locals.ids() {
			val l = &body.locals[local]
			val name = self.text(l.name)
			if name == "_" ||
				name.contains("#") ||
				madeByTheChecker(l.name) ||
				self.isPoisoned(l.ty) {
				continue
			}
			val read = countOf(&reads, local) > 0
			match l.kind {
				.Param => {
					if read then
						continue

					val .Some(p) = body.params.indexOf(&local) else continue
					if p == 0 && hidden then
						continue

					if def.isPub ||
						def.interfaceId.isSome() ||
						implementing.contains(&id) ||
						def.isExtern ||
						def.exportsC ||
						def.test.isSome() ||
						(p < def.params.len() && def.params[p].implicit) ||
						named.contains((id, p as u32)) {
						continue
					}
					found.push(
						Diagnostic::warning(
							PARAMETER_NEVER_READ,
							"the parameter `\(name)` is never read",
							l.span,
							"never read",
						).withNote(
							"a parameter the signature needs and the function does not is written `_`",
						).withFix("write `_` in its place", [Edit::replace(l.span, "_")]),
					)
				}
				.Binding => {
					// What a binding takes and owns, it keeps to the end of its
					// block, where `_` would drop it at once: a sender bound to
					// keep its channel open.
					if read ||
						(!body.aliasBindings.contains(&local) && self.program.ownsMemory(l.ty)) {
						continue
					}
					val replacement =
						if body.namedBindings.contains(&local) then "\(name): _" else "_"
					found.push(
						Diagnostic::warning(
							BINDING_NEVER_READ,
							"`\(name)` is bound and never read",
							l.span,
							"never read",
						).withNote("a pattern writes `_` for what it does not name").withFix(
							"write `\(replacement)` in its place",
							[Edit::replace(l.span, replacement)],
						),
					)
				}
				.Let(..) | .Var => {
					if !read && !self.program.ownsMemory(l.ty) {
						found.push(self.neverRead(&body, local, name))
						continue
					}
					if l.kind != .Var || written.contains(&local) then
						continue

					val .Some(keyword) = keywords.get(&local) else continue
					// A `var` pattern is a `val` where none of its names changes.
					if guarded.get(&local) is .Some(vars) && vars.any((v) => written.contains(&v)) {
						continue
					}
					found.push(
						Diagnostic::warning(
							NEVER_WRITTEN,
							"`\(name)` is never changed, so it is a `val`",
							l.span,
							"never written",
						).withNote(
							"a `var` says that it changes, and a reader looks for where",
						).withFix("make it a `val`", [Edit::replace(keyword, "val")]),
					)
				}
			}
		}
		return found
	}

	/// The warning of a local nothing reads: removed where what it is given
	/// only reads, and otherwise kept, for what giving it may do.
	fn neverRead(body: &Body, local: LocalId, name: str): Diagnostic = {
		val diagnostic = Diagnostic::warning(
			NEVER_READ,
			"`\(name)` is never read",
			body.locals[local].span,
			"never read",
		)
		for s in body.stmts.ids() {
			val .Let(local: declared, init) = body.stmts[s].kind else continue
			if declared != local then
				continue

			if onlyReads(&body, init) then
				return diagnostic.withFix("remove it", [Edit::replace(body.stmts[s].span, "")])
		}
		return diagnostic.withHelp("use it, or give what it is given as a statement of its own")
	}

	/// How often each local is read, and the locals that are written:
	/// assigned to, wholly or in part, lent with `&var`, or written through
	/// a binding that refers into them. Assigning a place reads nothing of
	/// it; `+=` reads it too.
	fn usesIn(body: &Body): (Map<LocalId, i64>, Set<LocalId>) = {
		var reads: Map<LocalId, i64> = Map()
		var written: Set<LocalId> = Set()
		for e in body.exprs.ids() {
			match body.exprs[e].kind {
				.Local(local) => reads.put(local, countOf(&reads, local) + 1)
				.Assign(place, op, ..) => {
					val .Some((root, direct)) = self.rootOf(&body, place, true) else continue
					written.add(root)
					if op.isNone() && direct then
						reads.put(root, countOf(&reads, root) - 1)
				}
				.Lend(place) => {
					if self.rootOf(&body, place, true) is .Some((root, _)) then written.add(root)
				}
				.Ref(place) if self.kind(body.exprs[e].ty) is .Ref(kind: .Var, ..) => {
					if self.rootOf(&body, place, true) is .Some((root, _)) then written.add(root)
				}
				_ => {}
			}
		}
		// A binding that refers into a place writes that place where it is
		// written through, and a binding of a binding the first's.
		var grew = true
		while grew {
			grew = false
			for entry in body.aliases {
				if !written.contains(&entry.key) then
					continue

				if self.rootOf(&body, entry.value, true) is .Some((root, _)) && written.add(root) {
					grew = true
				}
			}
		}
		return (reads, written)
	}

	/// The local a place is part of, and whether it is reached without
	/// reading through a reference or a pointer: `p.x` of a local `p`, and
	/// not of a `&var` one, nor `p[0]` of a `ptr`.
	fn rootOf(
		body: &Body,
		place: ExprId,
		direct: bool,
	): Option<(LocalId, bool)> = match body.exprs[place].kind {
		.Local(local) => (local, direct)
		.Index(base, ..) if self.kind(body.exprs[base].ty) is .Ptr(..) => self.rootOf(
			&body,
			base,
			false,
		)
		.Field(base, ..) | .Index(base, ..) | .SubSlice(base, ..) => self.rootOf(
			&body,
			base,
			direct,
		)
		.Deref(inner) => self.rootOf(&body, inner, false)
		_ => .None
	}
}

/// Whether working out `e` only reads: a literal, a local, or a field of one.
fn onlyReads(body: &Body, e: ExprId): bool = match body.exprs[e].kind {
	.Int(..) | .Float(..) | .Bool(..) | .Str(..) | .Null | .Local(..) => true
	.Field(base, ..) | .Deref(base) => onlyReads(&body, base)
	_ => false
}

/// How often `local` was counted.
fn countOf(counts: &Map<LocalId, i64>, local: LocalId): i64 = match counts.get(&local) {
	.Some(n) => n
	.None => 0
}

/// Each function `exprs` calls or names, but `within` itself, added to
/// `called`.
fn calledIn(exprs: &Arena<Expr>, within: Option<FnId>, called: &var Set<FnId>) = {
	for e in exprs.ids() {
		val target: FnId = match exprs[e].kind {
			.Call(callee, ..) => callee
			.FnRef(id, ..) | .Closure(id, ..) => id
			_ => continue
		}
		if target != within then
			called.add(target)
	}
}

/// Whether a local is one the checker made, which no program can name: what
/// a `for` walks, what a list built as it runs fills, what a struct's `..`
/// is taken from.
fn madeByTheChecker(name: ast::Symbol): bool =
	name == ast::Symbol::walked() || name == ast::Symbol::list() || name == ast::Symbol::ignored()
