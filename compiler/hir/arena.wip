// The checked program's arenas: values added one after another and never
// removed, each named by its number among them. The library's `Arena`, which
// lets values be removed and reused, names them by handles that say no
// number, and the checker names what it makes by number — a generator's
// type, a local in what it writes — and sorts by it.

/// A value's number in an `Arena`: where it was added.
pub struct Id<T> {
	number: u32
}

// An id compares, orders and hashes by its number, whatever `T` is; so these
// are written here, where a derived one would ask `T`.
extend Id<T>: Eq {
	@inline
	fn equals(other: &Id<T>): bool = self.number == other.number
}

extend Id<T>: Ord {
	fn compare(other: &Id<T>): Ordering = self.number.compare(&other.number)
}

extend Id<T>: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self.number as u64)
}

extend Id<T>: Text {
	fn appendTo(out: &var String) = {
		out.push("#")
		self.number.appendTo(&var out)
	}
}

extend Id<T> {
	/// The id of the value added `number`th.
	pub static fn of(number: i64): Id<T> = Id(number: number as u32)

	/// Where the value was added: 0 for the first.
	pub fn index(): i64 = self.number as i64
}

/// Values named by their number.
pub struct Arena<T> {
	values: Vec<T> = Vec()
}

extend Arena<T>: Items<T> {
	// The values, in the order they were added, which is what `for value in
	// arena` walks.
	fn items(): &[T] = lend self.values.items()
}

// `arena[id]`: the value, to read or to write.
extend Arena<T>: Index<Id<T>, T> {
	@inline
	lend fn at(id: Id<T>): &T = lend self.values[id.number as i64]
}

extend Arena<T> {
	/// Adds a value, and answers its id.
	pub var fn add(value: T): Id<T> keeps value = {
		val id: Id<T> = Id::of(self.values.len())
		self.values.push(move value)
		return id
	}

	pub fn len(): i64 = self.values.len()

	pub fn isEmpty(): bool = self.values.isEmpty()

	/// The id of each value, in the order they were added.
	pub fn ids(): Vec<Id<T>> = {
		var ids: Vec<Id<T>> = Vec::withCapacity(self.values.len())
		for i in 0..self.values.len() {
			ids.push(Id::of(i))
		}
		return move ids
	}
}

extend Arena<T: Clone>: Clone {
	fn clone(): Arena<T> = Arena(values: self.values.clone())
}
