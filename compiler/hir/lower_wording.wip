// Wording for diagnostics: suggestions for misspelt names, and plurals.

/// The candidate closest to `name`, if it is close enough to be a typo.
/// Names shorter than three characters get no suggestions: offering `y` for
/// `x` is noise.
fn suggest(name: str, candidates: &[str]): Option<str> = {
	val limit = name.chars().count() / 3
	if limit == 0 then return .None
	var best: Option<(i64, str)> = .None
	for c in candidates {
		if c == name then continue
		val d = editDistance(name, c)
		if d > limit then continue
		// The least distance, and among equals the least name, as a minimum
		// of pairs is.
		val better = match best {
			.None => true
			.Some((bestD, bestC)) => d < bestD || (d == bestD && c < bestC)
		}
		if better then best = .Some((d, c))
	}
	return match best {
		.Some((_, c)) => .Some(c)
		.None => .None
	}
}

/// Where a name the prelude gave up went, said as the help for a program
/// that used it without an import: the import that brings it back, or the
/// method that took its place.
fn leftThePrelude(name: str): Option<String> = {
	val module = match name {
		"Map" | "MapEntry" | "Set" => "std::collections"
		"Mapped" | "Filtered" | "Enumerated" | "Taken" | "Skipped" | "Zipped" | "Walk" =>
			"std::iter"
		"Chars" | "Split" | "Lines" | "ParseError" => "std::text"
		"sort" => return .Some("`sort` is a method of a slice and a `Vec`: `values.sort()`")
		"sortBy" => return .Some(
			"`sortBy` is a method of a slice and a `Vec`: `values.sortBy(before)`",
		)
		_ => return .None
	}
	return .Some("`\(name)` is in `\(module)`: `import \(module)::{\(name)}`")
}

/// Edit distance counting an adjacent transposition as one edit, since
/// swapped letters (`cuont`, `hieght`) are the most common typo.
fn editDistance(left: str, right: str): i64 = {
	var a: Vec<char> = Vec()
	for c in left.chars() {
		a.push(c)
	}
	var b: Vec<char> = Vec()
	for c in right.chars() {
		b.push(c)
	}
	var d: Vec<Vec<i64>> = Vec()
	for i in 0..a.len() + 1 {
		var row: Vec<i64> = Vec()
		for j in 0..b.len() + 1 {
			row.push(if i == 0 then j else if j == 0 then i else 0)
		}
		d.push(move row)
	}
	for i in 1..a.len() + 1 {
		for j in 1..b.len() + 1 {
			val cost = if a[i - 1] != b[j - 1] then 1 else 0
			var best = d[i - 1][j] + 1
			if d[i][j - 1] + 1 < best then best = d[i][j - 1] + 1
			if d[i - 1][j - 1] + cost < best then best = d[i - 1][j - 1] + cost
			if i > 1 &&
				j > 1 &&
				a[i - 1] == b[j - 2] &&
				a[i - 2] == b[j - 1] &&
				d[i - 2][j - 2] + 1 < best {
				best = d[i - 2][j - 2] + 1
			}
			d[i][j] = best
		}
	}
	return d[a.len()][b.len()]
}

fn plural(n: i64, one: str, many: str): String = "\(n) \(if n == 1 then one else many)"

/// "a" or "an", for a word as it is said: `an \`Iterator\``, `a \`Source\``.
fn article(word: str): str = {
	var at = 0
	while at < word.len() && word[at] == b'`' {
		at += 1
	}
	if at < word.len() &&
		word[at] is b'A' | b'E' | b'I' | b'O' | b'U' | b'a' | b'e' | b'i' | b'o' | b'u' {
		return "an"
	}
	return "a"
}
