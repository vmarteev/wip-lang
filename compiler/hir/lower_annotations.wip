// Annotations: `@name` and `@name(arguments)` before a declaration.
//
// The set is closed and written here. An annotation the compiler does not
// know is an error, and so is one on a declaration that does not take it,
// one given the wrong arguments, and one written twice: an annotation that
// quietly does nothing is worse than none, because a reader believes it.

import syntax as ast
import syntax::{ANNOTATION, Diagnostic, Edit, Span, Symbol}

/// What a declaration is, for the table below.
@derive(Eq, Clone)
enum AnnotationTarget {
	Fn
	Struct
	Enum
	Interface
	Extend
	Extern
	/// A declaration inside an extern block: a function, a variable or a type
	/// C owns.
	ExternFn
	ExternVar
	ExternType
	Val
	Assert
	/// A struct's field, which `@align` may be written on.
	Field
}

extend AnnotationTarget {
	fn text(): str = match self {
		.Fn => "a function"
		.Struct => "a struct"
		.Enum => "an enum"
		.Interface => "an interface"
		.Extend => "an `extend` block"
		.Extern => "an `extern` block"
		.ExternFn => "a C function's declaration"
		.ExternVar => "a C variable's declaration"
		.ExternType => "a C type's declaration"
		.Val => "a constant"
		.Assert => "a top-level `assert`"
		.Field => "a struct's field"
	}
}

/// An interface the compiler can write from a type's fields, which is what
/// `@derive` takes.
@derive(Eq, Hash, Clone)
enum Derived {
	/// `equals`, field by field, written as code.
	Eq
	/// `compare`, field by field, written as code.
	Ord
	/// `hashInto`, part by part.
	Hash
	/// `appendTo`, as the literal that would make the value.
	Text
	/// `clone`, field by field, written as code.
	Clone
	/// `encode`, a record of the fields, written as code.
	Encode
	/// `decode`, the fields read by name, written as code.
	Decode
}

extend Derived {
	fn name(): str = match self {
		.Eq => "Eq"
		.Ord => "Ord"
		.Hash => "Hash"
		.Text => "Text"
		.Clone => "Clone"
		.Encode => "Encode"
		.Decode => "Decode"
	}

	/// The one called `name`, if `@derive` can write it.
	static fn named(name: str): Option<Derived> = {
		for d in Derived::all() {
			if d.name() == name then return .Some(d)
		}
		return .None
	}
}

/// What each annotation that wrote a body was called before `@derive`:
/// reported with a fix to the form that replaced it.
val DERIVED_BEFORE: [(str, str); 4] = [
	("eq", "Eq"),
	("ord", "Ord"),
	("hash", "Hash"),
	("text", "Text"),
]

/// The annotations the compiler knows, by name.
val KNOWN_NAMES: [str; 20] = [
	"tailrec",
	"inline",
	"intrinsic",
	"target",
	"test",
	"export",
	"link",
	"include",
	"source",
	"define",
	"prefix",
	"framework",
	"symbol",
	"derive",
	"oneOf",
	"opaque",
	"comptime",
	"header",
	"align",
	"packed",
]

/// One annotation the compiler knows: where it may be written; what it
/// takes, for the message when it is given something else, nothing where
/// it takes no arguments; and whether it may be written without them.
view struct Known {
	targets: Vec<AnnotationTarget>
	arguments: Option<str>
	bare: bool = false
}

/// What the compiler knows of the annotation called `name`, if it knows one.
fn known(name: str): Option<Known> = match name {
	"tailrec" => .Some(Known(targets: Vec::of(own [AnnotationTarget::Fn]), arguments: .None))
	"inline" => .Some(Known(targets: Vec::of(own [AnnotationTarget::Fn]), arguments: .None))
	"intrinsic" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Fn, AnnotationTarget::Struct]),
		arguments: .None,
	))
	// Every kind of declaration that carries annotations: what a target has
	// and has not is not one kind of thing.
	"target" => .Some(Known(
		targets: Vec::of(own [
			AnnotationTarget::Fn,
			AnnotationTarget::Struct,
			AnnotationTarget::Enum,
			AnnotationTarget::Interface,
			AnnotationTarget::Extern,
			AnnotationTarget::ExternFn,
			AnnotationTarget::ExternVar,
			AnnotationTarget::ExternType,
			AnnotationTarget::Extend,
			AnnotationTarget::Val,
			AnnotationTarget::Assert,
		]),
		arguments: .Some("what it is for, as in `@target(os = \"linux\")`"),
	))
	"test" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Fn]),
		arguments: .Some("what the test expects, as in `@test(panics = \"out of bounds\")`"),
		bare: true,
	))
	"export" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Fn]),
		arguments: .Some("one ABI name, as in `@export(\"C\")`"),
	))
	"link" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Extern]),
		arguments: .Some("library names, as in `@link(\"sqlite3\")`"),
	))
	"include" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Extern]),
		arguments: .Some("directories in the module, as in `@include(\"src\")`"),
	))
	"source" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Extern]),
		arguments: .Some(
			"C files in the module, as in `@source(\"src/rcore.c\")`, and what they are written in, `language = \"objective-c\"`",
		),
	))
	"define" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Extern]),
		arguments: .Some(
			"settings for the module's C, as in `@define(\"PLATFORM_DESKTOP\", \"LEVEL=2\")`",
		),
	))
	"prefix" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Extern]),
		arguments: .Some("one header, as in `@prefix(\"build.h\")`"),
	))
	"framework" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Extern]),
		arguments: .Some("framework names, as in `@framework(\"Cocoa\")`"),
	))
	"symbol" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::ExternFn, AnnotationTarget::ExternVar]),
		arguments: .Some("one C name, as in `@symbol(\"sqlite3_open\")`"),
	))
	"derive" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Struct, AnnotationTarget::Enum]),
		arguments: .Some("the interfaces it writes, as in `@derive(Eq, Hash)`"),
	))
	"oneOf" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Interface]),
		arguments: .Some(
			"the methods an implementation writes one of, as in `@oneOf(toString, appendTo)`",
		),
	))
	"opaque" => .Some(Known(targets: Vec::of(own [AnnotationTarget::Struct]), arguments: .None))
	"align" => .Some(Known(
		targets: Vec::of(own [AnnotationTarget::Struct, AnnotationTarget::Field]),
		arguments: .Some("an alignment in bytes, a power of two up to 4096, as in `@align(16)`"),
	))
	"packed" => .Some(Known(targets: Vec::of(own [AnnotationTarget::Struct]), arguments: .None))
	"comptime" => .Some(Known(targets: Vec::of(own [AnnotationTarget::Val]), arguments: .None))
	"header" => .Some(Known(
		targets: Vec::of(own [
			AnnotationTarget::Extern,
			AnnotationTarget::Struct,
			AnnotationTarget::ExternFn,
			AnnotationTarget::ExternVar,
		]),
		arguments: .Some("one header to include, as in `@header(\"<math.h>\")`"),
	))
	_ => .None
}

/// What the annotations of a declaration say about it.
@derive(Clone)
struct Annotations {
	/// `@tailrec`.
	tailrec: bool = false
	/// `@intrinsic`: the compiler writes this body.
	intrinsic: bool = false
	/// `@inline`: every call to it is spliced, or the program does not
	/// compile.
	inline: Option<Span> = .None
	/// `@test`: `wip test` runs it, and what it expects of the run.
	test: Option<(Test, Span)> = .None
	/// `@link("name", …)`: the libraries the declarations, or the C the
	/// module builds, come from.
	link: Vec<(Symbol, Span)> = Vec()
	/// `@export("C")`: the function gets a plain C symbol, so that C can call
	/// it by name.
	export: Option<(Symbol, Span)> = .None
	/// `@symbol("sqlite3_open")`: what C calls it, when Wip calls it something
	/// else.
	symbol: Option<(Symbol, Span)> = .None
	/// `@derive(Eq, Ord, Hash, Text)`: the interfaces the compiler writes from
	/// the fields, and where each was named.
	derive: Vec<(Derived, Span)> = Vec()
	/// `@opaque`: C knows this struct's layout and Wip does not, so its fields
	/// are reached through C.
	opaque: Option<Span> = .None
	/// `@align(n)`: the alignment, a power of two, and where it was written.
	align: Option<(u32, Span)> = .None
	/// `@packed`: no padding between the fields.
	packed: Option<Span> = .None
	/// `@comptime`: the constant is worked out by running code while the
	/// program is compiled.
	comptime: Option<Span> = .None
	/// `@oneOf(a, b)`, as many as are written: methods of the interface of
	/// which an implementation writes one at least.
	oneOf: Vec<OneOf> = Vec()
	/// `@header("<math.h>")`: the declarations are what this header says they
	/// are, so each call goes through C that includes it.
	header: Option<(Symbol, Span)> = .None
	/// `@include("src", …)`: directories in the module where its C looks for
	/// headers.
	include: Vec<(Symbol, Span)> = Vec()
	/// `@framework("Cocoa", …)`: what an Apple target links besides the
	/// libraries.
	framework: Vec<(Symbol, Span)> = Vec()
	/// `@source("src/rcore.c", …)`: C files of the module, below its own
	/// directory, each compiled with the program, and `language = "…"`, what
	/// they are written in where their extension does not say.
	source: Vec<(Symbol, Span)> = Vec()
	sourceLanguage: Option<CLanguage> = .None
	/// `standard = "c++20"`: the C++ standard the files are compiled to,
	/// where it is not C++17.
	sourceStandard: Option<String> = .None
	/// `@prefix("build.h")`: a header put before every C file of the module,
	/// which is how a vendored library is configured.
	prefix: Option<(Symbol, Span)> = .None
	/// `@define("PLATFORM_DESKTOP", "LEVEL=2")`: what every C file of the
	/// module is compiled with defined, as `-D` defines it.
	define: Vec<(Symbol, Span)> = Vec()
}

extend Lowerer {
	/// Checks the annotations written on a declaration, and returns what they
	/// say.
	var fn annotations(written: &[ast::Annotation], target: AnnotationTarget): Annotations = {
		var annotations = Annotations()
		var seen: Vec<(Symbol, Span)> = Vec()
		for annotation in written {
			val name = String::of(self.text(annotation.name.sym))
			// `@eq` and its three siblings are written `@derive(Eq)` now.
			var renamed: Option<str> = .None
			for (old, interfaceName) in DERIVED_BEFORE {
				if old == name then renamed = .Some(interfaceName)
			}
			if renamed is .Some(interfaceName) {
				self.report(
					Diagnostic::error(
						ANNOTATION,
						"`@\(name)` is written `@derive(\(interfaceName))`",
						annotation.span,
						"the old spelling",
					).withFix(
						"write `@derive(\(interfaceName))`",
						own [Edit::replace(annotation.span, "@derive(\(interfaceName))")],
					).withNote(
						"the annotations that write an interface's body are one, and it names the interface: `@derive(Eq, Ord, Hash, Text)`",
					),
				)
				continue
			}
			val .Some(knownOne) = known(name) else {
				var diagnostic = Diagnostic::error(
					ANNOTATION,
					"there is no annotation `@\(name)`",
					annotation.name.span,
					"not an annotation",
				).withNote(
					"the compiler knows every annotation there is; a name it does not know is a mistake, not a hint",
				)
				if suggest(name, &KNOWN_NAMES) is .Some(similar) then
					diagnostic = diagnostic.withFix(
						"did you mean `@\(similar)`?",
						own [Edit::replace(annotation.name.span, similar)],
					)
				self.report(diagnostic)
				continue
			}
			// `@derive` may be written more than once, and what the lines name
			// is one list: it is what fixing `@eq @hash` one at a time leaves.
			// `@target` may too, and the lines are the targets it is for, any
			// of them; and `@oneOf`, each line a group of its own.
			if name.toStr() !is "derive" | "target" | "oneOf" {
				var first: Option<Span> = .None
				for (sym, span) in seen {
					if first.isNone() && sym == annotation.name.sym then first = .Some(span)
				}
				if first is .Some(first) {
					self.report(
						Diagnostic::error(
							ANNOTATION,
							"`@\(name)` is written twice",
							annotation.span,
							"written again",
						).withSecondary(first, "written here").withHelp("remove one of them"),
					)
					continue
				}
			}
			seen.push((annotation.name.sym, annotation.span))
			if !knownOne.targets.contains(&target) {
				var places: Vec<str> = Vec()
				for t in knownOne.targets {
					places.push(t.text())
				}
				self.report(
					Diagnostic::error(
						ANNOTATION,
						"`@\(name)` cannot be written on \(target.text())",
						annotation.span,
						"on \(target.text())",
					).withHelp("`@\(name)` belongs on \(oneOfPlaces(&places))"),
				)
				continue
			}
			val argumentsFit = match (knownOne.arguments, annotation.parens) {
				(.None, .Some(parens)) => {
					self.report(
						Diagnostic::error(
							ANNOTATION,
							"`@\(name)` takes no arguments",
							parens,
							"arguments",
						).withFix("remove them", own [Edit::replace(parens, String())]),
					)
					false
				}
				(.Some(takes), .None) if !knownOne.bare => {
					self.report(
						Diagnostic::error(
							ANNOTATION,
							"`@\(name)` takes \(takes)",
							annotation.span,
							"no arguments",
						),
					)
					false
				}
				_ => true
			}
			if !argumentsFit then continue
			match name.toStr() {
				"tailrec" => annotations.tailrec = true
				"intrinsic" => annotations.intrinsic = true
				"inline" => annotations.inline = .Some(annotation.span)
				"test" => annotations.test = .Some((self.testExpects(&annotation), annotation.span))
				// The driver has already read it and dropped what this target
				// does not take; here it is known so that it is not reported as
				// an annotation that is not.
				"target" => {}
				"link" => annotations.link = self.strings(&annotation)
				"header" => annotations.header = self.oneString(&annotation)
				"include" => annotations.include = self.strings(&annotation)
				"framework" => annotations.framework = self.strings(&annotation)
				"source" => {
					val (files, language, standard) = self.sources(&annotation)
					annotations.source = files
					annotations.sourceLanguage = language
					annotations.sourceStandard = standard
				}
				"prefix" => annotations.prefix = self.oneString(&annotation)
				"define" => annotations.define = self.strings(&annotation)
				"symbol" => annotations.symbol = self.oneString(&annotation)
				"opaque" => annotations.opaque = .Some(annotation.span)
				"align" => annotations.align = self.alignment(&annotation)
				"packed" => annotations.packed = .Some(annotation.span)
				"comptime" => annotations.comptime = .Some(annotation.span)
				"derive" => {
					for d in self.derivedOf(&annotation, &annotations.derive) {
						annotations.derive.push(d)
					}
				}
				"export" => annotations.export = self.oneString(&annotation)
				"oneOf" => {
					match self.oneOf(&annotation) {
						.Some(group) => annotations.oneOf.push(group)
						.None => {}
					}
				}
				other => panic("`@\(other)` is known but does nothing")
			}
		}
		return annotations
	}

	/// What `@align(n)` says: `n`, one whole number, a power of two up to
	/// 4096 — an alignment a page holds.
	var fn alignment(annotation: &ast::Annotation): Option<(u32, Span)> = {
		if annotation.args.len() == 1 &&
			annotation.args[0].name.isNone() &&
			annotation.args[0].value is .Int(value) &&
			value >= 1 &&
			value <= 4096 &&
			(value & (value - 1)) == 0 {
			return .Some((value as u32, annotation.span))
		}
		self.report(
			Diagnostic::error(
				ANNOTATION,
				"`@align` takes one alignment in bytes, a power of two up to 4096",
				annotation.span,
				"not an alignment",
			).withNote(
				"an address is a multiple of its alignment, which processors and C ask to be a power of two",
			),
		)
		return .None
	}

	/// The interfaces `@derive` names, each one the compiler can write, and
	/// each once.
	var fn derivedOf(
		annotation: &ast::Annotation,
		earlier: &[(Derived, Span)],
	): Vec<(Derived, Span)> = {
		var derived: Vec<(Derived, Span)> = Vec()
		if annotation.args.isEmpty() then
			self.report(
				Diagnostic::error(
					ANNOTATION,
					"`@derive` names what it writes",
					annotation.span,
					"nothing named",
				).withHelp("write the interfaces, as in `@derive(Eq, Hash)`"),
			)
		for arg in annotation.args {
			val .Name(sym) = arg.value else {
				self.report(
					Diagnostic::error(
						ANNOTATION,
						"`@derive` takes the names of interfaces",
						arg.span,
						"not a name",
					),
				)
				continue
			}
			if arg.name is .Some(written) {
				self.report(
					Diagnostic::error(
						ANNOTATION,
						"`@derive`'s arguments have no names",
						written.span,
						"a named argument",
					),
				)
				continue
			}
			val text = String::of(self.text(sym))
			val .Some(which) = Derived::named(text) else {
				var names: Vec<String> = Vec()
				for d in Derived::all() {
					names.push("`\(d.name())`")
				}
				self.report(
					Diagnostic::error(
						ANNOTATION,
						"the compiler cannot write `\(text)`",
						arg.span,
						"not an interface it writes",
					).withNote("`@derive` writes \(names.join(", ")) from the fields; any other interface is written by hand in an `extend` block"),
				)
				continue
			}
			var first: Option<Span> = .None
			for (d, span) in earlier {
				if first.isNone() && d == which then first = .Some(span)
			}
			for (d, span) in derived {
				if first.isNone() && d == which then first = .Some(span)
			}
			if first is .Some(first) {
				self.report(
					Diagnostic::error(
						ANNOTATION,
						"`\(text)` is named twice",
						arg.span,
						"named again",
					).withSecondary(first, "named here"),
				)
				continue
			}
			derived.push((which, arg.span))
		}
		return derived
	}

	/// What `@test` says its test expects: that it returns, where it is
	/// written alone; that it panics, `@test(panics)`; or that it panics
	/// with a message holding a text, `@test(panics = "out of bounds")`.
	var fn testExpects(annotation: &ast::Annotation): Test = {
		val .Some(parens) = annotation.parens else return .Returns
		val (span, label) = match annotation.args.len() {
			0 => (parens, String::of("nothing given"))
			1 => {
				val arg = &annotation.args[0]
				if arg.name.isNone() && arg.value is .Name(sym) && self.text(sym) == "panics" then
					return .Panics(.None)
				if arg.name is .Some(name) && self.text(name.sym) == "panics" {
					if arg.value is .Str(text) then return .Panics(.Some(text))
					(arg.span, String::of("not a string"))
				} else {
					(arg.span, String::of("not `panics`"))
				}
			}
			count => (annotation.span, "\(count) arguments given")
		}
		self.report(
			Diagnostic::error(
				ANNOTATION,
				"`@test` takes `panics`, or `panics = \"text\"`",
				span,
				label,
			).withNote(
				"`@test(panics)` is a test that must panic, and `@test(panics = \"out of bounds\")` one whose panic's message must hold that text",
			),
		)
		return .Returns
	}

	/// The methods `@oneOf` names, as names; whether the interface has them
	/// is asked once its methods are known.
	var fn oneOf(annotation: &ast::Annotation): Option<OneOf> = {
		var names: Vec<(Symbol, Span)> = Vec()
		for arg in annotation.args {
			if arg.name.isNone() && arg.value is .Name(sym) {
				names.push((sym, arg.span))
				continue
			}
			self.report(
				Diagnostic::error(
					ANNOTATION,
					"`@oneOf` takes the names of the interface's methods",
					arg.span,
					"not a method's name",
				).withHelp("write them as they are declared, as in `@oneOf(toString, appendTo)`"),
			)
			return .None
		}
		return .Some(OneOf(names: names, span: annotation.span))
	}

	/// The one string an annotation was given, where it takes one: reports
	/// anything else, since an annotation that is read wrongly is worse than
	/// one that is not read at all.
	var fn oneString(annotation: &ast::Annotation): Option<(Symbol, Span)> = {
		val name = String::of(self.text(annotation.name.sym))
		if annotation.args.len() != 1 {
			self.report(
				Diagnostic::error(
					ANNOTATION,
					"`@\(name)` takes one argument",
					annotation.span,
					"\(plural(annotation.args.len(), "argument", "arguments")) given",
				),
			)
			return .None
		}
		return self.annotationString(name, &annotation.args[0])
	}

	/// `@source("sokol.h", language = "objective-c")`: the files, each checked
	/// as `strings` checks its strings, the language they are written in, if
	/// it is said, and for C++ the standard, if it is said.
	var fn sources(
		annotation: &ast::Annotation,
	): (Vec<(Symbol, Span)>, Option<CLanguage>, Option<String>) = {
		var language: Option<CLanguage> = .None
		var standard: Option<(String, Span)> = .None
		var files: Vec<(Symbol, Span)> = Vec()
		var wrong = false
		for arg in annotation.args {
			val .Some(name) = arg.name else {
				if self.annotationString("source", &arg) is .Some(file) then files.push(file)
				continue
			}
			val said = self.text(name.sym)
			if said == "standard" && standard.isNone() {
				if arg.value is .Str(text) && cxxStandard(self.text(text)) {
					standard = .Some((String::of(self.text(text)), arg.span))
					continue
				}
				self.report(
					Diagnostic::error(
						ANNOTATION,
						"`standard` is a C++ standard: `\"c++11\"`, `\"c++14\"`, `\"c++17\"`, `\"c++20\"` or `\"c++23\"`",
						arg.span,
						"not a standard it knows",
					),
				)
				wrong = true
				continue
			}
			val named: Option<CLanguage> = match arg.value {
				.Str(text) if said == "language" => match self.text(text) {
					"c" => .Some(.C)
					"objective-c" => .Some(.ObjectiveC)
					"c++" => .Some(.CPlusPlus)
					"objective-c++" => .Some(.ObjectiveCPlusPlus)
					_ => .None
				}
				_ => .None
			}
			match named {
				.Some(named) if language.isNone() => language = .Some(named)
				_ => {
					self.report(
						Diagnostic::error(
							ANNOTATION,
							"`@source` takes files, `language` once — `\"c\"`, `\"objective-c\"`, `\"c++\"` or `\"objective-c++\"` — and for C++ a `standard`",
							arg.span,
							"not a file, nor a language it knows",
						).withNote(
							"a file is compiled as its extension says — `.c` as C, `.m` as Objective-C, `.cpp`, `.cc` and `.cxx` as C++, `.mm` as Objective-C++, `.s` and `.S` as assembly — unless `language` says otherwise, as a header holding a library's implementation needs",
						),
					)
					wrong = true
				}
			}
		}
		if files.isEmpty() && !wrong then
			self.report(
				Diagnostic::error(
					ANNOTATION,
					"`@source` takes one file or more",
					annotation.span,
					"no files given",
				),
			)
		// A standard is C++'s: said of files that are C, or Objective-C, it
		// would be passed over.
		if standard is .Some((_, span)) && language is .Some(.C) | .Some(.ObjectiveC) {
			self.report(
				Diagnostic::error(
					ANNOTATION,
					"`standard` is for C++ files",
					span,
					"the files are not C++",
				).withHelp("say `language = \"c++\"`, or leave `standard` out"),
			)
			return (files, language, .None)
		}
		val chosen: Option<String> = match move standard {
			.Some((text, _)) => .Some(text)
			.None => .None
		}
		return (files, language, chosen)
	}

	/// `@include("src", "include")`: one string or more, each checked as
	/// `oneString` checks its one.
	var fn strings(annotation: &ast::Annotation): Vec<(Symbol, Span)> = {
		val name = String::of(self.text(annotation.name.sym))
		if annotation.args.isEmpty() {
			self.report(
				Diagnostic::error(
					ANNOTATION,
					"`@\(name)` takes one string or more",
					annotation.span,
					"no arguments given",
				),
			)
			return Vec()
		}
		var found: Vec<(Symbol, Span)> = Vec()
		for arg in annotation.args {
			if self.annotationString(name, &arg) is .Some(s) then found.push(s)
		}
		return found
	}

	/// One argument of `@name(…)` that must be a string, not named and not
	/// empty.
	var fn annotationString(name: str, arg: &ast::AnnotationArg): Option<(Symbol, Span)> = {
		if arg.name is .Some(written) {
			self.report(
				Diagnostic::error(
					ANNOTATION,
					"`@\(name)`'s argument has no name",
					written.span,
					"a named argument",
				),
			)
			return .None
		}
		val .Str(text) = arg.value else {
			self.report(
				Diagnostic::error(
					ANNOTATION,
					"`@\(name)` takes a string",
					arg.span,
					"not a string",
				),
			)
			return .None
		}
		if self.text(text).isEmpty() {
			self.report(
				Diagnostic::error(
					ANNOTATION,
					"`@\(name)` needs a name",
					arg.span,
					"an empty string",
				),
			)
			return .None
		}
		return .Some((text, arg.span))
	}
}

/// `a`, `a or b`, `a, b or c`: the places an annotation may be written.
fn oneOfPlaces(places: &[str]): String = {
	if places.isEmpty() then return String()
	if places.len() == 1 then return places[0]
	var rest: Vec<str> = Vec()
	for i in 0..places.len() - 1 {
		rest.push(places[i])
	}
	return "\(rest.join(", ")) or \(places[places.len() - 1])"
}

/// Whether `text` names a C++ standard a module's C++ may be compiled to.
fn cxxStandard(text: str): bool = text is "c++11" | "c++14" | "c++17" | "c++20" | "c++23"
