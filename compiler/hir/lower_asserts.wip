// Top-level `assert`s: facts the program relies on, checked while it is
// compiled. Each is checked as any `assert` is, in a body of its own, which
// becomes a function the compiler runs once the program is checked, as it
// runs a `@comptime` constant's; a condition that does not hold is a compile
// error there. A generic's signature may say such facts of its type and
// length parameters: each is a function of those parameters, made and run
// for each instance a call makes.

import std::collections::{Map}
import std::mem
import syntax as ast
import syntax::{Diagnostic, SIGNATURE_ASSERT, Span, Symbol}

extend Lowerer {
	/// Checks the file's top-level asserts, and keeps each as the function
	/// that checks it.
	var fn checkAsserts() = {
		val file = self.ast
		for item in file.items {
			val .Assert(decl) = item else continue
			self.annotations(&decl.annotations, .Assert)
			self.outer.push(mem::replace(&var self.state, BodyState()))
			self.state.scopes = [Map()]
			self.checkingAssert = true
			val root = self.check(decl.assertion, UNIT)
			self.checkingAssert = false
			var body = mem::replace(&var self.state.body, Body())
			body.value = root
			self.state = self.outer.pop().unwrap()
			val id = self.program.fns.add(FnDef(
				name: Symbol::assertion(),
				nameSpan: decl.span,
				symbol: .None,
				receiver: .None,
				owner: .None,
				interfaceId: .None,
				generics: Vec(),
				instanceOf: .None,
				params: Vec(),
				ret: UNIT,
				retSpan: .None,
				isExtern: false,
				exportsC: false,
				header: .None,
				accesses: .None,
				isVariadic: false,
				variadicOf: .None,
				lendsFrom: .None,
				keeps: Vec(),
				keepsAt: .None,
				isLambda: false,
				generator: .None,
				isTailrec: false,
				test: .None,
				isInline: false,
				generated: .None,
				intrinsic: .None,
				body:,
				projects: .None,
				compileTime: true,
				module: self.current as u32,
				isPub: false,
				span: decl.span,
			))
			self.program.asserts.push(id)
		}
	}
}

extend Lowerer {
	/// The `assert`s of a function's signature, each declared as a function
	/// the compiler runs, with the function's type and length parameters and
	/// none of its values, and its condition left to be checked as a body is.
	/// A function with no type or length parameter has nothing for them to
	/// ask, and is told to say its facts at the top level.
	var fn declareSignatureAsserts(sig: &ast::FnSig, id: FnId, bodies: &var Vec<BodyWork>) = {
		if sig.asserts.isEmpty() then
			return

		val file = self.ast
		if self.program.fns[id].generics.isEmpty() {
			for a in sig.asserts do
				self.report(
					Diagnostic::error(
						SIGNATURE_ASSERT,
						"an `assert` in a signature asks something of type or length parameters, and this function has none",
						file.exprs[a].span,
						"nothing to check for each call",
					).withHelp(
						"a fact that is the same at every call is a top-level `assert`, checked once",
					),
				)

			return
		}
		var asserts: Vec<FnId> = Vec()
		for a in sig.asserts {
			val span = file.exprs[a].span
			val assertion = self.signatureAssert(id, span)
			asserts.push(assertion)
			bodies.push(BodyWork(body: a, id: assertion, span:))
		}
		self.program.fns[id].asserts = asserts
	}

	/// The function that checks one `assert` of `id`'s signature: `id`'s type
	/// parameters, and its type's, with no value parameters, run while the
	/// program is compiled.
	var fn signatureAssert(id: FnId, span: Span): FnId = {
		val generics = self.program.fns[id].generics.clone()
		val owner = self.program.fns[id].owner
		return self.program.fns.add(FnDef(
			name: Symbol::assertion(),
			nameSpan: span,
			symbol: .None,
			receiver: .None,
			owner:,
			interfaceId: .None,
			generics:,
			instanceOf: .None,
			params: Vec(),
			ret: UNIT,
			retSpan: .None,
			isExtern: false,
			exportsC: false,
			header: .None,
			accesses: .None,
			isVariadic: false,
			variadicOf: .None,
			lendsFrom: .None,
			keeps: Vec(),
			keepsAt: .None,
			isLambda: false,
			generator: .None,
			isTailrec: false,
			test: .None,
			isInline: false,
			generated: .None,
			intrinsic: .None,
			body: .None,
			projects: .None,
			compileTime: true,
			assertOf: id,
			module: self.current as u32,
			isPub: false,
			span:,
		))
	}

	/// Where a name not found in a signature's `assert` is one of the
	/// function's value parameters, which it cannot read: known only when the
	/// call runs.
	fn valueInSignatureAssert(sym: Symbol, span: Span): Option<Diagnostic> = {
		val .Some(function) = self.state.function else return .None
		val .Some(generic) = self.program.fns[function].assertOf else return .None
		for param in self.program.fns[generic].params {
			if param.name != sym then
				continue

			return Diagnostic::error(
				SIGNATURE_ASSERT,
				"`\(self.text(sym))` is a value, which an `assert` in a signature cannot read",
				span,
				"known only when the call runs",
			).withNote(
				"a signature's `assert` is checked while the program is compiled, for each instance a call makes: it reads the type and length parameters, constants, and what runs while compiling",
			)
		}
		return .None
	}

	/// Refuses the `assert`s of a signature that has no instances of its own
	/// to check them for: `whose` says whose signature it is.
	var fn noSignatureAsserts(sig: &ast::FnSig, whose: str) = {
		val file = self.ast
		for a in sig.asserts do
			self.report(
				Diagnostic::error(
					SIGNATURE_ASSERT,
					"\(whose) signature cannot have an `assert`",
					file.exprs[a].span,
					"not checked here",
				).withNote(
					"a signature's `assert` is checked for each instance of a generic function or method a call makes",
				),
			)
	}
}
