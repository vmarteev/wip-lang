// `expr?`: the value, or an early return of the other variant.
//
// It lowers to what a reader would write: a `match` whose first arm takes the
// value and whose second returns, so the move checker, the MIR and code
// generation see nothing new. In a lambda whose result is not known yet,
// what the second arm returns waits for the first `return`, or the body's
// value, to say it, and is checked then.

import std::collections::{Map}
import std::mem
import syntax as ast
import syntax::{CANNOT_PROPAGATE, Diagnostic, Span}

/// The `expr?` being lowered: the enum it is of, its value, and how the arms
/// bind that value's fields.
@derive(Clone)
struct Tried {
	id: EnumId
	ty: Ty
	/// Where the value is a place, the kind of reference its bindings are:
	/// aliases for its fields.
	alias: Option<RefKind>
	scrutinee: ExprId
	span: Span
}

/// A `?` met in a lambda whose result was not known yet: the type it is
/// on, and the value its second arm returns, whose type is the result's
/// once that is said, and whose error is converted then where it must be.
@derive(Clone)
struct PendingTry {
	ty: Ty
	id: EnumId
	kind: Propagated
	returned: ExprId
	span: Span
}

/// What a `?` returns from, for its message: a function, or a lambda, with
/// where its result was said where something said it.
@derive(Clone)
enum ReturnsFrom {
	Function
	Lambda(said: Option<Span>)
}

/// The two types `?` knows.
@derive(Eq, Clone)
enum Propagated {
	Option
	Result
}

extend Lowerer {
	var fn tryExpr(value: ast::ExprId, hint: Option<Ty>, span: Span): ExprId = {
		// What is expected of the value taken out is what the call under the
		// `?` holds, where its own arguments do not say.
		if hint is .Some(h) && h != UNIT && !self.isPoisoned(h) then
			self.state.wanted.put(value, Wanted::Propagated(ty: h))
		val inferred = self.infer(value, .None)
		self.state.wanted.remove(&value)
		val ty = self.tyOf(inferred)
		if self.isPoisoned(ty) then return self.errorExpr(span)
		val .Enum(id, args) = self.kind(ty) else {
			val diagnostic = self.notPropagatable(ty, span)
			self.report(diagnostic)
			return self.errorExpr(span)
		}
		val .Some(kind) = self.propagatedEnum(id) else {
			val diagnostic = self.notPropagatable(ty, span)
			self.report(diagnostic)
			return self.errorExpr(span)
		}
		// The function must return the same one, with the same error type,
		// or one that says how it is made from this one; a lambda whose
		// result is not known yet is held to it once the result is said.
		val waits = self.state.inferringRet
		val ret = if waits then ty else self.state.ret
		var conversion: Option<FnId> = .None
		if !waits {
			match self.resultFits(ty, ret, id, kind) {
				.Some(from) => conversion = from
				.None => {
					val from = if self.state.lambda then ReturnsFrom::Lambda(.None) else .Function
					val diagnostic = self.wrongResult(ty, ret, kind, span, from)
					self.report(diagnostic)
					return self.errorExpr(span)
				}
			}
		}
		// `.Some` is the first variant, `.None` the second; `.Ok` and `.Err`
		// likewise.
		val taken = 0
		val other = 1
		// A value that owns memory is taken; plain data is read where it is, as
		// a `match` on a place does.
		val scrutinee = if self.state.body.isPlace(inferred) && self.owns(ty) {
			val at = self.state.body.exprs[inferred].span
			self.alloc(.Move(inferred), ty, at)
		} else inferred
		val tried = Tried(
			id: id,
			ty: ty,
			alias: self.aliasKind(scrutinee),
			scrutinee: scrutinee,
			span: span,
		)
		// The arm that takes the value.
		val valueTy = self.program.variantFieldTy(ty, taken, 0)
		// The arms' bindings are named as the variants' fields are — `value`,
		// `error` — in a scope of their own, so that they do not hide a
		// program's own `value` after the `?`.
		self.state.scopes.push(Map())
		val (local, body) = self.fieldBinding(&tried, taken)
		val takenArm = Arm(
			pattern: .Variant(variant: taken, binders: [Binder::Bind(local)]),
			guard: .None,
			body: body,
			span: span,
		)
		// The arm that returns what was not taken.
		val (otherArm, returned) = self.returningArm(&tried, other, ret)
		if conversion is .Some(from) then self.convertReturned(returned, from)
		if waits then
			self.state.pendingTries.push(PendingTry(
				ty: ty,
				id: id,
				kind: kind,
				returned: returned,
				span: span,
			))
		self.state.scopes.pop()
		return self.alloc(.Match(scrutinee: scrutinee, arms: [takenArm, otherArm]), valueTy, span)
	}

	/// Whether a `?` on `ty` fits a function that returns `ret`: nothing
	/// where it does not; where it does, the `from` that makes the error the
	/// function returns from this one, where they differ.
	var fn resultFits(ty: Ty, ret: Ty, id: EnumId, kind: Propagated): Option<Option<FnId>> = {
		val .Enum(args, ..) = self.kind(ty) else return .None
		val same = match self.kind(ret) {
			.Enum(id: retId, args: retArgs) if retId == id => match kind {
				.Option => true
				.Result =>
					secondArg(&self.program.types, args) == secondArg(&self.program.types, retArgs)
			}
			_ => false
		}
		if same then return .Some(.None)
		// Where the error types differ, the function's error type may say how
		// it is made from this one.
		if kind != .Result then return .None
		return .Some(.Some(self.errorConversion(ty, ret, id)?))
	}

	/// The `?`s that waited for the lambda's result, now that it is said,
	/// at `said` where something said it: each one's returned value takes
	/// the result's type, and its error is converted where it must be, or
	/// the `?` is refused.
	var fn settlePendingTries(said: Option<Span>) = {
		val pending = mem::replace(&var self.state.pendingTries, Vec())
		val ret = self.state.ret
		for waiting in pending {
			match self.resultFits(waiting.ty, ret, waiting.id, waiting.kind) {
				.Some(conversion) => {
					self.state.body.exprs[waiting.returned].ty = ret
					if conversion is .Some(from) then self.convertReturned(waiting.returned, from)
				}
				.None => {
					val diagnostic = self.wrongResult(
						waiting.ty,
						ret,
						waiting.kind,
						waiting.span,
						.Lambda(said),
					)
					self.report(diagnostic)
				}
			}
		}
	}

	/// `extend TheirError: From<ThisError>`: the error the returning arm's
	/// `returned` holds made into the one the function returns, by `from`.
	var fn convertReturned(returned: ExprId, from: FnId) = {
		val span = self.state.body.exprs[returned].span
		val made = self.program.fns[from].ret
		var kind = self.state.body.exprs[returned].kind.clone()
		match kind {
			.Variant(args, ..) => {
				val error = args[0]
				args[0] = self.alloc(
					.Call(callee: from, args: [error], typeArgs: TyList::empty(), order: Vec()),
					made,
					span,
				)
			}
			_ => return
		}
		self.state.body.exprs[returned].kind = kind
	}

	/// The arm that returns `ret`: `.None` as it is, and `.Err(error)` with
	/// the error it was given; and the value it returns.
	var fn returningArm(tried: &Tried, variant: u32, ret: Ty): (Arm, ExprId) = {
		val id = tried.id
		val span = tried.span
		val fields = self.program.enums[id].variants[variant].fields.len()
		var binders: Vec<Binder> = Vec()
		var args: Vec<ExprId> = Vec()
		if fields != 0 {
			val (local, read) = self.fieldBinding(&tried, variant)
			// The error `?` returns is the one it was given, passed on.
			self.state.body.errorBindings.add(local)
			binders.push(.Bind(local))
			args.push(read)
		}
		val returned = self.alloc(
			.Variant(id: id, variant: variant, args: args, order: Vec()),
			ret,
			span,
		)
		// `return` is a statement, so the arm is a block of one.
		val stmt = self.state.body.stmts.add(Stmt(kind: .Return(.Some(returned)), span: span))
		val body = self.alloc(.Block(Block(stmts: [stmt], value: .None, span: span)), NEVER, span)
		val arm = Arm(
			pattern: .Variant(variant: variant, binders: binders),
			guard: .None,
			body: body,
			span: span,
		)
		return (arm, returned)
	}

	/// The binding of a variant's one field, `value` or `error`, and the value
	/// read from it.
	var fn fieldBinding(tried: &Tried, variant: u32): (LocalId, ExprId) = {
		val span = tried.span
		val fieldTy = self.program.variantFieldTy(tried.ty, variant, 0)
		val boundTy = match tried.alias {
			.Some(kind) => self.intern(.Ref(inner: fieldTy, kind: kind))
			.None => fieldTy
		}
		val name = self.program.enums[tried.id].variants[variant as i64].fields[0].name
		val local = self.declare(name, boundTy, .Binding, span)
		if tried.alias.isSome() {
			self.state.body.aliases.put(local, tried.scrutinee)
			self.state.body.aliasBindings.add(local)
		}
		var value = self.alloc(.Local(local), boundTy, span)
		// An alias is read through, as a `match` binding is; a field that is
		// itself a reference, `Option<&Json>`'s, is the value, and copied as a
		// view is.
		if tried.alias.isSome() then value = self.alloc(.Deref(value), fieldTy, span) else if self.owns(
			boundTy,
		) {
			// The binding owns its field, which is taken from it.
			value = self.alloc(.Move(value), boundTy, span)
		}
		return (local, value)
	}

	/// The error type of a `Result`, which is its second type argument.
	fn errorOf(ty: Ty): Option<Ty> = {
		val .Enum(id, args) = self.kind(ty) else return .None
		if self.propagatedEnum(id) != .Some(.Result) then return .None
		return secondArg(&self.program.types, args)
	}

	/// The `from` of `extend TheirError: From<ThisError>`, where the function
	/// returns a `Result` whose error type says how it is made from this one.
	var fn errorConversion(ty: Ty, ret: Ty, result: EnumId): Option<FnId> = {
		val interfaceId = self.program.preludeItems.interfaceOf(.From)?
		val .Enum(id: retId, args: retArgs) = self.kind(ret) else return .None
		if retId != result then return .None
		val .Enum(args, ..) = self.kind(ty) else return .None
		val source = secondArg(&self.program.types, args)?
		val target = secondArg(&self.program.types, retArgs)?
		val owner = self.ownerOf(target)?
		val wanted = self.program.types.internList([source])
		var method: Option<FnId> = .None
		for i in self.program.impls {
			if i.interfaceId == interfaceId && i.ty == owner && i.args == wanted {
				if i.methods.isEmpty() then return .None
				method = .Some(i.methods[0])
				break
			}
		}
		val found = method?
		// The conversion is the interface's one method, and an implementation
		// that only has the interface's default would convert nothing.
		return if self.program.fns[found].body.isSome() then .Some(found) else .None
	}

	/// Which of the prelude's two types an enum is, if it is one.
	fn propagatedEnum(id: EnumId): Option<Propagated> = {
		val prelude = self.prelude?
		val name = self.program.enums[id].name
		val declared = match self.modules[prelude].types.get(&name) {
			.Some((def, _)) => def == .Enum(id)
			.None => false
		}
		if !declared then return .None
		if self.text(name) == "Option" then return .Some(.Option)
		if self.text(name) == "Result" then return .Some(.Result)
		return .None
	}

	fn notPropagatable(ty: Ty, span: Span): Diagnostic = Diagnostic::error(
		CANNOT_PROPAGATE,
		"`?` needs an `Option` or a `Result`, and this is \(self.tyName(ty))",
		span,
		"not an `Option` or a `Result`",
	).withNote("`?` takes the value, or returns the other variant to the caller")

	fn wrongResult(ty: Ty, ret: Ty, kind: Propagated, span: Span, from: ReturnsFrom): Diagnostic = {
		val value = self.tyName(ty)
		val result = self.tyName(ret)
		val diagnostic = match from {
			.Function => Diagnostic::error(
				CANNOT_PROPAGATE,
				"`?` on \(value) needs the function to return one too",
				span,
				"this function returns \(result)",
			)
			.Lambda(said) => {
				val answers =
					if ret == UNIT then String::of("this lambda answers nothing")
					else "this lambda answers \(result)"
				match said {
					.Some(at) if ret != UNIT => Diagnostic::error(
						CANNOT_PROPAGATE,
						"`?` on \(value) needs the lambda to answer one too",
						span,
						"returns from the lambda",
					).withSecondary(at, answers)
					_ => Diagnostic::error(
						CANNOT_PROPAGATE,
						"`?` on \(value) needs the lambda to answer one too",
						span,
						answers,
					)
				}
			}
		}
		return match kind {
			.Result => {
				// Where the two error types are known, the help names the
				// implementation that would bridge them. The names go inside an
				// `extend` the help writes out, so they are written plainly.
				val help = match (self.errorOf(ty), self.errorOf(ret)) {
					(.Some(source), .Some(target)) => {
						val sourceName = self.tyName(source)
						val targetName = self.tyName(target)
						"write `extend \(targetName.toStr().trimMatches("`")): From<\(sourceName.toStr().trimMatches("`"))>`, and `?` will use it; or convert it here with `mapErr`"
					}
					_ => "convert it first, with `mapErr`"
				}
				diagnostic.withNote(
					if from is .Lambda(..) then
						"`?` returns the error as it is, unless the lambda's error type says how it is made from this one"
					else "`?` returns the error as it is, unless the function's error type says how it is made from this one",
				).withHelp(help)
			}
			.Option => diagnostic.withNote(
				if from is .Lambda(..) then
					"`?` on an `Option` returns `.None`, so the lambda must answer an `Option`"
				else "`?` on an `Option` returns `.None`, so the function must return an `Option`",
			)
		}
	}
}

/// The second of a list of types, where it has one.
fn secondArg(types: &Types, args: TyList): Option<Ty> = {
	val list = types.list(args)
	return if list.len() > 1 then .Some(list[1]) else .None
}
