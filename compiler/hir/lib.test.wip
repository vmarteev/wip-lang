// What an implementation's type arguments match.

import syntax::{Interner}

/// A type parameter, the `index`th of its item's.
fn param(types: &var Types, interner: &var Interner, index: u32, name: str): Ty = types.intern(
	.Param(TyParam(index: index, name: interner.intern(name), copy: false)),
)

/// `extend Vec<T>: Items<T>` answers `Items<Card>` for a `Vec<Card>`, and
/// not `Items<i64>`.
@test
fn aParameterIsReadAsTheTypesArgument() = {
	var types = Types::new()
	var interner = Interner::new()
	val t = param(&var types, &var interner, 0, "T")
	val declared = types.internList([t])
	val card = F64
	assert(argsMatchWith(&types, declared, [card], [card]))
	assert(!argsMatchWith(&types, declared, [card], [I64]))
}

/// An argument written out is compared as it is.
@test
fn anArgumentWrittenOutMustBeTheOneAskedFor() = {
	var types = Types::new()
	val declared = types.internList([I64])
	val none: [Ty; 0] = []
	assert(argsMatchWith(&types, declared, &none, [I64]))
	assert(!argsMatchWith(&types, declared, &none, [F64]))
	assert(!argsMatchWith(&types, declared, &none, &none), "one argument, not none")
}

/// An argument made of the type's parameters — `Iterator<(T, V)>` of
/// `Zipped<I, T, J, V>` — is read with them before it is compared. It was
/// once compared as written, which matched only a bare parameter and made
/// `zip(…).count()` say a zipped iterator was not one.
@test
fn anArgumentMadeOfParametersIsReadWithThem() = {
	var types = Types::new()
	var interner = Interner::new()
	var params: Vec<Ty> = Vec()
	val names = ["I", "T", "J", "V"]
	for (i, name) in names.forwards().enumerate() {
		params.push(param(&var types, &var interner, i as u32, name))
	}
	val ofT = types.intern(.Slice(params[1]))
	val declared = types.internList([ofT])
	val owner = [UNIT, I64, UNIT, F64]
	val ofI64 = types.intern(.Slice(I64))
	val ofF64 = types.intern(.Slice(F64))
	assert(argsMatchWith(&types, declared, &owner, [ofI64]))
	assert(!argsMatchWith(&types, declared, &owner, [ofF64]))
}
