// A local whose value leaves some of its type arguments undecided, given
// them by the first place after it that names it: `var shapes = Vec()`, then
// `shapes.push(move shape)`. The value is checked again then, as if its type
// had been written. So is a local whose value is a number literal, which
// takes the type the literal would take where the local is first named:
// `var sum = 0.0`, then `sum += sample`, of an `f32`; where that place says
// none, it is the literal's own, `i64` or `f64`.

import std::collections::{Map}
import std::mem
import syntax as ast
import syntax::{CANNOT_INFER, Diagnostic, Edit, Span, Symbol}

/// A local waiting for its first use to say its type.
struct PendingLocal {
	/// The value, checked again once the type is known.
	init: ast::ExprId
	/// The names in scope where it was declared, among which the value is
	/// checked again.
	scopes: Vec<Map<Symbol, LocalId>>
	/// The `val` or `var` that declares it, whose value is replaced then.
	stmt: Option<StmtId>
	/// What stands for the value until then.
	standIn: ExprId
	name: ast::Name
	mutable: bool
	/// Whether its value is a number literal, whose own type it has until
	/// its first use says another.
	literal: bool = false
	/// Whether a literal's first use has been, and decided its type. Its
	/// value is checked against it where its scope ends, so that deciding
	/// adds nothing that checking another local's value could take back.
	decided: bool = false
}

/// A number literal that kept its own type: where its first use was, which
/// said nothing of it, and how it was declared.
struct KeptOwn {
	firstUse: Span
	name: ast::Name
	mutable: bool
}

/// How much checking a value had added, to undo it.
struct CheckMark {
	exprs: i64
	locals: i64
	stmts: i64
	fns: i64
	diagnostics: i64
	unsettled: i64
	pending: i64
	constraints: i64
	copies: i64
}

extend Lowerer {
	fn checkMark(): CheckMark = CheckMark(
		exprs: self.state.body.exprs.len(),
		locals: self.state.body.locals.len(),
		stmts: self.state.body.stmts.len(),
		fns: self.program.fns.len(),
		diagnostics: self.diagnostics.len(),
		unsettled: self.state.unsettledDefaults.len(),
		pending: self.state.pendingLocals.len(),
		constraints: self.pendingConstraints.len(),
		copies: self.pendingCopy.len(),
	)

	/// Whether a local's value, checked since `mark`, leaves type arguments
	/// that its first use may decide: its type holds what could not be
	/// inferred, that is all that went wrong, and checking it added nothing
	/// but expressions, which can be taken back. A value that is the first
	/// use of another local waiting for its type is checked once: that use
	/// decided it, or said why not.
	fn leavesTypeOpen(mark: &CheckMark, value: ExprId): bool = {
		if !self.hasError(self.tyOf(value)) then return false
		if self.state.body.locals.len() != mark.locals ||
			self.state.body.stmts.len() != mark.stmts ||
			self.program.fns.len() != mark.fns ||
			self.state.unsettledDefaults.len() != mark.unsettled ||
			self.state.pendingLocals.len() != mark.pending {
			return false
		}
		var inferring = false
		for i in mark.diagnostics..self.diagnostics.len() {
			if self.diagnostics[i].code == CANNOT_INFER then inferring = true
			else if self.diagnostics[i].isError() then return false
		}
		return inferring
	}

	/// Whether a local's value, checked since `mark`, is a number literal that
	/// waits for its first use to say its type: a literal, or an `if`, a
	/// `match` or a block of them, which checking added nothing to but
	/// expressions, and of no error.
	fn waitsAsLiteral(init: ast::ExprId, mark: &CheckMark, value: ExprId): bool = {
		if !self.numberShaped(init) || !self.program.types.isNumeric(self.tyOf(value)) then
			return false
		return self.state.body.locals.len() == mark.locals &&
			self.state.body.stmts.len() == mark.stmts &&
			self.program.fns.len() == mark.fns &&
			self.state.unsettledDefaults.len() == mark.unsettled &&
			self.state.pendingLocals.len() == mark.pending &&
			self.diagnostics.len() == mark.diagnostics
	}

	/// Whether `e` is a number literal, negated or in parentheses, or an
	/// `if`, a `match` or a block all of whose values are.
	fn numberShaped(e: ast::ExprId): bool = {
		val file = self.ast
		return match file.exprs[e].kind {
			.Int(..) | .Float(..) => true
			.Unary(op: .Neg, operand, ..) | .Paren(inner: operand) => self.numberShaped(operand)
			.If(thenBlock, elseBranch, ..) => match elseBranch {
				.Some(other) => self.blockNumberShaped(&thenBlock) && self.numberShaped(other)
				.None => false
			}
			.Block(block) => self.blockNumberShaped(&block)
			.Match(arms, ..) => {
				for arm in arms {
					if !self.numberShaped(arm.body) then return false
				}
				!arms.isEmpty()
			}
			_ => false
		}
	}

	fn blockNumberShaped(block: &ast::Block): bool = match blockValue(self.ast, &block) {
		.Some(value) => self.numberShaped(value)
		.None => false
	}

	/// Takes back what checking `value` added since `mark`, and answers what
	/// stands for it until its local's first use: an error of what is known
	/// of its type. The expressions it added are the arena's last.
	var fn standIn(mark: &CheckMark, value: ExprId): ExprId = {
		val ty = self.tyOf(value)
		val span = self.state.body.exprs[value].span
		self.state.body.exprs.truncate(mark.exprs)
		self.diagnostics.truncate(mark.diagnostics)
		self.pendingConstraints.truncate(mark.constraints)
		self.pendingCopy.truncate(mark.copies)
		return self.alloc(.Error, ty, span)
	}

	/// The local `e` names, where it waits for its type.
	fn waitingLocal(e: ast::ExprId): Option<LocalId> = {
		if self.state.pendingLocals.isEmpty() then return .None
		val .Name(sym) = self.ast.exprs[e].kind else return .None
		val local = self.lookup(sym)?
		return match self.state.pendingLocals.get(&local) {
			.Some(pending) if !pending.decided => .Some(local)
			_ => .None
		}
	}

	/// The local `e` names, where it is a number literal waiting for its
	/// type.
	fn waitingLiteral(e: ast::ExprId): Option<LocalId> = {
		val local = self.waitingLocal(e)?
		return if self.state.pendingLocals.at(&local).literal then .Some(local) else .None
	}

	/// The first use of a local that is a number literal, where `found` is
	/// the type the use says, if any. It takes that type where its literal
	/// would: a type of the literal's kind, integer or float, where the
	/// literal's own would not do — not where its own widens to the type
	/// expected, `into`, nor where a value of the type found widens to its
	/// own, `from`, which compile as they are. Otherwise it keeps its own.
	var fn decideLiteral(local: LocalId, found: Option<Ty>, into: bool, from: bool, at: Span) = {
		val .Some(pending) = self.state.pendingLocals.get(&local) else return
		if pending.decided then return
		val standIn = pending.standIn
		val kept = KeptOwn(firstUse: at, name: pending.name, mutable: pending.mutable)
		val itsOwn = self.state.body.locals[local].ty
		val types = &self.program.types
		val ty: Option<Ty> = match found {
			.Some(t) if t != itsOwn &&
				types.isNumeric(t) &&
				types.isInteger(t) == types.isInteger(itsOwn) &&
				!(into && types.widens(itsOwn, t)) &&
				!(from && types.widens(t, itsOwn)) => .Some(t)
			_ => .None
		}
		if ty is .Some(t) {
			self.state.body.locals[local].ty = t
			self.state.body.exprs[standIn].ty = t
		} else self.state.keptOwn.put(local, kept)
		self.state.pendingLocals.at(&local).decided = true
	}

	/// `diagnostic`, about `e` where a number of type `wanted` is: where `e`
	/// is a number literal's local that kept its own type, why, and how to
	/// say the type.
	fn withKeptOwn(diagnostic: Diagnostic, e: ExprId, wanted: Ty): Diagnostic = {
		val .Local(local) = self.state.body.exprs[e].kind else return diagnostic
		val .Some(kept) = self.state.keptOwn.get(&local) else return diagnostic
		val types = &self.program.types
		val itsOwn = self.state.body.locals[local].ty
		if !types.isNumeric(wanted) || types.isInteger(wanted) != types.isInteger(itsOwn) then
			return diagnostic
		val name = self.text(kept.name.sym)
		val keyword = if kept.mutable then "var" else "val"
		val said =
			if kept.firstUse == self.state.body.exprs[e].span then diagnostic
			else diagnostic.withSecondary(
				kept.firstUse,
				"its first use, which says nothing of its type",
			)
		return said.withNote("`\(name)` is \(self.tyName(itsOwn)), its literal's own: a variable of a number literal takes its type from its first use, where that says one").withHelp("write it where `\(name)` is declared: `\(keyword) \(name): \(self.program.tyName(wanted, self.interner)) = …`")
	}

	/// The first use of a local that is a number literal, as an operand
	/// beside `other`, where a literal would take `wanted`: that, unless the
	/// other is a constant, which takes its type from beside it as the
	/// literal does.
	var fn decideBeside(local: LocalId, other: ExprId, wanted: Ty, span: Span) = {
		val found: Option<Ty> = if self.constantShaped(other) then .None else .Some(wanted)
		self.decideLiteral(local, found, into: true, from: true, at: span)
	}

	/// The first use of a local waiting for its type, where `found` is the
	/// type the use gives it, `ERROR` where a type argument is not said. The
	/// value is checked again as one of that type, among the names it was
	/// declared among; where the use says too little, it is E0315 here.
	var fn decide(local: LocalId, found: Ty, span: Span) = {
		val .Some(pending) = self.state.pendingLocals.remove(&local) else return
		val known = self.state.body.locals[local].ty
		val ty = match self.filled(known, found) {
			.Some(filled) => self.defaultsFilled(filled)
			.None => known
		}
		if self.hasError(ty) {
			self.report(self.notKnownHere(&pending, ty, span))
			return
		}
		self.recheck(local, pending, .Some(ty))
	}

	/// Checks a waiting local's value again, against `ty` or as it is, and
	/// puts it in the `val` or `var` in place of what stood for it.
	var fn recheck(local: LocalId, pending: PendingLocal, ty: Option<Ty>) = {
		val scopes = mem::replace(&var self.state.scopes, pending.scopes)
		val value = match ty {
			.Some(t) => self.check(pending.init, t)
			.None => self.infer(pending.init, .None)
		}
		self.state.scopes = scopes
		self.state.body.locals[local].ty = self.tyOf(value)
		if pending.stmt is .Some(stmt) then
			self.state.body.stmts[stmt].kind = .Let(local: local, init: value)
		// What stood for it is no longer anyone's, and covers no text.
		val at = self.state.body.exprs[pending.standIn].span.lo
		self.state.body.exprs[pending.standIn].span = Span::new(at, at)
	}

	/// The locals declared in the scope about to end and never used: their
	/// values are checked as they are, which says what is missing where they
	/// are declared.
	var fn settleScope() = {
		var ending: Vec<LocalId> = Vec()
		val depth = self.state.scopes.len()
		for entry in self.state.pendingLocals {
			if entry.value.scopes.len() == depth then ending.push(entry.key)
		}
		for local in ending {
			val pending = self.state.pendingLocals.remove(&local).unwrap()
			// A number literal is checked against the type its first use
			// decided, or its own.
			val ty: Option<Ty> =
				if pending.literal then .Some(self.state.body.locals[local].ty) else .None
			self.recheck(local, pending, ty)
		}
	}

	/// What a use says of a waiting local's type, `found`, laid over what its
	/// value said, `known`: nothing where the two are different types.
	var fn filled(known: Ty, found: Ty): Option<Ty> = {
		if known == ERROR then return .Some(found)
		if !self.hasError(known) then return .Some(known)
		return match (self.kind(known), self.kind(found)) {
			(.Struct(id: a, args: x), .Struct(id: b, args: y)) if a == b => {
				val args = self.filledArgs(x, y)?
				Option::Some(self.intern(.Struct(id: a, args: args)))
			}
			(.Enum(id: a, args: x), .Enum(id: b, args: y)) if a == b => {
				val args = self.filledArgs(x, y)?
				Option::Some(self.intern(.Enum(id: a, args: args)))
			}
			_ => .None
		}
	}

	var fn filledArgs(known: TyList, found: TyList): Option<TyList> = {
		val knownArgs = self.program.types.list(known).toVec()
		val foundArgs = self.program.types.list(found).toVec()
		var args: Vec<Ty> = Vec()
		for i in 0..knownArgs.len() {
			args.push(self.filled(knownArgs[i], foundArgs[i])?)
		}
		return .Some(self.program.types.internList(&args))
	}

	/// `ty`, with each of its own type arguments still unknown given its
	/// default, where it has one and the arguments it names are known:
	/// `Pool<i64, …>` is a `Pool<i64, i64>`.
	var fn defaultsFilled(ty: Ty): Ty = {
		val (def, list) = match self.kind(ty) {
			.Struct(id, args) => (TypeDef::Struct(id), args)
			.Enum(id, args) => (TypeDef::Enum(id), args)
			_ => return ty
		}
		val generics = self.typeGenerics(def)
		var solution: Vec<Option<Ty>> = Vec()
		for arg in self.program.types.list(list) {
			solution.push(if arg == ERROR then .None else .Some(arg))
		}
		if solution.len() != generics.len() then return ty
		for i in 0..generics.len() {
			if solution[i].isSome() then continue
			if generics[i].default is .Ty(default) && self.resolved(default, &solution) {
				val args = solved(&solution)
				solution[i] = .Some(self.program.types.subst(default, &args))
			}
		}
		val tys = solved(&solution)
		val args = self.program.types.internList(&tys)
		return match def {
			.Struct(id) => self.intern(.Struct(id: id, args: args))
			.Enum(id) => self.intern(.Enum(id: id, args: args))
			_ => ty
		}
	}

	/// E0315 at the first use of a local that says too little of its type.
	fn notKnownHere(pending: &PendingLocal, known: Ty, span: Span): Diagnostic = {
		val name = self.text(pending.name.sym)
		val holes = self.holeNames(known)
		val keyword = if pending.mutable then "var" else "val"
		val said = if holes.isEmpty() then String::of("its type") else "`\(holes.join("` or `"))`"
		val diagnostic = Diagnostic::error(
			CANNOT_INFER,
			"the type of `\(name)` is not known here",
			span,
			"says nothing of \(said)",
		).withSecondary(pending.name.span, "declared without its type")
			.withHelp("write it where `\(name)` is declared: `\(keyword) \(name): \(self.holeText(known)) = …`")
			.withNote(
				"a variable whose value leaves its type open takes it from the first place that names it",
			)
		// `var names = []`: a list that will grow is a vector, whose element
		// the first use says.
		val init = &self.ast.exprs[pending.init]
		return if init.kind is .Array(elems) && elems.isEmpty() then
			diagnostic.withFix("make it an empty vector", [Edit::replace(init.span, "Vec()")])
		else diagnostic
	}

	/// The type parameters `ty` leaves unknown, by name.
	fn holeNames(ty: Ty): Vec<str> = {
		var names: Vec<str> = Vec()
		val (def, list) = match self.kind(ty) {
			.Struct(id, args) => (TypeDef::Struct(id), args)
			.Enum(id, args) => (TypeDef::Enum(id), args)
			_ => return names
		}
		val generics = self.typeGenerics(def)
		for (i, arg) in self.program.types.list(list).forwards().enumerate() {
			if arg == ERROR && i < generics.len() then names.push(self.text(generics[i].name)) else if self.hasError(
				arg,
			) {
				val inside = self.holeNames(arg)
				names.pushAll(&inside)
			}
		}
		return names
	}

	/// `ty` as it is written, with `…` for what is not known.
	fn holeText(ty: Ty): String = {
		if ty == ERROR then return String::of("…")
		val (def, list) = match self.kind(ty) {
			.Struct(id, args) if self.hasError(ty) => (TypeDef::Struct(id), args)
			.Enum(id, args) if self.hasError(ty) => (TypeDef::Enum(id), args)
			_ => return self.program.tyName(ty, self.interner)
		}
		var args: Vec<String> = Vec()
		for arg in self.program.types.list(list) {
			args.push(self.holeText(arg))
		}
		return "\(self.typeName(def))<\(args.join(", "))>"
	}

	/// A method called on a local waiting for its type: what the call's
	/// arguments say of the method's type parameters says the receiver's, as
	/// a generic function's arguments say its own. They are checked here,
	/// and kept for where the call checks them.
	var fn decideByMethod(local: LocalId, base: ast::ExprId, name: ast::Name, item: &ItemUse) = {
		// A method says nothing of a number literal's type: the method is
		// found by it.
		if self.state.pendingLocals.at(&local).literal {
			self.decideLiteral(
				local,
				.None,
				into: false,
				from: false,
				at: self.ast.exprs[base].span,
			)
			return
		}
		val known = self.state.body.locals[local].ty
		var found = ERROR
		if self.ownerOf(known) is .Some(owner) {
			var method = self.methodOf(owner, name.sym)
			if method.isNone() {
				val (offered, _) = self.offered(owner, known, name.sym)
				if !offered.isEmpty() then method = .Some(offered[0].method)
			}
			if method is .Some(id) &&
				self.program.fns[id].receiver is .Some(kind) &&
				kind != .Static {
				found = self.receiverFromArguments(id, &item)
			}
		}
		self.decide(local, found, self.ast.exprs[base].span)
	}

	/// The receiver's type a call of `method` says through its arguments.
	var fn receiverFromArguments(method: FnId, item: &ItemUse): Ty = {
		val .Some(args) = item.args else return ERROR
		val params = self.program.fns[method].params.clone()
		if params.isEmpty() then return ERROR
		var solution: Vec<Option<Ty>> = Vec()
		for _ in self.program.fns[method].generics {
			solution.push(.None)
		}
		var checked: Vec<bool> = Vec()
		for _ in args {
			checked.push(false)
		}
		// A literal waits for what the others say, as in a generic call.
		for pass in 0..2 {
			for i in 0..args.len() {
				if checked[i] then continue
				val arg = args[i]
				val at = match (if i < item.names.len() then item.names[i] else .None) {
					.Some(n) => {
						var position: Option<i64> = .None
						for p in 1..params.len() {
							if params[p].name == n.sym then position = .Some(p)
						}
						match position {
							.Some(p) => p
							.None => continue
						}
					}
					.None => i + 1
				}
				if at >= params.len() then continue
				var declared = params[at].ty
				if self.resolved(declared, &solution) then continue
				if self.isLambda(arg) then continue
				if pass == 0 && self.takesExpectedType(arg) then continue
				val inferred = self.keptFor(self.inferArgument(arg, .None), declared)
				self.state.early.put(arg, inferred)
				checked[i] = true
				// A value with no place of its own answers a `&T` parameter.
				if self.kind(declared) is .Ref(inner, kind: .Shared) &&
					self.kind(self.tyOf(inferred)) !is .Ref(..) {
					declared = inner
				}
				self.unify(declared, self.tyOf(inferred), &var solution)
			}
		}
		val receiver = self.underRefs(params[0].ty)
		val args = solved(&solution)
		return self.program.types.subst(receiver, &args)
	}
}
