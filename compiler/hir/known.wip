// The prelude's items the compiler itself uses: the interface `==` goes
// through, the enum `main` may return, the method that makes a `String` a
// `str`. Each is declared here once, with what it is for, found where the
// prelude declares it by the name it has there, and read through
// `PreludeItems` by what it is for.

import std::collections::{Map}
import syntax::{BinaryOp}

/// An interface of the prelude's that the compiler asks for.
@derive(Eq, Hash, Clone)
pub enum KnownInterface {
	/// What the compiler calls where a value ends.
	Destroy
	/// What an error implements to be printed, and what interpolation writes
	/// a value with.
	Text
	/// What `?` converts an error through.
	From
	/// What `==` goes through.
	Eq
	/// What `<` goes through.
	Ord
	/// What `@derive(Clone)` implements.
	Clone
	/// What `+` asks a type of a program's own.
	Add
	/// `-` between two values.
	Subtract
	/// `*`.
	Multiply
	/// `/`.
	Divide
	/// `%`.
	Remainder
	/// `-x`.
	Negate
	/// `!x`.
	Not
	/// What `x[i]` calls.
	Index
	/// What `for` walks a container through.
	Items
	/// What `for` walks what lends its elements one at a time through.
	Sequence
	/// What `for` walks what lends no slice through.
	Iterator
	/// What `for x in move c` walks: what `c` gives up its elements to.
	IntoIterator
	/// What a map asks a key for.
	Hash
}

extend KnownInterface {
	/// What the prelude calls it.
	pub fn name(): str = match self {
		.Destroy => "Destroy"
		.Text => "Text"
		.From => "From"
		.Eq => "Eq"
		.Ord => "Ord"
		.Clone => "Clone"
		.Add => "Add"
		.Subtract => "Subtract"
		.Multiply => "Multiply"
		.Divide => "Divide"
		.Remainder => "Remainder"
		.Negate => "Negate"
		.Not => "Not"
		.Index => "Index"
		.Items => "Items"
		.Sequence => "Sequence"
		.Iterator => "Iterator"
		.IntoIterator => "IntoIterator"
		.Hash => "Hash"
	}

	/// The one the prelude calls `name`, if any is.
	pub static fn named(name: str): Option<KnownInterface> = {
		for known in KnownInterface::all() {
			if known.name() == name then return .Some(known)
		}
		return .None
	}

	/// The operator an interface answers, where it is one of the arithmetic
	/// ones.
	pub fn binaryOp(): Option<BinaryOp> = match self {
		.Add => .Some(.Add)
		.Subtract => .Some(.Sub)
		.Multiply => .Some(.Mul)
		.Divide => .Some(.Div)
		.Remainder => .Some(.Rem)
		_ => .None
	}

	/// The interface behind a binary operator on a type of a program's own.
	pub static fn ofBinary(op: BinaryOp): Option<KnownInterface> = match op {
		.Add => .Some(.Add)
		.Sub => .Some(.Subtract)
		.Mul => .Some(.Multiply)
		.Div => .Some(.Divide)
		.Rem => .Some(.Remainder)
		_ => .None
	}
}

/// An enum of the prelude's that the compiler makes values of.
@derive(Eq, Hash, Clone)
pub enum KnownEnum {
	/// What `fromIndex` answers with, and what an iterator's `next` does.
	Option
	/// What `main` may return.
	Result
	/// What `Ord` answers with.
	Ordering
}

extend KnownEnum {
	/// What the prelude calls it.
	pub fn name(): str = match self {
		.Option => "Option"
		.Result => "Result"
		.Ordering => "Ordering"
	}

	/// The one the prelude calls `name`, if any is.
	pub static fn named(name: str): Option<KnownEnum> = {
		for known in KnownEnum::all() {
			if known.name() == name then return .Some(known)
		}
		return .None
	}
}

/// A struct of the prelude's that the compiler makes values of.
@derive(Eq, Hash, Clone)
pub enum KnownStruct {
	/// What a string literal becomes where one is expected.
	String
}

extend KnownStruct {
	/// What the prelude calls it.
	pub fn name(): str = match self {
		.String => "String"
	}

	/// The one the prelude calls `name`, if any is.
	pub static fn named(name: str): Option<KnownStruct> = {
		for known in KnownStruct::all() {
			if known.name() == name then return .Some(known)
		}
		return .None
	}
}

/// A function of the prelude's that the compiler calls.
@derive(Eq, Hash, Clone)
pub enum KnownFn {
	/// `String::toStr`, called where a `String` is passed to what takes a
	/// `str`.
	StringToStr
	/// `String::over`, a `String` over a `str`'s own bytes, made where a
	/// `str` is passed to what takes a `&String`.
	StringOver
	/// `String::of`, a copy of text, made where a `str` is given where a
	/// `String` is expected.
	StringOf
	/// What a `main` that returns a `Result` with an `i64` goes through.
	ExitCode
	/// What a `main` that returns a `Result` with nothing goes through.
	ExitVoid
}

extend KnownFn {
	/// What the prelude calls it.
	pub fn name(): str = match self {
		.StringToStr => "toStr"
		.StringOver => "over"
		.StringOf => "of"
		.ExitCode => "exitCode"
		.ExitVoid => "exitVoid"
	}

	/// The struct it is a method of, or nothing for a free function.
	pub fn owner(): Option<KnownStruct> = match self {
		.StringToStr | .StringOver | .StringOf => .Some(.String)
		.ExitCode | .ExitVoid => .None
	}

	/// The one the prelude calls `name`, as a method of `owner` or, where
	/// that is nothing, as a free function.
	pub static fn named(owner: Option<KnownStruct>, name: str): Option<KnownFn> = {
		for known in KnownFn::all() {
			if known.owner() == owner && known.name() == name then return .Some(known)
		}
		return .None
	}
}

/// The prelude's items the compiler uses, by what each is for: filled in
/// where the prelude declares them, and nothing for one it does not.
@derive(Clone)
pub struct PreludeItems {
	interfaces: Map<KnownInterface, InterfaceId> = Map()
	enums: Map<KnownEnum, EnumId> = Map()
	structs: Map<KnownStruct, StructId> = Map()
	fns: Map<KnownFn, FnId> = Map()
}

extend PreludeItems {
	pub fn interfaceOf(which: KnownInterface): Option<InterfaceId> = match self.interfaces.get(
		&which,
	) {
		.Some(id) => .Some(id)
		.None => .None
	}

	pub fn enumeration(which: KnownEnum): Option<EnumId> = match self.enums.get(&which) {
		.Some(id) => .Some(id)
		.None => .None
	}

	pub fn structure(which: KnownStruct): Option<StructId> = match self.structs.get(&which) {
		.Some(id) => .Some(id)
		.None => .None
	}

	pub fn function(which: KnownFn): Option<FnId> = match self.fns.get(&which) {
		.Some(id) => .Some(id)
		.None => .None
	}

	/// Which of these `id` is, if it is one.
	pub fn whichInterface(id: InterfaceId): Option<KnownInterface> = {
		for i in 0..self.interfaces.len() {
			if self.interfaces.valueAt(i) == id then return .Some(self.interfaces.keyAt(i).clone())
		}
		return .None
	}

	var fn setInterface(which: KnownInterface, id: InterfaceId) = self.interfaces.put(which, id)

	var fn setEnumeration(which: KnownEnum, id: EnumId) = self.enums.put(which, id)

	var fn setStructure(which: KnownStruct, id: StructId) = self.structs.put(which, id)

	var fn setFunction(which: KnownFn, id: FnId) = self.fns.put(which, id)
}
