// Matching the arguments of a call, or the values of a variant, to the
// parameters or fields they are for: by position, by name, from a default,
// or, for an implicit parameter, from the implicit of its name where the
// call is.

import std::collections::{Map}
import std::mem
import syntax as ast
import syntax::{
	ARGUMENTS_SWAPPED,
	ARGUMENT_NAMED_WITH_EQUALS,
	ARGUMENT_TWICE,
	Diagnostic,
	Edit,
	INVALID_DEFAULT,
	MISMATCHED_TYPES,
	NAME_SAID_TWICE,
	NO_IMPLICIT,
	Span,
	Symbol,
	UNKNOWN_ARGUMENT_NAME
}

/// A parameter or field that an argument can give a value to.
@derive(Clone)
struct Slot {
	name: Symbol
	ty: Ty
	/// Where it is declared.
	span: Span
	default: Option<DefaultValue>
	/// An implicit parameter, filled where no argument gives it a value.
	implicit: bool = false
}

/// Where the arguments of one call went.
struct Matched {
	/// For each slot, the argument that gives it a value, if one does.
	slots: Vec<Option<i64>>
	/// Arguments that give no slot a value: an unknown name, a slot given
	/// twice, or more positional arguments than slots. They are still
	/// checked, so that the mistakes inside them are reported.
	unmatched: Vec<i64>
	/// How many positional arguments had no slot.
	extra: i64
	/// Whether an argument named no slot. The slot it was probably meant for
	/// is then not reported as missing too.
	unknown: bool
	/// The slots an argument names, `scale: 2`.
	named: Vec<i64> = Vec()
}

extend Matched {
	/// The slots that get neither an argument nor a default, unless an
	/// unknown name was probably meant for one of them.
	fn missing(slots: &[Slot]): Vec<i64> = {
		var missing: Vec<i64> = Vec()
		if self.unknown then
			return missing

		for i in 0..slots.len() do
			if self.slots[i].isNone() && slots[i].default.isNone() && !slots[i].implicit then
				missing.push(i)

		return missing
	}
}

/// The slot of a name, among `slots`.
fn slotNamed(slots: &[Slot], sym: Symbol): Option<i64> = {
	for (i, s) in slots.indexed() do
		if s.name == sym then
			return i

	return .None
}

extend Lowerer {
	/// Matches arguments to slots: positional arguments to the first slots,
	/// named ones to the slots of their names. Reports unknown names and slots
	/// given twice; the caller reports what is missing or extra. `what` is
	/// "parameter" or "field", and `owner` the function or variant.
	var fn matchArguments(
		slots: &[Slot],
		args: &[ast::ExprId],
		names: &[Option<ast::Name>],
		what: str,
		owner: str,
	): Matched = {
		val slotted: Vec<Option<i64>> = [
			for _ in 0..slots.len() do
				yield .None
		]
		var matched = Matched(slots: slotted, unmatched: Vec(), extra: 0, unknown: false)
		var positional = 0
		for (i, name) in names.indexed() {
			// `f(style = x)`, meant as `f(style: x)`: an assignment to a
			// parameter's name, where nothing of that name is in scope.
			var meant: Option<Symbol> = .None
			if name.isNone() &&
				self.ast.exprs[args[i]].kind is .Assign(target, op: .None, value, ..) &&
				self.ast.exprs[target].kind is .Name(sym) &&
				self.lookup(sym).isNone() &&
				slotNamed(&slots, sym).isSome() {
				val between = Span::new(
					lo: self.ast.exprs[target].span.hi,
					hi: self.ast.exprs[value].span.lo,
				)
				self.report(
					Diagnostic::error(
						ARGUMENT_NAMED_WITH_EQUALS,
						"an argument is named with `:`, as `\(self.text(sym)): …`",
						self.ast.exprs[args[i]].span,
						"an assignment",
					).withFix("name it", [Edit::replace(between, ": ")]).withNote(
						"`=` assigns, and an assignment is an expression, so `f(x = 1)` would assign to `x`; an argument is named as a struct literal's field is",
					),
				)
				self.state.namedByEquals.add(args[i])
				meant = sym
			}
			var slot = 0
			when {
				name is .Some(n) => {
					val .Some(found) = slotNamed(&slots, n.sym) else {
						val text = self.text(n.sym)
						val texts: Vec<str> = slots.map((s) => self.text(s.name))
						var diagnostic = Diagnostic::error(
							UNKNOWN_ARGUMENT_NAME,
							"`\(owner)` has no \(what) named `\(text)`",
							n.span,
							"no such \(what)",
						)
						if suggest(text, &texts) is .Some(similar) then
							diagnostic = diagnostic.withFix(
								"did you mean `\(similar)`?",
								[Edit::replace(n.span, similar)],
							)
						else {
							val quoted: Vec<String> = slots.map((s) => "`\(self.text(s.name))`")
							if !quoted.isEmpty() then
								diagnostic = diagnostic.withNote("the \(what)s are \(quoted.join(", "))")
						}

						self.report(diagnostic)
						matched.unmatched.push(i)
						matched.unknown = true
						continue
					}
					slot = found
					matched.named.push(found)
					self.nameSaidTwice(&n, args[i])
				}
				meant is .Some(sym) => {
					slot = slotNamed(&slots, sym).unwrap()
					matched.named.push(slot)
				}
				else => {
					slot = positional
					positional += 1
					if slot >= slots.len() {
						matched.extra += 1
						matched.unmatched.push(i)
						continue
					}
				}
			}
			if matched.slots[slot] is .Some(first) {
				val text = self.text(slots[slot].name)
				val this = match name {
					.Some(n) => n.span
					.None => self.ast.exprs[args[i]].span
				}
				self.report(
					Diagnostic::error(
						ARGUMENT_TWICE,
						"the \(what) `\(text)` is given twice",
						this,
						"given again here",
					).withSecondary(self.ast.exprs[args[first]].span, "given here first"),
				)
				matched.unmatched.push(i)
				continue
			}
			matched.slots[slot] = i
		}
		return matched
	}

	/// A warning for a call whose arguments by position include two or more
	/// that are the parameters' own names, each in another's place:
	/// `draw(height, width)` for `draw(width, height)`. One named as another
	/// parameter whose own argument is something else — `rhs` in `lhs` and
	/// `size` in `rhs` — is a chain a program writes on purpose, and is not
	/// one. Naming the arguments says the order is meant.
	var fn swappedArguments(
		params: &[ParamDef],
		args: &[ast::ExprId],
		names: &[Option<ast::Name>],
		callee: str,
	) = {
		var given: Vec<Option<Symbol>> = Vec()
		var i = 0
		while i < args.len() && i < names.len() && names[i].isNone() {
			given.push(self.argumentName(args[i]))
			i += 1
		}
		var swapped: Vec<i64> = [
			for at in 0..given.len() {
				if paramElsewhere(&params, &given, at) is .Some(j) &&
					paramElsewhere(&params, &given, j).isSome() {
					yield at
				}
			}
		]
		if swapped.len() < 2 then
			return

		val quoted: Vec<String> = [
			for k in swapped do
				if given[k] is .Some(sym) then
					yield "`\(self.text(sym))`"
		]
		val message = if quoted.len() == 2 {
			"\(quoted[0]) and \(quoted[1]) are passed in each other's places"
		} else {
			val head: Vec<String> = [
				for k in 0..quoted.len() - 1 do
					yield quoted[k].clone()
			]
			"\(head.join(", ")) and \(quoted[quoted.len() - 1]) are passed in one another's places"
		}
		var diagnostic = Diagnostic::warning(ARGUMENTS_SWAPPED, message, self.ast.exprs[args[swapped[0]]].span, "given as `\(self.text(params[swapped[0]].name))`")
		for k in 1..swapped.len() {
			val at = swapped[k]
			diagnostic = diagnostic.withSecondary(self.ast.exprs[args[at]].span, "given as `\(self.text(params[at].name))`")
		}
		// Named from the first of them on, since nothing by position may follow
		// a named argument.
		val edits: Vec<Edit> = [
			for k in swapped[0]..given.len() do
				yield Edit::insert(self.ast.exprs[args[k]].span.lo, "\(self.text(params[k].name)): ")
		]
		val order: Vec<String> = [
			for k in 0..given.len() do
				yield "`\(self.text(params[k].name))`"
		]
		diagnostic = diagnostic.withFix(
			"if that is meant, name them",
			(edits).intoBuffer(),
		).withNote("`\(callee)` takes \(order.join(", ")), in that order")
		self.report(diagnostic)
	}

	/// The name an argument is written by: a variable's, or a field's that is
	/// read, through `&`, `&var`, `move` and parentheses.
	fn argumentName(arg: ast::ExprId): Option<Symbol> = match self.ast.exprs[arg].kind {
		.Name(sym) => sym
		.Field(name, ..) => name.sym
		.Paren(inner) => self.argumentName(inner)
		.Unary(op: .Ref | .RefVar | .Move, operand, ..) => self.argumentName(operand)
		_ => .None
	}

	/// The checked values of matched arguments, in slot order, with defaults
	/// copied in and error expressions for what is missing, and the order in
	/// which they are evaluated: the written arguments as written, then the
	/// defaults. `place` is where the call's name is written, which a
	/// `Location` filled at the call names.
	var fn arrangeArguments(
		slots: &[Slot],
		matched: &Matched,
		checked: &[Option<ExprId>],
		span: Span,
		place: Span,
		callee: str,
	): (Vec<ExprId>, Vec<u32>) = {
		var values: Vec<ExprId> = Vec()
		var written: Vec<(i64, u32)> = Vec()
		var rest: Vec<u32> = Vec()
		for (slot, arg) in matched.slots.indexed() {
			val value = match arg {
				.Some(a) => {
					written.push((a, slot as u32))
					checked[a].unwrap()
				}
				.None => {
					rest.push(slot as u32)
					match slots[slot].default {
						.Some(default) => self.useDefault(&default, span, [])
						.None if slots[slot].implicit => self.implicitArgument(
							&slots[slot],
							callee,
							span,
							place,
						)
						.None => self.errorExpr(span)
					}
				}
			}
			values.push(value)
		}
		written.sortUnstable()
		var order: Vec<u32> = [
			for (_, slot) in written do
				yield slot
		]
		for slot in rest do
			order.push(slot)

		return (values, orderOf(order))
	}

	/// What fills the implicit parameter `slot` of a call to `callee` that
	/// leaves it out: the implicit of its name where the call is — one of the
	/// function's own implicit parameters, an `implicit val` or `var` in
	/// scope, or one a lambda captures from around it — lent as the
	/// parameter takes it, as if the call had written `rng: &var rng`.
	/// Where there is none, a `Location` is the call's own place, `place`,
	/// which is where its name is written; any other type is refused.
	var fn implicitArgument(slot: &Slot, callee: str, span: Span, place: Span): ExprId = {
		val name = String::of(self.text(slot.name))
		val wanted = self.tyName(slot.ty)
		if !self.implicitInScope(slot.name) && self.program.isLocation(slot.ty) then
			return self.alloc(.Here, slot.ty, place)

		if !self.implicitInScope(slot.name) {
			var diagnostic = Diagnostic::error(
				NO_IMPLICIT,
				"`\(callee)` needs `\(name)`, an implicit \(wanted), and nothing here is one",
				span,
				"`\(name)` is not given",
			).withSecondary(
				slot.span,
				"the implicit parameter",
			).withHelp("add `implicit \(name): \(self.program.tyName(slot.ty, self.interner))` to the parameters of the function around the call, declare `implicit var \(name)` before it, or pass it, `\(name): …`")
			if self.lookup(slot.name).isSome() || self.namesAround(slot.name) then
				diagnostic = diagnostic.withNote("a `\(name)` is here, but not implicit: only an implicit fills an implicit, so that declaring a variable never changes what an unrelated call receives")

			self.report(diagnostic)
			return self.errorExpr(span)
		}
		// The binding's place: what it holds, or what it refers to.
		val place = self.name(slot.name, .None, span)
		val held = self.tyOf(place)
		// What an editor shows the call to have been given, before its `)`.
		val at = if span.hi > span.lo then span.hi - 1 else span.hi
		val given: ExprId = match self.kind(slot.ty) {
			.Ref(inner, kind) if inner == held => {
				if kind == .Var then
					self.requireWritable(place, .Borrow)

				val lent = if kind == .Var then "&var " else "&"
				self.program.implicitFills.push((at, "\(name): \(lent)\(name)"))
				self.alloc(.Ref(place), slot.ty, span)
			}
			_ if held == slot.ty => {
				self.program.implicitFills.push((at, "\(name): \(name)"))
				place
			}
			_ => {
				self.report(
					Diagnostic::error(
						MISMATCHED_TYPES,
						"`\(callee)` needs `\(name)` as \(wanted), and the implicit here holds \(self.tyName(held))",
						span,
						"`\(name)` filled from here",
					).withSecondary(slot.span, "the implicit parameter").withNote(
						"an implicit is found by its name, and must then be of the type the parameter takes",
					),
				)
				self.errorExpr(span)
			}
		}
		return given
	}

	/// Whether `sym` names an implicit: of the body being checked, or of one
	/// around a lambda, which the lambda captures.
	fn implicitInScope(sym: Symbol): bool = self.implicitTy(sym).isSome()

	/// The type of the implicit `sym` names, where it names one: of the body
	/// being checked, or of one around a lambda.
	fn implicitTy(sym: Symbol): Option<Ty> = {
		if self.lookup(sym) is .Some(local) {
			val found = &self.state.body.locals[local]
			return if found.implicit then found.ty else .None
		}
		var i = self.outer.len()
		while i > 0 {
			i -= 1
			var s = self.outer[i].scopes.len()
			while s > 0 {
				s -= 1
				if self.outer[i].scopes[s].get(&sym) is .Some(local) {
					val found = &self.outer[i].body.locals[local]
					return if found.implicit then found.ty else .None
				}
			}
		}
		return .None
	}

	/// What a literal or a call that leaves a field or a parameter out puts
	/// there: a copy of a constant, or a call of the default's own function. A
	/// generic one's call is given its type arguments when the literal's or
	/// the call's are known: `settleDefaults`.
	var fn useDefault(default: &DefaultValue, span: Span, args: &[Ty]): ExprId = match default {
		.Constant(exprs, root) => self.copyDefault(&exprs, root, span, &args)
		.Code(code) => {
			val ret = self.program.fns[code].ret
			val call = self.alloc(
				.Call(callee: code, args: Vec(), typeArgs: .empty(), order: Vec()),
				ret,
				span,
			)
			if !self.program.fns[code].generics.isEmpty() then
				self.state.unsettledDefaults.push(call)

			call
		}
	}

	/// Gives the calls of generic defaults made since `mark` the type
	/// arguments of the literal or the call that uses them, which are the
	/// defaults' own.
	var fn settleDefaults(mark: i64, args: &[Ty]) = {
		var calls: Vec<ExprId> = Vec()
		while self.state.unsettledDefaults.len() > mark do
			calls.push(self.state.unsettledDefaults.remove(mark))

		if calls.isEmpty() then
			return

		val list = self.program.types.internList(&args)
		for call in calls {
			val .Call(
				callee,
				args: callArgs,
				order,
				..,
			) = self.state.body.exprs[call].kind.clone() else {
				continue
			}
			val ret = self.program.types.subst(self.program.fns[callee].ret, &args)
			self.state.body.exprs[call].kind = .Call(
				callee:,
				args: callArgs,
				typeArgs: list,
				order:,
			)
			self.state.body.exprs[call].ty = ret
		}
	}

	/// A copy of a constant default's expressions in the body being checked,
	/// at the literal or the call that uses it.
	var fn copyDefault(exprs: &Arena<Expr>, id: ExprId, span: Span, typeArgs: &[Ty]): ExprId = {
		// Written where a type's parameters are its own, as `.None` of an
		// `Option<Part<T>>`: made the type of the value it is a default of.
		val ty =
			if typeArgs.isEmpty() then exprs[id].ty
			else self.program.types.subst(exprs[id].ty, &typeArgs)
		val kind: ExprKind = match exprs[id].kind {
			.Unary(op, operand) => .Unary(
				op:,
				operand: self.copyDefault(&exprs, operand, span, &typeArgs),
			)
			.Variant(id: enumId, variant, args, order) => .Variant(
				id: enumId,
				variant:,
				args: args.map((a) => self.copyDefault(&exprs, a, span, &typeArgs)),
				order: order.clone(),
			)
			.Struct(id: structId, fields, order) => .Struct(
				id: structId,
				fields: fields.map((f) => self.copyDefault(&exprs, f, span, &typeArgs)),
				order: order.clone(),
			)
			.Array(elems) => .Array(elems.map((e) => self.copyDefault(&exprs, e, span, &typeArgs)))
			.ArrayRepeat(elem, count) => .ArrayRepeat(
				elem: self.copyDefault(&exprs, elem, span, &typeArgs),
				count:,
			)
			// A lent closure's default: the function, with an environment of
			// nothing built where the call is.
			.Closure(id: code, env) => .Closure(
				id: code,
				env: self.copyDefault(&exprs, env, span, &typeArgs),
			)
			other => other.clone()
		}
		return self.alloc(kind, ty, span)
	}

	/// Whether a parameter may have a default at all: a C function's may not,
	/// nor may a reference parameter, which a value would not be a place for,
	/// but a lent closure's, whose default is a function that captures
	/// nothing and needs no place. What is refused is reported.
	var fn defaultAllowed(value: ast::ExprId, ty: Ty, param: &ast::Param, isExtern: bool): bool = {
		val span = self.ast.exprs[value].span
		val refusal: Option<str> =
			if isExtern then "a C function's parameters have no defaults"
			else if self.kind(ty) is .Ref(..) && !self.isLentClosure(ty) then
				"a reference parameter has no default: a value is not a place"
			else .None
		if refusal is .Some(message) {
			self.report(
				Diagnostic::error(INVALID_DEFAULT, message, span, "a default").withSecondary(
					param.name.span,
					"for this parameter",
				),
			)
			return false
		}
		return true
	}

	/// Whether a type is a closure lent for a call, `&(…) => R` or `&var (…)
	/// => R`.
	fn isLentClosure(ty: Ty): bool = self.kind(ty) is .Ref(inner, ..) && self.kind(inner) is .Fn(..)

	/// Whether a checked default of a lent closure is a function that
	/// captures nothing: a lambda whose environment is empty, or a function
	/// named, lent with an environment of nothing. Not one generic in what
	/// it belongs to, whose instance the caller could not make.
	fn plainFunction(exprs: &Arena<Expr>, root: ExprId, body: &Body): bool = {
		val .Closure(id: code, env) = exprs[root].kind else return false
		val .Struct(fields, ..) = exprs[env].kind else return false
		if !fields.isEmpty() then
			return false

		return self.program.fns[code].generics.isEmpty() && !body.closureTypeArgs.contains(&root)
	}

	/// A default, checked as a value of the type it is for, once every
	/// function is declared, with the type parameters of what it belongs to
	/// in scope. A constant is kept to be copied in where it is used; a
	/// default that is code is the body of a function of its own, which is
	/// called there.
	var fn defaultOf(value: ast::ExprId, ty: Ty): Option<DefaultValue> = {
		val span = self.ast.exprs[value].span
		val outer = mem::replace(&var self.state.body, Body())
		val scopes = mem::replace(&var self.state.scopes, [Map()])
		val ret = self.state.ret
		val retSpan = self.state.retSpan
		// A `return` in a default leaves its function, with a value of the type
		// the default is.
		self.state.ret = ty
		self.state.retSpan = .None
		val errors = self.errorsReported()
		val root = self.check(value, ty)
		val refused = self.errorsReported() > errors
		val constant = self.isConstant(root)
		var body = mem::replace(&var self.state.body, outer)
		self.state.scopes = scopes
		self.state.ret = ret
		self.state.retSpan = retSpan
		// A lent closure's default is copied into each call that leaves it
		// out, its empty environment the caller's, as an argument's is; a
		// value that captures has nothing in the signature to capture from.
		if self.isLentClosure(ty) {
			if self.plainFunction(&body.exprs, root, &body) then
				return .Constant(exprs: body.exprs, root:)

			// What was wrong with the value is said already.
			if refused then
				return .None

			// A lambda of a generic function is generic in its parameters, and
			// the call that leaves it out could not make its instance.
			val generic = body.exprs[root].kind is .Closure(..) && !self.typeParams.isEmpty()
			val diagnostic =
				if generic then
					Diagnostic::error(
						INVALID_DEFAULT,
						"a lent closure's default in a generic function is a function's name",
						span,
						"a lambda of a generic function",
					).withHelp("declare the function outside, and name it here")
				else Diagnostic::error(
					INVALID_DEFAULT,
					"a lent closure's default is a lambda or a function's name",
					span,
					"another value",
				).withNote(
					"a default is lent to the call that leaves it out, and a function that captures nothing is the one value lent with nothing behind it",
				)
			self.report(diagnostic)
			return .None
		}
		if constant then
			return .Constant(exprs: body.exprs, root:)

		body.value = root
		val code = self.program.fns.add(FnDef(
			name: Symbol::defaultCode(),
			nameSpan: span,
			symbol: .None,
			receiver: .None,
			owner: .None,
			interfaceId: .None,
			generics: self.typeParams.clone(),
			instanceOf: .None,
			params: Vec(),
			ret: ty,
			retSpan: .None,
			isExtern: false,
			exportsC: false,
			header: .None,
			accesses: .None,
			isVariadic: false,
			variadicOf: .None,
			lendsFrom: .None,
			keeps: Vec(),
			keepsAt: .None,
			isLambda: false,
			generator: .None,
			isTailrec: false,
			test: .None,
			isInline: false,
			generated: .None,
			intrinsic: .None,
			body:,
			projects: .None,
			compileTime: false,
			module: self.current as u32,
			isPub: false,
			span:,
		))
		return .Code(code)
	}

	/// Whether a checked expression is a constant.
	fn isConstant(id: ExprId): bool = match self.state.body.exprs[id].kind {
		.Int(..) | .Float(..) | .Bool(..) | .Str(..) | .Error => true
		.Unary(operand, ..) => self.isConstant(operand)
		.Variant(args: parts, ..) | .Struct(fields: parts, ..) | .Array(elems: parts) => {
			for p in parts do
				if !self.isConstant(p) then
					return false

			true
		}
		.ArrayRepeat(elem, ..) => self.isConstant(elem)
		_ => false
	}

	/// E0485: a named argument whose value is the variable of its name,
	/// `x: x`, which `x:` says. Not one written so already, whose value is
	/// at the name's own span, nor what `@derive` writes, nor one the parser
	/// made of an interpolation's options, whose names the program did not
	/// write where they stand.
	var fn nameSaidTwice(name: &ast::Name, value: ast::ExprId) = {
		val written = &self.ast.exprs[value]
		val .Name(symbol) = written.kind else return
		if symbol != name.sym || written.span == name.span then
			return

		if self.inDerived() || !self.writtenAt(name.sym, name.span.lo) then
			return

		val text = self.text(name.sym)
		self.report(
			Diagnostic::warning(
				NAME_SAID_TWICE,
				"`\(text): \(text)` is `\(text):`",
				Span::new(name.span.lo, written.span.hi),
				"the name, and a value of the same name",
			).withNote(
				"a named argument written `name:`, before a `,` or the `)`, is given the value of that name",
			).withFix("write the name once", [
				Edit::replace(Span::new(name.span.hi, written.span.hi), ":"),
			]),
		)
	}

	/// Whether the file writes `sym` at `at`: its identifiers are kept in the
	/// order they are written, so it is looked for by halves.
	fn writtenAt(sym: Symbol, at: u32): bool = {
		val written = &self.ast.identifiers
		var lo = 0
		var hi = written.len()
		while lo < hi {
			val middle = (lo + hi) / 2
			if written[middle].1 < at then
				lo = middle + 1
			else
				hi = middle
		}
		return lo < written.len() && written[lo].1 == at && written[lo].0 == sym
	}
}

/// The parameter a value given at `at` is named as, where it is another
/// parameter than its own.
fn paramElsewhere(params: &[ParamDef], given: &[Option<Symbol>], at: i64): Option<i64> = {
	if at >= given.len() then
		return .None

	val .Some(sym) = given[at] else return .None
	for (other, p) in params.indexed() do
		if p.name == sym then
			return if other != at then other else .None

	return .None
}
