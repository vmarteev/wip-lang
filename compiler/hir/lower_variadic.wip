// Calls to a C function that takes more than it declares: each is pointed
// at a declaration of exactly what it passes, which the C the compiler
// writes for itself then calls.

import std::collections::{Map}

/// Points each call to a C function that takes more than it declares at a
/// declaration of exactly what that call passes. This is done once every
/// body is checked. One declaration serves every call that passes the same
/// types, so two `printf`s of one format share a wrapper.
fn resolveVariadicCalls(program: &var Program) = {
	var any = false
	for def in program.fns {
		if def.isVariadic then any = true
	}
	if !any then return
	var calls: Vec<(FnId, ExprId, FnId, Vec<Ty>)> = Vec()
	for owner in program.fns.ids() {
		val .Some(body) = program.fns[owner].body else {
			continue
		}
		for id in body.exprs.ids() {
			val .Call(callee, args, ..) = body.exprs[id].kind else {
				continue
			}
			if !program.fns[callee].isVariadic then continue
			var types: Vec<Ty> = Vec()
			for arg in args {
				types.push(body.exprs[arg].ty)
			}
			calls.push((owner, id, callee, move types))
		}
	}
	var made: Map<(FnId, TyList), FnId> = Map()
	var redirects: Vec<(FnId, ExprId, FnId)> = Vec()
	for (owner, id, callee, types) in move calls {
		val list = program.types.internList(&types)
		val key = (callee, list)
		val concrete = match made.get(&key) {
			.Some(found) => found
			.None => {
				val declared = program.fns[callee].params.clone()
				var def = program.fns[callee].clone()
				var params: Vec<ParamDef> = Vec()
				for (i, ty) in types.forwards().enumerate() {
					var param =
						if i < declared.len() then declared[i].clone() else declared[0].clone()
					param.ty = ty
					params.push(move param)
				}
				def.params = move params
				def.isVariadic = false
				def.variadicOf = .Some(callee)
				def.body = .None
				val madeId = program.fns.add(move def)
				made.put((callee, list), madeId)
				madeId
			}
		}
		redirects.push((owner, id, concrete))
	}
	for (owner, id, concrete) in redirects {
		val .Some(body) = program.fns[owner].body.take() else {
			continue
		}
		var changed = move body
		if changed.exprs[id].kind.clone() is .Call(args, typeArgs, order, ..) then
			changed.exprs[id].kind = .Call(
				callee: concrete,
				args: move args,
				typeArgs: typeArgs,
				order: move order,
			)
		program.fns[owner].body = .Some(move changed)
	}
}
