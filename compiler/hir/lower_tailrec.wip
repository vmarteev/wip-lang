// Tail calls: `@tailrec`, a function whose calls to itself are jumps, and
// `become f(x)`, a call that takes the function's frame.
//
// Tail position is decided here, where the spans are: the value of the body,
// the value of a block in tail position, every arm of an `if` or a `match` in
// tail position, and the operand of `return`. A call to the function itself
// anywhere else is an error, and so is an argument that refers into the frame
// the call is about to reuse. What is left — that no local still owns memory,
// and that no `defer` is pending — needs to know what has been moved, so the
// move checker asks it.

import std::collections::{Set}
import syntax as ast
import syntax::{BECOME_AGGREGATE, BECOME_SIGNATURE, Diagnostic, NOT_A_TAIL_CALL, Span}

extend Lowerer {
	/// Checks a `@tailrec` function once its body is checked, and records the
	/// calls the mid-level IR turns into jumps.
	var fn checkTailrec(id: FnId, value: ExprId) = {
		// A projection lends a place of its caller; `yield` is not a call.
		if self.program.fns[id].projects.isSome() ||
			self.kind(self.program.fns[id].ret) is .Ref(..) {
			val span = self.program.fns[id].span
			self.report(
				Diagnostic::error(
					NOT_A_TAIL_CALL,
					"a projection cannot be `@tailrec`",
					span,
					"a projection",
				).withNote(
					"a projection lends a place that belongs to its caller, and ends with `lend` rather than a call",
				),
			)
			return
		}
		var tails: Vec<ExprId> = Vec()
		self.tailPositions(value, &var tails)
		// `return f(x)` is a tail call too, wherever the `return` is written.
		self.returnedValues(value, &var tails)
		var tailSet: Set<ExprId> = Set()
		for t in tails {
			tailSet.add(t)
		}
		// Every call the function makes to itself, in the order written.
		var calls: Vec<ExprId> = Vec()
		self.selfCalls(value, id, &var calls)
		if calls.isEmpty() {
			val span = self.program.fns[id].nameSpan
			val name = String::of(self.text(self.program.fns[id].name))
			self.report(
				Diagnostic::error(
					NOT_A_TAIL_CALL,
					"`\(name)` never calls itself",
					span,
					"no call to itself",
				).withNote(
					"`@tailrec` promises that a function's calls to itself are jumps; a function that makes none has nothing to promise",
				).withHelp("remove `@tailrec`"),
			)
			return
		}
		var tailCalls: Vec<ExprId> = Vec()
		for call in calls {
			if !tailSet.contains(&call) {
				val span = self.state.body.exprs[call].span
				self.report(
					Diagnostic::error(
						NOT_A_TAIL_CALL,
						"this call to itself is not a tail call",
						span,
						"its value is used by what is around it",
					).withNote(
						"a tail call's value is the function's value, and nothing of the function runs after it",
					).withHelp(
						"in a `@tailrec` function every call to itself is a jump: carry what is computed after the call in a parameter instead",
					),
				)
				continue
			}
			if self.borrowsFrame(
				call,
				"reuses",
				"a `@tailrec` function's call to itself is a jump, so this frame is the one the next round uses",
			) {
				continue
			}
			tailCalls.push(call)
		}
		self.state.body.tailCalls = tailCalls
	}

	/// The expressions in tail position, starting from the body's value.
	fn tailPositions(id: ExprId, tails: &var Vec<ExprId>) = {
		tails.push(id)
		match self.state.body.exprs[id].kind {
			// A block's value is in tail position; its statements are not, except
			// a `return`, which the walk below finds anyway.
			.Block(block) => {
				if block.value is .Some(value) then self.tailPositions(value, &var tails)
			}
			.If(thenBlock, elseBlock, ..) => {
				if thenBlock.value is .Some(value) then self.tailPositions(value, &var tails)
				if elseBlock is .Some(b) && b.value is .Some(value) then
					self.tailPositions(value, &var tails)
			}
			.Match(arms, ..) => {
				for arm in arms {
					self.tailPositions(arm.body, &var tails)
				}
			}
			_ => {}
		}
	}

	/// The operands of every `return` in the body, which are in tail position
	/// wherever they are written, and what is in tail position inside them.
	fn returnedValues(id: ExprId, tails: &var Vec<ExprId>) = {
		val kind = &self.state.body.exprs[id].kind
		for child in kind.children() {
			self.returnedValues(child, &var tails)
		}
		for block in kind.blocks() {
			self.returnedValuesInBlock(&block, &var tails)
		}
		for arm in kind.arms() {
			self.returnedValues(arm.body, &var tails)
		}
	}

	fn returnedValuesInBlock(block: &Block, tails: &var Vec<ExprId>) = {
		for stmt in block.stmts {
			val kind = &self.state.body.stmts[stmt].kind
			if kind is .Return(.Some(value)) then self.tailPositions(value, &var tails)
			for child in kind.children() {
				self.returnedValues(child, &var tails)
			}
			for inner in kind.blocks() {
				self.returnedValuesInBlock(&inner, &var tails)
			}
		}
		if block.value is .Some(value) then self.returnedValues(value, &var tails)
	}

	/// Every call of the function to itself, wherever it is written. The
	/// operand of a `return` is in tail position too, so the statements are
	/// walked for those.
	fn selfCalls(id: ExprId, function: FnId, calls: &var Vec<ExprId>) = {
		val kind = &self.state.body.exprs[id].kind
		if kind is .Call(callee, ..) && callee == function then calls.push(id)
		for child in kind.children() {
			self.selfCalls(child, function, &var calls)
		}
		for block in kind.blocks() {
			self.selfCallsInBlock(&block, function, &var calls)
		}
		for arm in kind.arms() {
			self.selfCalls(arm.body, function, &var calls)
		}
	}

	fn selfCallsInStmt(id: StmtId, function: FnId, calls: &var Vec<ExprId>) = {
		val kind = &self.state.body.stmts[id].kind
		for child in kind.children() {
			self.selfCalls(child, function, &var calls)
		}
		for block in kind.blocks() {
			self.selfCallsInBlock(&block, function, &var calls)
		}
	}

	fn selfCallsInBlock(block: &Block, function: FnId, calls: &var Vec<ExprId>) = {
		for stmt in block.stmts {
			self.selfCallsInStmt(stmt, function, &var calls)
		}
		if block.value is .Some(value) then self.selfCalls(value, function, &var calls)
	}

	/// Whether an argument of the call refers into this frame, which the call
	/// is about to take: it `does` so, and `note` says why. Reports it, and
	/// returns whether it did.
	var fn borrowsFrame(call: ExprId, does: str, note: str): bool = {
		val .Call(args, ..) = self.state.body.exprs[call].kind.clone() else {
			panic("a self-call is a call")
		}
		var found: Option<(Span, str)> = .None
		for arg in args {
			self.frameReference(arg, &var found)
		}
		val .Some((span, what)) = found else return false
		self.report(
			Diagnostic::error(
				NOT_A_TAIL_CALL,
				"this argument refers into the frame the call \(does), so it cannot be a \(what)",
				span,
				"points into this call's frame",
			).withNote(note).withHelp(
				"pass the value itself, or a reference the function was given",
			),
		)
		return true
	}

	/// The first reference into this frame inside `id`, if there is one.
	fn frameReference(id: ExprId, found: &var Option<(Span, str)>) = {
		if found.isSome() then return
		val kind = &self.state.body.exprs[id].kind
		// A closure lent for one call keeps its environment in this frame; an
		// owned one is on the heap.
		if kind is .Closure(..) {
			found = .Some((self.state.body.exprs[id].span, "closure"))
			return
		}
		if kind is .Ref(inner) && self.rootsHere(inner) {
			found = .Some((self.state.body.exprs[id].span, "reference"))
			return
		}
		for child in kind.children() {
			self.frameReference(child, &var found)
		}
	}

	/// Whether a place stands in this frame, rather than behind a reference
	/// the function was given.
	fn rootsHere(id: ExprId): bool = match self.state.body.exprs[id].kind {
		.Local(local) => self.kind(self.state.body.locals[local].ty) !is .Ref(..)
		.Field(base, ..) | .Index(base, ..) | .SubSlice(base, ..) => self.rootsHere(base)
		// A dereference reaches what the reference points to, which is another
		// frame's.
		.Deref(_) => false
		// A temporary of this call: it lives in this frame.
		_ => true
	}

	/// `become f(args)`: the call, checked as the function's value, and
	/// recorded as one that takes the function's frame. What may not be is
	/// said here; what the frame still holds, the move checker says.
	var fn becomeCall(call: ast::ExprId, span: Span): ExprId = {
		val keyword = Span::new(span.lo, span.lo + 6)
		// Where there is no function's frame of the signature to give.
		val around: Option<str> = when {
			self.state.lambda => .Some("a lambda")
			self.state.generator.isSome() => .Some("a generator")
			self.kind(self.state.ret) is .Ref(..) => .Some("a projection")
			else => .None
		}
		if around is .Some(what) {
			self.report(
				Diagnostic::error(
					NOT_A_TAIL_CALL,
					"`become` cannot be written in \(what)",
					keyword,
					"in \(what)",
				).withNote("`become` gives a function's frame to the call, and \(what) has none of its own to give").withHelp(
					"write `return`",
				),
			)
			// Checked as `return` would check it, which says a lambda's result.
			return match self.returnValue(.Some(call), span) {
				.Some(returned) => returned
				.None => self.errorExpr(span)
			}
		}
		val value = self.check(call, self.state.ret)
		if self.isPoisoned(self.tyOf(value)) then return value
		val .Call(callee, args, typeArgs, ..) = self.state.body.exprs[value].kind.clone() else {
			self.report(
				Diagnostic::error(
					NOT_A_TAIL_CALL,
					"`become` needs a function called by its name",
					self.state.body.exprs[value].span,
					"not a call of a function by its name",
				).withNote(
					"a closure, a function value and a `dyn` method are called through an address, and only a call of a function by its name can take the frame",
				).withHelp("write `return`"),
			)
			return value
		}
		val def = &self.program.fns[callee]
		val name = String::of(self.text(def.name))
		val exportsC = match self.state.function {
			.Some(id) => self.program.fns[id].exportsC
			.None => false
		}
		val refused: Option<str> = when {
			def.isExtern || def.isVariadic => .Some("a C function, which takes C's frame")
			def.exportsC != exportsC => .Some(
				"a function called as C calls it, or not, where this one is the other",
			)
			def.isInline => .Some("an `@inline` function, which has no call to become")
			def.intrinsic.isSome() => .Some("a function the compiler writes in place")
			else => .None
		}
		if refused is .Some(what) {
			self.report(
				Diagnostic::error(
					NOT_A_TAIL_CALL,
					"`become` cannot call `\(name)`",
					self.state.body.exprs[value].span,
					"\(what)",
				).withHelp("write `return`"),
			)
			return value
		}
		// The call takes the frame, so it takes what the function was given.
		val typeArgsList = self.program.types.list(typeArgs).toVec()
		var theirs: Vec<Ty> = Vec()
		for param in def.params {
			theirs.push(self.program.types.subst(param.ty, &typeArgsList))
		}
		val answers = self.program.types.subst(def.ret, &typeArgsList)
		var mine: Vec<Ty> = Vec()
		for param in self.state.body.params {
			mine.push(self.state.body.locals[param].ty)
		}
		if theirs != mine || answers != self.state.ret {
			val declared = def.nameSpan
			self.report(
				Diagnostic::error(
					BECOME_SIGNATURE,
					"`\(name)` \(self.signatureText(&theirs, answers)), and this function \(self.signatureText(&mine, self.state.ret))",
					self.state.body.exprs[value].span,
					"would take this function's frame",
				).withSecondary(declared, "`\(name)` declared here").
					withNote(
						"the call takes the caller's frame, so it takes what the caller was given, in its order, and answers what the caller answers",
					).
					withHelp("write `return`, which makes a call of its own"),
			)
			return value
		}
		// A value passed by the address of its place must be in a frame that
		// outlives this one.
		for (i, arg) in args.forwards().enumerate() {
			if i >= theirs.len() then break
			if !isAggregate(&self.program, theirs[i]) || self.passedOn(arg) then continue
			val ty = self.tyName(theirs[i])
			self.report(
				Diagnostic::error(
					BECOME_AGGREGATE,
					"this \(ty) is made in this frame, which is gone before `\(name)` reads it",
					self.state.body.exprs[arg].span,
					"passed by the address of its place",
				).withNote(
					"a struct, an enum, an array, a `str` and a slice are passed by the address of their place; a parameter passed on is in the frame of the caller's caller",
				).withHelp(
					"keep the value where the caller's caller can lend it, and pass `&` or `&var` of it",
				),
			)
			return value
		}
		if self.borrowsFrame(
			value,
			"takes",
			"`become` gives this frame to the call, so nothing in it is there when the call runs",
		) {
			return value
		}
		self.state.body.becomes.push(value)
		return value
	}

	/// Whether an argument is a parameter of the function passed on as it
	/// is, in the frame of the caller's caller.
	fn passedOn(arg: ExprId): bool = match self.state.body.exprs[arg].kind {
		.Local(local) => self.state.body.params.contains(&local)
		_ => false
	}

	/// `(u64, i64)` and what it answers, for a message.
	fn signatureText(params: &[Ty], ret: Ty): String = {
		var names: Vec<String> = Vec()
		for param in params {
			names.push(self.program.tyName(param, self.interner))
		}
		val answered = if ret == UNIT then String::of("nothing") else self.tyName(ret)
		return "takes `(\(names.join(", ")))` and answers \(answered)"
	}

	/// An `@inline` function's `become`s: each would leave the function it is
	/// spliced into.
	var fn inlineBecomes(id: FnId) = {
		val span = self.state.body.exprs[self.state.body.becomes[0]].span
		self.report(
			Diagnostic::error(
				NOT_A_TAIL_CALL,
				"an `@inline` function cannot `become`",
				span,
				"would leave the function it is spliced into",
			).withSecondary(self.program.fns[id].nameSpan, "`@inline` here").withHelp(
				"write `return`, or leave out `@inline`",
			),
		)
	}
}
