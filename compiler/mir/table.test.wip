// The bytes of constants as the program keeps them.

import syntax::{Interner}

/// The bytes of the constant `name` that `text` declares, and the program's
/// interner.
fn bytesOf(text: str, name: str, littleEndian: bool): (TableBytes, Interner) = {
	val (program, interner) = lowered(text)
	for id in program.consts.ids() {
		val def = &program.consts[id]
		if interner.resolve(def.name) != name then continue
		val .Some(value) = def.value else {
			panic("worked out")
		}
		var layouts = Layouts::new()
		val table = tableBytes(&program, &interner, &var layouts, &value, def.ty, littleEndian)
		return (move table, move interner)
	}
	panic("`\(name)` is declared")
}

/// `count` zeros, with `bytes` at the offsets they are paired with.
fn zerosWith(count: i64, bytes: &[(i64, i64)]): Vec<u8> = {
	var all = Vec::filled(count, 0 as u8)
	for (at, byte) in bytes {
		all[at] = byte as u8
	}
	return move all
}

/// Each field where the struct's layout puts it, with the padding between
/// them zero, in the target's order of bytes.
@test
fn aStructIsWrittenWhereItsLayoutPutsEachField() = {
	val text =
		"struct Mixed { small: u8, big: i64, middle: u16 }\nval M: Mixed = Mixed { small: 1, big: 2, middle: 3 }\n"
	val (little, _) = bytesOf(text, "M", true)
	assert(little.bytes == zerosWith(24, [(0, 1), (8, 2), (16, 3)]))
	val (big, _) = bytesOf(text, "M", false)
	assert(big.bytes == zerosWith(24, [(0, 1), (15, 2), (17, 3)]))
}

/// A variant's number in its tag, and its fields where the enum's layout puts
/// them.
@test
fn aVariantIsItsTagAndItsFields() = {
	val (table, _) = bytesOf(
		"enum Shape { Dot, Circle(r: i64) }\nval S: Shape = .Circle(r: 5)\n",
		"S",
		true,
	)
	assert(table.bytes == zerosWith(16, [(0, 1), (8, 5)]))
}

/// An array's elements a stride apart, and floats and a `bool` in their own
/// widths.
@test
fn anArrayIsItsElementsAStrideApart() = {
	val text =
		"struct Pair { ratio: f32, on: bool }\nval P: [Pair; 2] = [Pair { ratio: 1.5, on: true }, Pair { ratio: -2.0, on: false }]\n"
	val (table, _) = bytesOf(text, "P", true)
	// 1.5 is 0x3FC00000 and -2.0 is 0xC0000000, low byte first.
	assert(table.bytes.items() == [0, 0, 0xC0, 0x3F, 1, 0, 0, 0, 0, 0, 0, 0xC0, 0, 0, 0, 0])
}

/// A `str` leaves its address to the backend and writes its length; a
/// `cstring` is its address alone.
@test
fn aStringIsLeftForItsAddress() = {
	val text = "val WORDS: [str; 2] = [\"a\", \"hello\"]\nval C: [cstring; 1] = [\"x\"]\n"
	val (table, interner) = bytesOf(text, "WORDS", true)
	assert(table.strings.len() == 2)
	assert(table.strings[0].0 == 0 && interner.resolve(table.strings[0].1) == "a")
	assert(table.strings[1].0 == 16 && interner.resolve(table.strings[1].1) == "hello")
	assert(table.bytes.items()[8..16] == [1, 0, 0, 0, 0, 0, 0, 0])
	assert(table.bytes.items()[24..32] == [5, 0, 0, 0, 0, 0, 0, 0])
	val (cstrings, _) = bytesOf(text, "C", true)
	assert(cstrings.bytes == Vec::filled(8, 0 as u8))
	assert(cstrings.strings.len() == 1)
}
