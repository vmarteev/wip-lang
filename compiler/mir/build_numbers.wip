// `count`, `fromIndex`, `all`, `name` and `fromName`: what an enum whose
// variants carry nothing gets.
//
// Such an enum is which variant it holds, and nothing else, so the number of
// its variants is a constant, the variant with a given number is a switch
// over the numbers it has, and so is the name of the one held.

import hir::{BOOL, I32, I64, STR, Ty, VariantDef}
import syntax::{Symbol}

/// Where the prelude's `Option` writes its two variants.
val SOME: u32 = 0
val NONE: u32 = 1

extend Builder {
	/// `static fn count(): i64`: how many variants the enum has.
	var fn countFn(count: u64) = {
		val ret = self.newLocal(I64, .Return)
		self.ret = ret
		self.assign(Place::of(ret), .Use(.Const(.Int(bits: count, ty: I64))))
		self.terminate(.Return)
	}

	/// `static fn all(): [Self; count]`: each element is the variant with its
	/// number.
	var fn allVariantsFn(ty: Ty, array: Ty) = {
		val ret = self.newLocal(array, .Return)
		self.ret = ret
		val at = self.newLocal(I64, .Var)
		for variant in 0..(self.variantsOf(ty).len() as u32) {
			self.assign(Place::of(at), .Use(.Const(.Int(bits: variant, ty: I64))))
			val element = Place::of(ret).project(.Index(at))
			self.push(.SetVariant(place: element, variant:))
		}
		self.terminate(.Return)
	}

	/// `static fn fromIndex(index: i64): Option<Self>`: the variant with that
	/// number, or nothing where the enum has no such variant.
	var fn indexToVariantFn(ty: Ty, option: Ty) = {
		val index = self.newLocal(I64, .Param)
		self.params.push(index)
		val ret = self.newLocal(option, .Return)
		self.ret = ret
		val count = self.variantsOf(ty).len() as u32
		// A number no variant has answers nothing, which is also what the
		// switch's other cases answer.
		val none = self.newBlock()
		val found = self.newLocal(ty, .Var)
		val narrow = self.value(I32, .Cast(operand: .Copy(Place::of(index)), ty: I32))
		val inRange = self.value(BOOL, .Binary(
			op: .Lt,
			lhs: .Copy(Place::of(index)),
			rhs: .Const(.Int(bits: count, ty: I64)),
		))
		val switch = self.newBlock()
		self.terminate(.Branch(cond: inRange, thenBlock: switch, otherwise: none))
		self.switchTo(switch)
		val some = self.newBlock()
		var cases: Vec<(u32, BlockId)> = Vec()
		for variant in 0..count {
			val block = self.newBlock()
			self.switchTo(block)
			self.push(.SetVariant(place: Place::of(found), variant:))
			self.terminate(.Goto(some))
			cases.push((variant, block))
		}
		self.switchTo(switch)
		// A negative number, which the range test did not rule out.
		self.terminate(.Switch(value: narrow, cases:, otherwise: none))
		// `.Some(found)`, whose payload is the variant that was found.
		self.switchTo(some)
		self.push(.SetVariant(place: Place::of(ret), variant: SOME))
		val payload = Place::of(ret).project(.VariantField(variant: SOME, field: 0))
		self.assign(payload, .Use(.Copy(Place::of(found))))
		self.terminate(.Return)
		self.switchTo(none)
		self.push(.SetVariant(place: Place::of(ret), variant: NONE))
		self.terminate(.Return)
	}

	/// `fn name(): str`: the name of the variant `self` holds, as the
	/// declaration writes it. Each name is a literal, kept once in the
	/// program's read-only data.
	var fn variantNameFn(ty: Ty, receiver: Ty) = {
		val this = self.newLocal(receiver, .Param)
		self.params.push(this)
		val ret = self.newLocal(STR, .Return)
		self.ret = ret
		val which = self.value(I32, .Variant(Place::of(this).project(.Deref)))
		val entry = self.current
		val done = self.newBlock()
		var cases: Vec<(u32, BlockId)> = Vec()
		for (variant, name) in self.variantNames(ty).indexed() {
			val block = self.newBlock()
			self.switchTo(block)
			self.assignText(Place::of(ret), name)
			self.terminate(.Goto(done))
			cases.push((variant as u32, block))
		}
		// No value holds a variant the enum does not have.
		val otherwise = self.newBlock()
		self.switchTo(otherwise)
		self.terminate(.Unreachable)
		self.switchTo(entry)
		self.terminate(.Switch(value: which, cases:, otherwise:))
		self.switchTo(done)
		self.terminate(.Return)
	}

	/// `static fn fromName(text: str): Option<Self>`: the variant whose name
	/// is `text`, byte for byte, or nothing where no variant has it.
	var fn nameToVariantFn(ty: Ty, option: Ty) = {
		val text = self.newLocal(STR, .Param)
		self.params.push(text)
		val ret = self.newLocal(option, .Return)
		self.ret = ret
		val found = self.newLocal(ty, .Var)
		val name = Place::of(self.newLocal(STR, .Var))
		val same = Place::of(self.newLocal(BOOL, .Var))
		val some = self.newBlock()
		// Each name is tried in turn, and the first that is `text` is the
		// variant.
		for (variant, written) in self.variantNames(ty).indexed() {
			self.assignText(name.clone(), written)
			self.push(.Call(
				callee: .StrEq,
				args: [
					Operand::Copy(Place::of(text).project(.Field(0))),
					Operand::Copy(Place::of(text).project(.Field(1))),
					Operand::Copy(name.project(.Field(0))),
					Operand::Copy(name.project(.Field(1))),
				],
				dest: same.clone(),
			))
			val matched = self.newBlock()
			val next = self.newBlock()
			self.terminate(.Branch(cond: .Copy(same.clone()), thenBlock: matched, otherwise: next))
			self.switchTo(matched)
			self.push(.SetVariant(place: Place::of(found), variant: variant as u32))
			self.terminate(.Goto(some))
			self.switchTo(next)
		}
		self.push(.SetVariant(place: Place::of(ret), variant: NONE))
		self.terminate(.Return)
		// `.Some(found)`, whose payload is the variant whose name it was.
		self.switchTo(some)
		self.push(.SetVariant(place: Place::of(ret), variant: SOME))
		val payload = Place::of(ret).project(.VariantField(variant: SOME, field: 0))
		self.assign(payload, .Use(.Copy(Place::of(found))))
		self.terminate(.Return)
	}

	/// Writes the `str` of a name into `place`: its bytes, which the program
	/// keeps once, and its length.
	var fn assignText(place: Place, text: Symbol) = {
		val len = self.interner.resolve(text).len() as u128
		self.assign(place.project(.Field(0)), .Use(.Const(.CStr(text))))
		self.assign(place.project(.Field(1)), .Use(Builder::int(len, I64)))
	}

	/// The names of an enum type's variants, in order.
	fn variantNames(ty: Ty): Vec<Symbol> = {
		val names: Vec<Symbol> = [
			for variant in self.variantsOf(ty) do
				yield variant.name
		]
		return names
	}

	/// The variants of an enum type.
	fn variantsOf(ty: Ty): &[VariantDef] = match self.kind(ty) {
		.Enum(id, ..) => lend self.program.enums[id].variants.items()
		_ => panic("an enum's number is asked of an enum")
	}
}
