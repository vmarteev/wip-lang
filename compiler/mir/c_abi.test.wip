// How C passes a struct, piece by piece, on each processor.

fn part(offset: u32, reg: Reg): Part = Part(offset: offset, reg: reg)

/// Two floats side by side are two floating registers on arm64, and one SSE
/// register on x86-64.
@test
fn vector2IsTwoFloatsOnArm64AndOneSseRegisterOnX86_64() = {
	val v2 = [(0 as u32, 4 as u32, Leaf::F32), (4, 4, .F32)]
	assert(pieces(.Arm64, 8, &v2) == Option::Some(Vec::of(own [part(0, .F32), part(4, .F32)])))
	assert(pieces(.X86_64, 8, &v2) == Option::Some(Vec::of(own [part(0, .F64)])))
}

@test
fn vector3SplitsOnX86_64IntoAPairAndAFloat() = {
	val v3 = [(0 as u32, 4 as u32, Leaf::F32), (4, 4, .F32), (8, 4, .F32)]
	assert(pieces(.X86_64, 12, &v3) == Option::Some(Vec::of(own [part(0, .F64), part(8, .F32)])))
	assert(pieces(.Arm64, 12, &v3).unwrap().len() == 3)
}

@test
fn colorIsOneIntegerRegister() = {
	val color = [(0 as u32, 1 as u32, Leaf::Int), (1, 1, .Int), (2, 1, .Int), (3, 1, .Int)]
	assert(pieces(.Arm64, 4, &color) == Option::Some(Vec::of(own [part(0, .I64)])))
	assert(pieces(.X86_64, 4, &color) == Option::Some(Vec::of(own [part(0, .I64)])))
}

@test
fn aMixedEightbyteIsInteger() = {
	val mixed = [(0 as u32, 4 as u32, Leaf::F32), (4, 4, .Int), (8, 8, .F64)]
	assert(pieces(.X86_64, 16, &mixed) == Option::Some(Vec::of(own [part(0, .I64), part(8, .F64)])))
	// Not homogeneous, so its bytes, in two general registers.
	assert(pieces(.Arm64, 16, &mixed) == Option::Some(Vec::of(own [part(0, .I64), part(8, .I64)])))
}

@test
fn fourDoublesAreRegistersOnArm64AndMemoryOnX86_64() = {
	val v4d = [(0 as u32, 8 as u32, Leaf::F64), (8, 8, .F64), (16, 8, .F64), (24, 8, .F64)]
	assert(pieces(.Arm64, 32, &v4d).unwrap().len() == 4)
	assert(pieces(.X86_64, 32, &v4d).isNone())
}

@test
fn fiveFloatsAreNotHomogeneous() = {
	val five = [
		(0 as u32, 4 as u32, Leaf::F32),
		(4, 4, .F32),
		(8, 4, .F32),
		(12, 4, .F32),
		(16, 4, .F32),
	]
	assert(pieces(.Arm64, 20, &five).isNone())
}

@test
fn mixedFloatsAreNotHomogeneous() = {
	val mixed = [(0 as u32, 4 as u32, Leaf::F32), (8, 8, .F64)]
	assert(pieces(.Arm64, 16, &mixed) == Option::Some(Vec::of(own [part(0, .I64), part(8, .I64)])))
	assert(pieces(.X86_64, 16, &mixed) == Option::Some(Vec::of(own [part(0, .F32), part(8, .F64)])))
}

@test
fn aSpilledFloatingStructIsItsMembersOnAppleAndItsBytesOnLinux() = {
	val v3 = Vec::of(own [part(0, .F32), part(4, .F32), part(8, .F32)])
	assert(spilled(.AppleArm64, 12, v3.clone()) == v3)
	assert(spilled(.Arm64, 12, v3.clone()) == Vec::of(own [part(0, .F64), part(8, .F64)]))
}

@test
fn aSpilledIntegerStructIsItsEightBytePiecesEverywhere() = {
	val pair = Vec::of(own [part(0, .I64), part(8, .I64)])
	assert(spilled(.AppleArm64, 16, pair.clone()) == pair)
	assert(spilled(.Arm64, 16, pair.clone()) == pair)
}

/// `union { float a; float b[2]; }`: two floats' worth, not three.
@test
fn aUnionOfFloatsIsCountedByItsSize() = {
	val overlapping = [(0 as u32, 4 as u32, Leaf::F32), (0, 4, .F32), (4, 4, .F32)]
	assert(
		pieces(.Arm64, 8, &overlapping) ==
			Option::Some(Vec::of(own [part(0, .F32), part(4, .F32)])),
	)
	assert(pieces(.X86_64, 8, &overlapping) == Option::Some(Vec::of(own [part(0, .F64)])))
}

/// `union { float f; double d; }`
@test
fn aUnionOfTwoFloatingTypesIsNotHomogeneous() = {
	val mixed = [(0 as u32, 4 as u32, Leaf::F32), (0, 8, .F64)]
	assert(pieces(.Arm64, 8, &mixed) == Option::Some(Vec::of(own [part(0, .I64)])))
	assert(pieces(.X86_64, 8, &mixed) == Option::Some(Vec::of(own [part(0, .F64)])))
}

/// `union { float f; int32_t i; }`
@test
fn anIntegerOverAFloatMakesTheEightbyteInteger() = {
	val merged = [(0 as u32, 4 as u32, Leaf::F32), (0, 4, .Int)]
	assert(pieces(.X86_64, 4, &merged) == Option::Some(Vec::of(own [part(0, .I64)])))
	assert(pieces(.Arm64, 4, &merged) == Option::Some(Vec::of(own [part(0, .I64)])))
}
