// Rewriting the places a body names.
//
// The frame, inlining, simplifying and splitting scalars each change where
// statements read and write, and nothing else. What they share is the walk:
// each statement and terminator is taken apart, its places rewritten, and put
// back together. The places are visited in the order the statement uses them:
// what it reads first, then what it writes.

/// How the places of a statement are rewritten.
pub interface Rewrite {
	/// A place that is read, or whose address or variant is.
	var fn read(place: Place): Place

	/// A place that is written, or checked before it is: the place a drop
	/// reads and zeroes.
	var fn written(place: Place): Place

	/// Whether the value a call calls is rewritten too.
	fn rewritesCallee(): bool
}

pub fn rewriteOperand<R: Rewrite>(operand: Operand, rewrite: &var R): Operand = match move operand {
	.Copy(place) => .Copy(rewrite.read(place))
	.Const(value) => .Const(move value)
}

pub fn rewriteRvalue<R: Rewrite>(rvalue: Rvalue, rewrite: &var R): Rvalue = match move rvalue {
	.Use(operand) => .Use(rewriteOperand(operand, &var rewrite))
	.Unary(op, operand) => .Unary(op: op, operand: rewriteOperand(operand, &var rewrite))
	.Cast(operand, ty) => .Cast(operand: rewriteOperand(operand, &var rewrite), ty: ty)
	.CstrLen(operand) => .CstrLen(rewriteOperand(operand, &var rewrite))
	.Float(op, operand) => .Float(op: op, operand: rewriteOperand(operand, &var rewrite))
	.Integer(op, operand) => .Integer(op: op, operand: rewriteOperand(operand, &var rewrite))
	.Bits(operand) => .Bits(rewriteOperand(operand, &var rewrite))
	.VTableFn(table, index, methods) => .VTableFn(
		table: rewriteOperand(table, &var rewrite),
		index: index,
		methods: methods,
	)
	.Binary(op, lhs, rhs) => {
		val left = rewriteOperand(lhs, &var rewrite)
		Rvalue::Binary(op: op, lhs: left, rhs: rewriteOperand(rhs, &var rewrite))
	}
	.Rotate(turn, lhs, rhs) => {
		val left = rewriteOperand(lhs, &var rewrite)
		Rvalue::Rotate(turn: turn, lhs: left, rhs: rewriteOperand(rhs, &var rewrite))
	}
	.Overflows(op, lhs, rhs) => {
		val left = rewriteOperand(lhs, &var rewrite)
		Rvalue::Overflows(op: op, lhs: left, rhs: rewriteOperand(rhs, &var rewrite))
	}
	.MulAdd(first, second, third) => {
		val a = rewriteOperand(first, &var rewrite)
		val b = rewriteOperand(second, &var rewrite)
		Rvalue::MulAdd(first: a, second: b, third: rewriteOperand(third, &var rewrite))
	}
	.AddressOf(place) => .AddressOf(rewrite.read(place))
	.Variant(place) => .Variant(rewrite.read(place))
}

fn rewriteOptionalOperand<R: Rewrite>(
	operand: Option<Operand>,
	rewrite: &var R,
): Option<Operand> = match move operand {
	.Some(o) => .Some(rewriteOperand(o, &var rewrite))
	.None => .None
}

fn rewriteDest<R: Rewrite>(dest: Option<Place>, rewrite: &var R): Option<Place> = match move dest {
	.Some(place) => .Some(rewrite.written(place))
	.None => .None
}

pub fn rewriteStatement<R: Rewrite>(
	statement: Statement,
	rewrite: &var R,
): Statement = match move statement {
	.Assign(place, rvalue) => {
		val value = rewriteRvalue(rvalue, &var rewrite)
		Statement::Assign(place: rewrite.written(place), rvalue: value)
	}
	.SetVariant(place, variant) => .SetVariant(place: rewrite.written(place), variant: variant)
	.Zero(place) => .Zero(rewrite.written(place))
	.Poison(place) => .Poison(rewrite.written(place))
	.DropInPlace(ty, place) => .DropInPlace(ty: ty, place: rewrite.written(place))
	.CheckMoved(place, at) => .CheckMoved(place: rewrite.written(place), at: at)
	.Arith(dest, op, lhs, rhs, at) => {
		val left = rewriteOperand(lhs, &var rewrite)
		val right = rewriteOperand(rhs, &var rewrite)
		Statement::Arith(dest: rewrite.written(dest), op: op, lhs: left, rhs: right, at: at)
	}
	.Call(callee, args, dest) => {
		val called = if rewrite.rewritesCallee() {
			match move callee {
				.Value(operand) => Callee::Value(rewriteOperand(operand, &var rewrite))
				other => other
			}
		} else callee
		var rewritten: Vec<Operand> = Vec()
		for arg in move args {
			rewritten.push(rewriteOperand(arg, &var rewrite))
		}
		.Call(callee: called, args: rewritten, dest: rewriteDest(dest, &var rewrite))
	}
	.Alloc(dest, ty) => .Alloc(dest: rewrite.written(dest), ty: ty)
	.AllocBuffer(dest, elem, count) => {
		val counted = rewriteOperand(count, &var rewrite)
		Statement::AllocBuffer(dest: rewrite.written(dest), elem: elem, count: counted)
	}
	.Atomic(op, order, ty, address, value, expected, dest) => {
		val at = rewriteOperand(address, &var rewrite)
		val given = rewriteOptionalOperand(value, &var rewrite)
		val wanted = rewriteOptionalOperand(expected, &var rewrite)
		Statement::Atomic(
			op: op,
			order: order,
			ty: ty,
			address: at,
			value: given,
			expected: wanted,
			dest: rewriteDest(dest, &var rewrite),
		)
	}
	.Free(operand) => .Free(rewriteOperand(operand, &var rewrite))
	.DropFn(ty, ptr) => .DropFn(ty: ty, ptr: rewriteOperand(ptr, &var rewrite))
	.ErrorStep(made, function, at) => .ErrorStep(made: made, function: function, at: at)
	.At(span) => .At(span)
	.Fence(order) => .Fence(order)
	.Check(fails, kind, at) => {
		val failing = rewriteOperand(fails, &var rewrite)
		val reported: CheckKind = match move kind {
			.Bounds(index, length) => {
				val i = rewriteOperand(index, &var rewrite)
				CheckKind::Bounds(index: i, length: rewriteOperand(length, &var rewrite))
			}
			.Length(length) => .Length(rewriteOperand(length, &var rewrite))
			other => other
		}
		Statement::Check(fails: failing, kind: reported, at: at)
	}
}

/// The operands a terminator reads, rewritten; where it goes is left alone.
pub fn rewriteTerminator<R: Rewrite>(
	terminator: Terminator,
	rewrite: &var R,
): Terminator = match move terminator {
	.Branch(cond, thenBlock, otherwise) => .Branch(
		cond: rewriteOperand(cond, &var rewrite),
		thenBlock: thenBlock,
		otherwise: otherwise,
	)
	.Switch(value, cases, otherwise) => .Switch(
		value: rewriteOperand(value, &var rewrite),
		cases: cases,
		otherwise: otherwise,
	)
	.Panic(note, message, at) => .Panic(
		note: rewriteOptionalOperand(note, &var rewrite),
		message: message,
		at: at,
	)
	.TailCall(callee, args) => {
		var rewritten: Vec<Operand> = Vec()
		for arg in move args {
			rewritten.push(rewriteOperand(arg, &var rewrite))
		}
		.TailCall(callee: callee, args: rewritten)
	}
	other => other
}
