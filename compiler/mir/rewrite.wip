// Rewriting the places a body names.
//
// The frame, inlining, simplifying and splitting scalars each change where
// statements read and write, and nothing else. What they share is the walk:
// each statement and terminator is taken apart, its places rewritten, and put
// back together. The places are visited in the order the statement uses them:
// what it reads first, then what it writes.

/// How the places of a statement are rewritten.
pub interface Rewrite {
	/// A place that is read, or whose address or variant is.
	var fn read(place: Place): Place

	/// A place that is written, or checked before it is: the place a drop
	/// reads and zeroes.
	var fn written(place: Place): Place

	/// Whether the value a call calls is rewritten too.
	fn rewritesCallee(): bool
}

pub fn rewriteOperand<R: Rewrite>(operand: Operand, rewrite: &var R): Operand = match move operand {
	.Copy(place) => .Copy(rewrite.read(move place))
	.Const(value) => .Const(move value)
}

pub fn rewriteRvalue<R: Rewrite>(rvalue: Rvalue, rewrite: &var R): Rvalue = match move rvalue {
	.Use(operand) => .Use(rewriteOperand(move operand, &var rewrite))
	.Unary(op, operand) => .Unary(op: op, operand: rewriteOperand(move operand, &var rewrite))
	.Cast(operand, ty) => .Cast(operand: rewriteOperand(move operand, &var rewrite), ty: ty)
	.CstrLen(operand) => .CstrLen(rewriteOperand(move operand, &var rewrite))
	.Float(op, operand) => .Float(op: op, operand: rewriteOperand(move operand, &var rewrite))
	.Integer(op, operand) => .Integer(op: op, operand: rewriteOperand(move operand, &var rewrite))
	.Bits(operand) => .Bits(rewriteOperand(move operand, &var rewrite))
	.VTableFn(table, index, methods) => .VTableFn(
		table: rewriteOperand(move table, &var rewrite),
		index: index,
		methods: methods,
	)
	.Binary(op, lhs, rhs) => {
		val left = rewriteOperand(move lhs, &var rewrite)
		.Binary(op: op, lhs: move left, rhs: rewriteOperand(move rhs, &var rewrite))
	}
	.Rotate(turn, lhs, rhs) => {
		val left = rewriteOperand(move lhs, &var rewrite)
		.Rotate(turn: turn, lhs: move left, rhs: rewriteOperand(move rhs, &var rewrite))
	}
	.Overflows(op, lhs, rhs) => {
		val left = rewriteOperand(move lhs, &var rewrite)
		.Overflows(op: op, lhs: move left, rhs: rewriteOperand(move rhs, &var rewrite))
	}
	.MulAdd(first, second, third) => {
		val a = rewriteOperand(move first, &var rewrite)
		val b = rewriteOperand(move second, &var rewrite)
		.MulAdd(first: move a, second: move b, third: rewriteOperand(move third, &var rewrite))
	}
	.AddressOf(place) => .AddressOf(rewrite.read(move place))
	.Variant(place) => .Variant(rewrite.read(move place))
}

fn rewriteOptionalOperand<R: Rewrite>(
	operand: Option<Operand>,
	rewrite: &var R,
): Option<Operand> = match move operand {
	.Some(o) => .Some(rewriteOperand(move o, &var rewrite))
	.None => .None
}

fn rewriteDest<R: Rewrite>(dest: Option<Place>, rewrite: &var R): Option<Place> = match move dest {
	.Some(place) => .Some(rewrite.written(move place))
	.None => .None
}

pub fn rewriteStatement<R: Rewrite>(
	statement: Statement,
	rewrite: &var R,
): Statement = match move statement {
	.Assign(place, rvalue) => {
		val value = rewriteRvalue(move rvalue, &var rewrite)
		.Assign(place: rewrite.written(move place), rvalue: move value)
	}
	.SetVariant(place, variant) => .SetVariant(place: rewrite.written(move place), variant: variant)
	.Zero(place) => .Zero(rewrite.written(move place))
	.Poison(place) => .Poison(rewrite.written(move place))
	.DropInPlace(ty, place) => .DropInPlace(ty: ty, place: rewrite.written(move place))
	.CheckMoved(place, at) => .CheckMoved(place: rewrite.written(move place), at: at)
	.Arith(dest, op, lhs, rhs, at) => {
		val left = rewriteOperand(move lhs, &var rewrite)
		val right = rewriteOperand(move rhs, &var rewrite)
		.Arith(dest: rewrite.written(move dest), op: op, lhs: move left, rhs: move right, at: at)
	}
	.Call(callee, args, dest) => {
		val called = if rewrite.rewritesCallee() {
			match move callee {
				.Value(operand) => Callee::Value(rewriteOperand(move operand, &var rewrite))
				other => move other
			}
		} else {
			move callee
		}
		var rewritten: Vec<Operand> = Vec()
		for arg in move args {
			rewritten.push(rewriteOperand(move arg, &var rewrite))
		}
		.Call(callee: move called, args: move rewritten, dest: rewriteDest(move dest, &var rewrite))
	}
	.Alloc(dest, ty) => .Alloc(dest: rewrite.written(move dest), ty: ty)
	.AllocBuffer(dest, elem, count) => {
		val counted = rewriteOperand(move count, &var rewrite)
		.AllocBuffer(dest: rewrite.written(move dest), elem: elem, count: move counted)
	}
	.Atomic(op, ty, address, value, expected, dest) => {
		val at = rewriteOperand(move address, &var rewrite)
		val given = rewriteOptionalOperand(move value, &var rewrite)
		val wanted = rewriteOptionalOperand(move expected, &var rewrite)
		.Atomic(
			op: op,
			ty: ty,
			address: move at,
			value: move given,
			expected: move wanted,
			dest: rewriteDest(move dest, &var rewrite),
		)
	}
	.Free(operand) => .Free(rewriteOperand(move operand, &var rewrite))
	.DropFn(ty, ptr) => .DropFn(ty: ty, ptr: rewriteOperand(move ptr, &var rewrite))
	.At(span) => .At(span)
	.Check(fails, kind, at) => {
		val failing = rewriteOperand(move fails, &var rewrite)
		val reported: CheckKind = match move kind {
			.Bounds(index, length) => {
				val i = rewriteOperand(move index, &var rewrite)
				.Bounds(index: move i, length: rewriteOperand(move length, &var rewrite))
			}
			.Length(length) => .Length(rewriteOperand(move length, &var rewrite))
			other => move other
		}
		.Check(fails: move failing, kind: move reported, at: at)
	}
}

/// The operands a terminator reads, rewritten; where it goes is left alone.
pub fn rewriteTerminator<R: Rewrite>(
	terminator: Terminator,
	rewrite: &var R,
): Terminator = match move terminator {
	.Branch(cond, thenBlock, otherwise) => .Branch(
		cond: rewriteOperand(move cond, &var rewrite),
		thenBlock: thenBlock,
		otherwise: otherwise,
	)
	.Switch(value, cases, otherwise) => .Switch(
		value: rewriteOperand(move value, &var rewrite),
		cases: move cases,
		otherwise: otherwise,
	)
	.Panic(note, message, at) => .Panic(
		note: rewriteOptionalOperand(move note, &var rewrite),
		message: message,
		at: at,
	)
	other => move other
}
