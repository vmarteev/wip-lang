// Checks a body's structure. A malformed body is a bug in the builder, so a
// problem panics with a description of it.

/// Checks that every local and block `body` names exists, that its parameters
/// and result are locals of the right kind, and that no switch lists a case
/// twice.
pub fn validate(body: &Body) = {
	var check = Validator(locals: body.locals.len(), blocks: body.blocks.len())
	for param in body.params {
		check.local(param, "a parameter")
		if body.local(param).kind != .Param then
			panic("parameter _\(param.index) is a local of another kind")
	}
	if body.ret is .Some(ret) {
		check.local(ret, "the result")
		if body.local(ret).kind != .Return then
			panic("the result _\(ret.index) is a local of another kind")
	}
	for block in body.blocks {
		for statement in block.statements {
			rewriteStatement(statement.clone(), &var check)
		}
		rewriteTerminator(block.terminator.clone(), &var check)
		match block.terminator {
			.Goto(target) => check.target(target)
			.Branch(thenBlock, otherwise, ..) => {
				check.target(thenBlock)
				check.target(otherwise)
			}
			.Switch(cases, otherwise, ..) => {
				for (i, (case, target)) in cases.forwards().enumerate() {
					for j in 0..i {
						if cases[j].0 == case then panic("a switch lists case \(case) twice")
					}
					check.target(target)
				}
				check.target(otherwise)
			}
			.Panic(..) | .Return | .Unreachable => {}
		}
	}
}

/// How many locals and blocks a body has, to check what it names against.
struct Validator {
	locals: i64
	blocks: i64
}

extend Validator {
	fn local(local: Local, what: str) = {
		if local.index as i64 >= self.locals then
			panic("\(what) names local _\(local.index) of \(self.locals)")
	}

	fn target(block: BlockId) = {
		if block.index as i64 >= self.blocks || block.index == 0 then
			panic("a jump to block \(block.index) of \(self.blocks), or to the entry")
	}

	fn place(place: &Place) = {
		self.local(place.local, "a place")
		for projection in place.projections {
			if projection is .Index(index) then self.local(index, "an index")
		}
	}
}

extend Validator: Rewrite {
	var fn read(place: Place): Place = {
		self.place(&place)
		return move place
	}

	var fn written(place: Place): Place = {
		self.place(&place)
		return move place
	}

	fn rewritesCallee(): bool = true
}
