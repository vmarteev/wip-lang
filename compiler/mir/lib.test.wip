// The MIR of small programs, against the text it is for each: a change to
// it is a change to what every backend compiles.

import hir::{ConstValue, FnId, Program, Ty, TyList, lowerFile}
import syntax::{EVALUATION_TOO_LONG, Interner, Span, lex, parse}

/// The program `text` declares, which must check, and its interner.
fn lowered(text: str): (Program, Interner) = {
	var interner = Interner::new()
	val lexed = lex(text, &var interner)
	val parsed = parse(text, &lexed)
	val checked = lowerFile(&parsed.ast, &interner)
	for d in checked.diagnostics {
		assert(!d.isError(), d.message.toStr())
	}
	return (move checked.program, move interner)
}

/// The function `name` declares.
fn named(program: &Program, interner: &Interner, name: str): FnId = {
	for id in program.fns.ids() {
		if interner.resolve(program.fns[id].name) == name then return id
	}
	panic("`\(name)` is declared")
}

/// What a function lowers to, checked and written out.
fn written(program: &Program, interner: &Interner, id: FnId): String = {
	val def = &program.fns[id]
	val .Some(hir) = def.body else {
		panic("a body")
	}
	val mir = lowerFn(&program, &interner, &def, &hir)
	validate(&mir)
	return dump(&program, &interner, interner.resolve(def.name), &mir)
}

/// Whether `got` is `want`, which a text block holds without its last line
/// break.
fn same(got: str, want: str) = {
	val whole = "\(want)\n"
	assert(got == whole.toStr(), "wrote:\n\(got)\nwanted:\n\(whole)")
}

/// A `defer` and a drop at the end of one block, a bounds check, and a
/// `match` whose arm binds a field by alias.
@test
fn dropsDeferChecksAndMatch() = {
	val (program, interner) = lowered(
		"extern \"C\" {\n    fn wip_print_i64(x: i64)\n}\n\nenum Link {\n    More(value: i64, next: own<Link>)\n    End\n}\n\n// A `defer` and a drop at the end of the same block: the drop comes first,\n// since it was registered last.\nfn scoped(n: i64): i64 = {\n    defer wip_print_i64(n)\n    val list = own Link::More(value: n, next: own Link::End)\n    n\n}\n\n// A bounds check, and a `match` whose arm binds a field by alias.\nfn head(xs: &[i64], link: &Link): i64 = match link {\n    .More(value, ..) => value + xs[0]\n    .End => 0\n}\n",
	)
	var out = String()
	for id in program.fns.ids() {
		if program.fns[id].body.isSome() then out.push(written(&program, &interner, id).toStr())
	}
	same(
		out.toStr(),
		"""
			fn scoped(_0: i64) -> _1: i64 {
			    var _2: own<Link>
			    temp _3: own<Link>
			    temp _4: i64
			    temp _5: own<Link>
			    temp _6: i64
			    temp _7: own<Link>
			    temp _8: i64
			  bb0:
			    _3 = alloc Link
			    set_variant((*_3), 0)
			    _4 = _0
			    ((*_3) as 0).0 = _4
			    _5 = alloc Link
			    set_variant((*_5), 1)
			    ((*_3) as 0).1 = _5
			    _2 = _3
			    _6 = _0
			    _7 = _2
			    drop_fn<Link>(_7)
			    zero(_2)
			    _8 = _0
			    call wip_print_i64(_8)
			    _1 = _6
			    return
			}
			fn head(_0: &[i64], _1: &Link) -> _2: i64 {
			    temp _3: &Link
			    temp _4: i32
			    temp _5: i64
			    var _6: i64
			    temp _7: i64
			    temp _8: i64
			    temp _9: i64
			    temp _10: u64
			    temp _11: u64
			    temp _12: bool
			    temp _13: i64
			    temp _14: i64
			  bb0:
			    _3 = _1
			    _4 = variant((*_3))
			    switch _4 [0: bb2, 1: bb3] else bb4
			  bb1:
			    _2 = _5
			    return
			  bb2:
			    _6 = ((*_3) as 0).0
			    _7 = _6
			    _8 = _0.1
			    _9 = 0_i64
			    _10 = _9 as u64
			    _11 = _8 as u64
			    _12 = _10 >= _11
			    check _12 (Bounds)
			    _13 = _0[_9]
			    _14 = _7 +? _13
			    _5 = _14
			    goto bb1
			  bb3:
			    _5 = 0_i64
			    goto bb1
			  bb4:
			    unreachable
			}
			""",
	)
}

/// The drop function of `own<Link>` follows `next` in a loop, not by calling
/// itself.
@test
fn aDropFunctionLoopsOverAChain() = {
	val (program, interner) = lowered(
		"extern \"C\" {\n    fn wip_print_i64(x: i64)\n}\n\nenum Link {\n    More(value: i64, next: own<Link>)\n    End\n}\n\n// A `defer` and a drop at the end of the same block: the drop comes first,\n// since it was registered last.\nfn scoped(n: i64): i64 = {\n    defer wip_print_i64(n)\n    val list = own Link::More(value: n, next: own Link::End)\n    n\n}\n\n// A bounds check, and a `match` whose arm binds a field by alias.\nfn head(xs: &[i64], link: &Link): i64 = match link {\n    .More(value, ..) => value + xs[0]\n    .End => 0\n}\n",
	)
	var link: Option<Ty> = .None
	for id in program.enums.ids() {
		if interner.resolve(program.enums[id].name) == "Link" then
			link = program.types.find(.Enum(id: id, args: TyList::empty()))
	}
	val mir = lowerDropFn(&program, &interner, link.unwrap())
	validate(&mir)
	val text = dump(&program, &interner, "drop_link", &mir)
	assert(!text.contains("drop_fn<"), "no call to itself")
	same(
		text.toStr(),
		"""
			fn drop_link(_0: own<Link>) {
			    var _1: own<Link>
			    temp _2: bool
			    temp _3: i32
			    temp _4: own<Link>
			  bb0:
			    _1 = _0
			    goto bb1
			  bb1:
			    _2 = _1 == 0_own<Link>
			    branch _2 ? bb3 : bb2
			  bb2:
			    _3 = variant((*_1))
			    switch _3 [0: bb5] else bb4
			  bb3:
			    return
			  bb4:
			    free(_1)
			    return
			  bb5:
			    _4 = ((*_1) as 0).1
			    free(_1)
			    _1 = _4
			    goto bb1
			}
			""",
	)
}

/// A field moved out of a field, whose local then drops only what is left of
/// it; and an arm that took its value out of a temporary and leaves by
/// `break`, after which the temporary is not dropped again.
@test
fn aMoveOutOfAFieldAndOutOfAnArmDropsOnce() = {
	val (program, interner) = lowered(
		"struct Node { value: i64 }\nstruct Inner { kept: own<Node>, left: own<Node> }\nstruct Outer { inner: Inner, other: own<Node> }\nenum Maybe { Some(node: own<Node>), None }\n\nfn made(): Maybe = .Some(own Node { value: 1 })\n\nfn nested() = {\n    val outer = Outer {\n        inner: Inner { kept: own Node { value: 1 }, left: own Node { value: 2 } },\n        other: own Node { value: 3 },\n    }\n    val taken = move outer.inner.kept\n}\n\nfn leaving() = {\n    while true {\n        match made() {\n            .Some(node) => {\n                break\n            }\n            .None => {\n                break\n            }\n        }\n    }\n}\n",
	)
	var out = String()
	for name in ["nested", "leaving"] {
		out.push(written(&program, &interner, named(&program, &interner, name)).toStr())
	}
	same(
		out.toStr(),
		"""
			fn nested() {
			    var _0: Outer
			    temp _1: own<Node>
			    temp _2: own<Node>
			    temp _3: own<Node>
			    var _4: own<Node>
			    temp _5: own<Node>
			    temp _6: own<Node>
			    temp _7: bool
			    temp _8: own<Node>
			    temp _9: bool
			    temp _10: own<Node>
			    temp _11: bool
			    temp _12: own<Node>
			    temp _13: bool
			  bb0:
			    _1 = alloc Node
			    (*_1).0 = 1_i64
			    _0.0.0 = _1
			    _2 = alloc Node
			    (*_2).0 = 2_i64
			    _0.0.1 = _2
			    _3 = alloc Node
			    (*_3).0 = 3_i64
			    _0.1 = _3
			    _5 = _0.0.0
			    zero(_0.0.0)
			    _4 = _5
			    _6 = _4
			    _7 = _6 != 0_own<Node>
			    branch _7 ? bb1 : bb2
			  bb1:
			    free(_6)
			    goto bb2
			  bb2:
			    zero(_4)
			    _8 = _0.1
			    _9 = _8 != 0_own<Node>
			    branch _9 ? bb3 : bb4
			  bb3:
			    free(_8)
			    goto bb4
			  bb4:
			    zero(_0.1)
			    _10 = _0.0.1
			    _11 = _10 != 0_own<Node>
			    branch _11 ? bb5 : bb6
			  bb5:
			    free(_10)
			    goto bb6
			  bb6:
			    zero(_0.0.1)
			    _12 = _0.0.0
			    _13 = _12 != 0_own<Node>
			    branch _13 ? bb7 : bb8
			  bb7:
			    free(_12)
			    goto bb8
			  bb8:
			    zero(_0.0.0)
			    return
			}
			fn leaving() {
			    temp _0: Maybe
			    temp _1: i32
			    var _2: own<Node>
			    temp _3: i32
			    temp _4: own<Node>
			    temp _5: bool
			    temp _6: own<Node>
			    temp _7: bool
			    temp _8: i32
			    temp _9: own<Node>
			    temp _10: bool
			  bb0:
			    goto bb1
			  bb1:
			    branch true ? bb2 : bb3
			  bb2:
			    _0 = call made()
			    _1 = variant(_0)
			    switch _1 [0: bb5, 1: bb6] else bb7
			  bb3:
			    return
			  bb4:
			    unreachable
			  bb5:
			    _2 = (_0 as 0).0
			    zero((_0 as 0).0)
			    _3 = variant(_0)
			    switch _3 [0: bb9] else bb8
			  bb6:
			    _8 = variant(_0)
			    switch _8 [0: bb15] else bb14
			  bb7:
			    unreachable
			  bb8:
			    _6 = _2
			    _7 = _6 != 0_own<Node>
			    branch _7 ? bb12 : bb13
			  bb9:
			    _4 = (_0 as 0).0
			    _5 = _4 != 0_own<Node>
			    branch _5 ? bb10 : bb11
			  bb10:
			    free(_4)
			    goto bb11
			  bb11:
			    zero((_0 as 0).0)
			    goto bb8
			  bb12:
			    free(_6)
			    goto bb13
			  bb13:
			    zero(_2)
			    goto bb3
			  bb14:
			    goto bb3
			  bb15:
			    _9 = (_0 as 0).0
			    _10 = _9 != 0_own<Node>
			    branch _10 ? bb16 : bb17
			  bb16:
			    free(_9)
			    goto bb17
			  bb17:
			    zero((_0 as 0).0)
			    goto bb14
			}
			""",
	)
}

/// A struct copied whole and an enum an inlined call answers: in a release
/// build, no local of either is left, each split into its fields.
@test
fn smallAggregatesBecomeScalars() = {
	val (program, interner) = lowered(
		"struct Pair {\n    a: i64\n    b: f64\n}\n\nenum Maybe {\n    Some(value: i64)\n    Nothing\n}\n\n@inline\nfn found(n: i64): Maybe = if n > 0 { .Some(value: n) } else { .Nothing }\n\n// A struct copied whole and written by field, and an enum an inlined call\n// answers and a `match` takes apart: each split into locals in a release\n// build.\nfn small(n: i64): i64 = {\n    val pair = Pair(a: n, b: 1.5)\n    var copy = pair\n    copy.a += 1\n    match found(copy.a) {\n        .Some(value) => value\n        .Nothing => 0\n    }\n}\n",
	)
	val def = &program.fns[named(&program, &interner, "small")]
	val .Some(hir) = def.body else {
		panic("a body")
	}
	var mir = lowerFn(&program, &interner, &def, &hir)
	inline(&program, &interner, &var mir)
	simplify(&program, &var mir)
	scalars(&program, &var mir)
	validate(&mir)
	for decl in mir.locals {
		assert(
			!(program.types.kind(decl.ty) is .Struct(..) | .Enum(..)),
			program.tyName(decl.ty, &interner).toStr(),
		)
	}
}

/// What `fn take` lowers to, where a debug build drops by call or not: it
/// takes a struct of two owned values and drops it at its end.
fn take(dropsByCall: bool): String = {
	val (checked, interner) = lowered(
		"struct Pair {\n    a: own<i64>\n    b: own<i64>\n}\n\nfn take(pair: Pair) = {}\n",
	)
	var program = move checked
	program.dropsByCall = dropsByCall
	val .Some(body) = functionBody(&program, &interner, named(&program, &interner, "take")) else {
		panic("`take` has a body")
	}
	return dump(&program, &interner, "take", &body)
}

/// A debug build drops a struct by calling the function that drops its type,
/// once; a release build frees each field where it is dropped, for the
/// optimiser to see through.
@test
fn aDebugBuildDropsAStructByACall() = {
	val debug = take(true)
	assert(debug.contains("drop_in_place<Pair>"), debug.toStr())
	assert(!debug.contains("free("), debug.toStr())
	val release = take(false)
	assert(!release.contains("drop_in_place"), release.toStr())
	assert(release.toStr().split("free(").count() == 3, release.toStr())
}

/// A loop that never ends runs out of its budget, and is an error at its
/// constant; one that ends within it is worked out.
@test
fn aConstantHasABudgetOfSteps() = {
	val (checked, read) = lowered(
		"fn spin(): i64 = {\n    var n = 0\n    while true {\n        n += 1\n        n -= 1\n    }\n    return n\n}\n\nfn sum(to: i64): i64 = {\n    var total = 0\n    for i in 0..to {\n        total += i\n    }\n    return total\n}\n\n@comptime\nval FOREVER: i64 = spin()\n@comptime\nval SMALL: i64 = sum(10)\n",
	)
	var program = move checked
	var interner = move read
	val found = evaluateWithin(
		&var program,
		&var interner,
		(at: Span) => (String::of("main.wip"), 0, 0),
		1000,
	)
	assert(found.len() == 1)
	assert(found[0].code == EVALUATION_TOO_LONG)
	var small: Option<ConstValue> = .None
	for id in program.consts.ids() {
		if interner.resolve(program.consts[id].name) == "SMALL" then
			small = program.consts[id].value.clone()
	}
	assert(small == Option::Some(ConstValue::Int(45)))
}

/// What a guard makes is dropped on the paths through the guard, and not
/// where the `match` ends: an arm whose pattern did not match never made it,
/// and would drop whatever its slot held.
@test
fn aGuardDropsWhatItMadeWhereItRan() = {
	val (program, interner) = lowered(
		"struct Node {\n    value: i64\n}\n\nenum Boxed {\n    Full(node: own<Node>)\n    Empty\n}\n\nextend Boxed {\n    fn weight(): i64 = match self {\n        .Full(node) => node.value\n        .Empty => 0\n    }\n}\n\nenum Shape {\n    Named(id: i64)\n    Unnamed\n}\n\nfn boxed(id: i64): Boxed = .Full(node: own Node(value: id))\n\n// A guard that makes a value owning memory: only the paths through the guard\n// may drop it.\nfn describe(shape: &Shape): i64 = match shape {\n    .Named(id) if boxed(id).weight() > 1 => 2\n    .Named(..) => 1\n    .Unnamed => 0\n}\n",
	)
	val def = &program.fns[named(&program, &interner, "describe")]
	val .Some(hir) = def.body else {
		panic("a body")
	}
	val mir = lowerFn(&program, &interner, &def, &hir)
	validate(&mir)
	val unwritten = readsBeforeWrites(&mir)
	assert(unwritten.isEmpty(), dump(&program, &interner, "describe", &mir).toStr())
}
