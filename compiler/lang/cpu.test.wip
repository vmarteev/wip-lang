// The processor a build is for, as `--cpu` names it, of the target's kind.

val IPAD: Target = Target(os: .Ios, arch: .Arm64)
val SIMULATOR: Target = Target(os: .Ios, arch: .Arm64, simulator: true)

@test
fn aProcessorIsNamedAsCompilersNameIt() = {
	val host = Target::host()
	assert(Cpu::parse("native", &host) is .Ok(.Native))
	assert(Cpu::parse("baseline", &host) is .Ok(.Baseline))
	for level in Level::of(&host) {
		assert(Cpu::parse(level.name(), &host) is .Ok(cpu) && cpu == Cpu::Level(level.clone()))
	}
	assert(Cpu::parse("pentium", &host) is .Err(refused) && refused.contains("baseline, native"))
	assert(Cpu::Native.level(&host) == .None)
	assert(Cpu::Baseline.level(&host) == .Some(Level::baseline(&host)))
}

/// An iPad's processors are Apple's own, the A10 the least; the simulator's
/// are the Mac's it runs on; and the device is not this machine.
@test
fn anIpadsProcessorIsItsOwn() = {
	assert(Level::baseline(&IPAD) == .AppleA10)
	assert(Cpu::parse("apple-a10", &IPAD) is .Ok(.Level(.AppleA10)))
	assert(Cpu::parse("apple-m1", &IPAD) is .Err(..))
	assert(Cpu::parse("native", &IPAD) is .Err(refused) && refused.contains("iPad"))
	assert(cpuFlag(Cpu::Baseline, &IPAD) == "-mcpu=apple-a10")
	assert(Level::baseline(&SIMULATOR) == .AppleM1)
	assert(cpuFlag(Cpu::Baseline, &SIMULATOR) == "-mcpu=apple-m1")
	assert(Cpu::parse("native", &SIMULATOR) is .Ok(.Native))
}
