// The processor a build is for, as `--cpu` names it.

@test
fn aProcessorIsNamedAsCompilersNameIt() = {
	assert(Cpu::parse("native") is .Ok(.Native))
	assert(Cpu::parse("baseline") is .Ok(.Baseline))
	for level in Level::ofHost() {
		assert(Cpu::parse(level.name()) is .Ok(cpu) && cpu == Cpu::Level(level.clone()))
	}
	assert(Cpu::parse("pentium") is .Err(refused) && refused.contains("baseline, native"))
	assert(Cpu::Native.level() == .None)
	assert(Cpu::Baseline.level() == Level::baseline())
}
