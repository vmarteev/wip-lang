// How long each phase of a build takes, for `wip build --time`.

import std::time::{Duration, Instant}

/// How long each phase of a build took, in the order the phases ran.
pub struct Timings {
	pub phases: Vec<(String, Duration)> = Vec()
}

extend Timings {
	/// Records how long `phase` took, which began at `started`. A phase that
	/// runs again, such as lexing for each wave of modules, adds to its
	/// first entry.
	pub var fn record(phase: str, started: Instant) = {
		val elapsed = started.elapsed()
		for entry in self.phases {
			if entry.0 == phase {
				entry.1 = entry.1 + elapsed
				return
			}
		}
		self.phases.push((String::of(phase), elapsed))
	}

	/// The time spent in `phase`, or none if it did not run.
	pub fn get(phase: str): Duration = {
		var time = Duration::nanos(0)
		for (name, spent) in self.phases {
			if name == phase then time = time + spent
		}
		return time
	}

	pub fn total(): Duration = {
		var time = Duration::nanos(0)
		for (_, spent) in self.phases {
			time = time + spent
		}
		return time
	}
}

/// Each phase a line, its time in milliseconds, and then the total.
extend Timings: Text {
	fn toString(): String = {
		var text = String()
		for (phase, time) in self.phases {
			text.push("\(phase, width: 12)\(ms(time), width: 10, precision: 1) ms\n")
		}
		text.push("\("total", width: 12)\(ms(self.total()), width: 10, precision: 1) ms\n")
		return move text
	}
}

fn ms(time: Duration): f64 = time.asSeconds() * 1000.0
