// Building: checking a loaded program, generating its code, compiling the C
// it carries and linking the executable or library.

import std::fs
import std::io
import std::path
import std::process::{Command}
import std::time::{Duration, Instant, sleep}
import hir::{FnId, Program, checkMain}
import llvm
import mir
import syntax::{Diagnostic, Interner}

/// What `wip build` writes.
pub enum Emit {
	/// An executable, with the C entry point.
	Program
	/// An archive C links against: the objects, the runtime, and the C files
	/// the modules carry.
	Static
	/// A shared library: `.dylib` on macOS, `.so` elsewhere.
	Dynamic
	/// The program's LLVM IR, as text, which `clang` is not run on: its
	/// parts, the first where the output says and the rest beside it,
	/// numbered.
	LlvmIr
	/// The same, as LLVM's bitcode.
	LlvmBc
	/// The program's objects, which a linker on another machine links: a
	/// directory of them, with what the link takes beside them in
	/// `link.txt`, an object or a library a line. A Windows program is built so from
	/// another system, and linked on Windows.
	Objects
}

extend Emit {
	/// Whether what is written needs a `main` — a library does not.
	pub fn isProgram(): bool = self is .Program | .LlvmIr | .LlvmBc | .Objects

	/// What the flag's value is written as, for a message.
	pub fn text(): str = match self {
		.Program => "program"
		.Static => "static"
		.Dynamic => "dynamic"
		.LlvmIr => "llvm-ir"
		.LlvmBc => "llvm-bc"
		.Objects => "objects"
	}

	/// The flag's value, read.
	pub static fn parse(text: str): Option<Emit> = match text {
		"program" => .Program
		"static" => .Static
		"dynamic" => .Dynamic
		"llvm-ir" => .LlvmIr
		"llvm-bc" => .LlvmBc
		"objects" => .Objects
		_ => .None
	}
}

/// Whether a build is for debugging or for use: the program does the same
/// either way, and a release build is faster.
pub enum Profile {
	/// Not optimised, with the move checks; the default.
	Debug
	/// Optimised, without the move checks, and with the debug information in
	/// a file beside the program.
	Release
}

extend Profile {
	pub fn optimizes(): bool = self == Profile::Release
}

/// Where to look for the C a program binds: the directories a command line
/// added with `-I` and `-L`. What a module needs is in the module; where it
/// is on this machine is not.
@derive(Clone)
pub struct Search {
	pub var includes: Vec<String> = Vec()
	pub var libraryPaths: Vec<String> = Vec()
}

/// How a program is built, beyond what and where: where the C it binds is on
/// this machine, what is written, and whether for debugging or for use.
/// `BuildOptions()` is a debug build of an executable, looking for C where
/// the compiler looks by itself.
@derive(Clone)
pub struct BuildOptions {
	/// The directories `-I` and `-L` added.
	pub var search: Search = Search()
	/// A program, a library C links against, or the program's IR.
	pub var emit: Emit = .Program
	/// Where to write the C declarations of what a library exports, if
	/// anywhere.
	pub var header: Option<String> = .None
	/// Debug or release.
	pub var profile: Profile = .Debug
	/// The processor the program is built for.
	pub var cpu: Cpu = .Baseline
	/// Whether it carries debug information: the lines a panic lists, and
	/// what a debugger reads.
	pub var debugInfo: bool = true
	/// The constants it defines, `--define NAME=VALUE`.
	pub var defines: Vec<(String, String)> = Vec()
	/// The machine it is built for, and what `clang` is told of it: nothing
	/// for the machine the compiler runs on.
	pub var target: Target = .host()
	pub var targetFlags: Vec<String> = Vec()
	/// What checks the program's memory as it runs, where a build asks.
	pub var sanitize: Option<Sanitizer> = .None
}

/// A sanitizer `clang` builds a program with: AddressSanitizer, which faults
/// on a read or write of memory that was freed — a slot of the stack whose
/// variable's life ended among it — or that was never the program's; and
/// ThreadSanitizer, which reports two threads reaching one place, one of
/// them writing, with nothing between them that orders the two.
pub enum Sanitizer {
	Address
	Thread
}

extend Sanitizer {
	/// The sanitizer `name` says, as `--sanitize` takes it.
	pub static fn parse(name: str): Option<Sanitizer> = match name {
		"address" => Sanitizer::Address
		"thread" => Sanitizer::Thread
		_ => .None
	}

	/// What the backend instruments every function for.
	pub fn sanitized(): llvm::Sanitized = match self {
		.Address => .Address
		.Thread => .Thread
	}

	/// What every `clang` of the build is given: the program's IR, its C and
	/// its link, which brings the sanitizer's runtime in. A frame keeps its
	/// pointer, so what it reports names each call.
	pub fn flags(): Vec<String> = match self {
		.Address => ["-fsanitize=address", "-fno-omit-frame-pointer"]
		.Thread => ["-fsanitize=thread", "-fno-omit-frame-pointer"]
	}

	/// Why `target` cannot be built with it, where it cannot: its `clang` has
	/// no runtime for it.
	pub fn refusal(target: &Target): Option<String> = {
		return match self {
			.Address if target.os == .Windows && target.arch == .Arm64 => String::of(
				"the address sanitizer has no runtime for Windows on arm64",
			)
			.Thread if target.os == .Windows => String::of(
				"the thread sanitizer has no runtime for Windows",
			)
			_ => .None
		}
	}
}

/// Why a build did not finish: what is wrong in the program, or what went
/// wrong after it was checked.
pub enum BuildError {
	Diagnostics(diagnostics: Vec<Diagnostic>)
	Link(message: String)
}

/// Compiles a loaded program as `options` say, to `output`, and answers the
/// warnings. What the build writes on the way is named by `unique`, which
/// the process shares with whatever else names a file.
pub fn buildLoaded(
	loaded: &var Loaded,
	output: str,
	options: &BuildOptions,
	unique: &Unique,
	timings: &var Timings,
): Result<Vec<Diagnostic>, BuildError> = {
	val checked = checkLoaded(&var loaded, &var timings)
	var program = checked.program
	val diagnostics = checked.diagnostics
	if anyError(&diagnostics) then
		return .Err(.Diagnostics(diagnostics))

	program.checkMoves = options.profile == Profile::Debug
	program.tracesErrors = options.profile == Profile::Debug
	program.dropsByCall = options.profile == Profile::Debug
	// A program has an entry point; a library is called from one.
	var main: Option<llvm::Entry> = .None
	if options.emit.isProgram() {
		match checkMain(&program, &loaded.interner) {
			.Ok(entry) => main = .Main(entry.main)
			.Err(diagnostic) => return .Err(.Diagnostics([diagnostic]))
		}
	}
	match writeBinary(&loaded, &program, main, output, &options, &unique, &var timings) {
		.Ok(..) => {}
		.Err(error) => return .Err(error)
	}
	return diagnostics
}

/// Compiles a checked program that starts at `entry` and links it, writing
/// the declarations of what a library exports where one was asked for.
fn writeBinary(
	loaded: &Loaded,
	program: &Program,
	entry: Option<llvm::Entry>,
	output: str,
	options: &BuildOptions,
	unique: &Unique,
	timings: &var Timings,
): Result<void, BuildError> = {
	// What C cannot be given to call.
	val arch = abiOf(&options.target)
	val refused = mir::refusedExports(&program, &loaded.interner, arch)
	if !refused.isEmpty() then
		return .Err(.Diagnostics(refused))

	val optimize = options.profile.optimizes()
	val sources = &loaded.sources
	// The `clang` that compiles the IR says how it marks a local's life;
	// IR asked for is written for it too, where there is one.
	val clang = findClang(&unique)
	val lifetimes = lifetimesOf(&clang)
	var started = Instant::now()
	var ir = llvm::compile(
		&program,
		&loaded.interner,
		entry,
		(span) => sources.locate(span),
		optimize,
		loaded.threads,
		arch,
		options.target.os == .Windows,
		options.sanitize.map((sanitizer) => sanitizer.sanitized()).unwrapOr(.Unchecked),
		lifetimes,
	)
	if !options.debugInfo then
		ir.dropDebugInfo()

	timings.record("codegen", started)
	if options.emit is .LlvmIr | .LlvmBc {
		for (index, module) in ir.modules.indexed() {
			val path = partPath(output, index)
			// Bitcode is bytes, which a `str` holds as any others.
			val written = if options.emit == Emit::LlvmBc {
				val bytes = llvm::bitcode(&module)
				fs::writeFile(path, str::fromBytes(&bytes.items()))
			} else fs::writeFile(path, module.text())
			if written is .Err(error) then
				return .Err(.Link("cannot write `\(path)`: \(error)"))
		}
		return
	}
	val found = match move clang {
		.Ok(found) => found
		.Err(message) => return .Err(.Link(message))
	}
	started = Instant::now()
	val compiled = llvmObjects(&ir, &found, &options, optimize, &unique)
	timings.record("codegen", started)
	val objects = compiled?
	started = Instant::now()
	val linked = linkProgram(&loaded, &program, &objects, output, &options, &unique)
	timings.record("link", started)
	linked?
	if options.header is .Some(header) {
		val guard = headerGuard(header)
		val text = mir::writeHeader(&program, &loaded.interner, guard)
		if fs::writeFile(header, text) is .Err(error) then
			return .Err(.Link("cannot write `\(header)`: \(error)"))
	}
	return
}

/// Links what was compiled with the C the program carries, which is known
/// only once it is checked.
fn linkProgram(
	loaded: &Loaded,
	program: &Program,
	objects: &[Vec<u8>],
	output: str,
	options: &BuildOptions,
	unique: &Unique,
): Result<void, BuildError> = {
	val shims = shims(&program, &loaded.interner, &options.target)
	val dirs: Vec<String> = [
		for module in loaded.modules do
			yield module.dir.clone()
	]
	val includeDirs = cIncludeDirs(&program, &dirs, &loaded.includeDirs)?
	// The C a module names with `@source`, and the header it puts before
	// its own C with `@prefix`, and what it defines for it with
	// `@define`. All are known only once the program is checked, which
	// is why they join the files here rather than where the modules were
	// read.
	val cFiles = cSources(&program, &dirs, &loaded.cFiles, &options.target)?
	val exports = mir::exportedSymbols(&program, &loaded.interner)
	val linking = Linking(
		cFiles: &cFiles,
		shims: match shims {
			.Some(text) => text.toStr()
			.None => .None
		},
		includeDirs: &includeDirs,
		search: &options.search,
		libraries: &program.libraries,
		frameworks: &program.frameworks,
		exports: &exports,
		emit: options.emit,
		profile: options.profile,
		cpu: &options.cpu,
		target: &options.target,
		targetFlags: &options.targetFlags,
		sanitized: options.sanitize.isSome(),
	)
	if options.emit == Emit::Objects then
		return writeObjects(&objects, &linking, output)

	return link(&objects, &linking, output, &unique)
}

/// The objects in the directory `output`, each part an object of its own,
/// and `link.txt` beside them: what the link takes, one a line — `object
/// NAME` for each object, in the order it is linked, since the directory
/// may hold others of an earlier build; `library NAME` for each library
/// the program links; and for Windows `object program.res`, the
/// program's manifest as a resource, written beside them, `runtime
/// compiler-rt` and each `option` the linker is given, as
/// `windowsLinking` says. The C a program carries is compiled where it
/// is linked, which is not yet done, so a program with C is refused.
fn writeObjects(objects: &[Vec<u8>], linking: &Linking, output: str): Result<void, BuildError> = {
	if !linking.cFiles.isEmpty() || linking.shims.isSome() then
		return .Err(
			.Link(
				"the program carries C, which `--emit objects` does not compile: it is compiled where it is linked, which is not yet done",
			),
		)

	if fs::makeDirs(output) is .Err(error) then
		return .Err(.Link("cannot make `\(output)`: \(error)"))

	val windows = linking.target.os == .Windows
	val extension = if windows then "obj" else "o"
	var listed = String()
	for (i, object) in objects.indexed() {
		val name = "part\(i).\(extension)"
		val path = path::join(output, name)
		if fs::writeFile(path, str::fromBytes(&object.items())) is .Err(error) then
			return .Err(.Link("cannot write `\(path)`: \(error)"))

		listed.push("object \(name)\n")
	}
	for library in linking.libraries do
		listed.push("library \(library)\n")

	if windows {
		val resource = path::join(output, "program.res")
		if writeBytes(resource, manifestResource()) is .Err(error) then
			return .Err(.Link("cannot write `\(resource)`: \(error)"))

		listed.push("object program.res\n")
		listed.push("runtime compiler-rt\n")
		for option in windowsOptions(linking.profile) do
			listed.push("option \(option)\n")
	}
	val list = path::join(output, "link.txt")
	if fs::writeFile(list, listed) is .Err(error) then
		return .Err(.Link("cannot write `\(list)`: \(error)"))

	return
}

/// What Microsoft's linker is given for a Windows program, beside its
/// objects, its manifest and Clang's runtime, which the code calls for
/// what the processor has no instruction for, as a 128-bit division, and
/// which Clang gives a Unix's linker by itself and not Microsoft's: the
/// debug information into a PDB beside the program (`/DEBUG`); no linking
/// in steps, which may pad between the pieces of a section, where the
/// entries of a panic's table, gathered in one, would read the padding;
/// and in a release, what nothing reaches left out (`/OPT:REF`), as
/// `--gc-sections` does on Linux.
fn windowsOptions(profile: Profile): Vec<String> = {
	var options: Vec<String> = ["/DEBUG", "/INCREMENTAL:NO"]
	if profile.optimizes() then
		options.push("/OPT:REF")

	return options
}

/// The program's manifest as a compiled resource, a `.res`, which the
/// linker takes as it takes an object: no `mt.exe` is needed to put it
/// into the program. The file is an empty entry, as every `.res` begins,
/// and then the manifest's: its size, its header's, its type, 24, a
/// manifest, and its name, 1, the program's own, each as a number after
/// `0xFFFF`; and the text, padded to four bytes.
fn manifestResource(): Vec<u8> = {
	var out: Vec<u8> = Vec()
	resourceEntry(&var out, 0, 0, 0, 0)
	resourceEntry(&var out, WINDOWS_MANIFEST.len(), RT_MANIFEST, 1, LANGUAGE_NEUTRAL)
	out.pushAll(WINDOWS_MANIFEST)
	while out.len() % 4 != 0 do
		out.push(0)

	return out
}

/// `RT_MANIFEST`, the type of a manifest's resource.
val RT_MANIFEST: u16 = 24

/// A resource for every language.
val LANGUAGE_NEUTRAL: u16 = 0

/// One resource's header, 32 bytes, for `size` bytes of it, its type and
/// name numbers: what is moved and dropped as Windows likes, `0x1030`, for
/// one with something in it.
fn resourceEntry(out: &var Vec<u8>, size: i64, kind: u16, name: u16, language: u16) = {
	pushU32(&var out, size as u32)
	pushU32(&var out, 32)
	pushU16(&var out, 0xFFFF)
	pushU16(&var out, kind)
	pushU16(&var out, 0xFFFF)
	pushU16(&var out, name)
	pushU32(&var out, 0)
	pushU16(&var out, if size > 0 then 0x1030 else 0)
	pushU16(&var out, language)
	pushU32(&var out, 0)
	pushU32(&var out, 0)
}

fn pushU16(out: &var Vec<u8>, value: u16) = {
	out.push((value & 0xFF) as u8)
	out.push((value >> 8) as u8)
}

fn pushU32(out: &var Vec<u8>, value: u32) = {
	pushU16(&var out, (value & 0xFFFF) as u16)
	pushU16(&var out, (value >> 16) as u16)
}

/// What a Windows program says of itself to Windows: that its code page is
/// UTF-8, so that the C library's text — a path, an argument, a variable —
/// is UTF-8, as Wip's is.
val WINDOWS_MANIFEST: str = """
	<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
	  <application xmlns="urn:schemas-microsoft-com:asm.v3">
	    <windowsSettings>
	      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
	    </windowsSettings>
	  </application>
	</assembly>
	"""

/// Compiles a loaded program's tests to a runner at `output`, or its objects
/// where `options` asks for them: it calls each
/// test the program declares, in declaration order, and `filter` keeps the
/// ones whose name, as the runner prints it — `board::placesABall` — holds
/// it. The count is how many tests the runner holds. What `options` say of
/// what is written and where its declarations go is not asked: tests are a
/// program of their own, with no header to write.
pub fn buildTests(
	loaded: &var Loaded,
	output: str,
	options: &BuildOptions,
	filter: Option<str>,
	unique: &Unique,
	timings: &var Timings,
): Result<(Vec<Diagnostic>, i64), BuildError> = {
	val profile = options.profile
	val checked = checkLoaded(&var loaded, &var timings)
	var program = checked.program
	val diagnostics = checked.diagnostics
	if anyError(&diagnostics) then
		return .Err(.Diagnostics(diagnostics))

	program.checkMoves = profile == Profile::Debug
	program.tracesErrors = profile == Profile::Debug
	program.dropsByCall = profile == Profile::Debug
	val tests: Vec<FnId> = [for id in program.fns.ids() {
		if program.fns[id].test.isNone() then
			continue

		if filter is .Some(text) && !program.testName(id, &loaded.interner).contains(text) then
			continue

		yield id
	}]
	val count = tests.len()
	val written = BuildOptions(
		search: options.search.clone(),
		emit: if options.emit == Emit::Objects then Emit::Objects else Emit::Program,
		header: .None,
		profile: move profile,
		cpu: options.cpu,
		target: options.target,
		targetFlags: options.targetFlags.clone(),
		sanitize: options.sanitize,
	)
	writeBinary(&loaded, &program, .Tests(tests), output, &written, &unique, &var timings)?
	return (diagnostics, count)
}

/// Where the part `index` of a debug build's IR is written: the first at
/// `output`, and each after it beside it, its number before the extension —
/// `main.ll`, `main.1.ll`, `main.2.ll`.
fn partPath(output: str, index: i64): String = {
	if index == 0 then
		return output

	var slash: Option<i64> = .None
	for i in 0..output.len() do
		if output[i] == b'/' then
			slash = i

	val (dir, name) = match slash {
		.Some(at) => (output[0..at + 1], output[at + 1..output.len()])
		.None => ("", output)
	}
	var dot: Option<i64> = .None
	for i in 1..name.len() do
		if name[i] == b'.' then
			dot = i

	return match dot {
		.Some(at) => "\(dir)\(name[0..at]).\(index).\(name[at + 1..name.len()])"
		.None => "\(dir)\(name).\(index)"
	}
}

/// `BOARD_H` for `board.h`: what keeps a header from being read twice.
fn headerGuard(header: str): String = {
	val name = path::name(header)
	val given = if name.isEmpty() then "wip" else name
	var guard = String::of("WIP_")
	for byte in given {
		// One `_` for each character that is not a letter or a digit, however
		// many bytes it takes.
		if byte is 0x80..=0xBF then
			continue

		if byte is b'a'..=b'z' then
			guard.pushByte(byte - 32)
		else if byte is b'A'..=b'Z' | b'0'..=b'9' then
			guard.pushByte(byte)
		else
			guard.pushByte(b'_')
	}
	return guard
}

/// Every C file compiled with the program: the ones found beside a module's
/// Wip files, and the ones a module names with `@source`, each carrying the
/// `@prefix` header of the module it belongs to.
fn cSources(
	program: &Program,
	dirs: &[String],
	found: &[String],
	target: &Target,
): Result<Vec<CFile>, BuildError> = {
	var files: Vec<CFile> = Vec()
	for file in found {
		var c = CFile::of(file.clone())
		if ownerOf(file, &dirs) is .Some(owner) {
			c.prefix = prefixOf(&program, &dirs, owner)
			c.defines = definesOf(&program, owner)
		}
		files.push(c)
	}
	for (module, relative, language, standard) in program.cSources {
		val path = path::join(dirs[module], relative)
		if !(fs::meta(path) is .Ok(meta) && meta.isFile()) {
			val name =
				if program.modules[module].isEmpty() then String::of("the root module")
				else "module `\(program.modules[module])`"
			return .Err(.Link("`@source(\"\(relative)\")` in \(name): `\(path)` is not a file"))
		}
		var c = CFile::of(path)
		// What `@source` said it is written in.
		match language {
			.Some(.C) => c.language = .C
			.Some(.ObjectiveC) => c.language = .ObjectiveC
			.Some(.CPlusPlus) => c.language = .CPlusPlus
			.Some(.ObjectiveCPlusPlus) => c.language = .ObjectiveCPlusPlus
			.None => {}
		}
		c.standard = standard.clone()
		// Objective-C and Objective-C++ are Apple's, as they are for a file
		// found beside the module's own.
		if c.language.isApples() && !target.isApple() then
			continue

		c.prefix = prefixOf(&program, &dirs, module)
		c.defines = definesOf(&program, module)
		files.push(c)
	}
	return files
}

/// A module's prefix header, as a path.
fn prefixOf(program: &Program, dirs: &[String], module: i64): Option<String> = {
	for (owner, relative) in program.cPrefix do
		if owner == module then
			return path::join(dirs[module], relative)

	return .None
}

/// What a module's C is compiled with defined.
fn definesOf(program: &Program, module: i64): Vec<String> = {
	val defines: Vec<String> = [
		for (owner, define) in program.cDefines do
			if owner == module then
				yield define.clone()
	]
	return defines
}

/// Which module a file found on disk belongs to: the deepest module
/// directory it is under, or else a module in the current directory, as
/// `wip run main.wip` has.
fn ownerOf(file: str, dirs: &[String]): Option<i64> = {
	var deepest: Option<(i64, i64)> = .None
	for (module, dir) in dirs.indexed() {
		if dir.isEmpty() || !path::isWithin(file, dir) then
			continue

		val depth = components(dir)
		if !(deepest is .Some((_, deeper)) && deeper > depth) then
			deepest = (module, depth)
	}
	if deepest is .Some((module, _)) then
		return module

	for (module, dir) in dirs.indexed() do
		if dir.isEmpty() then
			return module

	return .None
}

/// How many names a path is made of: `/` and `.` count as one each, as
/// Rust's components do.
fn components(dir: str): i64 = {
	val root = path::root(dir)
	var count = if root.isEmpty() then 0 else 1
	var at = root.len()
	while at < dir.len() {
		var end = at
		while end < dir.len() && !path::isSeparator(dir[end]) do
			end += 1

		val name = dir[at..end]
		at = end + 1
		if !name.isEmpty() && !(name == "." && count > 0) then
			count += 1
	}
	return count
}

/// Where the program's C looks for headers: the modules' directories, and
/// then the directories they name with `@include`, each inside its module.
/// One that is not there is an error, since a header the C cannot find would
/// be reported by the C compiler, far from the cause.
fn cIncludeDirs(
	program: &Program,
	moduleDirs: &[String],
	modules: &[String],
): Result<Includes, BuildError> = {
	var dirs = Includes()
	for dir in modules do
		dirs.quoted.push(dir.clone())

	for (module, relative) in program.cIncludes {
		val path = &program.modules[module]
		val dir = path::join(moduleDirs[module], relative)
		if !(fs::meta(dir) is .Ok(meta) && meta.isDirectory()) {
			val name = if path.isEmpty() then String::of("the root module") else "module `\(path)`"
			return .Err(
				.Link("`@include(\"\(relative)\")` in \(name): `\(dir)` is not a directory"),
			)
		}
		if !dirs.angled.contains(&dir) then
			dirs.angled.push(dir)
	}
	return dirs
}

/// What the linker is given besides the objects: where to look for
/// libraries, the libraries the extern blocks name, and on an Apple target
/// the frameworks.
fn linkArgs(
	libraryPaths: &[String],
	libraries: &[String],
	frameworks: &[String],
	target: &Target,
): Vec<String> = {
	var args: Vec<String> = [
		for dir in libraryPaths do
			yield "-L\(dir)"
	]
	for name in libraries do
		args.push("-l\(name)")

	// The runtime starts threads: a Linux whose C library does not have them
	// in it has them in a library of their own. A Mac has them in libSystem.
	if target.os == Os::Linux then
		args.push("-lpthread")

	// No other system has frameworks, so elsewhere they are not asked for.
	if target.isApple() {
		for name in frameworks {
			args.push("-framework")
			args.push(name.clone())
		}
	}
	return args
}

/// Everything the C toolchain is given besides the object files: what to
/// compile beside them, where to look, and what to write.
view struct Linking {
	/// The modules' own C: the files found beside their Wip ones and those
	/// they name with `@source`, each with the `@prefix` header of its
	/// module.
	cFiles: &[CFile]
	shims: Option<str>
	/// Where the program's C looks for headers: the modules' directories,
	/// for `#include "…"`, and those they name with `@include`.
	includeDirs: &Includes
	search: &Search
	libraries: &[String]
	frameworks: &[String]
	/// What a library exports to C, by its symbols.
	exports: &[String]
	emit: Emit
	profile: Profile
	cpu: &Cpu
	target: &Target
	targetFlags: &[String]
	/// Whether it is built with a sanitizer, whose `clang` compiles its C and
	/// links it.
	sanitized: bool
}

/// The C the compiler writes for the calls it cannot make itself: the ones
/// `c_abi` leaves to a wrapper on `target`.
fn shims(program: &Program, interner: &Interner, target: &Target): Option<String> = {
	val shimmed = mir::shimmed(&program, abiOf(&target))
	return mir::writeShims(&program, &interner, &shimmed)
}

/// The rules C calls by on `target`: Apple's arm64 packs what goes on the
/// stack, as Linux's does not; Windows on Arm64 passes a struct as AAPCS64
/// does, its variadic calls aside, which LLVM lays out for the target; and
/// Windows on x86-64 by Microsoft's own rules, not System V's.
fn abiOf(target: &Target): Option<mir::Arch> = match (target.os, target.arch) {
	(.Windows, .Arm64) => .Arm64
	(.Windows, .X86_64) => .WindowsX64
	(_, .X86_64) => .X86_64
	(_, .Arm64) => .Some(if target.isApple() then .AppleArm64 else .Arm64)
}

/// Compiles the program's C, each file once, and links it with the modules'
/// object files, using `$CC` or `cc`.
fn link(
	objects: &[Vec<u8>],
	linking: &Linking,
	output: str,
	unique: &Unique,
): Result<void, BuildError> = {
	val dir = match fs::TempDir::new() {
		.Ok(dir) => dir
		.Err(why) => return .Err(.Link("cannot create a temporary directory: \(why)"))
	}
	var members: Vec<String> = Vec()
	for (i, object) in objects.indexed() {
		val path = dir.join("module\(i).o")
		if writeBytes(path, &object) is .Err(error) then
			return .Err(.Link("cannot write temporary files: \(error)"))

		members.push(path)
	}

	// The C the compiler wrote for the calls C has to make is kept where its
	// path depends only on what it says, so it compiles once. A person can
	// read it there if a call ever goes wrong. The runtime is Wip, in the
	// prelude: a program that brings no C and needs no wrapper compiles no C.
	val cache = cacheDir()
	var files: Vec<CFile> = [
		for file in linking.cFiles do
			yield file.clone()
	]
	if linking.shims is .Some(source) {
		val generated = match generated(cache, [("wip_shims.c", source)], &unique) {
			.Ok(generated) => generated
			.Err(message) => return .Err(.Link(message))
		}
		files.push(CFile::c(path::join(generated, "wip_shims.c")))
	}

	// The modules' directories first, then the command line's, so a module's
	// header wins over one of the same name elsewhere. Each as the file
	// system names it, so that the same directory is the same flag wherever
	// the build was started. An empty path is the current directory, as a
	// bare file name's parent is: written as it is, it would be a `-I` that
	// takes the next argument.
	var includes = Includes()
	for dir in linking.includeDirs.quoted do
		addInclude(&var includes.quoted, dir)

	for dir in linking.includeDirs.angled do
		addInclude(&var includes.angled, dir)

	for dir in linking.search.includes do
		addInclude(&var includes.angled, dir)

	// Code in a shared library is placed wherever the library is loaded;
	// Apple's compilers make all code so.
	val positionIndependent = linking.emit == Emit::Dynamic && !linking.target.isApple()
	val compiled = match compile(
		&files,
		&includes,
		cache,
		positionIndependent,
		linking.profile.optimizes(),
		linking.cpu,
		linking.target,
		linking.targetFlags,
		&unique,
		linking.sanitized,
	) {
		.Ok(compiled) => compiled
		.Err(message) => return .Err(.Link(message))
	}
	for object in compiled.objects do
		members.push(object.clone())

	// An archive is made of objects, and `ar` collects them; on Windows,
	// which has none, `llvm-lib`, which comes with Visual Studio's `clang`.
	if linking.emit == Emit::Static && linking.target.os == .Windows {
		var args: Vec<String> = ["/OUT:\(output)"]
		for member in members do
			args.push(member.clone())

		return run(windowsArchiver(), strs(&args))
	}
	if linking.emit == Emit::Static {
		var args: Vec<String> = Vec()
		args.push("rcs")
		args.push(output)
		for member in members do
			args.push(member.clone())

		val ar = match io::env("AR") {
			.Some(ar) => ar
			.None => "ar"
		}
		return run(ar, strs(&args))
	}
	if linking.target.os == .Windows then
		return linkWindows(&members, &linking, output, &dir)

	var args: Vec<String> = [
		for flag in linking.targetFlags do
			yield flag.clone()
	]
	// A shared library has no entry point, and each platform spells it
	// differently.
	if linking.emit == Emit::Dynamic then
		args.push(if linking.target.isApple() then "-dynamiclib" else "-shared")

	args.push("-o")
	args.push(output)
	for member in members do
		args.push(member.clone())

	for arg in linkArgs(
		&linking.search.libraryPaths,
		linking.libraries,
		linking.frameworks,
		linking.target,
	) do
		args.push(arg)

	// C++ compiled with the program needs the C++ library, which a C
	// driver does not link: the system's, libc++ on Apple's and libstdc++
	// on Linux. A program with no C++ links neither.
	var cxx = false
	for file in linking.cFiles do
		if file.language.isCxx() then
			cxx = true

	if cxx then
		args.push(if linking.target.isApple() then "-lc++" else "-lstdc++")

	// A release build is stripped of what nothing reaches: a function every
	// call to which was inlined, in a part another names. The table of a
	// panic's calls keeps none alive, its entry for each tied to the
	// function; on ELF, only where the reference to its section's start is
	// not taken to keep every entry, which `-z start-stop-gc` says.
	if linking.profile.optimizes() {
		if linking.target.isApple() then
			args.push("-Wl,-dead_strip")
		else {
			args.push("-Wl,--gc-sections")
			args.push("-Wl,-z,start-stop-gc")
		}
	}
	val cc = compilerFor(linking.sanitized)
	run(cc, strs(&args))?
	// Apple's linker leaves the debug information in the objects and names
	// them in the program; the program's objects go when this returns, so it
	// is gathered beside it first, as `clang -g` does. What the linker left
	// in the program, naming the objects, is then of no use, and is taken
	// out, as Xcode does for a release: the debugger finds the `.dSYM` by the
	// program's UUID.
	if linking.target.isApple() {
		val symbols = "\(output).dSYM"
		run("dsymutil", [output, "-o", symbols.toStr()])?
		return run("strip", ["-S", output])
	}
	// Elsewhere the linker puts it in the program. A release build moves it
	// into a file beside the program, which the program names, as Linux
	// distributions ship theirs: the program stays small, and gdb and
	// profilers find the file where it is kept.
	if linking.profile == Profile::Release {
		val objcopy = match io::env("OBJCOPY") {
			.Some(objcopy) => objcopy
			.None => "objcopy"
		}
		val debug = "\(output).debug"
		run(objcopy, ["--only-keep-debug", output, debug.toStr()])?
		val named = "--add-gnu-debuglink=\(debug)"
		run(objcopy, ["--strip-debug", named.toStr(), output])?
	}
	return
}

/// A Windows program, or a DLL, linked by Microsoft's linker through
/// `clang`, with its manifest, made a resource in `dir`, and what
/// `windowsOptions` says; the PDB is written beside it.
fn linkWindows(
	members: &[String],
	linking: &Linking,
	output: str,
	dir: &fs::TempDir,
): Result<void, BuildError> = {
	val resource = dir.join("program.res")
	if writeBytes(resource, manifestResource()) is .Err(error) then
		return .Err(.Link("cannot write temporary files: \(error)"))

	var args: Vec<String> = [
		for flag in linking.targetFlags do
			yield flag.clone()
	]
	args.push("-fuse-ld=link")
	// A DLL exports only what it is told to: each function the library
	// exports to C, which C linking against it, through the import library
	// written beside it, finds.
	if linking.emit == Emit::Dynamic {
		args.push("-shared")
		for symbol in linking.exports do
			args.push("-Wl,/EXPORT:\(symbol)")
	}

	// A program is linked beside where it goes and moved there: Windows
	// holds a program's file a moment after it ran, and a scanner holds a
	// new one, where the linker would be refused it. Its PDB is named as the
	// program is, `board.pdb` beside `board.exe`.
	val program = linking.emit == Emit::Program
	val written: String = if program then "\(output).linking" else output
	args.push("-o")
	args.push(written.clone())
	if program then
		args.push("-Wl,/PDB:\(path::join(path::parent(output), "\(path::stem(output)).pdb"))")

	for member in members do
		args.push(member.clone())

	args.push(resource)
	for arg in linkArgs(
		&linking.search.libraryPaths,
		linking.libraries,
		linking.frameworks,
		linking.target,
	) do
		args.push(arg)

	args.push("--rtlib=compiler-rt")
	for option in windowsOptions(linking.profile) do
		args.push("-Wl,\(option)")

	run(compilerFor(linking.sanitized), strs(&args))?
	if program then
		return movedInto(written, output)

	return
}

/// `from` moved to `to`, in place of what is there: tried again for a
/// second while Windows holds `to`, a program that ran a moment ago, or
/// one a scanner is reading.
fn movedInto(from: str, to: str): Result<void, BuildError> = {
	var tries = 0
	while true {
		match fs::rename(from, to) {
			.Ok(..) => return
			.Err(.Denied) if tries < 100 => {
				tries += 1
				sleep(Duration::millis(10))
			}
			.Err(error) => {
				fs::removeFile(from)
				return .Err(.Link("cannot put the program at `\(to)`: \(error)"))
			}
		}
	}
	return
}

/// What makes an archive on Windows: `$AR`, or the `llvm-lib` beside the
/// `clang` a build runs, or one on the path.
fn windowsArchiver(): String = {
	if io::env("AR") is .Some(ar) && !ar.isEmpty() then
		return ar

	val clang = compiler()
	val beside = path::join(path::parent(clang), "llvm-lib.exe")
	if !path::root(clang).isEmpty() && fs::exists(beside) then
		return beside

	return "llvm-lib"
}

/// A directory the program's C looks in, as the file system names it, where
/// it is not there already.
fn addInclude(includes: &var Vec<String>, given: str) = {
	val dir = if given.isEmpty() then "." else given
	val real = match fs::realPath(dir) {
		.Ok(real) => real
		.Err(..) => dir
	}
	if !includes.contains(&real) then
		includes.push(real)
}

/// Each of `texts`, lent.
fn strs(texts: &[String]): Vec<str> = {
	var out: Vec<str> = Vec()
	for text in texts do
		out.push(text)

	return out
}

/// Runs a tool of the toolchain, saying what it said when it fails.
fn run(tool: str, args: &[str]): Result<void, BuildError> = {
	val result = match Command::of(tool).args(&args).output() {
		.Ok(result) => result
		.Err(error) => return .Err(.Link("cannot run `\(tool)`: \(error)"))
	}
	// What went wrong may be said on either stream: Microsoft's linker,
	// which `clang` runs on Windows, says it on its output.
	if !result.exit.success() then
		return .Err(.Link("`\(tool)` failed:\n\(result.stdout)\(result.stderr)"))

	return
}
