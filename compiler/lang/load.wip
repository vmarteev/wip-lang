// Reading a program: its modules' files, from disk or from memory,
// following its imports; every file of it, and where in it a span is.

import std::collections::{Map}
import std::fs
import std::future
import std::io
import std::time::{Instant}
import std::mem
import std::path
import hir::{ModuleAst, PRELUDE}
import syntax::{
	Ast,
	Diagnostic,
	Interner,
	Item,
	Lexed,
	LineIndex,
	Parsed,
	Span,
	Symbol,
	expand,
	lexAt,
	parseAt,
	split
}

/// Every file of a program, laid out end to end so that one `Span` names a
/// place in exactly one of them.
pub struct Sources {
	/// Name, text, and the offset where the file's spans begin.
	files: Vec<(String, String, u32)>
	/// Each file's line starts, found as the file is added.
	lines: Vec<LineIndex>
}

/// Where a span is: its file, and the line and column it begins at and
/// ends just before.
pub view struct Place {
	pub file: str
	pub start: (u32, u32)
	pub end: (u32, u32)
}

extend Sources {
	pub static fn new(): Sources = Sources(files: Vec(), lines: Vec())

	/// Adds a file and returns the offset its spans start at.
	pub var fn add(name: String, text: String): u32 = {
		val start = match self.files.last() {
			.Some(file) => file.2 + file.1.len() as u32 + 1
			.None => 0
		}
		self.lines.push(LineIndex::new(text))
		self.files.push((move name, move text, start))
		return start
	}

	pub static fn single(name: String, text: String): Sources = {
		var sources = Sources::new()
		sources.add(move name, move text)
		return move sources
	}

	/// Where a span was written, for a panic's message: the
	/// file as diagnostics name it, and the line and column, from one.
	pub fn locate(span: Span): (String, u32, u32) = {
		val .Some(file) = self.fileOf(span) else {
			return ("<unknown>", 0, 0)
		}
		val (name, text, base) = self.files[file]
		val (line, column) = self.lines[file].lineCol(text, span.lo - base)
		return (name.clone(), line, column)
	}

	/// Every file, in the order their spans lie in: name, text, and the
	/// offset where its spans begin.
	pub fn entries(): &[(String, String, u32)] = lend self.files.items()

	/// Where `span` begins and ends, counted as `locate` counts
	/// them; nothing where it is in no file. Both ends are found in the
	/// file it begins in, so that an end at the end of a file is not taken
	/// for the next file's start.
	pub fn place(span: Span): Option<Place> = {
		val .Some(file) = self.fileOf(span) else {
			return .None
		}
		val (name, text, base) = self.files[file]
		val index = &self.lines[file]
		val hi = if span.hi > span.lo then span.hi else span.lo
		return .Some(Place(
			file: name.toStr(),
			start: index.lineCol(text, span.lo - base),
			end: index.lineCol(text, hi - base),
		))
	}

	/// The file a span falls in: its name, its text, and its base offset.
	pub fn of(span: Span): Option<(str, str, u32)> = {
		val .Some(file) = self.fileOf(span) else {
			return .None
		}
		val (name, text, base) = self.files[file]
		return .Some((name.toStr(), text.toStr(), base))
	}

	pub fn isEmpty(): bool = self.files.isEmpty()

	/// The index of the last file that begins at or before `span`.
	fn fileOf(span: Span): Option<i64> = {
		var file = self.files.len()
		while file > 0 {
			file -= 1
			if self.files[file].2 <= span.lo then return .Some(file)
		}
		return .None
	}
}

/// One module's parsed files.
pub struct LoadedModule {
	/// `a::b::c`, empty for the root module; a dependency's modules begin
	/// with its name, `engine::render`.
	pub path: String
	pub files: Vec<Parsed>
	/// What `@derive` writes for its types: syntax the checker reads as one
	/// more of its files, placed in the files above.
	pub derived: Ast
	/// Where its files are. Empty for the standard library, which is in
	/// the compiler.
	pub dir: String
	/// What its paths are written from, and the packages they may begin
	/// with: its package's.
	pub prefix: String
	pub depends: Vec<String>
	/// Its package's root, which a file it embeds may not leave. Nothing
	/// for the standard library.
	pub root: Option<String>
}

/// A program: every module it reaches, and every file's text.
pub struct Loaded {
	pub var sources: Sources
	pub var interner: Interner
	pub var modules: Vec<LoadedModule>
	/// The `.c` files of the modules, compiled and linked with the program.
	/// A module's directory is also a header search path, so its C files can
	/// include their own headers.
	pub var cFiles: Vec<String>
	/// Every module's directory, searched for the headers a declaration
	/// names with `@header`.
	pub var includeDirs: Vec<String>
	/// What lexing, parsing and module discovery reported.
	pub var diagnostics: Vec<Diagnostic>
	/// The entry's directory, where the modules are found.
	pub var root: String
	/// The program's package and the ones it depends on.
	pub var packages: Vec<Package>
	/// How many threads the phases that read the program split their work
	/// across: given to the loader, and kept with what it loaded.
	pub threads: i64
}

/// What is compiled: a program; a program and every module of its
/// package, imported or not, which is what `wip check` checks; or those
/// together with the tests the modules carry in their `.test.wip` files.
@derive(Eq, Clone)
pub enum Mode {
	Program
	Package
	Tests
}

extend Mode {
	/// Whether a file belongs to what is being compiled: a `.test.wip` file
	/// is compiled by `wip test` and by nothing else.
	fn takes(name: str): bool = self == .Tests || !name.endsWith(".test.wip")

	/// Whether every module of the program's package is loaded, so that
	/// one nothing imports yet is still checked, and its tests run.
	fn wholePackage(): bool = self is .Package | .Tests
}

/// Reads the program that starts at `entry`, following its imports. The
/// entry file's directory is the root module.
pub fn load(entry: str): Result<Loaded, String> = {
	var timings = Timings()
	return loadMode(entry, .Program, &var timings, future::cores())
}

/// Like `load`, compiling what `mode` says, and splitting the work of each
/// phase across `threads`. The entry must be a `.wip` file, or the
/// directory of a package, on disk: what a command line names.
///
/// Modules are loaded in waves: the root, then the modules it imports,
/// then the ones those import.
pub fn loadMode(
	entry: str,
	mode: Mode,
	timings: &var Timings,
	threads: i64,
): Result<Loaded, String> = loadFor(entry, mode, Target::host(), &var timings, threads)

/// Like `loadMode`, for `target` rather than this machine: the items and
/// files that target takes, and its `TARGET_OS`, `TARGET_ARCH` and
/// `TARGET_VENDOR`. What is loaded can be checked, and is built only where
/// `target` is this machine.
pub fn loadFor(
	entry: str,
	mode: Mode,
	target: Target,
	timings: &var Timings,
	threads: i64,
): Result<Loaded, String> = {
	// The entry's whole directory is compiled, so a mistyped entry must not
	// quietly compile whatever else is there.
	val meta = match fs::meta(entry) {
		.Ok(meta) => meta
		.Err(error) => return .Err("cannot read `\(entry)`: \(error)")
	}
	// A package is built by naming its directory, or its `package.wip`.
	if meta.isDirectory() {
		if !isFile(path::join(entry, "package.wip")) then
			return .Err("`\(entry)` is a directory with no `package.wip`: name the `.wip` file the program starts in")
		return loadWith(entry, .None, mode, target, Overlay(), &var timings, threads)
	}
	if !meta.isFile() || path::extension(entry) != .Some("wip") then
		return .Err("`\(entry)` is not a `.wip` file")
	return loadWith(parentOf(entry), .None, mode, target, Overlay(), &var timings, threads)
}

/// A file's directory as a path names it: empty for a bare file name,
/// which the loader reads as the current directory.
fn parentOf(file: str): str = match file.rsplitOnce("/") {
	.Some(("", _)) => "/"
	.Some((dir, _)) => dir
	.None => ""
}

/// Texts that stand in for files on disk: what an editor has not saved. A
/// file is known by its canonical path, so two paths to it are one file,
/// and one not yet on disk is read as if it were.
@derive(Clone)
pub struct Overlay {
	files: Map<String, String> = Map()
}

extend Overlay {
	/// `text` is `path`'s, whatever the disk says.
	pub var fn set(path: str, text: String) = self.files.put(canonicalFile(path), move text)

	/// `path` is read from the disk again.
	pub var fn remove(path: str) = {
		val key = canonicalFile(path)
		self.files.remove(&key)
	}

	/// `path`'s text: the overlay's, or the disk's.
	pub fn read(path: str): Result<String, io::IoError> = {
		if !self.files.isEmpty() {
			val key = canonicalFile(path)
			if self.files.get(&key) is .Some(text) then return .Ok(text.clone())
		}
		return fs::readFile(path)
	}

	/// The names of the files the overlay holds in `dir` that are not on
	/// disk.
	fn unsavedIn(dir: str): Vec<String> = {
		var names: Vec<String> = Vec()
		if self.files.isEmpty() then return move names
		val canonical = identity(dir)
		for at in 0..self.files.len() {
			val file = String::of(self.files.keyAt(at))
			if path::parent(file) == canonical && !fs::exists(file) then
				names.push(path::name(file))
		}
		return move names
	}
}

/// A file's canonical path, which it has even before it is on disk: its
/// directory's, and its name.
pub fn canonicalFile(file: str): String = {
	val name = path::name(file)
	if name.isEmpty() then return identity(file)
	return path::join(identity(parentOf(file)), name)
}

/// Like `loadMode`, with what `overlay` holds read in place of the files on
/// disk: the program an editor shows. `entry` is the root the editor worked
/// out, and is not checked on disk as a command line's is, since what the
/// editor holds may not be saved yet.
pub fn loadOverlaid(
	entry: str,
	mode: Mode,
	overlay: &Overlay,
	threads: i64,
): Result<Loaded, String> = {
	var timings = Timings()
	val root = if isDirectory(entry) then entry else parentOf(entry)
	return loadWith(root, .None, mode, Target::host(), &overlay, &var timings, threads)
}

/// A program whose root module is one file held in memory, with the
/// prelude and whatever it imports read as for any program. The file's
/// directory is where its imports are looked for, and nothing else in it
/// is compiled.
pub fn loadSource(
	file: &SourceFile,
	timings: &var Timings,
	threads: i64,
): Result<Loaded, String> = {
	val given = Vec::of(own [(file.name.clone(), file.text.clone())])
	return loadWith(
		parentOf(file.name),
		.Some(move given),
		.Program,
		Target::host(),
		Overlay(),
		&var timings,
		threads,
	)
}

/// A range of a wave's files: where it begins among them, where each symbol
/// of the interner it was lexed with is in the program's, and its files
/// lexed and then parsed.
struct Lexing {
	start: i64
	symbols: Vec<Symbol>
	lexed: Vec<Lexed>
	parsed: Vec<Parsed>
}

/// A module the loader writes itself: its path, the name its file is
/// shown by, and the file's text.
struct Generated {
	path: String
	name: String
	text: String
}

/// The loader behind them all: `given` is the root module's files, where
/// they are not read from `root`, and `target` what they are loaded for.
fn loadWith(
	root: str,
	given: Option<Vec<(String, String)>>,
	mode: Mode,
	target: Target,
	overlay: &Overlay,
	timings: &var Timings,
	threads: i64,
): Result<Loaded, String> = {
	var loaded = Loaded(
		sources: Sources::new(),
		interner: Interner::new(),
		modules: Vec(),
		cFiles: Vec(),
		includeDirs: Vec(),
		diagnostics: Vec(),
		root: root,
		packages: Vec(),
		threads: threads,
	)
	// The program's package and every one it depends on, from their
	// `package.wip` files, before any module is read.
	val started = Instant::now()
	loaded.packages = packages(root, &var loaded, &overlay)
	timings.record("read", started)
	// `package::NAME` and `package::VERSION`: a module of two constants for
	// each package that has a name, written here, as the prelude's
	// `target.wip` is.
	var generated: Vec<Generated> = Vec()
	for package in loaded.packages {
		val .Some(name) = package.name else {
			continue
		}
		val modulePath =
			if package.prefix.isEmpty() then String::of("package") else "\(package.prefix)::package"
		var text = "pub val NAME: str = \"\(name)\"\n"
		if package.version is .Some(version) then
			text.push("pub val VERSION: str = \"\(version)\"\n")
		generated.push(Generated(path: move modulePath, name: "<package \(name)>", text: move text))
	}
	// The root module, the prelude, which every program has without an
	// import, and each package's own.
	var wave = Vec::of(own [String(), PRELUDE])
	for made in generated {
		wave.push(made.path.clone())
	}
	// `wip check` and `wip test` of a package see all of it: each module,
	// imported or not, is loaded as though the root imported it, and is
	// checked, and its tests run, as an imported one's are.
	if mode.wholePackage() && given.isNone() && !loaded.packages.isEmpty() {
		val dir = loaded.packages[0].dir.clone()
		if isFile(path::join(dir, "package.wip")) {
			var modules: Vec<String> = Vec()
			packageModules(dir, "", &var modules)
			for module in move modules {
				if !wave.contains(&module) then wave.push(move module)
			}
		}
	}
	var seen: Vec<String> = wave.clone()
	// Where the standard library is, found when the first of its modules is
	// read.
	var home: Option<String> = .None
	// Which module imports which, and where, so a cycle can be reported.
	var edges: Vec<(String, String, Span)> = Vec()
	while !wave.isEmpty() {
		// The wave's files follow the earlier waves' in `loaded.sources`;
		// `owners` says which of the wave's modules each belongs to.
		val first = loaded.sources.entries().len()
		var owners: Vec<i64> = Vec()
		var places: Vec<(String, Option<i64>)> = Vec()
		for (module, modulePath) in wave.forwards().enumerate() {
			var made: Option<i64> = .None
			for (i, g) in generated.forwards().enumerate() {
				if made.isNone() && g.path == modulePath then made = .Some(i)
			}
			val located = locateModule(&loaded.packages, modulePath)
			var files: Vec<(String, String)> = Vec()
			if made is .Some(i) {
				files.push((generated[i].name.clone(), generated[i].text.clone()))
			} else if given is .Some(given) && modulePath.isEmpty() {
				files = given.clone()
			} else {
				match located {
					.None => {
						if home.isNone() then home = .Some(findHome()?)
						val .Some(dir) = home else {
							panic("the home was found above")
						}
						files = stdFiles(dir, modulePath, target)?
					}
					.Some((package, local)) => {
						val dir = loaded.packages[package].dir.clone()
						// `wip test game` runs `game`'s tests; a dependency's
						// are run by testing it.
						val moduleMode = if package == 0 then mode else Mode::Program
						val started = Instant::now()
						val read = moduleFiles(dir, local, moduleMode, target, &overlay)
						timings.record("read", started)
						files = read?
					}
				}
			}
			for (name, text) in move files {
				loaded.sources.add(move name, move text)
				owners.push(module)
			}
			// Its C files are compiled with the program, and its directory
			// is searched for the headers it names. A root given in memory
			// has none, and neither has a module the compiler wrote.
			match located {
				.Some((package, local)) if made.isNone() => {
					val dir = moduleDir(loaded.packages[package].dir, local)
					if given.isNone() || !modulePath.isEmpty() {
						val started = Instant::now()
						val cFiles = moduleCFiles(dir, target)
						timings.record("read", started)
						for file in move cFiles {
							loaded.cFiles.push(move file)
						}
					}
					if !loaded.includeDirs.contains(&dir) then loaded.includeDirs.push(dir.clone())
					places.push((move dir, .Some(package)))
				}
				.Some((package, _)) => places.push((String(), .Some(package)))
				.None => places.push((String(), .None))
			}
		}
		// Each range of the wave's files is lexed with an interner of its own;
		// absorbed in order, they number the symbols as one interner would
		// have. Each file's symbols are then renamed, and it is parsed, on the
		// threads again.
		val entries = loaded.sources.entries()
		var sizes: Vec<i64> = Vec()
		for k in first..entries.len() {
			sizes.push(entries[k].1.len())
		}
		val ranges = split(&sizes.items(), threads)
		var started = Instant::now()
		val lexedRanges = future::map(&ranges.items(), (range) => {
			var interner = Interner::new()
			var lexed: Vec<Lexed> = Vec()
			for k in range.0..range.1 {
				lexed.push(lexAt(entries[first + k].1, entries[first + k].2, &var interner))
			}
			return (move interner, move lexed)
		})
		var work: Vec<Lexing> = Vec()
		var at = 0
		for (interner, lexed) in move lexedRanges {
			work.push(Lexing(
				start: ranges[at].0,
				symbols: loaded.interner.absorb(&interner),
				lexed: move lexed,
				parsed: Vec(),
			))
			at += 1
		}
		timings.record("lex", started)
		started = Instant::now()
		future::each(&var work, (piece) => {
			for k in 0..piece.lexed.len() {
				piece.lexed[k].renameSymbols(&piece.symbols)
				val entry = &entries[first + piece.start + k]
				piece.parsed.push(parseAt(entry.1, entry.2, &piece.lexed[k]))
			}
		})
		timings.record("parse", started)
		// In file order: diagnostics, imports, and the next wave.
		var files: Vec<Vec<Parsed>> = Vec()
		for _ in wave {
			files.push(Vec())
		}
		var next: Vec<String> = Vec()
		var i = -1
		for piece in move work {
			var j = -1
			for parsedFile in move piece.parsed {
				i += 1
				j += 1
				var parsed = move parsedFile
				val module = owners[i]
				for diagnostic in piece.lexed[j].diagnostics {
					loaded.diagnostics.push(diagnostic.clone())
				}
				for diagnostic in parsed.diagnostics {
					loaded.diagnostics.push(diagnostic.clone())
				}
				// What this target does not take is dropped before anything
				// reads the file: an import it held is not followed, and a name
				// it declared is free.
				for diagnostic in keep(&var parsed.ast, &loaded.interner, target) {
					loaded.diagnostics.push(move diagnostic)
				}
				for item in parsed.ast.items {
					val .Import(decl) = item else {
						continue
					}
					var written = String()
					for (j, name) in decl.path.forwards().enumerate() {
						if j > 0 then written.push("::")
						written.push(loaded.interner.resolve(name.sym))
					}
					// What the path means from this module's package, which the
					// checker works out the same way.
					val owner = places[module].1
					val imported = meant(&loaded.packages, owner, written)
					if importAcrossPackages(
						&loaded.packages,
						owner,
						written,
						imported,
						decl.span,
					) is .Some(d) {
						loaded.diagnostics.push(move d)
						continue
					}
					edges.push((wave[module].clone(), imported.clone(), decl.span))
					if !seen.contains(&imported) {
						seen.push(imported.clone())
						next.push(move imported)
					}
				}
				files[module].push(move parsed)
			}
		}
		for (module, modulePath) in wave.forwards().enumerate() {
			val moduleFiles = mem::replace(&var files[module], Vec())
			// A directory with no files is no module: the import that named
			// it reports it, with the span of the path it wrote.
			if moduleFiles.isEmpty() && !modulePath.isEmpty() then continue
			// What `@derive` writes, as syntax of the module's own, placed in
			// its files.
			val derived = expand(&moduleFiles, &var loaded.interner)
			val (dir, package) = places[module].clone()
			var prefix = String()
			var depends: Vec<String> = Vec()
			var packageRoot: Option<String> = .None
			if package is .Some(p) {
				prefix = loaded.packages[p].prefix.clone()
				for (name, _, _) in loaded.packages[p].depends {
					depends.push(name.clone())
				}
				packageRoot = .Some(loaded.packages[p].dir.clone())
			}
			loaded.modules.push(LoadedModule(
				path: modulePath.clone(),
				files: move moduleFiles,
				derived: move derived,
				dir: move dir,
				prefix: move prefix,
				depends: move depends,
				root: move packageRoot,
			))
		}
		wave = move next
	}
	// The root module was the first wave, so it is index 0, which is where
	// `main` must be.
	if importCycle(&edges) is .Some(diagnostic) then loaded.diagnostics.push(move diagnostic)
	loaded.diagnostics.sortByKey((d) => d.primary.span.lo)
	return .Ok(move loaded)
}

/// The `.wip` files of one module of a package whose root is `root`, in
/// name order. `package.wip` is the package's, not a module's.
fn moduleFiles(
	root: str,
	module: str,
	mode: Mode,
	target: Target,
	overlay: &Overlay,
): Result<Vec<(String, String)>, String> = {
	val dir = moduleDir(root, module)
	// An empty path is the current directory: `wip run main.wip`. Reading it
	// as a path would find nothing.
	val listing = if dir.isEmpty() then "." else dir.toStr()
	val .Ok(entries) = fs::readDir(listing) else {
		// The import reports it, with the span of the path that named it.
		return .Ok(Vec())
	}
	var names: Vec<String> = Vec()
	for entry in entries {
		names.push(entry.name.clone())
	}
	for name in overlay.unsavedIn(listing) {
		names.push(move name)
	}
	var files: Vec<(String, String)> = Vec()
	for named in names {
		val name = named.toStr()
		if path::extension(name) != .Some("wip") then continue
		// A test file is compiled by `wip test` and by nothing else, and a
		// file may say which target it is for.
		if name == "package.wip" || !mode.takes(name) || !takesFile(name, target) then continue
		// Named as the user wrote the path: `main.wip`, not `./main.wip`.
		val file = path::join(dir, name)
		val text = match overlay.read(file) {
			.Ok(text) => move text
			.Err(error) => return .Err("cannot read `\(file)`: \(error)")
		}
		if text.len() > 0xFFFF_FFFF then return .Err("`\(file)` is larger than 4 GiB")
		files.push((move file, move text))
	}
	files.sortBy((a, b) => a.0 < b.0)
	return .Ok(move files)
}

/// The modules of a package below `dir`, whose path is `prefix`: every
/// directory under it that holds a `.wip` file and is named as a module
/// may be, but not a hidden one, `target`, or one with a `package.wip` of
/// its own, which is another package. In name order, so a run loads them
/// the same way each time.
fn packageModules(dir: str, prefix: str, out: &var Vec<String>) = {
	val .Ok(entries) = fs::readDir(dir) else {
		return
	}
	var dirs: Vec<(String, String)> = Vec()
	for entry in entries {
		if !entry.isDirectory() then continue
		val name = entry.name.toStr()
		val full = path::join(dir, name)
		if isModuleName(name) && name != "target" && !fs::exists(path::join(full, "package.wip")) {
			dirs.push((name, move full))
		}
	}
	dirs.sortBy((a, b) => a.0 < b.0)
	for (name, full) in dirs {
		val module = if prefix.isEmpty() then name.clone() else "\(prefix)::\(name)"
		var holdsWip = false
		if fs::readDir(full) is .Ok(inside) {
			for entry in inside {
				if entry.kind == .File && path::extension(entry.name) == .Some("wip") then
					holdsWip = true
			}
		}
		if holdsWip then out.push(module.clone())
		packageModules(full, module, &var out)
	}
}

/// Whether a directory's name could be a module's in an import: a letter
/// or `_`, then letters, digits and `_`. A hidden directory is not one.
fn isModuleName(name: str): bool = {
	if name.isEmpty() then return false
	for i in 0..name.len() {
		val b = name[i]
		val letter = b is b'a'..=b'z' | b'A'..=b'Z' | b'_'
		if i == 0 && !letter then return false
		if !letter && b !is b'0'..=b'9' then return false
	}
	return true
}

/// Where a module's own files are: the root, and then its path.
pub fn moduleDir(root: str, module: str): String = {
	var dir = String::of(root)
	for segment in module.split("::") {
		if segment.isEmpty() then continue
		dir = path::join(dir, segment)
	}
	return move dir
}

extend LoadedModule {
	/// The module as the checker reads it: its files, and then what `@derive`
	/// wrote for them.
	pub fn syntax(): ModuleAst from self = {
		var files: Vec<&Ast> = Vec()
		for f in self.files {
			files.push(&f.ast)
		}
		if !self.derived.items.isEmpty() then files.push(&self.derived)
		// A module of the program has a package; the standard library's have
		// none, and no directory. An empty directory is the current one, as a
		// bare file name's parent is.
		return ModuleAst(
			path: self.path.clone(),
			files: move files,
			prefix: self.prefix.clone(),
			depends: self.depends.clone(),
			dir: if self.root.isSome() then
				.Some(if self.dir.isEmpty() then "." else self.dir.clone())
			else .None,
			root: match self.root {
				.Some(root) => .Some(if root.isEmpty() then "." else root.clone())
				.None => .None
			},
		)
	}
}
