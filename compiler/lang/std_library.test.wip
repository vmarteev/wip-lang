// The standard library, compiled as a program uses it.

import std::fs
import std::future
import hir::{BOOL}
import mir::{lowerFn, readsBeforeWrites}

/// A temporary made in one branch of what its statement evaluates — the
/// panic's message an arena's index builds where a handle is stale — is
/// dropped where the branches join, and its flag is written on every path
/// before it is read. An unwritten flag would be read as anything.
@test
fn noFlagIsReadBeforeItIsWritten() = {
	val unique = Unique::new()
	val .Ok(dir) = TempDir::new(&unique) else {
		panic("a temporary directory")
	}
	val main = dir.join("main.wip")
	val program =
		"import std::collections::{Arena, Handle}\n\nfn read(nodes: &Arena<i64>, at: Handle<i64>): i64 = nodes[at]\n\nfn main() = {}\n"
	assert(fs::writeFile(main.toStr(), program).isOk())
	var timings = Timings()
	val .Ok(loaded) = loadMode(main.toStr(), .Program, &var timings, future::cores()) else {
		panic("the program is read")
	}
	var read = move loaded
	val checked = checkLoaded(&var read, &var timings)
	for d in checked.diagnostics {
		assert(!d.isError(), d.message.toStr())
	}
	for id in checked.program.fns.ids() {
		val def = &checked.program.fns[id]
		if read.interner.resolve(def.name) != "read" then continue
		val .Some(hir) = def.body else {
			panic("a body")
		}
		val body = lowerFn(&checked.program, &read.interner, &def, &hir)
		for (local, _) in readsBeforeWrites(&body) {
			assert(body.local(local).ty != BOOL, "a flag is read before it is written")
		}
		return
	}
	panic("`read` is there")
}
