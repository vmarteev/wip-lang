// The standard library, compiled as a program uses it.

import std::fs
import std::future
import std::path
import hir::{BOOL}
import mir::{lowerFn, readsBeforeWrites}

/// A temporary made in one branch of what its statement evaluates — the
/// panic's message an arena's index builds where a handle is stale — is
/// dropped where the branches join, and its flag is written on every path
/// before it is read. An unwritten flag would be read as anything.
@test
fn noFlagIsReadBeforeItIsWritten() = {
	val .Ok(dir) = fs::TempDir::new() else panic("a temporary directory")
	val main = dir.join("main.wip")
	val program =
		"import std::collections::{Arena, Handle}\n\nfn read(nodes: &Arena<i64>, at: Handle<i64>): i64 = nodes[at]\n\nfn main() = {}\n"
	assert(fs::writeFile(main.toStr(), program).isOk())
	var timings = Timings()
	val .Ok(loaded) = loadMode(main.toStr(), .Program, &var timings, future::cores()) else {
		panic("the program is read")
	}
	var read = loaded
	val checked = checkLoaded(&var read, &var timings)
	for d in checked.diagnostics do
		assert(!d.isError(), d.message.toStr())

	for id in checked.program.fns.ids() {
		val def = &checked.program.fns[id]
		if read.interner.resolve(def.name) != "read" then
			continue

		val .Some(hir) = def.body else panic("a body")
		val body = lowerFn(&checked.program, &read.interner, id, &hir)
		for (local, _) in readsBeforeWrites(&body) do
			assert(body.local(local).ty != BOOL, "a flag is read before it is written")

		return
	}
	panic("`read` is there")
}

/// A binding of an `is` whose type cleans up after itself is dropped by a
/// flag, and where the test fails the flag says there is nothing: a
/// `return` after the `if` drops everything that may hold a value, and
/// would otherwise read a flag nothing wrote, and drop whatever the
/// binding's slot held — a descriptor of 0, closed.
@test
fn aBindingOfAFailedIsHasNothingToDrop() = {
	val .Ok(dir) = fs::TempDir::new() else panic("a temporary directory")
	val main = dir.join("main.wip")
	val program =
		"struct Handle {\n\tn: i64\n}\n\nextend Handle: Destroy {\n\tvar fn destroy() = {}\n}\n\nfn found(n: i64): Option<Handle> = if n > 0 then .Some(Handle(n: n)) else .None\n\nfn kept(n: i64): i64 = {\n\tif found(n) is .Some(handle) {\n\t\tvar held = handle\n\t\tif held.n > 3 then return held.n\n\t}\n\treturn 0\n}\n\nfn main() = {}\n"
	assert(fs::writeFile(main.toStr(), program).isOk())
	var timings = Timings()
	val .Ok(loaded) = loadMode(main.toStr(), .Program, &var timings, future::cores()) else {
		panic("the program is read")
	}
	var read = loaded
	val checked = checkLoaded(&var read, &var timings)
	for d in checked.diagnostics do
		assert(!d.isError(), d.message.toStr())

	for id in checked.program.fns.ids() {
		val def = &checked.program.fns[id]
		if read.interner.resolve(def.name) != "kept" then
			continue

		val .Some(hir) = def.body else panic("a body")
		val body = lowerFn(&checked.program, &read.interner, id, &hir)
		for (local, _) in readsBeforeWrites(&body) do
			assert(body.local(local).ty != BOOL, "a flag is read before it is written")

		return
	}
	panic("`kept` is there")
}

/// A library module's file named for a target is read for that target
/// alone, as a program's own is: a Mac's TLS and Linux's both define the
/// same type, and reading both would define it twice.
@test
fn aLibraryFileNamedForATargetIsReadForItAlone() = {
	val .Ok(home) = fs::TempDir::new() else panic("a temporary directory")
	val dir = home.join("std/demo")
	assert(fs::makeDirs(dir.toStr()).isOk())
	for name in ["demo.wip", "demo.apple.wip", "demo.linux.wip"] do
		assert(fs::writeFile(path::join(dir.toStr(), name), "").isOk())

	val namesFor = (target: str) => {
		val .Ok(targets) = Target::parse(target) else panic("\(target) is a target")
		val .Ok(files) = stdFiles(home.path.toStr(), "std::demo", targets[0]) else {
			panic("it is read")
		}
		val names: Vec<String> = files.map((f) => f.0.clone())
		names.join(" ")
	}
	assert(namesFor("macos") == "std/demo/demo.apple.wip std/demo/demo.wip")
	assert(namesFor("ios") == "std/demo/demo.apple.wip std/demo/demo.wip")
	assert(namesFor("linux") == "std/demo/demo.linux.wip std/demo/demo.wip")
}
