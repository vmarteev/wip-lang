// The Language Server Protocol's framing, and its way of naming places:
// JSON-RPC messages behind a `Content-Length` header, files by `file://`
// URI, and positions by line and UTF-16 column. What a message carries is
// read into the protocol's types and written from them; the envelope around
// it, JSON-RPC's, is an object of pairs.

import std::io
import std::json::{Json, parse as parseJson}

/// The next message, or nothing at the end of the input.
pub fn readMessage(input: &var io::Reader): Result<Option<Json>, String> = {
	var length: Option<i64> = .None
	while true {
		var line = String()
		match input.readLine(&var line) {
			.Ok(true) => {}
			.Ok(false) => return .Ok(.None)
			.Err(error) => return .Err("\(error)")
		}
		val header = line.toStr().trimEnd()
		if header.isEmpty() then
			break

		if header.stripPrefix("Content-Length:") is .Some(n) then
			length = if n.trim().toInt() is .Ok(count) then count else .None
	}
	val .Some(count) = length else return .Err("a message with no Content-Length")
	var body = String()
	if input.readExact(count, &var body) is .Err(error) then
		return .Err("\(error)")

	return match parseJson(body) {
		.Ok(message) => .Ok(message)
		.Err(error) => .Err("\(error)")
	}
}

/// `message`, framed, on standard output.
pub fn writeMessage(message: &Json) = {
	val body = message.toString()
	io::print("Content-Length: \(body.len())\r\n\r\n\(body)")
	// Standard output is the editor's; if it has gone, so will the server.
	io::flush()
}

/// An object of `fields`, in their order.
pub fn object(fields: &[(str, Json)]): Json = {
	val pairs: Vec<(String, Json)> = [
		for (name, value) in fields do
			yield (name, value.clone())
	]
	return .Object(pairs)
}

/// What `value` holds at `path`, a field of a field: `Null` where any of it
/// is missing, as an editor's message leaves out what it need not say.
pub fn fieldAt(value: &Json, path: &[str]): Json = {
	var here = value.clone()
	for name in path do
		here = match here.get(name) {
			.Some(found) => found.clone()
			.None => Json::Null
		}

	return here
}

/// The text `value` holds at `path`, or the empty text.
pub fn textAt(value: &Json, path: &[str]): String = match fieldAt(&value, &path) {
	.Text(text) => text
	_ => String()
}

/// Text as JSON.
pub fn jsonText(text: str): Json = .Text(text)

/// Where each line of a text begins, to turn byte offsets into the
/// protocol's positions and back.
pub view struct Lines {
	text: str
	starts: Vec<i64>
}

extend Lines {
	pub static fn of(text: str): Lines = {
		var starts = Vec::of([0])
		for i in 0..text.len() do
			if text[i] == b'\n' then
				starts.push(i + 1)

		return Lines(text:, starts:)
	}

	/// The line and column of a byte offset, the column counted in UTF-16
	/// code units as the protocol counts it.
	pub fn position(at: i64): Position = {
		var offset = if at < self.text.len() then at else self.text.len()
		while offset > 0 && offset < self.text.len() && (self.text[offset] & 0xC0) == 0x80 do
			offset -= 1

		var line = 0
		while line + 1 < self.starts.len() && self.starts[line + 1] <= offset do
			line += 1

		var character = 0
		var i = self.starts[line]
		while i < offset {
			val (c, width) = self.text.charAt(i)
			character += utf16Len(c)
			i += width
		}
		return Position(line:, character:)
	}

	pub fn range(lo: i64, hi: i64): Range = Range(start: self.position(lo), end: self.position(hi))

	/// The byte offset of a position; past the end of a line is its end,
	/// and past the last line is the end of the text.
	pub fn offset(position: &Position): i64 = {
		val line = position.line
		val character = position.character
		if line < 0 || line >= self.starts.len() then
			return self.text.len()

		val start = self.starts[line]
		var units = 0
		var i = start
		while i < self.text.len() {
			val (c, width) = self.text.charAt(i)
			if units >= character || c == '\n' then
				return i

			units += utf16Len(c)
			i += width
		}
		return self.text.len()
	}

	/// The range of the whole text.
	pub fn whole(): Range = self.range(0, self.text.len())
}

/// How many UTF-16 code units a character takes.
fn utf16Len(c: char): i64 = if (c as u32) >= 0x10000 then 2 else 1

/// The file a `file://` URI names. On Windows a URI names a path with
/// `/` between its names and one before its drive, `file:///C:/work/x.wip`
/// — a drive's `:` escaped or not — and a share by its server,
/// `file://server/share/x.wip`; the path is Windows', with `\`s.
pub fn pathOf(uri: str): Option<String> = {
	val .Some(rest) = uri.stripPrefix("file://") else return .None
	var decoded = String()
	var i = 0
	while i < rest.len() {
		if rest[i] == b'%' &&
			i + 3 <= rest.len() &&
			rest[i + 1..i + 3].toInt(radix: 16) is .Ok(byte) {
			decoded.pushByte(byte as u8)
			i += 3
			continue
		}
		decoded.pushByte(rest[i])
		i += 1
	}
	if !decoded.isValidUtf8() then
		return .None

	if TARGET_OS != "windows" then
		return decoded

	val drive =
		decoded.len() >= 3 && decoded[0] == b'/' && decoded[1].isAsciiLetter() && decoded[2] == b':'
	val windows: String = when {
		drive => decoded[1..decoded.len()]
		decoded.startsWith("/") => decoded
		else => "//\(decoded)"
	}
	return windows.replace("/", by: "\\")
}

/// The `file://` URI of a path, with what a URI may not hold escaped. On
/// Windows its names are between `/`s, with one before a drive's,
/// `file:///C:/work/x.wip`, and a share's server is the URI's,
/// `file://server/share/x.wip`.
pub fn uriOf(path: str): String = {
	var uri = String::of("file://")
	val windows = TARGET_OS == "windows"
	val written: String = if windows then path.replace("\\", by: "/") else path
	val drive = windows && written.len() >= 2 && written[0].isAsciiLetter() && written[1] == b':'
	if drive then
		uri.push("/")

	val start = if windows && written.startsWith("//") then 2 else 0
	val digits = "0123456789ABCDEF"
	for i in start..written.len() {
		val byte = written[i]
		val kept =
			(byte as char).isAsciiAlphanumeric() ||
			byte is b'-' | b'.' | b'_' | b'~' | b'/' ||
			drive && i == 1
		if kept then
			uri.pushByte(byte)
		else {
			uri.push("%")
			uri.pushByte(digits[(byte >> 4)])
			uri.pushByte(digits[(byte & 15)])
		}
	}
	return uri
}
