// A directory that is removed when it is dropped.

import std::fs
import std::path
import std::process
import std::sync::{Atomic}

/// A fresh directory under the system's temporary directory, removed when
/// it is dropped.
pub struct TempDir {
	pub path: String
}

extend TempDir {
	/// A directory named by `unique`, under `$TMPDIR` or `/tmp`.
	pub static fn new(unique: &Unique): Result<TempDir, String> = {
		val root = temporaryRoot()
		val dir = path::join(root, "wip-\(unique.next())")
		if fs::makeDirs(dir) is .Err(error) then
			return .Err("cannot create a temporary directory: \(error)")
		return .Ok(TempDir(path: move dir))
	}

	/// A file or directory in it.
	pub fn join(name: str): String = path::join(self.path, name)
}

extend TempDir: Destroy {
	var fn destroy() = {
		fs::removeAll(self.path)
	}
}

/// Names no other writer uses: this process's number, and a count the
/// threads of a build share. The compiler keeps no state of its own beyond
/// what it is handed, so a build makes one and hands it to whatever names a
/// file.
pub struct Unique {
	count: Atomic<i64>
}

extend Unique {
	pub static fn new(): Unique = Unique(count: Atomic::of(0 as i64))

	/// A name not given before: `4211-7`.
	pub fn next(): String = "\(process::id())-\(self.count.add(1))"
}
