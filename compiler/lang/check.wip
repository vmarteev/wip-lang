// Parsing and checking a file or a loaded program: every phase before code
// is generated.

import std::fs
import std::time::{Instant}
import analysis
import mir
import hir::{ModuleAst, Program, fieldTables, instantiate, lower}
import syntax::{
	Ast,
	Code,
	Diagnostic,
	Interner,
	LIST_ONLY_WALKED,
	LOOP_AS_LIST,
	LOOP_AS_SEARCH,
	Span,
	lexAt,
	parseAt
}

/// A file's name, as the command line gave it, and its text.
pub struct SourceFile {
	pub name: String
	pub text: String
}

extend SourceFile {
	pub static fn read(path: str): Result<SourceFile, String> = {
		val text = match fs::readFile(path) {
			.Ok(text) => text
			.Err(error) => return .Err("cannot read `\(path)`: \(error)")
		}
		if !text.isValidUtf8() then
			return .Err("cannot read `\(path)`: stream did not contain valid UTF-8")

		// Spans are u32 byte offsets.
		if text.len() > 0xFFFF_FFFF then
			return .Err("`\(path)` is larger than 4 GiB")

		return SourceFile(name: path, text: text)
	}
}

pub struct ParsedFile {
	pub ast: Ast
	pub interner: Interner
	/// Lexer and parser diagnostics together, in source order.
	pub diagnostics: Vec<Diagnostic>
}

pub fn parseFile(file: &SourceFile): ParsedFile = {
	var interner = Interner::new()
	val lexed = lexAt(file.text, 0, &var interner)
	val parsed = parseAt(file.text, 0, &lexed)
	var diagnostics: Vec<Diagnostic> = Vec()
	for diagnostic in lexed.diagnostics do
		diagnostics.push(diagnostic.clone())

	for diagnostic in parsed.diagnostics do
		diagnostics.push(diagnostic.clone())

	diagnostics.sortByKey((diagnostic) => diagnostic.primary.span.lo)
	return ParsedFile(ast: parsed.ast, interner: interner, diagnostics: diagnostics)
}

/// A checked program: every module, and everything the phases reported.
pub struct Checked {
	pub program: Program
	pub diagnostics: Vec<Diagnostic>
}

/// Checks a loaded program's types and moves, and works out the constants that
/// are run, whose strings the interner takes.
pub fn checkLoaded(loaded: &var Loaded, timings: &var Timings): Checked = {
	val checked = checkTypes(&loaded, &var timings)
	var program = checked.program
	var diagnostics = checked.diagnostics
	if !anyError(&diagnostics) {
		// What each generator keeps between calls, now that every one is
		// known.
		mir::generatorFrames(&var program, &loaded.interner)
		val sources = &loaded.sources
		val started = Instant::now()
		val evaluated = mir::evaluateConstants(
			&var program,
			&var loaded.interner,
			(span) => sources.locate(span),
		)
		timings.record("constants", started)
		diagnostics.append(evaluated)
	}
	// A program with errors is not told what it never uses: what it has not
	// finished writing is often what would use it.
	if anyError(&diagnostics) then
		diagnostics.retain((d) => !d.code.saysUnused())

	// A fix that says a loop as a list or a search takes the loop's words
	// away, and the checker does not see comments: where it would take one
	// with them, the warning is not given.
	val sources = &loaded.sources
	diagnostics.retain((d) => !losesComment(&d, &sources))
	diagnostics.sortByKey((d) => d.primary.span.lo)
	return Checked(program: program, diagnostics: diagnostics)
}

/// The warnings whose fix takes a loop's words away, keeping its parts.
val MOVES_LOOPS: [Code; 3] = [LOOP_AS_LIST, LIST_ONLY_WALKED, LOOP_AS_SEARCH]

/// Whether a diagnostic's fix, one that moves a loop's code, replaces text
/// that holds a comment.
fn losesComment(diagnostic: &Diagnostic, sources: &Sources): bool = {
	if !MOVES_LOOPS.contains(&diagnostic.code) then
		return false

	val .Some(fix) = diagnostic.fix else return false
	for edit in fix.edits {
		if edit.span.hi <= edit.span.lo then
			continue

		val .Some((_, text, base)) = sources.of(edit.span) else continue
		val replaced = text[(edit.span.lo - base) as i64..(edit.span.hi - base) as i64]
		if replaced.contains("//") then
			return true
	}
	return false
}

/// What the checker makes of a loaded program: its types checked, its moves
/// and borrows, and the instances of its generic functions made, before
/// anything of it is run.
/// What `wip check --dump-hir` writes.
pub fn checkTypes(loaded: &Loaded, timings: &var Timings): Checked = {
	var modules: Vec<ModuleAst> = Vec()
	for module in loaded.modules do
		modules.push(module.syntax())

	var started = Instant::now()
	val lowered = lower(&modules, &loaded.interner, loaded.threads, loaded.defines.clone())
	timings.record("type check", started)
	// A type error inside an item that also has a syntax error is almost
	// always a consequence of the recovery, not a separate mistake.
	var broken: Vec<Span> = Vec()
	for module in loaded.modules {
		for file in module.written() {
			for item in file.items {
				val span = item.span()
				for d in loaded.diagnostics {
					if d.isError() && inside(span, d.primary.span.lo) {
						broken.push(span)
						break
					}
				}
			}
		}
	}
	var diagnostics = loaded.diagnostics.clone()
	for d in lowered.diagnostics {
		var dropped = false
		for item in broken do
			if inside(item, d.primary.span.lo) then
				dropped = true

		if !dropped then
			diagnostics.push(d.clone())
	}
	var program = lowered.program
	if !anyError(&diagnostics) {
		started = Instant::now()
		val analysed = analysis::check(&program, &loaded.interner, loaded.threads)
		timings.record("move check", started)
		diagnostics.append(analysed.diagnostics)
		// A place given away where it is used is a move there, which empties
		// it as a written one does.
		for (id, places) in analysed.given {
			var .Some(body) = program.fns[id].body.take() else continue
			for place in places do
				body.moveAt(place)

			program.fns[id].body = body
		}
	}
	// Instances of generic functions, once they are known to be correct.
	if !anyError(&diagnostics) {
		started = Instant::now()
		val instances = instantiate(&var program, &loaded.interner)
		timings.record("instances", started)
		diagnostics.append(instances)
		// Each struct a `fieldsOf` asks about, as the table it reads.
		if !anyError(&diagnostics) then
			fieldTables(&var program)
	}
	diagnostics.sortByKey((d) => d.primary.span.lo)
	return Checked(program: program, diagnostics: diagnostics)
}

fn inside(span: Span, pos: u32): bool = span.lo <= pos && pos <= span.hi

fn anyError(diagnostics: &[Diagnostic]): bool = {
	return diagnostics.any((d) => d.isError())
}
