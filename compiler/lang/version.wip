// Which version of Wip this compiler is.

import std::embed

/// The version, as the compiler names what it built with: `MAJOR.MINOR.PATCH`.
pub val VERSION: str = "0.3.1"

/// The commit the compiler was built from and its day, `4a5290ba1c3e
/// 2026-10-12`, as `scripts/build.sh` writes them beside this file; nothing
/// where it was built from a copy without its history, or by hand.
val COMMIT: str = embed::textOr("commit.txt", "")

/// The version as `wip --version` says it, and as the language server and
/// the tools' cache name it: the commit and its day after it, where they are
/// known.
pub fn described(): String = {
	val commit = COMMIT.trim()
	return if commit.isEmpty() then VERSION else "\(VERSION) (\(commit))"
}
