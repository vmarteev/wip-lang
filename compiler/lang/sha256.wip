// What the cache is named by: SHA-256, the library's, fed in fields and
// written in hexadecimal. A cache that answered with the wrong object would
// be worse than none, so the key is a hash nothing collides by accident.

import std::digest::{Sha256, sha256}

/// Feeds `bytes` with its length in front, so that two pieces cannot run
/// into each other: `("ab", "c")` and `("a", "bc")` hash apart.
fn field(hash: &var Sha256, bytes: &[u8]) = {
	val length = bytes.len() as u64
	var written = [0 as u8; 8]
	for i in 0..8 {
		written[i] = (length >> (8 * i) as u64) as u8
	}
	hash.write(&written)
	hash.write(bytes)
}

/// A digest, in hexadecimal.
fn hex(digest: &[u8]): String = {
	val digits = "0123456789abcdef"
	var out = String()
	for byte in digest {
		out.pushByte(digits[(byte >> 4) as i64])
		out.pushByte(digits[(byte & 15) as i64])
	}
	return move out
}

/// The hash of `bytes`, in hexadecimal.
fn hexOf(bytes: &[u8]): String = hex(sha256(bytes))
