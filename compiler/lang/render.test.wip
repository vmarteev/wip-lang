// Diagnostics, drawn and dumped.

import syntax::{Diagnostic, INVALID_MAIN, Span}

/// A text that would break a line, or be read as an escape, is written
/// so that it is one line, its backslashes and controls escaped.
@test
fn aTextIsOneLine() = {
	assert(escaped("a\\b\nc\td\u{7}") == "a\\\\b\\nc\\td\\u{7}")
	assert(escaped("`é` — fine") == "`é` — fine")
}

/// A diagnostic that points into no file is shown without an excerpt, never
/// dropped.
@test
fn aDiagnosticOutsideEveryFileIsShown() = {
	val diagnostic = Diagnostic::error(
		INVALID_MAIN,
		String::of("no `main` function"),
		Span::at(0),
		String::of("the program starts at `main`"),
	).withHelp(String::of("add `fn main(): i64 = 0`"))
	val rendered = renderProgram([move diagnostic], Sources::new(), false)
	assert(
		rendered == "[E0318] Error: no `main` function\n    Help: add `fn main(): i64 = 0`\n",
		rendered.toStr(),
	)
}
