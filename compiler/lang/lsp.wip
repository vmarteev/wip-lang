// `wip lsp`: a language server, speaking the Language Server Protocol on
// standard input and output.
//
// Every edit checks again the whole program each open file belongs to, with
// what the editor has not saved in place of the disk; a program of
// thousands of lines is checked in milliseconds, so nothing is kept from one
// check to the next. Messages that arrive together are answered together,
// and the program is checked once after them.

import std::collections::{Map, Set}
import std::future::{Future, Receiver, channel}
import std::io
import std::json
import std::json::{Json}
import std::libc
import hir::{Program}

/// Runs the server until the editor says `exit`, and ends the process with
/// the code it ends with: the thread that reads may be waiting for input
/// that will never come, which a server that returned would wait for too.
pub fn serve(threads: i64): never = {
	val (sender, messages) = channel<Json>()
	val reading = Future::run(own () => {
		var input = io::stdin()
		while readMessage(&var input) is .Ok(.Some(message)) {
			sender.send(message)
		}
	})
	var server = Server(threads: threads)
	while messages.receive() is .Some(message) {
		var next: Option<Json> = .Some(message)
		while next.take() is .Some(one) {
			if server.handle(one) is .Some(code) then libc::exit(code as c_int)
			next = match messages.tryReceive() {
				.Value(more) => .Some(more)
				_ => .None
			}
		}
		if server.dirty then server.recheck()
	}
	// The editor went away without saying `exit`.
	libc::exit(1)
}

/// A program checked with a placeholder at the cursor, and where the file
/// asked about begins in it.
struct Patched {
	loaded: Loaded
	program: Program
	base: u32
}

struct Server {
	/// The files the editor has open, by URI.
	documents: Vec<OpenFile> = Vec()
	overlay: Overlay = Overlay()
	/// The files that have diagnostics shown, to clear them once they have
	/// none.
	published: Vec<String> = Vec()
	/// The fixes of the diagnostics shown, by file.
	fixes: Map<String, Vec<QuickFix>> = Map()
	/// Each program last checked, to answer what its names mean.
	programs: Vec<(Loaded, Program)> = Vec()
	/// The program each directory's files belong to, found once.
	roots: Map<String, String> = Map()
	/// Whether an edit has not been checked yet.
	dirty: bool = false
	shutDown: bool = false
	/// How many threads each check splits its work across.
	threads: i64
}

extend Server {
	/// Handles one message; the exit code once the editor says `exit`.
	var fn handle(message: Json): Option<i64> = {
		val method = textAt(&message, ["method"])
		val params = fieldAt(&message, ["params"])
		val .Some(id) = message.get("id") else return self.notified(method, &params)
		// A response to a request of ours; the server makes none.
		if method.isEmpty() then return .None
		// A request is answered from what the editor has sent so far.
		if self.dirty then self.recheck()
		val response = match self.answer(method, &params) {
			.Ok(result) => object([
				("jsonrpc", jsonText("2.0")),
				("id", id.clone()),
				("result", result),
			])
			.Err((code, said)) => object([
				("jsonrpc", jsonText("2.0")),
				("id", id.clone()),
				("error", object([("code", Json::Int(code)), ("message", .Text(said))])),
			])
		}
		writeMessage(&response)
		return .None
	}

	/// The result of a request, or the code and the words of its error.
	var fn answer(method: str, params: &Json): Result<Json, (i64, String)> = {
		val result: Json = match method {
			"initialize" => json::toJson(capabilities())
			"shutdown" => {
				self.shutDown = true
				Json::Null
			}
			"textDocument/formatting" => {
				val asked = paramsOf<DocumentParams>(&params)?
				match self.document(asked.textDocument.uri) {
					.Some(at) => json::toJson(formatted(&self.documents[at]))
					.None => .Null
				}
			}
			"textDocument/documentSymbol" => {
				val asked = paramsOf<DocumentParams>(&params)?
				match self.document(asked.textDocument.uri) {
					.Some(at) => json::toJson(symbols(&self.documents[at]))
					.None => .Null
				}
			}
			"textDocument/codeAction" => json::toJson(
				self.codeActions(paramsOf<CodeActionParams>(&params)?),
			)
			"textDocument/hover" => {
				val asked = paramsOf<PositionParams>(&params)?
				self.atPosition(asked.textDocument.uri, &asked.position, .Hover)
			}
			"textDocument/inlayHint" => json::toJson(self.hints(paramsOf<DocumentParams>(&params)?))
			"textDocument/completion" => json::toJson(
				self.complete(paramsOf<PositionParams>(&params)?),
			)
			"textDocument/signatureHelp" => json::toJson(
				self.signature(paramsOf<PositionParams>(&params)?),
			)
			"textDocument/references" => {
				val asked = paramsOf<ReferenceParams>(&params)?
				val declaration = match asked.context {
					.Some(context) => context.includeDeclaration
					.None => true
				}
				self.atPosition(asked.textDocument.uri, &asked.position, .References(declaration))
			}
			"textDocument/rename" => {
				val asked = paramsOf<RenameParams>(&params)?
				val .Some(at) = self.document(asked.textDocument.uri) else return .Ok(.Null)
				match rename(
					&self.programs,
					&self.documents,
					&self.documents[at],
					&asked.position,
					asked.newName,
				) {
					.Ok(edit) => json::toJson(&edit)
					.Err(why) => return .Err((-32803, why))
				}
			}
			"textDocument/definition" => {
				val asked = paramsOf<PositionParams>(&params)?
				self.atPosition(asked.textDocument.uri, &asked.position, .Definition)
			}
			_ => return .Err((-32601, "`wip lsp` does not answer `\(method)`"))
		}
		return .Ok(result)
	}

	var fn notified(method: str, params: &Json): Option<i64> = {
		match method {
			"exit" => return .Some(if self.shutDown then 0 else 1)
			"textDocument/didOpen" => {
				val .Ok(given) = json::fromJson<DidOpen>(params.clone()) else return .None
				self.opened(given.textDocument.uri, given.textDocument.text.clone())
			}
			"textDocument/didChange" => {
				// The whole text, as `initialize` asked for.
				val .Ok(given) = json::fromJson<DidChange>(params.clone()) else return .None
				if given.contentChanges.last() is .Some(change) then
					self.opened(given.textDocument.uri, change.text.clone())
			}
			"textDocument/didClose" => {
				val .Ok(given) = json::fromJson<DocumentParams>(params.clone()) else return .None
				val uri = &given.textDocument.uri
				var i = 0
				while i < self.documents.len() {
					if self.documents[i].uri == uri {
						val closed = self.documents.remove(i)
						self.overlay.remove(closed.path)
					} else {
						i += 1
					}
				}
				self.dirty = true
			}
			// A save, or a file changed on disk, can change what another file
			// means, and which program a file is in.
			"textDocument/didSave" | "workspace/didChangeWatchedFiles" => {
				self.roots.clear()
				self.dirty = true
			}
			_ => {}
		}
		return .None
	}

	var fn opened(uri: str, text: String) = {
		val .Some(path) = pathOf(uri) else return
		self.overlay.set(path, text.clone())
		for document in self.documents {
			if document.uri == uri {
				document.text = text
				self.dirty = true
				return
			}
		}
		self.documents.push(OpenFile(uri: uri, path: path, text: text))
		self.dirty = true
	}

	/// Where among the open files is the document `uri` names.
	fn document(uri: str): Option<i64> = {
		for (at, document) in self.documents.forwards().enumerate() {
			if document.uri == uri then return .Some(at)
		}
		return .None
	}

	/// What could be written at the position a request names: the program is
	/// checked with a placeholder written there, so that it parses.
	var fn complete(asked: &PositionParams): CompletionList = {
		val .Some((at, cursor)) = self.requestAt(&asked) else return CompletionList(items: Vec())
		val .Some(patched) = self.patched(at, cursor, "") else return CompletionList(items: Vec())
		return completionItems(
			&patched.loaded,
			&patched.program,
			&self.documents[at],
			patched.base,
			cursor,
		)
	}

	/// The signature of the call the cursor is in the arguments of, and which
	/// argument it is at.
	var fn signature(asked: &PositionParams): Option<SignatureHelp> = {
		val (at, cursor) = self.requestAt(&asked)?
		val call = callAt(self.documents[at].text, cursor)?
		// The call may not be closed yet: then it is closed after the
		// placeholder.
		for close in ["", ")"] {
			if self.patched(at, cursor, close) is .Some(patched) {
				if signatureHelp(&patched.loaded, &patched.program, patched.base, &call) is .Some(
					help,
				) {
					return .Some(help)
				}
			}
		}
		return .None
	}

	/// The open file a request names, and the byte offset of the position it
	/// names; nothing for a file of the standard library.
	fn requestAt(asked: &PositionParams): Option<(i64, i64)> = {
		val at = self.document(asked.textDocument.uri)?
		val document = &self.documents[at]
		if inStd(document.path) then return .None
		val cursor = Lines::of(document.text).offset(&asked.position)
		return .Some((at, cursor))
	}

	/// The program of the open file `at`, checked with the placeholder name,
	/// and `close` after it, written at `cursor`, so that the text there
	/// parses.
	var fn patched(at: i64, cursor: i64, close: str): Option<Patched> = {
		val document = &self.documents[at]
		val text = document.text.toStr()
		val patchedText = "\(text[0..cursor])\(PLACEHOLDER)\(close)\(text[cursor..text.len()])"
		var overlay = self.overlay.clone()
		overlay.set(document.path, patchedText)
		val root = programRoot(document.path, &overlay, &var self.roots, self.threads)
		var loaded = match loadOverlaid(root, .Tests, &overlay, self.threads) {
			.Ok(loaded) => loaded
			.Err(..) => return .None
		}
		var timings = Timings()
		val checked = checkLoaded(&var loaded, &var timings)
		val file = canonicalFile(document.path)
		var base: Option<u32> = .None
		for (name, _, start) in loaded.sources.entries() {
			if base.isNone() && name.startsWith("/") && canonicalFile(name) == file then
				base = .Some(start)
		}
		val .Some(start) = base else return .None
		return .Some(Patched(loaded: loaded, program: checked.program, base: start))
	}

	/// Answers a request at a position, from the programs that hold the
	/// document `uri` names.
	fn atPosition(uri: str, position: &Position, asked: PositionRequest): Json = {
		val .Some(at) = self.document(uri) else return .Null
		val file = &self.documents[at]
		return match asked {
			.Hover => json::toJson(hover(&self.programs, &self.documents, &file, &position))
			.Definition => json::toJson(
				definition(&self.programs, &self.documents, &file, &position),
			)
			.References(declaration) => json::toJson(
				references(&self.programs, &self.documents, &file, &position, declaration),
			)
		}
	}

	/// The implicits the calls in the file a request names were given.
	fn hints(asked: &DocumentParams): Vec<InlayHint> = {
		val .Some(at) = self.document(asked.textDocument.uri) else return Vec()
		return inlayHints(&self.programs, &self.documents[at])
	}

	/// Checks every program an open file belongs to, and shows what is wrong
	/// in each file, clearing what no longer is.
	var fn recheck() = {
		self.dirty = false
		val found = diagnosticsOf(&self.documents, &self.overlay, &var self.roots, self.threads)
		for at in 0..found.diagnostics.len() {
			val uri = String::of(found.diagnostics.keyAt(at))
			val .Some(shown) = found.diagnostics.get(&uri) else continue
			publish(uri, shown.clone())
		}
		// An open file with nothing wrong is told so, and one that had
		// something wrong is cleared.
		var cleared: Set<String> = Set()
		for uri in self.published {
			cleared.add(uri.clone())
		}
		for document in self.documents {
			cleared.add(document.uri.clone())
		}
		for uri in cleared {
			if !found.diagnostics.contains(&uri) then publish(uri, Vec())
		}
		var published: Vec<String> = Vec()
		for at in 0..found.diagnostics.len() {
			published.push(String::of(found.diagnostics.keyAt(at)))
		}
		self.published = published
		self.fixes = found.fixes
		self.programs = found.programs
	}

	/// The fixes of the diagnostics in the range asked about.
	fn codeActions(asked: &CodeActionParams): Vec<CodeAction> = {
		val .Some(fixes) = self.fixes.get(&asked.textDocument.uri) else return Vec()
		val range = &asked.range
		var actions: Vec<CodeAction> = Vec()
		for fix in fixes {
			val shown = &fix.diagnostic.range
			if !shown.start.atOrBefore(&range.end) || !range.start.atOrBefore(&shown.end) then
				continue
			actions.push(CodeAction(
				title: fix.title.clone(),
				diagnostics: Vec::of(own [fix.diagnostic.clone()]),
				edit: fix.edit.clone(),
			))
		}
		return actions
	}
}

/// What a request at a position asks.
enum PositionRequest {
	Hover
	Definition
	References(declaration: bool)
}

/// What the editor sent, read as a `T`; an error that says so where it is
/// not one.
fn paramsOf<T: Decode>(params: &Json): Result<T, (i64, String)> = match json::fromJson<T>(
	params.clone(),
) {
	.Ok(value) => .Ok(value)
	.Err(error) => .Err((-32602, "the request's parameters: \(error.message)"))
}

/// What the server can do, as `initialize` answers.
fn capabilities(): InitializeResult = InitializeResult(
	capabilities: ServerCapabilities(
		completionProvider: CompletionOptions(triggerCharacters: texts([".", ":"])),
		signatureHelpProvider: SignatureHelpOptions(
			triggerCharacters: texts(["(", ","]),
			retriggerCharacters: texts([","]),
		),
		codeActionProvider: CodeActionOptions(codeActionKinds: texts(["quickfix"])),
	),
	serverInfo: ServerInfo(name: "wip", version: described()),
)

/// A list of texts.
fn texts(items: &[str]): Vec<String> = {
	var list: Vec<String> = Vec()
	for item in items {
		list.push(String::of(item))
	}
	return list
}

/// The diagnostics of `uri`, shown.
fn publish(uri: str, diagnostics: Vec<Reported>) = writeMessage(
	object([
		("jsonrpc", jsonText("2.0")),
		("method", jsonText("textDocument/publishDiagnostics")),
		("params", json::toJson(PublishDiagnostics(uri: uri, diagnostics: diagnostics))),
	]),
)
