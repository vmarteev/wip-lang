// `wip lsp`: a language server, speaking the Language Server Protocol on
// standard input and output.
//
// Every edit checks again the whole program each open file belongs to, with
// what the editor has not saved in place of the disk; a program of
// thousands of lines is checked in milliseconds, so nothing is kept from one
// check to the next. Messages that arrive together are answered together,
// and the program is checked once after them.

import std::collections::{Map, Set}
import std::future::{Future, Receiver, channel}
import std::io
import std::json::{Json}
import std::libc
import hir::{Program}

/// Runs the server until the editor says `exit`, and ends the process with
/// the code it ends with: the thread that reads may be waiting for input
/// that will never come, which a server that returned would wait for too.
pub fn serve(threads: i64): never = {
	val (sender, messages) = channel<Json>()
	val reading = Future::run(own () => {
		var input = io::stdin()
		while readMessage(&var input) is .Ok(.Some(message)) {
			sender.send(move message)
		}
	})
	var server = Server(threads: threads)
	while messages.receive() is .Some(message) {
		var next: Option<Json> = .Some(move message)
		while next.take() is .Some(one) {
			if server.handle(move one) is .Some(code) then libc::exit(code as c_int)
			next = match messages.tryReceive() {
				.Value(more) => .Some(move more)
				_ => .None
			}
		}
		if server.dirty then server.recheck()
	}
	// The editor went away without saying `exit`.
	libc::exit(1)
}

/// A program checked with a placeholder at the cursor, and where the file
/// asked about begins in it.
struct Patched {
	loaded: Loaded
	program: Program
	base: u32
}

struct Server {
	/// The files the editor has open, by URI.
	documents: Vec<OpenFile> = Vec()
	overlay: Overlay = Overlay()
	/// The files that have diagnostics shown, to clear them once they have
	/// none.
	published: Vec<String> = Vec()
	/// The fixes of the diagnostics shown, by file.
	fixes: Map<String, Vec<QuickFix>> = Map()
	/// Each program last checked, to answer what its names mean.
	programs: Vec<(Loaded, Program)> = Vec()
	/// The program each directory's files belong to, found once.
	roots: Map<String, String> = Map()
	/// Whether an edit has not been checked yet.
	dirty: bool = false
	shutDown: bool = false
	/// How many threads each check splits its work across.
	threads: i64
}

extend Server {
	/// Handles one message; the exit code once the editor says `exit`.
	var fn handle(message: Json): Option<i64> = {
		val method = textAt(&message, ["method"])
		val params = fieldAt(&message, ["params"])
		val .Some(id) = message.get("id") else {
			return self.notified(method.toStr(), &params)
		}
		// A response to a request of ours; the server makes none.
		if method.isEmpty() then return .None
		// A request is answered from what the editor has sent so far.
		if self.dirty then self.recheck()
		val answer: Result<Json, (i64, String)> = match method.toStr() {
			"initialize" => .Ok(capabilities())
			"shutdown" => {
				self.shutDown = true
				.Ok(.Null)
			}
			"textDocument/formatting" => .Ok(
				match self.document(&params) {
					.Some(at) => formatted(&self.documents[at])
					.None => .Null
				},
			)
			"textDocument/documentSymbol" => .Ok(
				match self.document(&params) {
					.Some(at) => symbols(&self.documents[at])
					.None => .Null
				},
			)
			"textDocument/codeAction" => .Ok(self.codeActions(&params))
			"textDocument/hover" => .Ok(self.atPosition(&params, .Hover))
			"textDocument/completion" => .Ok(self.complete(&params))
			"textDocument/signatureHelp" => .Ok(self.signature(&params))
			"textDocument/references" => {
				val declaration = match fieldAt(&params, ["context", "includeDeclaration"]) {
					.Bool(value) => value
					_ => true
				}
				.Ok(self.atPosition(&params, .References(declaration)))
			}
			"textDocument/rename" => {
				val new = textAt(&params, ["newName"])
				match self.document(&params) {
					.Some(at) => match rename(
						&self.programs,
						&self.documents,
						&self.documents[at],
						fieldAt(&params, ["position"]),
						new.toStr(),
					) {
						.Ok(edit) => .Ok(move edit)
						.Err(why) => .Err((-32803, move why))
					}
					.None => .Ok(.Null)
				}
			}
			"textDocument/definition" => .Ok(self.atPosition(&params, .Definition))
			_ => .Err((-32601, "`wip lsp` does not answer `\(method)`"))
		}
		val response = match move answer {
			.Ok(result) => object([
				("jsonrpc", jsonText("2.0")),
				("id", id.clone()),
				("result", move result),
			])
			.Err((code, said)) => object([
				("jsonrpc", jsonText("2.0")),
				("id", id.clone()),
				("error", object([("code", Json::Int(code)), ("message", .Text(move said))])),
			])
		}
		writeMessage(&response)
		return .None
	}

	var fn notified(method: str, params: &Json): Option<i64> = {
		val uri = textAt(&params, ["textDocument", "uri"])
		match method {
			"exit" => return .Some(if self.shutDown then 0 else 1)
			"textDocument/didOpen" => self.opened(
				uri.toStr(),
				textAt(&params, ["textDocument", "text"]),
			)
			"textDocument/didChange" => {
				// The whole text, as `initialize` asked for.
				if fieldAt(&params, ["contentChanges"]) is .Array(changes) &&
					!changes.isEmpty() &&
					changes[changes.len() - 1].get("text") is .Some(.Text(text)) {
					self.opened(uri.toStr(), text.clone())
				}
			}
			"textDocument/didClose" => {
				var i = 0
				while i < self.documents.len() {
					if self.documents[i].uri == uri {
						val closed = self.documents.remove(i)
						self.overlay.remove(closed.path.toStr())
					} else {
						i += 1
					}
				}
				self.dirty = true
			}
			// A save, or a file changed on disk, can change what another file
			// means, and which program a file is in.
			"textDocument/didSave" | "workspace/didChangeWatchedFiles" => {
				self.roots.clear()
				self.dirty = true
			}
			_ => {}
		}
		return .None
	}

	var fn opened(uri: str, text: String) = {
		val .Some(path) = pathOf(uri) else {
			return
		}
		self.overlay.set(path.toStr(), text.clone())
		for document in self.documents {
			if document.uri == uri {
				document.text = move text
				self.dirty = true
				return
			}
		}
		self.documents.push(OpenFile(uri: String::of(uri), path: move path, text: move text))
		self.dirty = true
	}

	/// Where among the open files is the document a request names.
	fn document(params: &Json): Option<i64> = {
		val uri = textAt(&params, ["textDocument", "uri"])
		for (at, document) in self.documents.forwards().enumerate() {
			if document.uri == uri then return .Some(at)
		}
		return .None
	}

	/// What could be written at the position a request names: the program is
	/// checked with a placeholder written there, so that it parses.
	var fn complete(params: &Json): Json = {
		val empty = object([("isIncomplete", Json::Bool(false)), ("items", Json::Array(Vec()))])
		val .Some((at, cursor)) = self.requestAt(&params) else {
			return move empty
		}
		val .Some(patched) = self.patched(at, cursor, "") else {
			return move empty
		}
		return completionItems(
			&patched.loaded,
			&patched.program,
			&self.documents[at],
			patched.base,
			cursor,
		)
	}

	/// The signature of the call the cursor is in the arguments of, and which
	/// argument it is at.
	var fn signature(params: &Json): Json = {
		val .Some((at, cursor)) = self.requestAt(&params) else {
			return .Null
		}
		val .Some(call) = callAt(self.documents[at].text.toStr(), cursor) else {
			return .Null
		}
		// The call may not be closed yet: then it is closed after the
		// placeholder.
		for close in ["", ")"] {
			if self.patched(at, cursor, close) is .Some(patched) {
				if signatureHelp(&patched.loaded, &patched.program, patched.base, &call) is .Some(
					help,
				) {
					return move help
				}
			}
		}
		return .Null
	}

	/// The open file a request names, and the byte offset of the position it
	/// names; nothing for a file of the standard library.
	fn requestAt(params: &Json): Option<(i64, i64)> = {
		val at = self.document(&params)?
		val document = &self.documents[at]
		if inStd(document.path.toStr()) then return .None
		val cursor = Lines::of(document.text.toStr()).offset(fieldAt(&params, ["position"]))
		return .Some((at, cursor))
	}

	/// The program of the open file `at`, checked with the placeholder name,
	/// and `close` after it, written at `cursor`, so that the text there
	/// parses.
	var fn patched(at: i64, cursor: i64, close: str): Option<Patched> = {
		val document = &self.documents[at]
		val text = document.text.toStr()
		val patchedText = "\(text[0..cursor])\(PLACEHOLDER)\(close)\(text[cursor..text.len()])"
		var overlay = self.overlay.clone()
		overlay.set(document.path.toStr(), move patchedText)
		val root = programRoot(document.path.toStr(), &overlay, &var self.roots, self.threads)
		var loaded = match loadOverlaid(root.toStr(), .Tests, &overlay, self.threads) {
			.Ok(loaded) => move loaded
			.Err(..) => return .None
		}
		var timings = Timings()
		val checked = checkLoaded(&var loaded, &var timings)
		val file = canonicalFile(document.path.toStr())
		var base: Option<u32> = .None
		for (name, _, start) in loaded.sources.entries() {
			if base.isNone() && name.startsWith("/") && canonicalFile(name.toStr()) == file then
				base = .Some(start)
		}
		val .Some(start) = base else {
			return .None
		}
		return .Some(Patched(loaded: move loaded, program: move checked.program, base: start))
	}

	/// Answers a request at a position, from the programs that hold the
	/// document it names.
	fn atPosition(params: &Json, asked: PositionRequest): Json = {
		val .Some(at) = self.document(&params) else {
			return .Null
		}
		val file = &self.documents[at]
		val position = fieldAt(&params, ["position"])
		return match asked {
			.Hover => hover(&self.programs, &self.documents, &file, &position)
			.Definition => definition(&self.programs, &self.documents, &file, &position)
			.References(declaration) => references(
				&self.programs,
				&self.documents,
				&file,
				&position,
				declaration,
			)
		}
	}

	/// Checks every program an open file belongs to, and shows what is wrong
	/// in each file, clearing what no longer is.
	var fn recheck() = {
		self.dirty = false
		val found = diagnosticsOf(&self.documents, &self.overlay, &var self.roots, self.threads)
		for at in 0..found.diagnostics.len() {
			val uri = String::of(found.diagnostics.keyAt(at).toStr())
			val .Some(shown) = found.diagnostics.get(&uri) else {
				continue
			}
			publish(uri.toStr(), .Array(shown.clone()))
		}
		// An open file with nothing wrong is told so, and one that had
		// something wrong is cleared.
		var cleared: Set<String> = Set()
		for uri in self.published {
			cleared.add(uri.clone())
		}
		for document in self.documents {
			cleared.add(document.uri.clone())
		}
		for uri in cleared {
			if !found.diagnostics.contains(&uri) then publish(uri.toStr(), .Array(Vec()))
		}
		var published: Vec<String> = Vec()
		for at in 0..found.diagnostics.len() {
			published.push(String::of(found.diagnostics.keyAt(at).toStr()))
		}
		self.published = move published
		self.fixes = move found.fixes
		self.programs = move found.programs
	}

	/// The fixes of the diagnostics in the range asked about.
	fn codeActions(params: &Json): Json = {
		val uri = textAt(&params, ["textDocument", "uri"])
		val .Some(fixes) = self.fixes.get(&uri) else {
			return .Array(Vec())
		}
		val start = fieldAt(&params, ["range", "start"])
		val end = fieldAt(&params, ["range", "end"])
		var actions: Vec<Json> = Vec()
		for fix in fixes {
			if !before(fieldAt(&fix.diagnostic, ["range", "start"]), &end) ||
				!before(&start, fieldAt(&fix.diagnostic, ["range", "end"])) {
				continue
			}
			actions.push(
				object([
					("title", jsonText(fix.title.toStr())),
					("kind", jsonText("quickfix")),
					("diagnostics", .Array(Vec::of(own [fix.diagnostic.clone()]))),
					("isPreferred", .Bool(true)),
					("edit", object([("changes", fix.changes.clone())])),
				]),
			)
		}
		return .Array(move actions)
	}
}

/// What a request at a position asks.
enum PositionRequest {
	Hover
	Definition
	References(declaration: bool)
}

/// Whether one position is at or before another.
fn before(a: &Json, b: &Json): bool = {
	val (aLine, aCharacter) = (positionPart(&a, "line"), positionPart(&a, "character"))
	val (bLine, bCharacter) = (positionPart(&b, "line"), positionPart(&b, "character"))
	return aLine < bLine || aLine == bLine && aCharacter <= bCharacter
}

/// A position's line or character, `-1` where it has none, as a missing
/// number compares before every other.
fn positionPart(position: &Json, name: str): i64 = match position.get(name) {
	.Some(.Int(n)) => n
	_ => -1
}

/// What the server can do, as `initialize` answers.
fn capabilities(): Json = object([
	(
		"capabilities",
		object([
			(
				"textDocumentSync",
				object([
					("openClose", Json::Bool(true)),
					("change", .Int(1)),
					("save", .Bool(true)),
				]),
			),
			("documentFormattingProvider", .Bool(true)),
			("documentSymbolProvider", .Bool(true)),
			("hoverProvider", .Bool(true)),
			("completionProvider", object([("triggerCharacters", texts([".", ":"]))])),
			(
				"signatureHelpProvider",
				object([
					("triggerCharacters", texts(["(", ","])),
					("retriggerCharacters", texts([","])),
				]),
			),
			("definitionProvider", .Bool(true)),
			("referencesProvider", .Bool(true)),
			("renameProvider", .Bool(true)),
			("codeActionProvider", object([("codeActionKinds", texts(["quickfix"]))])),
		]),
	),
	("serverInfo", object([("name", jsonText("wip")), ("version", jsonText(described().toStr()))])),
])

/// A list of texts.
fn texts(items: &[str]): Json = {
	var list: Vec<Json> = Vec()
	for item in items {
		list.push(jsonText(item))
	}
	return .Array(move list)
}

/// The diagnostics of `uri`, shown.
fn publish(uri: str, diagnostics: Json) = writeMessage(
	object([
		("jsonrpc", jsonText("2.0")),
		("method", jsonText("textDocument/publishDiagnostics")),
		("params", object([("uri", jsonText(uri)), ("diagnostics", move diagnostics)])),
	]),
)
