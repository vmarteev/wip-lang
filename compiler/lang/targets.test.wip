// What a target is named, and which files it takes.

val MAC: Target = Target(os: .Macos, arch: .Arm64)

@test
fn aTargetIsNamed() = {
	val .Ok(linux) = Target::parse("linux-x86_64") else panic("linux-x86_64 is a target")
	assert(linux.len() == 1)
	assert(linux[0].os == .Linux && linux[0].arch == .X86_64 && linux[0].vendor() == "")
	val .Ok(mac) = Target::parse("macos-arm64") else panic("macos-arm64 is a target")
	assert(mac[0].os == .Macos && mac[0].arch == .Arm64 && mac[0].vendor() == "apple")
	// A system alone is on this machine's processor.
	val .Ok(alone) = Target::parse("linux") else panic("linux is a target")
	assert(alone[0].arch == Target::host().arch)
	assert(Target::parse("all") is .Ok(all) && all.len() == 5)
	assert(Target::parse("linux-arm64") is .Ok(arm) && arm[0].name() == "linux-arm64")
	assert(Target::parse("windows") is .Err(message) && message.contains("not written for Windows"))
	assert(
		Target::parse("linux-riscv64") is .Err(message) &&
			message.contains("`linux-riscv64` is not a target"),
	)
	assert(Target::parse("freebsd") is .Err(..))
}

/// iOS is the device's and the simulator's, which answer `@target` alike;
/// `ios` alone is the device, and both are Apple's.
@test
fn iosIsADeviceAndASimulator() = {
	val .Ok(device) = Target::parse("ios") else panic("ios is a target")
	assert(device[0].os == .Ios && device[0].arch == .Arm64 && !device[0].simulator)
	assert(device[0].name() == "ios-arm64" && device[0].vendor() == "apple")
	val .Ok(simulator) = Target::parse("ios-arm64-simulator") else {
		panic("the simulator is a target")
	}
	assert(simulator[0].simulator && simulator[0].name() == "ios-arm64-simulator")
	assert(simulator[0].answer("os") == "ios" && simulator[0].answer("vendor") == "apple")
	assert(Target::parse("ios-x86_64") is .Err(message) && message.contains("ios-arm64-simulator"))
	// A Mac builds for iOS, and nothing builds for Linux but Linux.
	val linux = Target(os: .Linux, arch: Target::host().arch)
	if Target::host().os == .Macos {
		assert(device[0].buildable().isOk())
		assert(linux.buildable() is .Err(why) && why.contains("wip check --target"))
	} else assert(device[0].buildable().isErr())
	assert(device[0].sdk() == .Some("iphoneos") && simulator[0].sdk() == .Some("iphonesimulator"))
	assert(Target::host().sdk().isNone())
}

@test
fn aFileSaysWhatItIsFor() = {
	assert(takesFile("window.wip", MAC))
	assert(takesFile("window.macos.wip", MAC))
	assert(!takesFile("window.linux.wip", MAC))
	assert(takesFile("window.apple.wip", MAC))
	assert(takesFile("window.arm64.wip", MAC))
	assert(!takesFile("window.x86_64.wip", MAC))
	// A test for one target, and a name that merely holds a dot.
	assert(takesFile("board.macos.test.wip", MAC))
	assert(!takesFile("board.linux.test.wip", MAC))
	assert(takesFile("v1.2.wip", MAC))
	// `macos` is a Mac's alone, and `apple` a Mac's and an iPad's.
	val ipad = Target(os: .Ios, arch: .Arm64)
	assert(!takesFile("window.macos.wip", ipad))
	assert(takesFile("window.apple.wip", ipad) && takesFile("window.ios.wip", ipad))
	assert(!takesFile("window.ios.wip", MAC))
	// C is read the same way.
	assert(takesFile("rglfw.macos.c", MAC))
	assert(!takesFile("rglfw.linux.c", MAC))
}
