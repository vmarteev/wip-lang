// Which simulator an app runs in: the one asked for; else one booted that
// the app is for; else the first of the kind it is for.

/// What `xcrun simctl list devices available` says: an iPhone booted, an
/// iPad and another iPhone not, and a watch, which is not iOS's.
val LISTED = """
	== Devices ==
	-- iOS 18.1 --
	    iPhone 16 Pro Max (24215F8A-1C6D-456E-B800-E78FCF3D69D2) (Booted)
	    iPhone 16 (11111111-2222-3333-4444-555555555555) (Shutdown)
	-- iOS 26.5 --
	    iPad Air 11-inch (M2) (A4035909-0000-0000-0000-000000000000) (Shutdown)
	-- watchOS 11.0 --
	    Apple Watch Series 10 (46mm) (99999999-0000-0000-0000-000000000000) (Booted)
	"""

/// An app for `devices`.
fn appFor(devices: str): Option<App> = .Some(App(
	id: String::of("com.example.game"),
	devices: String::of(devices),
))

@test
fn anAppRunsInASimulatorItIsFor() = {
	val none: Option<String> = .None
	// For the iPad alone: an iPad, though an iPhone is booted.
	assert(
		chosenSimulator(LISTED, &none, appFor("ipad")) ==
			.Ok(String::of("A4035909-0000-0000-0000-000000000000")),
	)
	// For both, or the iPhone, or a program that is no app: the one booted.
	val booted = Result::Ok(String::of("24215F8A-1C6D-456E-B800-E78FCF3D69D2"))
	assert(chosenSimulator(LISTED, &none, appFor("both")) == booted)
	assert(chosenSimulator(LISTED, &none, appFor("iphone")) == booted)
	assert(chosenSimulator(LISTED, &none, .None) == booted)
	// One asked for, by its name or its identifier, whatever it is.
	val named: Option<String> = .Some(String::of("iPhone 16"))
	assert(
		chosenSimulator(LISTED, &named, appFor("ipad")) ==
			.Ok(String::of("11111111-2222-3333-4444-555555555555")),
	)
	val missing: Option<String> = .Some(String::of("iPad Pro"))
	assert(
		chosenSimulator(LISTED, &missing, .None) is .Err(message) && message.contains("`iPad Pro`"),
	)
	// Nothing of iOS: none.
	assert(chosenSimulator("== Devices ==\n-- watchOS 11.0 --\n", &none, .None).isErr())
}
