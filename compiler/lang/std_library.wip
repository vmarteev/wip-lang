/// The compiler's home: the directory its library, `std/`, and its tools,
/// `tools/`, are in. `WIP_HOME` names it; otherwise it is the nearest
/// directory above the executable, its links followed, that holds
/// `std/prelude/` — the checkout a compiler was built in, or the directory
/// an installed `bin/wip` is in.
pub fn findHome(): Result<String, String> = {
	if io::env("WIP_HOME") is .Some(dir) && !dir.isEmpty() then return .Ok(move dir)
	val exe = match process::executable() {
		.Ok(exe) => move exe
		.Err(
			error,
		) => return .Err("cannot find where `wip` is, and with it the standard library: \(error)")
	}
	var dir = path::parent(exe)
	while true {
		if isDirectory(path::join(dir, "std/prelude")) then return .Ok(dir)
		if dir == "/" || dir == "." then break
		dir = path::parent(dir)
	}
	return .Err("the standard library is not beside `\(exe)`: no directory above it holds `std/prelude`, and `WIP_HOME` names none")
}

/// The files of one of the standard library's modules, read from `home` as
/// `target` reads them: each one's name and text.
pub fn stdFiles(home: str, module: str, target: Target): Result<Vec<(String, String)>, String> = {
	var files: Vec<(String, String)> = Vec()
	for (owner, name) in STD {
		if owner != module then continue
		val file = path::join(home, name)
		match fs::readFile(file) {
			.Ok(text) => files.push((name, move text))
			.Err(error) => return .Err("cannot read `\(file)`: \(error)")
		}
	}
	// The prelude says what the target is, which only the compiler knows,
	// so that file is written here.
	if module == PRELUDE then files.push(("std/prelude/target.wip", prelude(target)))
	return .Ok(move files)
}

/// The standard library's modules, by path, `std::prelude` among them.
pub fn stdModules(): Vec<str> = {
	var modules: Vec<str> = Vec()
	for (module, _) in STD {
		modules.push(module)
	}
	modules.sort()
	modules.dedup()
	return move modules
}
