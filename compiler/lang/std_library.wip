// The standard library the compiler reads, from the compiler's home beside
// its executable: each directory of `std/` that holds a `.wip` file is a
// module, `std/collections` being `std::collections`, and its files are
// read in name order, as a package's are. A file added to the library is
// read with nothing said to the compiler. Each file is named as it is in a
// checkout, `std/prelude/option.wip`, wherever the home is, so that a span
// names it alike on every machine.

import std::fs
import std::io
import std::path
import std::process
import hir::{PRELUDE}

/// The module of the runner a program built by `wip test` starts in.
pub val TESTS: str = "std::test"

/// The compiler's home: the directory its library, `std/`, and its tools,
/// `tools/`, are in. `WIP_HOME` names it; otherwise it is the nearest
/// directory above the executable, its links followed, that holds
/// `std/prelude/` — the checkout a compiler was built in, or the directory
/// an installed `bin/wip` is in.
pub fn findHome(): Result<String, String> = {
	if io::env("WIP_HOME") is .Some(dir) && !dir.isEmpty() then return .Ok(dir)
	val exe = match process::executable() {
		.Ok(exe) => exe
		.Err(
			error,
		) => return .Err("cannot find where `wip` is, and with it the standard library: \(error)")
	}
	var dir = path::parent(exe)
	while true {
		if isDirectory(path::join(dir, "std/prelude")) then return .Ok(dir)
		if dir == "/" || dir == "." then break
		dir = path::parent(dir)
	}
	return .Err("the standard library is not beside `\(exe)`: no directory above it holds `std/prelude`, and `WIP_HOME` names none")
}

/// Whether `module` is one of the standard library's: a directory of the
/// home's `std/` that holds a `.wip` file. Where there is no home, there is
/// no library to be one of.
pub fn isStdModule(module: str): bool = {
	if !module.startsWith("std::") then return false
	val .Ok(home) = findHome() else return false
	return !stdNames(home, module).isEmpty()
}

/// The files of one of the standard library's modules, read from `home` as
/// `target` reads them: each one's name and text, in name order.
pub fn stdFiles(home: str, module: str, target: Target): Result<Vec<(String, String)>, String> = {
	var files: Vec<(String, String)> = Vec()
	for name in stdNames(home, module) {
		val file = path::join(home, name)
		match fs::readFile(file) {
			.Ok(text) => files.push((name, text))
			.Err(error) => return .Err("cannot read `\(file)`: \(error)")
		}
	}
	// The prelude says what the target is, which only the compiler knows,
	// so that file is written here.
	if module == PRELUDE then files.push(("std/prelude/target.wip", prelude(target)))
	return .Ok(files)
}

/// The standard library's modules in `home`, by path, `std::prelude` among
/// them, in name order.
pub fn stdModules(home: str): Vec<String> = {
	var modules: Vec<String> = Vec()
	val .Ok(entries) = fs::readDir(path::join(home, "std")) else return modules
	for entry in entries {
		if !entry.isDirectory() then continue
		val module = "std::\(entry.name)"
		if !stdNames(home, module).isEmpty() then modules.push(module)
	}
	modules.sort()
	return modules
}

/// The `.wip` files of the library's `module` in `home`, each named from the
/// root of a checkout, `std/digest/digest.wip`, in name order.
fn stdNames(home: str, module: str): Vec<String> = {
	var names: Vec<String> = Vec()
	val .Some(inside) = module.stripPrefix("std::") else return names
	val dir = "std/\(inside.replace("::", "/"))"
	val .Ok(entries) = fs::readDir(path::join(home, dir)) else return names
	for entry in entries {
		if entry.kind == .File && path::extension(entry.name.toStr()) == .Some("wip") then
			names.push(path::join(dir, entry.name.toStr()))
	}
	names.sort()
	return names
}
