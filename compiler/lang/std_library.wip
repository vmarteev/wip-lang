// The standard library the compiler reads: which files each of its
// modules is, in the order the compiler reads them, and the directory they
// are read from, the compiler's home beside its executable. Each file is
// named as it is in a checkout, `std/prelude/option.wip`, wherever the home
// is, so that a span names it alike on every machine.

import std::fs
import std::io
import std::path
import std::process
import hir::{PRELUDE}

/// Each file of the standard library: the module it belongs to, and its
/// path from the root of a checkout. The prelude is one module of several
/// files, one per type.
val STD: [(str, str); 81] = [
	("std::prelude", "std/prelude/option.wip"),
	("std::prelude", "std/prelude/result.wip"),
	("std::prelude", "std/prelude/tuple.wip"),
