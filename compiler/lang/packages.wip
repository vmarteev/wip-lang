// Packages: what a `package.wip` says, where a dependency is, and what a
// module of one may import from another.

import std::collections::{Deque}
import std::fs
import std::path
import fmt::{Style}
import syntax::{
	Annotation,
	Diagnostic,
	INTERNAL_MODULE,
	Interner,
	PACKAGE,
	Span,
	Symbol,
	UNKNOWN_MODULE,
	lexAt,
	parsePackageAt
}

/// A package of the program: where its modules are, and what its
/// `package.wip` says. The program's own is first.
@derive(Clone)
pub struct Package {
	pub name: Option<String>
	pub version: Option<String>
	/// Its root, as the program was told where it is.
	pub dir: String
	/// The same, resolved: two paths to one directory are one package.
	identity: String
	/// Empty for the program's own package, and its name for a
	/// dependency: what begins its modules' paths.
	pub prefix: String
	/// The packages it depends on: the name, which package, and where the
	/// `@depends` was written.
	pub depends: Vec<(String, i64, Span)>
	/// What `@files` names, the files and directories it reads while it
	/// runs, each as written, from its root: what a build puts beside the
	/// program, at the same paths for the program's own package and under a
	/// directory of its name for a dependency.
	pub files: Vec<String>
	/// The app it is, where it says so with `@app`: what an iOS build makes
	/// a bundle of.
	pub app: Option<App> = .None
}

/// What `@app` says of the app a package is.
@derive(Clone)
pub struct App {
	/// The bundle's identifier, reverse-DNS: `com.example.marble`.
	pub id: String
	/// What the home screen shows.
	pub name: Option<String> = .None
	/// `ipad`, `iphone` or `both`.
	pub devices: String = String::of("both")
	/// `landscape`, `portrait` or `any`.
	pub orientation: String = String::of("any")
	/// A square PNG of the package, from its root.
	pub icon: Option<String> = .None
	/// The least iOS version it runs on.
	pub minimum: String = String::of(MINIMUM_IOS)
}

/// The least iOS version an app runs on where it does not say: every iPad
/// sold since 2018 runs it.
pub val MINIMUM_IOS = "17.0"

/// What a `package.wip` says.
struct Manifest {
	name: Option<(String, Span)>
	version: Option<String>
	/// The name each dependency is imported by, where its root is relative
	/// to this package's, and where the `@depends` was written.
	depends: Vec<(String, String, Span)>
	/// What `@files` names, each found below the root, and where each was
	/// written.
	files: Vec<String>
	fileSpans: Vec<Span> = Vec()
	/// What `@app` says.
	app: Option<App> = .None
}

/// One argument of a package's annotation: its key, where it has one, its
/// text, where it is a string, and where it was written.
struct Said {
	key: Option<String>
	value: Option<String>
	span: Span
}

/// Reads the `package.wip` at `dir`, if there is one, reporting what is
/// wrong with it into `loaded`. Its text joins the sources, so that what is
/// reported can be shown.
fn manifest(dir: str, loaded: &var Loaded, overlay: &Overlay): Option<Manifest> = {
	val file = path::join(dir, "package.wip")
	val .Ok(text) = overlay.read(file) else return .None
	val base = loaded.sources.add(file.clone(), text.clone())
	val lexed = lexAt(text, base, &var loaded.interner)
	val parsed = parsePackageAt(text, base, &lexed)
	for diagnostic in lexed.diagnostics {
		loaded.diagnostics.push(diagnostic.clone())
	}
	for diagnostic in parsed.diagnostics {
		loaded.diagnostics.push(diagnostic.clone())
	}
	var manifest = Manifest(
		name: match parsed.name {
			.Some(name) => .Some((loaded.interner.resolve(name.sym), name.span))
			.None => .None
		},
		version: .None,
		depends: Vec(),
		files: Vec(),
	)
	var filesSaid = false
	var appSaid = false
	for annotation in parsed.annotations {
		val what = String::of(loaded.interner.resolve(annotation.name.sym))
		var strings: Vec<Said> = Vec()
		for arg in annotation.args {
			strings.push(Said(
				key: match arg.name {
					.Some(name) => .Some(loaded.interner.resolve(name.sym))
					.None => .None
				},
				value: match arg.value {
					.Str(symbol) => .Some(loaded.interner.resolve(symbol))
					_ => .None
				},
				span: arg.span,
			))
		}
		match what.toStr() {
			"version" => {
				val version = if strings.len() == 1 &&
					strings[0].key.isNone() &&
					strings[0].value is .Some(v) {
					v.clone()
				} else {
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"`@version` takes one version, as in `@version(\"1.4.0\")`",
							annotation.span,
							"not a version",
						).withNote(
							"a package's version is a semantic version: `MAJOR.MINOR.PATCH`, with a `-pre` and a `+build` if written",
						),
					)
					continue
				}
				if !isSemver(version) then
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"`\(version)` is not a semantic version",
							annotation.span,
							"not `MAJOR.MINOR.PATCH`",
						).withNote(
							"versions must compare once a dependency can name one, so a package's is `MAJOR.MINOR.PATCH`, with a `-pre` and a `+build` if written, as in `1.4.0` or `2.0.0-rc.1`",
						),
					)
				else if manifest.version.isSome() then
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"a package has one version",
							annotation.span,
							"a second `@version`",
						),
					)
				else manifest.version = .Some(version)
			}
			"depends" => {
				val name = if !strings.isEmpty() &&
					strings[0].key.isNone() &&
					strings[0].value is .Some(n) {
					n.clone()
				} else {
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"`@depends` begins with the name the dependency is imported by",
							annotation.span,
							"no name",
						).withHelp("write `@depends(\"engine\", path = \"../engine\")`"),
					)
					continue
				}
				var remote = false
				for said in strings {
					if said.key is .Some(key) && key.toStr() is "git" | "rev" then remote = true
				}
				if remote {
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"`\(name)` is named by where it is fetched from, which is not built yet",
							annotation.span,
							"a remote package",
						).withNote(
							"a remote source is reserved for when a program needs one, with a lock file; today a dependency is a directory, `path = \"…\"`",
						),
					)
					continue
				}
				var unknown: Option<Span> = .None
				for i in 1..strings.len() {
					val isPath = strings[i].key is .Some(key) && key == "path"
					if !isPath && unknown.isNone() then unknown = .Some(strings[i].span)
				}
				var found: Option<String> = .None
				for said in strings {
					if found.isNone() && said.key is .Some(key) && key == "path" then
						found = said.value.clone()
				}
				val .Some(dependency) = if unknown.isNone() then found else Option::None else {
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"`@depends` says where `\(name)` is with `path = \"…\"`, and nothing else",
							unknown.unwrapOr(annotation.span),
							"not what a dependency takes",
						).withHelp("write `@depends(\"\(name)\", path = \"../\(name)\")`"),
					)
					continue
				}
				manifest.depends.push((name, dependency, annotation.span))
			}
			"files" => {
				if filesSaid {
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"a package names its files once",
							annotation.span,
							"a second `@files`",
						).withHelp("name them all in one: `@files(\"levels\", \"sounds\")`"),
					)
					continue
				}
				filesSaid = true
				if strings.isEmpty() then
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"`@files` names no file",
							annotation.span,
							"nothing named",
						).withHelp("write `@files(\"levels\")`, a path from the package's root"),
					)
				for said in strings {
					val written = match said.value {
						.Some(written) if said.key.isNone() => written.clone()
						_ => {
							loaded.diagnostics.push(
								Diagnostic::error(
									PACKAGE,
									"`@files` takes paths, each a string",
									said.span,
									"not a path",
								).withHelp("write `@files(\"levels\", \"help.txt\")`"),
							)
							continue
						}
					}
					match packageFile(written, dir) {
						.Ok(found) => {
							if holdsCode(found) {
								loaded.diagnostics.push(
									Diagnostic::error(
										PACKAGE,
										"`\(written)` holds Wip's code",
										said.span,
										"a `.wip` file",
									).withNote(
										"a package's files are what it reads while it runs, not its modules; a dependency's are put in the program's package, where one would be read as a module of it",
									).withHelp(
										"name the directories below it that hold no `.wip` file",
									),
								)
							} else {
								manifest.files.push(written.clone())
								manifest.fileSpans.push(said.span)
							}
						}
						.Err((message, label)) => loaded.diagnostics.push(
							Diagnostic::error(PACKAGE, message, said.span, label).withNote(
								"the files a package names are put beside its program by every build of it, so each is the package's own",
							),
						)
					}
				}
			}
			"app" => {
				if appSaid {
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"a package is one app",
							annotation.span,
							"a second `@app`",
						),
					)
					continue
				}
				appSaid = true
				match appOf(&strings, dir, annotation.span) {
					.Ok(app) => manifest.app = .Some(app)
					.Err(wrong) => {
						for diagnostic in wrong {
							loaded.diagnostics.push(diagnostic.clone())
						}
					}
				}
			}
			// How `wip fmt` lays the package out, which the formatter reads
			// for itself.
			"format" => {
				if formatSettings(&annotation, &loaded.interner) is .Err(message) then
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							message.clone(),
							annotation.span,
							"not a layout `wip fmt` knows",
						),
					)
			}
			_ => {
				loaded.diagnostics.push(
					Diagnostic::error(
						PACKAGE,
						"`@\(what)` is not something a package says",
						annotation.span,
						"not a package's annotation",
					).withHelp(
						"a `package.wip` takes `@version(\"1.4.0\")`, `@depends(\"engine\", path = \"../engine\")`, `@files(\"levels\")`, `@app(id = \"com.example.game\")` and `@format(width = 120)`",
					),
				)
			}
		}
	}
	return .Some(manifest)
}

/// What `@app`'s arguments, `said`, make of the app, the package's root
/// `dir`: each a key and a string, `id` among them; or every mistake, at
/// `span` where it is not one argument's.
fn appOf(said: &[Said], dir: str, span: Span): Result<App, Vec<Diagnostic>> = {
	var app = App(id: String())
	var hasId = false
	var wrong: Vec<Diagnostic> = Vec()
	for arg in said {
		val mistake = (message: str, label: str) => Diagnostic::error(
			PACKAGE,
			message,
			arg.span,
			label,
		).withHelp(
			"write `@app(id = \"com.example.game\", name = \"The Game\")`, and `devices`, `orientation`, `icon` and `minimum` where they are not the default",
		)
		val .Some(key) = arg.key else {
			wrong.push(mistake("`@app` takes `key = \"value\"`", "no key"))
			continue
		}
		val .Some(value) = arg.value else {
			wrong.push(mistake("`\(key)` is a string", "not a string"))
			continue
		}
		match key.toStr() {
			"id" => {
				hasId = true
				if isBundleId(value) then app.id = value.clone()
				else wrong.push(
					mistake(
						"`\(value)` is not an app's identifier",
						"not reverse-DNS, as `com.example.game`",
					),
				)
			}
			"name" => app.name = .Some(value.clone())
			"devices" => {
				if value.toStr() is "ipad" | "iphone" | "both" then app.devices = value.clone()
				else wrong.push(mistake("`devices` is `ipad`, `iphone` or `both`", "not a device"))
			}
			"orientation" => {
				if value.toStr() is "landscape" | "portrait" | "any" then
					app.orientation = value.clone()
				else wrong.push(
					mistake(
						"`orientation` is `landscape`, `portrait` or `any`",
						"not an orientation",
					),
				)
			}
			"icon" => {
				if path::extension(value) != .Some("png") then
					wrong.push(mistake("an app's icon is a PNG", "not a `.png`"))
				else if packageFile(value, dir) is .Err((message, label)) then
					wrong.push(mistake(message, label))
				else app.icon = .Some(value.clone())
			}
			"minimum" => {
				if isVersion(value) then app.minimum = value.clone()
				else wrong.push(
					mistake("`minimum` is an iOS version, as `\"17.0\"`", "not a version"),
				)
			}
			_ => wrong.push(mistake("`@app` knows no `\(key)`", "not what an app says"))
		}
	}
	if !hasId then
		wrong.push(
			Diagnostic::error(PACKAGE, "an app says its identifier", span, "no `id`").withHelp(
				"write `@app(id = \"com.example.game\")`: reverse-DNS, unique to the app",
			),
		)
	return if wrong.isEmpty() then .Ok(app) else .Err(wrong)
}

/// Whether `text` is an app's identifier: two names or more, each of
/// letters, digits and `-`, joined by dots.
fn isBundleId(text: str): bool = {
	var parts = 0
	for part in text.split(".") {
		if part.isEmpty() then return false
		for byte in part {
			if !(byte.isAsciiAlphanumeric() || byte == b'-') then return false
		}
		parts += 1
	}
	return parts >= 2
}

/// Whether `text` is a version of numbers joined by dots: `17`, `17.2`.
fn isVersion(text: str): bool = {
	for part in text.split(".") {
		if part.isEmpty() then return false
		for byte in part {
			if !byte.isDigit() then return false
		}
	}
	return !text.isEmpty()
}

/// Where a path `@files` names is, written from the package's root `dir`:
/// a file or a directory below it, which it does not leave.
fn packageFile(written: str, dir: str): Result<String, (String, String)> = {
	if written.startsWith("/") then
		return .Err(
			(
				"`\(written)` is a whole path; a package's file is named from its root",
				"not relative to the root",
			),
		)
	val joined = path::join(dir, written)
	val .Ok(found) = fs::realPath(joined) else {
		return .Err(("there is no `\(written)` in the package", "looked for `\(joined)`"))
	}
	val root = identity(dir)
	if !path::isWithin(found, root) || found == root then
		return .Err(
			(
				"`\(written)` is outside the package, which its files may not leave",
				"outside `\(root)`",
			),
		)
	return .Ok(found)
}

/// Whether `path`, a file or a directory, is or holds a `.wip` file.
fn holdsCode(path: str): bool = {
	if !isDirectory(path) then return path::extension(path) == .Some("wip")
	val .Ok(entries) = fs::readDir(path) else return false
	return entries.any((entry) => holdsCode(path::join(path, entry.name)))
}

/// The files every package of a program names, put beside the program
/// built into `dir`: the program's own package's, `packages[0]`, at their
/// own paths, and each dependency's under a directory of its name. Linked
/// to each package's own where `link` says, and where `dir` is the
/// program's package's root, so that one edited while the program runs is
/// the one it reads; copied otherwise, but for a file as it was copied
/// before.
pub fn placeFiles(packages: &[Package], dir: str, link: bool): Result<void, String> = {
	if packages.isEmpty() then return .Ok()
	val inRoot = identity(dir) == packages[0].identity
	// The program's own: nothing to do in its root, which holds them.
	if !inRoot then placed(&packages[0], dir, link)?
	for i in 1..packages.len() {
		val package = &packages[i]
		if package.files.isEmpty() then continue
		val under = path::join(dir, package.prefix)
		if isFile(under) then
			return .Err("the program is `\(under)`, where `\(package.prefix)`'s files go beside it: write it elsewhere, or by another name")
		placed(&package, under, link || inRoot)?
	}
	return .Ok()
}

/// The files `package` names put in `dir`, at their paths from its root:
/// linked to its own where `link` says, and copied otherwise.
fn placed(package: &Package, dir: str, link: bool): Result<void, String> = {
	for written in package.files {
		val from = path::join(package.identity, written)
		val to = path::join(dir, written)
		val within = path::parent(to)
		if !within.isEmpty() && fs::makeDirs(within) is .Err(error) then
			return .Err("cannot make `\(within)`, where `\(written)` goes: \(error)")
		if !link {
			copyTree(from, to)?
			continue
		}
		// A link made before, by a build before this one, is kept where it
		// leads where it should, and made again where it does not.
		if fs::linkMeta(to) is .Ok(there) {
			if there.kind != .Link then
				return .Err("`\(to)` is in the way of a link to `\(from)`: move it, and build again")
			if fs::realPath(to) == .Ok(String::of(from)) then continue
			if fs::removeFile(to) is .Err(error) then
				return .Err("cannot replace the link `\(to)`: \(error)")
		}
		if fs::makeLink(from, to) is .Err(error) then
			return .Err("cannot link `\(to)` to `\(from)`: \(error)")
	}
	return .Ok()
}

/// `from` copied to `to`, a directory with all it holds, over what is there;
/// a file that holds what it would be given is left as it is.
fn copyTree(from: str, to: str): Result<void, String> = {
	if isDirectory(from) {
		if fs::makeDirs(to) is .Err(error) then return .Err("cannot make `\(to)`: \(error)")
		val entries = match fs::readDir(from) {
			.Ok(entries) => entries
			.Err(error) => return .Err("cannot read `\(from)`: \(error)")
		}
		for entry in entries {
			copyTree(path::join(from, entry.name), path::join(to, entry.name))?
		}
		return .Ok()
	}
	if fs::readFile(to) is .Ok(there) && fs::readFile(from) is .Ok(here) && there == here then
		return .Ok()
	if fs::copy(from, to) is .Err(error) then
		return .Err("cannot copy `\(from)` to `\(to)`: \(error)")
	return .Ok()
}

/// What a `@format(…)` says, over the default style: `width`,
/// `indent = "tabs"` or `"spaces"`, and `size`.
fn formatSettings(annotation: &Annotation, interner: &Interner): Result<Style, String> = {
	var style = Style()
	for arg in annotation.args {
		val key = match arg.name {
			.Some(name) => interner.resolve(name.sym)
			.None => ""
		}
		match arg.value {
			.Int(value) if key == "width" && value >= 40 && value <= 400 =>
				style.width = value as i64
			.Int(value) if key == "size" && value >= 1 && value <= 16 => style.size = value as i64
			.Str(symbol) if key == "indent" => {
				match interner.resolve(symbol) {
					"tabs" => style.tabs = true
					"spaces" => style.tabs = false
					other => return .Err("`indent = \"\(other)\"` is neither `\"tabs\"` nor `\"spaces\"`")
				}
			}
			_ => return .Err(
				"`@format` takes `width` (40 to 400), `indent = \"tabs\"` or `\"spaces\"`, and `size` (1 to 16)",
			)
		}
	}
	return .Ok(style)
}

/// How `wip fmt` lays out `file`: what the `@format` of the nearest
/// `package.wip` above it says, or the defaults.
pub fn formatStyle(file: str): Result<Style, String> = {
	val isDirectory = match fs::meta(file) {
		.Ok(meta) => meta.isDirectory()
		.Err(_) => false
	}
	val start = if isDirectory then file else path::parent(file)
	var dir = identity(start)
	while true {
		val manifest = path::join(dir, "package.wip")
		if fs::readFile(manifest) is .Ok(text) {
			var interner = Interner::new()
			val lexed = lexAt(text, 0, &var interner)
			val parsed = parsePackageAt(text, 0, &lexed)
			for annotation in parsed.annotations {
				if interner.resolve(annotation.name.sym) != "format" then continue
				return match formatSettings(&annotation, &interner) {
					.Ok(style) => .Ok(style)
					.Err(message) => .Err("\(manifest): \(message)")
				}
			}
			return .Ok(Style())
		}
		val up = path::parent(dir)
		if up == dir.toStr() then break
		dir = up
	}
	return .Ok(Style())
}

/// `MAJOR.MINOR.PATCH`, with a `-pre` and a `+build` if written: what
/// Semantic Versioning 2.0.0 says, which is what makes two versions
/// comparable.
fn isSemver(text: str): bool = {
	val built: (str, Option<str>) = match text.splitOnce("+") {
		.Some((rest, build)) => (rest, .Some(build))
		.None => (text, .None)
	}
	val (rest, build) = built
	val released: (str, Option<str>) = match rest.splitOnce("-") {
		.Some((core, pre)) => (core, .Some(pre))
		.None => (rest, .None)
	}
	val (core, pre) = released
	var parts = 0
	for part in core.split(".") {
		parts += 1
		if !isNumber(part) then return false
	}
	if parts != 3 then return false
	if pre is .Some(pre) && !identifiers(pre) then return false
	if build is .Some(build) && !identifiers(build) then return false
	return true
}

/// A part of a version's core: digits, with no leading zero but in `0`.
fn isNumber(part: str): bool = {
	if part.isEmpty() then return false
	for b in part {
		if b !is b'0'..=b'9' then return false
	}
	return part == "0" || !part.startsWith("0")
}

/// A version's `-pre` or `+build`: identifiers of letters, digits and `-`,
/// separated by `.`, none empty.
fn identifiers(text: str): bool = {
	for part in text.split(".") {
		if part.isEmpty() then return false
		for b in part {
			if b !is b'a'..=b'z' | b'A'..=b'Z' | b'0'..=b'9' | b'-' then return false
		}
	}
	return true
}

/// A path with `a/..` taken out, so that a dependency's files are named
/// `engine/render.wip` rather than `game/../engine/render.wip` in what is
/// reported. Nothing is resolved: that is `identity`'s job.
fn tidy(written: str): String = {
	val absolute = written.startsWith("/")
	var parts: Vec<str> = Vec()
	for part in written.split("/") {
		if part.isEmpty() || part == "." then continue
		if part == ".." && !parts.isEmpty() && parts[parts.len() - 1] != ".." {
			parts.pop()
			continue
		}
		// The root has no parent.
		if part == ".." && absolute && parts.isEmpty() then continue
		parts.push(part)
	}
	val joined = parts.join("/")
	return if absolute then "/\(joined)" else joined
}

/// Whether there is a file at `path`, a link to one followed.
fn isFile(path: str): bool = fs::meta(path) is .Ok(meta) && meta.isFile()

/// Whether there is a directory at `path`, a link to one followed.
pub fn isDirectory(path: str): bool = fs::meta(path) is .Ok(meta) && meta.isDirectory()

/// Where a directory really is, so that two paths to it are one; the path
/// as it was where it cannot be found.
fn identity(dir: str): String = {
	val named = if dir.isEmpty() then "." else dir
	return match fs::realPath(named) {
		.Ok(real) => real
		.Err(_) => named
	}
}

/// The program's package, whose root is `root`, and every package it
/// depends on, however far down. A package is identified by its directory,
/// so two paths to it are one package; its name must be the one it is
/// depended on by; and a cycle is reported.
fn packages(root: str, loaded: &var Loaded, overlay: &Overlay): Vec<Package> = {
	val ownManifest = manifest(root, &var loaded, &overlay)
	var packages = Vec::of([
		Package(
			name: match ownManifest {
				.Some(m) => match m.name {
					.Some((n, _)) => .Some(n.clone())
					.None => .None
				}
				.None => .None
			},
			version: match ownManifest {
				.Some(m) => m.version.clone()
				.None => .None
			},
			dir: root,
			identity: identity(root),
			prefix: String(),
			depends: Vec(),
			files: match ownManifest {
				.Some(m) => m.files.clone()
				.None => Vec()
			},
			app: match ownManifest {
				.Some(m) => m.app.clone()
				.None => .None
			},
		),
	])
	// The program's own files beside it may not meet a dependency's, which
	// go under a directory of the dependency's name.
	if ownManifest is .Some(m) {
		for (i, written) in m.files.forwards().enumerate() {
			val first = written.toStr().split("/").next().unwrapOr("")
			if !m.depends.any((dependency) => dependency.0 == first) then continue
			loaded.diagnostics.push(
				Diagnostic::error(
					PACKAGE,
					"`\(written)` is where `\(first)`'s files go",
					m.fileSpans[i],
					"a dependency's name",
				).withNote(
					"beside the program, each package it depends on has a directory of its name, holding the files it names",
				).withHelp("put these files in a directory of another name"),
			)
		}
	}
	var queue: Deque<(i64, Manifest)> = Deque()
	if ownManifest is .Some(..) {
		val .Some(m) = move ownManifest else panic("a manifest")
		queue.pushBack((0, m))
	}
	while queue.popFront() is .Some(entry) {
		val (owner, said) = move entry
		for (name, dependency, span) in move said.depends {
			if name == "std" || name == "package" {
				loaded.diagnostics.push(
					Diagnostic::error(
						PACKAGE,
						"`\(name)` is a name every package has already",
						span,
						"taken",
					).withNote(
						"`std` is the standard library, and `package::NAME` is a package's own name",
					),
				)
				continue
			}
			val dir = tidy(path::join(packages[owner].dir, dependency))
			if !isFile(path::join(dir, "package.wip")) {
				loaded.diagnostics.push(
					Diagnostic::error(
						PACKAGE,
						"`\(dir)` has no `package.wip`",
						span,
						"not a package",
					).withNote(
						"a dependency is a directory whose `package.wip` names it; `path` is relative to this package's root",
					),
				)
				continue
			}
			val id = identity(dir)
			var known: Option<i64> = .None
			for (i, package) in packages.forwards().enumerate() {
				if known.isNone() && package.identity == id then known = .Some(i)
			}
			if known is .Some(found) {
				// Reached again: a diamond, which is one package, or a
				// cycle, which is reported below.
				val same = packages[found].name is .Some(n) && n == name
				if !same {
					val called = match packages[found].name {
						.Some(n) => n.clone()
						.None => "without a name"
					}
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"`\(dir)` is package `\(called)`, not `\(name)`",
							span,
							"named differently here",
						),
					)
					continue
				}
				packages[owner].depends.push((name, found, span))
				continue
			}
			var taken = false
			for package in packages {
				if package.name is .Some(n) && n == name then taken = true
			}
			if taken {
				loaded.diagnostics.push(
					Diagnostic::error(
						PACKAGE,
						"two packages of this program are named `\(name)`",
						span,
						"a second one",
					).withNote(
						"a package's name is the first segment of the paths that reach it, so one program has one package of each name",
					),
				)
				continue
			}
			val .Some(theirs) = manifest(dir, &var loaded, &overlay) else continue
			match theirs.name {
				.Some((declared, _)) if declared == name => {}
				.Some((declared, declaredSpan)) => {
					loaded.diagnostics.push(
						Diagnostic::error(
							PACKAGE,
							"`\(dir)` is package `\(declared)`, not `\(name)`",
							span,
							"depended on by this name",
						).withSecondary(declaredSpan, "it says this").withNote(
							"a package is imported by the name it gives itself, so that a name is never a local alias of something else; `import engine as e` renames it where it is used",
						),
					)
					continue
				}
				.None => continue
			}
			val index = packages.len()
			packages.push(Package(
				name: .Some(name.clone()),
				version: theirs.version.clone(),
				dir: dir,
				identity: id,
				prefix: name.clone(),
				depends: Vec(),
				files: theirs.files.clone(),
			))
			packages[owner].depends.push((name, index, span))
			queue.pushBack((index, theirs))
		}
	}
	if packageCycle(&packages) is .Some(diagnostic) then loaded.diagnostics.push(diagnostic)
	return packages
}

/// A package that depends on itself, however far round: the first one
/// found, reported where the `@depends` that closes it was written.
fn packageCycle(packages: &[Package]): Option<Diagnostic> = {
	var trail = Vec::of([0])
	var done: Vec<i64> = Vec()
	val .Some((from, to, span)) = packageWalk(0, &packages, &var trail, &var done) else return .None
	return .Some(
		Diagnostic::error(
			PACKAGE,
			"packages `\(packageName(&packages, from))` and `\(packageName(&packages, to))` depend on each other",
			span,
			"this closes the circle",
		).withNote(
			"packages form a tree without cycles, so that each can be compiled after what it uses; what both need belongs in a third",
		),
	)
}

/// The walk `packageCycle` makes from one package: the first dependency
/// that leads back onto `trail`.
fn packageWalk(
	at: i64,
	packages: &[Package],
	trail: &var Vec<i64>,
	done: &var Vec<i64>,
): Option<(i64, i64, Span)> = {
	for (_, to, span) in packages[at].depends {
		if trail.contains(&to) then return .Some((at, to, span))
		if done.contains(&to) then continue
		trail.push(to)
		if packageWalk(to, &packages, &var trail, &var done) is .Some(found) then
			return .Some(found)
		trail.pop()
		done.push(to)
	}
	return .None
}

/// A package's name for a message.
fn packageName(packages: &[Package], i: i64): String = match packages[i].name {
	.Some(name) => name.clone()
	.None => "the program's"
}

/// Which package a module is in, and its path within it: nothing for the
/// standard library. A dependency's modules begin with its name.
pub fn locateModule(packages: &[Package], module: str): Option<(i64, String)> = {
	if module == "std" || module.startsWith("std::") then return .None
	val (first, rest) = match module.splitOnce("::") {
		.Some((first, rest)) => (first, rest)
		.None => (module, "")
	}
	for i in 1..packages.len() {
		if packages[i].prefix == first then return .Some((i, rest))
	}
	return .Some((0, module))
}

/// The module a path written in `owner`'s package means, as the checker
/// works it out: `std`'s and a dependency's as written, and one of the
/// package's own from its root.
pub fn meant(packages: &[Package], owner: Option<i64>, written: str): String = {
	val .Some(owner) = owner else return written
	val package = &packages[owner]
	val first = firstSegment(written)
	var depended = false
	for (name, _, _) in package.depends {
		if name == first then depended = true
	}
	if package.prefix.isEmpty() || first == "std" || depended then return written
	if written.isEmpty() then return package.prefix.clone()
	return "\(package.prefix)::\(written)"
}

/// What a path begins with: `a` of `a::b`.
fn firstSegment(written: str): str = match written.splitOnce("::") {
	.Some((first, _)) => first
	.None => written
}

/// What is wrong with an import that crosses from `owner`'s package into
/// another: a package it does not depend on, a module of its own named
/// like a dependency, or one under another package's `internal/`.
pub fn importAcrossPackages(
	packages: &[Package],
	owner: Option<i64>,
	written: str,
	imported: str,
	span: Span,
): Option<Diagnostic> = {
	val .Some(owner) = owner else return .None
	val .Some((target, local)) = locateModule(&packages, imported) else return .None
	val first = firstSegment(written)
	var depends = false
	for (name, _, _) in packages[owner].depends {
		if name == first then depends = true
	}
	// A directory of the dependency's name that holds no code is no module:
	// the dependency's files put beside a program built in the package's
	// root are one.
	if depends && holdsCode(moduleDir(packages[owner].dir, first)) then
		return .Some(
			Diagnostic::error(
				PACKAGE,
				"`\(first)` is both a package this one depends on and a module of its own",
				span,
				"which one is meant",
			).withHelp("rename the directory `\(first)`, or depend on the package by another name"),
		)
	if target == owner then return .None
	if !depends {
		val name = packages[target].name.clone().unwrapOr(String())
		return .Some(
			Diagnostic::error(
				PACKAGE,
				"this package does not depend on `\(name)`",
				span,
				"not a dependency",
			).withHelp("say so in `package.wip`: `@depends(\"\(name)\", path = \"…\")`"),
		)
	}
	var internal = false
	for segment in local.split("::") {
		if segment == "internal" then internal = true
	}
	if internal {
		val name = packages[target].name.clone().unwrapOr(String())
		return .Some(
			Diagnostic::error(
				INTERNAL_MODULE,
				"`\(written)` is internal to package `\(name)`",
				span,
				"not its interface",
			).withNote(
				"a module under a directory named `internal` can be imported by its own package's modules and by no other package's",
			),
		)
	}
	return .None
}

/// The `.c` files of one module for `target`, its C++ files — `.cpp`,
/// `.cc`, `.cxx` — and on an Apple target its `.m` and `.mm` files, in name
/// order. The standard library is compiled in and has
/// none; a module that cannot be read has its missing import reported
/// elsewhere.
pub fn moduleCFiles(dir: str, target: Target): Vec<String> = {
	val listing = if dir.isEmpty() then "." else dir
	val .Ok(entries) = fs::readDir(listing) else return Vec()
	var files: Vec<String> = Vec()
	for entry in entries {
		val name = entry.name.toStr()
		// Objective-C and Objective-C++ are Apple's, so a `.m` or `.mm` file
		// is glue for an Apple target, and passed over elsewhere. A file may
		// say which target it is for in its name.
		val takes = match path::extension(name) {
			.Some("c") | .Some("cpp") | .Some("cc") | .Some("cxx") => true
			.Some("m") | .Some("mm") => target.vendor() == "apple"
			_ => false
		}
		if takes && takesFile(name, target) then files.push(path::join(dir, name))
	}
	files.sort()
	return files
}

/// The first import cycle, if the modules form one.
pub fn importCycle(edges: &[(String, String, Span)]): Option<Diagnostic> = {
	var trail = Vec::of([String()])
	var done: Vec<String> = Vec()
	val .Some((to, from, span)) = importWalk("", &edges, &var trail, &var done) else return .None
	return .Some(
		Diagnostic::error(
			UNKNOWN_MODULE,
			"modules `\(to)` and `\(from)` import each other",
			span,
			"this import closes the circle",
		).withNote("modules form a directed acyclic graph, so each can be compiled on its own"),
	)
}

/// The walk `importCycle` makes from one module: the first import that
/// leads back onto `trail`.
fn importWalk(
	at: str,
	edges: &[(String, String, Span)],
	trail: &var Vec<String>,
	done: &var Vec<String>,
): Option<(String, String, Span)> = {
	for (from, to, span) in edges {
		if from != at then continue
		if trail.contains(&to) then return .Some((to.clone(), from.clone(), span))
		if done.contains(&to) then continue
		trail.push(to.clone())
		if importWalk(to, &edges, &var trail, &var done) is .Some(found) then return .Some(found)
		trail.pop()
		done.push(to.clone())
	}
	return .None
}
