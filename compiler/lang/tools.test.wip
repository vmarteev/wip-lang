// The tools written in Wip that `wip` carries.

@test
fn aToolIsItsSourceAndNotItsTests() = {
	val names = toolFiles("tools/bindgen")
	assert(names.contains(String::of("main.wip")))
	assert(names.contains(String::of("types/types.wip")))
	for name in names do
		assert(!name.endsWith(".test.wip"), "\(name) is a test")
}
