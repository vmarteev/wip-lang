// What `clang` makes, kept in the cache.

import std::future
import std::path

/// Objects kept at once by the threads of one process are each kept under
/// their own key: a name shared by the writes once put one program's object
/// under another's.
@test
fn objectsKeptAtOnceStayTheirOwn() = {
	val unique = Unique::new()
	val .Ok(dir) = TempDir::new(&unique) else {
		panic("a temporary directory")
	}
	val cache = dir.join("llvm")
	var numbers: Vec<i64> = Vec()
	for i in 0..32 {
		numbers.push(i)
	}
	future::map(&numbers, (i) => {
		val object = dir.join("made\(i).o")
		var bytes: Vec<u8> = Vec()
		for _ in 0..65536 {
			bytes.push(i as u8)
		}
		assert(writeBytes(object.toStr(), &bytes).isOk())
		val kept = path::join(cache.toStr(), "\(i).o")
		keepObject(kept.toStr(), object.toStr(), &unique)
	})
	for i in 0..32 {
		val kept = path::join(cache.toStr(), "\(i).o")
		val .Ok(read) = readBytes(kept.toStr()) else {
			panic("\(i).o is kept")
		}
		assert(read.len() == 65536)
		for byte in read {
			assert(byte == i as u8)
		}
	}
}
