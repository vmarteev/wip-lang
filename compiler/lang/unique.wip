// Names for what the compiler writes several of at once.

import std::process
import std::sync::{Atomic}

/// Names no other writer uses: this process's number, and a count the
/// threads of a build share. The compiler keeps no state of its own beyond
/// what it is handed, so a build makes one and hands it to whatever names a
/// file.
pub struct Unique {
	count: Atomic<i64>
}

extend Unique {
	pub static fn new(): Unique = Unique(count: Atomic::of(0 as i64))

	/// A name not given before: `4211-7`.
	pub fn next(): String = "\(process::id())-\(self.count.add(1))"
}
