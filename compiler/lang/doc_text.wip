// One item of the documentation, printed: what `wip doc
// std::collections::Map` or `wip doc str::findLast` shows at a terminal.

/// The item a path names, as text: `std::collections::Map`, a method
/// `std::collections::Map::get`, or a type found by name alone, `str` and
/// `str::findLast`. Where the path names nothing, what it might have meant.
pub fn printItem(docs: &Docs, path: str): Result<String, String> = {
	val segments: Vec<str> = path.split("::").toVec()
	// The longest start of the path that is a module, and what follows.
	var module: Option<i64> = .None
	var rest = 0
	var n = segments.len()
	while module.isNone() && n >= 0 {
		val prefix = joined(&segments[0..n])
		for (at, m) in docs.modules.forwards().enumerate() {
			if m.path == prefix && (n > 0 || !m.path.isEmpty()) {
				module = .Some(at)
				rest = n
				break
			}
		}
		n -= 1
	}
	if rest == segments.len() {
		// A module alone: its items, each a line.
		val .Some(at) = module else {
			panic("a path names a module where nothing follows it")
		}
		return .Ok(moduleText(&docs.modules[at]))
	}
	val name = segments[rest]
	var found: Vec<(i64, i64, i64)> = Vec()
	for (at, m) in docs.modules.forwards().enumerate() {
		if module is .Some(only) && only != at then continue
		for (f, file) in m.files.forwards().enumerate() {
			for (i, item) in file.items.forwards().enumerate() {
				if item.name == name then found.push((at, f, i))
			}
		}
	}
	if found.isEmpty() then return .Err("nothing is documented as `\(path)`")
	if found.len() > 1 {
		// A type and a function may share a name across modules; the
		// program's own comes first, as the index lists it.
		var choices: Vec<String> = Vec()
		for (at, f, i) in found {
			val m = &docs.modules[at]
			choices.push("  \(m.path)::\(m.files[f].items[i].name)")
		}
		return .Err("`\(path)` names more than one item; say which:\n\(choices.join("\n"))")
	}
	val (at, f, i) = found[0]
	val module = &docs.modules[at]
	val item = &module.files[f].items[i]
	if rest + 1 == segments.len() then return .Ok(itemText(&module, &item))
	if rest + 2 != segments.len() then return .Err("nothing is documented as `\(path)`")
	val member = segments[rest + 1]
	var members: Vec<&Member> = Vec()
	for m in item.members {
		if m.name == member then members.push(&m)
	}
	for group in item.methods {
		for m in group.methods {
			if m.name == member then members.push(&m)
		}
	}
	if members.isEmpty() then return .Err("`\(item.name)` has nothing documented as `\(member)`")
	var texts: Vec<String> = Vec()
	for m in members {
		texts.push(memberText(&module, &item, &m))
	}
	return .Ok(texts.join("\n"))
}

/// Names of a path, put back together.
fn joined(names: &[str]): String = names.join("::")

fn moduleText(module: &Module): String = {
	var out = "\(module.title())\n"
	for file in module.files {
		for item in file.items {
			out.push("\n\(item.decl)\n")
			val first = firstParagraph(item.doc)
			if !first.isEmpty() then out.push("\(indent(first, 4))\n")
		}
	}
	return move out
}

fn itemText(module: &Module, item: &DocItem): String = {
	var out = "\(module.path)::\(item.name)\n\n\(item.decl)\n"
	if !item.doc.isEmpty() then out.push("\n\(item.doc)\n")
	if !item.members.isEmpty() {
		val heading = match item.kind {
			.Enum => "Variants"
			.Interface => "Methods"
			_ => "Fields"
		}
		out.push("\n\(heading):\n")
		for m in item.members {
			out.push(memberLines(&m))
		}
	}
	if !item.implements.isEmpty() then out.push("\nImplements \(item.implements.join(", ")).\n")
	for group in item.methods {
		if group.methods.isEmpty() then continue
		match group.header {
			.Some(header) => out.push("\nMethods, \(header):\n")
			.None => out.push("\nMethods:\n")
		}
		for m in group.methods {
			out.push(memberLines(&m))
		}
	}
	return move out
}

fn memberText(module: &Module, item: &DocItem, member: &Member): String = {
	var out = "\(module.path)::\(item.name)::\(member.name)\n\n\(member.decl)\n"
	if !member.doc.isEmpty() then out.push("\n\(member.doc)\n")
	return move out
}

fn memberLines(member: &Member): String = {
	var out = "  \(member.decl)\n"
	if !member.doc.isEmpty() {
		out.push(indent(member.doc, 6))
		out.push("\n")
	}
	return move out
}

fn indent(text: str, by: i64): String = {
	val pad = String::of(" ").repeat(by)
	var lines: Vec<String> = Vec()
	for line in text.lines() {
		lines.push(if line.isEmpty() then String() else "\(pad)\(line)")
	}
	return lines.join("\n")
}
