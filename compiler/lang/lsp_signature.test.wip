// A call's signature as its arguments are written.

@test
fn theCallAndTheArgumentAreReadFromBeforeTheCursor() = {
	val atEnd = (text: str): Option<Call> => callAt(text, text.len())
	assert(
		atEnd("\tval a = area(1, g(2, 3), ") == .Some(Call(paren: 13, argument: 2, method: false)),
	)
	assert(atEnd("\tball.step(") == .Some(Call(paren: 10, argument: 0, method: true)))
	assert(atEnd("\tf(\"a, b\", ") == .Some(Call(paren: 2, argument: 1, method: false)))
	assert(atEnd("\tval t = (1, ") == .None)
	assert(atEnd("\tf(Point { x: 1, ") == .None)
}
