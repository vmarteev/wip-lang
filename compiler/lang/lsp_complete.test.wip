// What is asked where completion is.

@test
fn whatIsAskedIsReadFromBeforeTheCursor() = {
	val atEnd = (text: str): Asked => asked(text, text.len())
	assert(atEnd("\tval a = ball.") == Asked::Member(13))
	assert(atEnd("\tval a = ball.pa") == Asked::Member(13))
	// A leading dot is a member too, of nothing: the type expected decides.
	assert(atEnd("\tval a: Shape = .") == Asked::Member(16))
	assert(atEnd("\tarea(.Sq") == Asked::Member(6))
	assert(atEnd("\tgame::board::Bo") == Asked::Path([String::of("game"), String::of("board")]))
	assert(atEnd("\tfor i in 0..") == Asked::Scope)
	assert(atEnd("\tval a = to") == Asked::Scope)
}
