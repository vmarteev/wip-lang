// The protocol's framing and its way of naming places.

import std::json
import std::json::{Json, parse}

@test
fn aColumnIsCountedInUtf16() = {
	val text = "val a = 1\nval é𝄞 = 2\n"
	val lines = Lines::of(text)
	val .Some(two) = text.indexOf("2") else panic("a 2")
	assert(lines.position(two) == Position(line: 1, character: 10))
	assert(lines.offset(Position(line: 1, character: 10)) == two)
	assert(lines.offset(Position(line: 0, character: 99)) == 9)
	assert(lines.offset(Position(line: 9, character: 0)) == text.len())
}

@test
fn aUriNamesAPathAndBack() = {
	val uri = uriOf("/My Projects/wip/main.wip")
	assert(uri == "file:///My%20Projects/wip/main.wip")
	assert(pathOf(uri.toStr()) == .Some(String::of("/My Projects/wip/main.wip")))
}

@test
fn aFieldIsLookedUpByItsPath() = {
	val message = object([
		("params", object([("textDocument", object([("uri", jsonText("file:///a"))]))])),
	])
	assert(textAt(&message, ["params", "textDocument", "uri"]) == "file:///a")
	assert(fieldAt(&message, ["params", "nothing", "uri"]) == Json::Null)
}

@test
fn aMessageIsReadIntoItsType() = {
	val params = parse(
		"{\"textDocument\": {\"uri\": \"file:///a\", \"version\": 3}, \"position\": {\"line\": 2, \"character\": 5}}",
	).unwrap()
	val asked = json::fromJson<PositionParams>(params).unwrap()
	assert(
		asked.textDocument.uri == "file:///a" && asked.position == Position(line: 2, character: 5),
	)
	val item = CompletionItem(label: "area", kind: 3, detail: .None)
	assert(json::encode(&item) == "{\"label\":\"area\",\"kind\":3}", "what is nothing is left out")
}
