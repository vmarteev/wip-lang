// The protocol's framing and its way of naming places.

import std::json::{Json}

@test
fn aColumnIsCountedInUtf16() = {
	val text = "val a = 1\nval é𝄞 = 2\n"
	val lines = Lines::of(text)
	val .Some(two) = text.find("2") else {
		panic("a 2")
	}
	assert(lines.position(two) == object([("line", Json::Int(1)), ("character", Json::Int(10))]))
	assert(lines.offset(object([("line", Json::Int(1)), ("character", Json::Int(10))])) == two)
	assert(lines.offset(object([("line", Json::Int(0)), ("character", Json::Int(99))])) == 9)
	assert(
		lines.offset(object([("line", Json::Int(9)), ("character", Json::Int(0))])) == text.len(),
	)
}

@test
fn aUriNamesAPathAndBack() = {
	val uri = uriOf("/My Projects/wip/main.wip")
	assert(uri == "file:///My%20Projects/wip/main.wip")
	assert(pathOf(uri.toStr()) == .Some(String::of("/My Projects/wip/main.wip")))
}

@test
fn aFieldIsLookedUpByItsPath() = {
	val message = object([
		("params", object([("textDocument", object([("uri", jsonText("file:///a"))]))])),
	])
	assert(textAt(&message, ["params", "textDocument", "uri"]) == "file:///a")
	assert(fieldAt(&message, ["params", "nothing", "uri"]) == Json::Null)
	assert(
		withField(object([("a", Json::Int(1))]), "b", Json::Int(2)) ==
			object([("a", Json::Int(1)), ("b", Json::Int(2))]),
	)
}
