// What the language server finds of a name.

@test
fn documentationIsTheCommentAbovePastAnnotations() = {
	val text = "// not this\n/// The area.\n/// In units.\n@inline\nfn area(): i64 = 1\n"
	val .Some(at) = text.find("fn") else {
		panic("fn")
	}
	assert(documentation(text, at) == "The area.\nIn units.")
	assert(documentation(text, 3) == "")
}
