// Building with LLVM through `clang`, which compiles every build in parts,
// at once: a debug build at `-O0`, and a release build at `-O2`, each of its
// parts with copies of the small functions it calls from others. `clang` is
// handed each module as bitcode, which a later `clang`
// reads as the one it was written for, where its text it may not. The
// `clang` is version 15 or newer, found by asking it to compile a module of
// one function.
//
// What `clang` makes of a program is kept in the cache, as the C a module
// carries is, under the hash of everything it depends on: this compiler, the
// `clang`, the flags and the bitcode.

import std::collections::{Map}
import std::digest::{Sha256}
import std::fs
import std::future
import std::io
import std::path
import std::process
import std::process::{Command}
import llvm::{Ir, frameListAssembly, withFrameTables}
import llvm

/// A `clang` that compiles the LLVM backend's IR, and who it is: its name
/// and what it says its version is.
pub struct FoundClang {
	pub path: String
	pub identity: Vec<u8>
}

/// The `clang` that compiles the LLVM backend's IR: the one `WIP_CLANG`
/// names, or `clang`, if it reads the IR; what is wrong where there is
/// none. The answer is kept in the cache, so that a `clang` is asked once.
pub fn findClang(unique: &Unique): Result<FoundClang, String> = {
	val clang = match io::env("WIP_CLANG") {
		.Some(clang) => clang
		.None => "clang"
	}
	val identity = toolIdentity(clang)
	if !readsTheIr(clang, &identity, &unique) then
		return .Err("wip builds with a clang 15 or newer: \(missing())")
	return .Ok(FoundClang(path: clang, identity: identity))
}

/// Why there is no `clang` for LLVM, and what to do.
fn missing(): String = match io::env("WIP_CLANG") {
	.Some(clang) => "`\(clang)`, which WIP_CLANG names, is not a clang 15 or newer, or is not there"
	.None => "`clang` is not a clang 15 or newer, or is not there; WIP_CLANG names one"
}

/// Whether `clang` compiles a module with pointers that name no type, which
/// `clang` 15 reads by default and 14 does not: 15 is the version whose
/// bitcode the backend writes. Apple counts its versions as LLVM does not, so
/// the module answers rather than the number.
fn readsTheIr(clang: str, identity: &[u8], unique: &Unique): bool = {
	var key = Sha256()
	val asked = "reads the LLVM backend's IR"
	field(&var key, &asked)
	field(&var key, &identity)
	val answer = path::join(cache(), hex(key.finish()))
	if fs::readFile(answer) is .Ok(known) then return known.toStr() == "yes"
	val .Ok(dir) = fs::TempDir::new() else return false
	val module = dir.join("probe.ll")
	val object = dir.join("probe.o")
	val probe = "define ptr @probe(ptr %p) {\n  ret ptr %p\n}\n"
	val compiles = Command::of(clang).args([
		"-c",
		"-x",
		"ir",
		"-Wno-override-module",
		module.toStr(),
		"-o",
		object.toStr(),
	])
	val reads =
		fs::writeFile(module, probe).isOk() &&
		compiles.output() is .Ok(output) &&
		output.exit.success()
	// Only an answer from a `clang` that was there, and said its version, is
	// kept: one installed later is asked again.
	val there = identity.len() > clang.len()
	if there {
		fs::makeDirs(cache())
		fs::writeFile(answer, if reads then "yes" else "no")
	}
	return reads
}

/// Whether the `clang` that said `identity` is Apple's.
fn isAppleClang(identity: &[u8]): bool = {
	val text = str::fromBytes(&identity)
	for line in text.lines() {
		if line.contains("Apple clang") then return true
	}
	return false
}

/// The objects `clang` makes of the LLVM backend's IR, its parts compiled at
/// once, with the tables a panic reads its calls from, which the program's
/// DWARF says the contents of, and the list of them. A release build's part
/// has its table in its object; a debug build's one table is an object of
/// its own on a Mac and in the first part's object on ELF. `optimize` says
/// which: `-O2` or `-O0`, unless `WIP_LLVM_OPT` says another level. Kept in
/// the cache under what they depend on, part by part, and taken from there
/// when nothing has changed.
pub fn llvmObjects(
	ir: &Ir,
	options: &BuildOptions,
	optimize: bool,
	unique: &Unique,
): Result<Vec<Vec<u8>>, BuildError> = {
	val found = match findClang(&unique) {
		.Ok(found) => found
		.Err(message) => return .Err(.Link(message))
	}
	val llvm = Clang::new(&found, &options, optimize, &unique)
	return if optimize then llvm.optimized(&ir.modules, &ir.files)
	else llvm.parts(&ir.modules, &ir.files)
}

/// The symbol of the table of what is kept under `key`: named by what it is
/// made of, so that an object holding it is the same wherever its part is.
fn tableSymbol(key: str): String = "wip.frame_table.\(key[..16])"

/// The number the entries of what is kept under `key` hold, which the list
/// finds their shared piece by: the key's first sixteen hexadecimal digits,
/// which the piece's symbol is named by.
fn tableKey(key: str): u64 = {
	var number: u64 = 0
	for i in 0..16 {
		val digit = key[i]
		val value: u64 =
			if digit >= b'0' && digit <= b'9' then (digit - b'0') as u64
			else (digit - b'a' + 10) as u64
		number = number << 4 | value
	}
	return number
}

/// `clang`, and how it is asked to compile the LLVM backend's IR.
view struct Clang {
	found: &FoundClang
	/// Code for the system the program is for, where a position-independent
	/// program is loaded, for the processor the program's C is built for.
	target: Vec<String>
	/// Whether the objects are Mach-O, Apple's, rather than ELF.
	apple: bool
	/// What compiles a module, before what it compiles.
	compile: Vec<String>
	/// This compiler, as far as an object depends on it.
	compiler: Vec<u8>
	unique: &Unique
}

extend Clang {
	static fn new(
		found: &FoundClang,
		options: &BuildOptions,
		optimize: bool,
		unique: &Unique,
	): Clang = {
		val apple = options.target.isApple()
		var target: Vec<String> = Vec()
		for flag in options.targetFlags {
			target.push(flag.clone())
		}
		if !apple then target.push("-fPIC")
		target.push(cpuFlag(&options.cpu, &options.target))
		// `WIP_LLVM_OPT` sets the level, to tell what optimising does from
		// what the IR says.
		val level = match io::env("WIP_LLVM_OPT") {
			.Some(level) => level
			.None => if optimize then "2" else "0"
		}
		var compile: Vec<String> = Vec()
		compile.push("-O\(level)")
		compile.push("-x")
		compile.push("ir")
		compile.push("-Wno-override-module")
		// A function's cold code stays in the function: moved to one of its
		// own, it would be a call a panic's calls show, of a function the
		// program does not have. Apple's clang moves it unless told not to;
		// LLVM's own does not unless told to, and knows no such flag.
		if isAppleClang(&found.identity) {
			compile.push("-Xclang")
			compile.push("-fno-split-cold-code")
		}
		// An object is written again with the table in it, by a writer that
		// knows no table of the functions whose addresses are taken, which
		// only a linker folding identical code reads, and which names them
		// by numbers that the symbols a table adds to a Mach-O object change.
		compile.push("-fno-addrsig")
		// Each function in a section of its own on ELF, so that a release
		// build's linker drops one that nothing reaches, and the table's
		// entry for it, which is tied to its section.
		if optimize && !apple then compile.push("-ffunction-sections")
		for arg in target {
			compile.push(arg.clone())
		}
		return Clang(
			found: &found,
			target: target,
			apple: apple,
			compile: compile,
			compiler: thisCompiler(),
			unique: &unique,
		)
	}

	/// Where the cache keeps what is made of `parts`: what compiles them, and
	/// each part's bitcode, or each part's key.
	fn key(what: str, parts: &[&[u8]]): String = {
		var key = Sha256()
		field(&var key, &what)
		field(&var key, &self.compiler)
		field(&var key, &self.found.identity)
		for arg in self.compile {
			field(&var key, arg.toStr())
		}
		for part in parts {
			field(&var key, &part)
		}
		return hex(key.finish())
	}

	/// `clang` with what compiles a module, and then `args`.
	fn invoke(before: &[String], args: &[str]): Result<void, BuildError> = {
		var all: Vec<str> = Vec()
		for arg in before {
			all.push(arg)
		}
		for arg in args {
			all.push(arg)
		}
		return run(self.found.path, &all)
	}

	fn assemble(assembly: str, output: str): Result<void, BuildError> = {
		var args: Vec<String> = Vec()
		args.push("-c")
		args.push("-x")
		args.push("assembler")
		for arg in self.target {
			args.push(arg.clone())
		}
		return self.invoke(&args, [assembly, "-o", output])
	}

	/// `module`'s bitcode compiled straight to an object, in `dir`.
	fn object(module: &[u8], dir: &fs::TempDir): Result<Vec<u8>, BuildError> = {
		val source = dir.join("program.bc")
		val object = dir.join("program.o")
		if writeBytes(source, module) is .Err(error) then
			return .Err(.Link("cannot write the bitcode: \(error)"))
		self.invoke(&self.compile, ["-c", source.toStr(), "-o", object.toStr()])?
		return readObject(object)
	}

	/// A release build's parts, each compiled with its table at once with the
	/// others and kept on its own, and the list of their tables.
	fn optimized(
		modules: &[llvm::Module],
		files: &Map<String, String>,
	): Result<Vec<Vec<u8>>, BuildError> = {
		val built = future::map(&modules, (module) => self.optimizedPart(&module, &files))
		var keys: Vec<String> = Vec()
		var objects: Vec<Vec<u8>> = Vec()
		for result in move built {
			val (key, object) = result?
			keys.push(key)
			objects.push(object)
		}
		objects.push(self.list(&keys)?)
		return .Ok(objects)
	}

	/// One part of a release build, its bitcode compiled with its table, from
	/// the cache or compiled there, with the key the cache keeps it under.
	fn optimizedPart(
		part: &llvm::Module,
		files: &Map<String, String>,
	): Result<(String, Vec<u8>), BuildError> = {
		val module = llvm::bitcode(&part)
		val key = self.key("an optimised LLVM part", [module.items()])
		val symbol = tableSymbol(key)
		val kept = path::join(cache(), "\(key).o")
		if readBytes(kept) is .Ok(object) then return .Ok((key, object))
		val dir = temporaryDir()?
		val object = dir.join("program.o")
		// The object, written again with the table in it, with no assembly
		// between, whose names an assembler may read as registers.
		val compiled = self.object(&module.items(), &dir)?
		val built = match withFrameTables([compiled], &files, symbol, tableKey(key), true) {
			.Ok(built) => built
			.Err(error) => return .Err(dwarf(error))
		}
		if writeBytes(object, &built) is .Err(error) then
			return .Err(.Link("cannot write the object: \(error)"))
		keepObject(kept, object, self.unique)
		return .Ok((key, built))
	}

	/// The list of the tables, kept under `keys`: an object of its own, which
	/// says only their numbers and their shared pieces' names, kept under
	/// them.
	fn list(keys: &[String]): Result<Vec<u8>, BuildError> = {
		var all: Vec<&[u8]> = Vec()
		var tables: Vec<(u64, String)> = Vec()
		for key in keys {
			all.push(key.toStr())
			tables.push((tableKey(key), tableSymbol(key)))
		}
		val kept = path::join(cache(), "\(self.key("an LLVM list of tables", &all)).list.o")
		if readBytes(kept) is .Ok(list) then return .Ok(list)
		val dir = temporaryDir()?
		val assembly = dir.join("list.s")
		val list = dir.join("list.o")
		if fs::writeFile(assembly, frameListAssembly(&tables, self.apple)) is .Err(error) then
			return .Err(.Link("cannot write the assembly: \(error)"))
		self.assemble(assembly, list)?
		keepObject(kept, list, self.unique)
		return readObject(list)
	}

	/// A debug build's parts, each compiled straight to an object at once
	/// with the others and kept on its own, the table of them all, and the
	/// list of it.
	fn parts(
		modules: &[llvm::Module],
		files: &Map<String, String>,
	): Result<Vec<Vec<u8>>, BuildError> = {
		val built = future::map(&modules, (module) => self.part(&module))
		var keys: Vec<String> = Vec()
		var objects: Vec<Vec<u8>> = Vec()
		for result in move built {
			val (key, object) = result?
			keys.push(key)
			objects.push(object)
		}

		// The table, made of every part, kept under all their keys.
		var all: Vec<&[u8]> = Vec()
		for key in keys {
			all.push(key.toStr())
		}
		val key = self.key("an LLVM table", &all)
		val kept = path::join(cache(), "\(key).table.o")
		val table = match readBytes(kept) {
			.Ok(table) => table
			.Err(..) => self.table(&objects, &files, key, kept)?
		}
		// The table is the first part, written again with it.
		objects[0] = table
		objects.push(self.list([key])?)
		return .Ok(objects)
	}

	/// The table of a debug build's parts, named by `key`, made and kept at
	/// `kept`.
	fn table(
		objects: &[Vec<u8>],
		files: &Map<String, String>,
		key: str,
		kept: str,
	): Result<Vec<u8>, BuildError> = {
		val symbol = tableSymbol(key)
		val dir = temporaryDir()?
		val table = dir.join("table.o")
		// Its entries name every part's functions, which, on ELF, none of
		// their sections can be tied to in this object: a debug build strips
		// nothing.
		val first = match withFrameTables(&objects, &files, symbol, tableKey(key), false) {
			.Ok(first) => first
			.Err(error) => return .Err(dwarf(error))
		}
		if writeBytes(table, &first) is .Err(error) then
			return .Err(.Link("cannot write the object: \(error)"))
		keepObject(kept, table, self.unique)
		return readObject(table)
	}

	/// One part of a debug build, from the cache or compiled there, with the
	/// key the cache keeps it under: its bitcode, written on the thread that
	/// compiles it.
	fn part(part: &llvm::Module): Result<(String, Vec<u8>), BuildError> = {
		val module = llvm::bitcode(&part)
		val key = self.key("an LLVM part", [module.items()])
		val name = "\(key).o"
		val kept = path::join(cache(), name)
		if readBytes(kept) is .Ok(object) then return .Ok((key, object))
		val dir = temporaryDir()?
		val object = self.object(&module.items(), &dir)?
		val made = dir.join("program.o")
		keepObject(kept, made, self.unique)
		return .Ok((key, object))
	}
}

/// Where the cache keeps what LLVM made.
fn cache(): String = path::join(cacheDir(), "llvm")

fn temporaryDir(): Result<fs::TempDir, BuildError> = match fs::TempDir::new() {
	.Ok(dir) => .Ok(dir)
	.Err(why) => .Err(.Link("cannot create a temporary directory: \(why)"))
}

fn readObject(path: str): Result<Vec<u8>, BuildError> = match readBytes(path) {
	.Ok(object) => .Ok(object)
	.Err(error) => .Err(.Link("cannot read the object clang wrote: \(error)"))
}

fn dwarf(error: str): BuildError = .Link("cannot read the DWARF clang wrote: \(error)")

/// The bytes of a file.
fn readBytes(path: str): Result<Vec<u8>, io::IoError> = {
	val text = fs::readFile(path)?
	var bytes: Vec<u8> = Vec::withCapacity(text.len())
	bytes.pushAll(text.toStr())
	return .Ok(bytes)
}

/// Bytes, as the whole of a file that is made or emptied first.
fn writeBytes(path: str, bytes: &[u8]): Result<void, io::IoError> = {
	var file = fs::File::create(path)?
	file.writeAll(bytes)?
	return .Ok()
}

/// Puts an object in the cache, whole or not at all: written beside where it
/// goes under a name no other writer uses — the parts of a build are kept at
/// once, on threads — then renamed there. A cache that cannot be written is a
/// build that is not kept, and nothing worse.
fn keepObject(kept: str, object: str, unique: &Unique) = {
	val dir = path::parent(kept)
	if fs::makeDirs(dir).isErr() then return
	val partial = "\(kept).\(unique.next()).partial"
	if fs::copy(object, partial).isOk() && fs::rename(partial, kept).isErr() then
		fs::removeFile(partial)
}

/// This compiler, as far as an object it made depends on it: the table of
/// calls is written by its code, which the IR does not say. Its path, size
/// and time, which a new build of it changes.
fn thisCompiler(): Vec<u8> = {
	var id: Vec<u8> = Vec()
	val .Ok(exe) = process::executable() else return id
	id.pushAll(exe.toStr())
	if fs::meta(exe) is .Ok(meta) {
		pushLittle(&var id, meta.size as u64, 8)
		val nanos = meta.modified * 1_000_000_000 + meta.modifiedNanos
		pushLittle(&var id, nanos as u64, 16)
	}
	return id
}

/// `value`'s bytes, least first, in `width` bytes: those past eight are
/// zeros.
fn pushLittle(out: &var Vec<u8>, value: u64, width: i64) = {
	for i in 0..width {
		out.push(if i < 8 then (value >> (8 * i) as u64) as u8 else 0)
	}
}
