// What a package's version may be, how a dependency's path is named, and
// what an app's identifier and least iOS version may be.

@test
fn semanticVersions() = {
	for good in [
		"0.0.0",
		"1.4.0",
		"10.20.30",
		"2.0.0-rc.1",
		"1.0.0+build.7",
		"1.0.0-alpha-2+sha.5114f85",
	] {
		assert(isSemver(good), good)
	}
	for bad in [
		"1.4",
		"1.4.0.1",
		"01.4.0",
		"1.4.x",
		"v1.4.0",
		"1.4.0-",
		"1.4.0+",
		"1.4.0-a..b",
		"",
	] {
		assert(!isSemver(bad), bad)
	}
}

@test
fn aDependencysPathIsTidiedNotResolved() = {
	assert(tidy("game/../engine") == "engine")
	assert(tidy("../engine") == "../engine")
	assert(tidy("./a/./b/../c") == "a/c")
}

@test
fn anAppIsNamedInReverse() = {
	for good in ["com.example.game", "net.ex-ample.Game2", "a.b"] {
		assert(isBundleId(good), good)
	}
	for bad in ["game", "com..game", ".com.game", "com.game.", "com.ga me", "com.gäme", ""] {
		assert(!isBundleId(bad), bad)
	}
	for good in ["17", "17.0", "18.2.1"] {
		assert(isVersion(good), good)
	}
	for bad in ["", "17.", "v17", "17.x"] {
		assert(!isVersion(bad), bad)
	}
}
