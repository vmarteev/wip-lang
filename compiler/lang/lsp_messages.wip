// The Language Server Protocol's messages, as types: what the editor sends
// is read into them, and what the server answers is written from them, each
// field under its name in the protocol. A field the editor sends that a type
// does not have is passed over, and an `Option` that is nothing is left out.

import std::collections::{Map}

/// A place in a text: a line, and a column counted in UTF-16 code units.
@derive(Encode, Decode, Eq, Clone, Text)
pub struct Position {
	pub line: i64
	pub character: i64
}

extend Position {
	/// Whether it is at or before `other`.
	pub fn atOrBefore(other: &Position): bool =
		self.line < other.line || self.line == other.line && self.character <= other.character
}

/// What lies from `start` up to `end`.
@derive(Encode, Decode, Eq, Clone, Text)
pub struct Range {
	pub start: Position
	pub end: Position
}

/// A range in a file.
@derive(Encode, Decode, Eq, Clone, Text)
pub struct Location {
	pub uri: String
	pub range: Range
}

/// Text put in place of a range.
@derive(Encode, Clone)
pub struct TextEdit {
	pub range: Range
	pub newText: String
}

/// Edits, by the URI of the file each is in.
@derive(Encode, Clone)
pub struct WorkspaceEdit {
	pub changes: Map<String, Vec<TextEdit>>
}

/// What is wrong at a range, as the editor shows it.
@derive(Encode, Clone)
pub struct Reported {
	pub range: Range
	/// 1 an error, 2 a warning.
	pub severity: i64
	pub code: String
	pub source: String = "wip"
	pub message: String
	pub relatedInformation: Vec<Related>
}

/// Another place a diagnostic speaks of.
@derive(Encode, Clone)
pub struct Related {
	pub location: Location
	pub message: String
}

/// A fix the editor offers for diagnostics.
@derive(Encode)
pub struct CodeAction {
	pub title: String
	pub kind: String = "quickfix"
	pub diagnostics: Vec<Reported>
	pub isPreferred: bool = true
	pub edit: WorkspaceEdit
}

/// Text written in Markdown.
@derive(Encode)
pub struct Markdown {
	pub kind: String = "markdown"
	pub value: String
}

/// What a name is, and where.
@derive(Encode)
pub struct Hover {
	pub contents: Markdown
	pub range: Option<Range>
}

/// What a call was given that it does not show, after its arguments.
@derive(Encode)
pub struct InlayHint {
	pub position: Position
	pub label: String
	/// 2, a parameter.
	pub kind: i64 = 2
}

/// A declaration in a file's outline, and what it holds.
@derive(Encode)
pub struct DocumentSymbol {
	pub name: String
	pub kind: i64
	pub range: Range
	pub selectionRange: Range
	pub children: Vec<DocumentSymbol>
}

/// What could be written at a place.
@derive(Encode)
pub struct CompletionItem {
	pub label: String
	pub kind: i64
	pub detail: Option<String>
}

@derive(Encode)
pub struct CompletionList {
	pub isIncomplete: bool = false
	pub items: Vec<CompletionItem>
}

/// The signature of the call being written, and the argument at the cursor.
@derive(Encode)
pub struct SignatureHelp {
	pub signatures: Vec<SignatureInformation>
	pub activeSignature: i64 = 0
	pub activeParameter: i64
}

@derive(Encode)
pub struct SignatureInformation {
	pub label: String
	pub documentation: Option<Markdown>
	pub parameters: Vec<ParameterInformation>
}

@derive(Encode)
pub struct ParameterInformation {
	pub label: String
}

/// What the server can do, as `initialize` answers.
@derive(Encode)
pub struct InitializeResult {
	pub capabilities: ServerCapabilities
	pub serverInfo: ServerInfo
}

@derive(Encode)
pub struct ServerInfo {
	pub name: String
	pub version: String
}

@derive(Encode)
pub struct ServerCapabilities {
	pub textDocumentSync: SyncOptions = SyncOptions()
	pub documentFormattingProvider: bool = true
	pub documentSymbolProvider: bool = true
	pub hoverProvider: bool = true
	pub completionProvider: CompletionOptions
	pub signatureHelpProvider: SignatureHelpOptions
	pub definitionProvider: bool = true
	pub referencesProvider: bool = true
	pub renameProvider: bool = true
	pub inlayHintProvider: bool = true
	pub codeActionProvider: CodeActionOptions
}

/// Files are opened and closed, sent whole on each change, and saved.
@derive(Encode)
pub struct SyncOptions {
	pub openClose: bool = true
	/// 1, the whole text.
	pub change: i64 = 1
	pub save: bool = true
}

@derive(Encode)
pub struct CompletionOptions {
	pub triggerCharacters: Vec<String>
}

@derive(Encode)
pub struct SignatureHelpOptions {
	pub triggerCharacters: Vec<String>
	pub retriggerCharacters: Vec<String>
}

@derive(Encode)
pub struct CodeActionOptions {
	pub codeActionKinds: Vec<String>
}

/// The diagnostics of a file, all of them, replacing what was shown.
@derive(Encode)
pub struct PublishDiagnostics {
	pub uri: String
	pub diagnostics: Vec<Reported>
}

// What the editor sends.

/// A file, by its URI.
@derive(Decode)
pub struct DocumentId {
	pub uri: String
}

/// A request about a whole file.
@derive(Decode)
pub struct DocumentParams {
	pub textDocument: DocumentId
}

/// A request about a place in a file.
@derive(Decode)
pub struct PositionParams {
	pub textDocument: DocumentId
	pub position: Position
}

@derive(Decode)
pub struct ReferenceParams {
	pub textDocument: DocumentId
	pub position: Position
	pub context: Option<ReferenceContext>
}

@derive(Decode)
pub struct ReferenceContext {
	pub includeDeclaration: bool = true
}

@derive(Decode)
pub struct RenameParams {
	pub textDocument: DocumentId
	pub position: Position
	pub newName: String
}

@derive(Decode)
pub struct CodeActionParams {
	pub textDocument: DocumentId
	pub range: Range
}

/// A file opened, with its text.
@derive(Decode)
pub struct DidOpen {
	pub textDocument: OpenedDocument
}

@derive(Decode)
pub struct OpenedDocument {
	pub uri: String
	pub text: String
}

/// A file changed: its whole text, as `initialize` asked for, the last
/// change the one that holds.
@derive(Decode)
pub struct DidChange {
	pub textDocument: DocumentId
	pub contentChanges: Vec<ContentChange>
}

@derive(Decode)
pub struct ContentChange {
	pub text: String
}
