// Building: what the linker is told, and what the IR passes.

import std::fs
import std::future
import std::process::{Command}

/// What the linker is told after the objects, in order: where to look for
/// libraries, the libraries, the frameworks on an Apple target, and the
/// threads' library on Linux.
@test
fn linkArguments() = {
	val args = linkArgs(
		Vec::of([String::of("/opt/lib")]),
		Vec::of([String::of("sqlite3"), "z"]),
		Vec::of([String::of("Cocoa")]),
		Target::host(),
	)
	var expected: Vec<String> = Vec()
	expected.push("-L/opt/lib")
	expected.push("-lsqlite3")
	expected.push("-lz")
	if TARGET_OS == "linux" then
		expected.push("-lpthread")

	if TARGET_VENDOR == "apple" {
		expected.push("-framework")
		expected.push("Cocoa")
	}
	// The maths are not added here: the prelude asks for them where it needs
	// them.
	assert(args == expected)
}

/// `BOARD_H` for `board.h`, and one `_` for each character that is not a
/// letter or a digit.
@test
fn aHeaderIsGuardedByItsName() = {
	assert(headerGuard("include/board.h") == "WIP_BOARD_H")
	assert(headerGuard("é-x.h") == "WIP___X_H")
}

/// A `void` given to a generic function, `destroy<void>`: it is passed as a
/// null pointer, which the signature has for it.
@test
fn aVoidArgumentIsPassedAsNull() = {
	val unique = Unique::new()
	val .Ok(dir) = fs::TempDir::new() else panic("a temporary directory")
	val main = dir.join("main.wip")
	val program = "fn ended<R>(work: &() => R) = destroy(work())\n\nfn main() = ended(() => {})\n"
	assert(fs::writeFile(main.toStr(), program).isOk())
	var timings = Timings()
	val .Ok(loaded) = loadMode(main.toStr(), .Program, &var timings, future::cores()) else {
		panic("the program is read")
	}
	var program = loaded
	val output = dir.join("main.ll")
	val options = BuildOptions(emit: .LlvmIr, profile: .Release)
	assert(buildLoaded(&var program, output.toStr(), &options, &unique, &var timings).isOk())
	val .Ok(ir) = fs::readFile(output.toStr()) else panic("the IR is written")
	var passed = false
	for line in ir.lines() do
		if line.contains("destroy<void>") && line.contains("(ptr null)") then
			passed = true

	assert(passed)
}

/// A reference read out of memory is not null to LLVM, and aligned, but not
/// promised to reach its value: where the place is an enum's payload, LLVM
/// takes the promise as true even where the enum holds another variant, and
/// reads through the reference before the branch that loads it.
@test
fn aReferenceReadFromMemoryPromisesOnlyWhatHoldsEverywhere() = {
	val unique = Unique::new()
	val .Ok(dir) = fs::TempDir::new() else panic("a temporary directory")
	val main = dir.join("main.wip")
	val program =
		"import std::collections::{Map}\n\nfn first(seen: &Map<i64, i64>, key: i64): i64 = match seen.get(&key) {\n\t.Some(value) => value + 1\n\t.None => 0\n}\n\nfn main() = {\n\tvar seen: Map<i64, i64> = Map()\n\tseen.put(1, 2)\n\tassert(first(&seen, 1) == 3 && first(&seen, 5) == 0)\n}\n"
	assert(fs::writeFile(main.toStr(), program).isOk())
	var timings = Timings()
	val .Ok(loaded) = loadMode(main.toStr(), .Program, &var timings, future::cores()) else {
		panic("the program is read")
	}
	var read = loaded
	val output = dir.join("main.ll")
	val options = BuildOptions(emit: .LlvmIr, profile: .Release)
	assert(buildLoaded(&var read, output.toStr(), &options, &unique, &var timings).isOk())
	val .Ok(ir) = fs::readFile(output.toStr()) else panic("the IR is written")
	var loads = 0
	for line in ir.lines() {
		if !line.contains("load ptr") || !line.contains("!nonnull") then
			continue

		loads += 1
		assert(!line.contains("!dereferenceable"), line)
	}
	assert(loads > 0, "no reference is loaded")
	assert(ir.contains("nonnull dereferenceable("), "a parameter promises it")
}

/// A comparison in constant time keeps its loop whole in a release build:
/// what `opaque` hides is read and written back by volatile steps, which
/// the optimiser keeps, so it cannot end the loop at the first byte that
/// differs, nor skip a step. Checked after `clang -O2`, from the IR as text
/// and as bitcode.
@test
fn aComparisonInConstantTimeKeepsItsLoopOptimised() = {
	val unique = Unique::new()
	val .Ok(clang) = findClang(&unique) else panic("a clang to build with")
	val .Ok(dir) = fs::TempDir::new() else panic("a temporary directory")
	val main = dir.join("main.wip")
	val program =
		"import std::io\nimport std::secret\n\nfn main() = {\n\tval a = secret::bytes(64)\n\tval b = secret::bytes(64)\n\tio::println(\"\\(secret::equal(&a, &b))\")\n}\n"
	assert(fs::writeFile(main.toStr(), program).isOk())
	for (emit, name) in [(Emit::LlvmIr, "main.ll"), (Emit::LlvmBc, "main.bc")] {
		var timings = Timings()
		val .Ok(loaded) = loadMode(main.toStr(), .Program, &var timings, future::cores()) else {
			panic("the program is read")
		}
		var read = loaded
		val output = dir.join(name)
		val options = BuildOptions(emit:, profile: .Release)
		assert(buildLoaded(&var read, output.toStr(), &options, &unique, &var timings).isOk())
		val optimized = dir.join("\(name).opt.ll")
		val ran = Command::of(clang.path.toStr()).args([
			"-O2",
			"-S",
			"-emit-llvm",
			"-Wno-override-module",
			output.toStr(),
			"-o",
			optimized.toStr(),
		]).output()
		assert(ran is .Ok(done) && done.exit.success(), "clang optimises \(name)")
		val .Ok(ir) = fs::readFile(optimized.toStr()) else panic("the IR is written")
		// The program has no other volatile step, wherever `equal` was
		// inlined: each iteration of its loop reads and writes one back.
		var volatile = 0
		for line in ir.lines() do
			if line.contains("load volatile") || line.contains("store volatile") then
				volatile += 1

		assert(volatile >= 2, "the loop keeps its volatile steps, from \(name)")
	}
}
