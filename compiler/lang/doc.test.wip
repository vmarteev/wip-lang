// A program's documentation, read from its source.

import std::fs
import std::future
import std::path

/// A module of two files: a type declared in one and extended in the other,
/// with what is and is not `pub`, a derive, an interface, a constrained
/// block, a constant and an alias.
fn shapes(): Module = {
	val first = """
		// Shapes, and what they cover.
		//
		// A second paragraph.

		import std::collections::{Map}

		/// A point on the plane.
		@derive(Eq, Text)
		pub struct Point {
		    /// Across.
		    pub x: f64
		    hidden: f64
		}

		/// What a shape is.
		pub enum Shape {
		    /// A circle, by its radius.
		    Round(radius: f64)
		    Dot
		}

		fn private(): i64 = 0

		/// The largest there is.
		pub val LIMIT: i64 = 10

		/// Another name.
		pub type Points = Map<str, Point>\n
		"""
	val second = """
		// Methods of a point.

		extend Point {
		    /// How far from the origin.
		    ///
		    ///     val d = p.length()
		    pub fn length(): f64 = self.x

		    fn helper(): f64 = 0.0
		}

		extend Point: Clone {
		    fn clone(): Point = Point(x: self.x, hidden: 0.0)
		}

		extend Pair<T: Eq> {
		    pub fn same(): bool = true
		}

		/// Two of a kind.
		pub struct Pair<T> {
		    pub a: T
		}\n
		"""
	val files = Vec::of(own [
		(String::of("shapes/first.wip"), String::of(first)),
		(String::of("shapes/second.wip"), String::of(second)),
	])
	return readModule("shapes", .Program, &files)
}

/// Which file of `module` the item named `name` is in, and where in it.
fn placeOf(module: &Module, name: str): (i64, i64) = {
	for (f, file) in module.files.forwards().enumerate() {
		for (i, item) in file.items.forwards().enumerate() {
			if item.name == name then return (f, i)
		}
	}
	panic("`\(name)` is documented")
}

@test
fn whatIsPubIsDocumentedWithItsComment() = {
	val module = shapes()
	var names: Vec<str> = Vec()
	for file in module.files {
		for item in file.items {
			names.push(item.name.toStr())
		}
	}
	assert(names == Vec::of(own ["Point", "Shape", "LIMIT", "Points", "Pair"]))
	val (pointFile, pointAt) = placeOf(&module, "Point")
	val point = &module.files[pointFile].items[pointAt]
	assert(point.kind == .Struct)
	assert(point.decl == "@derive(Eq, Text) struct Point")
	assert(point.doc == "A point on the plane.")
	// Its `pub` field alone, with the field's own comment.
	assert(point.members.len() == 1)
	assert(point.members[0].decl == "x: f64" && point.members[0].doc == "Across.")
	val (shapeFile, shapeAt) = placeOf(&module, "Shape")
	val shape = &module.files[shapeFile].items[shapeAt]
	assert(shape.members.len() == 2)
	assert(shape.members[0].decl == "Round(radius: f64)")
	assert(module.files[0].items[2].decl == "val LIMIT: i64")
	assert(module.files[0].items[3].decl == "type Points = Map<str, Point>")
}

@test
fn aTypesMethodsAndInterfacesAreGatheredFromEveryFile() = {
	val module = shapes()
	val (pointFile, pointAt) = placeOf(&module, "Point")
	val point = &module.files[pointFile].items[pointAt]
	assert(
		point.implements ==
			Vec::of(own [String::of("Eq"), String::of("Text"), String::of("Clone")]),
	)
	var methods: Vec<str> = Vec()
	for group in point.methods {
		for m in group.methods {
			methods.push(m.decl.toStr())
		}
	}
	assert(methods == Vec::of(own ["fn length(): f64"]), "`helper` is not `pub`")
	assert(point.methods[0].methods[0].doc == "How far from the origin.\n\n    val d = p.length()")
	// A block that asks more of the type's parameters keeps its header.
	val (pairFile, pairAt) = placeOf(&module, "Pair")
	val pair = &module.files[pairFile].items[pairAt]
	assert(pair.methods[0].header == .Some(String::of("extend Pair<T: Eq>")))
	assert(pair.hasPage() && point.hasPage() && !module.files[0].items[1].hasPage())
}

@test
fn aFileSaysWhatItIsForInItsOpeningParagraph() = {
	val module = shapes()
	assert(module.files[0].about == "Shapes, and what they cover.\n\nA second paragraph.")
	assert(module.files[1].about == "Methods of a point.")
	assert(fileParagraph("/// An item's.\nfn a() = {}\n") == "")
	assert(module.files[0].imports.len() == 1)
	assert(
		module.files[0].imports[0].0 == "Map" && module.files[0].imports[0].1 == "std::collections",
	)
}

@test
fn aBuiltInTypesMethodsAreItsOwnItem() = {
	val files = Vec::of(own [
		(
			String::of("std/prelude/text.wip"),
			String::of("extend str {\n    /// Twice.\n    pub fn twice(): String = String()\n}\n"),
		),
	])
	val module = readModule("std::prelude", .Std, &files)
	val (textFile, textAt) = placeOf(&module, "str")
	val text = &module.files[textFile].items[textAt]
	assert(text.kind == .BuiltIn)
	assert(text.methods[0].methods[0].doc == "Twice.")
}

@test
fn anItemIsFoundByItsPathOrItsName() = {
	val docs = Docs(modules: Vec::of(own [shapes()]))
	val .Ok(point) = printItem(&docs, "shapes::Point") else {
		panic("found")
	}
	assert(point.startsWith("shapes::Point\n\n@derive(Eq, Text) struct Point\n"))
	assert(point.contains("Implements Eq, Text, Clone."))
	assert(printItem(&docs, "Point") is .Ok(byName) && byName == point, "found by its name alone")
	val .Ok(method) = printItem(&docs, "Point::length") else {
		panic("a method")
	}
	assert(method.startsWith("shapes::Point::length\n\nfn length(): f64\n"))
	val .Ok(module) = printItem(&docs, "shapes") else {
		panic("a module alone")
	}
	assert(module.startsWith("shapes\n") && module.contains("struct Point"))
	assert(printItem(&docs, "shapes::Nothing").isErr())
	assert(printItem(&docs, "Point::nothing").isErr())
}

@test
fn aCommentIsParagraphsCodeAndExamples() = {
	val html = prose("One `a<b>` line\nand more.\n\n    let x = 1\n\nTwo.")
	assert(
		html ==
			"<p>One <code>a&lt;b&gt;</code> line and more.</p>\n<pre class=\"example\">let x = 1</pre>\n<p>Two.</p>\n",
	)
}

/// The whole standard library is written, and every link on its pages is
/// to a page that was written and to an anchor that page has: what the gate
/// asks of `wip doc`.
@test
fn theStandardLibrarysPagesLinkOnlyToWhatTheyWrote() = {
	val .Ok(docs) = read(.None, future::cores()) else {
		panic("the standard library is read")
	}
	val unique = Unique::new()
	val .Ok(dir) = TempDir::new(&unique) else {
		panic("a temporary directory")
	}
	val .Ok(pages) = writeSite(&docs, dir.path.toStr()) else {
		panic("written")
	}
	assert(pages > 50, "\(pages) pages")
	// Each page, and the anchors it has.
	var files: Vec<(String, String, Vec<String>)> = Vec()
	var stack = Vec::of(own [dir.path.clone()])
	while stack.pop() is .Some(at) {
		val .Ok(entries) = fs::readDir(at.toStr()) else {
			panic("a directory")
		}
		for entry in entries {
			val page = path::join(at.toStr(), entry.name.toStr())
			if entry.isDirectory() {
				stack.push(move page)
			} else if path::extension(page.toStr()) == .Some("html") {
				val .Ok(text) = fs::readFile(page.toStr()) else {
					panic("a page")
				}
				var ids: Vec<String> = Vec()
				for (i, piece) in text.split("id=\"").enumerate() {
					if i > 0 then ids.push(String::of(attributeValue(piece)))
				}
				files.push((move page, move text, move ids))
			}
		}
	}
	val pages = move files
	for (page, text, _) in pages {
		for (i, piece) in text.split("href=\"").enumerate() {
			if i == 0 then continue
			val href = attributeValue(piece)
			val (target, anchor) = match href.splitOnce("#") {
				.Some(parts) => parts
				.None => (href, "")
			}
			val file =
				if target.isEmpty() then page.clone()
				else normalize(path::join(path::parent(page.toStr()), target).toStr())
			assert(fs::exists(file.toStr()), "\(page) links to \(href), which is not there")
			if anchor.isEmpty() then continue
			val wanted = String::of(anchor)
			for (other, _, ids) in pages {
				if other == file then
					assert(
						ids.contains(&wanted),
						"\(page) links to \(href), which has no such anchor",
					)
			}
		}
	}
}

/// What a piece of a page holds up to the quote that ends an attribute's
/// value.
fn attributeValue(piece: str): str = match piece.find("\"") {
	.Some(end) => piece[0..end]
	.None => piece
}

/// A path with its `..` steps taken.
fn normalize(given: str): String = {
	var parts: Vec<str> = Vec()
	for part in given.split("/") {
		if part == ".." then parts.pop() else parts.push(part)
	}
	return parts.join("/")
}
