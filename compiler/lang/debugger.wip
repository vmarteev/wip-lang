// `wip debug`: the debugger, with the scripts that show Wip's values as they
// are meant — a `Vec` as its elements, an enum as the variant it holds. The
// scripts are part of the compiler, as the standard library is, so they read
// the layouts of the compiler that built the program; they are in its home,
// beside the library.

import std::path
import std::process::{Command}

/// A debugger the scripts are written for.
@derive(Eq, Clone)
pub enum Debugger {
	Lldb
	Gdb
}

extend Debugger {
	/// The one a system's own compiler comes with: lldb on a Mac, gdb
	/// elsewhere.
	pub static fn native(): Debugger = if TARGET_VENDOR == "apple" then .Lldb else .Gdb
}

/// Where the scripts are.
pub struct Scripts {
	pub lldb: String
	pub gdb: String
}

/// The scripts, in the compiler's home.
pub fn scripts(): Result<Scripts, String> = {
	val home = findHome()?
	val dir = path::join(home, "tools/debugger")
	val scripts = Scripts(lldb: path::join(dir, "wip_lldb.py"), gdb: path::join(dir, "wip_gdb.py"))
	if !isFile(scripts.lldb) || !isFile(scripts.gdb) then
		return .Err("the debugger's scripts are not in `\(dir)`")
	return .Ok(move scripts)
}

/// `debugger` started on `program`, which is given `args`, with the scripts
/// loaded, and waited for: its exit code, or why it could not be run.
pub fn debug(debugger: Debugger, program: str, args: &[str]): Result<i64, String> = {
	val scripts = scripts()?
	val loading = "command script import \(scripts.lldb)"
	val tool = if debugger == .Lldb then "lldb" else "gdb"
	val command = match debugger {
		.Lldb => Command::of(tool).args(["-o", loading.toStr(), "--", program])
		.Gdb => Command::of(tool).args(["-x", scripts.gdb.toStr(), "--args", program])
	}
	return match command.args(&args).run() {
		.Ok(.Code(code)) => .Ok(code)
		.Ok(..) => .Ok(1)
		.Err(error) => .Err("cannot run `\(tool)`: \(error)")
	}
}
