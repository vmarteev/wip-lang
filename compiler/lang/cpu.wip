// The processor a program is built for: by default, every one of its kind
// that the systems Wip runs on still run on, so that a program built on one
// machine runs on another; or the compiling machine itself, or a level
// named.

/// Which processors the code may run on.
@derive(Eq, Clone)
pub enum Cpu {
	/// The baseline of the host's kind of processor: `Level::baseline`.
	Baseline
	/// The compiling machine, with every feature it has: the program may not
	/// run on another.
	Native
	/// A level named.
	Level(level: Level)
}

/// A level of a kind of processor: the features a program may use, as
/// compilers name them.
@derive(Eq, Clone)
pub enum Level {
	/// Every x86-64 processor: SSE2.
	X86_64
	/// x86-64 from Intel's Nehalem (2008) and AMD's Bulldozer (2011) on:
	/// SSE4.2 and POPCNT.
	X86_64V2
	/// x86-64 from 2013 on (Haswell, Excavator): AVX2, BMI, LZCNT and FMA.
	X86_64V3
	/// x86-64 with AVX-512.
	X86_64V4
	/// Every 64-bit Arm processor.
	Armv8_0
	/// Arm from v8.1 on: the atomic instructions of LSE.
	Armv8_1
	/// Apple's processors, from the M1 on.
	AppleM1
}

extend Level {
	/// What a level is called, as `--cpu` takes it and as C compilers name
	/// it.
	pub fn name(): str = match self {
		.X86_64 => "x86-64"
		.X86_64V2 => "x86-64-v2"
		.X86_64V3 => "x86-64-v3"
		.X86_64V4 => "x86-64-v4"
		.Armv8_0 => "armv8.0"
		.Armv8_1 => "armv8.1"
		.AppleM1 => "apple-m1"
	}

	/// The levels of the host's kind of processor, oldest first.
	pub static fn ofHost(): Vec<Level> = {
		var levels: Vec<Level> = Vec()
		if TARGET_ARCH == "x86_64" {
			levels.push(.X86_64)
			levels.push(.X86_64V2)
			levels.push(.X86_64V3)
			levels.push(.X86_64V4)
		} else if TARGET_ARCH == "arm64" {
			levels.push(.Armv8_0)
			levels.push(.Armv8_1)
			levels.push(.AppleM1)
		}
		return move levels
	}

	/// The level a program is built for when nothing says otherwise: on
	/// x86-64, v2, which every x86-64 processor since Nehalem and Bulldozer
	/// has, and which Windows 11 and Red Hat's systems require; on a Mac with
	/// Apple silicon, the M1, which every such Mac has; on other Arm systems,
	/// v8.0, which the Raspberry Pi 4 and the first Graviton are.
	pub static fn baseline(): Option<Level> = {
		if TARGET_ARCH == "x86_64" then return .Some(.X86_64V2)
		if TARGET_ARCH == "arm64" && TARGET_VENDOR == "apple" then return .Some(.AppleM1)
		if TARGET_ARCH == "arm64" then return .Some(.Armv8_0)
		return .None
	}
}

extend Cpu {
	/// What `--cpu` says: `native`, `baseline`, or a level of the host's
	/// kind of processor.
	pub static fn parse(text: str): Result<Cpu, String> = {
		if text == "native" then return .Ok(.Native)
		if text == "baseline" then return .Ok(.Baseline)
		val levels = Level::ofHost()
		for level in levels {
			if level.name() == text then return .Ok(.Level(level.clone()))
		}
		var names = String::of("baseline, native")
		for level in levels {
			names.push(", \(level.name())")
		}
		return .Err("`\(text)` is not a processor this compiler builds for; it takes \(names)")
	}

	/// The level this is, where it is one: the baseline's, or the one named.
	/// The compiling machine's is not a level.
	pub fn level(): Option<Level> = match self {
		.Baseline => Level::baseline()
		.Native => .None
		.Level(level) => .Some(level.clone())
	}
}
