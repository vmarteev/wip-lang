// How long each phase of a build took.

import std::time::{Duration, Instant}

@test
fn aPhaseThatRunsAgainAddsToItsFirstEntry() = {
	var timings = Timings()
	val started = Instant::now()
	timings.record("lex", started)
	timings.record("parse", started)
	timings.record("lex", started)
	assert(timings.phases.len() == 2)
	assert(timings.phases[0].0 == "lex" && timings.phases[1].0 == "parse")
	assert(timings.total() == timings.get("lex") + timings.get("parse"))
	assert(timings.get("link").isZero())
}

@test
fn eachPhaseIsALineInMilliseconds() = {
	val timings = Timings(phases: Vec::of(own [(String::of("read"), Duration::micros(1250))]))
	assert(timings.toString() == "read               1.2 ms\ntotal              1.2 ms\n")
}
