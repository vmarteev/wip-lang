// The table a panic reads to say the calls that led to it, made from the
// DWARF LLVM wrote.
//
// What the table holds — each function's code, and where each run of it was
// written — is known only once LLVM has compiled the program, and LLVM has
// inlined much of it. The table names each function by its symbol, which
// only the object that defines it may do of a function LLVM made of the
// program's, as a release build's optimising makes them, kept to the object:
// so a release build's part has a table of its own, in its own object.
//
// The object `clang` wrote is read, and the table, its relocations and its
// symbols are added to it (`withFrameTables`): after it on ELF
// (`elf.wip`), and laid out again around it in Mach-O (`macho.wip`), whose
// sections and symbols are listed where adding one moves the rest. A debug
// build changes nothing LLVM is given, and makes no functions of its own:
// one table is read from every part's DWARF, and added to the first part's
// object, which names the others' functions for the linker to find.
//
// A table is pieces the linker may keep or drop one by one. Each function
// has an entry of its own — its address, its code's length, its rows — in
// the section `wip_frames`, which references nothing but the function, so
// that a linker dropping what nothing reaches keeps the entry while it keeps
// the function: on a Mac, an entry is a piece of its own in a section marked
// `live_support`; on ELF, a release build's part ties each entry's section
// to its function's (`SHF_LINK_ORDER`). What the entries share — the files,
// the calls inlined, the names — is one piece, which an entry finds by its
// part's key, through the list.
//
// The runtime reads the list, `wip.frame_tables`, an object of its own
// (`frameListAssembly`): where the entries begin and end, and each part's
// key and shared piece. The pieces have the form the runtime reads
// (`std/prelude/runtime.wip`), with what LLVM's inlining adds: a row may say
// that its code is a call inlined, and the shared piece's list of those says
// what was called, and from which line of what.

import std::collections::{Map}

/// The runtime's own file, and the runner of the tests: their functions
/// are how a panic is told, or how a test is called, not where it happened.
val PASSED_OVER: [str; 2] = ["std/prelude/runtime.wip", "std/test/test.wip"]

/// The sections of DWARF a reader of it loads, each with its relocations.
val DEBUG_SECTIONS: [str; 16] = [
	".debug_abbrev",
	".debug_addr",
	".debug_aranges",
	".debug_info",
	".debug_line",
	".debug_line_str",
	".debug_macinfo",
	".debug_macro",
	".debug_names",
	".debug_str",
	".debug_str_offsets",
	".debug_types",
	".debug_loc",
	".debug_loclists",
	".debug_ranges",
	".debug_rnglists",
]

/// What a debug section's relocations put at each offset: an addend, and
/// whether it adds to what is written there.
fn relocationsOf(file: &Object, section: &ObjectSection): Result<Map<u64, (bool, u64)>, String> = {
	var map: Map<u64, (bool, u64)> = Map()
	for relocation in section.relocations {
		if !relocation.absolute then return .Err("a relocation of \(relocation.kind) in DWARF")
		val target: u64 = match relocation.target {
			.Symbol(index) => {
				if index >= file.symbols.len() then
					return .Err("a relocation of a symbol that is not there")
				val .Some(symbol) = file.symbols[index] else {
					return .Err("a relocation of a symbol that is not there")
				}
				address(&file, symbol.section, symbol.address)
			}
			.Section(index) => address(&file, .Some(index), 0)
			.Nothing => return .Err("a relocation in DWARF to nothing it names")
		}
		map.put(relocation.offset, (relocation.implicit, target +% relocation.addend as u64))
	}
	return .Ok(map)
}

/// An address in `section` of the object, where every section of code has a
/// place of its own: a Mach-O object's sections have theirs, and an ELF
/// object's each begin at 0, so each is given a base of its own — LLVM may put
/// a cold function in a section other than the rest. An address in any other
/// section is a distance into it, as DWARF reads one in its own sections;
/// DWARF names no other code or data.
fn address(file: &Object, section: Option<i64>, at: u64): u64 = {
	val .Some(index) = section else return at
	val .Some(found) = file.sectionAt(index) else return at
	if !found.text then return at
	return if file.format == Format::Elf then ((index as u64) << 32) + at else found.address + at
}

/// A function of the program as the DWARF describes it.
struct DwarfFunction {
	symbol: String
	name: String
	low: u64
	high: u64
	passOver: bool
}

/// A call inlined: what was called, and from where in what. Two calls inlined
/// that say the same are one in the table.
@derive(Eq, Hash, Clone)
struct Inlined {
	name: String
	passOver: bool
	file: u32
	line: u32
	/// The call inlined this one was inlined into, counting from 1; 0 for the
	/// function itself.
	parent: u32
}

/// A call inlined into the function being read: its record in the table, and
/// the code it is.
struct InlinedCall {
	record: u32
	ranges: Vec<(u64, u64)>
}

/// A row of a function's table: from `offset`, code written at `file` and
/// `line`, in the call inlined `inlined` (from 1), or in the function.
@derive(Eq, Clone)
struct Row {
	offset: u32
	file: u32
	line: u32
	inlined: u32
}

/// The first of `objects`, as `clang` compiled it, with the table of them
/// all added, its shared piece named `symbol` and its entries saying `key`:
/// read from their DWARF, which names files as `files` says a panic names
/// them. A function of another of them is named by a symbol the linker
/// finds. On ELF, where `tied` says, as for a release build's part, whose
/// functions are all its own, each entry is a section tied to its
/// function's; in Mach-O each entry is a piece of its own, after a symbol of
/// its own, in a section the linker keeps only what is live of.
pub fn withFrameTables(
	objects: &[Vec<u8>],
	files: &Map<String, String>,
	symbol: str,
	key: u64,
	tied: bool,
): Result<Vec<u8>, String> = {
	var table = Table::new()
	for object in objects {
		val file = readObject(&object)?
		read(&file, &files, &var table)?
	}
	if objects.isEmpty() then return .Err("no object to add the table to")
	val (shared, entries) = table.layout(key)
	if readObject(&objects[0])?.format == Format::Macho then
		return withMachoData(&objects[0], machoTable(&shared, &entries, symbol))
	var added = Vec::of([
		elfData(".data.rel.ro.wip.frames", &shared, .Some(String::of(symbol)), .None),
	])
	if tied {
		for entry in entries {
			added.push(elfData(ENTRIES, &entry.items, .None, .Some(entry.section)))
		}
	} else {
		var all: Vec<Item> = Vec()
		for entry in move entries {
			for item in move entry.items {
				all.push(item)
			}
		}
		added.push(elfData(ENTRIES, &all, .None, .None))
	}
	return withData(&objects[0], &added)
}

/// The list the runtime reads, `wip.frame_tables`: where the functions'
/// entries begin and end, how many parts there are, and each one's key and
/// shared piece, by its symbol; as assembly to be an object of its own. A
/// program with no entries — built without debug information — must still
/// have where they begin and end: a Mac's linker gives them for the empty
/// section the list carries, and ELF's for none, so ELF's are named weakly,
/// and are 0 where there is no section.
pub fn frameListAssembly(tables: &[(u64, String)], macho: bool): String = {
	val (start, end) =
		if macho then
			("section$start$__DATA_CONST$__wip_frames", "section$end$__DATA_CONST$__wip_frames")
		else ("__start_wip_frames", "__stop_wip_frames")
	var items: Vec<Item> = [
		Item::Address(.Symbol(String::of(start))),
		Item::Address(.Symbol(String::of(end))),
		Item::Word(tables.len() as u64),
	]
	for (key, table) in tables {
		items.push(.Word(key))
		items.push(.Address(.Symbol(if macho then "_\(table)" else table.clone())))
	}
	var out = String()
	if !macho then out.push("\t.weak\t\"\(start)\"\n\t.weak\t\"\(end)\"\n")
	out.push(assembly(&items, TABLES, macho))
	if macho then
		out.push("\t.section\t__DATA_CONST,__wip_frames,regular,live_support\n\t.p2align\t3\n")
	return out
}

/// What an object's DWARF and symbols describe, added to `table`.
fn read(file: &Object, files: &Map<String, String>, table: &var Table): Result<void, String> = {
	val macho = file.format == Format::Macho
	var sections: Map<String, DebugSection> = Map()
	for name in DEBUG_SECTIONS {
		val .Some(section) = file.section(name) else continue
		val relocations = relocationsOf(&file, &section)?
		sections.put(name, DebugSection(
			data: file.data(&section).toVec(),
			relocations: relocations,
		))
	}
	val dwarf = Dwarf(
		info: takeSection(&var sections, ".debug_info"),
		abbrev: takeSection(&var sections, ".debug_abbrev"),
		str: takeSection(&var sections, ".debug_str"),
		line: takeSection(&var sections, ".debug_line"),
		lineStr: takeSection(&var sections, ".debug_line_str"),
		ranges: takeSection(&var sections, ".debug_ranges"),
	)
	// A function's symbol, by the address of its code: the program's own, not
	// an assembler's label at the same place.
	var symbols: Map<u64, String> = Map()
	for found in file.symbols {
		val .Some(symbol) = found else continue
		if !symbol.text || symbol.undefined then continue
		val name = symbol.name.toStr()
		val temporary =
			name.isEmpty() ||
			name.startsWith(".L") ||
			macho && (name.startsWith("l") || name.startsWith("L"))
		if !temporary {
			val at = address(&file, symbol.section, symbol.address)
			if !symbols.contains(&at) then symbols.put(at, symbol.name.clone())
		}
	}
	for unit in dwarf.units()? {
		readUnit(&dwarf, &unit, &files, &symbols, &var table)?
	}
	return .Ok()
}

/// The section `name`, taken out of `sections`, or one with nothing in it.
fn takeSection(sections: &var Map<String, DebugSection>, name: str): DebugSection = {
	val key = String::of(name)
	return match sections.remove(&key) {
		.Some(section) => section
		.None => DebugSection::empty()
	}
}

struct Table {
	files: Vec<String>
	fileIndex: Map<String, u32>
	functions: Vec<(DwarfFunction, Vec<Row>)>
	inlined: Vec<Inlined>
	inlinedIndex: Map<Inlined, u32>
}

extend Table {
	static fn new(): Table = Table(
		files: Vec(),
		fileIndex: Map(),
		functions: Vec(),
		inlined: Vec(),
		inlinedIndex: Map(),
	)

	/// A call inlined's record, counting from 1.
	var fn inline(call: Inlined): u32 = {
		if self.inlinedIndex.get(&call) is .Some(index) then return index
		self.inlined.push(call.clone())
		val index = self.inlined.len() as u32
		self.inlinedIndex.put(call, index)
		return index
	}

	var fn file(name: String): u32 = {
		if self.fileIndex.get(&name) is .Some(index) then return index
		self.files.push(name.clone())
		val index = (self.files.len() - 1) as u32
		self.fileIndex.put(name, index)
		return index
	}
}

/// The table's place for the unit's file `index`, 0 where it has none.
fn fileOf(unitFiles: &Map<u64, u32>, index: u64): u32 = match unitFiles.get(&index) {
	.Some(at) => at
	.None => 0
}

fn readUnit(
	dwarf: &Dwarf,
	unit: &Unit,
	files: &Map<String, String>,
	symbols: &Map<u64, String>,
	table: &var Table,
): Result<void, String> = {
	// The unit's files, as a panic names them, in the table's list.
	var unitFiles: Map<u64, u32> = Map()
	var lines: Vec<(u64, u64, u32)> = Vec()
	if unit.lineProgram is .Some(offset) {
		val program = dwarf.lineProgram(&unit, offset)?
		var index = 0
		while true {
			// DWARF 4 counts files from 1, and 5 from 0.
			if program.file(index) is .Some(entry) {
				val name = fileName(&dwarf, &unit, &program, &entry, &files)
				val at = table.file(name)
				unitFiles.put(index, at)
			} else if index > 0 then break
			index += 1
		}
		for (address, file, line, endSequence) in program.rows {
			// The end of a sequence is the end of the code before it, and a row
			// of no line is code the compiler wrote on its own: the row before
			// it goes on.
			if endSequence || line == 0 then continue
			lines.push((address, file, line as u32))
		}
	}
	lines.sortBy((a, b) => a.0 < b.0)

	// The inlined calls open at each depth, by their index in the table's
	// list, and the function open, if one is.
	var open: Vec<(i64, u32)> = Vec()
	var function: Option<(i64, DwarfFunction, Vec<InlinedCall>)> = .None
	for entry in dwarf.entries(&unit)? {
		val depth = entry.depth
		var still: Vec<(i64, u32)> = Vec()
		for o in open {
			if o.0 < depth then still.push(o)
		}
		open = still
		val closing = match function {
			.Some((at, _, _)) => at >= depth
			.None => false
		}
		if closing {
			val .Some((_, done, calls)) = function.take() else panic("a function is open")
			finish(&var table, done, &calls, &lines, &unitFiles)
		}
		if entry.tag == DW_TAG_subprogram {
			val .Some((_, .Addr(..))) = entry.attr(DW_AT_low_pc) else continue
			val ranges = dwarf.rangesOf(&unit, &entry)
			if ranges.isEmpty() then continue
			val (low, high) = ranges[0]
			val .Some(symbol) = symbols.get(&low) else {
				// No symbol at the code's start: not a function the program can
				// name.
				continue
			}
			val (name, passOver) = described(&dwarf, &unit, &entry, &unitFiles, &table)?
			function = .Some(
				(
					depth,
					DwarfFunction(
						symbol: symbol.clone(),
						name: name,
						low: low,
						high: high,
						passOver: passOver,
					),
					Vec(),
				),
			)
		} else if entry.tag == DW_TAG_inlined_subroutine && function.isSome() {
			val (name, passOver) = described(&dwarf, &unit, &entry, &unitFiles, &table)?
			val ranges = dwarf.rangesOf(&unit, &entry)
			val callFile = match fileIndex(&entry, DW_AT_call_file) {
				.Some(index) => fileOf(&unitFiles, index)
				.None => 0
			}
			val callLine = match entry.attr(DW_AT_call_line) {
				.Some((_, value)) => udata(&value).unwrapOr(0) as u32
				.None => 0
			}
			val parent = if open.isEmpty() then 0 else open[open.len() - 1].1
			val record = table.inline(Inlined(
				name: name,
				passOver: passOver,
				file: callFile,
				line: callLine,
				parent: parent,
			))
			open.push((depth, record))
			if function.take() is .Some((at, f, var more)) {
				more.push(InlinedCall(record: record, ranges: ranges))
				function = .Some((at, f, more))
			}
		}
	}
	if function.take() is .Some((_, done, calls)) then
		finish(&var table, done, &calls, &lines, &unitFiles)
	return .Ok()
}

/// A file's name as a panic gives it, from the line program's entry.
fn fileName(
	dwarf: &Dwarf,
	unit: &Unit,
	program: &LineProgram,
	entry: &FileEntry,
	files: &Map<String, String>,
): String = {
	val name = dwarf.string(&entry.name)
	if files.get(&name) is .Some(shown) then return shown.clone()
	val directory = match program.directory(&entry, &unit) {
		.Some(value) => dwarf.string(&value)
		.None => String()
	}
	val path = "\(directory)/\(name)"
	return match files.get(&path) {
		.Some(shown) => shown.clone()
		.None => name
	}
}

/// A subprogram's name, and whether a panic's calls pass over it: code the
/// compiler wrote on its own, or the runtime's, which tells the panic. An
/// entry that is a call inlined, or a function also inlined elsewhere, is
/// described by the one it is an instance of.
fn described(
	dwarf: &Dwarf,
	unit: &Unit,
	given: &Die,
	unitFiles: &Map<u64, u32>,
	table: &Table,
): Result<(String, bool), String> = {
	var entry = Die(
		offset: given.offset,
		depth: given.depth,
		tag: given.tag,
		attrs: given.attrs.clone(),
	)
	while true {
		val first = entry.attr(DW_AT_abstract_origin)
		val origin = if first.isSome() then first else entry.attr(DW_AT_specification)
		match origin {
			.Some((_, .UnitRef(offset))) => entry = dwarf.entryAt(&unit, offset)?
			_ => break
		}
	}
	val name = match entry.attr(DW_AT_name) {
		.Some((_, value)) => dwarf.string(&value)
		.None => String()
	}
	val artificial = entry.attr(DW_AT_artificial) is .Some((_, .Flag(true)))
	val runtime = match fileIndex(&entry, DW_AT_decl_file) {
		.Some(index) => PASSED_OVER.contains(table.files[fileOf(&unitFiles, index)].toStr())
		.None => false
	}
	return .Ok((name, artificial || runtime))
}

/// The line program's index of the file an attribute names.
fn fileIndex(entry: &Die, at: u64): Option<u64> = match entry.attr(at) {
	.Some((_, value)) => udata(&value)
	.None => .None
}

/// A constant attribute's value, where it is one that is not negative.
fn udata(value: &FormValue): Option<u64> = match value {
	.Data(n) => .Some(n)
	.Signed(n) if n >= 0 => .Some(n as u64)
	_ => .None
}

/// The first of `lines` at or past `low`: how many are before it.
fn partition(lines: &[(u64, u64, u32)], before: u64, inclusive: bool): i64 = {
	var lo = 0
	var hi = lines.len()
	while lo < hi {
		val mid = (lo + hi) / 2
		val address = lines[mid].0
		val goesBefore = if inclusive then address <= before else address < before
		if goesBefore then lo = mid + 1 else hi = mid
	}
	return lo
}

/// A function's rows: where the line or the call inlined changes, the line,
/// and the innermost call inlined there.
fn finish(
	table: &var Table,
	function: DwarfFunction,
	calls: &[InlinedCall],
	lines: &[(u64, u64, u32)],
	unitFiles: &Map<u64, u32>,
) = {
	val low = function.low
	val high = function.high
	var points: Vec<u64> = [low]
	val first = partition(&lines, low, false)
	for i in first..lines.len() {
		if lines[i].0 >= high then break
		points.push(lines[i].0)
	}
	for call in calls {
		for (begin, end) in call.ranges {
			if begin >= low && begin < high then points.push(begin)
			if end >= low && end < high then points.push(end)
		}
	}
	points.sort()
	points.dedup()
	var rows: Vec<Row> = Vec()
	for at in points {
		val line = partition(&lines, at, true)
		if line == 0 || lines[line - 1].0 < low then continue
		val (_, file, number) = lines[line - 1]
		// The innermost: a call inlined comes after the one it is in.
		var inlined: u32 = 0
		var c = calls.len()
		while c > 0 {
			c -= 1
			var holds = false
			for (begin, end) in calls[c].ranges {
				if begin <= at && at < end then holds = true
			}
			if holds {
				inlined = calls[c].record
				break
			}
		}
		val row = Row(
			offset: (at - low) as u32,
			file: fileOf(&unitFiles, file),
			line: number,
			inlined: inlined,
		)
		if !rows.isEmpty() {
			val last = &rows[rows.len() - 1]
			if last.file == row.file && last.line == row.line && last.inlined == row.inlined then
				continue
		}
		rows.push(move row)
	}
	table.functions.push((function, rows))
}

/// The name of the list of the tables, which the runtime reads.
val TABLES: str = "wip.frame_tables"

/// The section of the functions' entries, which ELF's linker gives a start
/// and an end where its name is a C name.
val ENTRIES: str = "wip_frames"

/// A function's entry: what it holds, and in an ELF object the section of
/// its function's code, which a release build's entry is tied to.
struct FrameEntry {
	section: u32
	items: Vec<Item>
}

/// What the list, a table's shared piece and an entry are, in order: words,
/// addresses, rows' `u32`s and names' bytes.
enum Item {
	Word(word: u64)
	Address(target: Target)
	U32(word: u32)
	Text(bytes: Vec<u8>)
}

/// What an address is of.
@derive(Clone)
enum Target {
	/// A function, a table or a section's bound, by its symbol as the object
	/// names it.
	Symbol(name: String)
	/// A place in the piece, by its distance from its start.
	Here(at: u64)
}

/// Each name once, however many say it: their bytes, and where each begins.
struct TableNames {
	at: u64
	bytes: Vec<u8>
	named: Map<String, u64>
}

extend TableNames {
	/// Where `text` is in the piece, written there where it is not yet.
	var fn place(text: str): u64 = {
		val key = String::of(text)
		if self.named.get(&key) is .Some(found) then return found
		val found = self.at + self.bytes.len() as u64
		for i in 0..text.len() {
			self.bytes.push(text[i])
		}
		self.named.put(key, found)
		return found
	}

	/// `text`'s address, in the piece.
	var fn name(text: str): Item = .Address(.Here(self.place(text)))

	/// `text`'s distance from where the names begin: what an entry, which
	/// references nothing but its function, holds of its name.
	var fn offset(text: str): u64 = self.place(text) - self.at
}

extend Table {
	/// The table as its pieces: what the entries share — three words, two for
	/// each file, six for each call inlined, and the names — and each
	/// function's entry, saying the key of its part, `key`: seven words, and
	/// sixteen bytes for each row.
	fn layout(key: u64): (Vec<Item>, Vec<FrameEntry>) = {
		val files = 24
		val inlined = files + 16 * self.files.len() as u64
		val namesAt = inlined + 48 * self.inlined.len() as u64
		var names = TableNames(at: namesAt, bytes: Vec(), named: Map())
		var shared: Vec<Item> = [
			Item::Address(.Here(files)),
			Item::Address(.Here(inlined)),
			Item::Address(.Here(namesAt)),
		]
		for file in self.files {
			shared.push(names.name(file))
			shared.push(.Word(file.len() as u64))
		}
		// A call inlined: what was called, its name's length, the file and
		// line of the call, the call it is in, and whether it is passed over.
		for call in self.inlined {
			shared.push(names.name(call.name))
			shared.push(.Word(call.name.len() as u64))
			shared.push(.Word(call.file))
			shared.push(.Word(call.line))
			shared.push(.Word(call.parent))
			shared.push(.Word(if call.passOver then 1 else 0))
		}
		// A function: its code and its length, its part, its name and the
		// name's length, whether it is passed over, and its rows.
		var entries: Vec<FrameEntry> = Vec()
		for (function, rows) in self.functions {
			var items: Vec<Item> = [
				Item::Address(.Symbol(function.symbol.clone())),
				Item::Word(function.high - function.low),
				Item::Word(key),
				Item::Word(names.offset(function.name)),
				Item::Word(function.name.len() as u64),
				Item::Word(if function.passOver then 1 else 0),
				Item::Word(rows.len() as u64),
			]
			for row in rows {
				items.push(.U32(row.offset))
				items.push(.U32(row.file))
				items.push(.U32(row.line))
				items.push(.U32(row.inlined))
			}
			// An ELF object's code is placed by its section, above the
			// distance into it.
			entries.push(FrameEntry(section: (function.low >> 32) as u32, items: items))
		}
		shared.push(.Text(names.bytes))
		return (shared, entries)
	}
}

/// A table's shared piece or the list as assembly, in the program's data,
/// named `symbol`.
fn assembly(items: &[Item], symbol: str, macho: bool): String = {
	val named = if macho then "\"_\(symbol)\"" else "\"\(symbol)\""
	var out = String::of("\n")
	if macho {
		out.push("\t.section\t__DATA,__const\n")
		out.push("\t.private_extern\t\(named)\n")
	} else {
		out.push("\t.section\t.data.rel.ro,\"aw\",@progbits\n")
		out.push("\t.hidden\t\(named)\n")
	}
	out.push("\t.globl\t\(named)\n\t.p2align\t3\n\(named):\n")
	itemsAssembly(&var out, &items, named)
	return out
}

/// `items` as assembly, at the end of `out`: a place in the piece is a
/// distance from `named`, its symbol as the assembly writes it.
fn itemsAssembly(out: &var String, items: &[Item], named: str) = {
	for item in items {
		match item {
			.Word(word) => out.push("\t.quad\t\(word)\n")
			// A symbol is as the object names it, `_` and all.
			.Address(.Symbol(name)) => out.push("\t.quad\t\"\(name)\"\n")
			.Address(.Here(at)) => out.push("\t.quad\t\(named)+\(at)\n")
			.U32(word) => out.push("\t.long\t\(word)\n")
			.Text(bytes) => out.push("\t.ascii\t\"\(ascii(&bytes))\"\n")
		}
	}
}

/// `items` as a section of an ELF object named `name`: its bytes, and an
/// address of each function it names and of each place in it it points to,
/// with the hidden `symbol` at its start where it has one, tied to the
/// section `tiedTo` where it is.
fn elfData(name: str, items: &[Item], symbol: Option<String>, tiedTo: Option<u32>): Data = {
	var bytes: Vec<u8> = Vec()
	var addresses: Vec<(u64, Address)> = Vec()
	itemBytes(&items, &var bytes, &var addresses)
	return Data(
		name: String::of(name),
		bytes: bytes,
		symbol: symbol,
		addresses: addresses,
		tiedTo: tiedTo,
	)
}

/// A table as the two sections of a Mach-O object that hold it: the shared
/// piece, named `symbol`, in `__DATA,__const`; and the entries, each after
/// a linker-private symbol of its own, `lwip.frame_entry.N`, that makes it a
/// piece of its own, in `__DATA_CONST,__wip_frames`, which the linker keeps
/// only the pieces of that keep something live (`live_support`).
fn machoTable(shared: &[Item], entries: &[FrameEntry], symbol: str): Vec<MachoData> = {
	var sharedBytes: Vec<u8> = Vec()
	var sharedAddresses: Vec<(u64, Address)> = Vec()
	itemBytes(&shared, &var sharedBytes, &var sharedAddresses)
	var bytes: Vec<u8> = Vec()
	var addresses: Vec<(u64, Address)> = Vec()
	var labels: Vec<(u64, String)> = Vec()
	for (n, entry) in entries.forwards().enumerate() {
		while bytes.len() % 8 != 0 {
			bytes.push(0)
		}
		labels.push((bytes.len() as u64, "lwip.frame_entry.\(n)"))
		itemBytes(&entry.items, &var bytes, &var addresses)
	}
	return [
		MachoData(
			segment: "__DATA",
			section: "__const",
			flags: 0,
			align: 3,
			bytes: sharedBytes,
			symbol: .Some(String::of(symbol)),
			labels: Vec(),
			addresses: sharedAddresses,
		),
		MachoData(
			segment: "__DATA_CONST",
			section: "__wip_frames",
			flags: S_ATTR_LIVE_SUPPORT,
			align: 3,
			bytes: bytes,
			symbol: .None,
			labels: labels,
			addresses: addresses,
		),
	]
}

/// `items`' bytes at the end of `bytes`, and where an address goes in them,
/// and of what, at the end of `addresses`: a place in the piece is a
/// distance from where the piece begins.
fn itemBytes(items: &[Item], bytes: &var Vec<u8>, addresses: &var Vec<(u64, Address)>) = {
	val start = bytes.len() as u64
	for item in items {
		match item {
			.Word(word) => pushWord(&var bytes, word)
			.Address(target) => {
				val address: Address = match target {
					.Symbol(name) => .Symbol(name.clone())
					.Here(at) => .Here(start + at)
				}
				addresses.push((bytes.len() as u64, address))
				pushWord(&var bytes, 0)
			}
			.U32(word) => pushHalfWord(&var bytes, word)
			.Text(text) => {
				for b in text {
					bytes.push(b)
				}
			}
		}
	}
}

/// Bytes as an assembler's `.ascii` takes them.
fn ascii(text: &[u8]): String = {
	var out = String()
	for byte in text {
		match byte {
			b'"' | b'\\' => {
				out.pushByte(b'\\')
				out.pushByte(byte)
			}
			0x20..=0x7e => out.pushByte(byte)
			_ => {
				out.pushByte(b'\\')
				out.pushByte(b'0' + (byte >> 6))
				out.pushByte(b'0' + ((byte >> 3) & 7))
				out.pushByte(b'0' + (byte & 7))
			}
		}
	}
	return out
}
