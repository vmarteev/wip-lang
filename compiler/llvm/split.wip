// A program as parts, each an LLVM module of its own that `clang` compiles
// at once with the others, and that the cache keeps on its own.
//
// At `-O0` nothing is inlined, so where a function goes changes nothing it
// does. At `-O2` a part inlines only what it has the body of, and Wip's code
// is made of small functions, which a call into another part would leave
// calls; so in a release build a part also has a copy of each small
// function of another part that it names, and of each that those name, as
// LLVM's `available_externally`: a body to inline, never emitted, the
// definition being the other part's. A function in a cycle of calls is
// inlined nowhere, and is not copied. A function no other part names is kept
// to its part, as one module keeps its functions, so that LLVM may drop it
// once every call is inlined, or change how it is called. The functions are taken file by file, in the order each file's were
// defined, and cut into parts of about a megabyte of text: each part is a
// `clang` started, which costs as much as compiling a part a third that size,
// and a smaller part is compiled again sooner after an edit, which changes
// every line after it in its file. Where a part ends is decided by what is in
// it, not by its place in the program, as rsync cuts a file into blocks:
// after a function whose symbol's hash says so, once the part is large
// enough, or where it is too large to go on. An edit changes the part it is
// in, and the parts after it are cut where they were. Each part has what its
// functions name: the program's data, its own copy of each constant, and the
// metadata they reach; a function of another part is declared, which its
// hidden linkage lets the linker find.
//
// A part is all that its object depends on, so it says nothing of the rest
// of the program: its constants and its metadata are numbered in the order
// its text names them, not as the whole program numbered them, and an edit to
// one file leaves the other files' parts as they were. Each function moves
// into its part, which a program's millions of instructions make worth more
// than a copy.

import std::collections::{Map, Set}
import std::future
import std::mem

/// How much of the functions' text, as `Function.size` reckons it, a part
/// holds before it may end: enough that starting `clang` is a small part of
/// the work.
val LEAST: i64 = 512 << 10

/// How much it holds before it must end, so that a large program is compiled
/// on several cores.
val MOST: i64 = 1 << 20

/// One function in this many, by its symbol's hash, may end a part.
val ENDS: u64 = 16

/// How many instructions a function of another part is at most, for a part
/// of a release build to copy it: fewer, and too little is inlined for the
/// program to run as fast as one module; more, and the parts grow, and the
/// build slows, with the program no faster.
val COPIED: i64 = 250

/// The program's parts, each a module of its own: the function `i` of
/// `whole` was written in `files[i]`. Where `copies` says, as for a release
/// build, each part has a copy of the small functions of others it names.
fn split(whole: Module, files: &[String], copies: bool): Vec<Module> = {
	var module = whole
	var byFile: Map<String, Vec<i64>> = Map()
	for (index, file) in files.forwards().enumerate() {
		byFile.atOrPut(file.clone(), Vec()).push(index)
	}
	var names: Vec<String> = Vec()
	for entry in byFile {
		names.push(entry.key.clone())
	}
	names.sort()
	var parts: Vec<Vec<i64>> = Vec()
	var size = 0
	var part: Vec<i64> = Vec()
	for name in names {
		for index in byFile.at(&name) {
			val function = &module.functions[index]
			size += function.size()
			part.push(index)
			val ends = hash(module.names[function.symbol]) % ENDS == 0
			if size >= LEAST && ends || size >= MOST {
				parts.push(part)
				part = Vec()
				size = 0
			}
		}
	}
	if !part.isEmpty() then parts.push(part)
	// Where each function is defined, and how another part declares it.
	var defined: Map<u32, (i64, Declaration)> = Map()
	for (at, functions) in parts.forwards().enumerate() {
		for index in functions {
			val function = &module.functions[index]
			defined.put(function.symbol, (at, function.declaration()))
		}
	}
	// Each constant of the program's, by its name's number.
	var data: Map<u32, i64> = Map()
	for (index, global) in module.data.forwards().enumerate() {
		data.put(global.name, index)
	}
	// The functions a part may copy, by their symbols.
	var copyable: Map<u32, Function> = Map()
	if copies {
		for function in module.functions {
			if !function.inCycle && function.instructions() <= COPIED then
				copyable.put(function.symbol, function.clone())
		}
	}
	// Each function to its part, in the part's order.
	var taken: Vec<Option<Function>> = Vec()
	for function in mem::replace(&var module.functions, Vec()) {
		taken.push(.Some(function))
	}
	var works: Vec<PartWork> = Vec()
	for (at, indices) in parts.forwards().enumerate() {
		var functions: Vec<Function> = Vec()
		for index in indices {
			val .Some(function) = mem::replace(&var taken[index], .None) else {
				panic("a function is in one part")
			}
			functions.push(function)
		}
		var symbols: Vec<u32> = Vec()
		for function in functions {
			symbols.push(function.symbol)
		}
		works.push(PartWork(
			at: at,
			functions: functions,
			symbols: symbols,
			named: Vec(),
			made: .None,
		))
	}
	// Each part made on a thread: they share only what they read.
	future::each(&var works, (work) => {
		var writing = PartWriter::new(&module, &data, &defined, &copyable, work.at)
		work.made = .Some(writing.part(mem::replace(&var work.functions, Vec())))
		work.named = mem::replace(&var writing.others, Vec())
	})
	// What another part names, it declares or copies; the rest of a release
	// build's functions are their own part's.
	var namedElsewhere: Set<u32> = Set()
	for work in works {
		for symbol in work.named {
			namedElsewhere.add(symbol)
		}
	}
	var made: Vec<Module> = Vec()
	for work in move works {
		var .Some(written) = work.made else panic("every part is made")
		if copies {
			for (i, symbol) in work.symbols.forwards().enumerate() {
				if written.functions[i].linkage == Linkage::Hidden &&
					!namedElsewhere.contains(&symbol) {
					written.functions[i].linkage = .Internal
				}
			}
		}
		made.push(written)
	}
	return made
}

/// A part to be made: its number, its functions and their symbols, the
/// functions of other parts it names, and the module made of them.
struct PartWork {
	at: i64
	functions: Vec<Function>
	symbols: Vec<u32>
	named: Vec<u32>
	made: Option<Module>
}

/// FNV-1a: a hash of `text` that is the same on every machine and in every
/// build of the compiler.
fn hash(text: str): u64 = {
	var hash: u64 = 0xcbf29ce484222325
	for i in 0..text.len() {
		hash = (hash ^ text[i]) *% 0x00000100000001b3
	}
	return hash
}

/// One part as it is made: what its functions name, numbered in the order
/// its text names them.
view struct PartWriter {
	whole: &Module
	/// Each constant of the program's, by its name's number.
	wholeData: &Map<u32, i64>
	defined: &Map<u32, (i64, Declaration)>
	/// The functions a part may copy, by the program's numbers.
	copyable: &Map<u32, Function>
	at: i64
	/// The part's names, by its own numbers.
	names: Vec<String>
	/// Each of the program's numbers the part names, with its own.
	numbers: Map<u32, u32>
	/// The program's constants it names, in order.
	dataOrder: Vec<i64>
	/// Each node it reaches, by the program's number, with its own.
	nodes: Map<i64, i64>
	nodeOrder: Vec<i64>
	/// The functions of other parts it calls or names, by its own numbers.
	declared: Map<u32, Declaration>
	/// The functions of other parts it copies, by the program's numbers, in
	/// the order its text names them.
	copied: Vec<u32>
	/// The functions of other parts it names, copied or declared, by the
	/// program's numbers.
	others: Vec<u32>
}

extend PartWriter {
	static fn new(
		whole: &Module,
		wholeData: &Map<u32, i64>,
		defined: &Map<u32, (i64, Declaration)>,
		copyable: &Map<u32, Function>,
		at: i64,
	): PartWriter = PartWriter(
		whole: &whole,
		wholeData: &wholeData,
		defined: &defined,
		copyable: &copyable,
		at: at,
		names: Vec(),
		numbers: Map(),
		dataOrder: Vec(),
		nodes: Map(),
		nodeOrder: Vec(),
		declared: Map(),
		copied: Vec(),
		others: Vec(),
	)

	/// The part of `functions`: the functions, then the copies of others',
	/// then the constants they name, the compile unit and the flags, and the
	/// nodes, each numbered as it is first named.
	var fn part(functions: Vec<Function>): Module = {
		val whole = self.whole
		var defined: Vec<Function> = Vec()
		for function in move functions {
			defined.push(self.function(function))
		}
		// A copy may name more to copy, and a constant may name a function
		// to copy — a table of methods — and a copy a constant, so each is
		// taken in turn until neither names anything new.
		var data: Vec<Global> = Vec()
		var nextCopy = 0
		var nextData = 0
		while nextCopy < self.copied.len() || nextData < self.dataOrder.len() {
			while nextCopy < self.copied.len() {
				val .Some(original) = self.copyable.get(&self.copied[nextCopy]) else {
					panic("what is copied is copyable")
				}
				nextCopy += 1
				var copy = self.function(original.clone())
				copy.linkage = .AvailableExternally
				defined.push(copy)
			}
			while nextData < self.dataOrder.len() {
				val global = whole.data[self.dataOrder[nextData]].clone()
				nextData += 1
				data.push(self.global(global))
			}
		}
		val unit = self.node(whole.unit)
		val flags = (self.node(whole.flags.0), self.node(whole.flags.1))
		var nodes: Vec<Node> = Vec()
		var at = 0
		while at < self.nodeOrder.len() {
			val node = whole.nodes[self.nodeOrder[at]].clone()
			at += 1
			nodes.push(self.renumbered(node))
		}
		var declared: Vec<Declared> = Vec()
		for item in whole.declared {
			declared.push(
				match item {
					.Function(declaration) => {
						var renamed = declaration.clone()
						renamed.symbol = self.named(declaration.symbol)
						Declared::Function(renamed)
					}
					.Global(global) => Declared::Global(self.global(global.clone()))
				},
			)
		}
		var mine: Vec<(String, Declaration)> = Vec()
		for entry in self.declared {
			mine.push((entry.value.text(&self.names), entry.value.clone()))
		}
		mine.sortBy((a, b) => a.0 < b.0)
		for (_, declaration) in move mine {
			declared.push(.Function(declaration))
		}
		// The program's variables are defined once, in the first part, and
		// declared in the others.
		var globals: Vec<Global> = Vec()
		for global in whole.globals {
			var renamed = self.global(global.clone())
			if self.at != 0 then renamed.init = .None
			globals.push(renamed)
		}
		return Module(
			heading: "; A part of a program, written by wip's LLVM backend.",
			names: mem::replace(&var self.names, Vec()),
			data: data,
			globals: globals,
			declared: declared,
			functions: defined,
			groups: whole.groups.clone(),
			unit: unit,
			flags: flags,
			nodes: nodes,
		)
	}

	/// This part's number for what the program numbers `global`: a constant
	/// renamed as the part's own, and another part's function declared.
	var fn named(global: u32): u32 = {
		if self.numbers.get(&global) is .Some(mine) then return mine
		val constant = self.wholeData.get(&global)
		val name = match constant {
			.Some(index) => {
				val written = "@\"wip.data.\(self.dataOrder.len())\""
				self.dataOrder.push(index)
				written
			}
			.None => self.whole.names[global].clone()
		}
		val mine = self.names.len() as u32
		self.names.push(name)
		self.numbers.put(global, mine)
		if constant.isNone() &&
			self.defined.get(&global) is .Some((part, declaration)) &&
			part != self.at {
			self.others.push(global)
			if self.copyable.contains(&global) then self.copied.push(global) else {
				var declared = declaration.clone()
				declared.symbol = mine
				self.declared.put(mine, declared)
			}
		}
		return mine
	}

	/// This part's number for the program's node `node`.
	var fn node(node: i64): i64 = {
		// None, which a module without debug information says by -1.
		if node < 0 then return node
		if self.nodes.get(&node) is .Some(mine) then return mine
		val mine = self.nodeOrder.len()
		self.nodes.put(node, mine)
		self.nodeOrder.push(node)
		return mine
	}

	var fn nodeOf(node: Option<i64>): Option<i64> = node.map((n) => self.node(n))

	/// A global of the program's, as this part names it and what it names.
	var fn global(global: Global): Global = {
		var renamed = global
		renamed.name = self.named(renamed.name)
		renamed.init = renamed.init.map((init) => self.constant(init))
		return renamed
	}

	var fn constant(constant: Constant): Constant = match move constant {
		.Address(global) => .Address(self.named(global))
		.Packed(fields) => {
			var renamed: Vec<Constant> = Vec()
			for field in move fields {
				renamed.push(self.constant(field))
			}
			.Packed(renamed)
		}
		.Array(elements) => {
			var renamed: Vec<Constant> = Vec()
			for element in move elements {
				renamed.push(self.constant(element))
			}
			.Array(renamed)
		}
		other => other
	}

	/// A function as this part names what it names.
	var fn function(function: Function): Function = {
		var renamed = function
		renamed.symbol = self.named(renamed.symbol)
		renamed.subprogram = self.node(renamed.subprogram)
		var blocks: Vec<Block> = Vec()
		for block in mem::replace(&var renamed.blocks, Vec()) {
			var instructions: Vec<Instruction> = Vec()
			for instruction in move block.instructions {
				instructions.push(self.instruction(instruction))
			}
			blocks.push(Block(label: block.label.clone(), instructions: instructions))
		}
		renamed.blocks = blocks
		return renamed
	}

	var fn instruction(instruction: Instruction): Instruction = {
		var renamed = instruction
		renamed.op = self.op(renamed.op)
		renamed.at = self.nodeOf(renamed.at)
		return renamed
	}

	var fn value(value: Value): Value = match move value {
		.Global(index) => .Global(self.named(index))
		other => other
	}

	var fn typedValue(given: Val): Val = {
		var renamed = given
		renamed.v = self.value(renamed.v)
		return renamed
	}

	/// An instruction's operands and nodes, in the order its text names
	/// them.
	var fn op(op: Op): Op = match move op {
		.Load(t, address, align, assumes) => {
			val from = self.value(address)
			val facts: Assumes = match assumes {
				.Nothing => .Nothing
				.Reference(nonnull, align: aligned) => {
					val first = self.node(nonnull)
					Assumes::Reference(nonnull: first, align: self.node(aligned))
				}
				.Invariant(node) => .Invariant(self.node(node))
				.Range(node) => .Range(self.node(node))
			}
			Op::Load(t: t, address: from, align: align, assumes: move facts)
		}
		.LoadAtomic(t, address, align, order) => .LoadAtomic(
			t: t,
			address: self.value(address),
			align: align,
			order: order,
		)
		.Store(value, address, align) => {
			val stored = self.typedValue(value)
			Op::Store(value: stored, address: self.value(address), align: align)
		}
		.StoreAtomic(value, address, align, order) => {
			val stored = self.typedValue(value)
			Op::StoreAtomic(value: stored, address: self.value(address), align: align, order: order)
		}
		.Offset(base, offset) => {
			val from = self.value(base)
			Op::Offset(base: from, offset: self.value(offset))
		}
		.Arithmetic(op, wrap, left, right) => {
			val first = self.typedValue(left)
			Op::Arithmetic(op: op, wrap: wrap, left: first, right: self.value(right))
		}
		.FNeg(value) => .FNeg(self.typedValue(value))
		.IntCompare(cond, left, right) => {
			val first = self.typedValue(left)
			Op::IntCompare(cond: cond, left: first, right: self.value(right))
		}
		.FloatCompare(cond, left, right) => {
			val first = self.typedValue(left)
			Op::FloatCompare(cond: cond, left: first, right: self.value(right))
		}
		.Cast(cast, value, to) => .Cast(cast: cast, value: self.typedValue(value), to: to)
		.Select(select) => {
			val c = self.value(select.condition.clone())
			val a = self.typedValue(select.ifTrue.clone())
			val b = self.typedValue(select.ifFalse.clone())
			Op::Select(own Select(condition: c, ifTrue: a, ifFalse: b))
		}
		.ExtractValue(aggregate, index) => .ExtractValue(
			aggregate: self.typedValue(aggregate),
			index: index,
		)
		.InsertValue(insert) => {
			val into = self.typedValue(insert.aggregate.clone())
			val value = self.typedValue(insert.value.clone())
			Op::InsertValue(own InsertValue(aggregate: into, value: value, index: insert.index))
		}
		.Call(call) => {
			val callee = self.value(call.callee.clone())
			val args: Vec<Arg> = call.args.map((arg) => Arg(
				value: self.typedValue(arg.value.clone()),
				attrs: arg.attrs.clone(),
			))
			Op::Call(own Call(
				ret: call.ret.clone(),
				retAttrs: call.retAttrs.clone(),
				variadic: call.variadic.clone(),
				callee: callee,
				args: args,
				tail: call.tail,
			))
		}
		.AtomicRmw(op, address, value, align, order) => {
			val at = self.value(address)
			Op::AtomicRmw(
				op: op,
				address: at,
				value: self.typedValue(value),
				align: align,
				order: order,
			)
		}
		.CmpXchg(swap) => {
			val at = self.value(swap.address.clone())
			val wanted = self.typedValue(swap.expected.clone())
			val stored = self.typedValue(swap.replacement.clone())
			Op::CmpXchg(own CmpXchg(
				address: at,
				expected: wanted,
				replacement: stored,
				align: swap.align,
				order: swap.order.clone(),
			))
		}
		.Fence(order) => .Fence(order)
		.Declare(address, variable, expression) => {
			val at = self.value(address)
			Op::Declare(address: at, variable: self.node(variable), expression: expression)
		}
		.CondBr(condition, ifTrue, ifFalse, weights) => {
			val c = self.value(condition)
			Op::CondBr(
				condition: c,
				ifTrue: ifTrue,
				ifFalse: ifFalse,
				weights: self.nodeOf(weights),
			)
		}
		.Switch(value, otherwise, cases) => .Switch(
			value: self.typedValue(value),
			otherwise: otherwise,
			cases: cases,
		)
		.Ret(value) => match move value {
			.Some(given) => .Ret(.Some(self.typedValue(given)))
			.None => .Ret(.None)
		}
		other => other
	}

	/// A node as this part numbers what it names, in the order its text
	/// names them.
	var fn renumbered(node: Node): Node = match move node {
		.CompileUnit(file, optimized) => .CompileUnit(file: self.node(file), optimized: optimized)
		.Subprogram(name, file, line, typeNode, artificial, optimized, unit, retained) => {
			val inFile = self.node(file)
			val subroutine = self.node(typeNode)
			val inUnit = self.node(unit)
			val kept: Option<i64> = match retained {
				.Some(tuple) => .Some(self.node(tuple))
				.None => .None
			}
			Node::Subprogram(
				name: name,
				file: inFile,
				line: line,
				typeNode: subroutine,
				artificial: artificial,
				optimized: optimized,
				unit: inUnit,
				retained: kept,
			)
		}
		.LexicalBlock(scope, file, line, column) => {
			val outer = self.node(scope)
			Node::LexicalBlock(scope: outer, file: self.node(file), line: line, column: column)
		}
		.LexicalBlockFile(scope, file) => {
			val outer = self.node(scope)
			Node::LexicalBlockFile(scope: outer, file: self.node(file))
		}
		.Location(line, column, scope) => .Location(
			line: line,
			column: column,
			scope: self.node(scope),
		)
		.LocalVariable(name, arg, scope, file, line, typeNode) => {
			val outer = self.node(scope)
			val inFile = self.node(file)
			Node::LocalVariable(
				name: name,
				arg: arg,
				scope: outer,
				file: inFile,
				line: line,
				typeNode: self.node(typeNode),
			)
		}
		.PointerType(base, size) => .PointerType(base: self.nodeOf(base), size: size)
		.Typedef(name, base) => .Typedef(name: name, base: self.node(base))
		.Member(name, scope, base, size, offset) => {
			val outer = self.node(scope)
			Node::Member(
				name: name,
				scope: outer,
				base: self.node(base),
				size: size,
				offset: offset,
			)
		}
		.Structure(tag, name, size, elements) => .Structure(
			tag: tag,
			name: name,
			size: size,
			elements: self.node(elements),
		)
		.ArrayType(base, size, elements) => {
			val of = self.nodeOf(base)
			Node::ArrayType(base: of, size: size, elements: self.node(elements))
		}
		.Enumeration(name, base, size, elements) => {
			val written = self.node(base)
			Node::Enumeration(name: name, base: written, size: size, elements: self.node(elements))
		}
		.Tuple(items) => {
			var renumbered: Vec<MetaItem> = Vec()
			for item in move items {
				renumbered.push(
					match move item {
						.Node(node) => MetaItem::Node(self.node(node))
						other => other
					},
				)
			}
			.Tuple(renumbered)
		}
		other => other
	}
}
