// What DWARF's numbers of a variable length read as.

import std::collections::{Map}

/// The signed number `bytes` hold, read from the start.
fn signedOf(bytes: Vec<u8>): i64 = {
	val section = DebugSection(data: bytes, relocations: Map())
	var at = 0
	return section.sleb(&var at)
}

@test
fn aSignedNumberOfEveryLengthReads() = {
	assert(signedOf([0x02]) == 2)
	assert(signedOf([0x7e]) == -2)
	assert(signedOf([0xff, 0x00]) == 127)
	assert(signedOf([0x80, 0x7f]) == -128)
	// Nine bytes, whose sign is the 63rd bit and all above it.
	assert(signedOf([0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x40]) == -4611686018427387904)
	// Ten, the least there is.
	assert(signedOf([0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x7f]) == i64::MIN)
}
