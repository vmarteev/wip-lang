// LLVM's bitstream: bits from each byte's lowest, numbers in pieces, blocks
// that say how long they are, and records written as they are or by an
// abbreviation.

/// The bytes of what `write` writes.
fn written(write: (bits: &var Bitstream) => void): Vec<u8> = {
	var bits = Bitstream::new()
	write(&var bits)
	return bits.finish()
}

@test
fn bitsFillEachByteFromItsLowest() = {
	val bytes = written((bits) => {
		bits.emit(1, 1)
		bits.emit(0, 1)
		bits.emit(3, 2)
		bits.emit(0xAB, 8)
	})
	assert(bytes.len() == 4, "a stream ends on a word")
	assert(bytes[0] == 0xBD && bytes[1] == 0x0A, "1, 0, 3 then 0xAB: \(bytes[0]) \(bytes[1])")
}

@test
fn aNumberIsWrittenInPiecesEachSayingAnotherFollows() = {
	// 100 in pieces of six bits: 36 with the bit that says more, then 3.
	val bytes = written((bits) => bits.vbr(100, 6))
	assert(bytes[0] == (36 | 32 | (3 << 6)) as u8 && bytes[1] == 0, "\(bytes[0]) \(bytes[1])")
}

@test
fn aBlockSaysHowManyWordsItHolds() = {
	val bytes = written((bits) => {
		bits.enter(8, 3)
		bits.record(1, &Vec::of(own [2 as u64]).items())
		bits.exit()
	})
	// Its header's word, its length's word, and one word of contents.
	assert(bytes.len() == 12, "\(bytes.len())")
	assert(bytes[4] == 1 && bytes[5] == 0 && bytes[6] == 0 && bytes[7] == 0, "one word")
}

@test
fn anAbbreviationWritesABlobFromAWord() = {
	val bytes = written((bits) => {
		bits.enter(23, 3)
		val blob = bits.define(Vec::of(own [Field::Literal(1), Field::Blob]))
		val values = Vec::of(own [1 as u64])
		bits.abbreviated(&blob, &values.items(), &Vec::of(own [b'a', b'b']).items())
		bits.exit()
	})
	var found = false
	for i in 0..(bytes.len() - 1) {
		if bytes[i] == b'a' && bytes[i + 1] == b'b' && i % 4 == 0 then found = true
	}
	assert(found, "the blob's bytes start a word")
}

@test
fn aSignedNumberKeepsItsSignInItsLowestBit() = {
	assert(signedVbr(5) == 10)
	assert(signedVbr(-5) == 11)
	assert(signedVbr(0) == 0)
}
