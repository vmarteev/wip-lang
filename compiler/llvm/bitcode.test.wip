// The module as bitcode: what its records say of names, alignments and the
// smallest module. The gate's `bitcode` check has `clang` read the whole
// module of every case.

@test
fn aNameIsWrittenWithoutItsQuotesAndEscapes() = {
	assert(rawName("@\"wip.a\\22b\"") == Vec::of(own [b'w', b'i', b'p', b'.', b'a', b'"', b'b']))
	assert(rawName("@main") == Vec::of(own [b'm', b'a', b'i', b'n']))
}

@test
fn anAlignmentIsItsLogarithmPlusOne() = {
	assert(alignCode(1) == 1)
	assert(alignCode(8) == 4)
	assert(alignCode(16) == 5)
}

@test
fn aModuleStartsWithTheMagicAndWhoWroteIt() = {
	val module = Module(
		heading: String(),
		names: Vec::of(own [String::of("@wip_runtime_words"), String::of("@\"wip.frame_tables\"")]),
		data: Vec(),
		globals: Vec::of(own [runtimeWords(RUNTIME_WORDS), frameTables(FRAME_TABLES)]),
		declared: Vec(),
		functions: Vec(),
		groups: Vec(),
		unit: 0,
		flags: (1, 2),
		nodes: Vec::of(own [
			Node::CompileUnit(file: 3, optimized: false),
			Node::Tuple(Vec::of(own [MetaItem::Int(bits: 32, value: 7)])),
			Node::Tuple(Vec::of(own [MetaItem::Int(bits: 32, value: 2)])),
			Node::File(filename: String::of("a.wip"), directory: String::of("/")),
		]),
	)
	val bytes = bitcode(&module)
	assert(bytes[0] == b'B' && bytes[1] == b'C' && bytes[2] == 0xC0 && bytes[3] == 0xDE)
	assert(bytes.len() % 4 == 0, "it ends on a word")
	// Its global's names, at the end, as they are.
	val text = str::fromBytes(&bytes.items())
	assert(text.contains("wip_runtime_wordswip.frame_tables"), "the table of names")
}
