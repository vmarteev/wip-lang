// A debug build's parts: what each holds, and how each names it; and a
// module without debug information, whole and in parts.

/// A function of one block, hidden as a debug build's are, that answers
/// nothing.
fn hidden(
	symbol: u32,
	params: Vec<Param>,
	subprogram: i64,
	code: Vec<Instruction>,
): Function = Function(
	symbol: symbol,
	linkage: .Hidden,
	ret: .Void,
	retAttrs: Vec(),
	params: move params,
	returns: true,
	subprogram: subprogram,
	blocks: Vec::of(own [Block(label: .Start, instructions: move code)]),
)

fn line(op: Op, at: Option<i64>): Instruction = Instruction(result: .None, op: move op, at: at)

/// A program's module: the runtime's words and the frame tables first, as
/// every program's, then `names`.
fn module(
	names: Vec<str>,
	data: Vec<Global>,
	functions: Vec<Function>,
	flags: (i64, i64),
	nodes: Vec<Node>,
): Module = {
	var all = Vec::of(own [String::of("@wip_runtime_words"), String::of("@\"wip.frame_tables\"")])
	for name in names {
		all.push(String::of(name))
	}
	return Module(
		heading: String(),
		names: move all,
		data: move data,
		globals: Vec::of(own [runtimeWords(RUNTIME_WORDS), frameTables(FRAME_TABLES)]),
		declared: Vec(),
		functions: move functions,
		groups: Vec::of(own [Vec::of(own [FnAttr::NoUnwind])]),
		unit: 0,
		flags: flags,
		nodes: move nodes,
	)
}

/// Two files' functions, one calling the other, with a constant and
/// metadata: the parts number their own, copy what they name, declare what
/// the other defines, and leave quoted text as it is.
@test
fn aPartHasWhatItNamesAndNumbersItsOwn() = {
	// The names after the program's own two.
	val (a, b, string) = (2 as u32, 3 as u32, 4 as u32)
	val call = Call::plain(.Global(b), .Void, Vec::of(own [Val::of(.Global(string), .Ptr)]))
	val functions = Vec::of(own [
		hidden(
			a,
			Vec(),
			3,
			Vec::of(own [line(.Call(own move call), .Some(4)), line(.Ret(.None), .None)]),
		),
		hidden(
			b,
			Vec::of(own [Param(t: .Ptr, attrs: Vec(), name: .Some(.Param(0)))]),
			5,
			Vec::of(own [line(.Ret(.None), .None)]),
		),
	])
	val subprogram = (name: str) => Node::Subprogram(
		name: String::of(name),
		file: 6,
		line: 1,
		typeNode: 7,
		artificial: false,
		optimized: false,
		unit: 0,
	)
	val nodes = Vec::of(own [
		Node::CompileUnit(file: 6, optimized: false),
		Node::Tuple(
			Vec::of(own [
				MetaItem::Int(bits: 32, value: 7),
				MetaItem::Text(String::of("Dwarf Version")),
				MetaItem::Int(bits: 32, value: 4),
			]),
		),
		Node::Tuple(
			Vec::of(own [
				MetaItem::Int(bits: 32, value: 2),
				MetaItem::Text(String::of("Debug Info Version")),
				MetaItem::Int(bits: 32, value: 3),
			]),
		),
		subprogram("a!9 @x"),
		Node::Location(line: 1, column: 1, scope: 3),
		subprogram("b"),
		Node::File(filename: String::of("a.wip"), directory: String::of("/")),
		Node::SubroutineType,
	])
	val data = Vec::of(own [
		Global(
			name: string,
			linkage: .Private,
			unnamedAddr: true,
			constant: true,
			t: byteArray(4),
			init: .Some(.Bytes(Vec::of(own [b'!', b'2', b'@', b'y']))),
			align: .Some(1),
		),
	])
	val names = Vec::of(own ["@\"wip.a.1\"", "@\"wip.b.2\"", "@\"wip.str.0\""])
	val whole = module(move names, move data, move functions, (1, 2), move nodes)
	val files = Vec::of(own [String::of("a.wip"), String::of("b.wip")])
	val parts = split(move whole, &files)
	assert(parts.len() == 1, "small files share a part")
	val text = parts[0].text()
	val part = text.toStr()
	assert(part.contains("c\"!2@y\""), part)
	assert(part.contains("name: \"a!9 @x\""), part)
	assert(part.contains("@\"wip.data.0\" = private"), part)
	assert(!part.contains("wip.str.0"), part)
	assert(!part.contains("declare"), part)
	// The first function's subprogram is its first node.
	assert(part.contains("!dbg !0 {"), part)
	assert(part.contains("!0 = distinct !DISubprogram(name: \"a!9 @x\""), part)
}

/// A function of another part is declared, by its signature.
@test
fn aFunctionOfAnotherPartIsDeclared() = {
	val (a, b) = (2 as u32, 3 as u32)
	val call = Call::plain(.Global(b), .Void, Vec::of(own [Val::of(.Int(1), .I(64))]))
	var code = Vec::of(own [line(.Call(own move call), .None)])
	// More text than a part holds.
	for _ in 0..(MOST / 10) {
		code.push(line(.Unreachable, .None))
	}
	val functions = Vec::of(own [
		hidden(a, Vec(), 0, move code),
		hidden(
			b,
			Vec::of(own [Param(t: .I(64), attrs: Vec(), name: .Some(.Param(0)))]),
			0,
			Vec::of(own [line(.Ret(.None), .None)]),
		),
	])
	val nodes = Vec::of(own [
		Node::CompileUnit(file: 1, optimized: false),
		Node::File(filename: String::of("a.wip"), directory: String::of("/")),
	])
	val names = Vec::of(own ["@\"wip.a.1\"", "@\"wip.b.2\""])
	val whole = module(move names, Vec(), move functions, (0, 0), move nodes)
	val files = Vec::of(own [String::of("a.wip"), String::of("b.wip")])
	val parts = split(move whole, &files)
	assert(parts.len() == 2, "a part ends where it is too large")
	val first = parts[0].text()
	assert(first.contains("declare hidden void @\"wip.b.2\"(i64 %p0) #0\n"))
	assert(first.contains("@wip_runtime_words = global"))
	assert(parts[1].text().contains("@wip_runtime_words = external global"))
}

/// A module without debug information names none of it: no instruction's
/// location, no function's subprogram, no compile unit, no variable for a
/// debugger; and its parts are cut as any module's are.
@test
fn aModuleWithoutDebugInfoNamesNoneOfIt() = {
	val a = 2 as u32
	val declare = Op::Declare(address: .Param(0), variable: 3, expression: .Plain)
	val functions = Vec::of(own [
		hidden(
			a,
			Vec::of(own [Param(t: .Ptr, attrs: Vec(), name: .Some(.Param(0)))]),
			1,
			Vec::of(own [line(move declare, .Some(2)), line(.Ret(.None), .Some(2))]),
		),
	])
	val nodes = Vec::of(own [
		Node::CompileUnit(file: 4, optimized: false),
		Node::Subprogram(
			name: String::of("a"),
			file: 4,
			line: 1,
			typeNode: 5,
			artificial: false,
			optimized: false,
			unit: 0,
		),
		Node::Location(line: 1, column: 1, scope: 1),
		Node::LocalVariable(
			name: String::of("x"),
			arg: .Some(1),
			scope: 1,
			file: 4,
			line: 1,
			typeNode: 5,
		),
		Node::File(filename: String::of("a.wip"), directory: String::of("/")),
		Node::SubroutineType,
	])
	var whole = module(Vec::of(own ["@\"wip.a.1\""]), Vec(), move functions, (0, 0), move nodes)
	whole.dropDebugInfo()
	val text = whole.text()
	for debug in ["!dbg", "llvm.dbg.cu", "llvm.module.flags", "llvm.dbg.declare"] {
		assert(!text.contains(debug), text.toStr())
	}
	val files = Vec::of(own [String::of("a.wip")])
	val parts = split(move whole, &files)
	assert(parts.len() == 1)
	val part = parts[0].text()
	assert(!part.contains("!dbg") && !part.contains("llvm.dbg.cu"), part.toStr())
}
