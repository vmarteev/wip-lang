// A program's parts: what each holds, and how each names it; a release
// build's copies of the small functions of other parts; and a module
// without debug information, whole and in parts.

/// A function of one block, hidden as a debug build's are, that answers
/// nothing.
fn hidden(
	symbol: u32,
	params: Vec<Param>,
	subprogram: i64,
	code: Vec<Instruction>,
): Function = Function(
	symbol: symbol,
	linkage: .Hidden,
	ret: .Void,
	retAttrs: Vec(),
	params: params,
	returns: true,
	subprogram: subprogram,
	blocks: [Block(label: .Start, instructions: code)],
)

fn line(op: Op, at: Option<i64>): Instruction = Instruction(result: .None, op: op, at: at)

/// A program's module: the runtime's words and the frame tables first, as
/// every program's, then `names`.
fn module(
	names: Vec<str>,
	data: Vec<Global>,
	functions: Vec<Function>,
	flags: (i64, i64),
	nodes: Vec<Node>,
): Module = {
	var all = Vec::of([String::of("@wip_runtime_words"), String::of("@\"wip.frame_tables\"")])
	for name in names {
		all.push(String::of(name))
	}
	return Module(
		heading: String(),
		names: all,
		data: data,
		globals: [runtimeWords(RUNTIME_WORDS), frameTables(FRAME_TABLES)],
		declared: Vec(),
		functions: functions,
		groups: [[FnAttr::NoUnwind]],
		unit: 0,
		flags: flags,
		nodes: nodes,
	)
}

/// Two files' functions, one calling the other, with a constant and
/// metadata: the parts number their own, copy what they name, declare what
/// the other defines, and leave quoted text as it is.
@test
fn aPartHasWhatItNamesAndNumbersItsOwn() = {
	// The names after the program's own two.
	val (a, b, string) = (2 as u32, 3 as u32, 4 as u32)
	val call = Call::plain(.Global(b), .Void, [Val::of(.Global(string), .Ptr)])
	val functions = Vec::of([
		hidden(a, Vec(), 3, [line(.Call(own call), .Some(4)), line(.Ret(.None), .None)]),
		hidden(
			b,
			[Param(t: .Ptr, attrs: Vec(), name: .Some(.Param(0)))],
			5,
			[line(.Ret(.None), .None)],
		),
	])
	val subprogram = (name: str) => Node::Subprogram(
		name: String::of(name),
		file: 6,
		line: 1,
		typeNode: 7,
		artificial: false,
		optimized: false,
		unit: 0,
	)
	val nodes = Vec::of([
		Node::CompileUnit(file: 6, optimized: false),
		Node::Tuple([
			MetaItem::Int(bits: 32, value: 7),
			MetaItem::Text(String::of("Dwarf Version")),
			MetaItem::Int(bits: 32, value: 4),
		]),
		Node::Tuple([
			MetaItem::Int(bits: 32, value: 2),
			MetaItem::Text(String::of("Debug Info Version")),
			MetaItem::Int(bits: 32, value: 3),
		]),
		subprogram("a!9 @x"),
		Node::Location(line: 1, column: 1, scope: 3),
		subprogram("b"),
		Node::File(filename: String::of("a.wip"), directory: String::of("/")),
		Node::SubroutineType,
	])
	val data = Vec::of([
		Global(
			name: string,
			linkage: .Private,
			unnamedAddr: true,
			constant: true,
			t: byteArray(4),
			init: .Some(.Bytes([b'!', b'2', b'@', b'y'])),
			align: .Some(1),
		),
	])
	val names = Vec::of(["@\"wip.a.1\"", "@\"wip.b.2\"", "@\"wip.str.0\""])
	val whole = module(names, data, functions, (1, 2), nodes)
	val files = Vec::of([String::of("a.wip"), String::of("b.wip")])
	val parts = split(whole, &files, false)
	assert(parts.len() == 1, "small files share a part")
	val text = parts[0].text()
	val part = text.toStr()
	assert(part.contains("c\"!2@y\""), part)
	assert(part.contains("name: \"a!9 @x\""), part)
	assert(part.contains("@\"wip.data.0\" = private"), part)
	assert(!part.contains("wip.str.0"), part)
	assert(!part.contains("declare"), part)
	// The first function's subprogram is its first node.
	assert(part.contains("!dbg !0 {"), part)
	assert(part.contains("!0 = distinct !DISubprogram(name: \"a!9 @x\""), part)
}

/// A function of another part is declared, by its signature.
@test
fn aFunctionOfAnotherPartIsDeclared() = {
	val (a, b) = (2 as u32, 3 as u32)
	val call = Call::plain(.Global(b), .Void, [Val::of(.Int(1), .I(64))])
	var code = Vec::of([line(.Call(own call), .None)])
	// More text than a part holds.
	for _ in 0..(MOST / 10) {
		code.push(line(.Unreachable, .None))
	}
	val functions = Vec::of([
		hidden(a, Vec(), 0, code),
		hidden(
			b,
			[Param(t: .I(64), attrs: Vec(), name: .Some(.Param(0)))],
			0,
			[line(.Ret(.None), .None)],
		),
	])
	val nodes = Vec::of([
		Node::CompileUnit(file: 1, optimized: false),
		Node::File(filename: String::of("a.wip"), directory: String::of("/")),
	])
	val names = Vec::of(["@\"wip.a.1\"", "@\"wip.b.2\""])
	val whole = module(names, Vec(), functions, (0, 0), nodes)
	val files = Vec::of([String::of("a.wip"), String::of("b.wip")])
	val parts = split(whole, &files, false)
	assert(parts.len() == 2, "a part ends where it is too large")
	val first = parts[0].text()
	assert(first.contains("declare hidden void @\"wip.b.2\"(i64 %p0) #0\n"))
	assert(first.contains("@wip_runtime_words = global"))
	assert(parts[1].text().contains("@wip_runtime_words = external global"))
}

/// A module without debug information names none of it: no instruction's
/// location, no function's subprogram, no compile unit, no variable for a
/// debugger; and its parts are cut as any module's are.
@test
fn aModuleWithoutDebugInfoNamesNoneOfIt() = {
	val a = 2 as u32
	val declare = Op::Declare(address: .Param(0), variable: 3, expression: .Plain)
	val functions = Vec::of([
		hidden(
			a,
			[Param(t: .Ptr, attrs: Vec(), name: .Some(.Param(0)))],
			1,
			[line(declare, .Some(2)), line(.Ret(.None), .Some(2))],
		),
	])
	val nodes = Vec::of([
		Node::CompileUnit(file: 4, optimized: false),
		Node::Subprogram(
			name: String::of("a"),
			file: 4,
			line: 1,
			typeNode: 5,
			artificial: false,
			optimized: false,
			unit: 0,
		),
		Node::Location(line: 1, column: 1, scope: 1),
		Node::LocalVariable(
			name: String::of("x"),
			arg: .Some(1),
			scope: 1,
			file: 4,
			line: 1,
			typeNode: 5,
		),
		Node::File(filename: String::of("a.wip"), directory: String::of("/")),
		Node::SubroutineType,
	])
	var whole = module(["@\"wip.a.1\""], Vec(), functions, (0, 0), nodes)
	whole.dropDebugInfo()
	val text = whole.text()
	for debug in ["!dbg", "llvm.dbg.cu", "llvm.module.flags", "llvm.dbg.declare"] {
		assert(!text.contains(debug), text.toStr())
	}
	val files = Vec::of([String::of("a.wip")])
	val parts = split(whole, &files, false)
	assert(parts.len() == 1)
	val part = parts[0].text()
	assert(!part.contains("!dbg") && !part.contains("llvm.dbg.cu"), part.toStr())
}

/// A function that calls `callee` with nothing, then returns: one of
/// `filler` instructions more, to make it as large as that.
fn caller(symbol: u32, callee: u32, filler: i64): Function = {
	val call = Call::plain(.Global(callee), .Void, Vec())
	var code = Vec::of([line(.Call(own call), .None)])
	for _ in 0..filler {
		code.push(line(.Unreachable, .None))
	}
	code.push(line(.Ret(.None), .None))
	return hidden(symbol, Vec(), -1, code)
}

/// Four functions in two files, each file a part: `a`, too large to share
/// one, calls `b`, which calls `c` and names a constant, and `c` calls `d`,
/// which may be in a cycle of calls, or too large to copy. Copied where
/// `copies` says, as for a release build.
fn copying(d: Function, copies: bool): Vec<Module> = {
	// The names after the program's own two.
	val (a, b, c) = (2 as u32, 3 as u32, 4 as u32)
	val (dSymbol, string) = (5 as u32, 6 as u32)
	val callC = Call::plain(.Global(c), .Void, [Val::of(.Global(string), .Ptr)])
	val functions = Vec::of([
		caller(a, b, MOST / 54),
		hidden(b, Vec(), -1, [line(.Call(own callC), .None), line(.Ret(.None), .None)]),
		caller(c, dSymbol, 0),
		d,
	])
	val data = Vec::of([
		Global(
			name: string,
			linkage: .Private,
			unnamedAddr: true,
			constant: true,
			t: byteArray(2),
			init: .Some(.Bytes([b'h', b'i'])),
			align: .Some(1),
		),
	])
	val names = Vec::of([
		"@\"wip.a.1\"",
		"@\"wip.b.2\"",
		"@\"wip.c.3\"",
		"@\"wip.d.4\"",
		"@\"wip.str.0\"",
	])
	var whole = module(names, data, functions, (-1, -1), Vec())
	whole.dropDebugInfo()
	val files = Vec::of([
		String::of("a.wip"),
		String::of("b.wip"),
		String::of("b.wip"),
		String::of("b.wip"),
	])
	return split(whole, &files, copies)
}

/// A release build's part copies each small function of another part that
/// it names, and each that those name, for LLVM to inline: never emitted,
/// and hidden, as the definition the other part has is. What a copy names is
/// the part's own, a constant copied as its functions' are.
@test
fn aPartCopiesTheSmallFunctionsItNames() = {
	val parts = copying(caller(5, 4, 0), true)
	assert(parts.len() == 2, "a part ends where it is too large")
	val first = parts[0].text()
	assert(first.contains("define available_externally hidden void @\"wip.b.2\"()"), first.toStr())
	assert(first.contains("define available_externally hidden void @\"wip.c.3\"()"), first.toStr())
	assert(first.contains("define available_externally hidden void @\"wip.d.4\"()"), first.toStr())
	assert(!first.contains("declare"), first.toStr())
	assert(
		first.contains("@\"wip.data.0\" = private unnamed_addr constant [2 x i8] c\"hi\""),
		first.toStr(),
	)
	// The part's own functions come first, then the copies, in the order
	// they are named.
	val at = (name: str) => first.indexOf(name).unwrapOr(-1)
	assert(at("define internal void @\"wip.a.1\"") < at("@\"wip.b.2\"() #"))
	assert(at("@\"wip.b.2\"() #") < at("@\"wip.c.3\"() #"))
	assert(at("@\"wip.c.3\"() #") < at("@\"wip.d.4\"() #"))
	// The part that defines them defines them, and copies nothing back.
	val second = parts[1].text()
	assert(second.contains("define hidden void @\"wip.b.2\"()"), second.toStr())
	assert(!second.contains("available_externally"), second.toStr())
	// What no other part names is its own part's, which LLVM may drop once
	// every call is inlined; what another names, copied or not, is hidden.
	assert(first.contains("define internal void @\"wip.a.1\"()"), first.toStr())
	assert(second.contains("define hidden void @\"wip.c.3\"()"), second.toStr())
	assert(second.contains("define hidden void @\"wip.d.4\"()"), second.toStr())
}

/// A function in a cycle of calls is inlined nowhere, and one too large is
/// not copied: each is declared, as a debug build's parts declare all.
@test
fn aFunctionInACycleOrTooLargeIsDeclared() = {
	var cycled = caller(5, 4, 0)
	cycled.inCycle = true
	val large = caller(5, 4, COPIED)
	for d in [cycled, large] {
		val first = copying(d.clone(), true)[0].text()
		assert(
			first.contains("define available_externally hidden void @\"wip.c.3\"()"),
			first.toStr(),
		)
		assert(first.contains("declare hidden void @\"wip.d.4\"()"), first.toStr())
		assert(
			!first.contains("define available_externally hidden void @\"wip.d.4\""),
			first.toStr(),
		)
	}
}

/// A debug build's parts copy nothing, and keep nothing to themselves.
@test
fn aDebugBuildCopiesNothing() = {
	val first = copying(caller(5, 4, 0), false)[0].text()
	assert(first.contains("declare hidden void @\"wip.b.2\"()"), first.toStr())
	assert(!first.contains("available_externally"), first.toStr())
	assert(first.contains("define hidden void @\"wip.a.1\"()"), first.toStr())
}
