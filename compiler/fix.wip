// `wip fix`: the fixes of the warnings whose fix changes no meaning,
// applied to programs and their tests. Each program is checked with its
// tests, as `wip test` compiles it; where it has no errors, each such fix
// is applied to the file it is in, where that file is under the directory
// the command is typed in, and the program is checked again, since a copy
// taken away can make another value's use its last. What a round changed
// is laid out as `wip fmt` lays it out.

import std::fs
import std::io
import std::path
import fmt::{switchedOff}
import lang::{Sources, Target, Timings, checkLoaded, findHome, loadFor, renderProgram}
import syntax::{
	BINDING_NEVER_READ,
	BYTE_CAST,
	CLONE_OF_PLAIN,
	COPIED_AT_LAST_USE,
	Code,
	Diagnostic,
	FORWARDS_ENUMERATED,
	IMPORT_NEVER_USED,
	LIST_ONLY_WALKED,
	NAME_SAID_TWICE,
	LOOP_AS_LIST,
	LOOP_AS_SEARCH,
	MOVE_INFERRED,
	NEEDLESS_DERIVE,
	NEEDLESS_LAMBDA,
	NEEDLESS_STRING_OF,
	NEEDLESS_VEC_OF,
	NEEDLESS_WRAPPER,
	NEVER_READ,
	NEVER_WRITTEN,
	PARAMETER_NEVER_READ,
	REFERENCE_PASSED_ON
}

/// The warnings whose fix changes no meaning, which `wip fix` applies: a
/// copy where a move would do, a `move` the compiler infers, a `clone()` of
/// plain data, a `@derive` of what the type has without it, a character
/// cast to a byte, a `.Some` or an `.Ok` the type expected says, a `var`
/// nothing writes, a local nothing reads that is given what only reads, a
/// binding and a parameter nothing reads, an import nothing names, a
/// lambda that only calls a function, which its name says, a loop that
/// says what a list or a search says, a list walked by
/// `forwards().enumerate()`, which `indexed()` says, a `String::of` or a
/// `Vec::of` the type expected says, and a named argument `x: x`, which
/// `x:` says.
val FIXED: [Code; 19] = [
	COPIED_AT_LAST_USE,
	MOVE_INFERRED,
	CLONE_OF_PLAIN,
	NEEDLESS_DERIVE,
	BYTE_CAST,
	NEEDLESS_WRAPPER,
	NEVER_WRITTEN,
	NEVER_READ,
	BINDING_NEVER_READ,
	PARAMETER_NEVER_READ,
	IMPORT_NEVER_USED,
	NEEDLESS_LAMBDA,
	LOOP_AS_LIST,
	LIST_ONLY_WALKED,
	LOOP_AS_SEARCH,
	FORWARDS_ENUMERATED,
	NEEDLESS_STRING_OF,
	NEEDLESS_VEC_OF,
	NAME_SAID_TWICE,
]

/// The errors whose fix gives the program what its code meant before the
/// language asked for more: a reference passed on by its name, which a call
/// now lends with `&`. Their fixes are made too, in a program that has no
/// other error.
val MIGRATED: [Code; 1] = [REFERENCE_PASSED_ON]

/// How many times a program is checked and fixed again, at most: each round
/// can make another value's use its last.
val ROUNDS = 8

/// One edit a fix makes in a file: the bytes it replaces, what with, the
/// code of the warning it fixes, and whether it is the fix's first, which
/// the fix is counted by.
@derive(Clone)
struct FileEdit {
	lo: u32
	hi: u32
	replacement: String
	code: Code
	first: bool
}

/// `wip fix`: each program in `paths`, or the current directory's, fixed as
/// each of `targets` checks it, or this machine; each file changed listed
/// with how many fixes of each code it took. With `check`, nothing is
/// written, and it fails where something would change.
fn fixCommand(
	paths: &[str],
	targetNames: &[str],
	check: bool,
	layout: &Layout,
	color: bool,
	threads: i64,
): i64 = {
	val programs: Vec<str> = if paths.isEmpty() then ["."].toVec() else paths.toVec()
	val here = match fs::realPath(".") {
		.Ok(here) => here
		.Err(error) => {
			io::eprintln("error: cannot tell which directory this is: \(error)")
			return 2
		}
	}
	val home = findHome().toOption()
	var targets: Vec<Target> = Vec()
	for name in targetNames {
		match Target::parse(name) {
			.Ok(parsed) => {
				for target in parsed do
					if !targets.contains(&target) then
						targets.push(target)
			}
			.Err(message) => {
				io::eprintln("error: \(message)")
				return 2
			}
		}
	}
	if targets.isEmpty() then
		targets.push(Target::host())

	var changed: Vec<(String, Vec<Code>)> = Vec()
	var failed = 0
	for program in programs {
		for target in targets do
			failed += fixedFor(
				program,
				target,
				check,
				here,
				&home,
				&layout,
				color,
				threads,
				&var changed,
			)
	}
	for (file, codes) in changed do
		io::println("\(file.stripPrefix("\(here)/").unwrapOr(&file)): \(counted(&codes))")

	return if failed > 0 then 1 else if check && !changed.isEmpty() then 1 else 0
}

/// `program` fixed round after round as `target` checks it, each file it
/// changed added to `changed` with the codes of its fixes; how many
/// failures there were.
fn fixedFor(
	program: str,
	target: Target,
	check: bool,
	here: str,
	home: &Option<String>,
	layout: &Layout,
	color: bool,
	threads: i64,
	changed: &var Vec<(String, Vec<Code>)>,
): i64 = {
	var failed = 0
	for _ in 0..ROUNDS {
		var timings = Timings()
		var loaded = match loadFor(program, .Tests, target, &var timings, threads) {
			.Ok(loaded) => loaded
			.Err(message) => {
				io::eprintln("error: \(message)")
				return failed + 1
			}
		}
		val checked = checkLoaded(&var loaded, &var timings)
		if checked.diagnostics.any((d) => d.isError() && !MIGRATED.contains(&d.code)) {
			io::eprint(renderProgram(&checked.diagnostics, &loaded.sources, color))
			io::eprintln("`\(program)` is left as it is: it has errors")
			return failed + 1
		}
		val files = editsOf(&checked.diagnostics, &loaded.sources, here, &home)
		if files.isEmpty() then
			break

		for (file, edits) in files {
			val at = match changed.indexWhere((c) => c.0 == file) {
				.Some(at) => at
				.None => {
					changed.push((file.clone(), Vec()))
					changed.len() - 1
				}
			}
			for edit in edits do
				if edit.first then
					changed[at].1.push(edit.code)

			if !check && written(file, &edits, &layout, color) is .Err(message) {
				io::eprintln("error: \(message)")
				failed += 1
			}
		}
		if check then
			break
	}
	return failed
}

/// The edits the fixes of `diagnostics` make, file by file: those of the
/// warnings `FIXED` names, in files under `here`, each once. A fix is made
/// whole or not at all: one with an edit outside them, or that overlaps an
/// edit already taken, is left to a later round, which makes it if it
/// still applies.
fn editsOf(
	diagnostics: &[Diagnostic],
	sources: &Sources,
	here: str,
	home: &Option<String>,
): Vec<(String, Vec<FileEdit>)> = {
	var files: Vec<(String, Vec<FileEdit>)> = Vec()
	for diagnostic in diagnostics {
		val fixes =
			if diagnostic.isError() then MIGRATED.contains(&diagnostic.code)
			else FIXED.contains(&diagnostic.code)
		if !fixes then
			continue

		val .Some(fix) = diagnostic.fix else continue
		var made: Vec<(String, FileEdit)> = Vec()
		var whole = true
		for edit in fix.edits {
			val .Some((name, _, base)) = sources.of(edit.span) else {
				whole = false
				break
			}
			val .Some(file) = fixable(name, here, &home) else {
				whole = false
				break
			}
			val one = FileEdit(
				lo: edit.span.lo - base,
				hi: edit.span.hi - base,
				replacement: edit.replacement.clone(),
				code: diagnostic.code,
				first: made.isEmpty(),
			)
			val clashes =
				files.any((f) => f.0 == file && f.1.any((e) => overlaps(&e, &one))) ||
				made.any((m) => m.0 == file && overlaps(&m.1, &one))
			if clashes {
				whole = false
				break
			}
			made.push((file, one))
		}
		if !whole then
			continue

		for (file, one) in move made {
			val at = match files.indexWhere((f) => f.0 == file) {
				.Some(at) => at
				.None => {
					files.push((file, Vec()))
					files.len() - 1
				}
			}
			files[at].1.push(one)
		}
	}
	return files
}

/// Whether two edits touch the same bytes, or are both an insertion at
/// one place, which would leave their order to chance.
fn overlaps(a: &FileEdit, b: &FileEdit): bool =
	a.lo < b.hi && b.lo < a.hi || a.lo == b.lo && a.hi == b.hi

/// Where the file a diagnostic names is, where `wip fix` may change it:
/// under `here`. The library's files are named from its home.
fn fixable(name: str, here: str, home: &Option<String>): Option<String> = {
	val onDisk: String =
		if fs::exists(name) then name
		else match home {
			.Some(dir) if name.startsWith("std/") &&
				fs::exists(path::join(dir, name)) => path::join(dir, name)
			_ => return .None
		}
	val .Ok(real) = fs::realPath(onDisk) else return .None
	return if real.startsWith("\(here)/") then real else .None
}

/// `file` with `edits` made, laid out as `wip fmt` lays it out unless it
/// says not to be, and written.
/// `text` without the line at `at`, where an edit has left nothing on it
/// but its indent: a statement or an import removed leaves no blank line
/// of its own.
fn withoutEmptiedLine(text: String, at: i64): String = {
	var start = at
	while start > 0 && text[start - 1] != b'\n' do
		start -= 1

	var end = at
	while end < text.len() && text[end] != b'\n' do
		end += 1

	for i in start..end do
		if text[i] != b' ' && text[i] != b'\t' then
			return text

	if end >= text.len() then
		return text

	return "\(text[..start])\(text[end + 1..])"
}

fn written(file: str, edits: &[FileEdit], layout: &Layout, color: bool): Result<void, String> = {
	var text = fs::readFile(file).mapErr((error) => "cannot read `\(file)`: \(error)")?
	var order = edits.toVec()
	order.sortBy((a, b) => a.lo > b.lo)
	for edit in order {
		text = "\(text[..edit.lo as i64])\(edit.replacement)\(text[edit.hi as i64..])"
		if edit.replacement.isEmpty() && edit.hi > edit.lo then
			text = withoutEmptiedLine(text, edit.lo as i64)
	}
	if !switchedOff(text) && formatText(file, text, &layout, color) is .Some(formatted) then
		text = formatted

	return fs::writeFile(file, text).mapErr((error) => "cannot write `\(file)`: \(error)")
}

/// How many fixes of each code: `E0448 ×2, E0464`.
fn counted(codes: &[Code]): String = {
	var seen: Vec<(Code, i64)> = Vec()
	for code in codes {
		match seen.indexWhere((s) => s.0 == code) {
			.Some(at) => seen[at].1 += 1
			.None => seen.push((code, 1))
		}
	}
	seen.sortBy((a, b) => a.0.text() < b.0.text())
	val parts: Vec<String> = seen.map((s) => if s.1 == 1 then "\(s.0)" else "\(s.0) ×\(s.1)")
	return parts.join(", ")
}
