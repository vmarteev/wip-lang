// `wip bindgen header.h -o module/bindings.wip`: a Wip module written from a C
// header. What it writes is ordinary Wip source, which a person reads and
// commits; nothing is generated while a program is built.

import std::args::{ArgumentError, Arguments}
import std::fs
import std::io
import std::path
import declared::{Reading}
import header
import mapped::{Mapping}
import render

val USAGE = """
	usage: wip bindgen <header> [options]

	Writes a Wip module that declares what a C header declares, asking clang
	what that is: the compiler `$CC` names, or the clang `$WIP_CLANG` names,
	or `clang`.

	  -o, --out file           where to write it; standard output unless said
	      --link library       the library the module links, as `@link` says
	      --include header     the header the module names; the header's own
	                           name unless said
	      --module name        the module's name, said in its first lines
	  -D, --define NAME[=V]    a setting the header is read with, as `cc -D`;
	                           given again for each
	      --first header       a header read before it, as `cc -include`;
	                           given again for each
	  -I, --search directory   a directory the header's own includes are
	                           looked for in, as `cc -I`; given again for
	                           each
	      --type C=Wip         a C struct declared as a Wip type laid out as
	                           it is, `Vector3=std::math::Vec3`, which the
	                           module imports; given again for each
	      --pointer name       a parameter that is a pointer, never a
	                           reference, for what the header does not say:
	                           that it may be null, or is an array; given
	                           again for each
	  -h, --help               print this
	"""

/// What the command line asked for.
struct Asked {
	header: String = String()
	out: Option<String> = .None
	link: Option<String> = .None
	include: Option<String> = .None
	module: String = String()
	defines: Vec<String> = Vec()
	first: Vec<String> = Vec()
	search: Vec<String> = Vec()
	types: Vec<String> = Vec()
	pointers: Vec<String> = Vec()
}

/// The command line taken apart: what it asks for, nothing where it asks
/// for the usage, or what is wrong with it. One header is read at a time.
fn asked(args: &[cstring]): Result<Option<Asked>, ArgumentError> = {
	var asked = Asked()
	var arguments = Arguments::of(&args)

	while arguments.next()? is .Some(argument) {
		match argument {
			.Short('o') | .Long("out") => asked.out = .Some(arguments.value()?)
			.Long("link") => asked.link = .Some(arguments.value()?)
			.Long("include") => asked.include = .Some(arguments.value()?)
			.Long("module") => asked.module = arguments.value()?
			.Short('D') | .Long("define") => asked.defines.push(arguments.value()?)
			.Long("first") => asked.first.push(arguments.value()?)
			.Short('I') | .Long("search") => asked.search.push(arguments.value()?)
			.Long("type") => asked.types.push(arguments.value()?)
			.Long("pointer") => asked.pointers.push(arguments.value()?)
			.Short('h') | .Long("help") => return .Ok(.None)
			.Positional(name) if asked.header.isEmpty() => asked.header = name
			_ => return .Err(argument.unexpected())
		}
	}

	return .Ok(.Some(asked))
}

fn main(args: &[cstring]): i64 = {
	val asked = match asked(&args) {
		.Ok(.Some(asked)) => asked
		.Ok(.None) => {
			io::print(USAGE)
			return 0
		}
		.Err(error) => {
			io::eprintln("error: \(error)")
			io::eprint(USAGE)
			return 1
		}
	}

	if asked.header.isEmpty() {
		io::eprint(USAGE)
		return 1
	}

	val include = match asked.include {
		.Some(include) => include.clone()
		.None => path::name(asked.header)
	}

	var mappings: Vec<Mapping> = Vec()
	for written in asked.types {
		match Mapping::parse(written) {
			.Ok(mapping) => mappings.push(mapping)
			.Err(why) => {
				io::eprintln("error: \(why)")
				return 1
			}
		}
	}

	val reading = Reading(
		defines: asked.defines.clone(),
		first: asked.first.clone(),
		search: asked.search.clone(),
	)
	val read = header::read(
		asked.header,
		include,
		asked.link.clone(),
		&reading,
		&mappings,
		&asked.pointers.items(),
	)

	val header = match move read {
		.Ok(header) => header
		.Err(message) => {
			io::eprintln("error: \(message)")
			return 1
		}
	}

	val text = render::render(&header, asked.module)

	match asked.out {
		.Some(path) => {
			if fs::writeFile(path, text) is .Err(error) {
				io::eprintln("error: cannot write \(path): \(error)")
				return 1
			}
		}
		.None => io::print(text)
	}

	return 0
}
