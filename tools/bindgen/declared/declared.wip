// What a header declares, as the tool keeps it between reading it and
// writing the module.

import types::{Constant, Ty}

/// What a header declares, in the order it declared it.
pub struct Header {
	/// What the generated file says it includes, as `@header` writes it.
	pub var include: String
	/// The library the declarations come from, if `--link` named one.
	pub var link: Option<String> = .None
	/// The settings the header was read with, `NAME` or `NAME=VALUE`,
	/// which the C compiled with the program must be given too: written
	/// as `@define`.
	pub var defines: Vec<String> = Vec()
	pub var items: Vec<Item> = Vec()
	/// What the module imports: the Wip types the header's structs are
	/// declared as, `std::math::{Vec2, Vec3}`.
	pub var imports: Vec<String> = Vec()
	/// The function-like macros that were skipped, and anything else the
	/// tool could not write, said plainly at the end of the file.
	pub var skipped: Vec<String> = Vec()
}

/// A name and its type: a parameter, or a field.
pub struct Typed {
	pub var name: String
	pub var ty: Ty
	/// A field's `alignas`, or `__attribute__((aligned(n)))`: what Wip says
	/// with `@align(n)`.
	pub var align: Option<i64> = .None
}

pub enum Item {
	/// A function C declares. `inline` says it may have no symbol, so the
	/// call goes through the header.
	Function(name: String, params: Vec<Typed>, ret: Option<Ty>, variadic: bool, inline: bool)
	/// A struct or a union whose fields are known, or whose layout is C's
	/// business because it has bitfields or a packing that is not 1; packed,
	/// or aligned to more than its fields ask, as C declared it.
	Record(
		name: String,
		isUnion: bool,
		opaque: bool,
		packed: bool,
		align: Option<i64>,
		fields: Vec<Typed>,
	)
	/// A `struct sqlite3;` that is never defined: a type whose contents Wip
	/// does not know.
	Opaque(name: String)
	/// A variable C owns.
	Variable(name: String, ty: Ty)
	/// A constant: an enumerator, or an object-like macro.
	Constant(constant: Constant)
}

/// How clang is to read a header: the settings, as `-D` gives them, and the
/// headers it reads first, as `-include` does, for one that is not whole
/// on its own — `sokol_glue.h`, which needs `sokol_gfx.h` before it.
pub struct Reading {
	pub var defines: Vec<String> = Vec()
	pub var first: Vec<String> = Vec()
	/// Where the header's own includes are looked for, besides beside it.
	pub var search: Vec<String> = Vec()
}

extend Reading {
	/// What clang is given for them.
	pub fn arguments(): Vec<String> = {
		var out: Vec<String> = Vec()

		for define in self.defines.items() {
			out.push("-D\(define)")
		}

		for header in self.first.items() {
			out.push("-include")
			out.push(header.clone())
		}

		for directory in self.search.items() {
			out.push("-I")
			out.push(directory.clone())
		}

		return move out
	}
}
