// The C compiler, run, and the syntax tree clang writes of a header, read.
// Nothing in this tool parses C: the compiler is asked, as `clang -Xclang
// -ast-dump=json` for what a header declares and `cc -E -dD` for what it
// `#define`s, and these are the questions and how the answers are read.

import std::io
import std::json
import std::json::{Json}
import std::process::{Command, Output}
import declared::{Reading}

/// The compiler `$CC` names, or `fallback` where it names none.
pub fn compiler(fallback: str): String = io::env("CC").unwrapOr(fallback)

/// `compiler` run with `options`, then the settings `reading` holds, then
/// `inputs`, with `stdin` to read where there is one: what it wrote and how
/// it ended, or why it could not be run.
pub fn run(
	compiler: str,
	options: &[str],
	reading: &Reading,
	inputs: &[str],
	stdin: Option<str>,
): Result<Output, String> = {
	var command = Command::of(compiler).args(&options)

	for argument in reading.arguments() {
		command = command.arg(argument.toStr())
	}

	command = command.args(&inputs)

	if stdin is .Some(text) then command = command.input(text)

	return match command.output() {
		.Ok(output) => .Ok(move output)
		.Err(error) => .Err("cannot run `\(compiler)`: \(error)")
	}
}

/// The syntax tree `compiler` wrote of `what`, as JSON. Only clang writes
/// one, and clang says the format is for testing, so what is not
/// understood is said rather than guessed at.
pub fn tree(compiler: str, output: &Output, what: str): Result<Json, String> = {
	if output.stdout.isEmpty() {
		val hint = "only clang writes one, so run again with `CC=clang`"
		return .Err("`\(compiler)` wrote no syntax tree of \(what); \(hint):\n\(output.stderr)")
	}

	val why = "clang's format is for testing and may have changed"

	return json::parse(output.stdout.toStr()).mapErr((error) =>
		"`\(compiler)`'s JSON is not what this tool knows (\(error)); \(why)")
}

/// The text of the field `name`, where the node has one that is text.
pub fn textOf(node: &Json, name: str): Option<str> = node.get(name)?.asText()

/// Whether the field `name` is there and `true`.
pub fn flag(node: &Json, name: str): bool =
	node.get(name).flatMap((value) => value.asBool()) == .Some(true)

/// The type as C wrote it, `node.type.qualType`, where it wrote one.
pub fn writtenType(node: &Json): Option<str> = node.get("type")?.get("qualType")?.asText()

/// The type as C wrote it, or nothing written.
pub fn qualType(node: &Json): str = writtenType(node).unwrapOr("")

/// What is inside a node, where it has anything.
pub fn inner(node: &Json): Option<&Vec<Json>> = node.get("inner")?.asArray()

/// The one node inside `node`, or the first.
pub fn only(node: &Json): Option<&Json> = node.get("inner")?.item(0)

/// The nodes directly inside `node` of the kind `kind`.
pub fn children(node: &Json, kind: str): Vec<&Json> = {
	var found: Vec<&Json> = Vec()

	if inner(node) is .Some(nodes) {
		for child in nodes.items() {
			if textOf(child, "kind") == .Some(kind) then found.push(child)
		}
	}

	return move found
}
