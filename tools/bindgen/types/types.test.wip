// How a C type's spelling and a `#define`'s value are written in Wip.

/// The value `constant` writes for a `#define NAME text`, or nothing.
fn valueOf(text: str): Option<String> = match constant("NAME", text) {
	.Some(constant) => .Some(constant.value.clone())
	.None => .None
}

@test
fn cEscapesBecomeWipOnes() = {
	// `\0` is octal in C, which is why it is not passed through.
	assert(valueOf("\"\\0\"") == .Some("\"\\u{0}\""))
	// What both languages write the same way is left alone.
	assert(valueOf("\"a\\nb\\t\\\\\"") == .Some("\"a\\nb\\t\\\\\""))
	// What only C has becomes the code point it stands for:
	// this is the escape termbox2's constants hold.
	assert(valueOf("\"\\x1b[?1000h\"") == .Some("\"\\u{1b}[?1000h\""))
	assert(valueOf("\"\\e[m\"") == .Some("\"\\u{1b}[m\""))
	assert(valueOf("\"\\a\\b\\f\\v\"") == .Some("\"\\u{7}\\u{8}\\u{c}\\u{b}\""))
	// Octal, up to three digits, and a question mark C escapes and Wip
	// does not.
	assert(valueOf("\"\\033[m\"") == .Some("\"\\u{1b}[m\""))
	assert(valueOf("\"\\1234\"") == .Some("\"\\u{53}4\""))
	assert(valueOf("\"\\?\"") == .Some("\"?\""))
	// An escape this does not know leaves the constant out rather than
	// writing something that will not compile.
	assert(valueOf("\"\\q\"").isNone())
	assert(valueOf("\"\\x\"").isNone())
}

@test
fn numbersAreWholeAndInRange() = {
	assert(valueOf("42") == .Some("42"))
	assert(valueOf("0x1F") == .Some("31"))
	assert(valueOf("0X10UL") == .Some("16"))
	assert(valueOf("+7u") == .Some("7"))
	assert(valueOf("-3") == .Some("-3"))
	// An expression, a float and a number too large for an `i64` are left
	// out.
	assert(valueOf("(1 << 4)").isNone())
	assert(valueOf("1.5").isNone())
	assert(valueOf("0x10000000000000000").isNone())
}

/// How the binding writes the C type `written`, where it writes one.
fn written(text: str, position: Where, known: &Known): Option<String> = match at(
	text,
	position,
	known,
) {
	.Some(ty) => .Some(ty.text())
	.None => .None
}

@test
fn cTypesAreWrittenAsWipNamesThem() = {
	var known = Known()
	known.records.add("Point")
	known.aliases.put("Spot", "Point")
	known.aliases.put("Handle", "Point *")
	val field = Where::Field
	val param = Where::Parameter
	assert(written("unsigned long", field, &known) == .Some("c_ulong"))
	assert(written("const char *", param, &known) == .Some("cstring"))
	assert(written("char [8]", field, &known) == .Some("[c_char; 8]"))
	assert(written("void *", param, &known) == .Some("ptr<void>"))
	// A pointer to a struct the header defines is a reference where it
	// is a parameter, and a pointer where it is a field.
	assert(written("struct Point *", param, &known) == .Some("&var Point"))
	assert(written("const Point *", param, &known) == .Some("&Point"))
	assert(written("Point *", field, &known) == .Some("ptr<Point>"))
	assert(written("Point **", param, &known) == .Some("ptr<ptr<Point>>"))
	// A second name is read as what it names.
	assert(written("Spot", field, &known) == .Some("Point"))
	assert(written("Handle", param, &known) == .Some("&var Point"))
	// A function pointer is a function type, whose parts are read as a
	// field's are, and a second name for one is read as it.
	assert(written("int (*)(void)", param, &known) == .Some("() => c_int"))

	assert(
		written("int (*)(const void *, const void *)", param, &known) ==
			.Some("(a0: ptr<void>, a1: ptr<void>) => c_int"),
	)

	assert(
		written("void (*)(Point *, int (*)(int))", param, &known) ==
			.Some("(a0: ptr<Point>, a1: (a0: c_int) => c_int) => void"),
	)

	known.aliases.put("Callback", "unsigned char *(*)(const char *, int *)")

	assert(
		written("Callback", param, &known) ==
			.Some("(a0: cstring, a1: ptr<c_int>) => ptr<c_uchar>"),
	)

	// A variadic one, and one taking C's list of variadic arguments, are
	// not written.
	assert(written("int (*)(const char *, ...)", param, &known).isNone())
	assert(written("void (*)(int, va_list)", param, &known).isNone())
	assert(written("int (*[4])(int)", field, &known).isNone())
}

@test
fn aFunctionPointerThatCKeepsMayBeNull() = {
	var known = Known()

	val .Some(callback) = at("void (*)(int)", .Field, &known) else {
		assert(false, "a function pointer is read")
		return
	}

	assert(stored(move callback).text() == "Option<(a0: c_int) => void>")

	val .Some(count) = at("int", .Field, &known) else {
		assert(false, "an int is read")
		return
	}

	assert(stored(move count).text() == "c_int")
}

@test
fn anEnumIsAnIntAndAPointerSizedIntegerIsNamedAsCNamesIt() = {
	var known = Known()
	known.enums.add("Color")
	val field = Where::Field
	assert(written("Color", field, &known) == .Some("c_int"))
	assert(written("enum Color", field, &known) == .Some("c_int"))
	assert(written("uintptr_t", field, &known) == .Some("uintptr_t"))
	assert(written("ssize_t", field, &known) == .Some("ssize_t"))
}

@test
fn whatCannotCrossIsLeftOut() = {
	var known = Known()
	known.records.add("Handle")
	known.left.add("Hooks")
	val field = Where::Field
	// C passes a struct by value in registers, and a Wip function value
	// takes its address, so such a function pointer is not written.
	assert(written("void (*)(Handle, void *)", field, &known).isNone())
	assert(written("Handle (*)(void)", field, &known).isNone())

	assert(written("void (*)(Handle *)", field, &known) == .Some("(a0: ptr<Handle>) => void"))

	// A struct the binding left out is left out wherever it is used.
	assert(written("const Hooks *", Where::Parameter, &known).isNone())
}
