// A C header in, what it declares out.
//
// Nothing here parses C. The C compiler is already required for Wip's
// runtime, so it is asked instead: `clang -Xclang -ast-dump=json` for the
// declarations, and `cc -E -dD` for the constants a header `#define`s.

import std::collections::{Set}
import std::json::{Json}
import std::path
import clang
import clang::{children, flag, inner, only, qualType, textOf, writtenType}
import declared::{Header, Item, Reading, Typed}
import mapped::{Mapping}
import mapped
import probe
import types::{Constant, Known, Ty}
import types

/// Reads `header` with the C compiler, as `reading` says to, and answers
/// what it declares, or why it cannot.
pub fn read(
	header: str,
	include: str,
	link: Option<String>,
	reading: &Reading,
	mappings: &[Mapping],
	pointers: &[String],
): Result<Header, String> = {
	val tree = syntaxTree(header, reading)?

	var read = Header(include: include, link: link, defines: reading.defines.clone())

	// What the header says a value of is, which decides whether a pointer
	// to one is a reference.
	var known = Known()
	definedRecords(&tree, &var known)
	enumNames(&tree, &var known)
	aliases(&tree, &var known)
	for mapping in mappings {
		known.mapped.put(recordOf(&known, mapping.c), mapping.name())
	}
	for name in pointers {
		known.pointers.add(name.clone())
	}
	declarations(&tree, path::name(header), &var known, &var read)
	declaredElsewhere(&var read)
	declaredAs(header, reading, &known, mappings, &var read)?
	constants(header, reading, &known, &var read)?

	return .Ok(read)
}

/// A struct the header names and another header declares — Vulkan's name
/// its video codecs', which `vulkan_core.h` includes — is a type of its own
/// to the binding, whose contents it does not know: where it is only
/// pointed at, it is declared as one. What holds one by value is left out,
/// since its fields are the other header's, and so is what holds a struct
/// C alone lays out, of bitfields, which Wip has no value of; and then what
/// holds what was left out, until nothing more is.
fn declaredElsewhere(out: &var Header) = {
	var leftOut: Set<String> = Set()
	var leaving = true
	while leaving {
		leaving = false
		var holdable: Set<String> = Set()
		var opaque: Set<String> = Set()
		for item in out.items {
			if item is .Record(name, opaque: laidOutByC, ..) {
				if laidOutByC then opaque.add(name.clone()) else holdable.add(name.clone())
			}
		}
		var kept: Vec<Item> = Vec()
		for item in move out.items {
			var held: Vec<String> = Vec()
			var pointed: Vec<String> = Vec()
			for ty in typesOf(&item) {
				namedIn(ty, false, &var held, &var pointed)
			}
			match held.find((name) => !holdable.contains(name)) {
				.Some(name) => {
					val why =
						if opaque.contains(name) then "a struct C alone lays out"
						else if leftOut.contains(name) then "a struct left out"
						else "a struct another header declares"
					out.skipped.push("`\(nameOf(&item))`, which holds \(why), `\(name)`")
					leftOut.add(nameOf(&item))
					leaving = true
				}
				.None => kept.push(item)
			}
		}
		out.items = kept
	}
	var declared: Set<String> = Set()
	for item in out.items {
		match item {
			.Record(name, ..) | .Opaque(name) => declared.add(name.clone())
			_ => {}
		}
	}
	var pointedAt: Vec<String> = Vec()
	for item in out.items {
		var held: Vec<String> = Vec()
		var pointed: Vec<String> = Vec()
		for ty in typesOf(&item) {
			namedIn(ty, false, &var held, &var pointed)
		}
		for name in pointed {
			if !declared.contains(&name) && !pointedAt.contains(&name) then
				pointedAt.push(name.clone())
		}
	}
	for name in pointedAt {
		out.items.push(.Opaque(name.clone()))
	}
}

/// The types an item is written with.
fn typesOf(item: &Item): Vec<&Ty> = {
	var tys: Vec<&Ty> = Vec()
	match item {
		.Function(params, ret, ..) => {
			for param in params {
				tys.push(&param.ty)
			}
			if ret is .Some(ty) then tys.push(&ty)
		}
		.Record(fields, ..) => {
			for field in fields {
				tys.push(&field.ty)
			}
		}
		.Variable(ty, ..) => tys.push(&ty)
		.Opaque(..) | .Constant(..) => {}
	}
	return tys
}

/// The structs `ty` names: in `pointed` those behind a pointer, and in
/// `held` those it holds.
fn namedIn(ty: &Ty, behind: bool, held: &var Vec<String>, pointed: &var Vec<String>) = match ty {
	.Tag(name) => if behind then pointed.push(name.clone()) else held.push(name.clone())
	.Pointer(target) | .Ref(target, ..) => namedIn(&target, true, &var held, &var pointed)
	.Array(element, ..) => namedIn(&element, behind, &var held, &var pointed)
	.Nullable(target) => namedIn(&target, behind, &var held, &var pointed)
	.Function(params, result) => {
		for param in params {
			namedIn(&param, behind, &var held, &var pointed)
		}
		namedIn(&result, behind, &var held, &var pointed)
	}
	.Named(..) | .Mapped(..) | .Void => {}
}

/// What an item is called.
fn nameOf(item: &Item): String = match item {
	.Function(name, ..) | .Record(name, ..) | .Opaque(name) | .Variable(name, ..) => name.clone()
	.Constant(constant) => constant.name.clone()
}

/// The struct a C name is: itself, or the struct a `typedef` of it names.
fn recordOf(known: &Known, name: str): String = match known.aliases.get(name) {
	.Some(target) if known.records.contains(&target) => target.clone()
	_ => String::of(name)
}

/// Each struct `--type` declares as a Wip type: checked to be laid out as
/// it, and left out of what the module declares, which imports the Wip
/// type instead.
fn declaredAs(
	header: str,
	reading: &Reading,
	known: &Known,
	mappings: &[Mapping],
	out: &var Header,
): Result<void, String> = {
	// Each module, and the types imported from it, in the order named.
	var imported: Vec<(String, Vec<String>)> = Vec()
	for mapping in mappings {
		val name = recordOf(&known, mapping.c)
		var found: Option<i64> = .None
		for i in 0..out.items.len() {
			if out.items[i] is .Record(name: declared, ..) && declared == name then found = .Some(i)
		}
		val .Some(at) = found else {
			return .Err("`--type \(mapping.c)=\(mapping.wip)`: the header declares no struct `\(mapping.c)` with its fields")
		}
		val .Record(isUnion, opaque, fields, ..) = out.items.remove(at) else panic("just found")
		if isUnion || opaque then
			return .Err("`--type \(mapping.c)=\(mapping.wip)`: `\(mapping.c)` is laid out by C alone, a union or a struct of bitfields")
		// C spells it by a `typedef` where one names it, and as a struct
		// where none does.
		val spelled =
			if known.typedefs.contains(&mapping.c) then mapping.c.clone() else "struct \(name)"
		mapped::check(header, reading, mapping, spelled, &fields, mappings)?
		val module = mapping.module()
		var at: Option<i64> = .None
		for i in 0..imported.len() {
			if imported[i].0 == module then at = .Some(i)
		}
		match at {
			.Some(i) => imported[i].1.push(mapping.name())
			.None => imported.push((module, Vec::of(own [mapping.name()])))
		}
	}
	for (module, names) in imported {
		out.imports.push("\(module)::{\(names.join(", "))}")
	}
	return .Ok()
}

/// The compiler's own view of the header, as JSON. It is clang's, and
/// clang says the format is for testing, so what is not understood is
/// said rather than guessed at.
fn syntaxTree(header: str, reading: &Reading): Result<Json, String> = {
	val cc = clang::clang()
	val options = ["-Xclang", "-ast-dump=json", "-fsyntax-only"]
	val output = clang::run(cc, &options, &reading, [header], .None)?

	if !output.exit.success() then
		return .Err("`\(cc)` could not read the header:\n\(output.stderr)")

	return clang::tree(cc, &output, "the header")
}

/// The macros a header defines, which are what C libraries use for
/// constants. The preprocessor is asked to keep the `#define`s in place
/// (`-dD`) rather than to list them all (`-dM`), so that the line markers
/// say which file each one came from: a header that includes `<stdint.h>`
/// is not also binding `INT8_MAX`.
fn constants(
	header: str,
	reading: &Reading,
	known: &Known,
	out: &var Header,
): Result<void, String> = {
	val cc = clang::compiler("cc")
	val output = clang::run(cc, ["-E", "-dD", "-x", "c"], &reading, [header], .None)?

	if !output.exit.success() then
		return .Err("`\(cc)` could not read the header:\n\(output.stderr)")

	val name = path::name(header)
	var here = false
	// Each `#define`, in the header's order, and what a literal it is; the
	// rest are asked of clang, all at once.
	var found: Vec<(String, Option<Constant>)> = Vec()
	var asked: Vec<String> = Vec()

	for line in output.stdout.lines() {
		// `# 12 "shapes.h"`: what follows comes from that file.
		if line.stripPrefix("# ") is .Some(marker) && quotedIn(marker) is .Some(quoted) {
			here = quoted.endsWith(name)
			continue
		}

		if !here then continue

		val .Some(rest) = line.stripPrefix("#define ") else continue

		val .Some((defined, value)) = rest.splitOnce(" ") else continue

		// A macro that takes arguments is not a constant, and what it
		// means depends on what is passed.
		if defined.contains("(") || !types::isName(defined) || value.trim().isEmpty() then continue
		val literal = types::constant(defined, value.trim())
		if literal.isNone() then asked.push(defined)
		found.push((defined, literal))
	}

	var answers = probe::ask(header, reading, &asked, &out.items, known)?

	for (_, literal) in move found {
		match move literal {
			.Some(constant) => out.items.push(.Constant(constant: constant))
			.None => {
				match answers.remove(0) {
					.Written(constant) => out.items.push(.Constant(constant: constant))
					.Left(why) => out.skipped.push(why)
				}
			}
		}
	}

	return .Ok()
}

/// What a line marker names, `shapes.h` of `12 "shapes.h" 2`: what comes
/// after the first `"`, up to the next.
fn quotedIn(marker: str): Option<str> = {
	val (_, rest) = marker.splitOnce("\"")?
	return match rest.splitOnce("\"") {
		.Some((quoted, _)) => .Some(quoted)
		.None => .Some(rest)
	}
}

/// The structs and unions this translation unit defines, anywhere in it:
/// a header may use one another header defined.
fn definedRecords(node: &Json, known: &var Known) = {
	if textOf(node, "kind") == .Some("RecordDecl") &&
		flag(node, "completeDefinition") &&
		textOf(node, "name") is .Some(name) {
		known.records.add(name)
	}

	if inner(node) is .Some(children) {
		for child in children.items() {
			definedRecords(child, &var known)
		}
	}
}

/// The enums the translation unit names — `enum Color { … }`, and
/// `typedef enum { … } Color;` — which a type that names one is read as
/// `c_int`, as their enumerators are written.
fn enumNames(node: &Json, known: &var Known) = {
	if textOf(node, "kind") == .Some("EnumDecl") && textOf(node, "name") is .Some(name) then
		known.enums.add(name)

	if textOf(node, "kind") == .Some("TypedefDecl") &&
		textOf(node, "name") is .Some(name) &&
		writtenType(node) is .Some(written) &&
		written.trim().startsWith("enum ") {
		known.enums.add(name)
	}

	if inner(node) is .Some(children) {
		for child in children.items() {
			enumNames(child, &var known)
		}
	}
}

/// `typedef Texture Texture2D;`: a second name for a type the header
/// already declares. Wip writes the first one, so a use of the second is
/// read as it. A typedef of a struct written in place —
/// `typedef struct { … } Color;` — names the struct itself and is not one
/// of these.
fn aliases(node: &Json, known: &var Known) = {
	if textOf(node, "kind") == .Some("TypedefDecl") && textOf(node, "name") is .Some(name) then
		known.typedefs.add(name)
	if textOf(node, "kind") == .Some("TypedefDecl") &&
		textOf(node, "name") is .Some(name) &&
		writtenType(node) is .Some(written) {
		val trimmed = written.trim()
		var target = trimmed
		for keyword in ["struct ", "union ", "enum "] {
			if trimmed.stripPrefix(keyword) is .Some(name) {
				target = name
				break
			}
		}
		if target != name then known.aliases.put(name, target)
	}

	if inner(node) is .Some(children) {
		for child in children.items() {
			aliases(child, &var known)
		}
	}
}

/// Walks the translation unit, keeping what the named header declared.
/// clang writes a declaration's file only when it changes, so the file it
/// last named is the one that holds what follows.
fn declarations(tree: &Json, header: str, known: &var Known, out: &var Header) = {
	val .Some(nodes) = inner(tree) else return

	var file = String()

	for node in nodes.items() {
		if node.get("loc").flatMap((loc) => textOf(loc, "file")) is .Some(named) then file = named

		if !file.endsWith(header) || flag(node, "isImplicit") then continue

		match textOf(node, "kind") {
			.Some("FunctionDecl") => function(node, &known, &var out)
			.Some("RecordDecl") => record(node, &var known, &var out)
			.Some("VarDecl") => variable(node, &known, &var out)
			.Some("EnumDecl") => enumeration(node, &known, &var out)
			// A typedef of a struct is the struct, which is declared beside
			// it; a typedef of a scalar is a name for a type Wip has.
			.Some("TypedefDecl" | "EmptyDecl" | "StaticAssertDecl") => {}
			.Some(kind) => out.skipped.push("a \(kind) the tool does not read")
			.None => {}
		}
	}
}

fn function(node: &Json, known: &Known, out: &var Header) = {
	val .Some(name) = textOf(node, "name") else return

	// A `static` function that is not `inline` belongs to one translation
	// unit, so nothing outside the header could call it.
	val inline = flag(node, "inline")
	if textOf(node, "storageClass") == .Some("static") && !inline then return
	val signature = qualType(node)
	val variadic = flag(node, "variadic")

	val found = match signature.splitOnce("(") {
		.Some((before, _)) => types::at(before.trim(), .Field, known)
		.None => .None
	}

	val .Some(ret) = move found else {
		out.skipped.push("`\(name)`, whose result Wip has no type for")
		return
	}

	var params: Vec<Typed> = Vec()
	var i = 0
	// The parameter before, by name: a struct pointer after a count is an
	// array.
	var before = String()

	for param in children(node, "ParmVarDecl") {
		val written = qualType(param)

		val .Some(read) = types::at(written, .Parameter, known) else {
			out.skipped.push("`\(name)`, whose parameter \(i) is `\(written)`")
			return
		}

		val given = match textOf(param, "name") {
			.Some(given) if !given.isEmpty() => String::of(given)
			_ => "a\(i)"
		}

		// A struct pointer right after a count is an array, which may be
		// empty and null, and so is one the command line names: a pointer,
		// whatever the header says it points at.
		val counted = before == "count" || before.endsWith("Count")
		val ty = match move read {
			.Ref(target) =>
				if counted || known.pointers.contains(&given) then Ty::Pointer(target)
				else Ty::Ref(target)
			other => other
		}

		before = given.clone()
		params.push(Typed(name: given, ty: ty))
		i += 1
	}

	val result: Option<Ty> = if ret.isVoid() then .None else .Some(ret)

	out.items.push(.Function(
		name: name,
		params: params,
		ret: result,
		variadic: variadic,
		inline: inline,
	))
}

fn record(node: &Json, known: &var Known, out: &var Header) = {
	val .Some(name) = textOf(node, "name") else {
		// An anonymous struct or union is a field's type, and needs a name
		// of its own before Wip can write it.
		out.skipped.push("an anonymous struct or union, which needs a name")
		return
	}

	val isUnion = textOf(node, "tagUsed") == .Some("union")

	// `struct sqlite3;` with no body: a type whose contents Wip does not
	// know.
	if !flag(node, "completeDefinition") {
		out.items.push(.Opaque(name))
		return
	}

	var fields: Vec<Typed> = Vec()
	var opaque = false
	// `#pragma pack(n)`, whose `n` clang's tree does not say: the layout is
	// C's, as a bitfield's is.
	if !children(node, "MaxFieldAlignmentAttr").isEmpty() then opaque = true
	val packed = !children(node, "PackedAttr").isEmpty()
	val align = alignment(node)

	for field in children(node, "FieldDecl") {
		// A bitfield's place in the storage unit differs between ABIs, so
		// Wip lays the struct out not at all.
		if flag(field, "isBitfield") then opaque = true
		val written = qualType(field)
		val given = textOf(field, "name").unwrapOr("")
		val found = types::at(written, .Field, &known)

		if given.isEmpty() || found.isNone() {
			out.skipped.push("`\(name)`, whose field `\(given)` is `\(written)`")
			// What uses it is left out too: the type is not in the file.
			known.left.add(name)
			return
		}

		fields.push(Typed(name: given, ty: types::stored(found.unwrap()), align: alignment(field)))
	}

	// A layout C keeps to itself says nothing of how it is packed.
	out.items.push(.Record(
		name: name,
		isUnion: isUnion,
		opaque: opaque,
		packed: packed && !opaque,
		align: if opaque then .None else align,
		fields: fields,
	))
}

/// What an `__attribute__((aligned(n)))` or an `alignas(n)` on the
/// declaration says `n` is, where it says one: the value clang worked out.
fn alignment(node: &Json): Option<i64> = {
	for attr in children(node, "AlignedAttr") {
		if only(attr) is .Some(value) && textOf(value, "value") is .Some(text) then
			return text.toInt().toOption()
	}
	return .None
}

fn variable(node: &Json, known: &Known, out: &var Header) = {
	val .Some(name) = textOf(node, "name") else return

	val written = qualType(node)
	val found = types::at(written, .Field, known)

	// A `static const` number the header gives a value is a constant, as a
	// `#define` is: Vulkan's 64-bit flags are written so, being past what
	// an enum holds.
	if textOf(node, "storageClass") == .Some("static") &&
		written.startsWith("const ") &&
		found is .Some(.Named(scalar)) &&
		scalar != "cstring" &&
		scalar != "bool" &&
		probe::evaluatedText(node) is .Some(value) {
		out.items.push(.Constant(constant: Constant(name: name, ty: scalar.clone(), value: value)))
		return
	}

	if found.all((ty) => !ty.isVoid()) && found.isSome() then
		out.items.push(.Variable(name: name, ty: types::stored(found.unwrap())))
	else out.skipped.push("`\(name)`, a variable of type `\(written)`")
}

/// C's enums are integers, and a value outside the listed ones is legal
/// C, so each enumerator becomes a constant rather than a Wip enum.
fn enumeration(node: &Json, known: &Known, out: &var Header) = {
	// The type C gives the enumerators: an `int`, unless one of the enum's
	// is past one, and then the enum's own, which that one has. A clang
	// before C23's rule gives the others `int` still, so the one past it
	// decides for all, whichever clang is asked.
	var ty = String::of("c_int")
	for constant in children(node, "EnumConstantDecl") {
		if types::at(qualType(constant), .Field, known) is .Some(.Named(scalar)) &&
			scalar != "c_int" {
			ty = scalar.clone()
		}
	}
	var next = 0
	for constant in children(node, "EnumConstantDecl") {
		val .Some(name) = textOf(constant, "name") else continue
		val value = probe::evaluated(constant).unwrapOr(next)
		next = value + 1
		out.items.push(.Constant(constant: types::enumerator(name, value, ty.clone())))
	}
}
