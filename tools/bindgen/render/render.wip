// What the tool writes: ordinary Wip source, which a person reads, edits
// and commits.

import declared::{Header, Item}
import types::{wipName}

/// The module the header becomes, as its file holds it.
pub fn render(header: &Header, module: str): String = {
	var out = String()
	out.push("// Written by `wip bindgen` from \(header.include). It is ordinary\n")
	out.push("// Wip source: read it, change what is wrong, and commit it.\n")
	if !module.isEmpty() then out.push("//\n// The module is `\(module)`.\n")

	out.push("\n")

	// The types first, since the declarations below use them. They go in
	// one block, which says `extern` and names the header once for all of
	// them.
	var types: Vec<String> = Vec()

	for item in header.items.items() {
		match item {
			.Opaque(name) => types.push("    pub type \(wipName(name.toStr()))")
			.Record(name, isUnion, opaque, fields) => {
				val keyword = if isUnion then "union" else "struct"
				var written = String()
				if opaque then written.push("    @opaque\n")
				written.push("    pub \(keyword) \(wipName(name.toStr())) {\n")

				// One field to a line, as `wip fmt` writes them: a line
				// break separates them.
				val lines = fields.map((field) =>
					"        \(wipName(field.name.toStr())): \(field.ty.text())")

				written.push("\(lines.join("\n"))\n    }")
				types.push(move written)
			}
			_ => {}
		}
	}

	// Then the constants, which a program uses as arguments.
	var constants = 0

	for item in header.items.items() {
		if item is .Constant(constant) {
			out.push("pub val \(wipName(constant.name.toStr())): \(constant.ty) = \(constant.value)\n")
			constants += 1
		}
	}

	if constants > 0 then out.push("\n")

	// The functions and variables, in one block per way of reaching them.
	var block = String()
	var behindHeader = String()

	for item in header.items.items() {
		match item {
			.Function(name, params, ret, variadic, inline) => {
				var written = params.map((param) =>
					"\(wipName(param.name.toStr())): \(param.ty.text())")

				if variadic then written.push(String::of("..."))

				val result = match ret {
					.Some(ty) => ": \(ty.text())"
					.None => String()
				}

				var line = String()
				// A `static inline` function has no symbol to link against,
				// so its call goes through C that includes the header, which
				// its own `@header` says.
				if inline then line.push("    @header(\"\(header.include)\")\n")
				val wip = wipName(name.toStr())
				if wip != name then line.push("    @symbol(\"\(name)\")\n")
				line.push("    pub fn \(wip)(\(written.join(", ")))\(result)\n")
				if inline then behindHeader.push(line.toStr()) else block.push(line.toStr())
			}
			.Variable(name, ty) => {
				val wip = wipName(name.toStr())
				if wip != name then block.push("    @symbol(\"\(name)\")\n")
				block.push("    pub var \(wip): \(ty.text())\n")
			}
			_ => {}
		}
	}

	// One block holds all of it: the types C lays out, the functions and
	// variables it exports, and the ones its header defines rather than
	// declares. The block says `extern` once, names the library once and
	// the header once, and what is inside it is in the order a reader
	// wants — the types first.
	var body = String()
	if !types.isEmpty() then body.push("\(types.join("\n\n"))\n\n")
	body.push(block.toStr())

	if !behindHeader.isEmpty() {
		if !block.isEmpty() then body.push("\n")
		body.push("    // These have no symbol to link against: they are `inline`,\n")
		body.push("    // so each call goes through the header.\n")
		body.push(behindHeader.toStr())
	}

	if !body.isEmpty() {
		if header.link is .Some(library) then out.push("@link(\"\(library)\")\n")

		// The header declares the types to C as well, so a call that
		// still needs a wrapper reads them from it rather than declaring
		// them a second time — which C would read as a conflict wherever a
		// type is written differently.
		// What the header was read with, the C is compiled with, or the
		// two would disagree about what it declares.
		if !header.defines.isEmpty() {
			val written = header.defines.map((define) => "\"\(define)\"")
			out.push("@define(\(written.join(", ")))\n")
		}

		out.push("@header(\"\(header.include)\")\n")
		out.push("extern \"C\" {\n\(body.toStr().trimEnd())\n}\n\n")
	}

	if !header.skipped.isEmpty() {
		out.push("// What this header has and this file does not:\n")
		for skipped in header.skipped.items() {
			out.push("//   - \(skipped)\n")
		}
	}

	return move out
}
