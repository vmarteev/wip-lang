// A body fetched from a server the test starts, written to a file as it
// comes, and a status that is not a success kept as the answer it is.

import std::fs
import std::future
import std::http::{Client}
import std::io
import std::net::{Listener}

/// Answers one request with `answer`, having read its head.
fn answerOnce(listener: &Listener, answer: str) = {
	var (stream, _) = listener.accept().unwrap()
	var room = [0 as u8; 4096]
	stream.read(&var room).unwrap()
	stream.writeText(answer).unwrap()
}

@test
fn aBodyIsWrittenToAFileAsItComes() = {
	val listener = Listener::tcp(.Some("127.0.0.1"), 0).unwrap()
	val .Ok(.V4(port: port, ..)) = listener.localAddress() else panic("an IPv4 address")
	val dir = fs::TempDir::new().unwrap()
	val path = dir.join("page")
	val answer = "HTTP/1.1 200 OK\r\nContent-Length: 12\r\nConnection: close\r\n\r\nhello, fetch"
	val (_, status) = future::both(
		() => answerOnce(&listener, answer),
		() => {
			var client = Client()
			var file = fs::File::create(&path).unwrap()
			return fetch(&var client, "http://127.0.0.1:\(port)/", false, &var file).unwrap()
		},
	)
	assert(status == 200 && fs::readFile(&path).unwrap() == "hello, fetch")
}

@test
fn aStatusThatIsNotASuccessIsAnswered() = {
	val listener = Listener::tcp(.Some("127.0.0.1"), 0).unwrap()
	val .Ok(.V4(port: port, ..)) = listener.localAddress() else panic("an IPv4 address")
	val answer = "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
	val (_, status) = future::both(
		() => answerOnce(&listener, answer),
		() => {
			var client = Client()
			var out = io::stdout()
			return fetch(&var client, "http://127.0.0.1:\(port)/missing", false, &var out).unwrap()
		},
	)
	assert(status == 404)
}
