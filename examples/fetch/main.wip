// Fetches a URL: `wip run examples/fetch/main.wip https://example.com/`.

import std::args::{ArgumentError, Arguments}
import std::fs
import std::http::{Client, Request}
import std::io
import std::time::{Duration}

val USAGE = """
	usage: fetch [-i] [-o file] [-t seconds] url

	Fetches the URL and prints its body, or writes it to a file as it comes,
	however large; gzip is asked for and undone.

	  -i, --include           print the status and the headers first
	  -o, --output file       write the body to this file
	  -t, --timeout seconds   give up when nothing comes for this long
	  -h, --help              print this
	"""

fn main(args: &[cstring]): Result<i64, ArgumentError> = {
	var include = false
	var output: Option<String> = .None
	var timeout = 30
	var url: Option<String> = .None
	var arguments = Arguments::of(&args)
	while arguments.next()? is .Some(argument) {
		match argument {
			.Short('i') | .Long("include") => include = true
			.Short('o') | .Long("output") => output = .Some(arguments.value()?)
			.Short('t') | .Long("timeout") => timeout = arguments.int()?
			.Short('h') | .Long("help") => {
				io::print(USAGE)
				return .Ok(0)
			}
			.Positional(text) => url = .Some(String::of(text))
			_ => return .Err(argument.unexpected())
		}
	}
	val .Some(target) = url else {
		io::eprint(USAGE)
		return .Ok(2)
	}
	var client = Client()
	client.timeout = .Some(Duration::seconds(timeout))
	val written = match output {
		.Some(path) => match fs::File::create(&path) {
			.Ok(opened) => {
				var file = opened
				fetch(&var client, &target, include, &var file)
			}
			.Err(error) => {
				io::eprintln("error: cannot write `\(path)`: \(error)")
				return .Ok(1)
			}
		}
		.None => {
			var out = io::stdout()
			fetch(&var client, &target, include, &var out)
		}
	}
	return match written {
		.Ok(status) => .Ok(if status >= 200 && status < 400 then 0 else 1)
		.Err(why) => {
			io::eprintln("error: \(why)")
			Result::Ok(1)
		}
	}
}
