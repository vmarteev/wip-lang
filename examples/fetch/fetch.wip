// What fetching is, apart from the command line: a request sent, and its
// body written as it comes to any `io::Write` — a file, or standard output
// — so that a body larger than memory is never held whole.

import std::http::{Client, HttpError, Request}
import std::io

/// `url` fetched by `client`, its status and headers printed first where
/// `include` says, and its body written to `to` as it comes; its status.
pub fn fetch(
	client: &var Client,
	url: str,
	include: bool,
	to: &var dyn io::Write,
): Result<i64, String> = {
	var incoming = match client.open(Request::get(url)) {
		.Ok(incoming) => incoming
		.Err(error) => return .Err("\(error)")
	}
	if include {
		io::println("\(incoming.status)")
		for header in incoming.headers {
			io::println("\(header.name): \(header.value)")
		}
		io::println("")
	}
	return match io::copy(&var incoming, &var to) {
		.Ok(_) => .Ok(incoming.status)
		.Err(error) => .Err("\(error)")
	}
}
