// Reads a JSON document and writes it again, indented, with its keys
// sorted where asked.

import std::args::{ArgumentError, Arguments}
import std::fs
import std::io
import std::json

val USAGE = """
	usage: json-pretty [-i spaces] [-s] [-c] [file]

	Reads a JSON document from the file, or from standard input where there
	is none or it is `-`, and writes it indented.

	  -i, --indent spaces   spaces to an indent, 2 unless said
	  -s, --sort-keys       write each object's keys in order
	  -c, --compact         write it on one line, with no spaces
	  -h, --help            print this
	"""

fn main(args: &[cstring]): Result<i64, ArgumentError> = {
	var layout = Layout()
	var compact = false
	var file = "-"
	var arguments = Arguments::of(&args)

	while arguments.next()? is .Some(argument) {
		match argument {
			.Short('i') | .Long("indent") => layout.indent = arguments.int()?
			.Short('s') | .Long("sort-keys") => layout.sortKeys = true
			.Short('c') | .Long("compact") => compact = true
			.Short('h') | .Long("help") => {
				io::print(USAGE)
				return .Ok(0)
			}
			.Positional(name) => file = name
			_ => return .Err(argument.unexpected())
		}
	}

	val .Some(text) = read(file) else {
		return .Ok(1)
	}

	match json::parse(text) {
		.Ok(document) =>
			if compact then io::println("\(document)") else io::print(pretty(&document, &layout))
		.Err(error) => {
			io::eprintln("error: \(if file == "-" then "standard input" else file): \(error)")
			return .Ok(1)
		}
	}

	return .Ok(0)
}

/// The file's text, or standard input's for `-`, or nothing once the
/// error is said.
fn read(file: str): Option<String> = {
	if file != "-" {
		match fs::readFile(file) {
			.Ok(text) => return .Some(move text)
			.Err(error) => io::eprintln("error: cannot read \(file): \(error)")
		}
		return .None
	}

	var text = String()
	var input = io::stdin()

	if input.readAll(&var text) is .Err(error) {
		io::eprintln("error: cannot read standard input: \(error)")
		return .None
	}

	return .Some(move text)
}
