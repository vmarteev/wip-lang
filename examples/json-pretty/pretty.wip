// A JSON value written over lines, one element or field to a line.

import std::json::{Json}

/// How it is laid out.
pub struct Layout {
	pub var indent: i64 = 2
	pub var sortKeys: bool = false
}

/// The document written over lines, each nested value one indent deeper,
/// ending with a line break.
pub fn pretty(value: &Json, layout: &Layout): String = {
	var out = String()
	write(&value, &layout, 0, &var out)
	out.push("\n")
	return move out
}

// A value at `depth`, which is where its own lines begin; what holds it has
// written what comes before it on the first.
fn write(value: &Json, layout: &Layout, depth: i64, out: &var String) = match value {
	.Array(items) => {
		if items.isEmpty() {
			out.push("[]")
			return
		}

		out.push("[\n")

		for i in 0..items.len() {
			indent(&layout, depth + 1, &var out)
			write(&items[i], &layout, depth + 1, &var out)
			out.push(if i + 1 < items.len() then ",\n" else "\n")
		}

		indent(&layout, depth, &var out)
		out.push("]")
	}
	.Object(fields) => {
		if fields.isEmpty() {
			out.push("{}")
			return
		}

		out.push("{\n")
		val order = keyOrder(&fields, layout.sortKeys)

		for i in 0..order.len() {
			val (key, field) = fields[order[i]]
			indent(&layout, depth + 1, &var out)
			// A key is written as a JSON string is, escapes and all.
			out.push("\(Json::Text(text: key.clone())): ")
			write(&field, &layout, depth + 1, &var out)
			out.push(if i + 1 < order.len() then ",\n" else "\n")
		}

		indent(&layout, depth, &var out)
		out.push("}")
	}
	// Anything else is written as it is compact.
	_ => value.appendTo(&var out)
}

fn indent(layout: &Layout, depth: i64, out: &var String) = {
	for _ in 0..depth * layout.indent {
		out.pushChar(' ')
	}
}

/// The positions of an object's fields in the order they are written: as
/// they are, or by key.
fn keyOrder(fields: &Vec<(String, Json)>, sorted: bool): Vec<i64> = {
	var order: Vec<i64> = Vec()
	for i in 0..fields.len() {
		order.push(i)
	}
	if sorted then order.sortBy((a, b) => fields[a].0 < fields[b].0)
	return move order
}
