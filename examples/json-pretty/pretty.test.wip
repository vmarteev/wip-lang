import std::json

@test
fn aDocumentIsWrittenOverLines() = {
	val .Ok(document) = json::parse("{\"name\": \"wip\", \"tags\": [1, 2.5], \"none\": {}}") else {
		assert(false, "the document parses")
		return
	}

	val written = pretty(&document, Layout())

	assert(
		written ==
			"""
				{
				  "name": "wip",
				  "tags": [
				    1,
				    2.5
				  ],
				  "none": {}
				}

				""",
	)
}

@test
fn keysAreSortedWhereAsked() = {
	val .Ok(document) = json::parse("{\"b\": 1, \"a\": [], \"c\\\"\": null}") else {
		assert(false, "the document parses")
		return
	}
	val written = pretty(&document, Layout(indent: 4, sortKeys: true))
	assert(written == "{\n    \"a\": [],\n    \"b\": 1,\n    \"c\\\"\": null\n}\n")
}
