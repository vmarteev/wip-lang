// A program that is a package, depending on a library package beside it:
// `geometry`, whose modules it imports as it imports `std`'s.

import geometry
import geometry::{Shape, largest}
import std::io

fn main() = {
	val shapes = Vec::of(own [
		Shape::Circle(radius: 1.5),
		Shape::Rectangle(width: 2.0, height: 3.0),
		Shape::Square(side: 2.5),
	])

	for shape in shapes {
		io::println("\(shape, width: 32) area \(shape.area())")
	}

	io::println("the largest is \(largest(&shapes.items()))")
	io::println("\(package::NAME) \(package::VERSION), with geometry \(geometry::version())")
}
