// Shapes and their areas: a library package, which a program uses by
// depending on it in its `package.wip`.

import internal::measure

/// A shape on the plane.
@derive(Eq, Text)
pub enum Shape {
	Circle(radius: f64)
	Rectangle(width: f64, height: f64)
	Square(side: f64)
}

extend Shape {
	/// How much of the plane it covers, rounded to two places.
	pub fn area(): f64 = measure::rounded(
		match self {
			.Circle(radius) => measure::PI * radius * radius
			.Rectangle(width, height) => width * height
			.Square(side) => side * side
		},
	)
}

/// The shape that covers most, or the first of those that cover as much.
pub fn largest(shapes: &[Shape]): &Shape = {
	var best = 0
	for i in 1..shapes.len() {
		if shapes[i].area() > shapes[best].area() then best = i
	}
	lend shapes[best]
}

/// This package's version, as its own `package.wip` says it.
pub fn version(): str = package::VERSION
