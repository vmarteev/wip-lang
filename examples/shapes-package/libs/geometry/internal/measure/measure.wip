// What `geometry` measures with. A module under `internal/` is its
// package's own: `geometry`'s modules import it, and a program that
// depends on `geometry` may not.

pub val PI: f64 = 3.141592653589793

/// `value` rounded to two places.
pub fn rounded(value: f64): f64 = (value * 100.0).round() / 100.0
