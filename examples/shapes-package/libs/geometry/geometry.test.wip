@test
fn eachShapeHasItsArea() = {
	assert(Shape::Circle(radius: 1.0).area() == 3.14)
	assert(Shape::Rectangle(width: 2.0, height: 3.5).area() == 7.0)
	assert(Shape::Square(side: 3.0).area() == 9.0)
}

@test
fn theLargestIsFound() = {
	val shapes = [Shape::Square(side: 1.0), Shape::Circle(radius: 1.0), Shape::Square(side: 1.5)]
	assert(largest(&shapes) == Shape::Circle(radius: 1.0))
}
