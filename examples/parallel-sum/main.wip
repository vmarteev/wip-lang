// Counts the primes below a limit, on one thread and then on several, and
// says how long each took.

import std::args::{ArgumentError, Arguments}
import std::io
import std::time::{Instant}

val USAGE = """
	usage: parallel-sum [-n limit] [-p parts]

	  -n, --limit n   count the primes below n, 5000000 unless said
	  -p, --parts n   how many parts the work is cut into, 16 unless said
	  -h, --help      print this
	"""

fn main(args: &[cstring]): Result<i64, ArgumentError> = {
	var limit = 5000000
	var parts = 16
	var arguments = Arguments::of(&args)

	while arguments.next()? is .Some(argument) {
		match argument {
			.Short('n') | .Long("limit") => limit = arguments.int()?
			.Short('p') | .Long("parts") => parts = arguments.int()?
			.Short('h') | .Long("help") => {
				io::print(USAGE)
				return .Ok(0)
			}
			_ => return .Err(argument.unexpected())
		}
	}

	parts = parts.max(1)
	timed("one thread", () => countIn(0, limit))
	timed("future::map", () => byMap(limit, parts))
	timed("future::together", () => byHalves(limit))
	timed("future::each", () => byTotal(limit, parts))

	return .Ok(0)
}

/// Runs `work`, and prints what it answered and how long it took.
fn timed(name: str, work: &() => i64) = {
	val start = Instant::now()
	val count = work()
	io::println("\(name, width: 18) \(count) primes in \(start.elapsed())")
}
