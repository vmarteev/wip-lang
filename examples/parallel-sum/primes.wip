// Counting primes, on one thread and on several. The work is the same;
// what differs is how it is shared out, and all three ways borrow what is
// around them, since the call that starts the threads waits for them.

import std::future
import std::sync::{Atomic}

/// Whether `n` is prime, by trial division.
pub fn isPrime(n: i64): bool = {
	if n < 2 then return false
	if n % 2 == 0 then return n == 2
	var d = 3

	while d * d <= n {
		if n % d == 0 then return false
		d += 2
	}

	return true
}

/// The primes in `lo..hi`, counted on this thread.
pub fn countIn(lo: i64, hi: i64): i64 = {
	var count = 0
	for n in lo..hi {
		if isPrime(n) then count += 1
	}
	return count
}

/// `0..limit` cut into `parts` ranges, each a part to count.
pub fn ranges(limit: i64, parts: i64): Vec<(i64, i64)> = {
	var all: Vec<(i64, i64)> = Vec()
	for i in 0..parts {
		all.push((limit * i / parts, limit * (i + 1) / parts))
	}
	return move all
}

/// With `future::map`: each range on a thread, and their counts added up.
pub fn byMap(limit: i64, parts: i64): i64 = {
	val all = ranges(limit, parts)
	val counts = future::map(&all.items(), (range) => countIn(range.0, range.1))
	return counts.fold(0, (sum, count) => sum + count)
}

/// With `future::together`: the two halves, one on another thread.
pub fn byHalves(limit: i64): i64 = {
	val (low, high) = future::together(() => countIn(0, limit / 2), () => countIn(limit / 2, limit))
	return low + high
}

/// With `future::each` and an `Atomic`: each thread adds what it counted to
/// one total, which they all change through a `&` at once.
pub fn byTotal(limit: i64, parts: i64): i64 = {
	val total = Atomic::of(0 as i64)
	var all = ranges(limit, parts)
	future::each(&var all.items(), (range) => { total.add(countIn(range.0, range.1)) })
	return total.load()
}
