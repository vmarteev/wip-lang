@test
fn everyWayCountsTheSame() = {
	assert(countIn(0, 100) == 25)
	assert(byMap(100000, 7) == 9592)
	assert(byHalves(100000) == 9592)
	assert(byTotal(100000, 5) == 9592)
}

@test
fn theRangesCoverTheLimitOnce() = {
	val all = ranges(10, 3)
	assert(all.len() == 3 && all[0] == (0, 3) && all[2] == (6, 10))
}
