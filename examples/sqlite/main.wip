// A query against SQLite, a real C library, which must be installed.
//
// Everything it uses is in the language: `@link` names the library,
// `type sqlite3` is an opaque C type only ever seen through `ptr`, a
// `&var ptr<sqlite3>` is C's `sqlite3 **` out-parameter, `c_int` is C's
// `int` whatever the target makes it, the constants are top-level `val`s,
// `cstring.toStr()` borrows the bytes of a text column, `\(…)` writes a
// `cstring` by walking it, and `defer` closes what was opened.
//
// Expected output: ada is 36, alan is 41, grace is 45, total 122.

import std::io

val SQLITE_OK: c_int = 0
val SQLITE_ROW: c_int = 100
val SQLITE_DONE: c_int = 101

@link("sqlite3")
extern "C" {
	type sqlite3
	type sqlite3_stmt

	fn sqlite3_open(path: cstring, db: &var ptr<sqlite3>): c_int
	fn sqlite3_exec(
		db: ptr<sqlite3>,
		sql: cstring,
		callback: ptr<u8>,
		arg: ptr<u8>,
		error: ptr<u8>,
	): c_int
	fn sqlite3_prepare_v2(
		db: ptr<sqlite3>,
		sql: cstring,
		bytes: c_int,
		stmt: &var ptr<sqlite3_stmt>,
		tail: ptr<u8>,
	): c_int
	fn sqlite3_step(stmt: ptr<sqlite3_stmt>): c_int
	fn sqlite3_column_int(stmt: ptr<sqlite3_stmt>, column: c_int): c_int
	fn sqlite3_column_text(stmt: ptr<sqlite3_stmt>, column: c_int): cstring
	fn sqlite3_finalize(stmt: ptr<sqlite3_stmt>): c_int
	fn sqlite3_close(db: ptr<sqlite3>): c_int
	fn sqlite3_errmsg(db: ptr<sqlite3>): cstring
}

fn main(): i64 = {
	var db: ptr<sqlite3> = null

	if sqlite3_open(":memory:", &var db) != SQLITE_OK {
		io::eprintln("cannot open: \(sqlite3_errmsg(db))")
		return 1
	}

	defer sqlite3_close(db)

	val schema: cstring = "create table people (name text, age integer)"

	if sqlite3_exec(db, schema, null, null, null) != SQLITE_OK {
		io::eprintln("cannot create: \(sqlite3_errmsg(db))")
		return 1
	}

	val rows: cstring = "insert into people values ('ada', 36), ('grace', 45), ('alan', 41)"

	if sqlite3_exec(db, rows, null, null, null) != SQLITE_OK {
		io::eprintln("cannot insert: \(sqlite3_errmsg(db))")
		return 1
	}

	var stmt: ptr<sqlite3_stmt> = null

	if sqlite3_prepare_v2(db, "select name, age from people order by age", -1, &var stmt, null) !=
		SQLITE_OK {
		io::eprintln("cannot prepare: \(sqlite3_errmsg(db))")
		return 1
	}

	defer sqlite3_finalize(stmt)

	var total = 0

	while sqlite3_step(stmt) == SQLITE_ROW {
		val name = sqlite3_column_text(stmt, 0).toStr()
		val age = sqlite3_column_int(stmt, 1) as i64
		io::println("\(name) is \(age)")
		total += age
	}

	io::println("total \(total)")

	return 0
}
