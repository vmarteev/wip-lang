// Counts the words of files, or of standard input, and prints the ones
// used most. The options are read with `std::args`, and what can go wrong
// is an error of the program's own, which `main` answers.

import std::args::{ArgumentError, Arguments}
import std::collections::{Map}
import std::fs
import std::io

val USAGE = """
	usage: wordcount [-n count] [-i] [file...]

	Counts the words of the files, or of standard input where there are
	none or a file is `-`, and prints the ones used most.

	  -n, --top count     how many to print, 10 unless said
	  -i, --ignore-case   count `The` and `the` as one word
	  -h, --help          print this
	"""

/// What can stop the program. `main` answers it, and it is printed after
/// `error: `.
enum Failure {
	Arguments(error: ArgumentError)
	Reading(path: String, error: io::IoError)
}

extend Failure: Text {
	fn toString(): String = match self {
		.Arguments(error) => "\(error)"
		.Reading(path, error) => "cannot read \(path): \(error)"
	}
}

// What `?` does with an `ArgumentError` in `main`.
extend Failure: From<ArgumentError> {
	static fn from(error: ArgumentError): Failure = .Arguments(error: move error)
}

fn main(args: &[cstring]): Result<i64, Failure> = {
	var top = 10
	var ignoreCase = false
	var files: Vec<str> = Vec()
	var arguments = Arguments::of(&args)

	while arguments.next()? is .Some(argument) {
		match argument {
			.Short('n') | .Long("top") => top = arguments.int()?
			.Short('i') | .Long("ignore-case") => ignoreCase = true
			.Short('h') | .Long("help") => {
				io::print(USAGE)
				return .Ok(0)
			}
			.Positional(file) => files.push(file)
			_ => return .Err(.Arguments(error: argument.unexpected()))
		}
	}

	if files.isEmpty() then files.push("-")

	var counts: Map<String, i64> = Map()

	for file in files {
		val text = read(file)?
		tally(text, ignoreCase, &var counts)
	}

	for (word, count) in mostUsed(&counts, top) {
		io::println("\(count, width: 7)  \(word)")
	}

	return .Ok(0)
}

/// A file's text, or standard input's for `-`.
fn read(file: str): Result<String, Failure> = {
	if file != "-" then
		return fs::readFile(file).mapErr((error) => .Reading(path: file, error: error))

	var text = String()
	var input = io::stdin()

	return match input.readAll(&var text) {
		.Ok(..) => .Ok(move text)
		.Err(error) => .Err(.Reading(path: "standard input", error: error))
	}
}
