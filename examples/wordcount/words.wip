// Words, and how often each is used. This file knows nothing of files or
// options, so its tests, in `words.test.wip`, give it text directly.

import std::collections::{Map}

/// The words of a text, in order: runs of letters and digits, with an
/// apostrophe inside one, as in `don't`. A letter is any character that is
/// not ASCII, as well as `a` to `z` in either case, so that `naïve` and
/// `привет` are words.
///
/// It is a generator: each word is a `str` of the text, found as it is
/// asked for, and nothing is allocated.
pub fn words(text: str): Iterator<str> = {
	// Where the word being read began, or -1 between words.
	var start = -1
	var at = 0

	while at < text.len() {
		val (c, size) = text.charAt(at)
		val inside = isLetter(c) || (c == '\'' && start >= 0 && letterAt(text, at + size))

		if inside {
			if start < 0 then start = at
		} else if start >= 0 {
			yield text[start..at]
			start = -1
		}

		at += size
	}

	if start >= 0 {
		yield text[start..]
	}
}

fn isLetter(c: char): bool = c.isAsciiLetter() || c.isDigit() || c as u32 > 127

fn letterAt(text: str, at: i64): bool = {
	if at >= text.len() then return false
	val (c, _) = text.charAt(at)
	return isLetter(c)
}

/// Each word of `text` counted into `counts`, lower-cased first where
/// `ignoreCase` says.
pub fn tally(text: str, ignoreCase: bool, counts: &var Map<String, i64>) = {
	for word in words(text) {
		val key = if ignoreCase then word.toLowercase() else String::of(word)
		counts.atOrPut(move key, 0) += 1
	}
}

/// The `count` words used most, most first; words used as often are in
/// the order of the alphabet.
pub fn mostUsed(counts: &Map<String, i64>, count: i64): Vec<(String, i64)> = {
	var all: Vec<(String, i64)> = Vec()

	for entry in counts {
		all.push((entry.key.clone(), entry.value))
	}

	all.sortBy((a, b) => a.1 > b.1 || (a.1 == b.1 && a.0 < b.0))
	all.truncate(count.max(0))

	return move all
}
