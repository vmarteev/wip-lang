import std::collections::{Map}

@test
fn wordsAreRunsOfLettersWithApostrophesInside() = {
	val found = words("It's a dog's life -- isn't it? 'Quoted' 42").toVec()
	assert(found == Vec::of(own ["It's", "a", "dog's", "life", "isn't", "it", "Quoted", "42"]))
	assert(words("naïve привет").toVec() == Vec::of(own ["naïve", "привет"]))
	assert(words("").toVec().isEmpty() && words(" ,.; ").toVec().isEmpty())
}

@test
fn caseIsIgnoredWhereAsked() = {
	var kept: Map<String, i64> = Map()
	tally("The cat and the hat", false, &var kept)
	assert(kept.len() == 5 && kept.at(String::of("The")) == 1)
	var folded: Map<String, i64> = Map()
	tally("The cat and the hat", true, &var folded)
	assert(folded.len() == 4 && folded.at(String::of("the")) == 2)
}

@test
fn theMostUsedComeFirstThenByTheAlphabet() = {
	var counts: Map<String, i64> = Map()
	tally("b a c b c b", false, &var counts)
	val top = mostUsed(&counts, 2)
	assert(top.len() == 2)
	assert(top[0].0 == "b" && top[0].1 == 3)
	assert(top[1].0 == "c" && top[1].1 == 2)
	assert(mostUsed(&counts, 10).len() == 3 && mostUsed(&counts, -1).isEmpty())
}
