@test
fn aLineIsATitleALinkTagsAndANote() = {
	val .Ok(found) = parse("# a comment\n\nWip | /wip | a b | a `note`\nBare | /bare\n") else {
		assert(false, "the lines are read")
		return
	}
	assert(found.len() == 2)
	assert(found[0].title == "Wip" && found[0].url == "/wip")
	assert(found[0].tags == ["a", "b"].toVec() && found[0].note == "a `note`")
	assert(found[1].tags.isEmpty() && found[1].note.isEmpty())
	val wrong = parse("no link here\n")
	assert(wrong is .Err(message) && message == "line 1 has no link: no link here")
}

@test
fn whatTheFileSaysIsTextOnThePage() = {
	val bookmark = Bookmark(title: "<b>bold</b> & co", url: "/a?x=1&y=2")
	assert(
		item(&bookmark).toStr() ==
			"<li><a href=\"/a?x=1&amp;y=2\">&lt;b&gt;bold&lt;/b&gt; &amp; co</a> <p></p></li>\n",
	)
}

@test
fn aLinkThatWouldRunAScriptRunsNothing() = {
	val bookmark = Bookmark(title: "x", url: "javascript:alert(1)")
	assert(item(&bookmark).toStr().contains("href=\"javascript%3Aalert(1)\""))
}

@test
fn aNotesBackticksAreCode() = {
	assert(inline("run `ls -l` <now>").toStr() == "run <code>ls -l</code> &lt;now&gt;")
	assert(inline("").isEmpty())
}

@test
fn tagsAreJoinedLinks() = {
	var bookmark = Bookmark(title: "x", url: "/x")
	bookmark.tags.push("one")
	bookmark.tags.push("two")
	val made = item(&bookmark)
	val written = made.toStr()
	assert(
		written.contains(
			"<a class=\"tag\" href=\"#one\">one</a>, <a class=\"tag\" href=\"#two\">two</a>",
		),
	)
}

@test
fn theFeedIsXml() = {
	val bookmarks = [Bookmark(title: "A & B", url: "/ab")]
	val made = feed("Mine", "https://example.com", &bookmarks)
	val written = made.toStr()
	assert(written.contains("<item><title>A &amp; B</title><link>/ab</link>"))
	assert(written.startsWith("<?xml"))
}
