// A page of bookmarks, and a feed of them, each built as `Html` or `Xml`:
// every title, link, tag and note read from the file is written as its
// place in the page needs, with no call to say so, and a piece of a page is
// a function that answers `Html`.

import std::markup::{Html, Xml}

/// A bookmark, as a line of the file says it.
pub struct Bookmark {
	pub title: String
	pub url: String
	pub tags: Vec<String> = Vec()
	pub note: String = String()
}

/// The bookmarks of a file, one a line: `title | url | tags | note`, the
/// tags split at spaces, and the last two left out where there are none.
/// A blank line, or one that starts with `#`, is passed over; a line with
/// no link is an error that says which.
pub fn parse(text: str): Result<Vec<Bookmark>, String> = {
	var found: Vec<Bookmark> = Vec()
	for (index, line) in text.lines().enumerate() {
		val written = line.trim()
		if written.isEmpty() || written.startsWith("#") then
			continue

		val parts: Vec<str> = [
			for part in written.split("|") do
				yield part.trim()
		]
		if parts.len() < 2 || parts[1].isEmpty() then
			return .Err("line \(index + 1) has no link: \(written)")

		var bookmark = Bookmark(title: parts[0], url: parts[1])
		if parts.len() > 2 {
			for tag in parts[2].split(" ") do
				if !tag.isEmpty() then
					bookmark.tags.push(tag)
		}

		if parts.len() > 3 then
			bookmark.note = parts[3]

		found.push(bookmark)
	}
	return found
}

/// The page: its title, and each bookmark an item of a list.
pub fn page(title: str, bookmarks: &[Bookmark]): Html = {
	var items = Html()
	for bookmark in bookmarks do
		items.push(item(&bookmark))

	return """
		<!doctype html>
		<html lang="en">
		<head>
		<meta charset="utf-8">
		<title>\(title)</title>
		</head>
		<body>
		<h1>\(title)</h1>
		<ul>
		\(items)</ul>
		</body>
		</html>

		"""
}

/// One bookmark: its link, its tags, each a link to the tag, and its
/// note. The title and the note are text; the tags are `Html`, joined as
/// they are.
pub fn item(bookmark: &Bookmark): Html = {
	val tags: Vec<Html> = [
		for tag in bookmark.tags do
			yield tagLink(tag.toStr())
	]
	val note = inline(bookmark.note.toStr())
	// A local of a literal says it is `Html`: with no type written it
	// would be a `String`, text, and its tags would show on the page.
	val link: Html = "<a href=\"\(bookmark.url)\">\(bookmark.title)</a>"
	return "<li>\(link) \(Html::joined(&tags, ", "))<p>\(note)</p></li>\n"
}

/// A tag, as a link to the place on the page it names.
fn tagLink(tag: str): Html = "<a class=\"tag\" href=\"#\(tag)\">\(tag)</a>"

/// A note's text, what it writes between backticks as code: `` `ls -l` ``.
pub fn inline(text: str): Html = {
	var out = Html()
	for (i, piece) in text.split("`").enumerate() {
		if i % 2 == 1 then
			out.push("<code>\(piece)</code>")
		else
			out.push("\(piece)")
	}
	return out
}

/// The same bookmarks as an RSS feed, each an item with its link.
pub fn feed(title: str, home: str, bookmarks: &[Bookmark]): Xml = {
	var items = Xml()
	for bookmark in bookmarks do
		items.push("<item><title>\(bookmark.title)</title><link>\(bookmark.url)</link><description>\(bookmark.note)</description></item>\n")

	return """
		<?xml version="1.0" encoding="utf-8"?>
		<rss version="2.0"><channel>
		<title>\(title)</title><link>\(home)</link>
		\(items)</channel></rss>

		"""
}
