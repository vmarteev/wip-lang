// Writes a page of bookmarks, or an RSS feed of them, from a file of one
// a line. What the file says is text, and the page is built as `Html`:
// a title with a `<` in it shows the `<`, and a link that would run a
// script is a link that runs nothing.

import std::args::{ArgumentError, Arguments}
import std::fs
import std::io

val USAGE = """
	usage: bookmarks [-t title] [-o file] [--rss link] file

	Writes a page of the bookmarks in the file, one a line:

	  title | link | tags | note

	  -t, --title text    the page's title, Bookmarks unless said
	  -o, --output file   where to write it, standard output unless said
	  --rss link          an RSS feed, whose home is the link, in place of the page
	  -h, --help          print this
	"""

/// What can stop the program, printed after `error: `.
enum Failure {
	Arguments(error: ArgumentError)
	Usage(message: String)
	Reading(path: String, error: io::IoError)
	Writing(path: String, error: io::IoError)
}

extend Failure: Text {
	fn toString(): String = match self {
		.Arguments(error) => "\(error)"
		.Usage(message) => "\(message); see `bookmarks --help`"
		.Reading(path, error) => "cannot read \(path): \(error)"
		.Writing(path, error) => "cannot write \(path): \(error)"
	}
}

extend Failure: From<ArgumentError> {
	static fn from(error: ArgumentError): Failure = .Arguments(error:)
}

fn main(args: &[cstring]): Result<i64, Failure> = {
	var title = "Bookmarks"
	var output: Option<str> = .None
	var home: Option<str> = .None
	var file: Option<str> = .None
	var arguments = Arguments::of(&args)
	while arguments.next()? is .Some(argument) {
		match argument {
			.Short('t') | .Long("title") => title = arguments.value()?
			.Short('o') | .Long("output") => output = arguments.value()?
			.Long("rss") => home = arguments.value()?
			.Short('h') | .Long("help") => {
				io::print(USAGE)
				return 0
			}
			.Positional(path) if file.isNone() => file = path
			_ => return .Err(.Arguments(error: argument.unexpected()))
		}
	}
	val .Some(path) = file else return .Err(.Usage("no file of bookmarks"))
	val text = fs::readFile(path).mapErr((error) => Failure::Reading(path:, error:))?
	val bookmarks = parse(text.toStr()).mapErr((message) => Failure::Usage(message:))?
	// Either is written out as its text.
	val written: String = match home {
		.Some(link) => "\(feed(title, link, &bookmarks))"
		.None => "\(page(title, &bookmarks))"
	}
	match output {
		.Some(to) =>
			fs::writeFile(to, written.toStr()).mapErr((error) => Failure::Writing(
				path: to,
				error:,
			))?
		.None => io::print(written.toStr())
	}
	return 0
}
