// A web server that answers every request with a line of text, on several
// threads at once. The threads borrow the listener and the count of
// requests, which `future::each` lends them for its call alone, so nothing
// needs counting or a lock: the count is an `Atomic`, the one kind of
// value threads may change through a `&`.

import std::future
import std::net::{Listener, Stream}
import std::sync::{Atomic}

/// Answers requests on `listener` with `threads` threads, until `limit`
/// have been answered, or for ever where `limit` is 0. Each thread takes a
/// ticket before it waits for a connection, so exactly `limit` are
/// answered and every thread then stops.
pub fn serve(listener: &Listener, threads: i64, limit: i64) = {
	val tickets = Atomic::of(0 as i64)
	var workers = own [0; threads]

	future::each(&var workers, (_) => {
		while true {
			val ticket = tickets.add(1)
			if limit > 0 && ticket >= limit then return
			val .Ok((stream, _)) = listener.accept() else {
				continue
			}
			answer(&stream, ticket + 1)
		}
	})
}

/// Reads a request's first line and answers it.
fn answer(stream: &Stream, visitor: i64) = {
	var request: [u8; 4096] = [0; 4096]

	val .Ok(count) = stream.read(&var request) else {
		return
	}

	val path = pathOf(str::fromBytes(&request[0..count]))
	val body = "hello from Wip, visitor #\(visitor): you asked for \(path)\n"

	stream.writeText("""
		HTTP/1.1 200 OK\r
		Content-Type: text/plain; charset=utf-8\r
		Content-Length: \(body.len())\r
		Connection: close\r
		\r
		\(body)
		""")
}

/// The path of a request: `/index.html` of `GET /index.html HTTP/1.1`, and
/// `/` where there is none to read.
pub fn pathOf(request: str): str = {
	var lines = request.lines()
	val line = lines.next().unwrapOr("")
	var words = line.split(" ")
	words.next()
	return words.next().unwrapOr("/")
}
