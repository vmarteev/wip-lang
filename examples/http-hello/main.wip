// A tiny web server: `curl localhost:8080/anything` while it runs.

import std::args::{ArgumentError, Arguments}
import std::io
import std::net::{Listener}

val USAGE = """
	usage: http-hello [-p port] [-t threads] [-n requests] [host]

	Answers every request with a line of text, on 127.0.0.1 unless a host
	is given; 0.0.0.0 answers every address.

	  -p, --port port         the port to listen on, 8080 unless said
	  -t, --threads count     how many threads answer, 4 unless said
	  -n, --requests count    stop after this many; never, unless said
	  -h, --help              print this
	"""

fn main(args: &[cstring]): Result<i64, ArgumentError> = {
	var port = 8080
	var threads = 4
	var limit = 0
	var host = "127.0.0.1"
	var arguments = Arguments::of(&args)

	while arguments.next()? is .Some(argument) {
		match argument {
			.Short('p') | .Long("port") => port = arguments.int()?
			.Short('t') | .Long("threads") => threads = arguments.int()?
			.Short('n') | .Long("requests") => limit = arguments.int()?
			.Short('h') | .Long("help") => {
				io::print(USAGE)
				return .Ok(0)
			}
			.Positional(name) => host = name
			_ => return .Err(argument.unexpected())
		}
	}

	val listener = match Listener::tcp(.Some(host), port as u16) {
		.Ok(listener) => move listener
		.Err(error) => {
			io::eprintln("error: cannot listen on \(host):\(port): \(error)")
			return .Ok(1)
		}
	}

	io::println("listening on http://\(host):\(port)/")
	serve(&listener, threads.max(1), limit)

	return .Ok(0)
}
