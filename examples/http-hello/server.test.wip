import std::future
import std::net::{Listener, Stream}

@test
fn aRequestIsAnswered() = {
	// Port 0: the system chooses one, and `localAddress` says which.
	val listener = Listener::tcp(.Some("127.0.0.1"), 0).unwrap()

	val .Ok(.V4(port: port, ..)) = listener.localAddress() else {
		assert(false, "the listener has an address")
		return
	}

	val (_, reply) = future::together(
		() => serve(&listener, 2, 1),
		() => {
			val stream = Stream::tcp("127.0.0.1", port).unwrap()
			stream.writeText("GET /greeting HTTP/1.1\r\nHost: here\r\n\r\n").unwrap()
			var reply = String()
			var buffer: [u8; 512] = [0; 512]

			while stream.read(&var buffer) is .Ok(count) && count > 0 {
				reply.push(str::fromBytes(&buffer[0..count]))
			}

			return move reply
		},
	)

	assert(reply.startsWith("HTTP/1.1 200 OK\r\n"))
	assert(reply.endsWith("hello from Wip, visitor #1: you asked for /greeting\n"))
}

@test
fn aRequestsPathIsReadFromItsFirstLine() = {
	assert(pathOf("GET /a/b?c=1 HTTP/1.1\r\nHost: x\r\n") == "/a/b?c=1")
	assert(pathOf("") == "/")
}
