@test
fn aListIsReadAndWrittenAsItsFileHasIt() = {
	val text = "[ ] buy milk\n[x] write the report\n\nwater the plants\n"
	val list = List::parse(text)
	assert(list.items.len() == 3)
	assert(list.items[1].done && !list.items[2].done)
	assert(list.items[2].text == "water the plants")
	assert("\(list)" == "[ ] buy milk\n[x] write the report\n[ ] water the plants\n")
}

@test
fn itemsAreMarkedAndRemovedByTheirNumber() = {
	var list = List()
	list.add("one")
	list.add("two")
	list.add("three")
	assert(list.markDone(2).isOk())
	assert(list.markDone(4) is .Err(.NoSuchItem(number: 4)))
	assert(list.markDone(0) is .Err(.NoSuchItem(number: 0)))

	val .Ok(removed) = list.remove(1) else {
		assert(false, "item 1 is there")
		return
	}

	assert(removed.text == "one" && list.items.len() == 2)
	assert(list.clearDone() == 1)
	assert(list.items.len() == 1 && list.items[0].text == "three")
}
