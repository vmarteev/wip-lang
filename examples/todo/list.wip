// A to-do list, kept as text: one item to a line, `[x] ` before one that is
// done and `[ ] ` before one that is not. Nothing here reads or writes a
// file; `main.wip` does, and `list.test.wip` tests this on its own.

/// One thing to do.
pub struct Item {
	pub var text: String
	pub var done: bool = false
}

/// The list, in the order its items were added.
pub struct List {
	pub var items: Vec<Item> = Vec()
}

/// What a change to the list can find wrong.
@derive(Eq)
pub enum ListError {
	/// No item has this number; they are numbered from 1.
	NoSuchItem(number: i64)
}

extend ListError: Text {
	fn toString(): String = match self {
		.NoSuchItem(number) => "there is no item \(number)"
	}
}

extend List {
	/// The list its text says, skipping blank lines.
	pub static fn parse(text: str): List = {
		var list = List()

		for line in text.lines() {
			if line.isEmpty() then continue
			val item = match line.stripPrefix("[x] ") {
				.Some(rest) => Item(text: String::of(rest), done: true)
				.None => Item(text: String::of(line.stripPrefix("[ ] ").unwrapOr(line)))
			}
			list.items.push(move item)
		}

		return move list
	}

	pub var fn add(text: str) = self.items.push(Item(text: String::of(text)))

	/// The item numbered `number`, marked done.
	pub var fn markDone(number: i64): Result<void, ListError> = {
		val at = self.position(number)?
		self.items[at].done = true
		return .Ok({})
	}

	/// The item numbered `number`, taken off the list.
	pub var fn remove(number: i64): Result<Item, ListError> = {
		val at = self.position(number)?
		return .Ok(self.items.remove(at))
	}

	/// Every item that is done, taken off; how many there were.
	pub var fn clearDone(): i64 = {
		val before = self.items.len()
		self.items.retain((item) => !item.done)
		return before - self.items.len()
	}

	// Where the item numbered `number` is, counting from 1.
	fn position(number: i64): Result<i64, ListError> = {
		if number < 1 || number > self.items.len() then return .Err(.NoSuchItem(number: number))
		return .Ok(number - 1)
	}
}

// The list as its file holds it.
extend List: Text {
	fn appendTo(out: &var String) = {
		for item in self.items {
			out.push(if item.done then "[x] " else "[ ] ")
			out.push(item.text)
			out.push("\n")
		}
	}
}
