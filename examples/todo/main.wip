// A to-do list on the command line, kept in a text file. A subcommand is a
// positional argument, after which the same `Arguments` reads what that
// subcommand takes.

import std::args::{ArgumentError, Arguments}
import std::fs
import std::io

val USAGE = """
	usage: todo [-f file] command

	  add text...     add an item
	  list [--all]    the items not done, or every item with --all
	  done number     mark an item done
	  remove number   take an item off
	  clear           take every item that is done off

	The list is kept in todo.txt, or in the file -f or $TODO_FILE names.
	"""

/// What can stop the program, printed after `error: `.
enum Failure {
	Arguments(error: ArgumentError)
	List(error: ListError)
	Io(path: String, error: io::IoError)
	Needs(what: String)
}

extend Failure: Text {
	fn toString(): String = match self {
		.Arguments(error) => "\(error)"
		.List(error) => "\(error)"
		.Io(path, error) => "\(path): \(error)"
		.Needs(what) => "\(what), as `todo --help` says"
	}
}

extend Failure: From<ArgumentError> {
	static fn from(error: ArgumentError): Failure = .Arguments(error: move error)
}

extend Failure: From<ListError> {
	static fn from(error: ListError): Failure = .List(error: move error)
}

fn main(args: &[cstring]): Result<i64, Failure> = {
	var file = io::env("TODO_FILE").unwrapOr(String::of("todo.txt"))
	var command = "list"
	var arguments = Arguments::of(&args)

	// The options before the command, and the command.
	while arguments.next()? is .Some(argument) {
		match argument {
			.Short('f') | .Long("file") => file = String::of(arguments.value()?)
			.Short('h') | .Long("help") => {
				io::print(USAGE)
				return .Ok(0)
			}
			.Positional(name) => {
				command = name
				break
			}
			_ => return .Err(.Arguments(error: argument.unexpected()))
		}
	}

	var list = load(file.toStr())?

	match command {
		"add" => {
			val words = arguments.rest()
			if words.isEmpty() then return .Err(.Needs(what: "`add` needs the item's text"))
			list.add(words.join(" "))
		}
		"list" => {
			var all = false

			while arguments.next()? is .Some(argument) {
				match argument {
					.Short('a') | .Long("all") => all = true
					_ => return .Err(.Arguments(error: argument.unexpected()))
				}
			}

			show(&list, all)

			return .Ok(0)
		}
		"done" => list.markDone(number(&var arguments, "done")?)?
		"remove" => {
			val item = list.remove(number(&var arguments, "remove")?)?
			io::println("removed: \(item.text)")
		}
		"clear" => io::println("cleared \(list.clearDone()) done")
		_ => return .Err(.Arguments(error: .UnexpectedArgument(text: String::of(command))))
	}

	return save(file.toStr(), &list)
}

/// The number a command is given, its only argument.
fn number(arguments: &var Arguments, command: str): Result<i64, Failure> = {
	val .Some(.Positional(text)) = arguments.next()? else {
		return .Err(.Needs(what: "`\(command)` needs an item's number"))
	}

	return match text.toInt() {
		.Ok(n) => .Ok(n)
		.Err(..) => .Err(.Needs(what: "`\(command)` needs an item's number, not `\(text)`"))
	}
}

/// The items, numbered from 1, with those done only where `all` says.
fn show(list: &List, all: bool) = {
	for i in 0..list.items.len() {
		val item = &list.items[i]
		if item.done && !all then continue
		io::println("\(i + 1, width: 3). \(if item.done then "[x]" else "[ ]") \(item.text)")
	}
}

/// The list in `path`, or an empty one where there is no file yet.
fn load(path: str): Result<List, Failure> = {
	if !fs::exists(path) then return .Ok(List())
	return match fs::readFile(path) {
		.Ok(text) => .Ok(List::parse(text))
		.Err(error) => .Err(.Io(path: String::of(path), error: error))
	}
}

fn save(path: str, list: &List): Result<i64, Failure> = match fs::writeFile(path, "\(list)") {
	.Ok(..) => .Ok(0)
	.Err(error) => .Err(.Io(path: String::of(path), error: error))
}
