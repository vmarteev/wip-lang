val ROWS: [[str; 3]; 1] = [["a, b", "say \"hi\"", "x"]]

@test
fn csvQuotesWhatNeedsIt() = {
	val header: [str; 3] = ["name", "note", "x"]
	assert(render(Csv(), &header, &ROWS) == "name,note,x\n\"a, b\",\"say \"\"hi\"\"\",x\n")
}

@test
fn eachFormatWritesItsOwnWay() = {
	val header: [str; 3] = ["name", "note", "x"]
	val markdown = render(Markdown(), &header, &ROWS)
	assert(markdown == "| name | note | x |\n|---|---|---|\n| a, b | say \"hi\" | x |\n")
	val json = render(JsonLines(), &header, &ROWS)
	assert(json == "{\"name\": \"a, b\", \"note\": \"say \\\"hi\\\"\", \"x\": \"x\"}\n")
	val plain = render(Plain(width: 6), &header, &ROWS)
	assert(plain.startsWith("name  note  x\n------------------\n"))
}

@test
fn throughDynOrGenericTheAnswerIsTheSame() = {
	val header: [str; 3] = ["name", "note", "x"]
	assert(render(Csv(), &header, &ROWS) == renderEach(Csv(), &header, &ROWS))
	assert(render(Markdown(), &header, &ROWS) == renderEach(Markdown(), &header, &ROWS))
}
