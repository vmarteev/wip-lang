// Writes a small table in the format an option names: the format is chosen
// while the program runs, and handed to `render` as a `&dyn Format`.

import std::args::{ArgumentError, Arguments}
import std::io

val USAGE = """
	usage: report-formats [-f format]

	Writes a table of programming languages.

	  -f, --format name   text, csv, markdown or json; text unless said
	  -h, --help          print this
	"""

val HEADER: [str; 3] = ["language", "year", "memory"]

val LANGUAGES: [[str; 3]; 5] = [
	["C", "1972", "by hand"],
	["Lisp", "1958", "collected"],
	["Rust", "2015", "owned, borrowed"],
	["Swift", "2014", "counted"],
	["Wip", "2026", "owned, \"lent\""],
]

fn main(args: &[cstring]): Result<i64, ArgumentError> = {
	var name = "text"
	var arguments = Arguments::of(&args)

	while arguments.next()? is .Some(argument) {
		match argument {
			.Short('f') | .Long("format") => name = arguments.value()?
			.Short('h') | .Long("help") => {
				io::print(USAGE)
				return .Ok(0)
			}
			_ => return .Err(argument.unexpected())
		}
	}

	// Each arm lends `render` a value of another type, as a `&dyn Format`.
	val table = match name {
		"text" => render(Plain(), &HEADER, &LANGUAGES)
		"csv" => render(Csv(), &HEADER, &LANGUAGES)
		"markdown" => render(Markdown(), &HEADER, &LANGUAGES)
		"json" => render(JsonLines(), &HEADER, &LANGUAGES)
		_ => {
			io::eprintln("error: there is no format `\(name)`; see `report-formats --help`")
			return .Ok(1)
		}
	}

	io::print(table)

	return .Ok(0)
}
