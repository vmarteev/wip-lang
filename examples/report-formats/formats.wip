// Four ways to write a table, behind one interface. Which is used is
// decided when the program runs, so `render` is given it as `&dyn Format`:
// one function, compiled once, that calls the format's methods through a
// table of them.

import std::json::{Json}

/// How a table is written: what comes before its rows, and each row.
pub interface Format {
	/// What comes before the rows: nothing, unless a format says.
	fn begin(header: &[str], out: &var String) = {}

	/// One row, its cells in the order of the header's.
	fn row(header: &[str], cells: &[str], out: &var String)
}

/// Columns padded to a width, under a line.
pub struct Plain {
	pub width: i64 = 12
}

extend Plain: Format {
	fn begin(header: &[str], out: &var String) = {
		self.row(&header, &header, &var out)
		for _ in 0..header.len() * self.width {
			out.pushChar('-')
		}
		out.push("\n")
	}

	// Each cell padded to the width but the last, so that no line ends in
	// spaces.
	fn row(header: &[str], cells: &[str], out: &var String) = {
		for i in 0..cells.len() {
			if i + 1 < cells.len() then out.push("\(cells[i], width: self.width)")
			else out.push(cells[i])
		}
		out.push("\n")
	}
}

/// Comma-separated values, a cell quoted where it holds a comma or a
/// quote.
pub struct Csv

extend Csv: Format {
	fn begin(header: &[str], out: &var String) = self.row(&header, &header, &var out)

	fn row(header: &[str], cells: &[str], out: &var String) = {
		for i in 0..cells.len() {
			if i > 0 then out.push(",")
			val cell = cells[i]

			if cell.contains(",") || cell.contains("\"") {
				out.push("\"")
				for c in cell.chars() {
					if c == '"' then out.push("\"\"") else out.pushChar(c)
				}
				out.push("\"")
			} else {
				out.push(cell)
			}
		}

		out.push("\n")
	}
}

/// A Markdown table.
pub struct Markdown

extend Markdown: Format {
	fn begin(header: &[str], out: &var String) = {
		self.row(&header, &header, &var out)
		out.push("|")
		for _ in header {
			out.push("---|")
		}
		out.push("\n")
	}

	fn row(header: &[str], cells: &[str], out: &var String) = {
		out.push("|")
		for cell in cells {
			out.push(" \(cell) |")
		}
		out.push("\n")
	}
}

/// One JSON object to a line, keyed by the header. It writes nothing
/// before its rows, so it keeps the interface's `begin`.
pub struct JsonLines

extend JsonLines: Format {
	fn row(header: &[str], cells: &[str], out: &var String) = {
		out.push("{")

		for i in 0..cells.len() {
			if i > 0 then out.push(", ")
			// A key and a value are written as JSON strings are, escapes
			// and all.
			out.push("\(Json::Text(header[i])): ")
			out.push("\(Json::Text(cells[i]))")
		}

		out.push("}\n")
	}
}

/// The table, written in `format`. Through `&dyn`, this one function
/// serves every format.
pub fn render(format: &dyn Format, header: &[str], rows: &[[str; 3]]): String = {
	var out = String()
	format.begin(&header, &var out)
	for cells in rows {
		format.row(&header, &cells, &var out)
	}
	return move out
}

/// The same, generic: compiled once for each format it is called with,
/// each call made directly. The answers are the same.
pub fn renderEach<F: Format>(format: &F, header: &[str], rows: &[[str; 3]]): String = {
	var out = String()
	format.begin(&header, &var out)
	for cells in rows {
		format.row(&header, &cells, &var out)
	}
	return move out
}
