import std::math::{Vec3}

@test
fn theCubesCentreIsInTheMiddleOfTheScreen() = {
	val at = onScreen(transform(0.6), Vec3::zero())
	assert((at.x - 320.0).abs() < 0.001 && (at.y - 180.0).abs() < 0.001)
}

@test
fn whatIsNearerIsLarger() = {
	// The camera is on `+z`: the face toward it is drawn wider than the one
	// away from it.
	val transform = transform(0.0)
	val near =
		onScreen(transform, Vec3::of(1.0, 0.0, 1.0)).x -
		onScreen(transform, Vec3::of(-1.0, 0.0, 1.0)).x
	val far =
		onScreen(transform, Vec3::of(1.0, 0.0, -1.0)).x -
		onScreen(transform, Vec3::of(-1.0, 0.0, -1.0)).x
	assert(near > far && far > 0.0)
}

@test
fn upIsUpOnTheScreen() = {
	val transform = transform(0.0)
	assert(
		onScreen(transform, Vec3::unitY()).y < onScreen(transform, Vec3::zero()).y,
		"pixels count down from the top",
	)
}
