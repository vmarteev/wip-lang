// A camera, a cube turned a little, and the matrices between them: where
// each corner of the cube lands on a screen of 640 by 360, and the cube's
// edges drawn in text, as a GPU would draw them in pixels.

import std::io
import std::math::{Mat4, Quat, Vec2, Vec3, Vec4}

val WIDTH: f32 = 640.0
val HEIGHT: f32 = 360.0

/// The eight corners of a cube two wide, about the origin.
fn corners(): [Vec3; 8] = [
	Vec3::of(-1.0, -1.0, -1.0),
	Vec3::of(1.0, -1.0, -1.0),
	Vec3::of(1.0, 1.0, -1.0),
	Vec3::of(-1.0, 1.0, -1.0),
	Vec3::of(-1.0, -1.0, 1.0),
	Vec3::of(1.0, -1.0, 1.0),
	Vec3::of(1.0, 1.0, 1.0),
	Vec3::of(-1.0, 1.0, 1.0),
]

/// Its twelve edges, as pairs of corners.
val EDGES: [(i64, i64); 12] = [
	(0, 1),
	(1, 2),
	(2, 3),
	(3, 0),
	(4, 5),
	(5, 6),
	(6, 7),
	(7, 4),
	(0, 4),
	(1, 5),
	(2, 6),
	(3, 7),
]

/// What puts a point of the cube on the screen: the model turns it, the
/// view puts the camera at the origin looking down `-z`, and the projection
/// makes what is far smaller.
pub fn transform(angle: f32): Mat4 = {
	val model = Mat4::rotation(Quat::axisAngle(Vec3::of(0.3, 1.0, 0.0).normalized(), angle))
	val eye = Vec3::of(0.0, 1.5, 6.0)
	val view = Mat4::lookAt(eye, target: Vec3::zero(), up: Vec3::unitY())
	val projection = Mat4::perspective(fovY: 0.9, aspect: WIDTH / HEIGHT, near: 0.1, far: 50.0)
	return projection * view * model
}

/// Where `point` lands on the screen, in pixels from its top left: the
/// clip coordinates divided by `w`, then from `-1`–`1` to the pixels.
pub fn onScreen(transform: Mat4, point: Vec3): Vec2 = {
	val clip = transform * point.extend(1.0)
	val ndc = clip.xyz() / clip.w
	return Vec2::of((ndc.x + 1.0) * 0.5 * WIDTH, (1.0 - ndc.y) * 0.5 * HEIGHT)
}

/// The edges drawn on a grid of `columns` by `rows` characters.
fn drawn(points: &[Vec2], columns: i64, rows: i64): String = {
	var grid: Vec<Vec<u8>> = Vec()
	for _ in 0..rows {
		var row: Vec<u8> = Vec()
		for _ in 0..columns {
			row.push(b' ')
		}
		grid.push(row)
	}
	val scale = Vec2::of(columns as f32 / WIDTH, rows as f32 / HEIGHT)
	for (from, to) in EDGES {
		val a = points[from] * scale
		val b = points[to] * scale
		val steps = 60
		for step in 0..steps + 1 {
			val at = a.lerp(b, step as f32 / steps as f32)
			val (column, row) = (at.x as i64, at.y as i64)
			if column >= 0 && column < columns && row >= 0 && row < rows then
				grid[row][column] = b'#'
		}
	}
	// The rows from the first that holds an edge to the last.
	var lines: Vec<str> = Vec()
	for row in grid.items() {
		val line = str::fromBytes(&row.items()).trimEnd()
		if !line.isEmpty() || !lines.isEmpty() then lines.push(line)
	}
	while lines.last() is .Some(line) && line.isEmpty() {
		lines.pop()
	}
	return "\(lines.join("\n"))\n"
}

fn main() = {
	val transform = transform(0.6)
	var points: Vec<Vec2> = Vec()
	for corner in corners() {
		val at = onScreen(transform, corner)
		io::println("\(corner) is at (\(at.x.round()), \(at.y.round()))")
		points.push(at)
	}
	io::println("the centre is at \(onScreen(transform, Vec3::zero()))")
	io::print(drawn(&points.items(), 64, 18))
	val corner = transform * Vec4::of(1.0, 1.0, 1.0, 1.0)
	io::println("a corner in clip coordinates: \(corner)")
}
