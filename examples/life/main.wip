// Conway's Game of Life in the terminal: each generation is drawn over the
// one before.

import std::args::{ArgumentError, Arguments}
import std::io
import std::time::{Duration, sleep}

val USAGE = """
	usage: life [-g generations] [-d milliseconds] [pattern]

	Draws the generations of a pattern on a board whose edges wrap. The
	patterns are glider, blinker, pulsar and r-pentomino, glider unless said.

	  -g, --generations n   how many to draw, 60 unless said
	  -d, --delay ms        the pause between them, 80 unless said
	  -h, --help            print this
	"""

// Each pattern, one string to a row, `#` for a live cell.
val GLIDER: [str; 3] = [".#.", "..#", "###"]
val BLINKER: [str; 1] = ["###"]
val R_PENTOMINO: [str; 3] = [".##", "##.", ".#."]
val PULSAR: [str; 13] = [
	"..###...###..",
	".............",
	"#....#.#....#",
	"#....#.#....#",
	"#....#.#....#",
	"..###...###..",
	".............",
	"..###...###..",
	"#....#.#....#",
	"#....#.#....#",
	"#....#.#....#",
	".............",
	"..###...###..",
]

fn main(args: &[cstring]): Result<i64, ArgumentError> = {
	var generations = 60
	var delay = 80
	var name = "glider"
	var arguments = Arguments::of(&args)

	while arguments.next()? is .Some(argument) {
		match argument {
			.Short('g') | .Long("generations") => generations = arguments.int()?
			.Short('d') | .Long("delay") => delay = arguments.int()?
			.Short('h') | .Long("help") => {
				io::print(USAGE)
				return .Ok(0)
			}
			.Positional(pattern) => name = pattern
			_ => return .Err(argument.unexpected())
		}
	}

	var board = match name {
		"glider" => Board::drawn(40, 20, 12, 3, &GLIDER)
		"blinker" => Board::drawn(40, 20, 12, 3, &BLINKER)
		"pulsar" => Board::drawn(40, 20, 12, 3, &PULSAR)
		"r-pentomino" => Board::drawn(40, 20, 18, 8, &R_PENTOMINO)
		_ => {
			io::eprintln("error: there is no pattern `\(name)`; see `life --help`")
			return .Ok(1)
		}
	}

	for generation in 0..generations {
		// Back to the top left, and the screen cleared, before each frame.
		io::print("\u{1b}[H\u{1b}[2J")
		io::print("\(board)")
		io::println("generation \(generation), \(board.alive().count()) alive")
		sleep(Duration::millis(delay))
		board = board.step()
	}

	return .Ok(0)
}
