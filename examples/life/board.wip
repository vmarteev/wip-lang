// The board of Conway's Game of Life, whose edges wrap around: a cell at
// the right edge has neighbours at the left.

/// The eight cells around one, as steps across and down. Worked out while
/// the program is compiled, by running `around()`, and kept as a table.
@comptime
val NEIGHBOURS: [(i64, i64); 8] = around()

fn around(): [(i64, i64); 8] = {
	var steps: [(i64, i64); 8] = [(0, 0); 8]
	var next = 0

	for dy in -1..=1 {
		for dx in -1..=1 {
			if dx == 0 && dy == 0 then continue
			steps[next] = (dx, dy)
			next += 1
		}
	}

	return steps
}

pub struct Board {
	pub width: i64
	pub height: i64
	cells: Vec<bool>
}

extend Board {
	/// An empty board.
	pub static fn of(width: i64, height: i64): Board = Board(
		width: width,
		height: height,
		cells: Vec::filled(width * height, false),
	)

	/// A board with `pattern` drawn on it at `x`, `y`: one string to a row,
	/// `#` for a live cell and anything else for a dead one.
	pub static fn drawn(width: i64, height: i64, x: i64, y: i64, pattern: &[str]): Board = {
		var board = Board::of(width, height)

		for row in 0..pattern.len() {
			val line = pattern[row]
			for column in 0..line.len() {
				board.at(x + column, y + row) = line[column] == b'#'
			}
		}

		return move board
	}

	/// The cell at `x`, `y`, wrapping around the edges: to read, or to
	/// write where the board is a `var`. One body gives both halves.
	pub lend fn at(x: i64, y: i64): &bool = {
		val column = ((x % self.width) + self.width) % self.width
		val row = ((y % self.height) + self.height) % self.height
		lend self.cells[row * self.width + column]
	}

	/// How many of the cells around `x`, `y` are alive.
	pub fn neighbours(x: i64, y: i64): i64 = {
		var count = 0
		for (dx, dy) in NEIGHBOURS {
			if self.at(x + dx, y + dy) then count += 1
		}
		return count
	}

	/// The board one generation later: a live cell with two or three live
	/// neighbours lives, and a dead one with three comes alive.
	pub fn step(): Board = {
		var next = Board::of(self.width, self.height)

		for y in 0..self.height {
			for x in 0..self.width {
				val count = self.neighbours(x, y)
				next.at(x, y) = count == 3 || (count == 2 && self.at(x, y))
			}
		}

		return move next
	}

	/// The live cells, row by row: a generator, which finds each as it is
	/// asked for.
	pub fn alive(): Iterator<(i64, i64)> = for y in 0..self.height {
		for x in 0..self.width {
			if self.at(x, y) {
				yield (x, y)
			}
		}
	}
}

// The board as text: `#` for a live cell and `.` for a dead one, a line to
// a row.
extend Board: Text {
	fn appendTo(out: &var String) = {
		for y in 0..self.height {
			for x in 0..self.width {
				out.pushChar(if self.at(x, y) then '#' else '.')
			}
			out.push("\n")
		}
	}
}
