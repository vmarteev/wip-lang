@test
fn aBlinkerTurnsAndTurnsBack() = {
	val across: [str; 1] = ["###"]
	val start = Board::drawn(5, 5, 1, 2, &across)
	val turned = start.step()
	assert("\(turned)" == ".....\n..#..\n..#..\n..#..\n.....\n")
	assert("\(turned.step())" == "\(start)")
}

@test
fn aGliderMovesOneCellDownAndAcrossInFour() = {
	val glider: [str; 3] = [".#.", "..#", "###"]
	var board = Board::drawn(8, 8, 1, 1, &glider)
	val before = board.alive().toVec()

	for _ in 0..4 {
		board = board.step()
	}

	val after = board.alive().toVec()
	assert(after.len() == 5)

	for i in 0..5 {
		assert(after[i].0 == before[i].0 + 1 && after[i].1 == before[i].1 + 1)
	}
}

@test
fn theEdgesWrapAround() = {
	var board = Board::of(4, 3)
	board.at(-1, -1) = true
	assert(board.at(3, 2) && board.neighbours(0, 0) == 1)
	assert(NEIGHBOURS.len() == 8 && NEIGHBOURS[0] == (-1, -1))
}
