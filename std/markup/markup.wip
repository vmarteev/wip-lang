// HTML and XML built by interpolated literals: where `Html` or `Xml` is
// expected, `"<li>\(name)</li>"` builds it, the literal's own text as it is
// and each value escaped as its place in the page needs. Each follows where
// in the page the next byte goes, from what was written before it: a value
// between tags or in a quoted attribute's value is escaped, a link's is
// kept from running a script, and one where it cannot be written safely, in
// a `<script>` or between a tag's attributes, is refused with a panic at
// the hole. Where a hole is follows from the literal's own text, so the
// first time a page is written shows a refusal, and any test of it does.

/// HTML: what a literal writes as it is, and each value written into it as
/// the place it is written to needs, so that no value's text is read as
/// markup, as a script, or as a link that runs one. `Html()` is an empty
/// one; written out, by `Text`, it is its text as it is.
///
/// A value's text is escaped between tags, in `<title>` and `<textarea>`,
/// and in a quoted attribute's value, with `&`, `<`, `>`, `"` and `'` written
/// as entities. In a link's value — `href`, `src`, `action`, `formaction`,
/// `cite`, `poster`, `data` and `manifest` — a `:` a value writes before the
/// link's scheme is known is written `%3A` unless the scheme is `http`,
/// `https` or `mailto`, so that `javascript:` is a relative path that runs
/// nothing. A hole anywhere else panics: in `<script>` or `<style>`, in
/// `style`, `srcset`, `srcdoc` or an `on…` attribute, in an attribute's
/// value with no quotes, in a tag, between its attributes, or in a comment.
@derive(Clone)
pub struct Html {
	page: Page = Page(text: String(), reading: Reading::of(true))
}

/// XML: what a literal writes as it is, and each value written into it
/// escaped, between tags and in a quoted attribute's value. A hole in a
/// tag, in an attribute's value with no quotes, in a comment, in CDATA or
/// in a processing instruction panics. It has none of HTML's own places:
/// a `<script>` is an element like any other.
@derive(Clone)
pub struct Xml {
	page: Page = Page(text: String(), reading: Reading::of(false))
}

extend Html: Template {
	static fn withCapacity(capacity: i64): Html = Html(page: Page::of(capacity, true))

	var fn pushLiteral(text: str) = self.page.pushLiteral(text)

	var fn pushBuilt(built: &Html, implicit at: Location) = self.page.join(&built.page, "HTML", at)
}

extend Html {
	/// A hole's value, as its place needs, or a panic at the hole where the
	/// place is one no value is written to.
	pub var fn pushValue<T: Text>(value: &T, implicit at: Location) = self.page.pushValue(
		&value,
		"HTML",
		at,
	)

	/// More HTML, at the end, joined as a hole of it would be: only between
	/// tags, and only HTML that ends between tags.
	pub var fn push(more: Html, implicit at: Location) = self.page.join(&more.page, "HTML", at)

	/// HTML that another writer made and the caller vouches for: a
	/// renderer's or a sanitizer's output. It is read for its places as a
	/// literal is, so text that leaves a tag open is refused where it is
	/// joined.
	pub static fn trusted(text: str): Html = {
		var made = Html()
		made.page.pushLiteral(text)
		return made
	}

	/// The pieces one after another, `between` between each two: a list
	/// of links, `Html::joined(&links, ", ")`.
	pub static fn joined(pieces: &[Html], between: Html, implicit at: Location): Html = {
		var made = Html()
		for (i, piece) in pieces.indexed() {
			if i > 0 then
				made.page.join(&between.page, "HTML", at)

			made.page.join(&piece.page, "HTML", at)
		}
		return made
	}

	/// The text, as it is written out.
	pub fn toStr(): str = self.page.text.toStr()

	/// Whether nothing is written.
	pub fn isEmpty(): bool = self.page.text.isEmpty()
}

// Written out, a page is its text as it is.
extend Html: Text {
	fn appendTo(out: &var String) = out.push(self.page.text.toStr())
}

// Two pages are equal where their text is.
extend Html: Eq {
	fn equals(other: &Html): bool = self.page.text == other.page.text
}

extend Xml: Template {
	static fn withCapacity(capacity: i64): Xml = Xml(page: Page::of(capacity, false))

	var fn pushLiteral(text: str) = self.page.pushLiteral(text)

	var fn pushBuilt(built: &Xml, implicit at: Location) = self.page.join(&built.page, "XML", at)
}

extend Xml {
	/// A hole's value, escaped, or a panic at the hole where the place is
	/// one no value is written to.
	pub var fn pushValue<T: Text>(value: &T, implicit at: Location) = self.page.pushValue(
		&value,
		"XML",
		at,
	)

	/// More XML, at the end, joined as a hole of it would be.
	pub var fn push(more: Xml, implicit at: Location) = self.page.join(&more.page, "XML", at)

	/// XML that another writer made and the caller vouches for, read for its
	/// places as a literal is.
	pub static fn trusted(text: str): Xml = {
		var made = Xml()
		made.page.pushLiteral(text)
		return made
	}

	/// The text, as it is written out.
	pub fn toStr(): str = self.page.text.toStr()

	/// Whether nothing is written.
	pub fn isEmpty(): bool = self.page.text.isEmpty()
}

extend Xml: Text {
	fn appendTo(out: &var String) = out.push(self.page.text.toStr())
}

extend Xml: Eq {
	fn equals(other: &Xml): bool = self.page.text == other.page.text
}

/// What `Html` and `Xml` are made of: the text, and where in it the next
/// byte goes.
@derive(Clone)
struct Page {
	text: String
	reading: Reading
}

extend Page {
	static fn of(capacity: i64, html: bool): Page = Page(
		text: .withCapacity(capacity),
		reading: Reading::of(html),
	)

	/// The program's own text, as it is.
	var fn pushLiteral(text: str) = {
		self.text.push(text)
		self.reading.read(text)
	}

	/// A value's text, as the place it goes to needs.
	var fn pushValue<T: Text>(value: &T, kind: str, at: Location) = {
		if self.reading.refusal() is .Some(place) then
			panic("a hole \(place), where \(kind) cannot write a value safely", at:)

		var written = String()
		value.appendTo(&var written)
		if self.reading.inLink() then
			self.pushLink(written.toStr())
		else
			escape(&var self.text, written.toStr())
	}

	/// A link's value: escaped, and a `:` written before its scheme is known
	/// written `%3A` unless what comes before it is a scheme that runs
	/// nothing.
	var fn pushLink(value: str) = {
		for byte in value {
			if self.reading.settled {
				escapeByte(&var self.text, byte)
				continue
			}
			when {
				byte == b':' => {
					self.reading.settled = true
					if runsNothing(self.reading.scheme.toStr()) then
						self.text.push(":")
					else
						self.text.push("%3A")
				}
				byte is b'/' | b'?' | b'#' => {
					self.reading.settled = true
					escapeByte(&var self.text, byte)
				}
				else => {
					self.reading.scheme.pushByte(byte)
					escapeByte(&var self.text, byte)
				}
			}
		}
	}

	/// Another page, at the end: only between tags, and only one that ends
	/// between tags.
	var fn join(other: &Page, kind: str, at: Location) = {
		if self.reading.refusal() is .Some(place) then
			panic("\(kind) joined \(place), where it can be joined only between tags", at:)

		if !self.reading.betweenTags() then
			panic("\(kind) joined where its tags would be read as text", at:)

		if !other.reading.betweenTags() then
			panic("\(kind) joined that ends inside a tag, a comment or a script", at:)

		self.text.push(other.text.toStr())
	}
}

/// Whether a link's scheme is one that runs nothing, in any case.
fn runsNothing(scheme: str): bool = {
	for allowed in SCHEMES {
		if scheme.len() != allowed.len() then
			continue

		var same = true
		for i in 0..scheme.len() do
			if lower(scheme[i]) != allowed[i] then
				same = false

		if same then
			return true
	}
	return false
}

/// `text`, with `&`, `<`, `>`, `"` and `'` written as entities.
fn escape(out: &var String, text: str) = {
	for byte in text do
		escapeByte(&var out, byte)
}

fn escapeByte(out: &var String, byte: u8) = match byte {
	b'&' => out.push("&amp;")
	b'<' => out.push("&lt;")
	b'>' => out.push("&gt;")
	b'"' => out.push("&quot;")
	b'\'' => out.push("&#39;")
	_ => out.pushByte(byte)
}
