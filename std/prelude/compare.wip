// Comparing two values of a type: whether they are the
// same, and which of them comes first.
//
// `@derive(Eq)` and `@derive(Ord)` on a struct or an enum make the compiler
// write the bodies — field by field, and for an enum the variant first. A
// type whose equality or order is not its fields writes the implementation
// itself.
//
// The built-in types implement both here. `==` and `<` on one of them are
// still the machine's comparison, with no call; these are what a generic
// function dispatches to when its parameter turns out to be a number.

/// `a == b` is `a.equals(&b)`, and `a != b` is its negation.
pub interface Eq {
	fn equals(other: &Self): bool
}

/// `a < b` asks which comes first, and so do `<=`, `>` and `>=`. A type that
/// asks for `@derive(Ord)` asks for `@derive(Eq)` too: two values that
/// compare `Same` and are not equal would make every algorithm that uses
/// both wrong.
@derive(Eq, Hash, Text)
pub enum Ordering {
	Less
	Same
	More

	/// Whether the first comes before the second.
	pub fn isLess(): bool = self is .Less
	/// Whether neither comes first.
	pub fn isSame(): bool = self is .Same
	/// Whether the first comes after the second.
	pub fn isMore(): bool = self is .More
}

/// Which of two values comes first: what `<`, `<=`, `>` and `>=` ask.
pub interface Ord {
	fn compare(other: &Self): Ordering
}

extend i8: Eq {
	fn equals(other: &i8): bool = self == other
}

extend i8: Ord {
	fn compare(other: &i8): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend i16: Eq {
	fn equals(other: &i16): bool = self == other
}

extend i16: Ord {
	fn compare(other: &i16): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend i32: Eq {
	fn equals(other: &i32): bool = self == other
}

extend i32: Ord {
	fn compare(other: &i32): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend i64: Eq {
	fn equals(other: &i64): bool = self == other
}

extend i64: Ord {
	fn compare(other: &i64): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend i128: Eq {
	fn equals(other: &i128): bool = self == other
}

extend i128: Ord {
	fn compare(other: &i128): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend u128: Eq {
	fn equals(other: &u128): bool = self == other
}

extend u128: Ord {
	fn compare(other: &u128): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend isize: Eq {
	fn equals(other: &isize): bool = self == other
}

extend isize: Ord {
	fn compare(other: &isize): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend u8: Eq {
	fn equals(other: &u8): bool = self == other
}

extend u8: Ord {
	fn compare(other: &u8): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend u16: Eq {
	fn equals(other: &u16): bool = self == other
}

extend u16: Ord {
	fn compare(other: &u16): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend u32: Eq {
	fn equals(other: &u32): bool = self == other
}

extend u32: Ord {
	fn compare(other: &u32): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend u64: Eq {
	fn equals(other: &u64): bool = self == other
}

extend u64: Ord {
	fn compare(other: &u64): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend usize: Eq {
	fn equals(other: &usize): bool = self == other
}

extend usize: Ord {
	fn compare(other: &usize): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend f32: Eq {
	fn equals(other: &f32): bool = self == other
}

extend f32: Ord {
	fn compare(other: &f32): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend f64: Eq {
	fn equals(other: &f64): bool = self == other
}

extend f64: Ord {
	fn compare(other: &f64): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

extend bool: Eq {
	fn equals(other: &bool): bool = self == other
}

// `false` comes before `true`, as the numbers they are stored as do.
extend bool: Ord {
	fn compare(other: &bool): Ordering =
		if self == other then .Same else if other then .Less else .More
}

// Characters compare as the numbers they are.
extend char: Eq {
	fn equals(other: &char): bool = self == other
}

extend char: Ord {
	fn compare(other: &char): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

// A slice is equal to another as long whose elements are, in order; an
// array compares as the slice of all of it.
extend [T: Eq]: Eq {
	fn equals(other: &[T]): bool = {
		if self.len() != other.len() then return false
		for i in 0..self.len() {
			if self[i] != other[i] then return false
		}
		return true
	}
}

// A slice comes before another where the first element they differ at
// does, and a slice that is the start of another comes before it — the
// order a dictionary puts words in.
extend [T: Ord]: Ord {
	fn compare(other: &[T]): Ordering = {
		for i in 0..self.len().min(other.len()) {
			val order = self[i].compare(&other[i])
			if !order.isSame() then return order
		}
		return self.len().compare(other.len())
	}
}

// A vector compares as the slice of its elements.
extend Vec<T: Eq>: Eq {
	fn equals(other: &Vec<T>): bool = self.items() == other.items()
}

extend Vec<T: Ord>: Ord {
	fn compare(other: &Vec<T>): Ordering = self.items().compare(&other)
}

// Two options are equal when both hold nothing, or both hold equal
// values; nothing comes before every value, as it does in Rust.
extend Option<T: Eq>: Eq {
	fn equals(other: &Option<T>): bool = match self {
		.Some(a) => match other {
			.Some(b) => a == b
			.None => false
		}
		.None => other is .None
	}
}

extend Option<T: Ord>: Ord {
	fn compare(other: &Option<T>): Ordering = match self {
		.Some(a) => match other {
			.Some(b) => a.compare(&b)
			.None => .More
		}
		.None => if other is .None then .Same else .Less
	}
}

// Two results are equal when both succeeded with equal values, or both
// failed with equal errors.
extend Result<T: Eq, E: Eq>: Eq {
	fn equals(other: &Result<T, E>): bool = match self {
		.Ok(a) => match other {
			.Ok(b) => a == b
			.Err(..) => false
		}
		.Err(e) => match other {
			.Ok(..) => false
			.Err(f) => e == f
		}
	}
}

extend String: Eq {
	fn equals(other: &String): bool = self.toStr() == other.toStr()
}

extend String: Ord {
	fn compare(other: &String): Ordering = self.toStr().compare(other.toStr())
}

extend str: Eq {
	fn equals(other: &str): bool = self == other
}

extend str: Ord {
	fn compare(other: &str): Ordering =
		if self < other then .Less else if self > other then .More else .Same
}

// By the text, as it is hashed: `==` on a `cstring` is this method, so it
// cannot answer with `==` itself.
extend cstring: Eq {
	fn equals(other: &cstring): bool = self.toStr() == other.toStr()
}

// A tuple is equal where each of its elements is.
extend Tuple2<A: Eq, B: Eq>: Eq {
	fn equals(other: &(A, B)): bool = self.0 == other.0 && self.1 == other.1
}

extend Tuple3<A: Eq, B: Eq, C: Eq>: Eq {
	fn equals(other: &(A, B, C)): bool =
		(self.0 == other.0 && self.1 == other.1 && self.2 == other.2)
}

extend Tuple4<A: Eq, B: Eq, C: Eq, D: Eq>: Eq {
	fn equals(other: &(A, B, C, D)): bool =
		(self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3)
}

// A tuple compares by its elements, the first one first, which is the
// order a pair of keys is sorted by.
extend Tuple2<A: Ord, B: Ord>: Ord {
	fn compare(other: &(A, B)): Ordering = {
		val first = self.0.compare(&other.0)
		if !first.isSame() then return first
		return self.1.compare(&other.1)
	}
}

extend Tuple3<A: Ord, B: Ord, C: Ord>: Ord {
	fn compare(other: &(A, B, C)): Ordering = {
		val first = self.0.compare(&other.0)
		if !first.isSame() then return first
		val second = self.1.compare(&other.1)
		if !second.isSame() then return second
		return self.2.compare(&other.2)
	}
}

extend Tuple4<A: Ord, B: Ord, C: Ord, D: Ord>: Ord {
	fn compare(other: &(A, B, C, D)): Ordering = {
		val first = self.0.compare(&other.0)
		if !first.isSame() then return first
		val second = self.1.compare(&other.1)
		if !second.isSame() then return second
		val third = self.2.compare(&other.2)
		if !third.isSame() then return third
		return self.3.compare(&other.3)
	}
}
