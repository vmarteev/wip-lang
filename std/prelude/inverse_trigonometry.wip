// musl's and the `libm` crate's changes are MIT-licensed. Each is within
// an ulp of the true angle.

/// π/2, and what that leaves out.
val HALF_PI_HI: f64 = 1.57079632679489655800e+00
val HALF_PI_LO: f64 = 6.12323399573676603587e-17

/// asin(x) = x + x·R(x²) on [0, 0.5], R a quotient of these.
val ARCSINE_P: [f64; 6] = [
	1.66666666666666657415e-01, -3.25565818622400915405e-01, 2.01212532134862925881e-01,
	-4.00555345006794114027e-02, 7.91534994289814532176e-04, 3.47933107596021167570e-05,
]
val ARCSINE_Q: [f64; 4] = [
	-2.40339491173441421878e+00, 2.02094576023350569471e+00, -6.88283971605453293030e-01,
	7.70381505559019352791e-02,
]

@inline
fn arcsineRatio(z: f64): f64 = {
	val p =
		z *
		(ARCSINE_P[0] +
			z *
				(ARCSINE_P[1] +
					z *
						(ARCSINE_P[2] +
							z * (ARCSINE_P[3] + z * (ARCSINE_P[4] + z * ARCSINE_P[5])))))
	val q = 1.0 + z * (ARCSINE_Q[0] + z * (ARCSINE_Q[1] + z * (ARCSINE_Q[2] + z * ARCSINE_Q[3])))
	return p / q
}

/// asin(x), in [-π/2, π/2]; NaN outside [-1, 1].
fn arcsine(x: f64): f64 = {
	val hx = (x.toBits() >> 32) as i64
	val ix = hx & 0x7fffffff
	// |x| >= 1, or NaN
	if ix >= 0x3ff00000 {
		val lx = (x.toBits() & 0xffffffff) as i64
		if ((ix - 0x3ff00000) | lx) == 0 then return x * HALF_PI_HI
		return 0.0 / (x - x)
	}
	// |x| < 0.5
	if ix < 0x3fe00000 {
		// 2^-1022 <= |x| < 2^-26: x is the answer.
		if ix >= 0x00100000 && ix < 0x3e500000 then return x
		return x + x * arcsineRatio(x * x)
	}
	// 0.5 <= |x| < 1: asin(x) = π/2 - 2 asin(√((1 - |x|)/2)).
	val z = (1.0 - x.abs()) * 0.5
	val s = z.sqrt()
	val r = arcsineRatio(z)
	var angle = 0.0
	// |x| > 0.975
	if ix >= 0x3fef3333 {
		angle = HALF_PI_HI - (2.0 * (s + s * r) - HALF_PI_LO)
	} else {
		// f + c = √z
		val f = f64::fromBits(s.toBits() & 0xFFFFFFFF00000000)
		val c = (z - f * f) / (s + f)
		angle =
			0.5 * HALF_PI_HI - (2.0 * s * r - (HALF_PI_LO - 2.0 * c) - (0.5 * HALF_PI_HI - 2.0 * f))
	}
	return if hx >> 31 != 0 then -angle else angle
}

/// acos(x), in [0, π]; NaN outside [-1, 1].
fn arccosine(x: f64): f64 = {
	val hx = (x.toBits() >> 32) as i64
	val ix = hx & 0x7fffffff
	val negative = (hx >> 31) & 1 != 0
	// |x| >= 1, or NaN
	if ix >= 0x3ff00000 {
		val lx = (x.toBits() & 0xffffffff) as i64
		if ((ix - 0x3ff00000) | lx) == 0 then return if negative then 2.0 * HALF_PI_HI else 0.0
		return 0.0 / (x - x)
	}
	// |x| < 0.5
	if ix < 0x3fe00000 {
		// |x| < 2^-57
		if ix <= 0x3c600000 then return HALF_PI_HI
		return HALF_PI_HI - (x - (HALF_PI_LO - x * arcsineRatio(x * x)))
	}
	// x < -0.5
	if negative {
		val z = (1.0 + x) * 0.5
		val s = z.sqrt()
		val w = arcsineRatio(z) * s - HALF_PI_LO
		return 2.0 * (HALF_PI_HI - (s + w))
	}
	// x > 0.5
	val z = (1.0 - x) * 0.5
	val s = z.sqrt()
	val df = f64::fromBits(s.toBits() & 0xFFFFFFFF00000000)
	val c = (z - df * df) / (s + df)
	val w = arcsineRatio(z) * s + c
	return 2.0 * (df + w)
}

/// atan(0.5), atan(1), atan(1.5) and atan(∞), and what each leaves out.
val ARCTANGENT_HI: [f64; 4] = [
	4.63647609000806093515e-01, 7.85398163397448278999e-01, 9.82793723247329054082e-01,
	1.57079632679489655800e+00,
]
val ARCTANGENT_LO: [f64; 4] = [
	2.26987774529616870924e-17, 3.06161699786838301793e-17, 1.39033110312309984516e-17,
	6.12323399573676603587e-17,
]
val ARCTANGENT_TERMS: [f64; 11] = [
	3.33333333333329318027e-01, -1.99999999998764832476e-01, 1.42857142725034663711e-01,
	-1.11111104054623557880e-01, 9.09088713343650656196e-02, -7.69187620504482999495e-02,
	6.66107313738753120669e-02, -5.83357013379057348645e-02, 4.97687799461593236017e-02,
	-3.65315727442169155270e-02, 1.62858201153657823623e-02,
]

/// atan(x), in [-π/2, π/2].
fn arctangent(x0: f64): f64 = {
	var x = x0
	val hx = (x.toBits() >> 32) as i64
	val negative = (hx >> 31) & 1 != 0
	val ix = hx & 0x7fffffff
	// |x| >= 2^66, or NaN
	if ix >= 0x44100000 {
		if x.isNaN() then return x
		return if negative then -ARCTANGENT_HI[3] else ARCTANGENT_HI[3]
	}
	// Which of the four known angles x is near, or none.
	var near = -1
	// |x| < 0.4375
	if ix < 0x3fdc0000 {
		// |x| < 2^-27
		if ix < 0x3e400000 then return x
	} else {
		x = x.abs()
		if ix < 0x3ff30000 {
			if ix < 0x3fe60000 {
				// 7/16 <= |x| < 11/16
				x = (2.0 * x - 1.0) / (2.0 + x)
				near = 0
			} else {
				// 11/16 <= |x| < 19/16
				x = (x - 1.0) / (x + 1.0)
				near = 1
			}
		} else if ix < 0x40038000 {
			// |x| < 2.4375
			x = (x - 1.5) / (1.0 + 1.5 * x)
			near = 2
		} else {
			// 2.4375 <= |x| < 2^66
			x = -1.0 / x
			near = 3
		}
	}
	val z = x * x
	val w = z * z
	// The series, in its odd and even terms.
	val odds =
		z *
		(ARCTANGENT_TERMS[0] +
			w *
				(ARCTANGENT_TERMS[2] +
					w *
						(ARCTANGENT_TERMS[4] +
							w *
								(ARCTANGENT_TERMS[6] +
									w * (ARCTANGENT_TERMS[8] + w * ARCTANGENT_TERMS[10])))))
	val evens =
		w *
		(ARCTANGENT_TERMS[1] +
			w *
				(ARCTANGENT_TERMS[3] +
					w *
						(ARCTANGENT_TERMS[5] +
							w * (ARCTANGENT_TERMS[7] + w * ARCTANGENT_TERMS[9]))))
	if near < 0 then return x - x * (odds + evens)
	val angle = ARCTANGENT_HI[near] - ((x * (odds + evens) - ARCTANGENT_LO[near]) - x)
	return if negative then -angle else angle
}

val PI_HI: f64 = 3.1415926535897931160e+00
val PI_LO: f64 = 1.2246467991473531772e-16

/// The angle of the point (x, y) from the x axis, in [-π, π].
fn arctangentOf(y: f64, x: f64): f64 = {
	if x.isNaN() || y.isNaN() then return x + y
	val hx = (x.toBits() >> 32) as i64
	val lx = (x.toBits() & 0xffffffff) as i64
	val hy = (y.toBits() >> 32) as i64
	val ly = (y.toBits() & 0xffffffff) as i64
	// x = 1
	if ((hx - 0x3ff00000) | lx) == 0 then return arctangent(y)
	// 2 × the sign of x + the sign of y
	val m = ((hy >> 31) & 1) | ((hx >> 30) & 2)
	val ix = hx & 0x7fffffff
	val iy = hy & 0x7fffffff
	// y = 0
	if (iy | ly) == 0 then
		return match m {
			0 | 1 => y
			2 => PI_HI
			_ => -PI_HI
		}
	// x = 0
	if (ix | lx) == 0 then return if m & 1 != 0 then -PI_HI / 2.0 else PI_HI / 2.0
	// x infinite
	if ix == 0x7ff00000 {
		if iy == 0x7ff00000 then
			return match m {
				0 => PI_HI / 4.0
				1 => -PI_HI / 4.0
				2 => 3.0 * PI_HI / 4.0
				_ => -3.0 * PI_HI / 4.0
			}
		return match m {
			0 => 0.0
			1 => -0.0
			2 => PI_HI
			_ => -PI_HI
		}
	}
	// |y/x| > 2^64, or y infinite
	if ix + (64 << 20) < iy || iy == 0x7ff00000 then
		return if m & 1 != 0 then -PI_HI / 2.0 else PI_HI / 2.0
	// atan(|y/x|), without a needless underflow
	val z = if (m & 2) != 0 && iy + (64 << 20) < ix then 0.0 else arctangent((y / x).abs())
	return match m {
		0 => z
		1 => -z
		2 => PI_HI - (z - PI_LO)
		_ => (z - PI_LO) - PI_HI
	}
}
