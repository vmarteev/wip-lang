// Sorting: the elements of a slice put in order where they
// lie. `sort` takes the order the type itself has, `sortBy` the order the
// caller hands it, and `sortByKey` the order of a key made of each.
//
// All are methods, of a slice and of a `Vec`: `values.sort()`,
// `v.items().sortBy(…)`. The prelude holds no functions of its own, since
// each would be a name taken from every program.
//
// They are stable: two elements neither of which comes before the other
// stay in the order they came, so a list sorted by one thing and then by
// another is in order by the second, and by the first among equals. It is
// a merge sort, which takes a buffer of half the elements. `sortUnstable`
// and `sortUnstableBy` are heapsort, for a program that cannot spare the
// memory: the same number of comparisons whatever the input, and none of
// its own, and equals may change places.

/// Puts the elements in the order `before` gives, keeping equals in the
/// order they came: `before` answers whether its first argument belongs
/// before its second.
fn mergeSort<T>(values: &var [T], before: &(a: &T, b: &T) => bool) = {
	val count = values.len()
	if count < 2 then return
	// The elements are moved through the slots over them, and through a
	// buffer, each always in one place; the slots are the slice's, and
	// are let go of, not freed.
	var slots = Slots<T>::over(&values)
	var buffer: Slots<T> = Slots<T>::alloc(if count > SHORT then count / 2 + 1 else 0)
	sortRange(&var slots, &var buffer, 0, count, before)
	slots.release()
}

/// A piece no longer than this is put in order by insertion, which is
/// faster than merging where there are few.
val SHORT: i64 = 16

/// Puts the elements from `lo` to `hi` in order: each half, and then the
/// halves merged, where they are not in order already.
fn sortRange<T>(
	slots: &var Slots<T>,
	buffer: &var Slots<T>,
	lo: i64,
	hi: i64,
	before: &(a: &T, b: &T) => bool,
) = {
	if hi - lo <= SHORT {
		insertionSort(&var slots, lo, hi, before)
		return
	}
	val mid = lo + (hi - lo) / 2
	sortRange(&var slots, &var buffer, lo, mid, before)
	sortRange(&var slots, &var buffer, mid, hi, before)
	// Where the halves meet in order, the whole is.
	if !before(&slots.slot(mid), &slots.slot(mid - 1)) then return
	merge(&var slots, &var buffer, lo, mid, hi, before)
}

/// Puts the elements from `lo` to `hi` in order by taking each and moving
/// it back past those it comes before. An equal is never passed, so equals
/// keep their order.
fn insertionSort<T>(slots: &var Slots<T>, lo: i64, hi: i64, before: &(a: &T, b: &T) => bool) = {
	for i in lo + 1..hi {
		if !before(&slots.slot(i), &slots.slot(i - 1)) then continue
		val taken = slots.moveOut(i)
		var at = i
		while at > lo && before(&taken, &slots.slot(at - 1)) {
			slots.moveIn(at, slots.moveOut(at - 1))
			at -= 1
		}
		slots.moveIn(at, move taken)
	}
}

/// Merges the runs from `lo` to `mid` and from `mid` to `hi`, each in
/// order, into one: the first is moved into the buffer, and each place
/// from `lo` on takes the one of the two runs' next that comes first —
/// the first run's where neither does, so equals keep their order.
fn merge<T>(
	slots: &var Slots<T>,
	buffer: &var Slots<T>,
	lo: i64,
	mid: i64,
	hi: i64,
	before: &(a: &T, b: &T) => bool,
) = {
	val left = mid - lo
	for k in 0..left {
		buffer.moveIn(k, slots.moveOut(lo + k))
	}
	var i = 0
	var j = mid
	var out = lo
	while i < left && j < hi {
		if before(&slots.slot(j), &buffer.slot(i)) {
			slots.moveIn(out, slots.moveOut(j))
			j += 1
		} else {
			slots.moveIn(out, buffer.moveOut(i))
			i += 1
		}
		out += 1
	}
	// What is left of the second run is where it belongs already.
	while i < left {
		slots.moveIn(out, buffer.moveOut(i))
		i += 1
		out += 1
	}
}

/// Puts the elements in the order `before` gives, where they lie and with
/// no memory of its own; equals may change places.
fn heapsort<T>(values: &var [T], before: &(a: &T, b: &T) => bool) = {
	val count = values.len()
	// Every parent, from the last one back, gets its larger child above it.
	var start = count / 2
	while start > 0 {
		start -= 1
		siftDown(&var values, before, start, count)
	}
	// The largest is at the front: put it where it belongs, shrink the
	// heap, and let the one that took its place fall to its own level.
	var end = count
	while end > 1 {
		end -= 1
		values.swap(0, end)
		siftDown(&var values, before, 0, end)
	}
}

/// Lets the element at `root` fall until neither child comes after it.
/// `end` is where the heap stops, which is not always where the slice does.
fn siftDown<T>(values: &var [T], before: &(a: &T, b: &T) => bool, root: i64, end: i64) = {
	var parent = root
	while parent * 2 + 1 < end {
		var child = parent * 2 + 1
		if child + 1 < end && before(&values[child], &values[child + 1]) then child += 1
		if !before(&values[parent], &values[child]) then return
		values.swap(parent, child)
		parent = child
	}
}

// Any slice sorts in an order it is given.
extend [T] {
	/// Puts the elements in the order `before` gives, where they lie,
	/// equals in the order they came: it answers whether its first argument
	/// belongs before its second.
	pub var fn sortBy(before: &(a: &T, b: &T) => bool) = mergeSort(&var self, before)

	/// Puts the elements in the order of the key `key` makes of each,
	/// equals in the order they came: `people.sortByKey((p) => p.age)`.
	pub var fn sortByKey<K: Ord>(key: &(x: &T) => K) = mergeSort(&var self, (a: &T, b: &T) =>
		key(&a) < key(&b))

	/// Puts the elements in the order `before` gives, with no memory of its
	/// own; equals may change places.
	pub var fn sortUnstableBy(before: &(a: &T, b: &T) => bool) = heapsort(&var self, before)
}

extend Vec<T> {
	/// Puts the vector's elements in the order `before` gives, equals in
	/// the order they came.
	pub var fn sortBy(before: &(a: &T, b: &T) => bool) = mergeSort(&var self.items(), before)

	/// Puts the vector's elements in the order of the key `key` makes of
	/// each, equals in the order they came.
	pub var fn sortByKey<K: Ord>(key: &(x: &T) => K) = self.items().sortByKey(key)

	/// Puts the vector's elements in the order `before` gives, with no
	/// memory of its own; equals may change places.
	pub var fn sortUnstableBy(before: &(a: &T, b: &T) => bool) = heapsort(&var self.items(), before)
}

// What a slice can do when its elements have an order.
extend [T: Ord] {
	/// Puts the elements in order, the smallest first, where they lie,
	/// equals in the order they came.
	pub var fn sort() = mergeSort(&var self, (a: &T, b: &T) => a.compare(&b).isLess())

	/// Puts the elements in order, the smallest first, with no memory of
	/// its own; equals may change places.
	pub var fn sortUnstable() = heapsort(&var self, (a: &T, b: &T) => a.compare(&b).isLess())

	/// Whether the elements are already in order.
	pub fn isSorted(): bool = {
		for i in 1..self.len() {
			if self[i] < self[i - 1] then return false
		}
		return true
	}
}

extend Vec<T: Ord> {
	/// Puts the vector's elements in order, the smallest first, equals in
	/// the order they came.
	pub var fn sort() = self.items().sort()

	/// Puts the vector's elements in order, with no memory of its own.
	pub var fn sortUnstable() = self.items().sortUnstable()

	/// Whether the vector's elements are already in order.
	pub fn isSorted(): bool = self.items().isSorted()
}
