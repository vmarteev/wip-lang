// What a slice can do whatever its elements are: swap and reverse them in
// place, ask about them, and walk them with the iterator adapters.
// Finding an element by equality or order is `search.wip`'s, and sorting
// `sort.wip`'s. A `Vec` lends its elements as a slice, and forwards these. What
// `walk` and `backwards` answer is `std::iter`'s.

import std::iter::{Backwards, Forwards, Walk}
import std::libc

// A slice is a sequence, and so is an array, through the
// slice it lends. `xs[i]` on either is still the machine's own indexing;
// this is what generic code over `Sequence<T>` reaches them through.
extend [T]: Sequence<T> {
	/// How many elements there are.
	@intrinsic
	fn len(): i64

	fn at(i: i64): &T = lend self[i]
}

extend [T] {
	/// Whether there are no elements.
	pub fn isEmpty(): bool = self.len() == 0

	/// The elements at `i` and `j` change places. A swap is not a move out
	/// of either: it leaves no hole, so it works for elements that own
	/// memory as well as for numbers, which is what sorting needs.
	@intrinsic
	pub var fn swap(i: i64, j: i64)

	/// The elements before `at` and those from it, each lent as a slice of
	/// its own, together, for `body`'s call: two parts of one slice that
	/// may be changed at once, since they do not overlap — what threads
	/// that each change their own part are given. It panics
	/// where `at` is not from 0 to the length.
	pub var fn split<R>(at: i64, body: &var (first: &var [T], second: &var [T]) => R): R = {
		if at < 0 || at > self.len() then panic("split at \(at) of a slice of \(self.len())")
		val first = pointerTo<T>(&self)
		val second = offsetBytes(first as ptr<u8>, at * (sizeOf<T>() as i64)) as ptr<T>
		return body(&var sliceAt<T>(first, at), &var sliceAt<T>(second, self.len() - at))
	}

	/// The elements the other way about, where they lie.
	pub var fn reverse() = {
		var i = 0
		var j = self.len() - 1
		while i < j {
			self.swap(i, j)
			i += 1
			j -= 1
		}
	}

	/// Whether `test` answers true for any element. It stops at the first.
	pub fn any(test: &(x: &T) => bool): bool = {
		for x in self {
			if test(&x) then return true
		}
		return false
	}

	/// Whether `test` answers true for every element. It stops at the
	/// first that fails.
	pub fn all(test: &(x: &T) => bool): bool = {
		for x in self {
			if !test(&x) then return false
		}
		return true
	}

	/// How many elements `test` answers true for. An iterator's `count()`
	/// counts them all; a slice's length is `len()`.
	pub fn countWhere(test: &(x: &T) => bool): i64 = {
		var n = 0
		for x in self {
			if test(&x) then n += 1
		}
		return n
	}
}

// Elements that are plain data can be copied out, so a slice of them can
// be filled, and handed to the adapters one copy at a time.
extend [T: copy] {
	/// Every element made `value`.
	pub var fn fill(value: T) = {
		for i in 0..self.len() {
			self[i] = value
		}
	}

	/// The elements, one at a time, as an iterator: what the adapters walk.
	/// `numbers.walk().map(own (n) => n * 2)`.
	pub fn walk(): Walk<T> = Walk::of(&self)

	/// Every element made the one at its index in `source`, which is as
	/// long: one copy of the memory.
	/// `window[at..at + n].copyFrom(&block)`. It panics where the lengths
	/// differ, as an index past the end does.
	pub var fn copyFrom(source: &[T]) = {
		if self.len() != source.len() then
			panic("copying \(source.len()) elements into \(self.len())")
		if self.len() > 0 {
			val bytes = self.len() * (sizeOf<T>() as i64)
			libc::memmove(
				pointerTo<T>(&self) as ptr<u8>,
				pointerTo<T>(source) as ptr<u8>,
				bytes as size_t,
			)
		}
	}

	/// The `count` elements from `from` copied to `to`, in one copy of the
	/// memory: `output.copyWithin(from: src, to: out,
	/// count: n)`. Where the two overlap, what is read is what was there
	/// before the copy began, as `memmove` copies. It panics where either
	/// range is outside the slice.
	pub var fn copyWithin(from: i64, to: i64, count: i64) = {
		val n = self.len()
		if count < 0 || from < 0 || to < 0 || from > n - count || to > n - count then
			panic("copying \(count) elements from \(from) to \(to) of \(n)")
		if count > 0 {
			val size = sizeOf<T>() as i64
			val first = pointerTo<T>(&self) as ptr<u8>
			libc::memmove(
				offsetBytes(first, to * size),
				offsetBytes(first, from * size),
				(count * size) as size_t,
			)
		}
	}
}

extend [T] {
	/// The elements from the first to the last, each lent where it lies, as
	/// an iterator: `rows.forwards().enumerate()`. `walk()` hands out
	/// copies of plain data instead.
	pub fn forwards(): Forwards<T> = Forwards::of(&self)

	/// The elements from the last to the first, each lent where it lies:
	/// `for rule in rules.backwards()`.
	pub fn backwards(): Backwards<T> = Backwards::of(&self)
}

// A vector does what the slice it lends does, by the same names,
// as it finds and sorts through it.
extend Vec<T> {
	/// The elements the other way about, where they lie.
	pub var fn reverse() = self.items().reverse()

	/// The elements from the first to the last, each lent where it lies.
	pub fn forwards(): Forwards<T> = self.items().forwards()

	/// The elements from the last to the first, each lent where it lies.
	pub fn backwards(): Backwards<T> = self.items().backwards()

	/// Whether `test` answers true for any element.
	pub fn any(test: &(x: &T) => bool): bool = self.items().any(test)

	/// Whether `test` answers true for every element.
	pub fn all(test: &(x: &T) => bool): bool = self.items().all(test)

	/// How many elements `test` answers true for.
	pub fn countWhere(test: &(x: &T) => bool): i64 = self.items().countWhere(test)
}

extend Vec<T: copy> {
	/// Every element made `value`.
	pub var fn fill(value: T) = self.items().fill(value)

	/// Every element made the one at its index in `source`, which is as
	/// long, in one copy.
	pub var fn copyFrom(source: &[T]) = self.items().copyFrom(source)

	/// The `count` elements from `from` copied to `to`, in one copy.
	pub var fn copyWithin(from: i64, to: i64, count: i64) = self.items().copyWithin(
		from: from,
		to: to,
		count: count,
	)

	/// The elements, one at a time, as an iterator.
	pub fn walk(): Walk<T> = self.items().walk()
}

/// The address of a slice's first element.
@intrinsic
fn pointerTo<T>(values: &[T]): ptr<T>

/// The slice of `count` elements from `first`, lent for writing.
@intrinsic
fn sliceAt<T>(first: ptr<T>, count: i64): &var [T]

/// How far one element is from the next.
@intrinsic
fn sizeOf<T>(): size_t
