/// How one error becomes another, which `?` uses where the function's error
/// type is not the one it was given.
///
///     extend ConfigError: From<io::IoError> {
///         static fn from(error: io::IoError): ConfigError = .Io(error)
///     }
///
/// A type may implement it once per type it converts from. Nothing is
/// implicit: `?` only finds the conversion a program wrote.
pub interface From<T> {
	static fn from(value: T): Self
}
