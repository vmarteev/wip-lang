// A copy of a value: `value.clone()` answers another value,
// equal to it, that owns what it holds on its own — a `String`'s bytes, a
// `Vec`'s elements, each cloned in turn.
//
// `@derive(Clone)` on a struct or an enum makes the compiler write
// `clone` field by field, and for an enum the variant it holds. What owns
// no memory — a number, a `bool`, a `char`, a `str`, a plain struct — is
// its own clone without saying so: the compiler copies it.

/// A value that can be copied into another that owns what it holds.
pub interface Clone {
	fn clone(): Self
}

/// A clone of what `value` refers to, of its own type: where that type is
/// a `&T` reference, the reference copied, where `value.clone()` would
/// look through it to what it refers to. It is what `@derive(Clone)`
/// writes for each field.
pub fn cloneOf<T: Clone>(value: &T): T = value.clone()

extend String: Clone {
	fn clone(): String = String::of(self)
}

// A vector's elements, each cloned, in order.
extend Vec<T: Clone>: Clone {
	fn clone(): Vec<T> = {
		var copy: Vec<T> = Vec::withCapacity(self.len())
		for i in 0..self.len() {
			copy.push(self.at(i).clone())
		}
		return move copy
	}
}

extend Option<T: Clone>: Clone {
	fn clone(): Option<T> = match self {
		.Some(value) => .Some(value.clone())
		.None => .None
	}
}

extend Result<T: Clone, E: Clone>: Clone {
	fn clone(): Result<T, E> = match self {
		.Ok(value) => .Ok(value.clone())
		.Err(error) => .Err(error.clone())
	}
}

// A tuple's elements, each cloned.
extend Tuple2<A: Clone, B: Clone>: Clone {
	fn clone(): (A, B) = (self.0.clone(), self.1.clone())
}

extend Tuple3<A: Clone, B: Clone, C: Clone>: Clone {
	fn clone(): (A, B, C) = (self.0.clone(), self.1.clone(), self.2.clone())
}

extend Tuple4<A: Clone, B: Clone, C: Clone, D: Clone>: Clone {
	fn clone(): (A, B, C, D) = (self.0.clone(), self.1.clone(), self.2.clone(), self.3.clone())
}
