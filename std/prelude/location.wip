// A place in a program, which a function is told its caller's by: an
// implicit parameter of type `Location`, where the call has no implicit of
// its name, is filled with the place of the call. A function that takes
// one and calls another that does hands its own on, so the place is the
// first call into the chain; `panic(message, at: at)` reports it.

/// A place in a program: its file, as a panic names it, its line and
/// column, and the function it is in, named as a panic's trace names it.
/// Its strings are the program's own, kept as long as it runs.
@derive(Eq)
pub view struct Location {
	pub file: str
	pub line: i64
	pub column: i64
	pub function: str
}

extend Location: Text {
	/// `file:line:column`, as a panic prints its place.
	fn appendTo(out: &var String) = {
		out.push(self.file)
		out.pushChar(':')
		out.pushInt(self.line)
		out.pushChar(':')
		out.pushInt(self.column)
	}
}
