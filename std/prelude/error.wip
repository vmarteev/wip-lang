// What happens when `main` hands back an error. An error is
// any value that can be written as text, which is what `Text` already means:
// the program says so on standard error and ends with 1 —
// a program working as written, where a panic's 101 means a program that is
// wrong.

import std::libc::{fflush, fwrite, stdout, stderr}

// The exit code of a `main` that returns `Result<i64, E>`: the value it
// gives, or 1 once the error is reported. The code generator calls one of
// these two with what `main` returned, so nothing here is a program's to
// call.
fn exitCode<E: Text>(result: Result<i64, E>): i64 = match move result {
	.Ok(value) => value
	.Err(error) => report(move error)
}

// The same, for a `main` that returns `Result<void, E>`.
fn exitVoid<E: Text>(result: Result<void, E>): i64 = match move result {
	.Ok(..) => 0
	.Err(error) => report(move error)
}

// The message, built by the error itself, on standard error.
fn report<E: Text>(error: E): i64 = {
	var text = String()
	text.push("error: ")
	error.appendTo(&var text)
	text.push("\n")
	// What the program printed goes out first: standard output is
	// buffered and standard error is not, so otherwise the report arrives
	// before the output it is about.
	fflush(stdout)
	fwrite(text, 1, stderr)
	return 1
}
