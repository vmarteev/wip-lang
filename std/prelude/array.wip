// What an array makes of itself: an array of its own length, held where
// it is; and an array made by a function of each index. Its other methods
// are its slice's. An array of values that own memory is made in slots in
// place, `InlineSlots`, and handed over whole once each holds a value.

// This body is the compiler's: the slots, every one of which holds a
// value, are the array.
extend InlineSlots<T, N> {
	/// The array the slots are, where every one of them holds a value: the
	/// caller has filled them all. Nothing is moved but the array itself.
	@intrinsic
	move fn intoItems(): [T; N]
}

extend [T; N] {
	/// Each element, as `f` makes it into another, in an array as long:
	/// `[1, 2, 3].map((n) => n * 10)` is `[10, 20, 30]`, an `[i64; 3]`.
	pub fn map<U>(f: &var (x: &T) => U): [U; N] = {
		var made: InlineSlots<U, N> = InlineSlots<U, N>::empty()
		for i in 0..N {
			made.moveIn(i, f(&self[i]))
			made.len = i + 1
		}
		return made.intoItems()
	}
}

/// The array whose element `i` is `make(i)`, made for each index in order,
/// its length and element type the type expected's: `val tens: [i64; 3] =
/// madeBy((i) => i * 10)` is `[0, 10, 20]`, and `madeBy((_) => Vec())`
/// makes each `Vec` of its own.
pub fn madeBy<T, val N>(make: &var (i: i64) => T): [T; N] = {
	var made: InlineSlots<T, N> = InlineSlots<T, N>::empty()
	for i in 0..N {
		made.moveIn(i, make(i))
		made.len = i + 1
	}
	return made.intoItems()
}
