// Methods of the integer types. A built-in type's methods
// are the prelude's, because a method is found by the type of its receiver:
// one written anywhere else would appear in files that never asked for it.
//
// Every integer type has the same few, and its smallest and largest values,
// `MIN` and `MAX`; an unsigned one has no `abs`, which would change nothing.
extend i8 {
	/// The smallest `i8`.
	pub val MIN: i8 = -127 - 1

	/// The largest `i8`.
	pub val MAX: i8 = 127

	/// Without its sign. The smallest value has no positive of its own, and
	/// panics, as `-` does.
	pub fn abs(): i8 = if self < 0 then -self else self

	/// The smaller of the two.
	pub fn min(other: i8): i8 = if self < other then self else other

	/// The larger of the two.
	pub fn max(other: i8): i8 = if self > other then self else other

	/// Brought inside `low` and `high`.
	pub fn clamp(low: i8, high: i8): i8 = self.max(low).min(high)
}

