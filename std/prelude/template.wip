// Templates: what an interpolated literal builds. Where a type that
// implements `Template` is expected, `"<li>\(name)</li>"` builds that type:
// its own text goes to `pushLiteral` as the program wrote it, and each hole
// to the type's `pushValue`, which says what a value becomes in it. Where
// none is expected it builds a `String`, which is a template too.

/// A type an interpolated literal builds where one is expected: the
/// literal's own text, and each hole's value, given to it in order.
///
/// A hole goes to the type's `pushValue`, which is not in the interface,
/// since what it takes is the type's: its value lent, and the hole's
/// options as its named arguments. A hole of the type itself is joined by
/// `pushBuilt`.
pub interface Template {
	/// An empty one, with room for about `capacity` bytes.
	static fn withCapacity(capacity: i64): Self

	/// A piece of the literal's own text, as the program wrote it.
	var fn pushLiteral(text: str)

	/// A hole whose value is of this type already: joined as it is, or
	/// refused, at the hole's place, where the type cannot join it there.
	var fn pushBuilt(built: &Self, implicit at: Location)
}

// A `String` is what an interpolation builds where nothing else is
// expected: each piece of text pushed, and each value's `Text`.
extend String: Template {
	/// The empty text, with room for `capacity` bytes.
	static fn withCapacity(capacity: i64): String = String(Vec::withCapacity(capacity))

	var fn pushLiteral(text: str) = self.push(text)

	var fn pushBuilt(built: &String, implicit at: Location) = self.push(built.toStr())
}

extend String {
	/// A hole's value, at the end: its `Text`, made up to `width`
	/// characters where a width is said, with `fill`, on the side `align`
	/// says.
	pub var fn pushValue<T: Text>(
		value: &T,
		width: Option<i64> = .None,
		fill: char = ' ',
		align: Option<Align> = .None,
	) = match width {
		.Some(width) => value.appendFitted(&var self, width:, fill:, align:)
		.None => value.appendTo(&var self)
	}
}
