// A text cut where Unicode says: its graphemes, what a reader takes for one
// character, and the step from a caret to the next and the last; its
// words, which a double-click selects and Ctrl+Arrow jumps by; and where
// its lines may break, which wrapping asks. Each
// answers byte offsets into the text, as `indexOf` does; the rules are
// `std::text`'s.

import std::text
import std::text::{Graphemes, LineBreaks, WordSegments}

extend str {
	/// The graphemes, one at a time, each a `str` into the text: what a
	/// reader takes for one character — a letter with its accents, a flag,
	/// a family of emoji — by Unicode's extended grapheme clusters.
	pub fn graphemes(): Graphemes = text::graphemes(self)

	/// Where the grapheme after byte `at` ends: the next place a caret
	/// stops, and the end where there is no more. From inside a grapheme,
	/// its end.
	pub fn nextGrapheme(at: i64): i64 = text::nextGrapheme(self, at)

	/// Where the grapheme before byte `at` begins: the last place a caret
	/// stopped, and 0 where there is no more. From inside a grapheme, its
	/// start.
	pub fn previousGrapheme(at: i64): i64 = text::previousGrapheme(self, at)

	/// The pieces between each two of its word boundaries, in order, by
	/// Unicode's default rules: each a `WordSegment`, its text, where it
	/// begins, and whether it is a word rather than spaces or punctuation.
	/// `can't` and `3.14` are each one; a script written without spaces is
	/// cut as the rules cut it, each ideograph one, with no dictionary.
	pub fn wordSegments(): WordSegments = text::wordSegments(self)

	/// The first word boundary after byte `at`, and the end where there is
	/// none: where Ctrl+Right goes, before it skips what is not a word.
	pub fn nextWordBoundary(at: i64): i64 = text::nextWordBoundary(self, at)

	/// The last word boundary before byte `at`, and 0 where there is none.
	pub fn previousWordBoundary(at: i64): i64 = text::previousWordBoundary(self, at)

	/// Each place a line may begin, in order, by Unicode's default rules,
	/// as a `LineBreak`: where it begins, and whether a line must begin
	/// there, after a newline, rather than may. The text's end is the last,
	/// and must. It measures nothing: a layout asks it where a line that is
	/// too wide may be cut.
	pub fn lineBreaks(): LineBreaks = text::lineBreaks(self)
}

extend String {
	/// The graphemes, one at a time, each a `str` into the text.
	pub fn graphemes(): Graphemes = self.toStr().graphemes()

	/// Where the grapheme after byte `at` ends.
	pub fn nextGrapheme(at: i64): i64 = self.toStr().nextGrapheme(at)

	/// Where the grapheme before byte `at` begins.
	pub fn previousGrapheme(at: i64): i64 = self.toStr().previousGrapheme(at)

	/// The pieces between each two of its word boundaries, in order.
	pub fn wordSegments(): WordSegments = self.toStr().wordSegments()

	/// The first word boundary after byte `at`.
	pub fn nextWordBoundary(at: i64): i64 = self.toStr().nextWordBoundary(at)

	/// The last word boundary before byte `at`.
	pub fn previousWordBoundary(at: i64): i64 = self.toStr().previousWordBoundary(at)

	/// Each place a line may begin, in order.
	pub fn lineBreaks(): LineBreaks = self.toStr().lineBreaks()

	/// The last grapheme taken off, or nothing where the text is empty: what
	/// one Backspace erases, as `popChar` takes one character.
	pub var fn popGrapheme(): Option<String> = {
		if self.isEmpty() then
			return .None

		val from = self.previousGrapheme(self.len())
		val taken = self.toStr()[from..self.len()].toString()
		self.bytes.truncate(from)
		return taken
	}
}
