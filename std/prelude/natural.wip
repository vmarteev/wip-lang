// A natural number of any size, which a float's text is worked out in:
// the exact value of a float, or of a decimal, as a fraction of two of
// them.

/// 10 to the 0th through 8th, each a limb's worth.
val TENS: [u32; 9] = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000]

/// A natural number of any size: 32-bit limbs, the lowest first, and no
/// zero limb at the top, so that zero has none.
@derive(Clone)
struct Natural {
	limbs: Vec<u32>
}

extend Natural {
	static fn of(value: u64): Natural = {
		var limbs: Vec<u32> = Vec()
		var rest = value
		while rest != 0 {
			limbs.push(rest as% u32)
			rest = rest >> 32
		}
		return Natural(limbs:)
	}

	fn isZero(): bool = self.limbs.isEmpty()

	/// How many bits it takes, to its highest one: 0 for zero.
	fn bitLength(): i64 = {
		if self.limbs.isEmpty() then
			return 0

		val top = self.limbs[self.limbs.len() - 1]
		return self.limbs.len() * 32 - top.leadingZeros() as i64
	}

	/// Whether its lowest bit is one.
	fn isOdd(): bool = !self.limbs.isEmpty() && self.limbs[0] & 1 == 1

	/// Without the zero limbs at its top.
	var fn trimmed() = {
		while !self.limbs.isEmpty() && self.limbs[self.limbs.len() - 1] == 0 do
			self.limbs.pop()
	}

	/// Multiplied by `factor`.
	var fn times(factor: u32) = {
		var carry: u64 = 0
		for i in 0..self.limbs.len() {
			val product = (self.limbs[i] as u64) * (factor as u64) + carry
			self.limbs[i] = product as% u32
			carry = product >> 32
		}
		if carry != 0 then
			self.limbs.push(carry as% u32)

		self.trimmed()
	}

	/// Multiplied by 10 to the `count`th.
	var fn timesTenTo(count: i64) = {
		var left = count
		while left >= 9 {
			self.times(1000000000)
			left -= 9
		}
		if left > 0 then
			self.times(TENS[left])
	}

	/// Multiplied by 2 to the `count`th.
	var fn shiftedUp(count: i64) = {
		if self.isZero() || count <= 0 then
			return

		val bits = (count % 32) as u32
		if bits != 0 {
			var carry: u32 = 0
			for i in 0..self.limbs.len() {
				val limb = self.limbs[i]
				self.limbs[i] = (limb << bits) | carry
				carry = limb >> (32 - bits)
			}
			if carry != 0 then
				self.limbs.push(carry)
		}
		val whole = count / 32
		if whole > 0 {
			var moved: Vec<u32> = Vec::filled(whole, 0)
			moved.pushAll(&self.limbs)
			self.limbs = moved
		}
	}

	/// Divided by 2 to the `count`th, what is below gone.
	var fn shiftedDown(count: i64) = {
		val whole = count / 32
		if whole >= self.limbs.len() {
			self.limbs = Vec()
			return
		}
		var kept: Vec<u32> = Vec()
		for i in whole..self.limbs.len() do
			kept.push(self.limbs[i])

		val bits = (count % 32) as u32
		if bits != 0 {
			for i in 0..kept.len() {
				val above = if i + 1 < kept.len() then kept[i + 1] << (32 - bits) else 0
				kept[i] = (kept[i] >> bits) | above
			}
		}
		self.limbs = kept
		self.trimmed()
	}

	/// Whether its bit `index`, from the lowest, is one.
	fn bitAt(index: i64): bool = {
		val limb = index / 32
		return limb < self.limbs.len() && (self.limbs[limb] >> (index % 32) as u32) & 1 == 1
	}

	/// Whether any of its bits below `index` is one.
	fn anyBelow(index: i64): bool = {
		for i in 0..index do
			if self.bitAt(i) then
				return true

		return false
	}

	/// -1, 0 or 1, as twice it is less than, equal to or more than `other`.
	fn compareTwice(other: &Natural): i64 = {
		// Twice it has at most one limb more; each limb of it is this one's
		// shifted up a bit, with the top bit of the limb below.
		val count = self.limbs.len() + 1
		if count < other.limbs.len() then
			return -1

		var i = count
		while i > 0 {
			i -= 1
			val mine = if i < self.limbs.len() then (self.limbs[i] as u64) << 1 else 0
			val carried =
				if i > 0 && i - 1 < self.limbs.len() then (self.limbs[i - 1] as u64) >> 31 else 0
			val doubled = (mine | carried) & 0xFFFFFFFF
			val theirs = if i < other.limbs.len() then other.limbs[i] as u64 else 0
			if doubled != theirs then
				return if doubled < theirs then -1 else 1
		}
		return 0
	}

	/// -1, 0 or 1, as it and `more` together are less than, equal to or
	/// more than `other`.
	fn compareSum(more: &Natural, other: &Natural): i64 = {
		val count = self.limbs.len().max(more.limbs.len()) + 1
		// Their sum's limbs, from the lowest, where there are few enough.
		if count > 64 {
			var whole = self.clone()
			whole.plus(&more)
			return whole.compare(&other)
		}
		var sum: [u32; 64] = [0; 64]
		var carry: u64 = 0
		for i in 0..count {
			val a = if i < self.limbs.len() then self.limbs[i] as u64 else 0
			val b = if i < more.limbs.len() then more.limbs[i] as u64 else 0
			val total = a + b + carry
			sum[i] = total as% u32
			carry = total >> 32
		}
		var top = count
		while top > 0 && sum[top - 1] == 0 do
			top -= 1

		if top != other.limbs.len() then
			return if top < other.limbs.len() then -1 else 1

		var i = top
		while i > 0 {
			i -= 1
			if sum[i] != other.limbs[i] then
				return if sum[i] < other.limbs[i] then -1 else 1
		}
		return 0
	}

	/// Plus `other`.
	var fn plus(other: &Natural) = {
		var carry: u64 = 0
		val count = self.limbs.len().max(other.limbs.len())
		for i in 0..count {
			val a = if i < self.limbs.len() then self.limbs[i] as u64 else 0
			val b = if i < other.limbs.len() then other.limbs[i] as u64 else 0
			val total = a + b + carry
			if i < self.limbs.len() then
				self.limbs[i] = total as% u32
			else
				self.limbs.push(total as% u32)

			carry = total >> 32
		}
		if carry != 0 then
			self.limbs.push(carry as% u32)
	}

	/// -1, 0 or 1, as it is less than, equal to or more than `other`.
	fn compare(other: &Natural): i64 = {
		if self.limbs.len() != other.limbs.len() then
			return if self.limbs.len() < other.limbs.len() then -1 else 1

		var i = self.limbs.len()
		while i > 0 {
			i -= 1
			if self.limbs[i] != other.limbs[i] then
				return if self.limbs[i] < other.limbs[i] then -1 else 1
		}
		return 0
	}

	/// Less `other`, which is no more than it.
	var fn minus(other: &Natural) = {
		var borrow: u64 = 0
		for i in 0..self.limbs.len() {
			val take = (if i < other.limbs.len() then other.limbs[i] as u64 else 0) + borrow
			val have = self.limbs[i] as u64
			if have >= take {
				self.limbs[i] = (have - take) as% u32
				borrow = 0
			} else {
				self.limbs[i] = (have + 4294967296 - take) as% u32
				borrow = 1
			}
		}
		self.trimmed()
	}

	/// Plus one.
	var fn plusOne() = {
		for i in 0..self.limbs.len() {
			if self.limbs[i] != 0xFFFFFFFF {
				self.limbs[i] += 1
				return
			}
			self.limbs[i] = 0
		}
		self.limbs.push(1)
	}

	/// Divided by `divisor`, which it becomes the quotient of: what is left.
	var fn dividedBy(divisor: u32): u32 = {
		var rest: u64 = 0
		var i = self.limbs.len()
		while i > 0 {
			i -= 1
			val current = (rest << 32) | (self.limbs[i] as u64)
			self.limbs[i] = (current / (divisor as u64)) as% u32
			rest = current % (divisor as u64)
		}
		self.trimmed()
		return rest as% u32
	}

	/// Its decimal digits, the first first: `0` for zero.
	fn decimal(): Vec<u8> = {
		if self.isZero() then
			return [b'0']

		var rest = self.clone()
		var backwards: Vec<u8> = Vec()
		while !rest.isZero() {
			var chunk = rest.dividedBy(1000000000)
			// Nine digits a chunk, but the last, which has no zeros before it.
			for _ in 0..9 {
				backwards.push(b'0' + (chunk % 10) as% u8)
				chunk = chunk / 10
				if rest.isZero() && chunk == 0 then
					break
			}
		}
		var digits: Vec<u8> = Vec()
		for i in 0..backwards.len() do
			digits.push(backwards[backwards.len() - 1 - i])

		return digits
	}
}
