// Tuples: the struct a program did not name. `(A, B)` is
// `Tuple2<A, B>`, `(a, b)` is its literal and `(x, y)` is its pattern; the
// fields are positions, `_0` and `_1`, and `pair.0` reads one.
//
// They are written out to four elements. A fifth is a struct with a name,
// and by then the names are what the reader wants.

/// `(A, B)`.
pub struct Tuple2<A, B> {
	pub var _0: A
	pub var _1: B
}

/// `(A, B, C)`.
pub struct Tuple3<A, B, C> {
	pub var _0: A
	pub var _1: B
	pub var _2: C
}

/// `(A, B, C, D)`.
pub struct Tuple4<A, B, C, D> {
	pub var _0: A
	pub var _1: B
	pub var _2: C
	pub var _3: D
}
