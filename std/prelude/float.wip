// Floating-point numbers: the maths a program reaches for,
// as methods of `f64` and `f32`, written in Wip so that the program and the
// compiler, which runs them for a `@comptime` constant, give one answer on
// every machine. What the machine does exactly — the square
// root, `floor`, `ceil`, `trunc` — is one instruction each; what is exact in
// a few steps is written here, over a float's bits; and the rest are
// ported: `trigonometry.wip`, `inverse_trigonometry.wip` and
// `logarithm10.wip` from fdlibm, as musl has them, and
// `exponential.wip`, `logarithm.wip`, `logarithm2.wip` and `power.wip` from
// Arm's optimized-routines, as glibc and musl have them. An
// `f32`'s are an `f64`'s, rounded once.
//
// `min` and `max` answer the other number where one is NaN, as C's
// `fmin` and `fmax` do, so a NaN does not spread through a clamp.
//
// `mulAdd` is the processor's fused multiply-add. An
// x86-64 processor older than 2013 has none, and C's `fma` is called in its
// place, which answers the same; on Linux that is in the maths library,
// which the block below links for that alone. It declares nothing.

@target(os = "linux", arch = "x86_64")
@link("m")
extern "C" {}

extend f64 {
	/// The square root, correctly rounded; NaN below zero.
	@intrinsic
	pub fn sqrt(): f64

	/// Of an angle in radians.
	@inline
	pub fn sin(): f64 = sine(self)

	/// Of an angle in radians.
	@inline
	pub fn cos(): f64 = cosine(self)

	/// Of an angle in radians.
	@inline
	pub fn tan(): f64 = tangent(self)

	/// The angle, in radians, whose sine it is.
	@inline
	pub fn asin(): f64 = arcsine(self)

	/// The angle, in radians, whose cosine it is.
	@inline
	pub fn acos(): f64 = arccosine(self)

	/// The angle, in radians, whose tangent it is.
	@inline
	pub fn atan(): f64 = arctangent(self)

	/// e to this power.
	@inline
	pub fn exp(): f64 = exponential(self)

	/// The natural logarithm.
	@inline
	pub fn ln(): f64 = logarithm(self)

	/// The logarithm to base 10.
	@inline
	pub fn log10(): f64 = logarithm10(self)

	/// The logarithm to base 2.
	@inline
	pub fn log2(): f64 = logarithm2(self)

	/// `self * by + plus`, rounded once where the two operations would
	/// round twice: IEEE 754's fused multiply-add.
	@intrinsic
	pub fn mulAdd(by: f64, plus: f64): f64

	/// The greatest whole number not above it.
	@intrinsic
	pub fn floor(): f64

	/// The least whole number not below it.
	@intrinsic
	pub fn ceil(): f64

	/// The nearest whole number, halves away from zero. What is taken off
	/// the whole part is exact, so comparing it with a half is.
	pub fn round(): f64 = {
		val whole = self.trunc()
		if (self - whole).abs() >= 0.5 then return whole + (if self < 0.0 then -1.0 else 1.0)
		return whole
	}

	/// The whole number toward zero.
	@intrinsic
	pub fn trunc(): f64

	/// Without its sign: the sign bit cleared.
	@inline
	pub fn abs(): f64 = f64::fromBits(self.toBits() & SIGN_F64 - 1)

	/// Its bits, as the unsigned integer of its width: the sign, the
	/// exponent and the fraction, as IEEE 754 lays them out.
	@intrinsic
	pub fn toBits(): u64

	/// The float whose bits these are.
	@intrinsic
	pub static fn fromBits(bits: u64): f64

	/// The angle, in radians, of the point `(x, self)` from the x axis.
	@inline
	pub fn atan2(x: f64): f64 = arctangentOf(self, x)

	/// This to the power of `exponent`.
	@inline
	pub fn pow(exponent: f64): f64 = power(self, exponent)

	/// The smaller of the two; the other where one is NaN, and a negative
	/// zero below a positive one.
	pub fn min(other: f64): f64 = {
		if self.isNaN() then return other
		if other.isNaN() then return self
		val signs = self.toBits() & SIGN_F64
		if signs != other.toBits() & SIGN_F64 then return if signs != 0 then self else other
		return if self < other then self else other
	}

	/// The larger of the two; the other where one is NaN, and a positive
	/// zero above a negative one.
	pub fn max(other: f64): f64 = {
		if self.isNaN() then return other
		if other.isNaN() then return self
		val signs = self.toBits() & SIGN_F64
		if signs != other.toBits() & SIGN_F64 then return if signs != 0 then other else self
		return if self < other then other else self
	}

	/// Brought inside `low` and `high`.
	pub fn clamp(low: f64, high: f64): f64 = self.max(low).min(high)

	/// Neither infinite nor NaN.
	pub fn isFinite(): bool = self - self == 0.0

	/// Whether it is not a number: the one value not equal to itself.
	pub fn isNaN(): bool = self != self
}

// `a % b`: what is left of `a` after taking out as many whole `b` as fit,
// with the sign of `a`, as C's `fmod` has it.
extend f64: Remainder {
	fn remainder(other: &f64): f64 = fmod(self, other)
}

extend f32 {
	/// The square root, correctly rounded; NaN below zero.
	@intrinsic
	pub fn sqrt(): f32

	/// Of an angle in radians.
	@inline
	pub fn sin(): f32 = sine(self as f64) as f32

	/// Of an angle in radians.
	@inline
	pub fn cos(): f32 = cosine(self as f64) as f32

	/// Of an angle in radians.
	@inline
	pub fn tan(): f32 = tangent(self as f64) as f32

	/// The angle, in radians, whose sine it is.
	@inline
	pub fn asin(): f32 = arcsine(self as f64) as f32

	/// The angle, in radians, whose cosine it is.
	@inline
	pub fn acos(): f32 = arccosine(self as f64) as f32

	/// The angle, in radians, whose tangent it is.
	@inline
	pub fn atan(): f32 = arctangent(self as f64) as f32

	/// e to this power.
	@inline
	pub fn exp(): f32 = exponential(self as f64) as f32

	/// The natural logarithm.
	@inline
	pub fn ln(): f32 = logarithm(self as f64) as f32

	/// The logarithm to base 10.
	@inline
	pub fn log10(): f32 = logarithm10(self as f64) as f32

	/// The logarithm to base 2.
	@inline
	pub fn log2(): f32 = logarithm2(self as f64) as f32

	/// `self * by + plus`, rounded once where the two operations would
	/// round twice: IEEE 754's fused multiply-add.
	@intrinsic
	pub fn mulAdd(by: f32, plus: f32): f32

	/// The greatest whole number not above it.
	@intrinsic
	pub fn floor(): f32

	/// The least whole number not below it.
	@intrinsic
	pub fn ceil(): f32

	/// The nearest whole number, halves away from zero. What is taken off
	/// the whole part is exact, so comparing it with a half is.
	pub fn round(): f32 = {
		val whole = self.trunc()
		if (self - whole).abs() >= 0.5 then return whole + (if self < 0.0 then -1.0 else 1.0)
		return whole
	}

	/// The whole number toward zero.
	@intrinsic
	pub fn trunc(): f32

	/// Without its sign: the sign bit cleared.
	@inline
	pub fn abs(): f32 = f32::fromBits(self.toBits() & SIGN_F32 - 1)

	/// Its bits, as the unsigned integer of its width: the sign, the
	/// exponent and the fraction, as IEEE 754 lays them out.
	@intrinsic
	pub fn toBits(): u32

	/// The float whose bits these are.
	@intrinsic
	pub static fn fromBits(bits: u32): f32

	/// The angle, in radians, of the point `(x, self)` from the x axis.
	@inline
	pub fn atan2(x: f32): f32 = arctangentOf(self as f64, x as f64) as f32

	/// This to the power of `exponent`.
	@inline
	pub fn pow(exponent: f32): f32 = power(self as f64, exponent as f64) as f32

	/// The smaller of the two; the other where one is NaN, and a negative
	/// zero below a positive one.
	pub fn min(other: f32): f32 = {
		if self.isNaN() then return other
		if other.isNaN() then return self
		val signs = self.toBits() & SIGN_F32
		if signs != other.toBits() & SIGN_F32 then return if signs != 0 then self else other
		return if self < other then self else other
	}

	/// The larger of the two; the other where one is NaN, and a positive
	/// zero above a negative one.
	pub fn max(other: f32): f32 = {
		if self.isNaN() then return other
		if other.isNaN() then return self
		val signs = self.toBits() & SIGN_F32
		if signs != other.toBits() & SIGN_F32 then return if signs != 0 then other else self
		return if self < other then other else self
	}

	/// Brought inside `low` and `high`.
	pub fn clamp(low: f32, high: f32): f32 = self.max(low).min(high)

	/// Neither infinite nor NaN.
	pub fn isFinite(): bool = self - self == 0.0

	/// Whether it is not a number: the one value not equal to itself.
	pub fn isNaN(): bool = self != self
}

// `a % b`: what is left of `a` after taking out as many whole `b` as fit,
// with the sign of `a`, as C's `fmod` has it.
// An `f32`'s remainder is an `f64`'s, which is exact, and so is its way
// back.
extend f32: Remainder {
	fn remainder(other: &f32): f32 = fmod(self as f64, other as f64) as f32
}

/// The sign bits of the two widths.
val SIGN_F64: u64 = 0x8000000000000000
val SIGN_F32: u32 = 0x80000000

/// C's `fmod`, from musl: what is left of `x` after taking out as many
/// whole `y` as fit, with the sign of `x`, computed exactly on the
/// significands, one bit of the quotient at a time.
fn fmod(x: f64, y: f64): f64 = {
	val xBits = x.toBits()
	var yBits = y.toBits()
	var ex = ((xBits >> 52) & 0x7ff) as i64
	var ey = ((yBits >> 52) & 0x7ff) as i64
	val sign = xBits & SIGN_F64
	if yBits << 1 == 0 || y.isNaN() || ex == 0x7ff then return (x * y) / (x * y)
	var ux = xBits
	if ux << 1 <= yBits << 1 {
		if ux << 1 == yBits << 1 then return 0.0 * x
		return x
	}
	// Each significand with its leading bit, a subnormal's shifted up to
	// where a normal's would be: by as many places as it has zeros before
	// its highest bit.
	if ex == 0 {
		ex = -((ux << 12).leadingZeros() as i64)
		ux = ux << (1 - ex) as u64
	} else {
		ux = (ux & (0xFFFFFFFFFFFFFFFF >> 12)) | (1 << 52)
	}
	if ey == 0 {
		ey = -((yBits << 12).leadingZeros() as i64)
		yBits = yBits << (1 - ey) as u64
	} else {
		yBits = (yBits & (0xFFFFFFFFFFFFFFFF >> 12)) | (1 << 52)
	}
	while ex > ey {
		val i = ux -% yBits
		if i >> 63 == 0 {
			if i == 0 then return 0.0 * x
			ux = i
		}
		ux = ux << 1
		ex -= 1
	}
	val i = ux -% yBits
	if i >> 63 == 0 {
		if i == 0 then return 0.0 * x
		ux = i
	}
	// What is left, with its highest bit back where a significand's is.
	val shift = ux.leadingZeros() - 11
	ux = ux << shift
	ex -= shift as i64
	if ex > 0 then ux = (ux -% (1 << 52)) | ((ex as u64) << 52) else ux = ux >> (1 - ex) as u64
	return f64::fromBits(ux | sign)
}
