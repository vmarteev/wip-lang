// Sine, cosine and tangent of an `f64`, ported from musl's
// libm by way of the `libm` crate, which keep FreeBSD's msun, which is
// Sun's fdlibm:
//
// ====================================================
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//
// Developed at SunSoft, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
// ====================================================
//
// Optimized by Bruce D. Evans. musl's and the `libm` crate's changes are
// MIT-licensed.
//
// Each takes its angle to within a quarter turn of zero — `rem_pio2`, whose
// large case multiplies by as many bits of 2/π as the angle needs — and
// evaluates a polynomial there: `kSin`, `kCos` and `kTan`, each within an
// ulp.

// --- The polynomials, on [-π/4, π/4] ---------------------------------------

val SIN1: f64 = -1.66666666666666324348e-01
val SIN2: f64 = 8.33333333332248946124e-03
val SIN3: f64 = -1.98412698298579493134e-04
val SIN4: f64 = 2.75573137070700676789e-06
val SIN5: f64 = -2.50507602534068634195e-08
val SIN6: f64 = 1.58969099521155010221e-10

/// sin(x + y), where `y` is what `x` left out; `tail` 0 says there is none.
@inline
fn kSin(x: f64, y: f64, tail: i64): f64 = {
	val z = x * x
	val w = z * z
	val r = SIN2 + z * (SIN3 + z * SIN4) + z * w * (SIN5 + z * SIN6)
	val v = z * x
	if tail == 0 then return x + v * (SIN1 + z * r)
	return x - ((z * (0.5 * y - v * r) - y) - v * SIN1)
}

val COS1: f64 = 4.16666666666666019037e-02
val COS2: f64 = -1.38888888888741095749e-03
val COS3: f64 = 2.48015872894767294178e-05
val COS4: f64 = -2.75573143513906633035e-07
val COS5: f64 = 2.08757232129817482790e-09
val COS6: f64 = -1.13596475577881948265e-11

/// cos(x + y), where `y` is what `x` left out.
@inline
fn kCos(x: f64, y: f64): f64 = {
	val z = x * x
	val w = z * z
	val r = z * (COS1 + z * (COS2 + z * COS3)) + w * w * (COS4 + z * (COS5 + z * COS6))
	val hz = 0.5 * z
	val one = 1.0 - hz
	return one + (((1.0 - one) - hz) + (z * r - x * y))
}

val TAN_TERMS: [f64; 13] = [
	3.33333333333334091986e-01, 1.33333333333201242699e-01, 5.39682539762260521377e-02,
	2.18694882948595424599e-02, 8.86323982359930005737e-03, 3.59207910759131235356e-03,
	1.45620945432529025516e-03, 5.88041240820264096874e-04, 2.46463134818469906812e-04,
	7.81794442939557092300e-05, 7.14072491382608190305e-05, -1.85586374855275456654e-05,
	2.59073051863633712884e-05,
]
val PIO4: f64 = 7.85398163397448278999e-01
val PIO4_LO: f64 = 3.06161699786838301793e-17

/// tan(x + y), or -1/tan(x + y) where `odd` is 1.
fn kTan(x0: f64, y0: f64, odd: i64): f64 = {
	var x = x0
	var y = y0
	val hx = (x.toBits() >> 32) as i64
	// |x| >= 0.6744
	val big = (hx & 0x7fffffff) >= 0x3FE59428
	val negative = (hx >> 31) & 1 != 0
	if big {
		if negative {
			x = -x
			y = -y
		}
		x = (PIO4 - x) + (PIO4_LO - y)
		y = 0.0
	}
	val z = x * x
	val w = z * z
	// x^5 (T1 + x^2 T2 + ...), in two halves.
	val odds =
		TAN_TERMS[1] +
		w *
			(TAN_TERMS[3] +
				w * (TAN_TERMS[5] + w * (TAN_TERMS[7] + w * (TAN_TERMS[9] + w * TAN_TERMS[11]))))
	val evens =
		z *
		(TAN_TERMS[2] +
			w *
				(TAN_TERMS[4] +
					w *
						(TAN_TERMS[6] +
							w * (TAN_TERMS[8] + w * (TAN_TERMS[10] + w * TAN_TERMS[12])))))
	val s = z * x
	val r = y + z * (s * (odds + evens) + y) + s * TAN_TERMS[0]
	val sum = x + r
	if big {
		val sign = 1.0 - 2.0 * odd as f64
		val v = sign - 2.0 * (x + (r - sum * sum / (sum + sign)))
		return if negative then -v else v
	}
	if odd == 0 then return sum
	// -1/(x + r) has up to two ulps of error, so it is computed with care.
	val w0 = zeroLowWord(sum)
	val v = r - (w0 - x)
	val a = -1.0 / sum
	val a0 = zeroLowWord(a)
	return a0 + a * (1.0 + a0 * w0 + a0 * v)
}

// --- The angle, within a quarter turn: x = n π/2 + y0 + y1 -------------

/// 1.5 × 2^52: added and taken away, it rounds to a whole number.
val TO_INT: f64 = 6755399441055744.0
/// 53 bits of 2/π.
val INV_PIO2: f64 = 6.36619772367581382433e-01
/// π/2 in three parts of 33 bits, and what each leaves out.
val PIO2_1: f64 = 1.57079632673412561417e+00
val PIO2_1T: f64 = 6.07710050650619224932e-11
val PIO2_2: f64 = 6.07710050630396597660e-11
val PIO2_2T: f64 = 2.02226624879595063154e-21
val PIO2_3: f64 = 2.02226624871116645580e-21
val PIO2_3T: f64 = 8.47842766036889956997e-32

/// How many quarter turns `x` is, and what is left, in two parts.
fn remPio2(x: f64): (i64, f64, f64) = {
	val sign = (x.toBits() >> 63) as i64
	val ix = ((x.toBits() >> 32) as i64) & 0x7fffffff
	// |x| ~<= 5π/4
	if ix <= 0x400f6a7a {
		// |x| ~= π/2 or 2π/2, where the first steps would cancel.
		if (ix & 0xfffff) == 0x921fb then return remPio2Medium(x, ix)
		// |x| ~<= 3π/4
		if ix <= 0x4002d97c then return if sign == 0 then stepDown(x, 1) else stepUp(x, 1)
		return if sign == 0 then stepDown(x, 2) else stepUp(x, 2)
	}
	// |x| ~<= 9π/4
	if ix <= 0x401c463b {
		// |x| ~<= 7π/4
		if ix <= 0x4015fdbc {
			if ix == 0x4012d97c then return remPio2Medium(x, ix)
			return if sign == 0 then stepDown(x, 3) else stepUp(x, 3)
		}
		if ix == 0x401921fb then return remPio2Medium(x, ix)
		return if sign == 0 then stepDown(x, 4) else stepUp(x, 4)
	}
	// |x| ~< 2^20 π/2
	if ix < 0x413921fb then return remPio2Medium(x, ix)
	// Infinite, or not a number.
	if ix >= 0x7ff00000 {
		val nothing = x - x
		return (0, nothing, nothing)
	}
	// Large: z = |x| scaled to 2^23 and more, in three parts of 24 bits.
	val scaled = (x.toBits() & (0xFFFFFFFFFFFFFFFE >> 12)) | ((0x3ff + 23) << 52)
	var z = f64::fromBits(scaled)
	var parts: [f64; 3] = [0.0, 0.0, 0.0]
	for i in 0..2 {
		parts[i] = z as i64 as f64
		z = (z - parts[i]) * TWO_24
	}
	parts[2] = z
	var count = 3
	while count > 1 && parts[count - 1] == 0.0 {
		count -= 1
	}
	var reduced: [f64; 3] = [0.0, 0.0, 0.0]
	val n = remPio2Large(&parts[0..count], &var reduced, (ix >> 20) - (0x3ff + 23), 1)
	if sign != 0 then return (-n, -reduced[0], -reduced[1])
	return (n, reduced[0], reduced[1])
}

/// x less `k` quarter turns, for x near them from above.
@inline
fn stepDown(x: f64, k: i64): (i64, f64, f64) = {
	val turns = k as f64
	val z = x - turns * PIO2_1
	val y0 = z - turns * PIO2_1T
	val y1 = (z - y0) - turns * PIO2_1T
	return (k, y0, y1)
}

/// x plus `k` quarter turns, for x near minus them.
@inline
fn stepUp(x: f64, k: i64): (i64, f64, f64) = {
	val turns = k as f64
	val z = x + turns * PIO2_1
	val y0 = z + turns * PIO2_1T
	val y1 = (z - y0) + turns * PIO2_1T
	return (-k, y0, y1)
}

/// |x| up to 2^20 π/2: the nearest number of quarter turns, taken off in
/// as many rounds as the answer needs.
fn remPio2Medium(x: f64, ix: i64): (i64, f64, f64) = {
	// rint(x / (π/2)), rounding to the nearest.
	val turns = (x * INV_PIO2 + TO_INT) - TO_INT
	val n = turns as i64
	var r = x - turns * PIO2_1
	// The first round is good to 85 bits.
	var w = turns * PIO2_1T
	var y0 = r - w
	val ex = ix >> 20
	val ey = ((y0.toBits() >> 52) as i64) & 0x7ff
	if ex - ey > 16 {
		// The second, to 118 bits.
		var t = r
		w = turns * PIO2_2
		r = t - w
		w = turns * PIO2_2T - ((t - r) - w)
		y0 = r - w
		val ey2 = ((y0.toBits() >> 52) as i64) & 0x7ff
		if ex - ey2 > 49 {
			// The third, to 151 bits, which covers every case.
			t = r
			w = turns * PIO2_3
			r = t - w
			w = turns * PIO2_3T - ((t - r) - w)
			y0 = r - w
		}
	}
	val y1 = (r - y0) - w
	return (n, y0, y1)
}

val TWO_24: f64 = 16777216.0
val TWO_MINUS_24: f64 = 5.9604644775390625e-08

/// The bits of 2/π, 24 at a time: as many as an `f64`'s largest exponent
/// needs.
val IPIO2: [i64; 66] = [
	0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62, 0x95993C, 0x439041, 0xFE5163,
	0xABDEBB, 0xC561B7, 0x246E3A, 0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,
	0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41, 0x3991D6, 0x398353, 0x39F49C,
	0x845F8B, 0xBDF928, 0x3B1FF8, 0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,
	0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5, 0xF17B3D, 0x0739F7, 0x8A5292,
	0xEA6BFB, 0x5FB11F, 0x8D5D08, 0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,
	0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880, 0x4D7327, 0x310606, 0x1556CA,
	0x73A8C9, 0x60E27B, 0xC08C6B,
]

/// π/2 in parts of 24 bits.
val PIO2_PARTS: [f64; 8] = [
	1.57079625129699707031e+00, 7.54978941586159635335e-08, 5.39030252995776476554e-15,
	3.28200341580791294123e-22, 1.27065575308067607349e-29, 1.22933308981111328932e-36,
	2.73370053816464559624e-44, 2.16741683877804819444e-51,
]

/// The terms a precision keeps: `prec` 1, an `f64`'s, keeps four.
val INIT_JK: [i64; 4] = [3, 4, 4, 6]

/// A large angle, given as parts of 24 bits scaled by 2^e0, less as many
/// quarter turns as fit, into `y` — two parts for `prec` 1. Answers the
/// turns, modulo 8.
fn remPio2Large(x: &[f64], y: &var [f64], e0: i64, prec: i64): i64 = {
	var f: [f64; 20] = [0.0; 20]
	var fq: [f64; 20] = [0.0; 20]
	var q: [f64; 20] = [0.0; 20]
	var iq: [i64; 20] = [0; 20]
	val jk = INIT_JK[prec]
	val jp = jk
	val jx = x.len() - 1
	var jv = (e0 - 3) / 24
	if jv < 0 then jv = 0
	var q0 = e0 - 24 * (jv + 1)
	// The bits of 2/π the angle's multiplication needs.
	var j = jv - jx
	for i in 0..=jx + jk {
		f[i] = if j < 0 then 0.0 else IPIO2[j] as f64
		j += 1
	}
	for i in 0..=jk {
		var fw = 0.0
		for k in 0..=jx {
			fw += x[k] * f[jx + i - k]
		}
		q[i] = fw
	}
	var jz = jk
	var z = 0.0
	var n = 0
	var ih = 0
	var recompute = true
	while recompute {
		recompute = false
		// The product, as integers of 24 bits in `iq`.
		var i = 0
		z = q[jz]
		var k = jz
		while k >= 1 {
			val fw = (TWO_MINUS_24 * z) as i64 as f64
			iq[i] = (z - TWO_24 * fw) as i64
			z = q[k - 1] + fw
			i += 1
			k -= 1
		}
		z = scaledByPowerOfTwo(z, q0)
		// Past the eighth turn is a whole number of turns.
		z -= 8.0 * (z * 0.125).floor()
		n = z as i64
		z -= n as f64
		ih = 0
		if q0 > 0 {
			val carried = iq[jz - 1] >> (24 - q0)
			n += carried
			iq[jz - 1] -= carried << (24 - q0)
			ih = iq[jz - 1] >> (23 - q0)
		} else if q0 == 0 {
			ih = iq[jz - 1] >> 23
		} else if z >= 0.5 {
			ih = 2
		}
		// More than half a turn left: take the next one, and what is left
		// is negative.
		if ih > 0 {
			n += 1
			var carry = 0
			for m in 0..jz {
				val digit = iq[m]
				if carry == 0 {
					if digit != 0 {
						carry = 1
						iq[m] = 0x1000000 - digit
					}
				} else {
					iq[m] = 0xffffff - digit
				}
			}
			if q0 == 1 then iq[jz - 1] = iq[jz - 1] & 0x7fffff
			else if q0 == 2 then iq[jz - 1] = iq[jz - 1] & 0x3fffff
			if ih == 2 {
				z = 1.0 - z
				if carry != 0 then z -= scaledByPowerOfTwo(1.0, q0)
			}
		}
		// Nothing left in what was taken: more bits of 2/π are needed.
		if z == 0.0 {
			var any = 0
			var m = jz - 1
			while m >= jk {
				any = any | iq[m]
				m -= 1
			}
			if any == 0 {
				var needed = 1
				while iq[jk - needed] == 0 {
					needed += 1
				}
				for m in jz + 1..=jz + needed {
					f[jx + m] = IPIO2[jv + m] as f64
					var fw = 0.0
					for p in 0..=jx {
						fw += x[p] * f[jx + m - p]
					}
					q[m] = fw
				}
				jz += needed
				recompute = true
			}
		}
	}
	// Chop off zero terms, or split what is left into 24 bits more.
	if z == 0.0 {
		jz -= 1
		q0 -= 24
		while iq[jz] == 0 {
			jz -= 1
			q0 -= 24
		}
	} else {
		z = scaledByPowerOfTwo(z, -q0)
		if z >= TWO_24 {
			val fw = (TWO_MINUS_24 * z) as i64 as f64
			iq[jz] = (z - TWO_24 * fw) as i64
			jz += 1
			q0 += 24
			iq[jz] = fw as i64
		} else {
			iq[jz] = z as i64
		}
	}
	// The integers back as floats, and then times π/2.
	var fw = scaledByPowerOfTwo(1.0, q0)
	var i = jz
	while i >= 0 {
		q[i] = fw * (iq[i] as f64)
		fw *= TWO_MINUS_24
		i -= 1
	}
	i = jz
	while i >= 0 {
		var sum = 0.0
		var k = 0
		while k <= jp && k <= jz - i {
			sum += PIO2_PARTS[k] * q[i + k]
			k += 1
		}
		fq[jz - i] = sum
		i -= 1
	}
	// What is left, in two parts for an `f64`.
	var head = 0.0
	i = jz
	while i >= 0 {
		head += fq[i]
		i -= 1
	}
	y[0] = if ih == 0 then head else -head
	var tail = fq[0] - head
	for m in 1..=jz {
		tail += fq[m]
	}
	y[1] = if ih == 0 then tail else -tail
	return n & 7
}

// --- The functions ------------------------------------------------------

/// sin(x), within an ulp.
fn sine(x: f64): f64 = {
	val ix = ((x.toBits() >> 32) as i64) & 0x7fffffff
	// |x| ~< π/4
	if ix <= 0x3fe921fb {
		// |x| < 2^-26
		if ix < 0x3e500000 then return x
		return kSin(x, 0.0, 0)
	}
	if ix >= 0x7ff00000 then return x - x
	val (n, y0, y1) = remPio2(x)
	return match n & 3 {
		0 => kSin(y0, y1, 1)
		1 => kCos(y0, y1)
		2 => -kSin(y0, y1, 1)
		_ => -kCos(y0, y1)
	}
}

/// cos(x), within an ulp.
fn cosine(x: f64): f64 = {
	val ix = ((x.toBits() >> 32) as i64) & 0x7fffffff
	if ix <= 0x3fe921fb {
		// |x| < 2^-27 √2
		if ix < 0x3e46a09e then return 1.0
		return kCos(x, 0.0)
	}
	if ix >= 0x7ff00000 then return x - x
	val (n, y0, y1) = remPio2(x)
	return match n & 3 {
		0 => kCos(y0, y1)
		1 => -kSin(y0, y1, 1)
		2 => -kCos(y0, y1)
		_ => kSin(y0, y1, 1)
	}
}

/// tan(x), within an ulp.
fn tangent(x: f64): f64 = {
	val ix = ((x.toBits() >> 32) as i64) & 0x7fffffff
	if ix <= 0x3fe921fb {
		// |x| < 2^-27
		if ix < 0x3e400000 then return x
		return kTan(x, 0.0, 0)
	}
	if ix >= 0x7ff00000 then return x - x
	val (n, y0, y1) = remPio2(x)
	return kTan(y0, y1, n & 1)
}
