// An `f64` as two 32-bit words and a power of two, which the functions
// ported from fdlibm work in: the high word holds the sign,
// the exponent and the top of the fraction, the low word the rest.

/// `x` with its low word zero: 21 bits of fraction, so that a product of
/// two such is exact.
@inline
fn zeroLowWord(x: f64): f64 = f64::fromBits(x.toBits() & 0xFFFFFFFF00000000)

/// x × 2^n, exactly where the answer is a normal number, and rounded once
/// where it is too small to be (C's `scalbn`, as musl has it).
@inline
fn scaledByPowerOfTwo(x: f64, power: i64): f64 = {
	var y = x
	var n = power
	if n > 1023 {
		// 2^1023, twice at most: the smallest subnormal to the largest
		// number is 2^2097.
		val most = f64::fromBits(0x7FE0000000000000)
		y *= most
		n -= 1023
		if n > 1023 {
			y *= most
			n -= 1023
			if n > 1023 then n = 1023
		}
	} else if n < -1022 {
		// 2^-1022 × 2^53, which keeps y normal, so that the one rounding
		// is the last multiplication's.
		val least = f64::fromBits(0x0360000000000000)
		y *= least
		n += 1022 - 53
		if n < -1022 {
			y *= least
			n += 1022 - 53
			if n < -1022 then n = -1022
		}
	}
	return y * f64::fromBits(((0x3FF + n) as u64) << 52)
}
