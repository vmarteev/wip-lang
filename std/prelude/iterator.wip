// Walking what is made one element at a time: a value
// that knows where it is, and hands out the next element when asked.
//
// `for x in it` calls `it.next()` until it answers nothing. Where a type
// lends its elements as a slice, `Items` is what `for` uses instead, since
// a slice can be indexed, searched and passed on; this is for what has no
// slice to lend — pieces of a text, characters, numbers counted out.
//
// An iterator of a program's own is most easily a generator, whose `next`
// the compiler writes: a loop that yields where a value stands, or a
// function that answers `Iterator<T>`. A type that
// implements this by hand, as the adapters below do, has a name a field
// can hold.
//
// Every iterator has the adapters and the consumers below.
// An adapter takes the iterator and answers another, which holds it and
// the closure it was given, so the closure is an owned one: `own (c) =>
// …`, which cannot capture a reference. A generator can:
// `for t in types { yield self.subst(t) }` borrows what it names. A
// consumer walks the iterator to its end then and there, so its closure
// is lent for the call, and may read anything around it.
//
// The adapters themselves are `std::iter`'s: a program
// names one only to keep it in a field, and imports it then, so their
// names are not taken from every program.

import std::collections::{Set}
import std::iter::{
	Chained,
	Enumerated,
	FilterMapped,
	Filtered,
	FlatMapped,
	Flattened,
	Mapped,
	Peekable,
	Skipped,
	Taken,
	TakenWhile,
	Zipped
}

/// Elements handed out one at a time, which `for` walks until there are
/// none.
pub interface Iterator<type Item> {
	/// The next element, or nothing when there are no more.
	var fn next(): Option<Item>

	/// Each element, as `f` makes it into another.
	move fn map<U>(f: own<(x: Item) => U>): Mapped<Self, U> = Mapped::of(move self, move f)

	/// Each element `f` makes something of, as what it makes: `f` answers
	/// nothing for the others. `words.filterMap(own (w) => w.toInt().toOption())`.
	move fn filterMap<U>(f: own<(x: Item) => Option<U>>): FilterMapped<Self, U> = FilterMapped::of(
		move self,
		move f,
	)

	/// Each element `f` makes an iterator of, walked in turn, as one
	/// iterator: `lines.flatMap(own (line) => line.split(" "))`.
	move fn flatMap<J: Iterator>(f: own<(x: Item) => J>): FlatMapped<Self, J> = FlatMapped::of(
		move self,
		move f,
	)

	/// The elements `keep` answers true for.
	move fn filter(keep: own<(x: &Item) => bool>): Filtered<Self> = Filtered::of(
		move self,
		move keep,
	)

	/// Each element with where it is, from 0: `(0, a)`, `(1, b)`, ….
	move fn enumerate(): Enumerated<Self> = Enumerated::of(move self)

	/// The elements up to the first that `keep` answers false for, which
	/// is not one of them.
	move fn takeWhile(keep: own<(x: &Item) => bool>): TakenWhile<Self> = TakenWhile::of(
		move self,
		move keep,
	)

	/// This iterator's elements, and then `other`'s.
	move fn chain<J: Iterator<Item>>(other: J): Chained<Self, J> = Chained::of(
		move self,
		move other,
	)

	/// The first `count` elements, or all of them where there are fewer.
	move fn take(count: i64): Taken<Self> = Taken::of(move self, count)

	/// The elements after the first `count`.
	move fn skip(count: i64): Skipped<Self> = Skipped::of(move self, count)

	/// This iterator's elements and `other`'s in pairs, until either runs
	/// out.
	move fn zip<J: Iterator>(other: J): Zipped<Self, J> = Zipped::of(move self, move other)

	/// The same elements, with the next one to look at before it is taken:
	/// `it.peek()`.
	move fn peekable(): Peekable<Self> = Peekable::of(move self)

	/// How many elements are left.
	move fn count(): i64 = {
		var n = 0
		for x in move self {
			n += 1
		}
		return n
	}

	/// The elements that are left, in a `Vec`.
	move fn toVec(): Vec<Item> = {
		var all: Vec<Item> = Vec()
		for x in move self {
			all.push(move x)
		}
		return move all
	}

	/// The element `n` places on, counting from 0, or nothing where there
	/// are not that many; those before it are passed over, and the
	/// iterator goes on after it.
	var fn nth(n: i64): Option<Item> = {
		var left = n
		while left > 0 {
			if self.next() is .None then return .None
			left -= 1
		}
		return self.next()
	}

	/// The last element, or nothing where there is none.
	move fn last(): Option<Item> = {
		var last: Option<Item> = .None
		for x in move self {
			last = .Some(move x)
		}
		return move last
	}

	/// Where the first element `test` answers true for is, counting from
	/// 0, or nothing.
	move fn position(test: &(x: &Item) => bool): Option<i64> = {
		var at = 0
		for x in move self {
			if test(&x) then return .Some(at)
			at += 1
		}
		return .None
	}

	/// What `f` makes of the first element it makes something of, or
	/// nothing.
	move fn findMap<U>(f: &(x: Item) => Option<U>): Option<U> = {
		for x in move self {
			if f(move x) is .Some(made) then return .Some(move made)
		}
		return .None
	}

	/// `f` of each element, in turn; it may write what it captures.
	move fn forEach(f: &var (x: Item) => void) = {
		for x in move self {
			f(move x)
		}
	}

	/// The first element `test` answers true for, or nothing.
	move fn find(test: &(x: &Item) => bool): Option<Item> = {
		for x in move self {
			if test(&x) then return .Some(move x)
		}
		return .None
	}

	/// The element whose key is least, the first of equals; nothing where
	/// there is none.
	move fn minBy<K: Ord>(key: &(x: &Item) => K): Option<Item> = {
		var best: Option<Item> = .None
		var least: Option<K> = .None
		for x in move self {
			val k = key(&x)
			if least is .Some(sofar) && !(k < sofar) then continue
			best = .Some(move x)
			least = .Some(move k)
		}
		return move best
	}

	/// The element whose key is greatest, the first of equals; nothing
	/// where there is none.
	move fn maxBy<K: Ord>(key: &(x: &Item) => K): Option<Item> = {
		var best: Option<Item> = .None
		var greatest: Option<K> = .None
		for x in move self {
			val k = key(&x)
			if greatest is .Some(sofar) && !(k > sofar) then continue
			best = .Some(move x)
			greatest = .Some(move k)
		}
		return move best
	}

	/// Whether `test` answers true for any element. It stops at the first.
	move fn any(test: &(x: &Item) => bool): bool = {
		for x in move self {
			if test(&x) then return true
		}
		return false
	}

	/// Whether `test` answers true for every element. It stops at the
	/// first that fails.
	move fn all(test: &(x: &Item) => bool): bool = {
		for x in move self {
			if !test(&x) then return false
		}
		return true
	}

	/// `start`, and then `f` of what it has so far and each element:
	/// `numbers.fold(0, (sum, n) => sum + n)`.
	move fn fold<A>(start: A, f: &(sofar: A, x: Item) => A): A = {
		var acc = move start
		for x in move self {
			acc = f(move acc, move x)
		}
		return move acc
	}
}

// What an iterator does with its elements where they add up, multiply or
// are ordered: an iterator of anything else has none of it.
// The elements in a `Set`, each once, where they can be: the first of
// equals is kept.
extend Iterator<T: Hash + Eq> {
	/// The elements, each once, in the order they first came.
	move fn toSet(): Set<T> = {
		var all: Set<T> = Set()
		for x in move self {
			all.add(move x)
		}
		return move all
	}
}

extend Iterator<T: Iterator> {
	/// The elements of each element, walked in turn, as one iterator:
	/// `rows.flatten()`.
	move fn flatten(): Flattened<Self, T> = Flattened::of(move self)
}

extend Iterator<T: Add + Zero> {
	/// The elements added up: zero where there are none.
	move fn sum(): T = self.fold(T::zero(), (total, x) => total + x)
}

extend Iterator<T: Multiply + One> {
	/// The elements multiplied together: one where there are none.
	move fn product(): T = self.fold(T::one(), (total, x) => total * x)
}

extend Iterator<T: Ord> {
	/// The smallest element, the first of equals; nothing where there is
	/// none.
	move fn min(): Option<T> = {
		var best: Option<T> = .None
		for x in move self {
			if best is .Some(sofar) && !(x < sofar) then continue
			best = .Some(move x)
		}
		return move best
	}

	/// The largest element, the first of equals; nothing where there is
	/// none.
	move fn max(): Option<T> = {
		var best: Option<T> = .None
		for x in move self {
			if best is .Some(sofar) && !(x > sofar) then continue
			best = .Some(move x)
		}
		return move best
	}
}

/// What gives up its elements to be walked: `for x in move c` walks
/// `c.intoIterator()`, and each element is the loop's to keep.
/// `I` is the iterator it answers, which holds what was
/// not taken yet and drops it with itself.
pub interface IntoIterator<type Iter> {
	move fn intoIterator(): Iter
}
