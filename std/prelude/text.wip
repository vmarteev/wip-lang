// Writing a value as text: the interface interpolation
// asks of what it is given, and how each type of the prelude answers it.
// Building the text is `String`'s; this is what each value puts into one.

/// What can be written as text. It is what interpolation
/// asks of a value: `"\(x)"` is `x.appendTo(&var out)`, whatever `x` is.
///
/// A type writes `toString`, the text as a `String` of its own, where that
/// is simplest, or `appendTo`, where it writes a lot or writes parts that
/// are `Text` themselves; each is written with the other.
@oneOf(toString, appendTo)
pub interface Text {
	/// The text, as a `String` of its own: `5.toString()` is `"5"`.
	fn toString(): String = {
		var out = String()
		self.appendTo(&var out)
		return move out
	}

	/// The text, at the end of `out`: what interpolation calls.
	fn appendTo(out: &var String) = out.push(self.toString())

	/// Whether a piece of an interpolation that says no alignment goes
	/// right, as a number's does in a column: `false` but for numbers.
	fn alignsRight(): bool = false

	/// `"\(x, width: 4, fill: '0', align: .Right)"`: the text, and `fill`
	/// before, after or around it to make it `width` characters, where it
	/// is fewer. The alignment unsaid is the value's: a number right,
	/// anything else left. A number filled with `0` has the zeros after its
	/// sign, `-005`.
	fn appendFitted(
		out: &var String,
		width: i64,
		fill: char = ' ',
		align: Option<Align> = .None,
	) = {
		val start = out.len()
		self.appendTo(&var out)
		val number = self.alignsRight()
		val side = align.unwrapOr(if number then .Right else .Left)
		fitted(&var out, start, width, fill, side, number)
	}
}

/// Where a piece of an interpolation goes in its width.
@derive(Eq, Hash, Text)
pub enum Align {
	Left
	Right
	/// In the middle, with any odd character of fill after the text.
	Center
}

/// The text from byte `start` of `out` made up to `width` characters with
/// `fill`, on the side `side` says; a number filled with `0` has the zeros
/// after its sign.
fn fitted(out: &var String, start: i64, width: i64, fill: char, side: Align, number: bool) = {
	val missing = width - out.toStr()[start..out.len()].chars().count()
	if missing <= 0 then return
	match side {
		.Left => out.insertCopies(out.len(), fill, missing)
		.Right => {
			val signed =
				number &&
				fill == '0' &&
				out.len() > start &&
				(out.toStr()[start] == b'-' || out.toStr()[start] == b'+')
			out.insertCopies(if signed then start + 1 else start, fill, missing)
		}
		.Center => {
			val before = missing / 2
			out.insertCopies(start, fill, before)
			out.insertCopies(out.len(), fill, missing - before)
		}
	}
}

// A slice is written as its elements, between brackets, when they can be
// written, and an array as the slice of all of it.
extend [T: Text]: Text {
	fn appendTo(out: &var String) = {
		out.push("[")
		self.joinTo(&var out, ", ")
		out.push("]")
	}
}

// A vector is written as the slice of its elements.
extend Vec<T: Text>: Text {
	fn appendTo(out: &var String) = self.items().appendTo(&var out)
}

extend i64: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushInt(self)
}

extend i8: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushInt(self as i64)
}

extend i16: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushInt(self as i64)
}

extend i32: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushInt(self as i64)
}

extend isize: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushInt(self as i64)
}

// The unsigned ones have no sign to write, and `u64` does not fit in an
// `i64`, so they go through `pushUnsigned`.
extend u8: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushUnsigned(self as u64)
}

extend u16: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushUnsigned(self as u64)
}

extend u32: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushUnsigned(self as u64)
}

extend u64: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushUnsigned(self)
}

extend usize: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushUnsigned(self as u64)
}

// The 128-bit ones are wider than `pushInt` and `pushUnsigned` take, so
// their digits are counted out here.
extend u128: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = writeWide(&var out, self)
}

// The smallest `i128` has no positive of its own, so its magnitude is taken
// one short and made up in unsigned arithmetic.
extend i128: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = {
		if self < 0 {
			out.pushByte('-' as u8)
			writeWide(&var out, (-(self + 1)) as u128 + 1)
		} else {
			writeWide(&var out, self as u128)
		}
	}
}

/// A `u128` in decimal: at most 39 digits.
fn writeWide(out: &var String, value: u128) = {
	var digits = [0 as u8; 40]
	var count = 0
	var rest = value
	while true {
		digits[count] = '0' as u8 + (rest % 10) as u8
		rest = rest / 10
		count += 1
		if rest == 0 then break
	}
	out.pushDigits(&digits[0..count])
}

extend f32: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushFloat32(self)
}

extend f64: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = out.pushFloat(self)
}

// C's bytes, which end with a NUL: written by walking to it, which is what
// `toStr` does.
extend cstring: Text {
	fn appendTo(out: &var String) = out.push(self.toStr())
}

// `void` is written `{}`, as its value is.
extend void: Text {
	fn appendTo(out: &var String) = out.push("{}")
}

extend bool: Text {
	fn appendTo(out: &var String) = out.pushBool(self)
}

// A character writes as itself.
extend char: Text {
	fn appendTo(out: &var String) = out.pushChar(self)
}

extend str: Text {
	fn toString(): String = String::of(self)

	fn appendTo(out: &var String) = out.push(self)
}

extend String: Text {
	/// A copy.
	fn toString(): String = String::of(self.toStr())

	fn appendTo(out: &var String) = out.push(self.toStr())
}

// An option is written as the variant it holds, as any enum is, when what
// it holds can be written.
extend Option<T: Text>: Text {
	fn appendTo(out: &var String) = match self {
		.Some(value) => {
			out.push(".Some(")
			value.appendTo(&var out)
			out.push(")")
		}
		.None => out.push(".None")
	}
}

// A result is written as the variant it holds, as any enum is, when both
// halves can be written.
extend Result<T: Text, E: Text>: Text {
	fn appendTo(out: &var String) = match self {
		.Ok(value) => {
			out.push(".Ok(")
			value.appendTo(&var out)
			out.push(")")
		}
		.Err(error) => {
			out.push(".Err(")
			error.appendTo(&var out)
			out.push(")")
		}
	}
}

// A tuple is written as its elements, between parentheses, when they can
// be written.
extend Tuple2<A: Text, B: Text>: Text {
	fn appendTo(out: &var String) = {
		out.push("(")
		self.0.appendTo(&var out)
		out.push(", ")
		self.1.appendTo(&var out)
		out.push(")")
	}
}

extend Tuple3<A: Text, B: Text, C: Text>: Text {
	fn appendTo(out: &var String) = {
		out.push("(")
		self.0.appendTo(&var out)
		out.push(", ")
		self.1.appendTo(&var out)
		out.push(", ")
		self.2.appendTo(&var out)
		out.push(")")
	}
}

extend Tuple4<A: Text, B: Text, C: Text, D: Text>: Text {
	fn appendTo(out: &var String) = {
		out.push("(")
		self.0.appendTo(&var out)
		out.push(", ")
		self.1.appendTo(&var out)
		out.push(", ")
		self.2.appendTo(&var out)
		out.push(", ")
		self.3.appendTo(&var out)
		out.push(")")
	}
}
