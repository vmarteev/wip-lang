// Reading a number from text: the other direction of
// `String::pushInt` and `pushFloat`.
//
// What comes back is a `Result`, because "this is not a number" is an
// ordinary thing for input to be, and the error says what was wrong with
// it rather than only that something was. The error is `std::text`'s,
// imported where a program names it.

import std::text::{ParseError}

extend str {
	/// The text as a whole number, in the radix asked for: `"42".toInt()`,
	/// `"ff".toInt(radix: 16)`. A leading `-` or `+` is read; spaces are
	/// not, so `trim()` comes first where the text may have any.
	pub fn toInt(radix: i64 = 10): Result<i64, ParseError> = {
		if radix < 2 || radix > 36 then
			return .Err(.BadRadix(radix))

		var i = self.signLength()
		val negative = i == 1 && self[0] == b'-'
		if i >= self.len() then
			return .Err(.Empty)

		// Counted downwards, so that the most negative number of the type
		// is as readable as the rest: its magnitude has no positive twin.
		val floor = i64::MIN
		var value = 0
		while i < self.len() {
			val .Some(digit) = self[i].digitValue(radix) else return .Err(.BadDigit(i))
			if value < floor / radix then
				return .Err(.TooLarge)

			value = value * radix
			if value < floor + digit then
				return .Err(.TooLarge)

			value = value - digit
			i += 1
		}
		if negative then
			return value

		if value == floor then
			return .Err(.TooLarge)

		return -value
	}

	/// The text as a number with a fraction: `"3.5"`, `"-0.25"`, `"2e3"`.
	/// It is the nearest `f64` to what is written, a tie to the one whose
	/// significand is even, and a number too large for one is `TooLarge`.
	pub fn toFloat(): Result<f64, ParseError> = {
		// What a number looks like: digits, a point and more digits, and
		// an `e` with a power of ten; not C's `inf`, `nan`, hexadecimal or
		// white space before it.
		val start = self.signLength()
		val negative = start == 1 && self[0] == b'-'
		var i = start
		while i < self.len() && self[i].isDigit() do
			i += 1

		val whole = i - start
		var fraction = 0
		if self.get(i) == b'.' {
			i += 1
			while i < self.len() && self[i].isDigit() {
				fraction += 1
				i += 1
			}
		}
		if whole + fraction == 0 then
			return .Err(.Empty)

		// `e` and what follows it: the power of ten to move the point by,
		// held at a billion, which is past any float.
		var exponent = 0
		if self.get(i) is .Some(b'e' | b'E') {
			i += 1
			val down = self.get(i) == b'-'
			if self.get(i) is .Some(b'-' | b'+') then
				i += 1

			if i >= self.len() then
				return .Err(.BadDigit(i))

			while i < self.len() {
				if !self[i].isDigit() then
					return .Err(.BadDigit(i))

				exponent = (exponent * 10 + (self[i] - b'0') as i64).min(1000000000)
				i += 1
			}
			if down then
				exponent = -exponent
		}
		if i < self.len() then
			return .Err(.BadDigit(i))

		val value = floatOf(self, start, whole, fraction, exponent, negative)
		if !value.isFinite() then
			return .Err(.TooLarge)

		return value
	}

	/// The text as a whole number of a `u64`, in the radix asked for, as
	/// `toInt` reads one: a `+` is read, and a `-` is a bad digit.
	pub fn toU64(radix: i64 = 10): Result<u64, ParseError> = {
		if radix < 2 || radix > 36 then
			return .Err(.BadRadix(radix))

		if self.len() > 0 && self[0] == b'-' then
			return .Err(.BadDigit(0))

		var i = self.signLength()
		if i >= self.len() then
			return .Err(.Empty)

		var value: u64 = 0
		while i < self.len() {
			val .Some(digit) = self[i].digitValue(radix) else return .Err(.BadDigit(i))
			val .Some(next) = value.checkedMul(radix as u64) else return .Err(.TooLarge)
			val .Some(added) = next.checkedAdd(digit as u64) else return .Err(.TooLarge)
			value = added
			i += 1
		}
		return value
	}

	/// The text as a whole number of an `i128`, in the radix asked for, as
	/// `toInt` reads one of an `i64`.
	pub fn toI128(radix: i64 = 10): Result<i128, ParseError> = {
		if radix < 2 || radix > 36 then
			return .Err(.BadRadix(radix))

		var i = self.signLength()
		val negative = i == 1 && self[0] == b'-'
		if i >= self.len() then
			return .Err(.Empty)

		// Counted downwards, as `toInt` counts, so that the most negative
		// is as readable as the rest.
		var value: i128 = 0
		while i < self.len() {
			val .Some(digit) = self[i].digitValue(radix) else return .Err(.BadDigit(i))
			val .Some(next) = value.checkedMul(radix) else return .Err(.TooLarge)
			val .Some(taken) = next.checkedSub(digit) else return .Err(.TooLarge)
			value = taken
			i += 1
		}
		if negative then
			return value

		return match value.checkedNeg() {
			.Some(positive) => positive
			.None => .Err(.TooLarge)
		}
	}

	/// The text as a whole number of a `u128`, in the radix asked for, as
	/// `toInt` reads one: a `+` is read, and a `-` is a bad digit.
	pub fn toU128(radix: i64 = 10): Result<u128, ParseError> = {
		if radix < 2 || radix > 36 then
			return .Err(.BadRadix(radix))

		if self.len() > 0 && self[0] == b'-' then
			return .Err(.BadDigit(0))

		var i = self.signLength()
		if i >= self.len() then
			return .Err(.Empty)

		var value: u128 = 0
		while i < self.len() {
			val .Some(digit) = self[i].digitValue(radix) else return .Err(.BadDigit(i))
			val .Some(next) = value.checkedMul(radix as u128) else return .Err(.TooLarge)
			val .Some(added) = next.checkedAdd(digit as u128) else return .Err(.TooLarge)
			value = added
			i += 1
		}
		return value
	}

	/// How many bytes the sign takes: 1 where the text begins with `-` or
	/// `+`, and 0 otherwise.
	fn signLength(): i64 = if self.len() > 0 && self[0] is b'-' | b'+' then 1 else 0
}

extend String {
	/// The text the `String` holds, as a whole number.
	pub fn toInt(radix: i64 = 10): Result<i64, ParseError> = self.toStr().toInt(radix:)

	/// The text the `String` holds, as a whole number of a `u64`.
	pub fn toU64(radix: i64 = 10): Result<u64, ParseError> = self.toStr().toU64(radix:)

	/// The text the `String` holds, as a whole number of an `i128`.
	pub fn toI128(radix: i64 = 10): Result<i128, ParseError> = self.toStr().toI128(radix:)

	/// The text the `String` holds, as a whole number of a `u128`.
	pub fn toU128(radix: i64 = 10): Result<u128, ParseError> = self.toStr().toU128(radix:)

	/// The text the `String` holds, as a number with a fraction.
	pub fn toFloat(): Result<f64, ParseError> = self.toStr().toFloat()
}
