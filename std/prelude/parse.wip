// Reading a number from text: the other direction of
// `String::pushInt` and `pushFloat`.
//
// What comes back is a `Result`, because "this is not a number" is an
// ordinary thing for input to be, and the error says what was wrong with
// it rather than only that something was. The error is `std::text`'s,
// imported where a program names it.

import std::libc
import std::text::{ParseError}

extend str {
	/// The text as a whole number, in the radix asked for: `"42".toInt()`,
	/// `"ff".toInt(radix: 16)`. A leading `-` or `+` is read; spaces are
	/// not, so `trim()` comes first where the text may have any.
	pub fn toInt(radix: i64 = 10): Result<i64, ParseError> = {
		if radix < 2 || radix > 36 then return .Err(.BadRadix(radix))
		var i = self.signLength()
		val negative = i == 1 && self[0] == '-' as u8
		if i >= self.len() then return .Err(.Empty)
		// Counted downwards, so that the most negative number of the type
		// is as readable as the rest: its magnitude has no positive twin.
		val floor = -9223372036854775807 - 1
		var value = 0
		while i < self.len() {
			val .Some(digit) = digitOf(self[i], radix) else {
				return .Err(.BadDigit(i))
			}
			if value < floor / radix then return .Err(.TooLarge)
			value = value * radix
			if value < floor + digit then return .Err(.TooLarge)
			value = value - digit
			i += 1
		}
		if negative then return .Ok(value)
		if value == floor then return .Err(.TooLarge)
		return .Ok(-value)
	}

	/// The text as a number with a fraction: `"3.5"`, `"-0.25"`, `"2e3"`.
	/// It is the nearest `f64` to what is written, and a
	/// number too large for one is `TooLarge`.
	pub fn toFloat(): Result<f64, ParseError> = {
		// What a number looks like is checked here: C would also read
		// `inf`, `nan`, hexadecimal and white space before it.
		var i = self.signLength()
		var digits = 0
		while i < self.len() && isDigit(self[i]) {
			digits += 1
			i += 1
		}
		if i < self.len() && self[i] == '.' as u8 {
			i += 1
			while i < self.len() && isDigit(self[i]) {
				digits += 1
				i += 1
			}
		}
		if digits == 0 then return .Err(.Empty)
		// `e` and what follows it: the power of ten to move the point by.
		if i < self.len() && self[i] is b'e' | b'E' {
			i += 1
			if i < self.len() && self[i] is b'-' | b'+' then i += 1
			if i >= self.len() then return .Err(.BadDigit(i))
			while i < self.len() {
				if !isDigit(self[i]) then return .Err(.BadDigit(i))
				i += 1
			}
		}
		if i < self.len() then return .Err(.BadDigit(i))
		// The value is C's, which reads the nearest one, from the text with
		// a NUL after it: in bytes of its own where it is short, as a
		// number nearly always is.
		var short = [0 as u8; 64]
		val value = if self.len() < short.len() {
			for k in 0..self.len() {
				short[k] = self[k]
			}
			libc::strtod(cstring::fromBytes(&short), null)
		} else {
			var long = String::of(self)
			libc::strtod(long.toCstring(), null)
		}
		if !value.isFinite() then return .Err(.TooLarge)
		return .Ok(value)
	}

	/// The text as a whole number of a `u64`, in the radix asked for, as
	/// `toInt` reads one: a `+` is read, and a `-` is a bad digit.
	pub fn toU64(radix: i64 = 10): Result<u64, ParseError> = {
		if radix < 2 || radix > 36 then return .Err(.BadRadix(radix))
		if self.len() > 0 && self[0] == b'-' then return .Err(.BadDigit(0))
		var i = self.signLength()
		if i >= self.len() then return .Err(.Empty)
		var value: u64 = 0
		while i < self.len() {
			val .Some(digit) = digitOf(self[i], radix) else {
				return .Err(.BadDigit(i))
			}
			val .Some(next) = value.checkedMul(radix as u64) else {
				return .Err(.TooLarge)
			}
			val .Some(added) = next.checkedAdd(digit as u64) else {
				return .Err(.TooLarge)
			}
			value = added
			i += 1
		}
		return .Ok(value)
	}

	/// The text as a whole number of an `i128`, in the radix asked for, as
	/// `toInt` reads one of an `i64`.
	pub fn toI128(radix: i64 = 10): Result<i128, ParseError> = {
		if radix < 2 || radix > 36 then return .Err(.BadRadix(radix))
		var i = self.signLength()
		val negative = i == 1 && self[0] == b'-'
		if i >= self.len() then return .Err(.Empty)
		// Counted downwards, as `toInt` counts, so that the most negative
		// is as readable as the rest.
		var value: i128 = 0
		while i < self.len() {
			val .Some(digit) = digitOf(self[i], radix) else {
				return .Err(.BadDigit(i))
			}
			val .Some(next) = value.checkedMul(radix as i128) else {
				return .Err(.TooLarge)
			}
			val .Some(taken) = next.checkedSub(digit as i128) else {
				return .Err(.TooLarge)
			}
			value = taken
			i += 1
		}
		if negative then return .Ok(value)
		return match value.checkedNeg() {
			.Some(positive) => .Ok(positive)
			.None => .Err(.TooLarge)
		}
	}

	/// The text as a whole number of a `u128`, in the radix asked for, as
	/// `toInt` reads one: a `+` is read, and a `-` is a bad digit.
	pub fn toU128(radix: i64 = 10): Result<u128, ParseError> = {
		if radix < 2 || radix > 36 then return .Err(.BadRadix(radix))
		if self.len() > 0 && self[0] == b'-' then return .Err(.BadDigit(0))
		var i = self.signLength()
		if i >= self.len() then return .Err(.Empty)
		var value: u128 = 0
		while i < self.len() {
			val .Some(digit) = digitOf(self[i], radix) else {
				return .Err(.BadDigit(i))
			}
			val .Some(next) = value.checkedMul(radix as u128) else {
				return .Err(.TooLarge)
			}
			val .Some(added) = next.checkedAdd(digit as u128) else {
				return .Err(.TooLarge)
			}
			value = added
			i += 1
		}
		return .Ok(value)
	}

	/// How many bytes the sign takes: 1 where the text begins with `-` or
	/// `+`, and 0 otherwise.
	fn signLength(): i64 = if self.len() > 0 && self[0] is b'-' | b'+' then 1 else 0
}

extend String {
	/// The text the `String` holds, as a whole number.
	pub fn toInt(radix: i64 = 10): Result<i64, ParseError> = self.toStr().toInt(radix: radix)

	/// The text the `String` holds, as a whole number of a `u64`.
	pub fn toU64(radix: i64 = 10): Result<u64, ParseError> = self.toStr().toU64(radix: radix)

	/// The text the `String` holds, as a whole number of an `i128`.
	pub fn toI128(radix: i64 = 10): Result<i128, ParseError> = self.toStr().toI128(radix: radix)

	/// The text the `String` holds, as a whole number of a `u128`.
	pub fn toU128(radix: i64 = 10): Result<u128, ParseError> = self.toStr().toU128(radix: radix)

	/// The text the `String` holds, as a number with a fraction.
	pub fn toFloat(): Result<f64, ParseError> = self.toStr().toFloat()
}

/// Whether the byte is a decimal digit.
fn isDigit(byte: u8): bool = byte is b'0'..=b'9'

/// What a decimal digit is worth.
fn digitValue(byte: u8): i64 = (byte - '0' as u8) as i64

/// What a byte is worth as a digit in this radix, or nothing where it is
/// not one of them: `0`–`9`, then `a`–`z` and `A`–`Z`.
fn digitOf(byte: u8, radix: i64): Option<i64> = {
	val value = match byte {
		b'0'..=b'9' => digitValue(byte)
		b'a'..=b'z' => (byte - b'a') as i64 + 10
		b'A'..=b'Z' => (byte - b'A') as i64 + 10
		_ => radix
	}
	if value >= radix then return .None
	return .Some(value)
}
