// A sequence: elements at positions from 0 to `len()`, each lent where it lies
// through a projection.
// A vector, a slice and an array are sequences, and so is anything of a
// program's own that answers these two — a ring buffer that wraps, the
// values of a map.
//
// It is what `x[i]` reads and `for x in c` walks: the loop binds `x` to
// each place `c.at(i)` lends, for the whole of the body. Where `c` can be
// written and its type also has the writing half — `lend fn at(i: i64): &T`
// gives both from one body — `x[i] = v` writes and the
// loop writes the elements.
//
// What it promises, beyond the two methods: every position below `len()`
// holds an element, in the order a walk visits them, and `at(i)` is as
// quick for the last position as for the first. A linked list, which must
// walk to its `i`th element, is not one: walked by position it would be
// quadratic, which is the trap Scala's `Seq` sets with `List`.
// It hands out its elements as an `Iterator` instead.

/// Elements at positions from 0, each lent where it lies.
pub interface Sequence<T> {
	/// How many elements there are.
	fn len(): i64

	/// The element at position `i`, counted from 0, as quickly for any
	/// position as for another.
	fn at(i: i64): &T

	/// Each element written onto `out` by `write`, with `separator` between
	/// each two: `fields.joinToBy(&var out, ",", (field, out) => …)`. A
	/// slice of `Text` elements has `joinTo`, which writes each as its text.
	fn joinToBy(out: &var String, separator: str, write: &(x: &T, out: &var String) => void) = {
		for i in 0..self.len() {
			if i > 0 then out.push(separator)
			write(&self.at(i), &var out)
		}
	}
}
