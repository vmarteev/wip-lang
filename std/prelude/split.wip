// Taking text apart: the pieces between separators, and
// the lines. Each piece is a `str` into the text, so nothing is copied, and
// the pieces are handed out one at a time; a `Vec<str>` of them is a loop
// away.
//
// What `split` and `lines` answer is `std::text`'s.

import std::text::{Lines, RSplit, Split, SplitN, SplitWhitespace}

extend str {
	/// The pieces between each `separator`: `"a,b,,c".split(",")` is `a`,
	/// `b`, the empty text and `c`. A text with no separator is one piece;
	/// so is the empty text. An empty separator splits nothing, and the
	/// whole text is the one piece.
	pub fn split(separator: str): Split = Split::of(self, separator)

	/// The pieces between each `separator`, from the last:
	/// `"a/b/c".rsplit("/")` is `c`, `b` and `a`.
	pub fn rsplit(separator: str): RSplit = RSplit::of(self, separator)

	/// At most `count` pieces: those between the first `count - 1`
	/// separators, and then the rest, separators and all:
	/// `"k=v=w".splitn(2, "=")` is `k` and `v=w`.
	pub fn splitn(count: i64, separator: str): SplitN = SplitN::of(self, count, separator)

	/// The words: the pieces between runs of white space, none of them
	/// empty, `"  a b\tc "` is `a`, `b` and `c`.
	pub fn splitWhitespace(): SplitWhitespace = SplitWhitespace::of(self)

	/// The lines: the pieces between line breaks, each without its `\n`,
	/// or its `\r\n`. A break at the very end starts no line of its own,
	/// and the empty text has none.
	pub fn lines(): Lines = Lines::of(self)

	/// The text before the first `separator` and after it:
	/// `"NAME=a=b".splitOnce("=")` is `NAME` and `a=b`. Nothing where there
	/// is no separator; an empty one is found before the first byte.
	pub fn splitOnce(separator: str): Option<(str, str)> = match self.find(separator) {
		.Some(at) => .Some((self[0..at], self[at + separator.len()..self.len()]))
		.None => .None
	}

	/// The text before the last `separator` and after it:
	/// `"a.tar.gz".rsplitOnce(".")` is `a.tar` and `gz`. Nothing where
	/// there is no separator.
	pub fn rsplitOnce(separator: str): Option<(str, str)> = match self.findLast(separator) {
		.Some(at) => .Some((self[0..at], self[at + separator.len()..self.len()]))
		.None => .None
	}
}

extend String {
	/// The pieces between each `separator`, as `str::split` has them.
	pub fn split(separator: str): Split = self.toStr().split(separator)

	/// The lines, as `str::lines` has them.
	pub fn lines(): Lines = self.toStr().lines()
}
