// A `str`, of the prelude: a view of bytes that live somewhere else,
// and everything it can do without memory of its own. A
// `str` is a pointer and a length, so slicing and comparing are all that
// searching and trimming need; building a new text belongs to `String`.
// Reading it by character is `char.wip`'s, taking it apart `split.wip`'s,
// and reading a number from it `parse.wip`'s.

// A `str` is a pointer and a length, which is what a slice of bytes is:
// `for byte in text` walks them.
extend str: Items<u8> {
	@intrinsic
	fn items(): &[u8]
}

extend str {
	/// How many bytes the text is: not how many
	/// characters, which `chars().count()` counts.
	@intrinsic
	pub fn len(): i64

	/// Bytes, read as text. A `str` and a `&[u8]` are the same pair — a
	/// pointer and a length — so this copies the pair and says nothing about
	/// what the bytes hold. What it answers borrows `bytes`,
	/// and the checker holds it to that.
	@intrinsic
	pub static fn fromBytes(bytes: &[u8]): str

	/// Whether the text has no bytes.
	pub fn isEmpty(): bool = self.len() == 0

	/// Whether the text begins with `prefix`, by bytes.
	pub fn startsWith(prefix: str): bool =
		prefix.len() <= self.len() && self[0..prefix.len()] == prefix

	/// Whether the text ends with `suffix`, by bytes.
	pub fn endsWith(suffix: str): bool =
		suffix.len() <= self.len() && self[self.len() - suffix.len()..self.len()] == suffix

	/// Where `needle` first appears, counted in bytes from the start, or
	/// nothing when it does not appear. The empty text is found at 0.
	pub fn find(needle: str): Option<i64> = {
		if needle.len() > self.len() then return .None
		for start in 0..self.len() - needle.len() + 1 {
			if self[start..start + needle.len()] == needle then return .Some(start)
		}
		return .None
	}

	/// Where `needle` last appears, counted in bytes from the start, or
	/// nothing when it does not appear. The empty text is found at the end.
	pub fn findLast(needle: str): Option<i64> = {
		if needle.len() > self.len() then return .None
		var start = self.len() - needle.len()
		while start >= 0 {
			if self[start..start + needle.len()] == needle then return .Some(start)
			start -= 1
		}
		return .None
	}

	/// Whether `needle` appears in the text.
	pub fn contains(needle: str): bool = self.find(needle).isSome()

	/// The text after `prefix`, where it begins with it, by bytes;
	/// nothing where it does not.
	pub fn stripPrefix(prefix: str): Option<str> =
		if self.startsWith(prefix) then .Some(self[prefix.len()..self.len()]) else .None

	/// The text before `suffix`, where it ends with it, by bytes; nothing
	/// where it does not.
	pub fn stripSuffix(suffix: str): Option<str> =
		if self.endsWith(suffix) then .Some(self[0..self.len() - suffix.len()]) else .None

	/// The text without the white space it begins with: spaces, tabs and
	/// line breaks.
	pub fn trimStart(): str = {
		var start = 0
		while start < self.len() && self[start].isAsciiWhitespace() {
			start += 1
		}
		return self[start..self.len()]
	}

	/// The text without the white space it ends with.
	pub fn trimEnd(): str = {
		var end = self.len()
		while end > 0 && self[end - 1].isAsciiWhitespace() {
			end -= 1
		}
		return self[0..end]
	}

	/// The text without the white space at either end.
	pub fn trim(): str = self.trimStart().trimEnd()
}

// C's kind of text, made from bytes.
extend cstring {
	// The bytes, as C's kind of string. What makes them one is the NUL the
	// caller wrote after them: `String::toCstring` appends one, and a float
	// is written into bytes and read back through one. It is the prelude's
	// alone: bytes with no NUL after them would be read past their end,
	// which is what its callers rule out.
	@intrinsic
	static fn fromBytes(bytes: &[u8]): cstring
}
