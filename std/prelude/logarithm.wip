// The natural logarithm of an `f64`, ported from Arm's
// optimized-routines, which glibc and musl compute it with, on the path
// that needs no fused multiply-add, so that every machine gives one answer:
//
// Copyright (c) 2018-2025, Arm Limited.
// SPDX-License-Identifier: MIT OR Apache-2.0 WITH LLVM-exception
//
// From `math/log.c`; within about 0.53 ulp.
//
// x = 2^k z, with z in [0.6875, 1.375): the tables have a c near z, of
// the 128 parts of that range, with 1/c and ln c, and ln x is
// k ln2 + ln c + ln(z/c), the last a polynomial of r = z/c - 1. Near 1,
// where that would lose digits, ln x is a polynomial of x - 1 alone.

/// ln(x); -∞ at zero, NaN below it.
fn logarithm(x: f64): f64 = {
	var ix = x.toBits()
	val top = (ix >> 48) as i64
	// 1 - 2^-4 <= x < 1 + 0x1.09p-4: 0x3FEE000000000000 to 0x3FF1090000000000.
	if ix -% 0x3FEE000000000000 < 0x0003090000000000 {
		val r = x - 1.0
		val r2 = r * r
		val r3 = r * r2
		var y =
			r3 *
			(LN_POLY_NEAR_ONE[1] +
				r * LN_POLY_NEAR_ONE[2] +
				r2 * LN_POLY_NEAR_ONE[3] +
				r3 *
					(LN_POLY_NEAR_ONE[4] +
						r * LN_POLY_NEAR_ONE[5] +
						r2 * LN_POLY_NEAR_ONE[6] +
						r3 *
							(LN_POLY_NEAR_ONE[7] +
								r * LN_POLY_NEAR_ONE[8] +
								r2 * LN_POLY_NEAR_ONE[9] +
								r3 * LN_POLY_NEAR_ONE[10])))
		// r - r²/2, with r's top half, whose square is exact, taken
		// apart from the rest.
		var w = r * 134217728.0
		val rhi = r + w - w
		val rlo = r - rhi
		w = rhi * rhi * LN_POLY_NEAR_ONE[0]
		val hi = r + w
		var lo = r - hi + w
		lo += LN_POLY_NEAR_ONE[0] * rlo * (rhi + r)
		y += lo
		y += hi
		return y
	}
	// Below 2^-1022, infinite, or not a number.
	if top < 0x0010 || top >= 0x7ff0 {
		if ix << 1 == 0 then return f64::fromBits(0xFFF0000000000000)
		if ix == 0x7FF0000000000000 then return x
		if top & 0x8000 != 0 || top & 0x7ff0 == 0x7ff0 then return (x - x) / (x - x)
		// Subnormal: scaled up by 2^52, which k takes back.
		ix = (x * 4503599627370496.0).toBits() -% (52 << 52)
	}
	// x = 2^k z, z in [0.6875, 1.375)
	val tmp = ix -% 0x3FE6000000000000
	val i = ((tmp >> 45) & 127) as i64
	val k = (tmp as i64) >> 52
	val iz = ix -% (tmp & (0xfff << 52))
	val invc = f64::fromBits(LN_INVERSE[i])
	val logc = f64::fromBits(LN_LOG_C[i])
	val z = f64::fromBits(iz)
	// r = z/c - 1, with c in two parts, as a fused multiply-add would.
	val chi = f64::fromBits(LN_C_HI[i])
	val clo = f64::fromBits(LN_C_LO[i])
	val r = (z - chi - clo) * invc
	val kd = k as f64
	// hi + lo = r + ln c + k ln2
	val w = kd * LN_LN2_HI + logc
	val hi = w + r
	val lo = w - hi + r + kd * LN_LN2_LO
	// ln x = lo + (log1p(r) - r) + hi
	val r2 = r * r
	return lo +
		r2 * LN_POLY[0] +
		r * r2 * (LN_POLY[1] + r * LN_POLY[2] + r2 * (LN_POLY[3] + r * LN_POLY[4])) +
		hi
}
