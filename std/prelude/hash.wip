// Hashing: a value writes its parts into a hasher it is
// handed, rather than answering a number of its own, so what the hasher
// sees is the bytes of the whole value, mixed once.
//
// `@derive(Hash)` on a struct or an enum makes the compiler write the body
// — each field in turn, and for an enum the variant's number first. It needs
// `@derive(Eq)` beside it, because a map is wrong the moment two equal
// values hash differently.

/// A word at a time: each is added to the state, which is then multiplied
/// by a large odd number, as the Fx hash a compiler's maps use does. It is
/// short, has no table, and is fast; it is not a defence against keys
/// chosen to collide, which a map of the program's own does not meet. A
/// map's hash is the program's own, never stored or sent, so it may change.
/// `Hasher()` is one with nothing written to it yet.
pub struct Hasher {
	state: u64 = 0
}

/// The odd number the state is multiplied by: rustc-hash's.
val MIX: u64 = 0xF1357AEA2E62A9C5

extend Hasher {
	/// One byte, mixed in as a word of its own.
	pub var fn writeByte(byte: u8) = self.writeInt(byte as u64)

	/// A number, mixed in whole.
	pub var fn writeInt(value: u64) = {
		self.state = (self.state +% value) *% MIX
	}

	/// The bytes eight at a time, the last few as a word of their own, and
	/// then how many there were.
	pub var fn writeBytes(bytes: &[u8]) = {
		val count = bytes.len()
		var at = 0
		while at + 8 <= count {
			var word: u64 = 0
			for i in 0..8 {
				word = word | ((bytes[at + i] as u64) << ((i * 8) as u64))
			}
			self.writeInt(word)
			at += 8
		}
		if at < count {
			var word: u64 = 0
			for i in 0..count - at {
				word = word | ((bytes[at + i] as u64) << ((i * 8) as u64))
			}
			self.writeInt(word)
		}
		// The length goes in too, so that "ab" and "a", "b" are not one.
		self.writeInt(count as u64)
	}

	/// The hash of everything written so far. The multiplication mixes
	/// into the high bits, and a map finds a slot by the low ones, so the
	/// high bits are turned down to them.
	pub fn finish(): u64 = self.state.rotateLeft(26)
}

/// A value that can be hashed, by writing its parts into a `Hasher`.
pub interface Hash {
	fn hashInto(out: &var Hasher)
}

extend i8: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self as u64)
}

extend i16: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self as u64)
}

extend i32: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self as u64)
}

extend i64: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self as u64)
}

extend isize: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self as u64)
}

extend u8: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self as u64)
}

extend u16: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self as u64)
}

extend u32: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self as u64)
}

extend u64: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self)
}

extend usize: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self as u64)
}

// The low half and then the high one.
extend i128: Hash {
	fn hashInto(out: &var Hasher) = {
		out.writeInt(self as u64)
		out.writeInt((self >> 64) as u64)
	}
}

extend u128: Hash {
	fn hashInto(out: &var Hasher) = {
		out.writeInt(self as u64)
		out.writeInt((self >> 64) as u64)
	}
}

// `void` holds nothing, so it adds nothing to the hash.
extend void: Hash {
	fn hashInto(out: &var Hasher) = {}
}

extend bool: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(if self then 1 else 0)
}

extend char: Hash {
	fn hashInto(out: &var Hasher) = out.writeInt(self as u64)
}

extend str: Hash {
	fn hashInto(out: &var Hasher) = out.writeBytes(&self)
}

// A slice hashes when its elements do, and an array as the slice of all
// of it. The length goes in too, so that `[1]` and
// `[1, 0]` are not one.
extend [T: Hash]: Hash {
	fn hashInto(out: &var Hasher) = {
		for value in self {
			value.hashInto(&var out)
		}
		out.writeInt(self.len() as u64)
	}
}

// A vector hashes as the slice of its elements.
extend Vec<T: Hash>: Hash {
	fn hashInto(out: &var Hasher) = self.items().hashInto(&var out)
}

// Which variant it is, then what it holds.
extend Option<T: Hash>: Hash {
	fn hashInto(out: &var Hasher) = match self {
		.Some(value) => {
			out.writeInt(1)
			value.hashInto(&var out)
		}
		.None => out.writeInt(0)
	}
}

extend Result<T: Hash, E: Hash>: Hash {
	fn hashInto(out: &var Hasher) = match self {
		.Ok(value) => {
			out.writeInt(1)
			value.hashInto(&var out)
		}
		.Err(error) => {
			out.writeInt(0)
			error.hashInto(&var out)
		}
	}
}

extend String: Hash {
	fn hashInto(out: &var Hasher) = self.toStr().hashInto(&var out)
}

extend cstring: Hash {
	fn hashInto(out: &var Hasher) = self.toStr().hashInto(&var out)
}

// A tuple is hashed by hashing each of its elements in turn.
extend Tuple2<A: Hash, B: Hash>: Hash {
	fn hashInto(out: &var Hasher) = {
		self.0.hashInto(&var out)
		self.1.hashInto(&var out)
	}
}

extend Tuple3<A: Hash, B: Hash, C: Hash>: Hash {
	fn hashInto(out: &var Hasher) = {
		self.0.hashInto(&var out)
		self.1.hashInto(&var out)
		self.2.hashInto(&var out)
	}
}

extend Tuple4<A: Hash, B: Hash, C: Hash, D: Hash>: Hash {
	fn hashInto(out: &var Hasher) = {
		self.0.hashInto(&var out)
		self.1.hashInto(&var out)
		self.2.hashInto(&var out)
		self.3.hashInto(&var out)
	}
}
