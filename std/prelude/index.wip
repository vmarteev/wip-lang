// Indexing: `x[i]` is a lookup the type answers.
//
// A `Vec` is indexed by a position, a `Grid` by a point: the interface
// says what the key is and what it finds.
//
// An array, a slice and a `str` are indexed by the machine; everything
// else says what `x[i]` means by implementing this. As `Items` and
// `Sequence` do, it declares the reading half of a lending pair: where
// the type also has `var fn at(key: K): &var V`, `x[i] = v` writes through
// it, and where it has not, the type is read-only. A type
// whose two halves say the same writes them once, as `lend fn at(key: K):
// &V`.
//
// A container indexed by a position from 0 implements `Sequence` instead,
// which is `x[i]` and `for` in one.

/// `x[key]`: the value a key finds.
pub interface Index<K, type V> {
	/// The value the key finds, lent where it lies.
	fn at(key: K): &V
}

// An index of any integer type is taken where a position is, an `i64`.
// One of 32 bits or fewer is one as it is; one of 64 bits
// or more comes through these, and where it is more than an `i64` holds it
// is past every length, and said so with what it was, not wrapped.

/// An unsigned index, as a position.
fn indexOfUnsigned(value: u128): i64 = {
	if value > 9223372036854775807 then panic("index \(value) is out of bounds")
	return value as i64
}

/// A signed index of 128 bits, as a position; a negative one goes on to
/// be out of bounds as any is.
fn indexOfSigned(value: i128): i64 = {
	if value > 9223372036854775807 || value < -9223372036854775808 then
		panic("index \(value) is out of bounds")
	return value as i64
}
