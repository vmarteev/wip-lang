// A range as a value: `lo..hi`, the integers from `lo` up to `hi`, and
// `lo..=hi`, up to and through `hi`, where they stand as an expression of
// their own — `(0..4).any((i) => taken[i])`, `val ages = 18..=65` — rather
// than what a `for` counts or a slice takes. It is an iterator, so every
// walk an iterator has is a range's: `map`, `filter`, `any`, `sum`, `toVec`.

/// The integers from `start` up to `end`, and `end` too where it is
/// `inclusive`, one after another: what `lo..hi` and `lo..=hi` are as a
/// value. `start` is the next it gives, so a range walked part of the way
/// starts where it stopped.
@derive(Eq, Clone)
pub struct Range<T> {
	pub start: T
	pub end: T
	pub inclusive: bool
	/// An inclusive range that has given its end, which may be the largest
	/// value of its type, past which it could not count.
	done: bool = false
}

extend Range<T> {
	/// What `start..end` is, and `start..=end`: the compiler's.
	static fn of(start: T, end: T, inclusive: bool): Range<T> = Range(
		start: start,
		end: end,
		inclusive: inclusive,
	)
}

extend Range<T: Eq + Ord + Add + One + Clone>: Iterator<T> {
	/// The next integer, or nothing once it has reached its end.
	var fn next(): Option<T> = {
		if self.done then return .None
		if self.inclusive {
			if self.start > self.end then return .None
			val at = self.start.clone()
			if at == self.end then self.done = true else self.start = at + T::one()
			return .Some(at)
		}
		if self.start >= self.end then return .None
		val at = self.start.clone()
		self.start = at + T::one()
		return .Some(at)
	}
}
