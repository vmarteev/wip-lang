// `Option<T>`, of the prelude: what every file sees without an import.
// Its name is reserved, so no other module may declare or
// import it, and `Option` means the same type in every program.

/// A value, or nothing. Its variants are written `.Some(x)` and `.None`
/// wherever the type is known, and it is taken apart with
/// `is`, `match`, or `val … else`.
///
/// `Option<own<T>>` is one word: the empty variant is the null pointer.
pub enum Option<T> {
	Some(value: T)
	None

	/// Whether it holds a value.
	pub fn isSome(): bool = self is .Some(..)
	/// Whether it holds nothing.
	pub fn isNone(): bool = self is .None

	/// The value, or a panic when there is none.
	pub move fn unwrap(): T = match move self {
		.Some(value) => move value
		.None => panic("unwrap of an Option that holds nothing")
	}

	/// The value, or `default` when there is none. For plain data this
	/// copies; for a value that owns memory it takes it.
	/// `default` is evaluated either way; `unwrapOrElse` makes it only where
	/// it is needed.
	pub move fn unwrapOr(default: T): T = match move self {
		.Some(value) => move value
		.None => move default
	}

	/// The value, or what `default` makes when there is none, which it is
	/// called only then to make.
	pub move fn unwrapOrElse(default: &var () => T): T = match move self {
		.Some(value) => move value
		.None => default()
	}

	/// This option if it has a value, and `alternative` otherwise. Both are
	/// evaluated; `orElse` makes the alternative only where it is needed.
	pub move fn or(alternative: Option<T>): Option<T> =
		if self.isSome() then move self else move alternative

	/// This option if it has a value, and what `alternative` makes
	/// otherwise, which it is called only then to make.
	pub move fn orElse(alternative: &var () => Option<T>): Option<T> =
		if self.isSome() then move self else alternative()

	/// The value lent, where there is one: an `Option<&T>`, which borrows
	/// this option's value as a view does, and which `map` makes into
	/// what it looks at — `host.asRef().map((name) => name.toStr())` is an
	/// `Option<str>`.
	pub fn asRef(): Option<&T> = match self {
		.Some(value) => .Some(&value)
		.None => .None
	}

	/// The value, made into another by `f`; nothing stays nothing.
	pub move fn map<U>(f: &(value: T) => U): Option<U> = match move self {
		.Some(value) => .Some(f(move value))
		.None => .None
	}

	/// What `f` answers for the value; nothing stays nothing.
	pub move fn flatMap<U>(f: &(value: T) => Option<U>): Option<U> = match move self {
		.Some(value) => f(move value)
		.None => .None
	}

	/// The value where `p` holds, and nothing otherwise.
	pub move fn filter(keep: &(value: &T) => bool): Option<T> = match move self {
		.Some(value) => if keep(&value) then .Some(move value) else .None
		.None => .None
	}

	/// `f` of the value, or what `ifEmpty` answers when there is none. Only
	/// the one that is needed is called, as `Result::fold` does.
	pub move fn fold<U>(ifEmpty: &() => U, f: &(value: T) => U): U = match move self {
		.Some(value) => f(move value)
		.None => ifEmpty()
	}

	/// Whether there is a value and `test` answers true for it.
	pub fn any(test: &(value: &T) => bool): bool = match self {
		.Some(value) => test(&value)
		.None => false
	}

	/// Whether `test` answers true for the value, or there is none.
	pub fn all(test: &(value: &T) => bool): bool = match self {
		.Some(value) => test(&value)
		.None => true
	}

	/// `f` of the value, where there is one.
	pub fn forEach(f: &(value: &T) => void) = match self {
		.Some(value) => f(&value)
		.None => {}
	}

	/// The value, lent where it lies, to read or to write; a panic where
	/// there is none. `unwrap` takes the value out; this
	/// leaves it where it is.
	pub lend fn get(): &T = match self {
		.Some(inner) => lend inner
		.None => panic("get of an Option that holds nothing")
	}

	/// The value, leaving nothing behind.
	pub var fn take(): Option<T> = {
		val taken = move self
		self = .None
		return move taken
	}

	/// The value, leaving `value` behind.
	pub var fn replace(value: T): Option<T> keeps value = {
		val taken = move self
		self = .Some(move value)
		return move taken
	}

	/// The value, put there first where there was none. Every path lends a
	/// place, so this is a projection.
	pub var fn getOrInsert(value: T): &var T keeps value = {
		if self.isNone() then self = .Some(move value)
		match self {
			.Some(inner) => lend inner
			.None => panic("an Option that was just filled holds nothing")
		}
	}

	/// This option as a result: the value, or `error` where there is none.
	pub move fn toResult<E>(error: E): Result<T, E> = match move self {
		.Some(value) => .Ok(move value)
		.None => .Err(move error)
	}

	/// An option of an option, without the outer one. It belongs to the
	/// type, not to the prelude's names, so `Result` may have one too.
	pub static fn flatten(option: Option<Option<T>>): Option<T> = match move option {
		.Some(inner) => move inner
		.None => .None
	}
}
