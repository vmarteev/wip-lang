// An integer's arithmetic where the answer may not fit: `+` panics then
// (and `+%` wraps), and these answer instead — `checkedAdd` and the rest
// nothing, `saturatingAdd` and the rest the least or the greatest value
// there is. What a constant folder, a size worked out from what a program
// was given, or a counter that stops at its top asks.
//
// Whether the answer fits is the machine's: the instruction a checked `+`
// uses answers it with the sum, up to 64 bits. The 128-bit types, which
// have no such instruction, work it out here from the wrapped answer.

extend i8 {
	/// Whether the sum does not fit an `i8`.
	@intrinsic
	fn addOverflows(other: i8): bool

	/// Whether the difference does not fit an `i8`.
	@intrinsic
	fn subOverflows(other: i8): bool

	/// Whether the product does not fit an `i8`.
	@intrinsic
	fn mulOverflows(other: i8): bool

	/// The sum, or nothing where it does not fit.
	pub fn checkedAdd(other: i8): Option<i8> =
		if self.addOverflows(other) then .None else .Some(self +% other)

	/// The difference, or nothing where it does not fit.
	pub fn checkedSub(other: i8): Option<i8> =
		if self.subOverflows(other) then .None else .Some(self -% other)

	/// The product, or nothing where it does not fit.
	pub fn checkedMul(other: i8): Option<i8> =
		if self.mulOverflows(other) then .None else .Some(self *% other)

	/// The quotient, or nothing where `other` is 0, or where the smallest
	/// value is divided by -1, whose quotient does not fit.
	pub fn checkedDiv(other: i8): Option<i8> =
		if other == 0 || (self == i8::MIN && other == -1) then .None else .Some(self / other)

	/// The remainder, or nothing where `other` is 0, or where the smallest
	/// value is divided by -1.
	pub fn checkedRem(other: i8): Option<i8> =
		if other == 0 || (self == i8::MIN && other == -1) then .None else .Some(self % other)

	/// The negative, or nothing for the smallest value, which has none.
	pub fn checkedNeg(): Option<i8> = if self == i8::MIN then .None else .Some(-self)

	/// Shifted left by `amount`, or nothing where `amount` is negative or
	/// not less than the width; the bits shifted out are gone, as `<<`
	/// loses them.
	pub fn checkedShl(amount: i8): Option<i8> =
		if amount < 0 || amount >= 8 then .None else .Some(self << amount)

	/// The sum, or the least or the greatest value where it does not fit.
	pub fn saturatingAdd(other: i8): i8 =
		if !self.addOverflows(other) then self +% other else if other < 0 then i8::MIN else i8::MAX

	/// The difference, or the least or the greatest value where it does
	/// not fit.
	pub fn saturatingSub(other: i8): i8 =
		if !self.subOverflows(other) then self -% other else if other > 0 then i8::MIN else i8::MAX

	/// The product, or the least or the greatest value where it does not
	/// fit.
	pub fn saturatingMul(other: i8): i8 =
		if !self.mulOverflows(other) then self *% other
		else if (self < 0) != (other < 0) then i8::MIN
		else i8::MAX
}

