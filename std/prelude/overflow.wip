	pub fn saturatingAdd(other: u64): u64 =
		if self.addOverflows(other) then u64::MAX else self +% other

	/// The difference, or 0 where it would be below it.
	pub fn saturatingSub(other: u64): u64 = if other > self then 0 else self - other

	/// The product, or the greatest value where it does not fit.
	pub fn saturatingMul(other: u64): u64 =
		if self.mulOverflows(other) then u64::MAX else self *% other
}

extend u128 {
	/// Whether the sum does not fit: the wrapped sum is below either side.
	fn addOverflows(other: u128): bool = self +% other < self

	/// Whether the difference does not fit: it would be below 0.
	fn subOverflows(other: u128): bool = other > self

	/// Whether the product does not fit: the wrapped product divided
	/// by one side is not the other.
	fn mulOverflows(other: u128): bool = self != 0 && (self *% other) / self != other

	/// The sum, or nothing where it does not fit.
	pub fn checkedAdd(other: u128): Option<u128> =
		if self.addOverflows(other) then .None else .Some(self +% other)

	/// The difference, or nothing where it does not fit.
	pub fn checkedSub(other: u128): Option<u128> =
		if self.subOverflows(other) then .None else .Some(self -% other)

	/// The product, or nothing where it does not fit.
	pub fn checkedMul(other: u128): Option<u128> =
		if self.mulOverflows(other) then .None else .Some(self *% other)

	/// The quotient, or nothing where `other` is 0.
	pub fn checkedDiv(other: u128): Option<u128> = if other == 0 then .None else .Some(self / other)

	/// The remainder, or nothing where `other` is 0.
	pub fn checkedRem(other: u128): Option<u128> = if other == 0 then .None else .Some(self % other)

	/// The negative, which only 0 has.
	pub fn checkedNeg(): Option<u128> = if self == 0 then .Some(0) else .None

	/// Shifted left by `amount`, or nothing where `amount` is not less than
	/// the width; the bits shifted out are gone, as `<<` loses them.
	pub fn checkedShl(amount: u128): Option<u128> =
		if amount >= 128 then .None else .Some(self << amount)

	/// The sum, or the greatest value where it does not fit.
	pub fn saturatingAdd(other: u128): u128 =
		if self.addOverflows(other) then u128::MAX else self +% other

	/// The difference, or 0 where it would be below it.
	pub fn saturatingSub(other: u128): u128 = if other > self then 0 else self - other

	/// The product, or the greatest value where it does not fit.
	pub fn saturatingMul(other: u128): u128 =
		if self.mulOverflows(other) then u128::MAX else self *% other
}

extend usize {
	/// Whether the sum does not fit a `usize`.
	@intrinsic
	fn addOverflows(other: usize): bool

	/// Whether the difference does not fit a `usize`.
	@intrinsic
	fn subOverflows(other: usize): bool

	/// Whether the product does not fit a `usize`.
	@intrinsic
	fn mulOverflows(other: usize): bool

	/// The sum, or nothing where it does not fit.
	pub fn checkedAdd(other: usize): Option<usize> =
		if self.addOverflows(other) then .None else .Some(self +% other)

	/// The difference, or nothing where it does not fit.
	pub fn checkedSub(other: usize): Option<usize> =
		if self.subOverflows(other) then .None else .Some(self -% other)

	/// The product, or nothing where it does not fit.
	pub fn checkedMul(other: usize): Option<usize> =
		if self.mulOverflows(other) then .None else .Some(self *% other)

	/// The quotient, or nothing where `other` is 0.
	pub fn checkedDiv(other: usize): Option<usize> =
		if other == 0 then .None else .Some(self / other)

	/// The remainder, or nothing where `other` is 0.
	pub fn checkedRem(other: usize): Option<usize> =
		if other == 0 then .None else .Some(self % other)

	/// The negative, which only 0 has.
	pub fn checkedNeg(): Option<usize> = if self == 0 then .Some(0) else .None

	/// Shifted left by `amount`, or nothing where `amount` is not less than
	/// the width; the bits shifted out are gone, as `<<` loses them.
	pub fn checkedShl(amount: usize): Option<usize> =
		if amount >= 64 then .None else .Some(self << amount)

	/// The sum, or the greatest value where it does not fit.
	pub fn saturatingAdd(other: usize): usize =
		if self.addOverflows(other) then usize::MAX else self +% other

	/// The difference, or 0 where it would be below it.
	pub fn saturatingSub(other: usize): usize = if other > self then 0 else self - other

	/// The product, or the greatest value where it does not fit.
	pub fn saturatingMul(other: usize): usize =
		if self.mulOverflows(other) then usize::MAX else self *% other
}
