extend i128 {
	/// Whether the sum does not fit: the two have one sign, and the
	/// wrapped sum the other.
	fn addOverflows(other: i128): bool = {
		val sum = self +% other
		return ((self ^ sum) & (other ^ sum)) < 0
	}

	/// Whether the difference does not fit: the two have different
	/// signs, and the wrapped difference the sign of `other`.
	fn subOverflows(other: i128): bool = {
		val difference = self -% other
		return ((self ^ other) & (self ^ difference)) < 0
	}

	/// Whether the product does not fit: the product of the two sizes,
	/// unsigned, is past what the sign allows — 2¹²⁷ for a negative
	/// product, one less for a positive. Not worked out from the wrapped
	/// product, as `u128`'s is: an optimiser makes that a signed multiply
	/// that checks itself, which needs a helper only LLVM's own runtime
	/// has, where a program on Linux links GCC's.
	fn mulOverflows(other: i128): bool = {
		if self == 0 || other == 0 then return false
		val a = if self < 0 then (0 -% self) as u128 else self as u128
		val b = if other < 0 then (0 -% other) as u128 else other as u128
		if a.mulOverflows(b) then return true
		val limit: u128 = 170141183460469231731687303715884105728
		return if (self < 0) != (other < 0) then a *% b > limit else a *% b >= limit
	}

	/// The sum, or nothing where it does not fit.
	pub fn checkedAdd(other: i128): Option<i128> =
		if self.addOverflows(other) then .None else .Some(self +% other)

	/// The difference, or nothing where it does not fit.
	pub fn checkedSub(other: i128): Option<i128> =
		if self.subOverflows(other) then .None else .Some(self -% other)

	/// The product, or nothing where it does not fit.
	pub fn checkedMul(other: i128): Option<i128> =
		if self.mulOverflows(other) then .None else .Some(self *% other)

	/// The quotient, or nothing where `other` is 0, or where the smallest
	/// value is divided by -1, whose quotient does not fit.
	pub fn checkedDiv(other: i128): Option<i128> =
		if other == 0 || (self == i128::MIN && other == -1) then .None else .Some(self / other)

	/// The remainder, or nothing where `other` is 0, or where the smallest
	/// value is divided by -1.
	pub fn checkedRem(other: i128): Option<i128> =
		if other == 0 || (self == i128::MIN && other == -1) then .None else .Some(self % other)

	/// The negative, or nothing for the smallest value, which has none.
	pub fn checkedNeg(): Option<i128> = if self == i128::MIN then .None else .Some(-self)

	/// Shifted left by `amount`, or nothing where `amount` is negative or
	/// not less than the width; the bits shifted out are gone, as `<<`
	/// loses them.
	pub fn checkedShl(amount: i128): Option<i128> =
		if amount < 0 || amount >= 128 then .None else .Some(self << amount)

	/// The sum, or the least or the greatest value where it does not fit.
	pub fn saturatingAdd(other: i128): i128 =
		if !self.addOverflows(other) then self +% other
		else if other < 0 then i128::MIN
		else i128::MAX

	/// The difference, or the least or the greatest value where it does
	/// not fit.
	pub fn saturatingSub(other: i128): i128 =
		if !self.subOverflows(other) then self -% other
		else if other > 0 then i128::MIN
		else i128::MAX

	/// The product, or the least or the greatest value where it does not
	/// fit.
	pub fn saturatingMul(other: i128): i128 =
		if !self.mulOverflows(other) then self *% other
		else if (self < 0) != (other < 0) then i128::MIN
		else i128::MAX
}

