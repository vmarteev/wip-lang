// Finding an element: what a slice can do when its
// elements can be compared, and what a `Vec` lends it for; and in a
// slice kept sorted, finding one by halves.
//
// The block says what the element must answer, so `values.contains(x)` is
// there for a slice of numbers and not for a slice of files, and the
// message says which constraint was not met.

extend [T: Eq] {
	/// Where `value` first appears, counted from the start, or nothing.
	pub fn indexOf(value: &T): Option<i64> = {
		for i in 0..self.len() {
			if self[i] == value then return .Some(i)
		}
		return .None
	}

	/// Where `value` last appears, counted from the start, or nothing.
	pub fn lastIndexOf(value: &T): Option<i64> = {
		var i = self.len() - 1
		while i >= 0 {
			if self[i] == value then return .Some(i)
			i -= 1
		}
		return .None
	}

	/// Whether any element is equal to `value`.
	pub fn contains(value: &T): bool = self.indexOf(&value).isSome()
}

extend [T] {
	/// Where an element lies in a slice sorted in the order `compare`
	/// stands for, found by halves: `compare` says how an element stands to
	/// the one sought — `.Less` where it comes before it. `.Ok(i)` where
	/// one is `.Same`, any of several; `.Err(i)` where none is, `i` being
	/// where it would go to keep the slice sorted. In a slice not sorted
	/// that way, what it answers means nothing.
	pub fn binarySearchBy(compare: &(x: &T) => Ordering): Result<i64, i64> = {
		var low = 0
		var high = self.len()
		while low < high {
			val middle = low + (high - low) / 2
			match compare(&self[middle]) {
				.Less => low = middle + 1
				.More => high = middle
				.Same => return .Ok(middle)
			}
		}
		return .Err(low)
	}
}

extend [T: Ord] {
	/// Where `value` lies in a sorted slice, found by halves: `.Ok(i)`
	/// where it is there, `.Err(i)` where it would go.
	pub fn binarySearch(value: &T): Result<i64, i64> = self.binarySearchBy((x: &T) => x.compare(
		&value,
	))

	/// Where the smallest element is, or nothing where there are none.
	/// The first of several equal ones is the one it answers.
	pub fn minIndex(): Option<i64> = {
		if self.isEmpty() then return .None
		var best = 0
		for i in 1..self.len() {
			if self[i] < self[best] then best = i
		}
		return .Some(best)
	}

	/// Where the largest element is, or nothing where there are none.
	/// The first of several equal ones is the one it answers.
	pub fn maxIndex(): Option<i64> = {
		if self.isEmpty() then return .None
		var best = 0
		for i in 1..self.len() {
			if self[best] < self[i] then best = i
		}
		return .Some(best)
	}
}

extend Vec<T: Eq> {
	/// Where `value` first appears in the vector, or nothing.
	pub fn indexOf(value: &T): Option<i64> = self.items().indexOf(&value)

	/// Where `value` last appears in the vector, or nothing.
	pub fn lastIndexOf(value: &T): Option<i64> = self.items().lastIndexOf(&value)

	/// Whether the vector holds a value equal to this one.
	pub fn contains(value: &T): bool = self.items().contains(&value)
}

extend Vec<T> {
	/// Where an element lies in a sorted vector, as a slice's
	/// `binarySearchBy` finds it.
	pub fn binarySearchBy(
		compare: &(x: &T) => Ordering,
	): Result<i64, i64> = self.items().binarySearchBy(compare)
}

extend Vec<T: Ord> {
	/// Where `value` lies in a sorted vector, or would go.
	pub fn binarySearch(value: &T): Result<i64, i64> = self.items().binarySearch(&value)

	/// Where the vector's smallest element is, or nothing.
	pub fn minIndex(): Option<i64> = self.items().minIndex()

	/// Where the vector's largest element is, or nothing.
	pub fn maxIndex(): Option<i64> = self.items().maxIndex()
}
