// Values written to a format and read back: `Encode` writes a value into
// any `Encoder`, and `Decode` reads one from any `Decoder`. A format — JSON,
// a binary one, an editor's panel — is a type that implements the two, and
// sees a value as a few shapes: a scalar, text, a sequence, a map, a
// record of named fields, and a variant of an enum. `@derive(Encode,
// Decode)` writes both from a type's fields, as `@derive(Clone)` writes
// `clone`; the prelude's types implement them where what they hold does.

/// What a value is written into: a format, which lays out each shape as it
/// is given.
pub interface Encoder {
	var fn bool(value: bool)

	var fn int(value: i64)

	/// An unsigned number past what an `i64` holds.
	var fn unsigned(value: u64)

	var fn float(value: f64)

	/// An `f32`, which a format may write in fewer digits than the `f64`
	/// it widens to.
	var fn float32(value: f32)

	var fn text(value: str)

	/// An `Option` that holds none. A format may leave a record's field that
	/// is nothing out, as JSON does.
	var fn nothing()

	/// `length` values follow, each encoded in turn, and then `endSequence`.
	var fn beginSequence(length: i64)

	var fn endSequence()

	/// `length` entries follow, each a key and then its value, and then
	/// `endMap`.
	var fn beginMap(length: i64)

	var fn endMap()

	/// A struct named `name`: `length` fields follow, each named by `field`
	/// and then encoded, and then `endRecord`.
	var fn beginRecord(name: str, length: i64)

	var fn field(name: str)

	var fn endRecord()

	/// The variant `name` of the enum `enumName`, of `length` fields: where it
	/// has any, a record of the variant's name follows; then `endVariant`.
	var fn beginVariant(enumName: str, name: str, length: i64)

	var fn endVariant()
}

/// What a value is read from: a format, which answers each shape in the
/// order it holds them, and a record's fields by name in any order. What it
/// cannot answer is its own `Error`, which says where.
pub interface Decoder<type Error> {
	var fn bool(): Result<bool, Error>

	var fn int(): Result<i64, Error>

	var fn unsigned(): Result<u64, Error>

	var fn float(): Result<f64, Error>

	var fn text(): Result<String, Error>

	/// Whether the next value is nothing, which is taken where it is.
	var fn nothing(): Result<bool, Error>

	var fn beginSequence(): Result<void, Error>

	/// Whether another element of the sequence, or entry of the map, follows.
	var fn more(): Result<bool, Error>

	var fn endSequence(): Result<void, Error>

	var fn beginMap(): Result<void, Error>

	var fn endMap(): Result<void, Error>

	/// A record of the struct `name`, whose fields are asked for by name.
	var fn beginRecord(name: str): Result<void, Error>

	/// Whether the record has the field `name`, which is read next where it
	/// does. A field the type does not ask for is passed over.
	var fn field(name: str): Result<bool, Error>

	var fn endRecord(): Result<void, Error>

	/// The name of the variant of the enum `enumName` that follows: where it has
	/// fields, a record of its name follows; then `endVariant`.
	var fn beginVariant(enumName: str): Result<String, Error>

	var fn endVariant(): Result<void, Error>

	/// The format's error for a field the input does not have, and the type
	/// gives no default for.
	fn missing(field: str): Error

	/// The format's error for a variant the enum does not have.
	fn unknown(enumName: str, name: str): Error

	/// The format's error for a value the type cannot hold: a number too
	/// large, a text of more than one `char`.
	fn invalid(what: str): Error
}

/// A value written into a format.
pub interface Encode {
	fn encode<E: Encoder>(into: &var E)
}

/// A value read from a format.
pub interface Decode {
	static fn decode<D: Decoder>(from: &var D): Result<Self, D::Error>
}

// ---- Scalars ----

extend bool: Encode {
	fn encode<E: Encoder>(into: &var E) = into.bool(self)
}

extend bool: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<bool, D::Error> = from.bool()
}

extend i8: Encode {
	fn encode<E: Encoder>(into: &var E) = into.int(self as i64)
}

extend i8: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<i8, D::Error> = {
		val n = from.int()?
		return if n < -128 || n > 127 then .Err(from.invalid("an i8")) else .Ok(n as i8)
	}
}

extend i16: Encode {
	fn encode<E: Encoder>(into: &var E) = into.int(self as i64)
}

extend i16: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<i16, D::Error> = {
		val n = from.int()?
		return if n < -32768 || n > 32767 then .Err(from.invalid("an i16")) else .Ok(n as i16)
	}
}

extend i32: Encode {
	fn encode<E: Encoder>(into: &var E) = into.int(self as i64)
}

extend i32: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<i32, D::Error> = {
		val n = from.int()?
		return if n < -2147483648 || n > 2147483647 then .Err(from.invalid("an i32"))
		else .Ok(n as i32)
	}
}

extend i64: Encode {
	fn encode<E: Encoder>(into: &var E) = into.int(self)
}

extend i64: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<i64, D::Error> = from.int()
}

extend isize: Encode {
	fn encode<E: Encoder>(into: &var E) = into.int(self as i64)
}

extend isize: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<isize, D::Error> = .Ok(from.int()? as isize)
}

extend u8: Encode {
	fn encode<E: Encoder>(into: &var E) = into.int(self)
}

extend u8: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<u8, D::Error> = {
		val n = from.int()?
		return if n < 0 || n > 255 then .Err(from.invalid("a u8")) else .Ok(n as u8)
	}
}

extend u16: Encode {
	fn encode<E: Encoder>(into: &var E) = into.int(self)
}

extend u16: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<u16, D::Error> = {
		val n = from.int()?
		return if n < 0 || n > 65535 then .Err(from.invalid("a u16")) else .Ok(n as u16)
	}
}

extend u32: Encode {
	fn encode<E: Encoder>(into: &var E) = into.int(self)
}

extend u32: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<u32, D::Error> = {
		val n = from.int()?
		return if n < 0 || n > 4294967295 then .Err(from.invalid("a u32")) else .Ok(n as u32)
	}
}

extend u64: Encode {
	fn encode<E: Encoder>(into: &var E) = into.unsigned(self)
}

extend u64: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<u64, D::Error> = from.unsigned()
}

extend usize: Encode {
	fn encode<E: Encoder>(into: &var E) = into.unsigned(self as u64)
}

extend usize: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<usize, D::Error> = .Ok(
		from.unsigned()? as usize,
	)
}

extend f32: Encode {
	fn encode<E: Encoder>(into: &var E) = into.float32(self)
}

extend f32: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<f32, D::Error> = .Ok(from.float()? as f32)
}

extend f64: Encode {
	fn encode<E: Encoder>(into: &var E) = into.float(self)
}

extend f64: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<f64, D::Error> = from.float()
}

/// A `char` is text of one.
extend char: Encode {
	fn encode<E: Encoder>(into: &var E) = into.text("\(self)")
}

extend char: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<char, D::Error> = {
		val text = from.text()?
		var chars = text.chars()
		val .Some(first) = chars.next() else return .Err(from.invalid("a char"))
		return if chars.next().isSome() then .Err(from.invalid("a char")) else .Ok(first)
	}
}

/// Text borrowed encodes, and does not decode: what it borrows has nowhere
/// to come from. A `String` does both.
extend str: Encode {
	fn encode<E: Encoder>(into: &var E) = into.text(self)
}

extend String: Encode {
	fn encode<E: Encoder>(into: &var E) = into.text(self.toStr())
}

extend String: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<String, D::Error> = from.text()
}

// ---- What holds others ----

extend Vec<T: Encode>: Encode {
	fn encode<E: Encoder>(into: &var E) = {
		into.beginSequence(self.len())
		for item in self.items() {
			item.encode(&var into)
		}
		into.endSequence()
	}
}

extend Vec<T: Decode>: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<Vec<T>, D::Error> = {
		from.beginSequence()?
		var items: Vec<T> = Vec()
		while from.more()? {
			items.push(T::decode(&var from)?)
		}
		from.endSequence()?
		return .Ok(items)
	}
}

extend [T: Encode]: Encode {
	fn encode<E: Encoder>(into: &var E) = {
		into.beginSequence(self.len())
		for item in self {
			item.encode(&var into)
		}
		into.endSequence()
	}
}

/// What it holds, or nothing.
extend Option<T: Encode>: Encode {
	fn encode<E: Encoder>(into: &var E) = match self {
		.Some(value) => value.encode(&var into)
		.None => into.nothing()
	}
}

extend Option<T: Decode>: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<Option<T>, D::Error> =
		if from.nothing()? then .Ok(.None) else .Ok(.Some(T::decode(&var from)?))
}

/// What it holds, as it is.
extend own<T: Encode>: Encode {
	fn encode<E: Encoder>(into: &var E) = encodeHeld<T, E>(&self, &var into)
}

/// What an `own` holds, encoded: lent as the `&T` an `&own<T>` is.
fn encodeHeld<T: Encode, E: Encoder>(value: &T, into: &var E) = value.encode(&var into)

extend own<T: Decode>: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<own<T>, D::Error> = .Ok(own (T::decode(
		&var from,
	)?))
}

/// A tuple is a sequence of its length.
extend Tuple2<A: Encode, B: Encode>: Encode {
	fn encode<E: Encoder>(into: &var E) = {
		into.beginSequence(2)
		self.0.encode(&var into)
		self.1.encode(&var into)
		into.endSequence()
	}
}

extend Tuple2<A: Decode, B: Decode>: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<(A, B), D::Error> = {
		from.beginSequence()?
		if !from.more()? then return .Err(from.invalid("a pair"))
		val a = A::decode(&var from)?
		if !from.more()? then return .Err(from.invalid("a pair"))
		val b = B::decode(&var from)?
		from.endSequence()?
		return .Ok((a, b))
	}
}

extend Tuple3<A: Encode, B: Encode, C: Encode>: Encode {
	fn encode<E: Encoder>(into: &var E) = {
		into.beginSequence(3)
		self.0.encode(&var into)
		self.1.encode(&var into)
		self.2.encode(&var into)
		into.endSequence()
	}
}

extend Tuple3<A: Decode, B: Decode, C: Decode>: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<(A, B, C), D::Error> = {
		from.beginSequence()?
		if !from.more()? then return .Err(from.invalid("a triple"))
		val a = A::decode(&var from)?
		if !from.more()? then return .Err(from.invalid("a triple"))
		val b = B::decode(&var from)?
		if !from.more()? then return .Err(from.invalid("a triple"))
		val c = C::decode(&var from)?
		from.endSequence()?
		return .Ok((a, b, c))
	}
}
