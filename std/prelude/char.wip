// Characters: a `char` is one Unicode scalar value — a
// number up to 10FFFF that is not a surrogate — in 32 bits. A `str` is
// bytes, UTF-8 by convention; `chars()` reads them as
// characters, and what is not UTF-8 reads as U+FFFD, one byte at a time,
// as Go reads it.
//
// What `chars` answers is `std::text`'s.

import std::text::{Chars}

extend char {
	/// The character whose number is `code`, or nothing where no character
	/// has that number.
	pub static fn fromInt(code: i64): Option<char> =
		if code is ..0 | 0xD800..=0xDFFF | 0x110000.. then .None
		else .Some(char::fromScalar(code as u32))

	/// A number known to be a character, as one. Only the prelude checks
	/// first.
	@intrinsic
	static fn fromScalar(code: u32): char

	/// How many bytes UTF-8 writes it in: one to four.
	pub fn utf8Len(): i64 = {
		val code = self as u32
		if code < 0x80 then return 1
		if code < 0x800 then return 2
		if code < 0x10000 then return 3
		return 4
	}

	/// Whether it is one of the first 128, which UTF-8 writes in one byte.
	pub fn isAscii(): bool = (self as u32) < 0x80

	/// `0` to `9`.
	pub fn isDigit(): bool = self is '0'..='9'

	/// `a` to `z` and `A` to `Z`. What is a letter in every other script
	/// needs Unicode's tables, which the prelude does not carry.
	pub fn isAsciiLetter(): bool = self is 'a'..='z' | 'A'..='Z'

	/// Unicode's white space: the space, the tab, the line breaks, and the
	/// wider and narrower spaces.
	pub fn isWhitespace(): bool = match self {
		'\t'..='\r' | ' ' | '\u{85}' | '\u{A0}' | '\u{1680}' => true
		'\u{2000}'..='\u{200A}' | '\u{2028}' | '\u{2029}' | '\u{202F}' => true
		'\u{205F}' | '\u{3000}' => true
		_ => false
	}

	/// `a` to `z` as `A` to `Z`; any other character as it is.
	pub fn toAsciiUpper(): char = match self {
		'a'..='z' => char::fromScalar(self as u32 - 32)
		_ => self
	}

	/// `A` to `Z` as `a` to `z`; any other character as it is.
	pub fn toAsciiLower(): char = match self {
		'A'..='Z' => char::fromScalar(self as u32 + 32)
		_ => self
	}
}

/// One character read from bytes: what it is, and how many bytes it took.
struct Decoded {
	code: u32
	width: i64
	valid: bool
}

extend str {
	/// The characters, one at a time, read as UTF-8.
	pub fn chars(): Chars = Chars::of(self)

	/// Whether the bytes are UTF-8 throughout.
	pub fn isValidUtf8(): bool = {
		var at = 0
		while at < self.len() {
			val decoded = self.decodeAt(at)
			if !decoded.valid then return false
			at += decoded.width
		}
		return true
	}

	/// The character that begins at byte `at`, which is inside the text,
	/// and how many bytes it takes. Where the bytes there are not UTF-8, it
	/// is U+FFFD and one byte, so a reader always moves on.
	pub fn charAt(at: i64): (char, i64) = {
		val decoded = self.decodeAt(at)
		return (char::fromScalar(decoded.code), decoded.width)
	}

	/// `charAt`, with whether the bytes were UTF-8.
	fn decodeAt(at: i64): Decoded = {
		val invalid = Decoded(code: 0xFFFD, width: 1, valid: false)
		val first = self[at] as u32
		if first < 0x80 then return Decoded(code: first, width: 1, valid: true)
		// How many bytes follow, the value the lead byte holds, and the
		// range the next byte must be in: narrower where it would write a
		// number too small for its length, a surrogate, or past 10FFFF.
		var more = 0
		var code: u32 = 0
		var low: u32 = 0x80
		var high: u32 = 0xBF
		if first is 0xC2..=0xDF {
			more = 1
			code = first & 0x1F
		} else if first is 0xE0..=0xEF {
			more = 2
			code = first & 0x0F
			if first == 0xE0 then low = 0xA0 else if first == 0xED then high = 0x9F
		} else if first is 0xF0..=0xF4 {
			more = 3
			code = first & 0x07
			if first == 0xF0 then low = 0x90 else if first == 0xF4 then high = 0x8F
		} else {
			return invalid
		}
		// The bytes it needs run past the end.
		if at + more >= self.len() then return invalid
		for i in 1..more + 1 {
			val next = self[at + i] as u32
			if next < low || next > high then return invalid
			code = (code << 6) | (next & 0x3F)
			low = 0x80
			high = 0xBF
		}
		return Decoded(code: code, width: more + 1, valid: true)
	}
}

extend String {
	/// The characters, one at a time, read as UTF-8.
	pub fn chars(): Chars = self.toStr().chars()

	/// Whether the bytes are UTF-8 throughout.
	pub fn isValidUtf8(): bool = self.toStr().isValidUtf8()
}
