// Characters: a `char` is one Unicode scalar value — a
// number up to 10FFFF that is not a surrogate — in 32 bits. A `str` is
// bytes, UTF-8 by convention; `chars()` reads them as
// characters, and what is not UTF-8 reads as U+FFFD, one byte at a time,
// as Go reads it.
// A byte is asked the same of what it is as an ASCII character: a digit,
// a letter, a space.
//
// What `chars` answers is `std::text`'s.

import std::text::{Chars}

extend char {
	/// The character whose number is `code`, or nothing where no character
	/// has that number.
	pub static fn fromInt(code: i64): Option<char> =
		if code is ..0 | 0xD800..=0xDFFF | 0x110000.. then .None
		else .Some(char::fromScalar(code as u32))

	/// A number known to be a character, as one. Only the prelude checks
	/// first.
	@intrinsic
	static fn fromScalar(code: u32): char

	/// How many bytes UTF-8 writes it in: one to four.
	pub fn utf8Len(): i64 = {
		val code = self as u32
		if code < 0x80 then return 1
		if code < 0x800 then return 2
		if code < 0x10000 then return 3
		return 4
	}

	/// Whether it is one of the first 128, which UTF-8 writes in one byte.
	pub fn isAscii(): bool = (self as u32) < 0x80

	/// `0` to `9`.
	pub fn isDigit(): bool = self is '0'..='9'

	/// `a` to `z` and `A` to `Z`. A letter of every script is `isLetter`.
	pub fn isAsciiLetter(): bool = self is 'a'..='z' | 'A'..='Z'

	/// `a` to `z`, `A` to `Z` and `0` to `9`: what a name in most languages
	/// is made of, with `_`. A letter or a number of every script is
	/// `isAlphanumeric`.
	pub fn isAsciiAlphanumeric(): bool = self is 'a'..='z' | 'A'..='Z' | '0'..='9'

	/// `A` to `Z`. Every script's capitals are `isUppercase`.
	pub fn isAsciiUppercase(): bool = self is 'A'..='Z'

	/// `a` to `z`. Every script's small letters are `isLowercase`.
	pub fn isAsciiLowercase(): bool = self is 'a'..='z'

	/// `0` to `9`, `a` to `f` and `A` to `F`: a digit of a number in base 16.
	pub fn isHexDigit(): bool = self is '0'..='9' | 'a'..='f' | 'A'..='F'

	/// What it is worth as a digit in base `radix`, 2 to 36 — `0` to `9`,
	/// then `a` to `z` in either case — or nothing where it is not one.
	pub fn digitValue(radix: i64 = 10): Option<i64> =
		if self.isAscii() then (self as u32 as u8).digitValue(radix) else .None

	/// Unicode's white space: the space, the tab, the line breaks, and the
	/// wider and narrower spaces.
	pub fn isWhitespace(): bool = match self {
		'\t'..='\r' | ' ' | '\u{85}' | '\u{A0}' | '\u{1680}' => true
		'\u{2000}'..='\u{200A}' | '\u{2028}' | '\u{2029}' | '\u{202F}' => true
		'\u{205F}' | '\u{3000}' => true
		_ => false
	}

	/// `a` to `z` as `A` to `Z`; any other character as it is.
	pub fn toAsciiUpper(): char = match self {
		'a'..='z' => char::fromScalar(self as u32 - 32)
		_ => self
	}

	/// `A` to `Z` as `a` to `z`; any other character as it is.
	pub fn toAsciiLower(): char = match self {
		'A'..='Z' => char::fromScalar(self as u32 + 32)
		_ => self
	}
}

// A byte read as ASCII: what C's `<ctype.h>` asks of one in the C locale,
// for a program that reads text a byte at a time — a lexer, a protocol, a
// file format. A byte past 127 is none of these: it is part of a character
// UTF-8 writes in several, which `str.chars()` reads.
extend u8 {
	/// Whether it is one of the first 128, a character by itself.
	pub fn isAscii(): bool = self < 0x80

	/// `0` to `9`.
	pub fn isDigit(): bool = self is b'0'..=b'9'

	/// `0` to `9`, `a` to `f` and `A` to `F`: a digit of a number in base 16.
	pub fn isHexDigit(): bool = self is b'0'..=b'9' | b'a'..=b'f' | b'A'..=b'F'

	/// `a` to `z` and `A` to `Z`.
	pub fn isAsciiLetter(): bool = self is b'a'..=b'z' | b'A'..=b'Z'

	/// `a` to `z`, `A` to `Z` and `0` to `9`.
	pub fn isAsciiAlphanumeric(): bool = self is b'a'..=b'z' | b'A'..=b'Z' | b'0'..=b'9'

	/// `A` to `Z`.
	pub fn isAsciiUppercase(): bool = self is b'A'..=b'Z'

	/// `a` to `z`.
	pub fn isAsciiLowercase(): bool = self is b'a'..=b'z'

	/// The space, the tab, and the line breaks `\n`, `\v`, `\f` and `\r`: C's
	/// `isspace`, and what `char`'s `isWhitespace` answers of these.
	pub fn isAsciiWhitespace(): bool = self is b' ' | b'\t'..=b'\r'

	/// What prints as a mark and is neither a letter nor a digit: `!` to `/`,
	/// `:` to `@`, `[` to `` ` `` and `{` to `~`, C's `ispunct`.
	pub fn isAsciiPunctuation(): bool =
		self is b'!'..=b'/' | b':'..=b'@' | b'['..=b'`' | b'{'..=b'~'

	/// What prints, the space among it: ` ` to `~`, C's `isprint`. The rest
	/// of the first 128 are control characters.
	pub fn isAsciiPrintable(): bool = self is b' '..=b'~'

	/// What it is worth as a digit in base `radix`, 2 to 36 — `0` to `9`,
	/// then `a` to `z` in either case — or nothing where it is not one.
	pub fn digitValue(radix: i64 = 10): Option<i64> = {
		val value: i64 = match self {
			b'0'..=b'9' => (self - b'0') as i64
			b'a'..=b'z' => (self - b'a') as i64 + 10
			b'A'..=b'Z' => (self - b'A') as i64 + 10
			_ => return .None
		}
		return if value < radix then .Some(value) else .None
	}

	/// `a` to `z` as `A` to `Z`; any other byte as it is.
	pub fn toAsciiUpper(): u8 = if self.isAsciiLowercase() then self - 32 else self

	/// `A` to `Z` as `a` to `z`; any other byte as it is.
	pub fn toAsciiLower(): u8 = if self.isAsciiUppercase() then self + 32 else self
}

/// One character read from bytes: what it is, and how many bytes it took.
struct Decoded {
	code: u32
	width: i64
	valid: bool
}

extend str {
	/// The characters, one at a time, read as UTF-8.
	pub fn chars(): Chars = Chars::of(self)

	/// `a` to `z` as `A` to `Z`, and every other byte as it is: what a
	/// protocol or a format that is ASCII asks. Every script's capitals are
	/// `toUppercase`.
	pub fn toAsciiUpper(): String = {
		var out = String::withCapacity(self.len())
		for b in self {
			out.pushByte(b.toAsciiUpper())
		}
		return move out
	}

	/// `A` to `Z` as `a` to `z`, and every other byte as it is. Every
	/// script's small letters are `toLowercase`.
	pub fn toAsciiLower(): String = {
		var out = String::withCapacity(self.len())
		for b in self {
			out.pushByte(b.toAsciiLower())
		}
		return move out
	}

	/// Whether the bytes are UTF-8 throughout.
	pub fn isValidUtf8(): bool = {
		var at = 0
		while at < self.len() {
			val decoded = self.decodeAt(at)
			if !decoded.valid then return false
			at += decoded.width
		}
		return true
	}

	/// The character that begins at byte `at`, which is inside the text,
	/// and how many bytes it takes. Where the bytes there are not UTF-8, it
	/// is U+FFFD and one byte, so a reader always moves on.
	pub fn charAt(at: i64): (char, i64) = {
		val decoded = self.decodeAt(at)
		return (char::fromScalar(decoded.code), decoded.width)
	}

	/// `charAt`, with whether the bytes were UTF-8.
	fn decodeAt(at: i64): Decoded = {
		val invalid = Decoded(code: 0xFFFD, width: 1, valid: false)
		val first = self[at] as u32
		if first < 0x80 then return Decoded(code: first, width: 1, valid: true)
		// How many bytes follow, the value the lead byte holds, and the
		// range the next byte must be in: narrower where it would write a
		// number too small for its length, a surrogate, or past 10FFFF.
		var more = 0
		var code: u32 = 0
		var low: u32 = 0x80
		var high: u32 = 0xBF
		if first is 0xC2..=0xDF {
			more = 1
			code = first & 0x1F
		} else if first is 0xE0..=0xEF {
			more = 2
			code = first & 0x0F
			if first == 0xE0 then low = 0xA0 else if first == 0xED then high = 0x9F
		} else if first is 0xF0..=0xF4 {
			more = 3
			code = first & 0x07
			if first == 0xF0 then low = 0x90 else if first == 0xF4 then high = 0x8F
		} else {
			return invalid
		}
		// The bytes it needs run past the end.
		if at + more >= self.len() then return invalid
		for i in 1..more + 1 {
			val next = self[at + i] as u32
			if next < low || next > high then return invalid
			code = (code << 6) | (next & 0x3F)
			low = 0x80
			high = 0xBF
		}
		return Decoded(code: code, width: more + 1, valid: true)
	}
}

extend String {
	/// The characters, one at a time, read as UTF-8.
	pub fn chars(): Chars = self.toStr().chars()

	/// Whether the bytes are UTF-8 throughout.
	pub fn isValidUtf8(): bool = self.toStr().isValidUtf8()
}
