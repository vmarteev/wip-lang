// The logarithm to base 2 of an `f64`, ported from Arm's
// optimized-routines, which glibc and musl compute it with, on the path
// that needs no fused multiply-add, so that every machine gives one answer:
//
// Copyright (c) 2018-2025, Arm Limited.
// SPDX-License-Identifier: MIT OR Apache-2.0 WITH LLVM-exception
//
// From `math/log2.c`; within 0.55 ulp.
//
// As `ln` is, with a table of 64 parts: x = 2^k z, and log2 x is
// k + log2 c + log2(z/c), with r/ln2 taken to extra precision.

/// log2(x); -∞ at zero, NaN below it.
fn logarithm2(x: f64): f64 = {
	var ix = x.toBits()
	val top = (ix >> 48) as i64
	// 1 - 0x1.5b51p-5 <= x < 1 + 0x1.6ab2p-5: 0x3FEEA4AF00000000 to
	// 0x3FF0B55900000000.
	if ix -% 0x3FEEA4AF00000000 < 0x000210AA00000000 {
		val r = x - 1.0
		// r/ln2 as hi + lo, with r's top half, whose product is exact.
		val rhi = f64::fromBits(r.toBits() & 0xFFFFFFFF00000000)
		val rlo = r - rhi
		val hi = rhi * LOG2_INV_LN2_HI
		var lo = rlo * LOG2_INV_LN2_HI + r * LOG2_INV_LN2_LO
		val r2 = r * r
		val r4 = r2 * r2
		val p = r2 * (LOG2_POLY_NEAR_ONE[0] + r * LOG2_POLY_NEAR_ONE[1])
		var y = hi + p
		lo += hi - y + p
		lo +=
			r4 *
				(LOG2_POLY_NEAR_ONE[2] +
					r * LOG2_POLY_NEAR_ONE[3] +
					r2 * (LOG2_POLY_NEAR_ONE[4] + r * LOG2_POLY_NEAR_ONE[5]) +
					r4 *
						(LOG2_POLY_NEAR_ONE[6] +
							r * LOG2_POLY_NEAR_ONE[7] +
							r2 * (LOG2_POLY_NEAR_ONE[8] + r * LOG2_POLY_NEAR_ONE[9])))
		y += lo
		return y
	}
	// Below 2^-1022, infinite, or not a number.
	if top < 0x0010 || top >= 0x7ff0 {
		if ix << 1 == 0 then return f64::fromBits(0xFFF0000000000000)
		if ix == 0x7FF0000000000000 then return x
		if top & 0x8000 != 0 || top & 0x7ff0 == 0x7ff0 then return (x - x) / (x - x)
		// Subnormal: scaled up by 2^52, which k takes back.
		ix = (x * 4503599627370496.0).toBits() -% (52 << 52)
	}
	// x = 2^k z, z in [0.6875, 1.375)
	val tmp = ix -% 0x3FE6000000000000
	val i = ((tmp >> 46) & 63) as i64
	val k = (tmp as i64) >> 52
	val iz = ix -% (tmp & (0xfff << 52))
	val invc = f64::fromBits(LOG2_INVERSE[i])
	val logc = f64::fromBits(LOG2_LOG_C[i])
	val z = f64::fromBits(iz)
	val kd = k as f64
	// r = z/c - 1, with c in two parts, as a fused multiply-add would; and
	// r/ln2 as t1 + t2.
	val chi = f64::fromBits(LOG2_C_HI[i])
	val clo = f64::fromBits(LOG2_C_LO[i])
	val r = (z - chi - clo) * invc
	val rhi = f64::fromBits(r.toBits() & 0xFFFFFFFF00000000)
	val rlo = r - rhi
	val t1 = rhi * LOG2_INV_LN2_HI
	val t2 = rlo * LOG2_INV_LN2_HI + r * LOG2_INV_LN2_LO
	// hi + lo = r/ln2 + log2 c + k
	val t3 = kd + logc
	val hi = t3 + t1
	val lo = t3 - hi + t1 + t2
	// log2(1 + r) = r/ln2 + r² p(r)
	val r2 = r * r
	val r4 = r2 * r2
	val p =
		LOG2_POLY[0] +
		r * LOG2_POLY[1] +
		r2 * (LOG2_POLY[2] + r * LOG2_POLY[3]) +
		r4 * (LOG2_POLY[4] + r * LOG2_POLY[5])
	return lo + r2 * p + hi
}
