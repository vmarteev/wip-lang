// `Result<T, E>`, of the prelude: a value, or why there is none.
// Its name is reserved, as `Option`'s is, so `Result` means
// the same type in every program.

/// The result of something that can fail: `.Ok(value)` or `.Err(error)`.
/// The error is any type at all — an enum, a number, a string.
pub enum Result<T, E> {
	Ok(value: T)
	Err(error: E)

	/// Whether it holds a value.
	pub fn isOk(): bool = self is .Ok(..)
	/// Whether it holds an error.
	pub fn isErr(): bool = self is .Err(..)

	/// The value, or a panic when there is an error.
	pub move fn unwrap(): T = match move self {
		.Ok(value) => value
		.Err(error) => panic("unwrap of a Result that holds an error")
	}

	/// The value, or `default` when there is an error. `default` is
	/// evaluated either way; `unwrapOrElse` makes it only where it is
	/// needed.
	pub move fn unwrapOr(default: T): T = match move self {
		.Ok(value) => value
		.Err(error) => default
	}

	/// The value, or what `default` makes of the error, which it is called
	/// only where there is one.
	pub move fn unwrapOrElse(default: &var (error: E) => T): T = match move self {
		.Ok(value) => value
		.Err(error) => default(error)
	}

	/// This result if it has a value, and `alternative` otherwise. Both are
	/// evaluated; `orElse` makes the alternative only where it is needed.
	pub move fn or(alternative: Result<T, E>): Result<T, E> =
		if self.isOk() then self else alternative

	/// This result if it has a value, and what `alternative` makes of the
	/// error otherwise, which it is called only then to make.
	pub move fn orElse(
		alternative: &var (error: E) => Result<T, E>,
	): Result<T, E> = match move self {
		.Ok(value) => .Ok(value)
		.Err(error) => alternative(error)
	}

	/// The value, made into another by `f`; an error stays as it is.
	pub move fn map<U>(f: &(value: T) => U): Result<U, E> = match move self {
		.Ok(value) => .Ok(f(value))
		.Err(error) => .Err(error)
	}

	/// The error, made into another by `f`; a value stays as it is.
	pub move fn mapErr<F>(f: &(error: E) => F): Result<T, F> = match move self {
		.Ok(value) => .Ok(value)
		.Err(error) => .Err(f(error))
	}

	/// Every value `results` hands out, in order, or the first error, after
	/// which nothing more is asked of it: what `?` does for one result, for
	/// many. `Result::collect(lines.walk().map(own (line) => line.toInt()))`.
	pub static fn collect<I: Iterator<Result<T, E>>>(results: I): Result<Vec<T>, E> = {
		var values: Vec<T> = Vec()
		for result in move results {
			match move result {
				.Ok(value) => values.push(value)
				.Err(error) => return .Err(error)
			}
		}
		return .Ok(values)
	}

	/// What `f` answers for the value; an error stays as it is.
	pub move fn flatMap<U>(f: &(value: T) => Result<U, E>): Result<U, E> = match move self {
		.Ok(value) => f(value)
		.Err(error) => .Err(error)
	}

	/// `f` of the value, or `ifErr` of the error.
	pub move fn fold<U>(ifErr: &(error: E) => U, f: &(value: T) => U): U = match move self {
		.Ok(value) => f(value)
		.Err(error) => ifErr(error)
	}

	/// Whether there is a value and `test` answers true for it.
	pub fn any(test: &(value: &T) => bool): bool = match self {
		.Ok(value) => test(&value)
		.Err(error) => false
	}

	/// Whether `test` answers true for the value, or there is an error.
	pub fn all(test: &(value: &T) => bool): bool = match self {
		.Ok(value) => test(&value)
		.Err(error) => true
	}

	/// `f` of the value, where there is one.
	pub fn forEach(f: &(value: &T) => void) = match self {
		.Ok(value) => f(&value)
		.Err(error) => {}
	}

	/// The value, if there is one, without the error.
	pub move fn toOption(): Option<T> = match move self {
		.Ok(value) => .Some(value)
		.Err(error) => .None
	}

	/// The error and the value the other way round.
	pub move fn swap(): Result<E, T> = match move self {
		.Ok(value) => .Err(value)
		.Err(error) => .Ok(error)
	}

	/// A result of a result, without the outer one.
	pub static fn flatten(result: Result<Result<T, E>, E>): Result<T, E> = match move result {
		.Ok(inner) => inner
		.Err(error) => .Err(error)
	}
}
