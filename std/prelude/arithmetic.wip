// The operators a type answers: `a + b` on a type a
// program declares is `a.add(&b)`, and so on for the rest. What is on the
// other side, and what the answer is, are the interface's arguments, the
// type itself where they are left out: `extend Money: Add` is
// `Add<Money, Money>`, and `extend Vec2: Multiply<f32>` scales a vector.
// `a op b` asks the type of `a` for the implementation
// whose `Rhs` is the type of `b`, and answers its `Out`.
//
// A built-in type's operators are the machine's: `i64 + i64` is an
// instruction, whatever is implemented. The prelude implements them for
// every number all the same, each answered by the operator itself and
// checked as it is, so that code generic over numbers can use them: `fn
// total<T: Add + Zero>`. `%` on a float is C's `fmod`, written in Wip.
// `a += b` is `a = a + b`, so a type that adds has compound assignment too.

/// `a + b`.
pub interface Add<Rhs = Self, Out = Self> {
	fn add(other: &Rhs): Out
}

/// `a - b`.
pub interface Subtract<Rhs = Self, Out = Self> {
	fn subtract(other: &Rhs): Out
}

/// `a * b`.
pub interface Multiply<Rhs = Self, Out = Self> {
	fn multiply(other: &Rhs): Out
}

/// `a / b`.
pub interface Divide<Rhs = Self, Out = Self> {
	fn divide(other: &Rhs): Out
}

/// `a % b`.
pub interface Remainder<Rhs = Self, Out = Self> {
	fn remainder(other: &Rhs): Out
}

/// `-x`.
pub interface Negate {
	fn negate(): Self
}

/// `!x`.
pub interface Not {
	fn not(): Self
}

/// What adding starts from: `x + T::zero()` is `x`. A vector has one, and
/// a sum of nothing is it.
pub interface Zero {
	static fn zero(): Self
}

/// What multiplying starts from: `x * T::one()` is `x`. A product of
/// nothing is it.
pub interface One {
	static fn one(): Self
}

// Each number answers each operator with itself, as the instruction does.

extend i8: Add {
	fn add(other: &i8): i8 = self + other
}

extend i8: Subtract {
	fn subtract(other: &i8): i8 = self - other
}

extend i8: Multiply {
	fn multiply(other: &i8): i8 = self * other
}

extend i8: Divide {
	fn divide(other: &i8): i8 = self / other
}

extend i8: Remainder {
	fn remainder(other: &i8): i8 = self % other
}

extend i8: Negate {
	fn negate(): i8 = -self
}

extend i8: Zero {
	static fn zero(): i8 = 0
}

extend i8: One {
	static fn one(): i8 = 1
}

