// The runtime's own on a Unix: what C's `main` calls first, and the calls
// that led to a panic, as C's unwinder walks them.

import std::libc

/// What C's `main` calls before the program's: nothing on a Unix, whose
/// streams are bytes as they come.
@export("C")
fn wip_start() = {}

/// The address each call that led here returns to, innermost first, as C's
/// unwinder walks them, into `frames` while there is room. Spliced where it
/// is called, so that the first is its caller's.
@inline
fn collectFrames(frames: &var Frames) = {
	libc::_Unwind_Backtrace(noteFrame, addressOf<Frames>(&var frames))
}

/// What the unwinder calls for each frame, with the `Frames` it was given.
fn noteFrame(context: ptr<void>, state: ptr<void>): c_int = note(
	&var referenceAt<Frames>(state),
	libc::_Unwind_GetIP(context) as i64,
)
