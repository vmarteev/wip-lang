/// 1/ln2, in a part of 32 bits.
val LOG2_INV_LN2_HI: f64 = 1.4426950407214463

/// What that part leaves out.
val LOG2_INV_LN2_LO: f64 = 1.6751713164886512e-10

/// log2(1 + r) ≈ r/ln2 + r²·(A0 + r·A1 + r²·(A2 + r·A3) + r⁴·(A4 + r·A5)).
val LOG2_POLY: [f64; 6] = [
	-0.7213475204444882, 0.4808983469629985, -0.36067375954075914, 0.2885390073180969,
	-0.2404693555628422, 0.2061202382173603,
]

