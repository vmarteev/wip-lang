// `String`, of the prelude: text that owns its bytes. A
// `str` is a view of bytes that live somewhere else, so it cannot be built,
// only looked at; a `String` is where bytes are put, and it is a `Vec<u8>`
// with the operations text wants.

import std::libc

/// Text that owns its bytes, and grows.
/// `String()` is the empty text, which takes no memory until something is
/// pushed.
pub struct String {
	bytes: Vec<u8> = Vec()
}

extend String {
	/// A `String` whose bytes are `text`'s own, made where a `&String` is
	/// taken and a `str` is given. The compiler never drops it: what it
	/// holds is not its own to free.
	static fn over(text: str): String = String(Vec(
		slots: Slots<u8>::over(&text.items()),
		length: text.len(),
	))

	/// The empty text, with room for `count` bytes.
	pub static fn withCapacity(count: i64): String = String(Vec::withCapacity(count))

	/// A `String` that holds a copy of `text`, which is how a `str` becomes
	/// a value that can be kept.
	pub static fn of(text: str): String = {
		var made = String::withCapacity(text.len())
		made.push(text)
		return move made
	}

	/// The text, as bytes that live in this `String`. It is a view: what it
	/// points at ends when the `String` does, or changes when it does.
	pub fn toStr(): str = str::fromBytes(&self.bytes)

	/// How many bytes the text is, not how many characters.
	pub fn len(): i64 = self.bytes.len()

	/// Whether the text has no bytes.
	pub fn isEmpty(): bool = self.bytes.len() == 0

	/// One byte, at the end.
	pub var fn pushByte(byte: u8) = self.bytes.push(byte)

	/// The text, at the end.
	pub var fn push(text: str) = self.pushBytes(&text)

	/// The bytes, as they are. It is what a module that reads them uses to
	/// build text.
	pub var fn pushBytes(bytes: &[u8]) = self.bytes.pushAll(bytes)

	/// `true` or `false`, at the end.
	pub var fn pushBool(value: bool) = self.push(if value then "true" else "false")

	/// The character, in the one to four bytes UTF-8 writes it in.
	pub var fn pushChar(c: char) = {
		val code = c as u32
		if code < 0x80 {
			self.bytes.push(code as u8)
		} else if code < 0x800 {
			self.bytes.push((0xC0 | (code >> 6)) as u8)
			self.bytes.push((0x80 | (code & 0x3F)) as u8)
		} else if code < 0x10000 {
			self.bytes.push((0xE0 | (code >> 12)) as u8)
			self.bytes.push((0x80 | ((code >> 6) & 0x3F)) as u8)
			self.bytes.push((0x80 | (code & 0x3F)) as u8)
		} else {
			self.bytes.push((0xF0 | (code >> 18)) as u8)
			self.bytes.push((0x80 | ((code >> 12) & 0x3F)) as u8)
			self.bytes.push((0x80 | ((code >> 6) & 0x3F)) as u8)
			self.bytes.push((0x80 | (code & 0x3F)) as u8)
		}
	}

	/// The number, written in decimal. The digits are counted out in
	/// negatives, so that the smallest `i64` — which has no positive of its
	/// own — is written like any other.
	pub var fn pushInt(value: i64) = {
		if value < 0 then self.pushByte('-' as u8)
		var digits = [0 as u8; 20]
		var count = 0
		var rest = if value < 0 then value else -value
		while true {
			digits[count] = ('0' as u8 as i64 - rest % 10) as u8
			rest = rest / 10
			count += 1
			if rest == 0 then break
		}
		self.pushDigits(&digits[0..count])
	}

	/// The number, written in decimal, where it has no sign to write.
	pub var fn pushUnsigned(value: u64) = {
		var digits = [0 as u8; 20]
		var count = 0
		var rest = value
		while true {
			digits[count] = '0' as u8 + (rest % 10) as u8
			rest = rest / 10
			count += 1
			if rest == 0 then break
		}
		self.pushDigits(&digits[0..count])
	}

	/// Digits counted out from the last, written from the first.
	var fn pushDigits(backwards: &[u8]) = {
		var i = backwards.len()
		while i > 0 {
			i -= 1
			self.pushByte(backwards[i])
		}
	}

	/// The float, as C's `%g` writes it, with as many digits as it takes to
	/// read back as the same `f64`, and six at the least: `0.1`, `1e+20`,
	/// `0.30000000000000004`.
	pub var fn pushFloat(value: f64) = self.pushFewestDigits(value, false)

	/// An `f32` the same way, with the digits it takes to read back as the
	/// same `f32`, which are at most 9.
	var fn pushFloat32(value: f32) = self.pushFewestDigits(value as f64, true)

	/// `%.6g`, `%.7g` and on, until what is written reads back as `value`:
	/// 17 digits always do for an `f64`, and 9 for an `f32`. Six or fewer
	/// are written as `%g` always wrote them, but for a value written with
	/// an exponent that fewer still read back as: a subnormal's.
	var fn pushFewestDigits(value: f64, single: bool) = {
		val most = if single then 9 else 17
		var digits = [0 as u8; 32]
		for precision in 6..most + 1 {
			var written = formatG(value, precision, &var digits)
			if !(readsBack(&digits, value, single) || !value.isFinite() || precision == most) then
				continue
			// Six digits written with an exponent may be more than the value
			// has: a subnormal keeps fewer bits, and `5e-324` reads back as
			// well as `4.94066e-324`. Fewer digits than six cannot move the
			// exponent to a point, so the first of them that reads back is
			// shorter text of the same kind.
			if precision == 6 && value.isFinite() && digits[0..written].contains(b'e') {
				for fewer in 1..6 {
					val shorter = formatG(value, fewer, &var digits)
					if readsBack(&digits, value, single) {
						self.pushBytes(&digits[0..shorter])
						return
					}
				}
				written = formatG(value, precision, &var digits)
			}
			self.pushBytes(&digits[0..written])
			return
		}
	}

	/// The text with a NUL after it, which is what C calls a string.
	/// The NUL goes past the end, so the `String`'s own
	/// length does not count it; what comes back borrows these bytes, and
	/// lasts until the `String` is changed or ends.
	pub var fn toCstring(): cstring = {
		self.bytes.push(0)
		self.bytes.length -= 1
		return cstring::fromBytes(&self.bytes)
	}

	/// Empties the text, keeping its memory.
	pub var fn clear() = self.bytes.clear()

	/// `count` copies of `c` put in at byte `at`, which is where a
	/// character begins or the end, the bytes after it moving along; for
	/// the width of an interpolation's piece. Nothing is
	/// made but the room.
	var fn insertCopies(at: i64, c: char, count: i64) = {
		if count <= 0 then return
		val old = self.bytes.len()
		for _ in 0..count {
			self.pushChar(c)
		}
		val added = self.bytes.len() - old
		val width = added / count
		// One copy's bytes, kept while the ones after `at` move along.
		var copy = [0 as u8; 4]
		for i in 0..width {
			copy[i] = self.bytes[old + i]
		}
		var from = old - 1
		while from >= at {
			self.bytes[from + added] = self.bytes[from]
			from -= 1
		}
		for i in 0..added {
			self.bytes[at + i] = copy[i % width]
		}
	}

	/// The last character taken off, or nothing where the text is empty,
	/// as `Vec::pop` takes an element. The `String` keeps
	/// its memory. Where its last bytes are not a character's, the last
	/// byte is taken, as U+FFFD, which is what reading the text finds
	/// there.
	pub var fn popChar(): Option<char> = {
		val length = self.bytes.len()
		if length == 0 then return .None
		// A character is at most four bytes, all but the first of the form
		// `10xxxxxx`.
		var start = length - 1
		while start > 0 && length - start < 4 && (self.bytes[start] & 0xC0) == 0x80 {
			start -= 1
		}
		val (c, width) = self.toStr().charAt(start)
		if start + width != length {
			self.bytes.truncate(length - 1)
			return .Some('\u{FFFD}')
		}
		self.bytes.truncate(start)
		return .Some(c)
	}
}

// The bytes it holds, so that `for byte in text` walks them.
extend String: Items<u8> {
	fn items(): &[u8] = lend self.bytes.items()
}

// Text made from text: each occurrence of a pattern replaced, the whole
// repeated. Each is a new `String`, which a `str` and a `String` both make.
extend str {
	/// The text with each occurrence of `pattern` replaced by `by`, left to
	/// right, none overlapping another: `"a-b-c".replace("-", by: "+")` is
	/// `a+b+c`. `count: .Some(n)` replaces the first `n` alone,
	/// `"a-b-c".replace("-", by: "+", count: .Some(1))` being `a+b-c`. An
	/// empty pattern panics: there is no occurrence of nothing that is not
	/// also a choice of where. So does a count below 0.
	pub fn replace(pattern: str, by: str, count: Option<i64> = .None): String = {
		if pattern.isEmpty() then
			panic("an empty pattern occurs everywhere, so nothing says where to replace it")
		if count is .Some(n) && n < 0 then panic("a count of replacements is 0 or more, not \(n)")
		// No text holds more occurrences than it has bytes.
		val most = count.unwrapOr(self.len())
		var out = String::withCapacity(self.len())
		var at = 0
		var replaced = 0
		while replaced < most && self[at..self.len()].find(pattern) is .Some(found) {
			out.push(self[at..at + found])
			out.push(by)
			at += found + pattern.len()
			replaced += 1
		}
		out.push(self[at..self.len()])
		return move out
	}

	/// The text `times` times over: `"ab".repeat(3)` is `ababab`, and no
	/// times is the empty text. A negative count panics.
	pub fn repeat(times: i64): String = {
		if times < 0 then panic("text is repeated 0 or more times, not \(times)")
		var out = String::withCapacity(self.len() * times)
		for _ in 0..times {
			out.push(self)
		}
		return move out
	}
}

/// `value` written by C's `%.<precision>g` into `digits`, with a NUL after
/// it; answers how many bytes before the NUL.
fn formatG(value: f64, precision: i64, digits: &var [u8; 32]): i64 = {
	var format = [0 as u8; 8]
	format[0] = '%' as u8
	format[1] = '.' as u8
	var at = 2
	if precision >= 10 {
		format[at] = '1' as u8
		at += 1
	}
	format[at] = '0' as u8 + (precision % 10) as u8
	format[at + 1] = 'g' as u8
	return libc::formatDouble(value, cstring::fromBytes(&format), &var digits)
}

/// Whether the digits `formatG` wrote read back as `value`, as an `f32`'s
/// where `single`.
fn readsBack(digits: &[u8; 32], value: f64, single: bool): bool = {
	val text = cstring::fromBytes(&digits)
	val back = if single then libc::strtof(text, null) as f64 else libc::strtod(text, null)
	return back == value
}
