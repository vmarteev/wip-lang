// Walking: a container lends its elements as a slice, and
// `for x in c` walks that slice.
//
// One method is the whole protocol, and what it hands out is an ordinary
// `&[T]`: everything written for a slice — searching, slicing, passing it
// on — works on any container that implements this. A container whose
// elements do not lie one after another cannot implement it, and waits for
// a protocol of its own.

/// A container that lends its elements as a slice, which `for` walks.
pub interface Items<T> {
	/// The elements, lent where they lie. It is a projection, so what the
	/// loop visits belongs to the container.
	fn items(): &[T]
}
