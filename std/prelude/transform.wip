// What a slice makes from its elements: another vector, a
// value, a part of itself, a text. The vocabulary of Scala's collections,
// eager, where an iterator's adapters are lazy: what a
// method here answers is there when it answers.
//
// A function given to these is lent for the call, so it may read anything
// around it. What reads an element is lent it; what keeps elements — a
// filtered vector, the smallest — copies them, so it is there for plain
// data, and a vector of values that own memory keeps what it wants in
// place with `retain`. What finds one element answers it by reference, for
// any element. A `Vec` does all of it, by the same names.

extend [T] {
	/// Each element, as `f` makes it into another: `[1, 2, 3].map((n) => n
	/// * 10)` is `[10, 20, 30]`.
	pub fn map<U>(f: &(x: &T) => U): Vec<U> = {
		var made: Vec<U> = Vec::withCapacity(self.len())
		for x in self {
			made.push(f(&x))
		}
		return move made
	}

	/// What `f` makes of each element, one after another in one vector.
	pub fn flatMap<U>(f: &(x: &T) => Vec<U>): Vec<U> = {
		var made: Vec<U> = Vec()
		for x in self {
			// Moved out from the back, so turned round first.
			var part = f(&x)
			part.reverse()
			while true {
				val .Some(y) = part.pop() else {
					break
				}
				made.push(move y)
			}
		}
		return move made
	}

	/// `start`, and then `f` of what it has so far and each element, from
	/// the first: `numbers.fold(0, (sum, n) => sum + n)`.
	pub fn fold<A>(start: A, f: &(sofar: A, x: &T) => A): A = {
		var sofar = move start
		for x in self {
			sofar = f(move sofar, &x)
		}
		return move sofar
	}

	/// Where the first element `test` answers true for is, or nothing.
	pub fn indexWhere(test: &(x: &T) => bool): Option<i64> = {
		for i in 0..self.len() {
			if test(&self[i]) then return .Some(i)
		}
		return .None
	}

	/// Where the last element `test` answers true for is, or nothing.
	pub fn lastIndexWhere(test: &(x: &T) => bool): Option<i64> = {
		var i = self.len() - 1
		while i >= 0 {
			if test(&self[i]) then return .Some(i)
			i -= 1
		}
		return .None
	}

	/// The first `count` elements, or all of them where there are fewer: a
	/// part of this slice, not a copy of it.
	pub fn take(count: i64): &[T] = lend self[0..count.max(0).min(self.len())]

	/// The elements after the first `count`, or none where there are fewer:
	/// a part of this slice, not a copy of it.
	pub fn skip(count: i64): &[T] = lend self[count.max(0).min(self.len())..self.len()]

	/// The first element `test` answers true for, by reference, or nothing.
	pub fn find(test: &(x: &T) => bool): Option<&T> = {
		for x in self {
			if test(&x) then return .Some(&x)
		}
		return .None
	}

	/// The element whose key is least, by reference, the first of equals;
	/// nothing where there is none.
	pub fn minBy<K: Ord>(key: &(x: &T) => K): Option<&T> = {
		var best: Option<&T> = .None
		var least: Option<K> = .None
		for x in self {
			val k = key(&x)
			if least is .Some(l) && !(k < l) then continue
			best = .Some(&x)
			least = .Some(move k)
		}
		return best
	}

	/// The element whose key is greatest, by reference, the first of
	/// equals; nothing where there is none.
	pub fn maxBy<K: Ord>(key: &(x: &T) => K): Option<&T> = {
		var best: Option<&T> = .None
		var greatest: Option<K> = .None
		for x in self {
			val k = key(&x)
			if greatest is .Some(g) && !(k > g) then continue
			best = .Some(&x)
			greatest = .Some(move k)
		}
		return best
	}

	/// The first element, by reference, or nothing where there is none.
	pub fn first(): Option<&T> = if self.isEmpty() then .None else .Some(&self[0])

	/// The last element, by reference, or nothing where there is none.
	pub fn last(): Option<&T> = if self.isEmpty() then .None else .Some(&self[self.len() - 1])
}

// Elements that are plain data are copied into what is kept.
extend [T: copy] {
	/// The elements `keep` answers true for, in their order.
	pub fn filter(keep: &(x: &T) => bool): Vec<T> = {
		var kept: Vec<T> = Vec()
		for x in self {
			if keep(&x) then kept.push(x)
		}
		return move kept
	}

	/// The elements `test` answers true for, and the rest, each in their
	/// order.
	pub fn partition(test: &(x: &T) => bool): (Vec<T>, Vec<T>) = {
		var yes: Vec<T> = Vec()
		var no: Vec<T> = Vec()
		for x in self {
			if test(&x) then yes.push(x) else no.push(x)
		}
		return (move yes, move no)
	}
}

extend [T: Add + Zero + copy] {
	/// The elements added up: zero where there are none.
	pub fn sum(): T = {
		var total = T::zero()
		for x in self {
			total = total + x
		}
		return total
	}
}

extend [T: Multiply + One + copy] {
	/// The elements multiplied together: one where there are none.
	pub fn product(): T = {
		var total = T::one()
		for x in self {
			total = total * x
		}
		return total
	}
}

extend [T: Ord + copy] {
	/// The smallest element, or nothing where there is none.
	pub fn min(): Option<T> = match self.minIndex() {
		.Some(i) => .Some(self[i])
		.None => .None
	}

	/// The largest element, or nothing where there is none.
	pub fn max(): Option<T> = match self.maxIndex() {
		.Some(i) => .Some(self[i])
		.None => .None
	}
}

extend [T: Text] {
	/// The elements written as text, with `separator` between each two:
	/// `["a", "b"].join(", ")` is `a, b`.
	pub fn join(separator: str): String = {
		var out = String()
		self.joinTo(&var out, separator)
		return move out
	}

	/// The elements written as text onto `out`, with `separator` between
	/// each two: what `join` makes, without a `String` of its own.
	pub fn joinTo(out: &var String, separator: str) = self.joinToBy(&var out, separator, (
		x,
		out,
	) => x.appendTo(&var out))
}

// Elements that clone are cloned into a vector of their own.
extend [T: Clone] {
	/// The elements, each cloned, in a new vector: a part of one,
	/// `names.skip(1).toVec()`, or a set's keys, `seen.items().toVec()`.
	pub fn toVec(): Vec<T> = self.map((x) => x.clone())
}

// A vector does what the slice it lends does, by the same names.
extend Vec<T> {
	/// Each element, as `f` makes it into another.
	pub fn map<U>(f: &(x: &T) => U): Vec<U> = self.items().map(f)

	/// What `f` makes of each element, one after another in one vector.
	pub fn flatMap<U>(f: &(x: &T) => Vec<U>): Vec<U> = self.items().flatMap(f)

	/// `start`, and then `f` of what it has so far and each element.
	pub fn fold<A>(start: A, f: &(sofar: A, x: &T) => A): A = self.items().fold(move start, f)

	/// Where the first element `test` answers true for is, or nothing.
	pub fn indexWhere(test: &(x: &T) => bool): Option<i64> = self.items().indexWhere(test)

	/// Where the last element `test` answers true for is, or nothing.
	pub fn lastIndexWhere(test: &(x: &T) => bool): Option<i64> = self.items().lastIndexWhere(test)

	/// The first `count` elements, or all of them where there are fewer.
	pub fn take(count: i64): &[T] = lend self.items()[0..count.max(0).min(self.len())]

	/// The elements after the first `count`, or none where there are fewer.
	pub fn skip(count: i64): &[T] = lend self.items()[count.max(0).min(self.len())..self.len()]

	/// The first element `test` answers true for, by reference, or nothing.
	pub fn find(test: &(x: &T) => bool): Option<&T> = self.items().find(test)

	/// The element whose key is least, by reference, the first of equals;
	/// nothing where there is none.
	pub fn minBy<K: Ord>(key: &(x: &T) => K): Option<&T> = self.items().minBy(key)

	/// The element whose key is greatest, by reference, the first of
	/// equals; nothing where there is none.
	pub fn maxBy<K: Ord>(key: &(x: &T) => K): Option<&T> = self.items().maxBy(key)

	/// The first element, by reference, or nothing where there is none.
	pub fn first(): Option<&T> = self.items().first()

	/// The last element, by reference, or nothing where there is none.
	pub fn last(): Option<&T> = self.items().last()
}

extend Vec<T: copy> {
	/// The elements `keep` answers true for, in their order.
	pub fn filter(keep: &(x: &T) => bool): Vec<T> = self.items().filter(keep)

	/// The elements `test` answers true for, and the rest.
	pub fn partition(test: &(x: &T) => bool): (Vec<T>, Vec<T>) = self.items().partition(test)
}

extend Vec<T: Add + Zero + copy> {
	/// The elements added up: zero where there are none.
	pub fn sum(): T = self.items().sum()
}

extend Vec<T: Multiply + One + copy> {
	/// The elements multiplied together: one where there are none.
	pub fn product(): T = self.items().product()
}

extend Vec<T: Ord + copy> {
	/// The smallest element, or nothing where there is none.
	pub fn min(): Option<T> = self.items().min()

	/// The largest element, or nothing where there is none.
	pub fn max(): Option<T> = self.items().max()
}

extend Vec<T: Text> {
	/// The elements written as text, with `separator` between each two.
	pub fn join(separator: str): String = self.items().join(separator)

	/// The elements written as text onto `out`, with `separator` between
	/// each two.
	pub fn joinTo(out: &var String, separator: str) = self.items().joinTo(&var out, separator)
}
