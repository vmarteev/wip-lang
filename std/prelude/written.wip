// A number written otherwise than its own text writes it: a float with so
// many digits after its point, an integer in another radix. They are what
// `"\(seconds, precision: 3)"` and `"\(byte, radix: 16)"` write, and what
// `withPrecision` and `inRadix` answer, for a program that writes one
// itself. Each is a number for `width`, `fill` and `align`: it goes right,
// and zeros go after its sign.

import std::libc

/// A float, written with so many digits after its point.
pub struct WithPrecision {
	value: f64
	digits: i64
}

/// An integer, written in a radix from 2 to 36: its magnitude, its digits
/// above 9 in lower case or in upper, after a `-` where it is negative, as
/// `toInt(radix:)` reads it back.
pub struct InRadix {
	magnitude: u128
	negative: bool
	radix: i64
	upper: bool
}

extend InRadix {
	/// A signed integer. The smallest `i128` has no positive of its own, so
	/// its magnitude is counted one short and made up.
	static fn signed(value: i128, radix: i64, upper: bool): InRadix = InRadix(
		magnitude: if value < 0 then (-(value + 1)) as u128 + 1 else value as u128,
		negative: value < 0,
		radix: radix,
		upper: upper,
	)

	/// An unsigned integer.
	static fn unsigned(value: u128, radix: i64, upper: bool): InRadix = InRadix(
		magnitude: value,
		negative: false,
		radix: radix,
		upper: upper,
	)
}

extend WithPrecision: Text {
	fn alignsRight(): bool = true

	/// The value the float holds exactly, rounded once to `digits` after
	/// its point, a tie to the even digit: what C's `%.3f` writes, and it is
	/// C that writes it. An infinity and a NaN are written as they always
	/// are, and no digits writes no point.
	fn appendTo(out: &var String) = {
		if !self.value.isFinite() then return out.pushFloat(self.value)
		if self.digits < 0 then panic("a precision is 0 or more digits, not \(self.digits)")
		var format = String::of("%.")
		format.pushInt(self.digits)
		format.push("f")
		// The largest float has 309 digits before its point.
		var written: Vec<u8> = Vec::filled(self.digits + 312, 0)
		val length = libc::formatDouble(self.value, format.toCstring(), &var written)
		out.pushBytes(&written.items()[0..length])
	}
}

extend InRadix: Text {
	fn alignsRight(): bool = true

	fn appendTo(out: &var String) = {
		if self.radix < 2 || self.radix > 36 then
			panic("a radix is from 2 to 36, not \(self.radix)")
		if self.negative then out.pushByte('-' as u8)
		// A `u128` in binary, the most digits any radix needs.
		var digits = [0 as u8; 128]
		var count = 0
		var rest = self.magnitude
		val radix = self.radix as u128
		while true {
			val digit = (rest % radix) as u8
			val ten = if self.upper then 'A' as u8 else 'a' as u8
			digits[count] = if digit < 10 then '0' as u8 + digit else ten + digit - 10
			rest = rest / radix
			count += 1
			if rest == 0 then break
		}
		out.pushDigits(&digits[0..count])
	}
}

extend f64 {
	/// The number, to be written with `digits` digits after its point.
	pub fn withPrecision(digits: i64): WithPrecision = WithPrecision(value: self, digits: digits)
}

extend f32 {
	/// The number, to be written with `digits` digits after its point.
	pub fn withPrecision(digits: i64): WithPrecision = WithPrecision(
		value: self as f64,
		digits: digits,
	)
}

extend i8 {
	/// The number, to be written in `radix`, its digits above 9 in upper
	/// case where `upper` says so.
	pub fn inRadix(radix: i64, upper: bool = false): InRadix = InRadix::signed(
		self as i128,
		radix,
		upper,
	)
}

extend i16 {
	/// The number, to be written in `radix`, its digits above 9 in upper
	/// case where `upper` says so.
	pub fn inRadix(radix: i64, upper: bool = false): InRadix = InRadix::signed(
		self as i128,
		radix,
		upper,
	)
}

