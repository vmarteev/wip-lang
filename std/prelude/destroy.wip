// A type that cleans up after itself. The compiler calls `destroy` where a
// value ends — at the end of its scope, at a reassignment, when a temporary's
// statement ends, and as part of ending whatever holds it — and then ends its
// fields, last first.
//
// A type that implements it is never copied, since exactly one owner runs
// exactly one `destroy`, and a program may not call the method itself.

/// What a value does where it ends, before its fields end.
pub interface Destroy {
	var fn destroy()
}

/// Ends a value early: it is moved in, and nothing is done with it, so it
/// ends where this call is. `destroy(move file)` is how a program closes
/// something before its scope ends.
pub fn destroy<T>(value: T) = {
	val ended = move value
}
