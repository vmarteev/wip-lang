// Collecting: a collection made from what an iterator hands out, one
// element at a time. Each of the library's collections implements it, and
// a list written where one is expected is made through it.

/// What can be made from what an iterator hands out, one at a time, kept
/// in the order they come: `val seen: Set<i64> = .collect(ids.copies())`.
/// A list written where such a type is expected, `val seen: Set<i64> = [1,
/// 2]`, is its `collect` of the list's elements.
pub interface Collect<T> {
	/// A collection of the elements `items` hands out.
	static fn collect<I: Iterator<T>>(items: I): Self
}
