// A slice's elements, copied out one at a time: what `values.copies()`
// answers, so a slice of plain data can go through the adapters. The method
// is the prelude's; the type is here, to be imported where a program keeps
// one.

/// A slice's elements, copied out one at a time: what `values.copies()`
/// answers. Its elements are plain data, which it hands out as copies;
/// `forwards()` lends any.
pub view struct Copies<T: copy> {
	values: &[T]
	at: i64
}

extend Copies<T> {
	/// What `values.copies()` makes: the elements from the first.
	pub static fn of(values: &[T]): Copies<T> = Copies(values: &values, at: 0)
}

extend Copies<T>: Iterator<T> {
	var fn next(): Option<T> = {
		if self.at >= self.values.len() then return .None
		self.at += 1
		return .Some(self.values[self.at - 1])
	}
}
