// A slice's elements from the first to the last, each lent where it lies:
// what `values.forwards()` answers. The method is the prelude's; the type is
// here, to be imported where a program keeps one, as `Walk` is.

/// A slice's elements from the first to the last, each lent where it lies:
/// what `values.forwards()` answers. A list of what owns memory is walked
/// as one of numbers is, since nothing is copied.
pub view struct Forwards<T> {
	values: &[T]
	at: i64
}

extend Forwards<T> {
	/// What `values.forwards()` makes: the elements from the first.
	pub static fn of(values: &[T]): Forwards<T> = Forwards(values: &values, at: 0)
}

extend Forwards<T>: Iterator<&T> {
	var fn next(): Option<&T> = {
		if self.at >= self.values.len() then return .None
		self.at += 1
		return .Some(&self.values[self.at - 1])
	}
}
