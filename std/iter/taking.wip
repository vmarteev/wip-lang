// A vector's elements given up to a loop: what `for x in
// move v` walks, and what a `Set` and a `Map` hand their keys and entries
// over in. The method is the prelude's, `intoIterator()`; the type is
// here, to be imported where a program keeps one. It holds the vector's
// block, which only the standard library may name.

/// A vector's elements, taken from the front one at a time, each the
/// taker's to keep. What is not taken when it ends — a loop that stopped
/// early — is dropped with it.
pub struct Taking<T> {
	slots: Slots<T>
	// The slot taken next; those before it hold nothing.
	taken: i64
	length: i64
}

extend Taking<T> {
	/// The first `length` of `slots`, which hold values, to be taken.
	pub static fn of(slots: Slots<T>, length: i64): Taking<T> = Taking(
		slots: move slots,
		taken: 0,
		length: length,
	)
}

extend Taking<T>: Iterator<T> {
	var fn next(): Option<T> = {
		if self.taken == self.length then return .None
		self.taken += 1
		return .Some(self.slots.moveOut(self.taken - 1))
	}
}

extend Taking<T>: Destroy {
	var fn destroy() = {
		while self.taken < self.length {
			val left = self.slots.moveOut(self.taken)
			self.taken += 1
		}
	}
}
