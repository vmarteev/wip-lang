// A slice's elements from the last to the first: what
// `values.backwards()` answers. The method is the prelude's; the type is
// here, to be imported where a program keeps one, as `Walk` is.

/// A slice's elements from the last to the first, each lent where it lies:
/// what `values.backwards()` answers. A list of what owns memory is walked
/// as one of numbers is, since nothing is copied.
pub view struct Backwards<T> {
	values: &[T]
	left: i64
}

extend Backwards<T> {
	/// What `values.backwards()` makes: the elements from the last.
	pub static fn of(values: &[T]): Backwards<T> = Backwards(values: &values, left: values.len())
}

extend Backwards<T>: Iterator<&T> {
	var fn next(): Option<&T> = {
		if self.left == 0 then return .None
		self.left -= 1
		return .Some(&self.values[self.left])
	}
}
