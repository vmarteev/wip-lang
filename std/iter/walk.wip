// A slice's elements, one at a time: what `values.walk()` answers, so a slice
// can go through the adapters. The method is the prelude's; the type is here,
// to be imported where a program keeps one.

/// A slice's elements, one at a time: what `values.walk()` answers. Its
/// elements are plain data, which it hands out as copies.
pub view struct Walk<T: copy> {
	values: &[T]
	at: i64
}

extend Walk<T> {
	/// What `values.walk()` makes: the elements from the first.
	pub static fn of(values: &[T]): Walk<T> = Walk(values: &values, at: 0)
}

extend Walk<T>: Iterator<T> {
	var fn next(): Option<T> = {
		if self.at >= self.values.len() then return .None
		self.at += 1
		return .Some(self.values[self.at - 1])
	}
}
