// What the adapters of `Iterator` answer: each holds the iterator it was made
// from and what it was given. The methods that make them, `it.map(f)` and the
// rest, are the prelude's; a program names one of these only to keep it in a
// field, and imports it then.

/// What `it.map(f)` answers.
pub struct Mapped<I, T, U> {
	inner: I
	f: own<(x: T) => U>
}

extend Mapped<I, T, U> {
	/// What `it.map(f)` makes.
	pub static fn of(inner: I, f: own<(x: T) => U>): Mapped<I, T, U> = Mapped(
		inner: move inner,
		f: move f,
	)
}

extend Mapped<I: Iterator<T>, T, U>: Iterator<U> {
	var fn next(): Option<U> = match self.inner.next() {
		.Some(x) => .Some(self.f(move x))
		.None => .None
	}
}

/// What `it.filter(keep)` answers.
pub struct Filtered<I, T> {
	inner: I
	keep: own<(x: &T) => bool>
}

extend Filtered<I, T> {
	/// What `it.filter(keep)` makes.
	pub static fn of(inner: I, keep: own<(x: &T) => bool>): Filtered<I, T> = Filtered(
		inner: move inner,
		keep: move keep,
	)
}

extend Filtered<I: Iterator<T>, T>: Iterator<T> {
	var fn next(): Option<T> = {
		while true {
			val .Some(x) = self.inner.next() else {
				return .None
			}
			if self.keep(&x) then return .Some(move x)
		}
		return .None
	}
}

/// What `it.enumerate()` answers.
pub struct Enumerated<I, T> {
	inner: I
	at: i64
}

extend Enumerated<I, T> {
	/// What `it.enumerate()` makes.
	pub static fn of(inner: I): Enumerated<I, T> = Enumerated(inner: move inner, at: 0)
}

extend Enumerated<I: Iterator<T>, T>: Iterator<(i64, T)> {
	var fn next(): Option<(i64, T)> = match self.inner.next() {
		.Some(x) => {
			self.at += 1
			.Some((self.at - 1, move x))
		}
		.None => .None
	}
}

/// What `it.take(n)` answers.
pub struct Taken<I, T> {
	inner: I
	left: i64
}

extend Taken<I, T> {
	/// What `it.take(count)` makes.
	pub static fn of(inner: I, count: i64): Taken<I, T> = Taken(inner: move inner, left: count)
}

extend Taken<I: Iterator<T>, T>: Iterator<T> {
	var fn next(): Option<T> = {
		if self.left <= 0 then return .None
		self.left -= 1
		return self.inner.next()
	}
}

/// What `it.skip(n)` answers.
pub struct Skipped<I, T> {
	inner: I
	left: i64
}

extend Skipped<I, T> {
	/// What `it.skip(count)` makes.
	pub static fn of(inner: I, count: i64): Skipped<I, T> = Skipped(inner: move inner, left: count)
}

extend Skipped<I: Iterator<T>, T>: Iterator<T> {
	var fn next(): Option<T> = {
		while self.left > 0 {
			self.left -= 1
			if self.inner.next() is .None then return .None
		}
		return self.inner.next()
	}
}

/// What `it.zip(other)` answers.
pub struct Zipped<I, T, J, V> {
	first: I
	second: J
}

extend Zipped<I, T, J, V> {
	/// What `it.zip(other)` makes.
	pub static fn of(first: I, second: J): Zipped<I, T, J, V> = Zipped(
		first: move first,
		second: move second,
	)
}

extend Zipped<I: Iterator<T>, T, J: Iterator<V>, V>: Iterator<(T, V)> {
	var fn next(): Option<(T, V)> = match self.first.next() {
		.Some(a) => match self.second.next() {
			.Some(b) => .Some((move a, move b))
			.None => .None
		}
		.None => .None
	}
}

/// What `it.peekable()` answers: the elements, and the next one to look at
/// before it is taken.
pub struct Peekable<I, T> {
	inner: I
	/// The next element, taken from `inner` ahead of time by `peek`:
	/// nothing where none was, and `.Some(.None)` where there were no more.
	peeked: Option<Option<T>>
}

extend Peekable<I, T> {
	/// What `it.peekable()` makes.
	pub static fn of(inner: I): Peekable<I, T> = Peekable(inner: move inner, peeked: .None)
}

extend Peekable<I: Iterator<T>, T> {
	/// The next element, by reference, without taking it: the next
	/// `next()` answers it. What it answers borrows the `Peekable`, so it
	/// is used before the `Peekable` goes on.
	pub var fn peek(): Option<&T> = {
		if self.peeked is .None then self.peeked = .Some(self.inner.next())
		return match self.peeked {
			.Some(.Some(next)) => .Some(&next)
			_ => .None
		}
	}
}

extend Peekable<I: Iterator<T>, T>: Iterator<T> {
	var fn next(): Option<T> = match self.peeked.take() {
		.Some(next) => move next
		.None => self.inner.next()
	}
}
