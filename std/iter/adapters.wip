// What the adapters of `Iterator` answer: each holds the iterator it was made
// from and what it was given. The methods that make them, `it.map(f)` and the
// rest, are the prelude's; a program names one of these only to keep it in a
// field, and imports it then.

/// What `it.map(f)` answers.
pub struct Mapped<I: Iterator, U> {
	inner: I
	f: own<(x: I::Item) => U>
}

extend Mapped<I, U> {
	/// What `it.map(f)` makes.
	pub static fn of(inner: I, f: own<(x: I::Item) => U>): Mapped<I, U> = Mapped(
		inner: move inner,
		f: move f,
	)
}

extend Mapped<I, U>: Iterator<U> {
	var fn next(): Option<U> = match self.inner.next() {
		.Some(x) => .Some(self.f(move x))
		.None => .None
	}
}

/// What `it.filter(keep)` answers.
pub struct Filtered<I: Iterator> {
	inner: I
	keep: own<(x: &I::Item) => bool>
}

extend Filtered<I> {
	/// What `it.filter(keep)` makes.
	pub static fn of(inner: I, keep: own<(x: &I::Item) => bool>): Filtered<I> = Filtered(
		inner: move inner,
		keep: move keep,
	)
}

extend Filtered<I>: Iterator<I::Item> {
	var fn next(): Option<I::Item> = {
		while true {
			val .Some(x) = self.inner.next() else {
				return .None
			}
			if self.keep(&x) then return .Some(move x)
		}
		return .None
	}
}

/// What `it.enumerate()` answers.
pub struct Enumerated<I: Iterator> {
	inner: I
	at: i64
}

extend Enumerated<I> {
	/// What `it.enumerate()` makes.
	pub static fn of(inner: I): Enumerated<I> = Enumerated(inner: move inner, at: 0)
}

extend Enumerated<I>: Iterator<(i64, I::Item)> {
	var fn next(): Option<(i64, I::Item)> = match self.inner.next() {
		.Some(x) => {
			self.at += 1
			.Some((self.at - 1, move x))
		}
		.None => .None
	}
}

/// What `it.take(n)` answers.
pub struct Taken<I: Iterator> {
	inner: I
	left: i64
}

extend Taken<I> {
	/// What `it.take(count)` makes.
	pub static fn of(inner: I, count: i64): Taken<I> = Taken(inner: move inner, left: count)
}

extend Taken<I>: Iterator<I::Item> {
	var fn next(): Option<I::Item> = {
		if self.left <= 0 then return .None
		self.left -= 1
		return self.inner.next()
	}
}

/// What `it.skip(n)` answers.
pub struct Skipped<I: Iterator> {
	inner: I
	left: i64
}

extend Skipped<I> {
	/// What `it.skip(count)` makes.
	pub static fn of(inner: I, count: i64): Skipped<I> = Skipped(inner: move inner, left: count)
}

extend Skipped<I>: Iterator<I::Item> {
	var fn next(): Option<I::Item> = {
		while self.left > 0 {
			self.left -= 1
			if self.inner.next() is .None then return .None
		}
		return self.inner.next()
	}
}

/// What `it.zip(other)` answers.
pub struct Zipped<I: Iterator, J: Iterator> {
	first: I
	second: J
}

extend Zipped<I, J> {
	/// What `it.zip(other)` makes.
	pub static fn of(first: I, second: J): Zipped<I, J> = Zipped(
		first: move first,
		second: move second,
	)
}

extend Zipped<I, J>: Iterator<(I::Item, J::Item)> {
	var fn next(): Option<(I::Item, J::Item)> = match self.first.next() {
		.Some(a) => match self.second.next() {
			.Some(b) => .Some((move a, move b))
			.None => .None
		}
		.None => .None
	}
}

/// What `it.peekable()` answers: the elements, and the next one to look at
/// before it is taken.
pub struct Peekable<I: Iterator> {
	inner: I
	/// The next element, taken from `inner` ahead of time by `peek`:
	/// nothing where none was, and `.Some(.None)` where there were no more.
	peeked: Option<Option<I::Item>>
}

extend Peekable<I> {
	/// What `it.peekable()` makes.
	pub static fn of(inner: I): Peekable<I> = Peekable(inner: move inner, peeked: .None)
}

extend Peekable<I> {
	/// The next element, by reference, without taking it: the next
	/// `next()` answers it. What it answers borrows the `Peekable`, so it
	/// is used before the `Peekable` goes on.
	pub var fn peek(): Option<&I::Item> = {
		if self.peeked is .None then self.peeked = .Some(self.inner.next())
		return match self.peeked {
			.Some(.Some(next)) => .Some(&next)
			_ => .None
		}
	}
}

extend Peekable<I>: Iterator<I::Item> {
	var fn next(): Option<I::Item> = match self.peeked.take() {
		.Some(next) => move next
		.None => self.inner.next()
	}
}

/// What `it.filterMap(f)` answers.
pub struct FilterMapped<I: Iterator, U> {
	inner: I
	f: own<(x: I::Item) => Option<U>>
}

extend FilterMapped<I, U> {
	/// What `it.filterMap(f)` makes.
	pub static fn of(
		inner: I,
		f: own<(x: I::Item) => Option<U>>,
	): FilterMapped<I, U> = FilterMapped(inner: move inner, f: move f)
}

extend FilterMapped<I, U>: Iterator<U> {
	var fn next(): Option<U> = {
		while self.inner.next() is .Some(x) {
			if self.f(move x) is .Some(made) then return .Some(move made)
		}
		return .None
	}
}

/// What `it.chain(other)` answers.
pub struct Chained<I: Iterator, J: Iterator<I::Item>> {
	first: I
	second: J
	/// The first has run out, and the second is walked.
	onSecond: bool
}

extend Chained<I, J> {
	/// What `it.chain(other)` makes.
	pub static fn of(first: I, second: J): Chained<I, J> = Chained(
		first: move first,
		second: move second,
		onSecond: false,
	)
}

extend Chained<I, J>: Iterator<I::Item> {
	var fn next(): Option<I::Item> = {
		if !self.onSecond {
			if self.first.next() is .Some(x) then return .Some(move x)
			self.onSecond = true
		}
		return self.second.next()
	}
}

/// What `it.flatMap(f)` answers.
pub struct FlatMapped<I: Iterator, J: Iterator> {
	inner: I
	f: own<(x: I::Item) => J>
	/// The iterator `f` made of the element being walked, where there is
	/// one.
	current: Option<J>
}

extend FlatMapped<I, J> {
	/// What `it.flatMap(f)` makes.
	pub static fn of(inner: I, f: own<(x: I::Item) => J>): FlatMapped<I, J> = FlatMapped(
		inner: move inner,
		f: move f,
		current: .None,
	)
}

extend FlatMapped<I, J>: Iterator<J::Item> {
	var fn next(): Option<J::Item> = {
		while true {
			if self.current is .Some(walking) && walking.next() is .Some(x) then
				return .Some(move x)
			val .Some(x) = self.inner.next() else {
				return .None
			}
			self.current = .Some(self.f(move x))
		}
		return .None
	}
}

/// What `it.flatten()` answers. Its element is named, `J`, since what is
/// asked of it, that it be an iterator, is said of a parameter.
pub struct Flattened<I: Iterator<J>, J: Iterator> {
	inner: I
	/// The element being walked, where there is one.
	current: Option<J>
}

extend Flattened<I, J> {
	/// What `it.flatten()` makes.
	pub static fn of(inner: I): Flattened<I, J> = Flattened(inner: move inner, current: .None)
}

extend Flattened<I, J>: Iterator<J::Item> {
	var fn next(): Option<J::Item> = {
		while true {
			if self.current is .Some(walking) && walking.next() is .Some(x) then
				return .Some(move x)
			val .Some(x) = self.inner.next() else {
				return .None
			}
			self.current = .Some(move x)
		}
		return .None
	}
}

/// What `it.takeWhile(keep)` answers.
pub struct TakenWhile<I: Iterator> {
	inner: I
	keep: own<(x: &I::Item) => bool>
	/// An element failed `keep`, and nothing more is taken.
	done: bool
}

extend TakenWhile<I> {
	/// What `it.takeWhile(keep)` makes.
	pub static fn of(inner: I, keep: own<(x: &I::Item) => bool>): TakenWhile<I> = TakenWhile(
		inner: move inner,
		keep: move keep,
		done: false,
	)
}

extend TakenWhile<I>: Iterator<I::Item> {
	var fn next(): Option<I::Item> = {
		if self.done then return .None
		val .Some(x) = self.inner.next() else {
			return .None
		}
		if self.keep(&x) then return .Some(move x)
		self.done = true
		return .None
	}
}
