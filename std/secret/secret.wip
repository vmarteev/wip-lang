// What a secret needs: bytes no one can guess, from the system's generator
// for secrets, and two secrets compared in a time that does not say where
// they differ. A key, a token, a salt or a nonce is made here, never with
// `std::random`, whose next number follows from the numbers it answered.

import std::libc

/// The most bytes `getentropy` gives in one call, on every system Wip runs
/// on.
val MOST_A_CALL: i64 = 256

/// `count` bytes from the system's generator for secrets: for a key, a
/// token, a salt, a nonce. A token is `hex::encode(&secret::bytes(16))`.
pub fn bytes(count: i64): Vec<u8> = {
	var made = Vec::filled(count, 0 as u8)
	fill(&var made)
	return made
}

/// `into` filled from the same generator, for a key of a fixed size:
/// `var key = [0 as u8; 32]` and then `secret::fill(&var key)`. It panics
/// where the system fails, which it documents only for a buffer it cannot
/// write.
pub fn fill(into: &var [u8]) = {
	var at = 0
	while at < into.len() {
		val end = (at + MOST_A_CALL).min(into.len())
		if libc::getentropy(&var into[at..end]) != 0 then
			panic("the system gave no bytes for a secret")

		at = end
	}
}

/// Whether `a` and `b` are the same bytes, in a time that depends on their
/// lengths alone, not on where they differ: for a signature, a token or a
/// password's hash compared with what was sent, where `==` stops at the
/// first byte that differs and so tells how many were right. Lengths that
/// differ answer `false` at once, since a signature's length is no secret.
pub fn equal(a: &[u8], b: &[u8]): bool = {
	if a.len() != b.len() then
		return false

	// Each step's difference is folded in through `opaque`, so the
	// optimiser cannot see that the answer is known once a byte differs.
	var differ: u64 = 0
	for i in 0..a.len() do
		differ = opaque(differ | ((a[i] ^ b[i]) as u64))

	return differ == 0
}

/// `value`, read back from memory the optimiser may not reason about, so
/// that nothing after it is worked out from what it was.
@intrinsic
fn opaque(value: u64): u64
