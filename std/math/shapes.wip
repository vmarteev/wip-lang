// The shapes a game tests things against: what is out of sight, what is
// under the mouse, what touches what. Each is plain numbers of `f32`, and a
// ray's hit answers how far along it the shape is first met.

extern "C" {
	/// A box whose sides lie along the axes, from its `min` corner to its `max`:
	/// what is drawn as one thing is culled, and picked first, as one.
	@derive(Eq, Text)
	pub struct Aabb {
		pub var min: Vec3
		pub var max: Vec3
	}
}

extend Aabb {
	/// The box from one corner to the other.
	pub static fn of(min: Vec3, max: Vec3): Aabb = Aabb(min: min, max: max)

	/// The smallest box around every point; around none, a box that holds
	/// nothing and grows to the first point `enclose` is given.
	pub static fn enclosing(points: &[Vec3]): Aabb = {
		var box = Aabb::empty()
		for point in points {
			box = box.enclose(point)
		}
		return box
	}

	/// The box around nothing, `min` above `max`: what growing starts from.
	pub static fn empty(): Aabb = Aabb(min: Vec3::splat(infinity()), max: Vec3::splat(-infinity()))

	/// It grown to hold `point` too.
	pub fn enclose(point: Vec3): Aabb = Aabb(min: self.min.min(point), max: self.max.max(point))

	/// Its middle.
	pub fn center(): Vec3 = (self.min + self.max) * 0.5

	/// How wide, tall and deep it is.
	pub fn size(): Vec3 = self.max - self.min

	/// Whether `point` is inside it or on its surface.
	pub fn contains(point: Vec3): bool =
		point.x >= self.min.x &&
		point.x <= self.max.x &&
		point.y >= self.min.y &&
		point.y <= self.max.y &&
		point.z >= self.min.z &&
		point.z <= self.max.z

	/// Whether the two boxes share a point.
	pub fn intersects(other: Aabb): bool =
		self.min.x <= other.max.x &&
		other.min.x <= self.max.x &&
		self.min.y <= other.max.y &&
		other.min.y <= self.max.y &&
		self.min.z <= other.max.z &&
		other.min.z <= self.max.z

	/// Whether the box and the sphere share a point.
	pub fn intersectsSphere(sphere: Sphere): bool =
		sphere.center.clamp(self.min, self.max).distance(sphere.center) <= sphere.radius

	/// How far along `ray` it is first met, in lengths of the ray's
	/// direction; `.None` where the ray misses it or it lies behind. A ray
	/// that starts inside meets it at 0.
	pub fn hit(ray: Ray): Option<f32> = {
		var near = 0.0 as f32
		var far = infinity()
		for axis in 0..3 {
			val origin = axisOf(ray.origin, axis)
			val direction = axisOf(ray.direction, axis)
			val low = axisOf(self.min, axis)
			val high = axisOf(self.max, axis)
			// Parallel to these sides: inside them always, or never.
			if direction == 0.0 {
				if origin < low || origin > high then return .None
				continue
			}
			val inverse = 1.0 / direction
			val toLow = (low - origin) * inverse
			val toHigh = (high - origin) * inverse
			near = near.max(toLow.min(toHigh))
			far = far.min(toLow.max(toHigh))
			if near > far then return .None
		}
		return .Some(near)
	}
}

extern "C" {
	/// A half line: from `origin`, along `direction`.
	@derive(Eq, Text)
	pub struct Ray {
		pub var origin: Vec3
		pub var direction: Vec3
	}
}

extend Ray {
	/// The ray from `origin` along `direction`.
	pub static fn of(origin: Vec3, direction: Vec3): Ray = Ray(origin: origin, direction: direction)

	/// The point `t` lengths of its direction along it.
	pub fn at(t: f32): Vec3 = self.origin + self.direction * t
}

extern "C" {
	/// A flat surface without end: the points whose distance along `normal`,
	/// of length one, is `distance`. A frustum is six of them.
	@derive(Eq, Text)
	pub struct Plane {
		pub var normal: Vec3
		pub var distance: f32
	}
}

extend Plane {
	/// The plane through `point` facing `normal`, of length one.
	pub static fn of(point: Vec3, normal: Vec3): Plane = Plane(
		normal: normal,
		distance: normal.dot(point),
	)

	/// How far `point` lies in front of it, along its normal: negative
	/// behind.
	pub fn signedDistance(point: Vec3): f32 = self.normal.dot(point) - self.distance

	/// How far along `ray` it is met; `.None` where the ray runs beside it or
	/// away from it.
	pub fn hit(ray: Ray): Option<f32> = {
		val facing = self.normal.dot(ray.direction)
		if facing == 0.0 then return .None
		val t = (self.distance - self.normal.dot(ray.origin)) / facing
		return if t >= 0.0 then .Some(t) else .None
	}
}

extern "C" {
	/// A ball: the points within `radius` of `center`.
	@derive(Eq, Text)
	pub struct Sphere {
		pub var center: Vec3
		pub var radius: f32
	}
}

extend Sphere {
	/// The sphere about `center`.
	pub static fn of(center: Vec3, radius: f32): Sphere = Sphere(center: center, radius: radius)

	/// Whether `point` is inside it or on its surface.
	pub fn contains(point: Vec3): bool =
		(point - self.center).lengthSquared() <= self.radius * self.radius

	/// Whether the two spheres share a point.
	pub fn intersects(other: Sphere): bool = {
		val reach = self.radius + other.radius
		return (other.center - self.center).lengthSquared() <= reach * reach
	}

	/// How far along `ray` it is first met, in lengths of the ray's
	/// direction; `.None` where the ray misses it or it lies behind. A ray
	/// that starts inside meets it at 0.
	pub fn hit(ray: Ray): Option<f32> = {
		val toCenter = ray.origin - self.center
		val a = ray.direction.lengthSquared()
		val halfB = toCenter.dot(ray.direction)
		val c = toCenter.lengthSquared() - self.radius * self.radius
		if c <= 0.0 then return .Some(0.0)
		val discriminant = halfB * halfB - a * c
		if discriminant < 0.0 then return .None
		val t = (-halfB - discriminant.sqrt()) / a
		return if t >= 0.0 then .Some(t) else .None
	}
}

/// A vector's number on `axis`: 0 is `x`, 1 is `y`, 2 is `z`.
fn axisOf(v: Vec3, axis: i64): f32 = match axis {
	0 => v.x
	1 => v.y
	_ => v.z
}

/// The `f32` larger than every other.
fn infinity(): f32 = f32::fromBits(0x7F80_0000)
