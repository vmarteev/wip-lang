// Vectors of `f64`, for where a world is larger than an `f32` keeps exact:
// a millimetre to about eight kilometres from the origin. Positions and the
// transforms that place things are kept so, and a renderer takes them
// relative to the camera, near which `f32` is exact again.

extern "C" {
	/// Two `f64`: a position in a plane larger than an `f32` keeps exact.
	@derive(Eq, Text)
	pub struct Vec2d {
		pub var x: f64
		pub var y: f64
	}
}

extend Vec2d {
	/// The vector of the 2 numbers.
	pub static fn of(x: f64, y: f64): Vec2d = Vec2d(x: x, y: y)

	/// The vector with `value` on every axis.
	pub static fn splat(value: f64): Vec2d = Vec2d(x: value, y: value)

	/// The unit vector along `x`.
	pub static fn unitX(): Vec2d = Vec2d(x: 1.0, y: 0.0)

	/// The unit vector along `y`.
	pub static fn unitY(): Vec2d = Vec2d(x: 0.0, y: 1.0)

	/// The sum of the products of the two vectors' numbers, axis by axis:
	/// zero where they are at right angles.
	pub fn dot(other: Vec2d): f64 = self.x * other.x + self.y * other.y

	/// How long it is.
	pub fn length(): f64 = self.dot(self).sqrt()

	/// How long it is, squared: cheaper, and enough to compare lengths.
	pub fn lengthSquared(): f64 = self.dot(self)

	/// How far it is from `other`, both taken as points.
	pub fn distance(other: Vec2d): f64 = (self - other).length()

	/// The vector of length one in its direction. A vector of zero length
	/// has none, and its numbers are NaN, as IEEE's division answers;
	/// `normalizedOr` answers another where that may happen.
	pub fn normalized(): Vec2d = self / self.length()

	/// The vector of length one in its direction, or `fallback` where it
	/// has none: its length is zero, or too small or too large to divide by.
	pub fn normalizedOr(fallback: Vec2d): Vec2d = {
		val length = self.length()
		return if length > 0.0 && (1.0 / length).isFinite() then self / length else fallback
	}

	/// The point `t` of the way from it to `to`: itself at 0, `to` at 1,
	/// and further along the line outside them.
	pub fn lerp(to: Vec2d, t: f64): Vec2d = self + (to - self) * t

	/// The smaller number on each axis.
	pub fn min(other: Vec2d): Vec2d = Vec2d(x: self.x.min(other.x), y: self.y.min(other.y))

	/// The larger number on each axis.
	pub fn max(other: Vec2d): Vec2d = Vec2d(x: self.x.max(other.x), y: self.y.max(other.y))

	/// Each number without its sign.
	pub fn abs(): Vec2d = Vec2d(x: self.x.abs(), y: self.y.abs())

	/// Each number held between `low`'s and `high`'s on its axis.
	pub fn clamp(low: Vec2d, high: Vec2d): Vec2d = self.max(low).min(high)

	/// It bounced off a surface whose normal, of length one, is `normal`.
	pub fn reflect(normal: Vec2d): Vec2d = self - normal * (2.0 * self.dot(normal))

	/// The angle between the two directions, in radians, from 0 to π.
	pub fn angleTo(other: Vec2d): f64 = {
		val cosine = self.dot(other) / (self.lengthSquared() * other.lengthSquared()).sqrt()
		return cosine.clamp(-1.0, 1.0).acos()
	}

	/// Whether every number is within `tolerance` of `other`'s: the
	/// comparison a test wants, where `==` asks for the same bits.
	pub fn approxEquals(other: Vec2d, tolerance: f64): bool =
		(self.x - other.x).abs() <= tolerance && (self.y - other.y).abs() <= tolerance
}

extend Vec2d: Zero {
	static fn zero(): Vec2d = Vec2d::splat(0.0)
}

/// The vector of ones, what `*` between two vectors starts from.
extend Vec2d: One {
	static fn one(): Vec2d = Vec2d::splat(1.0)
}

extend Vec2d: Add {
	fn add(other: &Vec2d): Vec2d = Vec2d(x: self.x + other.x, y: self.y + other.y)
}

extend Vec2d: Subtract {
	fn subtract(other: &Vec2d): Vec2d = Vec2d(x: self.x - other.x, y: self.y - other.y)
}

/// The product of each axis: `a * b`, a colour tinted by another.
extend Vec2d: Multiply {
	fn multiply(other: &Vec2d): Vec2d = Vec2d(x: self.x * other.x, y: self.y * other.y)
}

/// Every number times the scale: `v * s`.
extend Vec2d: Multiply<f64> {
	fn multiply(other: &f64): Vec2d = Vec2d(x: self.x * other, y: self.y * other)
}

/// Every number divided by `d`: `v / d`.
extend Vec2d: Divide<f64> {
	fn divide(other: &f64): Vec2d = Vec2d(x: self.x / other, y: self.y / other)
}

extend Vec2d: Negate {
	fn negate(): Vec2d = Vec2d(x: -self.x, y: -self.y)
}

/// The scale on the left: `s * v`.
extend f64: Multiply<Vec2d, Vec2d> {
	fn multiply(other: &Vec2d): Vec2d = Vec2d(x: self * other.x, y: self * other.y)
}

extern "C" {
	/// Three `f64`: a position in a world larger than an `f32` keeps exact,
	/// which a renderer takes relative to the camera, `relativeTo`.
	@derive(Eq, Text)
	pub struct Vec3d {
		pub var x: f64
		pub var y: f64
		pub var z: f64
	}
}

extend Vec3d {
	/// The vector of the 3 numbers.
	pub static fn of(x: f64, y: f64, z: f64): Vec3d = Vec3d(x: x, y: y, z: z)

	/// The vector with `value` on every axis.
	pub static fn splat(value: f64): Vec3d = Vec3d(x: value, y: value, z: value)

	/// The unit vector along `x`.
	pub static fn unitX(): Vec3d = Vec3d(x: 1.0, y: 0.0, z: 0.0)

	/// The unit vector along `y`.
	pub static fn unitY(): Vec3d = Vec3d(x: 0.0, y: 1.0, z: 0.0)

	/// The unit vector along `z`.
	pub static fn unitZ(): Vec3d = Vec3d(x: 0.0, y: 0.0, z: 1.0)

	/// The sum of the products of the two vectors' numbers, axis by axis:
	/// zero where they are at right angles.
	pub fn dot(other: Vec3d): f64 = self.x * other.x + self.y * other.y + self.z * other.z

	/// How long it is.
	pub fn length(): f64 = self.dot(self).sqrt()

	/// How long it is, squared: cheaper, and enough to compare lengths.
	pub fn lengthSquared(): f64 = self.dot(self)

	/// How far it is from `other`, both taken as points.
	pub fn distance(other: Vec3d): f64 = (self - other).length()

	/// The vector of length one in its direction. A vector of zero length
	/// has none, and its numbers are NaN, as IEEE's division answers;
	/// `normalizedOr` answers another where that may happen.
	pub fn normalized(): Vec3d = self / self.length()

	/// The vector of length one in its direction, or `fallback` where it
	/// has none: its length is zero, or too small or too large to divide by.
	pub fn normalizedOr(fallback: Vec3d): Vec3d = {
		val length = self.length()
		return if length > 0.0 && (1.0 / length).isFinite() then self / length else fallback
	}

	/// The point `t` of the way from it to `to`: itself at 0, `to` at 1,
	/// and further along the line outside them.
	pub fn lerp(to: Vec3d, t: f64): Vec3d = self + (to - self) * t

	/// The smaller number on each axis.
	pub fn min(other: Vec3d): Vec3d = Vec3d(
		x: self.x.min(other.x),
		y: self.y.min(other.y),
		z: self.z.min(other.z),
	)

	/// The larger number on each axis.
	pub fn max(other: Vec3d): Vec3d = Vec3d(
		x: self.x.max(other.x),
		y: self.y.max(other.y),
		z: self.z.max(other.z),
	)

	/// Each number without its sign.
	pub fn abs(): Vec3d = Vec3d(x: self.x.abs(), y: self.y.abs(), z: self.z.abs())

	/// Each number held between `low`'s and `high`'s on its axis.
	pub fn clamp(low: Vec3d, high: Vec3d): Vec3d = self.max(low).min(high)

	/// It bounced off a surface whose normal, of length one, is `normal`.
	pub fn reflect(normal: Vec3d): Vec3d = self - normal * (2.0 * self.dot(normal))

	/// The angle between the two directions, in radians, from 0 to π.
	pub fn angleTo(other: Vec3d): f64 = {
		val cosine = self.dot(other) / (self.lengthSquared() * other.lengthSquared()).sqrt()
		return cosine.clamp(-1.0, 1.0).acos()
	}

	/// Whether every number is within `tolerance` of `other`'s: the
	/// comparison a test wants, where `==` asks for the same bits.
	pub fn approxEquals(other: Vec3d, tolerance: f64): bool =
		(self.x - other.x).abs() <= tolerance &&
		(self.y - other.y).abs() <= tolerance &&
		(self.z - other.z).abs() <= tolerance
}

extend Vec3d: Zero {
	static fn zero(): Vec3d = Vec3d::splat(0.0)
}

/// The vector of ones, what `*` between two vectors starts from.
extend Vec3d: One {
	static fn one(): Vec3d = Vec3d::splat(1.0)
}

extend Vec3d: Add {
	fn add(other: &Vec3d): Vec3d = Vec3d(
		x: self.x + other.x,
		y: self.y + other.y,
		z: self.z + other.z,
	)
}

extend Vec3d: Subtract {
	fn subtract(other: &Vec3d): Vec3d = Vec3d(
		x: self.x - other.x,
		y: self.y - other.y,
		z: self.z - other.z,
	)
}

/// The product of each axis: `a * b`, a colour tinted by another.
extend Vec3d: Multiply {
	fn multiply(other: &Vec3d): Vec3d = Vec3d(
		x: self.x * other.x,
		y: self.y * other.y,
		z: self.z * other.z,
	)
}

/// Every number times the scale: `v * s`.
extend Vec3d: Multiply<f64> {
	fn multiply(other: &f64): Vec3d = Vec3d(x: self.x * other, y: self.y * other, z: self.z * other)
}

/// Every number divided by `d`: `v / d`.
extend Vec3d: Divide<f64> {
	fn divide(other: &f64): Vec3d = Vec3d(x: self.x / other, y: self.y / other, z: self.z / other)
}

extend Vec3d: Negate {
	fn negate(): Vec3d = Vec3d(x: -self.x, y: -self.y, z: -self.z)
}

/// The scale on the left: `s * v`.
extend f64: Multiply<Vec3d, Vec3d> {
	fn multiply(other: &Vec3d): Vec3d = Vec3d(
		x: self * other.x,
		y: self * other.y,
		z: self * other.z,
	)
}

extern "C" {
	/// Four `f64`: a position in the coordinates `Mat4d` works in.
	@derive(Eq, Text)
	pub struct Vec4d {
		pub var x: f64
		pub var y: f64
		pub var z: f64
		pub var w: f64
	}
}

extend Vec4d {
	/// The vector of the 4 numbers.
	pub static fn of(x: f64, y: f64, z: f64, w: f64): Vec4d = Vec4d(x: x, y: y, z: z, w: w)

	/// The vector with `value` on every axis.
	pub static fn splat(value: f64): Vec4d = Vec4d(x: value, y: value, z: value, w: value)

	/// The unit vector along `x`.
	pub static fn unitX(): Vec4d = Vec4d(x: 1.0, y: 0.0, z: 0.0, w: 0.0)

	/// The unit vector along `y`.
	pub static fn unitY(): Vec4d = Vec4d(x: 0.0, y: 1.0, z: 0.0, w: 0.0)

	/// The unit vector along `z`.
	pub static fn unitZ(): Vec4d = Vec4d(x: 0.0, y: 0.0, z: 1.0, w: 0.0)

	/// The unit vector along `w`.
	pub static fn unitW(): Vec4d = Vec4d(x: 0.0, y: 0.0, z: 0.0, w: 1.0)

	/// The sum of the products of the two vectors' numbers, axis by axis:
	/// zero where they are at right angles.
	pub fn dot(other: Vec4d): f64 =
		self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w

	/// How long it is.
	pub fn length(): f64 = self.dot(self).sqrt()

	/// How long it is, squared: cheaper, and enough to compare lengths.
	pub fn lengthSquared(): f64 = self.dot(self)

	/// How far it is from `other`, both taken as points.
	pub fn distance(other: Vec4d): f64 = (self - other).length()

	/// The vector of length one in its direction. A vector of zero length
	/// has none, and its numbers are NaN, as IEEE's division answers;
	/// `normalizedOr` answers another where that may happen.
	pub fn normalized(): Vec4d = self / self.length()

	/// The vector of length one in its direction, or `fallback` where it
	/// has none: its length is zero, or too small or too large to divide by.
	pub fn normalizedOr(fallback: Vec4d): Vec4d = {
		val length = self.length()
		return if length > 0.0 && (1.0 / length).isFinite() then self / length else fallback
	}

	/// The point `t` of the way from it to `to`: itself at 0, `to` at 1,
	/// and further along the line outside them.
	pub fn lerp(to: Vec4d, t: f64): Vec4d = self + (to - self) * t

	/// The smaller number on each axis.
	pub fn min(other: Vec4d): Vec4d = Vec4d(
		x: self.x.min(other.x),
		y: self.y.min(other.y),
		z: self.z.min(other.z),
		w: self.w.min(other.w),
	)

	/// The larger number on each axis.
	pub fn max(other: Vec4d): Vec4d = Vec4d(
		x: self.x.max(other.x),
		y: self.y.max(other.y),
		z: self.z.max(other.z),
		w: self.w.max(other.w),
	)

	/// Each number without its sign.
	pub fn abs(): Vec4d = Vec4d(x: self.x.abs(), y: self.y.abs(), z: self.z.abs(), w: self.w.abs())

	/// Each number held between `low`'s and `high`'s on its axis.
	pub fn clamp(low: Vec4d, high: Vec4d): Vec4d = self.max(low).min(high)

	/// It bounced off a surface whose normal, of length one, is `normal`.
	pub fn reflect(normal: Vec4d): Vec4d = self - normal * (2.0 * self.dot(normal))

	/// The angle between the two directions, in radians, from 0 to π.
	pub fn angleTo(other: Vec4d): f64 = {
		val cosine = self.dot(other) / (self.lengthSquared() * other.lengthSquared()).sqrt()
		return cosine.clamp(-1.0, 1.0).acos()
	}

	/// Whether every number is within `tolerance` of `other`'s: the
	/// comparison a test wants, where `==` asks for the same bits.
	pub fn approxEquals(other: Vec4d, tolerance: f64): bool =
		(self.x - other.x).abs() <= tolerance &&
		(self.y - other.y).abs() <= tolerance &&
		(self.z - other.z).abs() <= tolerance &&
		(self.w - other.w).abs() <= tolerance
}

extend Vec4d: Zero {
	static fn zero(): Vec4d = Vec4d::splat(0.0)
}

/// The vector of ones, what `*` between two vectors starts from.
extend Vec4d: One {
	static fn one(): Vec4d = Vec4d::splat(1.0)
}

extend Vec4d: Add {
	fn add(other: &Vec4d): Vec4d = Vec4d(
		x: self.x + other.x,
		y: self.y + other.y,
		z: self.z + other.z,
		w: self.w + other.w,
	)
}

extend Vec4d: Subtract {
	fn subtract(other: &Vec4d): Vec4d = Vec4d(
		x: self.x - other.x,
		y: self.y - other.y,
		z: self.z - other.z,
		w: self.w - other.w,
	)
}

/// The product of each axis: `a * b`, a colour tinted by another.
extend Vec4d: Multiply {
	fn multiply(other: &Vec4d): Vec4d = Vec4d(
		x: self.x * other.x,
		y: self.y * other.y,
		z: self.z * other.z,
		w: self.w * other.w,
	)
}

/// Every number times the scale: `v * s`.
extend Vec4d: Multiply<f64> {
	fn multiply(other: &f64): Vec4d = Vec4d(
		x: self.x * other,
		y: self.y * other,
		z: self.z * other,
		w: self.w * other,
	)
}

/// Every number divided by `d`: `v / d`.
extend Vec4d: Divide<f64> {
	fn divide(other: &f64): Vec4d = Vec4d(
		x: self.x / other,
		y: self.y / other,
		z: self.z / other,
		w: self.w / other,
	)
}

extend Vec4d: Negate {
	fn negate(): Vec4d = Vec4d(x: -self.x, y: -self.y, z: -self.z, w: -self.w)
}

/// The scale on the left: `s * v`.
extend f64: Multiply<Vec4d, Vec4d> {
	fn multiply(other: &Vec4d): Vec4d = Vec4d(
		x: self * other.x,
		y: self * other.y,
		z: self * other.z,
		w: self * other.w,
	)
}

extend Vec2d {
	/// It with `z` as a third number.
	pub fn extend(z: f64): Vec3d = Vec3d(x: self.x, y: self.y, z: z)

	/// Its numbers rounded to `f32`.
	pub fn toF32(): Vec2 = Vec2(x: self.x as f32, y: self.y as f32)

	/// Where it lies from `origin`, in `f32`: exact near the origin, which is
	/// where a renderer draws from.
	pub fn relativeTo(origin: Vec2d): Vec2 = (self - origin).toF32()
}

extend Vec3d {
	/// The vector at right angles to both, by the right hand.
	pub fn cross(other: Vec3d): Vec3d = Vec3d(
		x: self.y * other.z - self.z * other.y,
		y: self.z * other.x - self.x * other.z,
		z: self.x * other.y - self.y * other.x,
	)

	/// Its first two numbers.
	pub fn xy(): Vec2d = Vec2d(x: self.x, y: self.y)

	/// It with `w` as a fourth number.
	pub fn extend(w: f64): Vec4d = Vec4d(x: self.x, y: self.y, z: self.z, w: w)

	/// Its numbers rounded to `f32`.
	pub fn toF32(): Vec3 = Vec3(x: self.x as f32, y: self.y as f32, z: self.z as f32)

	/// Where it lies from `origin`, in `f32`: exact near the origin, which is
	/// where a renderer draws from.
	pub fn relativeTo(origin: Vec3d): Vec3 = (self - origin).toF32()
}

extend Vec4d {
	/// Its first three numbers.
	pub fn xyz(): Vec3d = Vec3d(x: self.x, y: self.y, z: self.z)

	/// Its numbers rounded to `f32`.
	pub fn toF32(): Vec4 = Vec4(
		x: self.x as f32,
		y: self.y as f32,
		z: self.z as f32,
		w: self.w as f32,
	)
}
