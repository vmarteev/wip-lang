// Matrices of `f32`, stored a column at a time, as GLSL, HLSL, Metal and
// WGSL take them by default: `m * v` multiplies the column vector `v` on the
// right, and `a * b` does `b` first. The projections come in two depth
// ranges, named, since a wrong one draws nothing and says nothing: OpenGL's
// `-1` to `1`, and Vulkan's, Metal's and Direct3D's `0` to `1`.

extern "C" {
	/// Three columns of three `f32`: a rotation and a scale, with no movement;
	/// what turns a normal. A GPU's buffer takes it as three `Vec4`s,
	/// `toColumns4()`.
	@derive(Eq, Text)
	pub struct Mat3 {
		pub var x: Vec3
		pub var y: Vec3
		pub var z: Vec3
	}
}

extend Mat3 {
	/// The matrix of these columns.
	pub static fn fromColumns(x: Vec3, y: Vec3, z: Vec3): Mat3 = Mat3(x: x, y: y, z: z)

	/// The matrix that changes nothing.
	pub static fn identity(): Mat3 = Mat3(x: Vec3::unitX(), y: Vec3::unitY(), z: Vec3::unitZ())

	/// The matrix that stretches each axis by `factors`' number on it.
	pub static fn scale(factors: Vec3): Mat3 = Mat3(
		x: Vec3::unitX() * factors.x,
		y: Vec3::unitY() * factors.y,
		z: Vec3::unitZ() * factors.z,
	)

	/// The matrix that turns as the rotation does.
	pub static fn rotation(rotation: Quat): Mat3 = {
		val m = Mat4::rotation(rotation)
		return Mat3(x: m.x.xyz(), y: m.y.xyz(), z: m.z.xyz())
	}

	/// The upper left three by three of `m`: its rotation and scale, without
	/// its movement.
	pub static fn fromMat4(m: Mat4): Mat3 = Mat3(x: m.x.xyz(), y: m.y.xyz(), z: m.z.xyz())

	/// Rows made columns.
	pub fn transposed(): Mat3 = Mat3(
		x: Vec3(x: self.x.x, y: self.y.x, z: self.z.x),
		y: Vec3(x: self.x.y, y: self.y.y, z: self.z.y),
		z: Vec3(x: self.x.z, y: self.y.z, z: self.z.z),
	)

	/// How much it scales a volume, and whether it mirrors: negative.
	pub fn determinant(): f32 = self.x.dot(self.y.cross(self.z))

	/// The matrix that undoes it, where one does: `.None` for a matrix that
	/// flattens space, whose determinant is zero.
	pub fn inverse(): Option<Mat3> = {
		val determinant = self.determinant()
		if determinant == 0.0 then return .None
		val scale = 1.0 / determinant
		val rows = Mat3(
			x: self.y.cross(self.z) * scale,
			y: self.z.cross(self.x) * scale,
			z: self.x.cross(self.y) * scale,
		)
		return .Some(rows.transposed())
	}

	/// Its columns, each a `Vec4` with 0 last, as a GPU's buffer lays a `mat3`.
	pub fn toColumns4(): [Vec4; 3] = [self.x.extend(0.0), self.y.extend(0.0), self.z.extend(0.0)]

	/// Whether every number is within `tolerance` of `other`'s.
	pub fn approxEquals(other: Mat3, tolerance: f32): bool =
		self.x.approxEquals(other.x, tolerance) &&
		self.y.approxEquals(other.y, tolerance) &&
		self.z.approxEquals(other.z, tolerance)
}

/// One matrix after another: `a * b` does `b` first.
extend Mat3: Multiply {
	fn multiply(other: &Mat3): Mat3 = Mat3(x: self * other.x, y: self * other.y, z: self * other.z)
}

/// A vector moved by the matrix: `m * v`.
extend Mat3: Multiply<Vec3, Vec3> {
	fn multiply(other: &Vec3): Vec3 = self.x * other.x + self.y * other.y + self.z * other.z
}

extern "C" {
	/// Four columns of four `f32`: a movement, a rotation and a scale, or a
	/// projection. Aligned to 16, as a GPU's `mat4`.
	@align(16)
	@derive(Eq, Text)
	pub struct Mat4 {
		pub var x: Vec4
		pub var y: Vec4
		pub var z: Vec4
		pub var w: Vec4
	}
}

extend Mat4 {
	/// The matrix of these columns.
	pub static fn fromColumns(x: Vec4, y: Vec4, z: Vec4, w: Vec4): Mat4 = Mat4(
		x: x,
		y: y,
		z: z,
		w: w,
	)

	/// The matrix of these rows: how a library that stores a row at a time
	/// hands one over.
	pub static fn fromRows(x: Vec4, y: Vec4, z: Vec4, w: Vec4): Mat4 = Mat4(
		x: x,
		y: y,
		z: z,
		w: w,
	).transposed()

	/// The matrix of sixteen numbers, a column at a time, as a buffer holds
	/// them.
	pub static fn fromArray(numbers: [f32; 16]): Mat4 = Mat4(
		x: Vec4(x: numbers[0], y: numbers[1], z: numbers[2], w: numbers[3]),
		y: Vec4(x: numbers[4], y: numbers[5], z: numbers[6], w: numbers[7]),
		z: Vec4(x: numbers[8], y: numbers[9], z: numbers[10], w: numbers[11]),
		w: Vec4(x: numbers[12], y: numbers[13], z: numbers[14], w: numbers[15]),
	)

	/// The matrix that changes nothing.
	pub static fn identity(): Mat4 = Mat4(
		x: Vec4::unitX(),
		y: Vec4::unitY(),
		z: Vec4::unitZ(),
		w: Vec4::unitW(),
	)

	/// The matrix that moves a point by `offset`, and leaves a direction be.
	pub static fn translation(offset: Vec3): Mat4 = Mat4(
		x: Vec4::unitX(),
		y: Vec4::unitY(),
		z: Vec4::unitZ(),
		w: offset.extend(1.0),
	)

	/// The matrix that stretches each axis by `factors`' number on it.
	pub static fn scale(factors: Vec3): Mat4 = Mat4(
		x: Vec4::unitX() * factors.x,
		y: Vec4::unitY() * factors.y,
		z: Vec4::unitZ() * factors.z,
		w: Vec4::unitW(),
	)

	/// The matrix that turns as the rotation, of length one, does.
	pub static fn rotation(rotation: Quat): Mat4 = {
		val (x, y, z, w) = (rotation.x, rotation.y, rotation.z, rotation.w)
		val (x2, y2, z2) = (x + x, y + y, z + z)
		val (xx, xy, xz) = (x * x2, x * y2, x * z2)
		val (yy, yz, zz) = (y * y2, y * z2, z * z2)
		val (wx, wy, wz) = (w * x2, w * y2, w * z2)
		return Mat4(
			x: Vec4(x: 1.0 - (yy + zz), y: xy + wz, z: xz - wy, w: 0.0),
			y: Vec4(x: xy - wz, y: 1.0 - (xx + zz), z: yz + wx, w: 0.0),
			z: Vec4(x: xz + wy, y: yz - wx, z: 1.0 - (xx + yy), w: 0.0),
			w: Vec4::unitW(),
		)
	}

	/// The matrix that turns by `angle` radians about `x`.
	pub static fn rotationX(angle: f32): Mat4 = {
		val (sine, cosine) = (angle.sin(), angle.cos())
		return Mat4(
			x: Vec4::unitX(),
			y: Vec4(x: 0.0, y: cosine, z: sine, w: 0.0),
			z: Vec4(x: 0.0, y: -sine, z: cosine, w: 0.0),
			w: Vec4::unitW(),
		)
	}

	/// The matrix that turns by `angle` radians about `y`.
	pub static fn rotationY(angle: f32): Mat4 = {
		val (sine, cosine) = (angle.sin(), angle.cos())
		return Mat4(
			x: Vec4(x: cosine, y: 0.0, z: -sine, w: 0.0),
			y: Vec4::unitY(),
			z: Vec4(x: sine, y: 0.0, z: cosine, w: 0.0),
			w: Vec4::unitW(),
		)
	}

	/// The matrix that turns by `angle` radians about `z`.
	pub static fn rotationZ(angle: f32): Mat4 = {
		val (sine, cosine) = (angle.sin(), angle.cos())
		return Mat4(
			x: Vec4(x: cosine, y: sine, z: 0.0, w: 0.0),
			y: Vec4(x: -sine, y: cosine, z: 0.0, w: 0.0),
			z: Vec4::unitZ(),
			w: Vec4::unitW(),
		)
	}

	/// The view of a camera at `eye` looking at `target`, with `up` above it:
	/// what puts the world in the camera's coordinates, the camera at the
	/// origin looking down `-z`, `y` up.
	pub static fn lookAt(eye: Vec3, target: Vec3, up: Vec3): Mat4 = {
		val forward = (target - eye).normalized()
		val side = forward.cross(up).normalized()
		val above = side.cross(forward)
		return Mat4(
			x: Vec4(x: side.x, y: above.x, z: -forward.x, w: 0.0),
			y: Vec4(x: side.y, y: above.y, z: -forward.y, w: 0.0),
			z: Vec4(x: side.z, y: above.z, z: -forward.z, w: 0.0),
			w: Vec4(x: -side.dot(eye), y: -above.dot(eye), z: forward.dot(eye), w: 1.0),
		)
	}

	/// A perspective projection, `fovY` radians from the bottom of the view
	/// to the top, `aspect` its width over its height, seeing from `near` to
	/// `far` in front of the camera; depth from `-1` at `near` to `1` at
	/// `far`, as OpenGL, raylib and sokol's GL take it.
	pub static fn perspective(fovY: f32, aspect: f32, near: f32, far: f32): Mat4 = {
		val focal = 1.0 / (fovY * 0.5).tan()
		val depth = 1.0 / (near - far)
		return Mat4(
			x: Vec4(x: focal / aspect, y: 0.0, z: 0.0, w: 0.0),
			y: Vec4(x: 0.0, y: focal, z: 0.0, w: 0.0),
			z: Vec4(x: 0.0, y: 0.0, z: (far + near) * depth, w: -1.0),
			w: Vec4(x: 0.0, y: 0.0, z: 2.0 * far * near * depth, w: 0.0),
		)
	}

	/// A perspective projection, as `perspective`, with depth from `0` at
	/// `near` to `1` at `far`, as Vulkan, Metal and Direct3D take it.
	pub static fn perspectiveZeroToOne(fovY: f32, aspect: f32, near: f32, far: f32): Mat4 = {
		val focal = 1.0 / (fovY * 0.5).tan()
		val depth = 1.0 / (near - far)
		return Mat4(
			x: Vec4(x: focal / aspect, y: 0.0, z: 0.0, w: 0.0),
			y: Vec4(x: 0.0, y: focal, z: 0.0, w: 0.0),
			z: Vec4(x: 0.0, y: 0.0, z: far * depth, w: -1.0),
			w: Vec4(x: 0.0, y: 0.0, z: far * near * depth, w: 0.0),
		)
	}

	/// A projection that keeps parallel lines parallel, of the box from
	/// `left` to `right`, `bottom` to `top`, and `near` to `far` in front of
	/// the camera; depth from `-1` to `1`, as OpenGL takes it.
	pub static fn orthographic(
		left: f32,
		right: f32,
		bottom: f32,
		top: f32,
		near: f32,
		far: f32,
	): Mat4 = {
		val width = 1.0 / (right - left)
		val height = 1.0 / (top - bottom)
		val depth = 1.0 / (far - near)
		return Mat4(
			x: Vec4(x: 2.0 * width, y: 0.0, z: 0.0, w: 0.0),
			y: Vec4(x: 0.0, y: 2.0 * height, z: 0.0, w: 0.0),
			z: Vec4(x: 0.0, y: 0.0, z: -2.0 * depth, w: 0.0),
			w: Vec4(
				x: -(right + left) * width,
				y: -(top + bottom) * height,
				z: -(far + near) * depth,
				w: 1.0,
			),
		)
	}

	/// A projection that keeps parallel lines parallel, as `orthographic`,
	/// with depth from `0` to `1`, as Vulkan, Metal and Direct3D take it.
	pub static fn orthographicZeroToOne(
		left: f32,
		right: f32,
		bottom: f32,
		top: f32,
		near: f32,
		far: f32,
	): Mat4 = {
		val width = 1.0 / (right - left)
		val height = 1.0 / (top - bottom)
		val depth = 1.0 / (far - near)
		return Mat4(
			x: Vec4(x: 2.0 * width, y: 0.0, z: 0.0, w: 0.0),
			y: Vec4(x: 0.0, y: 2.0 * height, z: 0.0, w: 0.0),
			z: Vec4(x: 0.0, y: 0.0, z: -depth, w: 0.0),
			w: Vec4(
				x: -(right + left) * width,
				y: -(top + bottom) * height,
				z: -near * depth,
				w: 1.0,
			),
		)
	}

	/// Rows made columns.
	pub fn transposed(): Mat4 = Mat4(
		x: Vec4(x: self.x.x, y: self.y.x, z: self.z.x, w: self.w.x),
		y: Vec4(x: self.x.y, y: self.y.y, z: self.z.y, w: self.w.y),
		z: Vec4(x: self.x.z, y: self.y.z, z: self.z.z, w: self.w.z),
		w: Vec4(x: self.x.w, y: self.y.w, z: self.z.w, w: self.w.w),
	)

	/// Its sixteen numbers, a column at a time, as a buffer holds them.
	pub fn toArray(): [f32; 16] = [
		self.x.x,
		self.x.y,
		self.x.z,
		self.x.w,
		self.y.x,
		self.y.y,
		self.y.z,
		self.y.w,
		self.z.x,
		self.z.y,
		self.z.z,
		self.z.w,
		self.w.x,
		self.w.y,
		self.w.z,
		self.w.w,
	]

	/// How much it scales a volume, and whether it mirrors: negative.
	pub fn determinant(): f32 = {
		val m = self.toArray()
		val (c0, c4, c8, c12) = cofactorsOfFirstColumn(&m)
		return m[0] * c0 + m[1] * c4 + m[2] * c8 + m[3] * c12
	}

	/// The matrix that undoes it, where one does: `.None` for a matrix that
	/// flattens space, whose determinant is zero.
	pub fn inverse(): Option<Mat4> = {
		val m = self.toArray()
		val (c0, c4, c8, c12) = cofactorsOfFirstColumn(&m)
		val determinant = m[0] * c0 + m[1] * c4 + m[2] * c8 + m[3] * c12
		if determinant == 0.0 then return .None
		val inverse: [f32; 16] = [
			c0,
			-m[1] * m[10] * m[15] +
				m[1] * m[11] * m[14] +
				m[9] * m[2] * m[15] -
				m[9] * m[3] * m[14] -
				m[13] * m[2] * m[11] +
				m[13] * m[3] * m[10],
			m[1] * m[6] * m[15] -
				m[1] * m[7] * m[14] -
				m[5] * m[2] * m[15] +
				m[5] * m[3] * m[14] +
				m[13] * m[2] * m[7] -
				m[13] * m[3] * m[6],
			-m[1] * m[6] * m[11] +
				m[1] * m[7] * m[10] +
				m[5] * m[2] * m[11] -
				m[5] * m[3] * m[10] -
				m[9] * m[2] * m[7] +
				m[9] * m[3] * m[6],
			c4,
			m[0] * m[10] * m[15] -
				m[0] * m[11] * m[14] -
				m[8] * m[2] * m[15] +
				m[8] * m[3] * m[14] +
				m[12] * m[2] * m[11] -
				m[12] * m[3] * m[10],
			-m[0] * m[6] * m[15] +
				m[0] * m[7] * m[14] +
				m[4] * m[2] * m[15] -
				m[4] * m[3] * m[14] -
				m[12] * m[2] * m[7] +
				m[12] * m[3] * m[6],
			m[0] * m[6] * m[11] -
				m[0] * m[7] * m[10] -
				m[4] * m[2] * m[11] +
				m[4] * m[3] * m[10] +
				m[8] * m[2] * m[7] -
				m[8] * m[3] * m[6],
			c8,
			-m[0] * m[9] * m[15] +
				m[0] * m[11] * m[13] +
				m[8] * m[1] * m[15] -
				m[8] * m[3] * m[13] -
				m[12] * m[1] * m[11] +
				m[12] * m[3] * m[9],
			m[0] * m[5] * m[15] -
				m[0] * m[7] * m[13] -
				m[4] * m[1] * m[15] +
				m[4] * m[3] * m[13] +
				m[12] * m[1] * m[7] -
				m[12] * m[3] * m[5],
			-m[0] * m[5] * m[11] +
				m[0] * m[7] * m[9] +
				m[4] * m[1] * m[11] -
				m[4] * m[3] * m[9] -
				m[8] * m[1] * m[7] +
				m[8] * m[3] * m[5],
			c12,
			m[0] * m[9] * m[14] -
				m[0] * m[10] * m[13] -
				m[8] * m[1] * m[14] +
				m[8] * m[2] * m[13] +
				m[12] * m[1] * m[10] -
				m[12] * m[2] * m[9],
			-m[0] * m[5] * m[14] +
				m[0] * m[6] * m[13] +
				m[4] * m[1] * m[14] -
				m[4] * m[2] * m[13] -
				m[12] * m[1] * m[6] +
				m[12] * m[2] * m[5],
			m[0] * m[5] * m[10] -
				m[0] * m[6] * m[9] -
				m[4] * m[1] * m[10] +
				m[4] * m[2] * m[9] +
				m[8] * m[1] * m[6] -
				m[8] * m[2] * m[5],
		]
		val scale = 1.0 / determinant
		val adjugate = Mat4::fromArray(inverse)
		return .Some(Mat4(
			x: adjugate.x * scale,
			y: adjugate.y * scale,
			z: adjugate.z * scale,
			w: adjugate.w * scale,
		))
	}

	/// The point moved by the matrix, taken with a fourth number of 1 and
	/// that number dropped after: right for a movement, a rotation and a
	/// scale. A projection divides by it, `m * p.extend(1.0)` and then by
	/// `w`.
	pub fn transformPoint(point: Vec3): Vec3 = (self * point.extend(1.0)).xyz()

	/// The direction turned and scaled by the matrix, not moved: taken with
	/// a fourth number of 0.
	pub fn transformDirection(direction: Vec3): Vec3 = (self * direction.extend(0.0)).xyz()

	/// Its numbers as `f64`.
	pub fn toF64(): Mat4d = Mat4d(
		x: self.x.toF64(),
		y: self.y.toF64(),
		z: self.z.toF64(),
		w: self.w.toF64(),
	)

	/// Whether every number is within `tolerance` of `other`'s.
	pub fn approxEquals(other: Mat4, tolerance: f32): bool =
		self.x.approxEquals(other.x, tolerance) &&
		self.y.approxEquals(other.y, tolerance) &&
		self.z.approxEquals(other.z, tolerance) &&
		self.w.approxEquals(other.w, tolerance)
}

/// One matrix after another: `a * b` does `b` first.
extend Mat4: Multiply {
	fn multiply(other: &Mat4): Mat4 = Mat4(
		x: self * other.x,
		y: self * other.y,
		z: self * other.z,
		w: self * other.w,
	)
}

/// A vector moved by the matrix: `m * v`.
extend Mat4: Multiply<Vec4, Vec4> {
	fn multiply(other: &Vec4): Vec4 =
		self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w
}

/// The cofactors of a four by four matrix's first column, a column at a
/// time in `m`: what its determinant and its inverse both start from.
fn cofactorsOfFirstColumn(m: &[f32; 16]): (f32, f32, f32, f32) = (
	m[5] * m[10] * m[15] -
		m[5] * m[11] * m[14] -
		m[9] * m[6] * m[15] +
		m[9] * m[7] * m[14] +
		m[13] * m[6] * m[11] -
		m[13] * m[7] * m[10],
	-m[4] * m[10] * m[15] +
		m[4] * m[11] * m[14] +
		m[8] * m[6] * m[15] -
		m[8] * m[7] * m[14] -
		m[12] * m[6] * m[11] +
		m[12] * m[7] * m[10],
	m[4] * m[9] * m[15] -
		m[4] * m[11] * m[13] -
		m[8] * m[5] * m[15] +
		m[8] * m[7] * m[13] +
		m[12] * m[5] * m[11] -
		m[12] * m[7] * m[9],
	-m[4] * m[9] * m[14] +
		m[4] * m[10] * m[13] +
		m[8] * m[5] * m[14] -
		m[8] * m[6] * m[13] -
		m[12] * m[5] * m[10] +
		m[12] * m[6] * m[9],
)
