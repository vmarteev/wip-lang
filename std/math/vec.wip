// Vectors of `f32`: what a game's positions, directions, sizes and colours
// are, and what a GPU and a C library draw from. Right-handed, `y` up, as
// OpenGL, glam and GLM have it; a matrix multiplies a vector on its right.
// Equality is exact: `approxEquals` is the comparison a test wants.

extern "C" {
	/// Two `f32`: a point or a direction in a plane, a size, a texture's
	/// coordinates. Laid out as C's `struct { float x, y; }`.
	@derive(Eq, Text)
	pub struct Vec2 {
		pub var x: f32
		pub var y: f32
	}
}

extend Vec2 {
	/// The vector of the 2 numbers.
	pub static fn of(x: f32, y: f32): Vec2 = Vec2(x: x, y: y)

	/// The vector with `value` on every axis.
	pub static fn splat(value: f32): Vec2 = Vec2(x: value, y: value)

	/// The unit vector along `x`.
	pub static fn unitX(): Vec2 = Vec2(x: 1.0, y: 0.0)

	/// The unit vector along `y`.
	pub static fn unitY(): Vec2 = Vec2(x: 0.0, y: 1.0)

	/// The sum of the products of the two vectors' numbers, axis by axis:
	/// zero where they are at right angles.
	pub fn dot(other: Vec2): f32 = self.x * other.x + self.y * other.y

	/// How long it is.
	pub fn length(): f32 = self.dot(self).sqrt()

	/// How long it is, squared: cheaper, and enough to compare lengths.
	pub fn lengthSquared(): f32 = self.dot(self)

	/// How far it is from `other`, both taken as points.
	pub fn distance(other: Vec2): f32 = (self - other).length()

	/// The vector of length one in its direction. A vector of zero length
	/// has none, and its numbers are NaN, as IEEE's division answers;
	/// `normalizedOr` answers another where that may happen.
	pub fn normalized(): Vec2 = self / self.length()

	/// The vector of length one in its direction, or `fallback` where it
	/// has none: its length is zero, or too small or too large to divide by.
	pub fn normalizedOr(fallback: Vec2): Vec2 = {
		val length = self.length()
		return if length > 0.0 && (1.0 / length).isFinite() then self / length else fallback
	}

	/// The point `t` of the way from it to `to`: itself at 0, `to` at 1,
	/// and further along the line outside them.
	pub fn lerp(to: Vec2, t: f32): Vec2 = self + (to - self) * t

	/// The smaller number on each axis.
	pub fn min(other: Vec2): Vec2 = Vec2(x: self.x.min(other.x), y: self.y.min(other.y))

	/// The larger number on each axis.
	pub fn max(other: Vec2): Vec2 = Vec2(x: self.x.max(other.x), y: self.y.max(other.y))

	/// Each number without its sign.
	pub fn abs(): Vec2 = Vec2(x: self.x.abs(), y: self.y.abs())

	/// Each number held between `low`'s and `high`'s on its axis.
	pub fn clamp(low: Vec2, high: Vec2): Vec2 = self.max(low).min(high)

	/// It bounced off a surface whose normal, of length one, is `normal`.
	pub fn reflect(normal: Vec2): Vec2 = self - normal * (2.0 * self.dot(normal))

	/// The angle between the two directions, in radians, from 0 to π.
	pub fn angleTo(other: Vec2): f32 = {
		val cosine = self.dot(other) / (self.lengthSquared() * other.lengthSquared()).sqrt()
		return cosine.clamp(-1.0, 1.0).acos()
	}

	/// Whether every number is within `tolerance` of `other`'s: the
	/// comparison a test wants, where `==` asks for the same bits.
	pub fn approxEquals(other: Vec2, tolerance: f32): bool =
		(self.x - other.x).abs() <= tolerance && (self.y - other.y).abs() <= tolerance
}

extend Vec2: Zero {
	static fn zero(): Vec2 = Vec2::splat(0.0)
}

/// The vector of ones, what `*` between two vectors starts from.
extend Vec2: One {
	static fn one(): Vec2 = Vec2::splat(1.0)
}

extend Vec2: Add {
	fn add(other: &Vec2): Vec2 = Vec2(x: self.x + other.x, y: self.y + other.y)
}

extend Vec2: Subtract {
	fn subtract(other: &Vec2): Vec2 = Vec2(x: self.x - other.x, y: self.y - other.y)
}

/// The product of each axis: `a * b`, a colour tinted by another.
extend Vec2: Multiply {
	fn multiply(other: &Vec2): Vec2 = Vec2(x: self.x * other.x, y: self.y * other.y)
}

/// Every number times the scale: `v * s`.
extend Vec2: Multiply<f32> {
	fn multiply(other: &f32): Vec2 = Vec2(x: self.x * other, y: self.y * other)
}

/// Every number divided by `d`: `v / d`.
extend Vec2: Divide<f32> {
	fn divide(other: &f32): Vec2 = Vec2(x: self.x / other, y: self.y / other)
}

extend Vec2: Negate {
	fn negate(): Vec2 = Vec2(x: -self.x, y: -self.y)
}

/// The scale on the left: `s * v`.
extend f32: Multiply<Vec2, Vec2> {
	fn multiply(other: &Vec2): Vec2 = Vec2(x: self * other.x, y: self * other.y)
}

extern "C" {
	/// Three `f32`: a point or a direction in space, a colour. Twelve bytes,
	/// as C's `struct { float x, y, z; }` and a vertex's position; a shader's
	/// `vec3` in a buffer says `@align(16)` where it is a field.
	@derive(Eq, Text)
	pub struct Vec3 {
		pub var x: f32
		pub var y: f32
		pub var z: f32
	}
}

extend Vec3 {
	/// The vector of the 3 numbers.
	pub static fn of(x: f32, y: f32, z: f32): Vec3 = Vec3(x: x, y: y, z: z)

	/// The vector with `value` on every axis.
	pub static fn splat(value: f32): Vec3 = Vec3(x: value, y: value, z: value)

	/// The unit vector along `x`.
	pub static fn unitX(): Vec3 = Vec3(x: 1.0, y: 0.0, z: 0.0)

	/// The unit vector along `y`.
	pub static fn unitY(): Vec3 = Vec3(x: 0.0, y: 1.0, z: 0.0)

	/// The unit vector along `z`.
	pub static fn unitZ(): Vec3 = Vec3(x: 0.0, y: 0.0, z: 1.0)

	/// The sum of the products of the two vectors' numbers, axis by axis:
	/// zero where they are at right angles.
	pub fn dot(other: Vec3): f32 = self.x * other.x + self.y * other.y + self.z * other.z

	/// How long it is.
	pub fn length(): f32 = self.dot(self).sqrt()

	/// How long it is, squared: cheaper, and enough to compare lengths.
	pub fn lengthSquared(): f32 = self.dot(self)

	/// How far it is from `other`, both taken as points.
	pub fn distance(other: Vec3): f32 = (self - other).length()

	/// The vector of length one in its direction. A vector of zero length
	/// has none, and its numbers are NaN, as IEEE's division answers;
	/// `normalizedOr` answers another where that may happen.
	pub fn normalized(): Vec3 = self / self.length()

	/// The vector of length one in its direction, or `fallback` where it
	/// has none: its length is zero, or too small or too large to divide by.
	pub fn normalizedOr(fallback: Vec3): Vec3 = {
		val length = self.length()
		return if length > 0.0 && (1.0 / length).isFinite() then self / length else fallback
	}

	/// The point `t` of the way from it to `to`: itself at 0, `to` at 1,
	/// and further along the line outside them.
	pub fn lerp(to: Vec3, t: f32): Vec3 = self + (to - self) * t

	/// The smaller number on each axis.
	pub fn min(other: Vec3): Vec3 = Vec3(
		x: self.x.min(other.x),
		y: self.y.min(other.y),
		z: self.z.min(other.z),
	)

	/// The larger number on each axis.
	pub fn max(other: Vec3): Vec3 = Vec3(
		x: self.x.max(other.x),
		y: self.y.max(other.y),
		z: self.z.max(other.z),
	)

	/// Each number without its sign.
	pub fn abs(): Vec3 = Vec3(x: self.x.abs(), y: self.y.abs(), z: self.z.abs())

	/// Each number held between `low`'s and `high`'s on its axis.
	pub fn clamp(low: Vec3, high: Vec3): Vec3 = self.max(low).min(high)

	/// It bounced off a surface whose normal, of length one, is `normal`.
	pub fn reflect(normal: Vec3): Vec3 = self - normal * (2.0 * self.dot(normal))

	/// The angle between the two directions, in radians, from 0 to π.
	pub fn angleTo(other: Vec3): f32 = {
		val cosine = self.dot(other) / (self.lengthSquared() * other.lengthSquared()).sqrt()
		return cosine.clamp(-1.0, 1.0).acos()
	}

	/// Whether every number is within `tolerance` of `other`'s: the
	/// comparison a test wants, where `==` asks for the same bits.
	pub fn approxEquals(other: Vec3, tolerance: f32): bool =
		(self.x - other.x).abs() <= tolerance &&
		(self.y - other.y).abs() <= tolerance &&
		(self.z - other.z).abs() <= tolerance
}

extend Vec3: Zero {
	static fn zero(): Vec3 = Vec3::splat(0.0)
}

/// The vector of ones, what `*` between two vectors starts from.
extend Vec3: One {
	static fn one(): Vec3 = Vec3::splat(1.0)
}

extend Vec3: Add {
	fn add(other: &Vec3): Vec3 = Vec3(x: self.x + other.x, y: self.y + other.y, z: self.z + other.z)
}

extend Vec3: Subtract {
	fn subtract(other: &Vec3): Vec3 = Vec3(
		x: self.x - other.x,
		y: self.y - other.y,
		z: self.z - other.z,
	)
}

/// The product of each axis: `a * b`, a colour tinted by another.
extend Vec3: Multiply {
	fn multiply(other: &Vec3): Vec3 = Vec3(
		x: self.x * other.x,
		y: self.y * other.y,
		z: self.z * other.z,
	)
}

/// Every number times the scale: `v * s`.
extend Vec3: Multiply<f32> {
	fn multiply(other: &f32): Vec3 = Vec3(x: self.x * other, y: self.y * other, z: self.z * other)
}

/// Every number divided by `d`: `v / d`.
extend Vec3: Divide<f32> {
	fn divide(other: &f32): Vec3 = Vec3(x: self.x / other, y: self.y / other, z: self.z / other)
}

extend Vec3: Negate {
	fn negate(): Vec3 = Vec3(x: -self.x, y: -self.y, z: -self.z)
}

/// The scale on the left: `s * v`.
extend f32: Multiply<Vec3, Vec3> {
	fn multiply(other: &Vec3): Vec3 = Vec3(x: self * other.x, y: self * other.y, z: self * other.z)
}

extern "C" {
	/// Four `f32`: a point in the coordinates a projection works in, a colour
	/// with its opacity. Aligned to 16, as a GPU's `vec4` and a SIMD register.
	@align(16)
	@derive(Eq, Text)
	pub struct Vec4 {
		pub var x: f32
		pub var y: f32
		pub var z: f32
		pub var w: f32
	}
}

extend Vec4 {
	/// The vector of the 4 numbers.
	pub static fn of(x: f32, y: f32, z: f32, w: f32): Vec4 = Vec4(x: x, y: y, z: z, w: w)

	/// The vector with `value` on every axis.
	pub static fn splat(value: f32): Vec4 = Vec4(x: value, y: value, z: value, w: value)

	/// The unit vector along `x`.
	pub static fn unitX(): Vec4 = Vec4(x: 1.0, y: 0.0, z: 0.0, w: 0.0)

	/// The unit vector along `y`.
	pub static fn unitY(): Vec4 = Vec4(x: 0.0, y: 1.0, z: 0.0, w: 0.0)

	/// The unit vector along `z`.
	pub static fn unitZ(): Vec4 = Vec4(x: 0.0, y: 0.0, z: 1.0, w: 0.0)

	/// The unit vector along `w`.
	pub static fn unitW(): Vec4 = Vec4(x: 0.0, y: 0.0, z: 0.0, w: 1.0)

	/// The sum of the products of the two vectors' numbers, axis by axis:
	/// zero where they are at right angles.
	pub fn dot(other: Vec4): f32 =
		self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w

	/// How long it is.
	pub fn length(): f32 = self.dot(self).sqrt()

	/// How long it is, squared: cheaper, and enough to compare lengths.
	pub fn lengthSquared(): f32 = self.dot(self)

	/// How far it is from `other`, both taken as points.
	pub fn distance(other: Vec4): f32 = (self - other).length()

	/// The vector of length one in its direction. A vector of zero length
	/// has none, and its numbers are NaN, as IEEE's division answers;
	/// `normalizedOr` answers another where that may happen.
	pub fn normalized(): Vec4 = self / self.length()

	/// The vector of length one in its direction, or `fallback` where it
	/// has none: its length is zero, or too small or too large to divide by.
	pub fn normalizedOr(fallback: Vec4): Vec4 = {
		val length = self.length()
		return if length > 0.0 && (1.0 / length).isFinite() then self / length else fallback
	}

	/// The point `t` of the way from it to `to`: itself at 0, `to` at 1,
	/// and further along the line outside them.
	pub fn lerp(to: Vec4, t: f32): Vec4 = self + (to - self) * t

	/// The smaller number on each axis.
	pub fn min(other: Vec4): Vec4 = Vec4(
		x: self.x.min(other.x),
		y: self.y.min(other.y),
		z: self.z.min(other.z),
		w: self.w.min(other.w),
	)

	/// The larger number on each axis.
	pub fn max(other: Vec4): Vec4 = Vec4(
		x: self.x.max(other.x),
		y: self.y.max(other.y),
		z: self.z.max(other.z),
		w: self.w.max(other.w),
	)

	/// Each number without its sign.
	pub fn abs(): Vec4 = Vec4(x: self.x.abs(), y: self.y.abs(), z: self.z.abs(), w: self.w.abs())

	/// Each number held between `low`'s and `high`'s on its axis.
	pub fn clamp(low: Vec4, high: Vec4): Vec4 = self.max(low).min(high)

	/// It bounced off a surface whose normal, of length one, is `normal`.
	pub fn reflect(normal: Vec4): Vec4 = self - normal * (2.0 * self.dot(normal))

	/// The angle between the two directions, in radians, from 0 to π.
	pub fn angleTo(other: Vec4): f32 = {
		val cosine = self.dot(other) / (self.lengthSquared() * other.lengthSquared()).sqrt()
		return cosine.clamp(-1.0, 1.0).acos()
	}

	/// Whether every number is within `tolerance` of `other`'s: the
	/// comparison a test wants, where `==` asks for the same bits.
	pub fn approxEquals(other: Vec4, tolerance: f32): bool =
		(self.x - other.x).abs() <= tolerance &&
		(self.y - other.y).abs() <= tolerance &&
		(self.z - other.z).abs() <= tolerance &&
		(self.w - other.w).abs() <= tolerance
}

extend Vec4: Zero {
	static fn zero(): Vec4 = Vec4::splat(0.0)
}

/// The vector of ones, what `*` between two vectors starts from.
extend Vec4: One {
	static fn one(): Vec4 = Vec4::splat(1.0)
}

extend Vec4: Add {
	fn add(other: &Vec4): Vec4 = Vec4(
		x: self.x + other.x,
		y: self.y + other.y,
		z: self.z + other.z,
		w: self.w + other.w,
	)
}

extend Vec4: Subtract {
	fn subtract(other: &Vec4): Vec4 = Vec4(
		x: self.x - other.x,
		y: self.y - other.y,
		z: self.z - other.z,
		w: self.w - other.w,
	)
}

/// The product of each axis: `a * b`, a colour tinted by another.
extend Vec4: Multiply {
	fn multiply(other: &Vec4): Vec4 = Vec4(
		x: self.x * other.x,
		y: self.y * other.y,
		z: self.z * other.z,
		w: self.w * other.w,
	)
}

/// Every number times the scale: `v * s`.
extend Vec4: Multiply<f32> {
	fn multiply(other: &f32): Vec4 = Vec4(
		x: self.x * other,
		y: self.y * other,
		z: self.z * other,
		w: self.w * other,
	)
}

/// Every number divided by `d`: `v / d`.
extend Vec4: Divide<f32> {
	fn divide(other: &f32): Vec4 = Vec4(
		x: self.x / other,
		y: self.y / other,
		z: self.z / other,
		w: self.w / other,
	)
}

extend Vec4: Negate {
	fn negate(): Vec4 = Vec4(x: -self.x, y: -self.y, z: -self.z, w: -self.w)
}

/// The scale on the left: `s * v`.
extend f32: Multiply<Vec4, Vec4> {
	fn multiply(other: &Vec4): Vec4 = Vec4(
		x: self * other.x,
		y: self * other.y,
		z: self * other.z,
		w: self * other.w,
	)
}

extend Vec2 {
	/// It with `z` as a third number.
	pub fn extend(z: f32): Vec3 = Vec3(x: self.x, y: self.y, z: z)

	/// Its numbers as `f64`.
	pub fn toF64(): Vec2d = Vec2d(x: self.x as f64, y: self.y as f64)
}

extend Vec3 {
	/// The vector at right angles to both, as long as the area of the
	/// parallelogram they span, by the right hand: `unitX().cross(unitY())`
	/// is `unitZ()`.
	pub fn cross(other: Vec3): Vec3 = Vec3(
		x: self.y * other.z - self.z * other.y,
		y: self.z * other.x - self.x * other.z,
		z: self.x * other.y - self.y * other.x,
	)

	/// Its first two numbers.
	pub fn xy(): Vec2 = Vec2(x: self.x, y: self.y)

	/// It with `w` as a fourth number: 1 for a point a matrix moves, 0 for a
	/// direction it only turns.
	pub fn extend(w: f32): Vec4 = Vec4(x: self.x, y: self.y, z: self.z, w: w)

	/// Its numbers as `f64`.
	pub fn toF64(): Vec3d = Vec3d(x: self.x as f64, y: self.y as f64, z: self.z as f64)
}

extend Vec4 {
	/// Its first two numbers.
	pub fn xy(): Vec2 = Vec2(x: self.x, y: self.y)

	/// Its first three numbers.
	pub fn xyz(): Vec3 = Vec3(x: self.x, y: self.y, z: self.z)

	/// Its numbers as `f64`.
	pub fn toF64(): Vec4d = Vec4d(
		x: self.x as f64,
		y: self.y as f64,
		z: self.z as f64,
		w: self.w as f64,
	)
}
