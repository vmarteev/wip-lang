// A matrix of `f64`, for the transforms that place things in a world larger
// than an `f32` keeps exact. It is the `Mat4` of positions, stored a column
// at a time as it is; a renderer takes it relative to the camera,
// `relativeTo`, and draws in `f32`.

extern "C" {
	/// Four columns of four `f64`: a movement, a rotation and a scale in a
	/// large world.
	@derive(Eq, Text)
	pub struct Mat4d {
		pub var x: Vec4d
		pub var y: Vec4d
		pub var z: Vec4d
		pub var w: Vec4d
	}
}

extend Mat4d {
	/// The matrix that changes nothing.
	pub static fn identity(): Mat4d = Mat4d(
		x: Vec4d::unitX(),
		y: Vec4d::unitY(),
		z: Vec4d::unitZ(),
		w: Vec4d::unitW(),
	)

	/// The matrix that moves a point by `offset`, and leaves a direction be.
	pub static fn translation(offset: Vec3d): Mat4d = Mat4d(
		x: Vec4d::unitX(),
		y: Vec4d::unitY(),
		z: Vec4d::unitZ(),
		w: offset.extend(1.0),
	)

	/// The matrix that stretches each axis by `factors`' number on it.
	pub static fn scale(factors: Vec3d): Mat4d = Mat4d(
		x: Vec4d::unitX() * factors.x,
		y: Vec4d::unitY() * factors.y,
		z: Vec4d::unitZ() * factors.z,
		w: Vec4d::unitW(),
	)

	/// The matrix that turns as the rotation does: a `Quat`, of `f32`, which
	/// keeps an orientation as well as a GPU can use it.
	pub static fn rotation(rotation: Quat): Mat4d = Mat4::rotation(rotation).toF64()

	/// Rows made columns.
	pub fn transposed(): Mat4d = Mat4d(
		x: Vec4d(x: self.x.x, y: self.y.x, z: self.z.x, w: self.w.x),
		y: Vec4d(x: self.x.y, y: self.y.y, z: self.z.y, w: self.w.y),
		z: Vec4d(x: self.x.z, y: self.y.z, z: self.z.z, w: self.w.z),
		w: Vec4d(x: self.x.w, y: self.y.w, z: self.z.w, w: self.w.w),
	)

	/// The point moved by the matrix, taken with a fourth number of 1.
	pub fn transformPoint(point: Vec3d): Vec3d = (self * point.extend(1.0)).xyz()

	/// The direction turned and scaled by the matrix, not moved.
	pub fn transformDirection(direction: Vec3d): Vec3d = (self * direction.extend(0.0)).xyz()

	/// Its numbers rounded to `f32`.
	pub fn toF32(): Mat4 = Mat4(
		x: self.x.toF32(),
		y: self.y.toF32(),
		z: self.z.toF32(),
		w: self.w.toF32(),
	)

	/// The same transform for a world whose origin is moved to `origin`, in
	/// `f32`: the movement taken from `origin` while it is `f64`, so what is
	/// near the camera is exact.
	pub fn relativeTo(origin: Vec3d): Mat4 = {
		val moved = Mat4d(x: self.x, y: self.y, z: self.z, w: Vec4d(
			x: self.w.x - origin.x,
			y: self.w.y - origin.y,
			z: self.w.z - origin.z,
			w: self.w.w,
		))
		return moved.toF32()
	}

	/// Whether every number is within `tolerance` of `other`'s.
	pub fn approxEquals(other: Mat4d, tolerance: f64): bool =
		self.x.approxEquals(other.x, tolerance) &&
		self.y.approxEquals(other.y, tolerance) &&
		self.z.approxEquals(other.z, tolerance) &&
		self.w.approxEquals(other.w, tolerance)
}

/// One matrix after another: `a * b` does `b` first.
extend Mat4d: Multiply {
	fn multiply(other: &Mat4d): Mat4d = Mat4d(
		x: self * other.x,
		y: self * other.y,
		z: self * other.z,
		w: self * other.w,
	)
}

/// A vector moved by the matrix: `m * v`.
extend Mat4d: Multiply<Vec4d, Vec4d> {
	fn multiply(other: &Vec4d): Vec4d =
		self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w
}
