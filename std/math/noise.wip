// Noise: values that change smoothly from point to point and never repeat
// in a pattern the eye finds, what terrain, clouds, fire and wood grain are
// made of. Ken Perlin's improved noise (2002), and the sum of its octaves
// every landscape is built from. The same permutation answers the same
// values on every machine, so a world generated from a seed is the same
// world each time.

/// Perlin's improved noise over a permutation of 0 to 255: `perlin()` is
/// his own, which his reference values are of, and `seeded(seed)` one
/// shuffled from a seed.
pub struct Noise {
	/// The permutation, twice over, so that an index plus one never wraps.
	table: [u8; 512]
}

extend Noise {
	/// Perlin's reference permutation.
	pub static fn perlin(): Noise = Noise::of(&PERMUTATION)

	/// A permutation shuffled from `seed`: another world for another seed,
	/// the same one for the same.
	pub static fn seeded(seed: u64): Noise = {
		var order = [0 as u8; 256]
		for i in 0..256 {
			order[i] = i as u8
		}
		// Fisher and Yates's shuffle, driven by SplitMix64.
		var state = seed
		var i = 255
		while i > 0 {
			state = state +% 0x9E3779B97F4A7C15
			var z = state
			z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9
			z = (z ^ (z >> 27)) *% 0x94D049BB133111EB
			z = z ^ (z >> 31)
			val j = (z % (i as u64 + 1)) as i64
			val held = order[i]
			order[i] = order[j]
			order[j] = held
			i -= 1
		}
		return Noise::of(&order)
	}

	static fn of(order: &[u8; 256]): Noise = {
		var table = [0 as u8; 512]
		for i in 0..512 {
			table[i] = order[i % 256]
		}
		return Noise(table)
	}

	/// The noise at a point in space, from -1 to 1, and 0 at every point
	/// whose coordinates are whole numbers.
	pub fn at3(x: f64, y: f64, z: f64): f64 = {
		val (cellX, cellY, cellZ) = (x.floor(), y.floor(), z.floor())
		val (a, b, c) = ((cellX as i64) & 255, (cellY as i64) & 255, (cellZ as i64) & 255)
		val (fx, fy, fz) = (x - cellX, y - cellY, z - cellZ)
		val (u, v, w) = (fade(fx), fade(fy), fade(fz))
		val p = &self.table
		val aa = p[p[a] + b] + c
		val ab = p[p[a] + b + 1] + c
		val ba = p[p[a + 1] + b] + c
		val bb = p[p[a + 1] + b + 1] + c
		return lerp(
			w,
			lerp(
				v,
				lerp(u, grad(p[aa], fx, fy, fz), grad(p[ba], fx - 1.0, fy, fz)),
				lerp(u, grad(p[ab], fx, fy - 1.0, fz), grad(p[bb], fx - 1.0, fy - 1.0, fz)),
			),
			lerp(
				v,
				lerp(u, grad(p[aa + 1], fx, fy, fz - 1.0), grad(p[ba + 1], fx - 1.0, fy, fz - 1.0)),
				lerp(
					u,
					grad(p[ab + 1], fx, fy - 1.0, fz - 1.0),
					grad(p[bb + 1], fx - 1.0, fy - 1.0, fz - 1.0),
				),
			),
		)
	}

	/// The noise at a point in a plane: the slice of space at `z = 0`.
	pub fn at2(x: f64, y: f64): f64 = self.at3(x, y, 0.0)

	/// The sum of `octaves` layers of noise at a point in space, each
	/// `lacunarity` times finer than the last and `gain` times as strong —
	/// 2 and 0.5 are the usual — scaled back to -1 to 1: hills with rocks on
	/// them, and pebbles on the rocks.
	pub fn fractal3(
		x: f64,
		y: f64,
		z: f64,
		octaves: i64,
		lacunarity: f64 = 2.0,
		gain: f64 = 0.5,
	): f64 = {
		var sum = 0.0
		var amplitude = 1.0
		var frequency = 1.0
		var total = 0.0
		for _ in 0..octaves {
			sum += amplitude * self.at3(x * frequency, y * frequency, z * frequency)
			total += amplitude
			amplitude *= gain
			frequency *= lacunarity
		}
		return if total > 0.0 then sum / total else 0.0
	}

	/// The sum of `octaves` layers of noise at a point in a plane, as
	/// `fractal3`.
	pub fn fractal2(
		x: f64,
		y: f64,
		octaves: i64,
		lacunarity: f64 = 2.0,
		gain: f64 = 0.5,
	): f64 = self.fractal3(x, y, 0.0, octaves, lacunarity, gain)
}

/// Perlin's curve from 0 to 1, `6t⁵ - 15t⁴ + 10t³`, whose slope and
/// curvature are both 0 at each end, so cells join with no crease.
fn fade(t: f64): f64 = t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

fn lerp(t: f64, a: f64, b: f64): f64 = a + t * (b - a)

/// The dot product of the point's place in its cell with one of twelve
/// directions to the cube's edges, chosen by the low four bits of `hash`.
fn grad(hash: u8, x: f64, y: f64, z: f64): f64 = {
	val h = hash & 15
	val u = if h < 8 then x else y
	val v = if h < 4 then y else if h == 12 || h == 14 then x else z
	return (if h & 1 == 0 then u else -u) + (if h & 2 == 0 then v else -v)
}

/// Ken Perlin's permutation of 0 to 255, from his reference implementation.
val PERMUTATION: [u8; 256] = [
	151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69,
	142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219,
	203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175,
	74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60, 211, 133, 230,
	220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76,
	132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186,
	3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59,
	227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70,
	221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178,
	185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81,
	51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115,
	121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195,
	78, 66, 215, 61, 156, 180,
]
