// Files embedded in the program: a file's contents, read
// when the program is compiled, from beside the module that names it and
// inside its package, and kept as a constant of the program, in memory
// nothing writes. They are written where a constant's value is worked
// out — a top-level `val`, a top-level `assert` — since the contents are a
// constant; a function reads them through that constant:
//
//     import std::embed
//
//     val FONT: &[u8] = embed::bytes("assets/font.png")
//     val HELP: str = embed::text("help.txt")

/// The bytes of the file at `path`, relative to the module's directory.
@intrinsic
pub fn bytes(path: str): &[u8]

/// The text of the file at `path`, which must be UTF-8.
@intrinsic
pub fn text(path: str): str

/// The text of the file at `path`, as `text` reads it, or `otherwise` where
/// there is no such file: what a build may have written beside the module,
/// or not.
@intrinsic
pub fn textOr(path: str, otherwise: str): str
