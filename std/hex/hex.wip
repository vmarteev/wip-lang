// Hexadecimal: each byte as two digits, `0` to `9` and `a` to `f`, as a
// digest, a key or a colour is written for a person to read and copy.

/// Why text is not hexadecimal: the byte at `at` is not a digit, or there
/// is half a byte at the end.
@derive(Eq, Clone)
pub enum HexError {
	NotADigit(at: i64)
	OddLength
}

extend HexError: Text {
	fn toString(): String = match self {
		.NotADigit(at) => "not hexadecimal: the byte at \(at) is not a digit"
		.OddLength => "not hexadecimal: it ends with half a byte"
	}
}

/// `bytes` as two digits each: `hex::encode(&digest)`, in lower case, or
/// upper where `upper` says.
pub fn encode(bytes: &[u8], upper: bool = false): String = {
	val digits = if upper then "0123456789ABCDEF" else "0123456789abcdef"
	var out = String::withCapacity(bytes.len() * 2)
	for byte in bytes {
		out.pushByte(digits[(byte >> 4) as i64])
		out.pushByte(digits[(byte & 15) as i64])
	}
	return out
}

/// The bytes `text`'s digits stand for, in either case.
pub fn decode(text: str): Result<Vec<u8>, HexError> = {
	var out: Vec<u8> = Vec::withCapacity(text.len() / 2)
	var at = 0
	while at + 1 < text.len() {
		val .Some(high) = text[at].digitValue(16) else return .Err(.NotADigit(at))
		val .Some(low) = text[at + 1].digitValue(16) else return .Err(.NotADigit(at + 1))
		out.push((high * 16 + low) as u8)
		at += 2
	}
	if at < text.len() {
		if text[at].digitValue(16).isNone() then return .Err(.NotADigit(at))
		return .Err(.OddLength)
	}
	return .Ok(out)
}
