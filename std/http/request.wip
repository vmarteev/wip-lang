// A request: a method, a URL, headers and a body, built a part at a time
// and sent by a `Client`. Each part given answers the request, so a request
// is written in one expression:
// `Request::post(url).header("Authorization", token).json(&item)`.

import std::json

/// What a client sends.
@derive(Clone)
pub struct Request {
	method: Method
	url: String
	headers: Vec<Header> = Vec()
	body: Body = .Empty
	/// How many bytes an upload says it sends, where the request says.
	length: Option<i64> = .None
}

/// Where a request's body comes from.
@derive(Clone)
enum Body {
	Empty
	Bytes(bytes: Vec<u8>)
	/// A file, read as it is sent.
	File(path: String)
}

extend Request {
	/// A request of `method` for `url`.
	pub static fn of(method: Method, url: str): Request = Request(
		method: method,
		url: String::of(url),
	)

	pub static fn get(url: str): Request = Request::of(.Get, url)

	pub static fn post(url: str): Request = Request::of(.Post, url)

	pub static fn put(url: str): Request = Request::of(.Put, url)

	pub static fn patch(url: str): Request = Request::of(.Patch, url)

	pub static fn delete(url: str): Request = Request::of(.Delete, url)

	pub static fn head(url: str): Request = Request::of(.Head, url)

	/// Its method.
	pub fn method(): Method = self.method

	/// Its URL, as it was given.
	pub fn url(): str = self.url.toStr()

	/// The header `name` with `value`, after those given before. One the
	/// client would send of itself — `Host`, `User-Agent`,
	/// `Accept-Encoding` — is sent as given instead.
	pub move fn header(name: str, value: str): Request = {
		var request = self
		request.headers.push(Header(name: String::of(name), value: String::of(value)))
		return request
	}

	/// `bytes` as the body.
	pub move fn body(bytes: &[u8]): Request = {
		var request = self
		request.body = .Bytes(bytes.toVec())
		return request
	}

	/// `text` as the body, said to be UTF-8 text unless a `Content-Type`
	/// was given.
	pub move fn text(text: str): Request = {
		var request = self.body(&text)
		return request.typed("text/plain; charset=utf-8")
	}

	/// `value` as the body, as JSON.
	pub move fn json<T: Encode>(value: &T): Request = {
		val written = json::encode(&value)
		var request = self.body(&written)
		return request.typed("application/json")
	}

	/// The file at `path` as the body, read as it is sent, its length the
	/// file's.
	pub move fn file(path: str): Request = {
		var request = self
		request.body = .File(String::of(path))
		return request
	}

	/// How many bytes an upload sends: `Content-Length`, which a server that
	/// will not take a body in chunks asks for. Fewer or more is an error.
	pub move fn length(count: i64): Request = {
		var request = self
		request.length = .Some(count)
		return request
	}

	/// `Content-Type: kind`, where none was given.
	move fn typed(kind: str): Request = {
		if self.has("Content-Type") then return self
		return self.header("Content-Type", kind)
	}

	/// Whether a header `name` was given, in any case.
	fn has(name: str): bool = self.headers.items().any((header) => sameName(header.name, name))
}

/// Whether two headers' names are one, as HTTP compares them: in any case.
fn sameName(a: str, b: str): bool = a.len() == b.len() && a.toAsciiLower() == b.toAsciiLower()
