// An HTTP/1.1 client. `http::get(url)` fetches a URL; a `Client` sends any
// `Request`, keeps its connections between requests, follows redirects and
// stops waiting when told. A body is read whole into a `Response`, or as it
// comes through an `Incoming`, which is an `io::Read`; one is sent from
// bytes, from a file as it is read, or from any `io::Read`. A status is an
// answer, not an error: a `404` is a `Response`, and an `HttpError` is what
// kept an answer from coming.

import std::io
import std::json
import std::tls::{TlsError}

/// What kept an answer from coming, or what came that is not one.
pub enum HttpError {
	/// The URL is not one the client sends to.
	InvalidUrl(reason: String)
	/// A header's name or value that would break the request: a line break
	/// in it, or no name.
	InvalidHeader(name: String)
	/// The connection, or the file a body was sent from, failed.
	Io(error: io::IoError)
	/// An `https` connection could not be made: its server's certificate,
	/// or its handshake.
	Tls(error: TlsError)
	/// Nothing came within the client's timeout.
	Timeout
	/// More redirects than the client follows.
	TooManyRedirects
	/// What came back is not HTTP.
	Malformed(reason: String)
	/// A body asked for as text that is not UTF-8.
	NotText
	/// A body asked for as JSON that is not the JSON of what it was read as.
	Json(error: json::DecodeError)
}

extend HttpError: Text {
	fn toString(): String = match self {
		.InvalidUrl(reason) => "invalid URL: \(reason)"
		.InvalidHeader(name) => "invalid header `\(name)`"
		.Io(error) => "\(error)"
		.Tls(error) => "\(error)"
		.Timeout => "timed out"
		.TooManyRedirects => "too many redirects"
		.Malformed(reason) => "not HTTP: \(reason)"
		.NotText => "the body is not UTF-8 text"
		.Json(error) => "the body is not the JSON asked for: \(error)"
	}
}

/// A request's method.
@derive(Eq, Clone, Text)
pub enum Method {
	Get
	Post
	Put
	Patch
	Delete
	Head
}

extend Method {
	/// As a request line writes it: `GET`.
	pub fn name(): str = match self {
		.Get => "GET"
		.Post => "POST"
		.Put => "PUT"
		.Patch => "PATCH"
		.Delete => "DELETE"
		.Head => "HEAD"
	}
}

/// A `GET` of `url`, by a client made for it, its body read whole.
pub fn get(url: str): Result<Response, HttpError> = {
	var client = Client()
	return client.get(url)
}

/// An I/O failure as the client says it: a read that waited longer than
/// the timeout is `Timeout`, and bytes that are not HTTP are `Malformed`.
fn failed(error: io::IoError): HttpError = match error {
	.TimedOut => .Timeout
	.InvalidData => .Malformed("the body is not what its headers say")
	other => .Io(other)
}
