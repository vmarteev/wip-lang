// Where a request goes, as the client sends to it: a `Url` asked for its
// scheme, `http` or `https`, its host, its port, and its path and query,
// which are sent as written. A fragment is the reader's, and is not sent;
// credentials in a URL are refused rather than sent in the clear.

import std::url::{Url}

/// Where a request goes.
@derive(Eq, Clone)
struct Target {
	/// `https`, where `http` is not.
	secure: bool
	/// A name, or an address; an IPv6 one without its brackets.
	host: String
	port: u16
	/// The path and the query: `/` where the URL has neither.
	target: String
}

extend Target {
	/// What `Host` says: the host, in brackets where it is an IPv6 address,
	/// and the port where it is not the scheme's.
	fn hostHeader(): String = {
		var out = if self.host.contains(":") then "[\(self.host)]" else String::of(self.host)
		val usual: u16 = if self.secure then 443 else 80
		if self.port != usual then
			out.push(":\(self.port)")

		return out
	}

	/// Which connections may carry a request to it.
	fn key(): String = "\(if self.secure then "https" else "http")://\(self.hostHeader())"
}

/// Where `url` leads, or why it cannot be sent to.
fn target(url: &Url): Result<Target, HttpError> = {
	val text = url.toStr()
	val secure = match url.scheme() {
		.Some(scheme) if scheme.toAsciiLower() == "http" => false
		.Some(scheme) if scheme.toAsciiLower() == "https" => true
		_ => return .Err(.InvalidUrl("`\(text)` is not an http or https URL"))
	}
	if url.userInfo().isSome() then
		return .Err(.InvalidUrl("credentials in a URL are not sent: `\(text)`"))

	val host = match url.host() {
		.Some(host) if !host.isEmpty() => host
		_ => return .Err(.InvalidUrl("no host: `\(text)`"))
	}
	var port: u16 = if secure then 443 else 80
	if url.portText() is .Some(written) && !written.isEmpty() {
		val .Some(number) = url.port() else return .Err(.InvalidUrl("port `\(written)`"))
		if number < 1 then
			return .Err(.InvalidUrl("port `\(written)`"))

		port = number
	}
	var path = String::of(url.path())
	if path.isEmpty() then
		path.push("/")

	if url.query() is .Some(query) {
		path.push("?")
		path.push(query)
	}
	return Target(secure:, host:, port:, target: path)
}

/// Where a redirect's `Location` leads from `base`: a URL of its own, one
/// with no scheme, a path on the same host, or a path beside `base`'s.
fn resolve(base: &Target, location: str): Result<Target, HttpError> = {
	val lower = location.toAsciiLower()
	if lower.startsWith("http://") || lower.startsWith("https://") then
		return target(parsed(location)?)

	val scheme = if base.secure then "https" else "http"
	if location.startsWith("//") then
		return target(parsed("\(scheme):\(location)")?)

	var moved = base.clone()
	if location.startsWith("/") then
		moved.target = location
	else {
		val path = match base.target.indexOf("?") {
			.Some(query) => base.target.toStr()[0..query]
			.None => base.target.toStr()
		}
		val directory = match path.lastIndexOf("/") {
			.Some(slash) => path[0..slash + 1]
			.None => "/"
		}
		moved.target = "\(directory)\(location)"
	}

	if moved.target.indexOf("#") is .Some(hash) then
		moved.target = moved.target.toStr()[0..hash]

	return moved
}

/// A `Location` read as a URL, or why it is not one.
fn parsed(location: str): Result<Url, HttpError> = match Url::parse(location) {
	.Ok(url) => url
	.Err(error) => .Err(.InvalidUrl("`\(location)`: \(error)"))
}
