// A body sent compressed, on Windows, which has no zlib: none is asked
// for — a request that says nothing of it would take any — so a server
// sends a body as it is, and one sent compressed all the same is refused.

/// What would undo a body sent compressed: never made here.
struct Decoder

extend Decoder {
	fn ended(): bool = true

	fn give(_: &[u8], _: &var Vec<u8>): Result<void, String> = .Err(
		"nothing undoes a compressed body here",
	)
}

/// What `Accept-Encoding` asks for, where the request does not say: the
/// body as it is.
val ACCEPTED_ENCODINGS: str = "identity"

/// Nothing, for a body sent as it is; a body sent compressed, which this
/// system cannot undo, is refused.
fn decoderOf(head: &Head, framing: &Framing): Result<Option<Decoder>, HttpError> = {
	if framing is .Nothing then
		return .Ok(.None)

	val .Some(encoding) = headerOf(&head.headers, "Content-Encoding") else return .Ok(.None)
	return match encoding.trim().toAsciiLower().toStr() {
		"gzip" | "x-gzip" | "deflate" => .Err(
			.Malformed("a body sent compressed, which Windows has no zlib to undo"),
		)
		_ => .Ok(.None)
	}
}
