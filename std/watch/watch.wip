// Watching files: a `Watcher` is told by the system when a file or a
// directory it watches changes, and answers which, when it is asked. It is
// FSEvents on a Mac and inotify on Linux; iOS has neither, and a watcher
// there cannot be made. A directory is watched for its entries, not for
// what is deeper; a file is watched through its directory, by its name, so
// that a file replaced under its name — as an editor saves — is still the
// file watched.
//
// It is a module of its own because FSEvents is in CoreServices, which a
// Mac program links only where it watches.

import std::fs
import std::io
import std::path

/// Files and directories watched, and what tells of their changes. Asked,
/// it answers which changed; it never waits.
pub struct Watcher {
	source: Source
	watched: Vec<Watched>
}

/// A path watched, as it was given.
struct Watched {
	path: String
	/// A file's name in its directory; none for a directory.
	name: Option<String>
	handle: Handle
	/// Told of since `changed` last answered it.
	fired: bool = false
}

extend Watcher {
	/// A watcher watching nothing yet; `.Unsupported` on a system that
	/// cannot watch.
	pub static fn new(): Result<Watcher, io::IoError> = Watcher(source: opened()?, watched: Vec())

	/// Watches `path`, a directory for what is made, written, renamed or
	/// removed in it, or a file for itself, written, removed or replaced.
	/// It must be there; watched already, it is one watch. What changed a
	/// moment before may be told of too, where the system's news of it
	/// arrives after.
	pub var fn watch(path: str): Result<void, io::IoError> = {
		if self.watched.any((one) => one.path == path) then return
		val about = fs::meta(path)?
		val name: Option<String> =
			if about.isDirectory() then .None else String::of(path::name(path))
		val directory: String = match name {
			.Some(..) =>
				if path::parent(path).isEmpty() then String::of(".")
				else String::of(path::parent(path))
			.None => String::of(path)
		}
		val handle = started(&var self.source, directory, &name)?
		self.watched.push(Watched(path: String::of(path), name: name, handle: handle))
	}

	/// No longer watches `path`.
	pub var fn unwatch(path: str) = {
		val .Some(at) = self.watched.items().indexWhere((one) => one.path == path) else return
		val gone = self.watched.remove(at)
		stopped(&var self.source, gone.handle, &self.watched.items())
	}

	/// Each path watched that changed since it was last asked, once, as it
	/// was given and in the order it was watched. Where the system lost
	/// track of what changed, every one. It never waits.
	pub var fn changed(): Vec<String> = {
		gathered(&var self.source, &var self.watched.items())
		var out: Vec<String> = Vec()
		for i in 0..self.watched.len() {
			if !self.watched[i].fired then continue
			self.watched[i].fired = false
			out.push(self.watched[i].path.clone())
		}
		return out
	}

	/// Whether `changed` would answer anything, which it leaves to answer.
	pub fn pending(): bool =
		self.watched.any((one) => one.fired) || waiting(&self.source, &self.watched.items())

	/// A descriptor that is ready to read while a change waits to be
	/// answered: what an event queue waits on, beside a program's sockets.
	pub fn descriptor(): i32 = descriptorOf(&self.source)
}

extend Watcher: Destroy {
	var fn destroy() = {
		while self.watched.pop() is .Some(gone) {
			stopped(&var self.source, gone.handle, &self.watched.items())
		}
		closed(&var self.source)
	}
}
