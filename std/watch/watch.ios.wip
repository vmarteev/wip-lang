// iOS has no way for an app to watch files: a watcher cannot be made there.

import std::io

struct Source

struct Handle

fn opened(): Result<Source, io::IoError> = .Err(.Unsupported)

fn closed(source: &var Source) = {}

fn descriptorOf(source: &Source): i32 = -1

fn started(
	source: &var Source,
	directory: str,
	name: &Option<String>,
): Result<Handle, io::IoError> = .Err(.Unsupported)

fn stopped(source: &var Source, handle: Handle, others: &[Watched]) = {}

fn gathered(source: &var Source, watched: &var [Watched]) = {}

fn waiting(source: &Source, watched: &[Watched]): bool = false
