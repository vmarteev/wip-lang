// iOS has no way for an app to watch files: a watcher cannot be made there.

import std::io

struct Source

struct Handle

fn opened(): Result<Source, io::IoError> = .Err(.Unsupported)

fn closed(_: &var Source) = {}

fn descriptorOf(_: &Source): i32 = -1

fn started(_: &var Source, _: str, _: &Option<String>): Result<Handle, io::IoError> = .Err(
	.Unsupported,
)

fn stopped(_: &var Source, _: Handle, _: &[Watched]) = {}

fn gathered(_: &var Source, _: &var [Watched]) = {}

fn waiting(_: &Source, _: &[Watched]): bool = false
