// Random numbers, for what is not cryptography: a game's dice, a test's
// input, a shuffled deck. Nothing here is fit to make a key or a password,
// which an attacker must not guess: what a generator answers next follows
// from what it has answered, by arithmetic anyone can run.
//
// The generator is xoshiro256**, with 256 bits of state, of the family
// Rust's `SmallRng` and Java's LXM generators come from. A seed is spread
// into the state by SplitMix64, as its authors advise, so that two seeds
// close together still start far apart.

import std::libc
import std::math::{TAU, TAU_F32, Vec2, Vec3}

/// A generator: the same seed answers the same numbers, on every machine
/// and every run.
pub struct Random {
	state: [u64; 4]
}

extend Random {
	/// A generator that answers the same numbers whenever it is seeded
	/// with `seed`: for a test, or a game that is played again.
	pub static fn seeded(seed: u64): Random = {
		var spread = seed
		var state = [0 as u64; 4]
		for i in 0..4 {
			state[i] = splitMix(&var spread)
		}
		return Random(state)
	}

	/// A generator seeded by the system, different on every run. It panics
	/// where the system has no randomness to give, which a system that runs
	/// Wip always has.
	pub static fn fromEntropy(): Random = {
		var bytes = [0 as u8; 32]
		if libc::getentropy(&var bytes) != 0 then
			panic("the system gave no randomness to seed with")
		var state = [0 as u64; 4]
		for i in 0..32 {
			state[i / 8] = state[i / 8] | ((bytes[i] as u64) << ((i % 8) * 8) as u64)
		}
		// A state of zeros answers zeros for ever; the chance of it is
		// one in 2^256, and it is seeded again rather than kept.
		if state[0] | state[1] | state[2] | state[3] == 0 then return Random::seeded(0)
		return Random(state)
	}

	/// The next 64 random bits.
	pub var fn next(): u64 = {
		var s = self.state
		val result = (s[1] *% 5).rotateLeft(7) *% 9
		val t = s[1] << 17
		s[2] = s[2] ^ s[0]
		s[3] = s[3] ^ s[1]
		s[1] = s[1] ^ s[2]
		s[0] = s[0] ^ s[3]
		s[2] = s[2] ^ t
		s[3] = s[3].rotateLeft(45)
		self.state = s
		return result
	}

	/// A number from 0 up to, not including, `count`, each as likely as any
	/// other. It panics where `count` is not above 0, as there is no number
	/// to answer.
	pub var fn below(count: i64): i64 = {
		if count <= 0 then panic("a number below \(count) is chosen from nothing")
		return self.belowBits(count as u64) as i64
	}

	/// A number from `low` up to, not including, `high`, as a range
	/// `low..high` is, each as likely as any other. It panics where the
	/// range is empty.
	pub var fn inRange(low: i64, high: i64): i64 = {
		if low >= high then panic("a number in \(low)..\(high) is chosen from nothing")
		// The width of the range, which may be more than an `i64` holds.
		val width = (high as u64) -% (low as u64)
		return ((low as u64) +% self.belowBits(width)) as i64
	}

	/// A float from 0.0 up to, not including, 1.0: 53 random bits, as many
	/// as a float's fraction holds, so each is as likely as any other.
	pub var fn float(): f64 = (self.next() >> 11) as f64 * (1.0 / 9007199254740992.0)

	/// True or false, each as likely.
	pub var fn bool(): bool = self.next() >> 63 == 1

	/// A float from `low` up to, not including, `high`. It panics where
	/// the range is empty.
	pub var fn floatIn(low: f64, high: f64): f64 = {
		if !(low < high) then panic("a float in \(low)..\(high) is chosen from nothing")
		while true {
			val chosen = low + (high - low) * self.float()
			// Rounding may land on `high`, which is not in the range.
			if chosen < high then return chosen
		}
		return low
	}

	/// An `f32` from 0.0 up to, not including, 1.0: 24 random bits, as many
	/// as an `f32`'s fraction holds.
	pub var fn f32(): f32 = (self.next() >> 40) as f32 * (1.0 / 16777216.0)

	/// An `f32` from `low` up to, not including, `high`. It panics where
	/// the range is empty.
	pub var fn f32In(low: f32, high: f32): f32 = {
		if !(low < high) then panic("a float in \(low)..\(high) is chosen from nothing")
		while true {
			val chosen = low + (high - low) * self.f32()
			if chosen < high then return chosen
		}
		return low
	}

	/// A point on the circle of radius 1, each as likely: a direction in a
	/// plane.
	pub var fn onCircle(): Vec2 = {
		val angle = self.f32() * TAU_F32
		return Vec2::of(angle.cos(), angle.sin())
	}

	/// A point in the disk of radius 1, each as likely: the radius is the
	/// square root of a uniform number, so the rim, which is longer, is
	/// chosen as much more often as it is longer.
	pub var fn inDisk(): Vec2 = self.onCircle() * self.f32().sqrt()

	/// A point on the sphere of radius 1, each as likely: a direction in
	/// space. Its height is uniform, as Archimedes showed a sphere's area is
	/// along its axis.
	pub var fn onSphere(): Vec3 = {
		val z = self.f32() * 2.0 - 1.0
		val radius = (1.0 - z * z).max(0.0).sqrt()
		val angle = self.f32() * TAU_F32
		return Vec3::of(radius * angle.cos(), radius * angle.sin(), z)
	}

	/// A point in the ball of radius 1, each as likely: points of the cube
	/// around it, drawn until one is inside.
	pub var fn inSphere(): Vec3 = {
		while true {
			val point = Vec3::of(
				self.f32() * 2.0 - 1.0,
				self.f32() * 2.0 - 1.0,
				self.f32() * 2.0 - 1.0,
			)
			if point.lengthSquared() <= 1.0 then return point
		}
		return Vec3::zero()
	}

	/// One of the items, each as likely; nothing where there are none.
	pub var fn pick<T>(items: &[T]): Option<&T> =
		if items.isEmpty() then .None else .Some(&items[self.below(items.len())])

	/// An index into `weights`, each as likely as its weight is of their
	/// sum: a loot table, a choice of moves. A weight below 0 counts as 0,
	/// and nothing is chosen where none is above 0.
	pub var fn weighted(weights: &[f64]): Option<i64> = {
		var total = 0.0
		for weight in weights {
			if weight > 0.0 then total += weight
		}
		if !(total > 0.0) || !total.isFinite() then return .None
		var left = self.float() * total
		var last: Option<i64> = .None
		for i in 0..weights.len() {
			val weight = weights[i]
			if !(weight > 0.0) then continue
			if left < weight then return .Some(i)
			left -= weight
			last = .Some(i)
		}
		// Rounding may leave a sliver past the last weight: it is the last's.
		return last
	}

	/// A number from the normal distribution of mean `mean` and standard
	/// deviation `deviation`, the bell curve: what heights and errors are
	/// spread as. Box and Muller's way, from two uniform numbers.
	pub var fn gaussian(mean: f64 = 0.0, deviation: f64 = 1.0): f64 = {
		// One minus a uniform number, which is never 0, whose logarithm is
		// finite.
		val u = 1.0 - self.float()
		val v = self.float()
		return mean + deviation * (-2.0 * u.ln()).sqrt() * (TAU * v).cos()
	}

	/// The elements put in an order each as likely as any other, where they
	/// are: Fisher and Yates's shuffle.
	pub var fn shuffle<T>(items: &var [T]) = {
		var i = items.len() - 1
		while i > 0 {
			items.swap(i, self.below(i + 1))
			i -= 1
		}
	}

	/// A number below `count`, which is more than 0, each as likely: the
	/// high half of a random number times `count`, with the few that would
	/// favour some numbers drawn again, as Lemire showed.
	var fn belowBits(count: u64): u64 = {
		var product = self.next() * (count as u128)
		var low = product as u64
		if low < count {
			// How many of the 2^64 random numbers are one too many for each
			// answer to be as likely.
			val surplus = (0 -% count) % count
			while low < surplus {
				product = self.next() * (count as u128)
				low = product as u64
			}
		}
		return (product >> 64) as u64
	}
}

/// SplitMix64's next number from `state`, which it moves on: what spreads
/// a seed through the generator's state.
fn splitMix(state: &var u64): u64 = {
	state = state +% 0x9E3779B97F4A7C15
	var z = state
	z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9
	z = (z ^ (z >> 27)) *% 0x94D049BB133111EB
	return z ^ (z >> 31)
}
