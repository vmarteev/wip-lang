// Base64: bytes written as text that any channel for text carries — mail,
// JSON, a header, a URL — each three bytes as four of 64 characters, as
// RFC 4648 has them. The standard alphabet ends with `+` and `/`; the one
// for URLs and file names, with `-` and `_`. `=` pads the last four where
// the bytes ran out; a format that leaves it out, as a JSON Web Token
// does, is written with `padded: false`, and is read either way.

/// Which 64 characters stand for six bits.
pub enum Alphabet {
	/// `A` to `Z`, `a` to `z`, `0` to `9`, `+` and `/`.
	Standard
	/// The same with `-` and `_` for `+` and `/`, which a URL and a file
	/// name may hold as they are.
	Url
}

/// Why text is not base64: the byte at `at` is not of the alphabet, or the
/// text ends part way through a byte.
@derive(Eq, Clone)
pub enum Base64Error {
	NotInAlphabet(at: i64)
	CutShort
}

extend Base64Error: Text {
	fn toString(): String = match self {
		.NotInAlphabet(at) => "not base64: the byte at \(at) is not of its alphabet"
		.CutShort => "not base64: it ends part way through a byte"
	}
}

val STANDARD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
val URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

/// `bytes` as base64: `base64::encode(&bytes)`, or
/// `base64::encode(&bytes, alphabet: .Url, padded: false)`.
pub fn encode(bytes: &[u8], alphabet: Alphabet = .Standard, padded: bool = true): String = {
	val table = match alphabet {
		.Standard => STANDARD
		.Url => URL
	}
	var out = String::withCapacity((bytes.len() + 2) / 3 * 4)
	var at = 0
	while at + 3 <= bytes.len() {
		val group = (bytes[at] as i64 << 16) | (bytes[at + 1] as i64 << 8) | bytes[at + 2] as i64
		out.pushByte(table[group >> 18])
		out.pushByte(table[(group >> 12) & 63])
		out.pushByte(table[(group >> 6) & 63])
		out.pushByte(table[group & 63])
		at += 3
	}
	val left = bytes.len() - at
	if left == 0 then return out
	val group = (bytes[at] as i64 << 16) | (if left == 2 then bytes[at + 1] as i64 << 8 else 0)
	out.pushByte(table[group >> 18])
	out.pushByte(table[(group >> 12) & 63])
	if left == 2 then out.pushByte(table[(group >> 6) & 63])
	if padded then out.push(if left == 2 then "=" else "==")
	return out
}

/// The bytes `text` stands for, in `alphabet`, with its padding or without.
/// Anything else — a space, a line break, a character of the other
/// alphabet — is an error, not skipped.
pub fn decode(text: str, alphabet: Alphabet = .Standard): Result<Vec<u8>, Base64Error> = {
	// Padding ends a text of whole fours; an `=` anywhere else is a byte
	// not of the alphabet.
	var end = text.len()
	if end % 4 == 0 && end > 0 && text[end - 1] == b'=' {
		end -= 1
		if text[end - 1] == b'=' then end -= 1
	}
	var out: Vec<u8> = Vec::withCapacity(end / 4 * 3 + 2)
	var group = 0
	var held = 0
	for at in 0..end {
		val value = valueOf(text[at], &alphabet)
		if value < 0 then return .Err(.NotInAlphabet(at))
		group = (group << 6) | value
		held += 1
		if held == 4 {
			out.push((group >> 16) as u8)
			out.push((group >> 8) as u8)
			out.push(group as u8)
			group = 0
			held = 0
		}
	}
	// Two or three characters left are one or two bytes, and the bits past
	// them are not read; one alone is part of a byte.
	if held == 1 then return .Err(.CutShort)
	if held == 2 then out.push((group >> 4) as u8)
	if held == 3 {
		out.push((group >> 10) as u8)
		out.push((group >> 2) as u8)
	}
	return .Ok(out)
}

/// The six bits `byte` stands for in `alphabet`, or -1.
fn valueOf(byte: u8, alphabet: &Alphabet): i64 = {
	if byte is b'A'..=b'Z' then return (byte - b'A') as i64
	if byte is b'a'..=b'z' then return (byte - b'a') as i64 + 26
	if byte is b'0'..=b'9' then return (byte - b'0') as i64 + 52
	val (last, end) = match alphabet {
		.Standard => (b'+', b'/')
		.Url => (b'-', b'_')
	}
	return if byte == last then 62 else if byte == end then 63 else -1
}
