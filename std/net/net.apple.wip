// A Mac's and iOS's sockets, as they lay them out and number their
// options.

import std::libc

extern struct AddrInfo {
	flags: c_int
	family: c_int
	socktype: c_int
	protocol: c_int
	addressLength: u32
	canonicalName: ptr<u8>
	address: ptr<u8>
	next: ptr<AddrInfo>
}

// A socket and a connection accepted are closed in a program started,
// from the moment they are made: a Mac marks them once made, and starts a
// program with every descriptor closed but those it is given, so no
// program another thread starts in between is given them.

fn openSocket(family: c_int, kind: c_int, protocol: c_int): c_int = {
	val fd = socket(family, kind, protocol)
	if fd >= 0 then libc::closeOnExec(fd)
	return fd
}

fn accepted(fd: c_int, address: &var SockAddr, length: &var u32): c_int = {
	val got = accept(fd, &var address, &var length)
	if got >= 0 then libc::closeOnExec(got)
	return got
}

val AF_INET6: c_int = 30

val SOL_SOCKET: c_int = 0xffff

/// What a socket's connection that did not wait failed with, once it is
/// done.
val SO_ERROR: c_int = 0x1007

/// A connection begun on a socket that does not wait, still being made.
val EINPROGRESS: c_int = 36

val SO_REUSEADDR: c_int = 4

/// A Mac's socket option for a write to a closed connection to fail with
/// `EPIPE`, not deliver `SIGPIPE`.
val SO_NOSIGPIPE: c_int = 0x1022

/// What each write passes: nothing, since the socket says it.
val SEND_FLAGS: c_int = 0

val SOMAXCONN: c_int = 128

val AI_NUMERICSERV: c_int = 0x1000

/// What `getaddrinfo` answers for a host it cannot find.
val EAI_NONAME: c_int = 8

/// The longest path a Unix-domain socket may have, without its NUL.
val UNIX_PATH_MOST: i64 = 103

/// A new connection's socket, made to answer `EPIPE` for a write the other
/// end will not read, where the system says so per socket.
fn quiet(fd: c_int) = setOption(fd, SO_NOSIGPIPE)

/// The family's place: a Mac's address starts with its length and a byte
/// of family.
fn setFamily(address: &var SockAddr, family: c_int, length: u8) = {
	address.bytes[0] = length
	address.bytes[1] = family as u8
}

fn familyOf(address: &SockAddr): c_int = address.bytes[1]
