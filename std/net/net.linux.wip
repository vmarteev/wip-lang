// Linux's sockets, as it lays them out and numbers their options.

import std::bytes

extern struct AddrInfo {
	flags: c_int
	family: c_int
	socktype: c_int
	protocol: c_int
	addressLength: u32
	address: ptr<u8>
	canonicalName: ptr<u8>
	next: ptr<AddrInfo>
}

// A socket and a connection accepted are closed in a program started,
// from the moment they are made: Linux marks them so as it makes them.

extern "C" {
	fn accept4(fd: c_int, address: &var SockAddr, length: &var u32, flags: c_int): c_int
}

/// `socket` and `accept4`: made closed in a program started.
val SOCK_CLOEXEC: c_int = 524288

fn openSocket(family: c_int, kind: c_int, protocol: c_int): c_int = socket(
	family,
	kind | SOCK_CLOEXEC,
	protocol,
)

fn accepted(fd: c_int, address: &var SockAddr, length: &var u32): c_int = accept4(
	fd,
	&var address,
	&var length,
	SOCK_CLOEXEC,
)

val AF_INET6: c_int = 10

val SOL_SOCKET: c_int = 1

/// What a socket's connection that did not wait failed with, once it is
/// done.
val SO_ERROR: c_int = 4

/// A connection begun on a socket that does not wait, still being made.
val EINPROGRESS: c_int = 115

val SO_REUSEADDR: c_int = 2

/// `MSG_NOSIGNAL`, which each write passes, for a write to a closed
/// connection to fail with `EPIPE`, not deliver `SIGPIPE`.
val SEND_FLAGS: c_int = 0x4000

val SOMAXCONN: c_int = 4096

val AI_NUMERICSERV: c_int = 0x400

/// What `getaddrinfo` answers for a host it cannot find.
val EAI_NONAME: c_int = -2

/// The longest path a Unix-domain socket may have, without its NUL.
val UNIX_PATH_MOST: i64 = 107

/// A new connection's socket, which needs nothing: each write says it.
fn quiet(_: c_int) = {}

/// The family's place: Linux's address starts with two bytes of family.
fn setFamily(address: &var SockAddr, family: c_int, _: u8) = {
	address.bytes[0] = family as u8
	address.bytes[1] = 0
}

fn familyOf(address: &SockAddr): c_int = bytes::u16le(&address.bytes, 0) as c_int
