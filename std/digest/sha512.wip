// SHA-512, as FIPS 180-4 defines it, written in Wip: SHA-256's design over
// 64-bit words, in blocks of 128 bytes.

import std::bytes

/// The SHA-512 digest of `bytes`: what npm's lockfile names a package's
/// contents by.
pub fn sha512(bytes: &[u8]): [u8; 64] = {
	var running = Sha512()
	running.write(&bytes)
	return running.finish()
}

/// A SHA-512 digest of bytes that come in pieces, as `Sha256` is: each
/// written in turn, and then finished.
pub struct Sha512 {
	state: [u64; 8] = [
		0x6A09E667F3BCC908, 0xBB67AE8584CAA73B, 0x3C6EF372FE94F82B, 0xA54FF53A5F1D36F1,
		0x510E527FADE682D1, 0x9B05688C2B3E6C1F, 0x1F83D9ABFB41BD6B, 0x5BE0CD19137E2179,
	]
	/// The block being filled, and how much of it is.
	block: [u8; 128] = [0; 128]
	filled: i64 = 0
	/// How many bytes were written, all told.
	length: u64 = 0
}

extend Sha512 {
	/// The bytes, after those written before.
	pub var fn write(bytes: &[u8]) = {
		var at = 0
		while self.filled != 0 && at < bytes.len() {
			self.push(bytes[at])
			at += 1
		}
		while bytes.len() - at >= 128 {
			self.compress(&bytes[at..at + 128])
			at += 128
		}
		while at < bytes.len() {
			self.push(bytes[at])
			at += 1
		}
		self.length +%= bytes.len() as u64
	}

	/// The digest of everything written: the input padded with a one bit,
	/// zeros, and its length in bits as 128 bits, as the standard says.
	pub move fn finish(): [u8; 64] = {
		var done = move self
		val high = done.length >> 61
		val bits = done.length *% 8
		done.push(0x80)
		while done.filled != 112 do
			done.push(0)

		for i in 0..8 do
			done.push((high >> ((56 - 8 * i) as u64)) as% u8)

		for i in 0..8 do
			done.push((bits >> ((56 - 8 * i) as u64)) as% u8)

		var out = [0 as u8; 64]
		for i in 0..8 {
			for j in 0..8 do
				out[8 * i + j] = (done.state[i] >> ((56 - 8 * j) as u64)) as% u8
		}
		return out
	}

	/// One byte into the block, which is mixed in where it is full.
	var fn push(byte: u8) = {
		self.block[self.filled] = byte
		self.filled += 1
		if self.filled == 128 {
			val block = self.block
			self.compress(&block)
			self.filled = 0
		}
	}

	/// A block of 128 bytes mixed into the state: its sixteen words
	/// stretched to eighty, and eighty rounds.
	var fn compress(block: &[u8]) = {
		var w = [0 as u64; 80]
		for i in 0..16 do
			w[i] = bytes::u64be(&block, 8 * i)

		for i in 16..80 {
			val s0 = w[i - 15].rotateRight(1) ^ w[i - 15].rotateRight(8) ^ (w[i - 15] >> 7)
			val s1 = w[i - 2].rotateRight(19) ^ w[i - 2].rotateRight(61) ^ (w[i - 2] >> 6)
			w[i] = w[i - 16] +% s0 +% w[i - 7] +% s1
		}
		var a = self.state[0]
		var b = self.state[1]
		var c = self.state[2]
		var d = self.state[3]
		var e = self.state[4]
		var f = self.state[5]
		var g = self.state[6]
		var h = self.state[7]
		for i in 0..80 {
			val sum1 = e.rotateRight(14) ^ e.rotateRight(18) ^ e.rotateRight(41)
			val choose = (e & f) ^ (!e & g)
			val first = h +% sum1 +% choose +% ROUNDS_512[i] +% w[i]
			val sum0 = a.rotateRight(28) ^ a.rotateRight(34) ^ a.rotateRight(39)
			val most = (a & b) ^ (a & c) ^ (b & c)
			val second = sum0 +% most
			h = g
			g = f
			f = e
			e = d +% first
			d = c
			c = b
			b = a
			a = first +% second
		}
		self.state[0] +%= a
		self.state[1] +%= b
		self.state[2] +%= c
		self.state[3] +%= d
		self.state[4] +%= e
		self.state[5] +%= f
		self.state[6] +%= g
		self.state[7] +%= h
	}
}

/// The round constants: the first 64 bits of the fractional parts of the
/// cube roots of the first 80 primes.
val ROUNDS_512: [u64; 80] = [
	0x428A2F98D728AE22, 0x7137449123EF65CD, 0xB5C0FBCFEC4D3B2F, 0xE9B5DBA58189DBBC,
	0x3956C25BF348B538, 0x59F111F1B605D019, 0x923F82A4AF194F9B, 0xAB1C5ED5DA6D8118,
	0xD807AA98A3030242, 0x12835B0145706FBE, 0x243185BE4EE4B28C, 0x550C7DC3D5FFB4E2,
	0x72BE5D74F27B896F, 0x80DEB1FE3B1696B1, 0x9BDC06A725C71235, 0xC19BF174CF692694,
	0xE49B69C19EF14AD2, 0xEFBE4786384F25E3, 0x0FC19DC68B8CD5B5, 0x240CA1CC77AC9C65,
	0x2DE92C6F592B0275, 0x4A7484AA6EA6E483, 0x5CB0A9DCBD41FBD4, 0x76F988DA831153B5,
	0x983E5152EE66DFAB, 0xA831C66D2DB43210, 0xB00327C898FB213F, 0xBF597FC7BEEF0EE4,
	0xC6E00BF33DA88FC2, 0xD5A79147930AA725, 0x06CA6351E003826F, 0x142929670A0E6E70,
	0x27B70A8546D22FFC, 0x2E1B21385C26C926, 0x4D2C6DFC5AC42AED, 0x53380D139D95B3DF,
	0x650A73548BAF63DE, 0x766A0ABB3C77B2A8, 0x81C2C92E47EDAEE6, 0x92722C851482353B,
	0xA2BFE8A14CF10364, 0xA81A664BBC423001, 0xC24B8B70D0F89791, 0xC76C51A30654BE30,
	0xD192E819D6EF5218, 0xD69906245565A910, 0xF40E35855771202A, 0x106AA07032BBD1B8,
	0x19A4C116B8D2D0C8, 0x1E376C085141AB53, 0x2748774CDF8EEB99, 0x34B0BCB5E19B48A8,
	0x391C0CB3C5C95A63, 0x4ED8AA4AE3418ACB, 0x5B9CCA4F7763E373, 0x682E6FF3D6B2B8A3,
	0x748F82EE5DEFB2FC, 0x78A5636F43172F60, 0x84C87814A1F0AB72, 0x8CC702081A6439EC,
	0x90BEFFFA23631E28, 0xA4506CEBDE82BDE9, 0xBEF9A3F7B2C67915, 0xC67178F2E372532B,
	0xCA273ECEEA26619C, 0xD186B8C721C0C207, 0xEADA7DD6CDE0EB1E, 0xF57D4F7FEE6ED178,
	0x06F067AA72176FBA, 0x0A637DC5A2C898A6, 0x113F9804BEF90DAE, 0x1B710B35131C471B,
	0x28DB77F523047D84, 0x32CAAB7B40C72493, 0x3C9EBE0A15C9BEBC, 0x431D67C49C100D4C,
	0x4CC5D4BECB3E42B6, 0x597F299CFC657E2A, 0x5FCB6FAB3AD6FAEC, 0x6C44198C4A475817,
]
