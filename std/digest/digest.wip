// Digests: a fixed number of bytes made from any number, which change
// wherever the input does — what a cache is named by, or a download
// checked against. SHA-256, as FIPS 180-4 defines it, written in Wip.

/// The SHA-256 digest of `bytes`: `digest::sha256(&text)`.
pub fn sha256(bytes: &[u8]): [u8; 32] = {
	var running = Sha256()
	running.write(bytes)
	return running.finish()
}

/// A SHA-256 digest of bytes that come in pieces: each written in turn,
/// and then finished. `Sha256()` is one with nothing written yet.
pub struct Sha256 {
	state: [u32; 8] = [
		0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB,
		0x5BE0CD19,
	]
	/// The block being filled, and how much of it is.
	block: [u8; 64] = [0; 64]
	filled: i64 = 0
	/// How many bytes were written, all told.
	length: u64 = 0
}

extend Sha256 {
	/// The bytes, after those written before: a block begun before is
	/// filled first, each whole block after it is mixed in from `bytes`
	/// where it lies, and what is left begins the next.
	pub var fn write(bytes: &[u8]) = {
		var at = 0
		while self.filled != 0 && at < bytes.len() {
			self.push(bytes[at])
			at += 1
		}
		while bytes.len() - at >= 64 {
			self.compress(&bytes[at..at + 64])
			at += 64
		}
		while at < bytes.len() {
			self.push(bytes[at])
			at += 1
		}
		self.length +%= bytes.len() as u64
	}

	/// The digest of everything written: the input padded with a one bit,
	/// zeros, and its length in bits, as the standard says.
	pub move fn finish(): [u8; 32] = {
		var done = move self
		val bits = done.length *% 8
		done.push(0x80)
		while done.filled != 56 {
			done.push(0)
		}
		for i in 0..8 {
			done.push((bits >> ((56 - 8 * i) as u64)) as u8)
		}
		var out = [0 as u8; 32]
		for i in 0..8 {
			for j in 0..4 {
				out[4 * i + j] = (done.state[i] >> ((24 - 8 * j) as u32)) as u8
			}
		}
		return out
	}

	/// One byte into the block, which is mixed in where it is full.
	var fn push(byte: u8) = {
		self.block[self.filled] = byte
		self.filled += 1
		if self.filled == 64 {
			val block = self.block
			self.compress(&block)
			self.filled = 0
		}
	}

	/// A block of 64 bytes mixed into the state: its sixteen words stretched
	/// to sixty-four, and sixty-four rounds.
	var fn compress(block: &[u8]) = {
		var w = [0 as u32; 64]
		for i in 0..16 {
			w[i] =
				(block[4 * i] as u32) << 24 |
					(block[4 * i + 1] as u32) << 16 |
					(block[4 * i + 2] as u32) << 8 |
					block[4 * i + 3] as u32
		}
		for i in 16..64 {
			val s0 = w[i - 15].rotateRight(7) ^ w[i - 15].rotateRight(18) ^ (w[i - 15] >> 3)
			val s1 = w[i - 2].rotateRight(17) ^ w[i - 2].rotateRight(19) ^ (w[i - 2] >> 10)
			w[i] = w[i - 16] +% s0 +% w[i - 7] +% s1
		}
		var a = self.state[0]
		var b = self.state[1]
		var c = self.state[2]
		var d = self.state[3]
		var e = self.state[4]
		var f = self.state[5]
		var g = self.state[6]
		var h = self.state[7]
		for i in 0..64 {
			val sum1 = e.rotateRight(6) ^ e.rotateRight(11) ^ e.rotateRight(25)
			val choose = (e & f) ^ (!e & g)
			val first = h +% sum1 +% choose +% ROUNDS[i] +% w[i]
			val sum0 = a.rotateRight(2) ^ a.rotateRight(13) ^ a.rotateRight(22)
			val most = (a & b) ^ (a & c) ^ (b & c)
			val second = sum0 +% most
			h = g
			g = f
			f = e
			e = d +% first
			d = c
			c = b
			b = a
			a = first +% second
		}
		self.state[0] +%= a
		self.state[1] +%= b
		self.state[2] +%= c
		self.state[3] +%= d
		self.state[4] +%= e
		self.state[5] +%= f
		self.state[6] +%= g
		self.state[7] +%= h
	}
}

/// The round constants: the first 32 bits of the fractional parts of the
/// cube roots of the first 64 primes.
val ROUNDS: [u32; 64] = [
	0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5, 0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
	0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3, 0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
	0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC, 0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
	0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7, 0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
	0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13, 0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
	0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3, 0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
	0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5, 0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
	0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208, 0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2,
]
