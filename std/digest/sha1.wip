// SHA-1, as FIPS 180-4 defines it, written in Wip. It is broken for
// signatures, and kept for the formats that name data by it.

import std::bytes

/// The SHA-1 digest of `bytes`. SHA-1 is broken for signatures: two inputs
/// with the same digest are made at will, so nothing is signed or trusted
/// by it. It is here for the formats that name data by it: a git object,
/// WebSocket's handshake, a one-time code.
pub fn sha1(bytes: &[u8]): [u8; 20] = {
	var running = Sha1()
	running.write(&bytes)
	return running.finish()
}

/// A SHA-1 digest of bytes that come in pieces, as `Sha256` is: each
/// written in turn, and then finished. Broken for signatures, as `sha1`
/// says.
pub struct Sha1 {
	state: [u32; 5] = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0]
	/// The block being filled, and how much of it is.
	block: [u8; 64] = [0; 64]
	filled: i64 = 0
	/// How many bytes were written, all told.
	length: u64 = 0
}

extend Sha1 {
	/// The bytes, after those written before.
	pub var fn write(bytes: &[u8]) = {
		var at = 0
		while self.filled != 0 && at < bytes.len() {
			self.push(bytes[at])
			at += 1
		}
		while bytes.len() - at >= 64 {
			self.compress(&bytes[at..at + 64])
			at += 64
		}
		while at < bytes.len() {
			self.push(bytes[at])
			at += 1
		}
		self.length +%= bytes.len() as u64
	}

	/// The digest of everything written, padded as SHA-256's is.
	pub move fn finish(): [u8; 20] = {
		var done = move self
		val bits = done.length *% 8
		done.push(0x80)
		while done.filled != 56 do
			done.push(0)

		for i in 0..8 do
			done.push((bits >> ((56 - 8 * i) as u64)) as% u8)

		var out = [0 as u8; 20]
		for i in 0..5 {
			for j in 0..4 do
				out[4 * i + j] = (done.state[i] >> ((24 - 8 * j) as u32)) as% u8
		}
		return out
	}

	/// One byte into the block, which is mixed in where it is full.
	var fn push(byte: u8) = {
		self.block[self.filled] = byte
		self.filled += 1
		if self.filled == 64 {
			val block = self.block
			self.compress(&block)
			self.filled = 0
		}
	}

	/// A block of 64 bytes mixed into the state: its sixteen words stretched
	/// to eighty, and eighty rounds in four kinds of twenty.
	var fn compress(block: &[u8]) = {
		var w = [0 as u32; 80]
		for i in 0..16 do
			w[i] = bytes::u32be(&block, 4 * i)

		for i in 16..80 do
			w[i] = (w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]).rotateLeft(1)

		var a = self.state[0]
		var b = self.state[1]
		var c = self.state[2]
		var d = self.state[3]
		var e = self.state[4]
		for i in 0..80 {
			val (mixed, constant) = when {
				i < 20 => ((b & c) | (!b & d), 0x5A827999 as u32)
				i < 40 => (b ^ c ^ d, 0x6ED9EBA1 as u32)
				i < 60 => ((b & c) | (b & d) | (c & d), 0x8F1BBCDC as u32)
				else => (b ^ c ^ d, 0xCA62C1D6 as u32)
			}
			val next = a.rotateLeft(5) +% mixed +% e +% constant +% w[i]
			e = d
			d = c
			c = b.rotateLeft(30)
			b = a
			a = next
		}
		self.state[0] +%= a
		self.state[1] +%= b
		self.state[2] +%= c
		self.state[3] +%= d
		self.state[4] +%= e
	}
}
