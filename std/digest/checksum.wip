// Checksums: four bytes that change wherever the input does, to find what
// a copy or a wire got wrong, not what someone changed on purpose. CRC-32,
// which gzip, zip and PNG end their data with, and Adler-32, which a zlib
// stream does.

import std::bytes

/// The CRC-32 of `bytes`, as gzip, zip and PNG have it:
/// `digest::crc32(&data)`.
pub fn crc32(bytes: &[u8]): u32 = {
	var running = Crc32()
	running.write(bytes)
	return running.value()
}

/// The Adler-32 of `bytes`, as a zlib stream has it: `digest::adler32(&data)`.
pub fn adler32(bytes: &[u8]): u32 = {
	var running = Adler32()
	running.write(bytes)
	return running.value()
}

/// A CRC-32 of bytes that come in pieces, each written in turn. Its value
/// may be read after any of them; `Crc32()` is one with nothing written yet.
pub struct Crc32 {
	/// The remainder so far, its bits the other way about, as the
	/// polynomial is taken.
	remainder: u32 = 0xFFFFFFFF
}

extend Crc32 {
	/// The bytes, after those written before: eight at a time, each of
	/// the eight through a table of its own, and what is left a byte at a
	/// time.
	pub var fn write(bytes: &[u8]) = {
		var c = self.remainder
		var at = 0
		while bytes.len() - at >= 8 {
			val low = bytes::u32le(bytes, at) ^ c
			val high = bytes::u32le(bytes, at + 4)
			c =
				CRC_TABLES[7][(low & 0xFF) as i64] ^
					CRC_TABLES[6][(low >> 8 & 0xFF) as i64] ^
					CRC_TABLES[5][(low >> 16 & 0xFF) as i64] ^
					CRC_TABLES[4][(low >> 24) as i64] ^
					CRC_TABLES[3][(high & 0xFF) as i64] ^
					CRC_TABLES[2][(high >> 8 & 0xFF) as i64] ^
					CRC_TABLES[1][(high >> 16 & 0xFF) as i64] ^
					CRC_TABLES[0][(high >> 24) as i64]
			at += 8
		}
		for byte in bytes[at..] {
			c = (c >> 8) ^ CRC_TABLES[0][((c ^ byte) & 0xFF) as i64]
		}
		self.remainder = c
	}

	/// The CRC-32 of everything written so far.
	pub fn value(): u32 = self.remainder ^ 0xFFFFFFFF
}

/// An Adler-32 of bytes that come in pieces, each written in turn. Its
/// value may be read after any of them; `Adler32()` is one with nothing
/// written yet.
pub struct Adler32 {
	/// The sum of the bytes, and the sum of those sums, each modulo
	/// 65521.
	sum: u32 = 1
	sums: u32 = 0
}

extend Adler32 {
	/// The bytes, after those written before. The sums are taken modulo
	/// 65521 only every 5552 bytes, the most that cannot carry them past 32
	/// bits, so between those they add without a check.
	pub var fn write(bytes: &[u8]) = {
		var a = self.sum
		var b = self.sums
		var at = 0
		while at < bytes.len() {
			val end = (at + ADLER_BLOCK).min(bytes.len())
			for byte in bytes[at..end] {
				a +%= byte
				b +%= a
			}
			a %= ADLER_MODULUS
			b %= ADLER_MODULUS
			at = end
		}
		self.sum = a
		self.sums = b
	}

	/// The Adler-32 of everything written so far.
	pub fn value(): u32 = (self.sums << 16) | self.sum
}

/// The largest prime below 2^16.
val ADLER_MODULUS: u32 = 65521

/// The most bytes whose sums, begun below the modulus, stay within 32 bits.
val ADLER_BLOCK: i64 = 5552

/// What a byte does to the remainder, for each of the 256, by the reflected
/// polynomial `0xEDB88320`; and the seven tables after it, each what a byte
/// does that many places further on, so that eight bytes are taken at
/// once.
@comptime
val CRC_TABLES: [[u32; 256]; 8] = crcTables()

fn crcTables(): [[u32; 256]; 8] = {
	var tables: [[u32; 256]; 8] = [[0; 256]; 8]
	for n in 0..256 {
		var c = n as u32
		for _ in 0..8 {
			c = if c & 1 != 0 then 0xEDB88320 ^ (c >> 1) else c >> 1
		}
		tables[0][n] = c
	}
	for n in 0..256 {
		for k in 1..8 {
			val before = tables[k - 1][n]
			tables[k][n] = (before >> 8) ^ tables[0][(before & 0xFF) as i64]
		}
	}
	return tables
}
