// HMAC, as RFC 2104 defines it: a digest of a message under a key, which
// only someone who holds the key can make, so that a message is known to
// come from them. What a webhook is signed with, and a one-time code made
// by. It is one function over the three digests, through an interface of
// what HMAC asks of each.

/// The HMAC of `message` under `key`, with SHA-256: what GitHub, Stripe and
/// Slack sign a webhook's body with. A key longer than SHA-256's block of
/// 64 bytes is its digest first, as RFC 2104 says. Compare one with what
/// was sent by `secret::equal`, never `==`.
pub fn hmacSha256(key: &[u8], message: &[u8]): [u8; 32] = {
	var out = [0 as u8; 32]
	hmac<Sha256>(&key, &message, &var out)
	return out
}

/// The HMAC of `message` under `key`, with SHA-1: what a one-time code,
/// TOTP, is made by. HMAC-SHA1 is not broken as SHA-1 is: what breaks SHA-1
/// does not let anyone without the key make one.
pub fn hmacSha1(key: &[u8], message: &[u8]): [u8; 20] = {
	var out = [0 as u8; 20]
	hmac<Sha1>(&key, &message, &var out)
	return out
}

/// The HMAC of `message` under `key`, with SHA-512, whose block is 128
/// bytes.
pub fn hmacSha512(key: &[u8], message: &[u8]): [u8; 64] = {
	var out = [0 as u8; 64]
	hmac<Sha512>(&key, &message, &var out)
	return out
}

/// What HMAC asks of a digest: a new one, bytes written to it, its value
/// written out, and the sizes of its block and its value.
interface Keyed {
	static fn begun(): Self
	var fn add(bytes: &[u8])
	move fn finishInto(out: &var [u8])
	static fn blockSize(): i64
	static fn digestSize(): i64
}

extend Sha1: Keyed {
	static fn begun(): Sha1 = Sha1()
	var fn add(bytes: &[u8]) = self.write(&bytes)
	move fn finishInto(out: &var [u8]) = {
		val done = self.finish()
		for i in 0..20 do
			out[i] = done[i]
	}
	static fn blockSize(): i64 = 64
	static fn digestSize(): i64 = 20
}

extend Sha256: Keyed {
	static fn begun(): Sha256 = Sha256()
	var fn add(bytes: &[u8]) = self.write(&bytes)
	move fn finishInto(out: &var [u8]) = {
		val done = self.finish()
		for i in 0..32 do
			out[i] = done[i]
	}
	static fn blockSize(): i64 = 64
	static fn digestSize(): i64 = 32
}

extend Sha512: Keyed {
	static fn begun(): Sha512 = Sha512()
	var fn add(bytes: &[u8]) = self.write(&bytes)
	move fn finishInto(out: &var [u8]) = {
		val done = self.finish()
		for i in 0..64 do
			out[i] = done[i]
	}
	static fn blockSize(): i64 = 128
	static fn digestSize(): i64 = 64
}

/// The HMAC of `message` under `key` with the digest `D`, written to `out`:
/// the digest of the key padded to a block with `0x5C` in each byte, and of
/// the digest of the key padded with `0x36` and the message.
fn hmac<D: Keyed>(key: &[u8], message: &[u8], out: &var [u8]) = {
	val block = D::blockSize()
	val size = D::digestSize()
	// The key, as long as a block: its digest where it is longer, and zeros
	// after it.
	var padded = [0 as u8; 128]
	if key.len() > block {
		var long = D::begun()
		long.add(&key)
		long.finishInto(&var padded[0..size])
	} else {
		for i in 0..key.len() do
			padded[i] = key[i]
	}
	var pad = [0 as u8; 128]
	for i in 0..block do
		pad[i] = padded[i] ^ 0x36

	var inner = D::begun()
	inner.add(&pad[0..block])
	inner.add(&message)
	var innerDigest = [0 as u8; 64]
	inner.finishInto(&var innerDigest[0..size])
	for i in 0..block do
		pad[i] = padded[i] ^ 0x5C

	var outer = D::begun()
	outer.add(&pad[0..block])
	outer.add(&innerDigest[0..size])
	outer.finishInto(&var out)
}
