// Reading a `Json` that is there: a field of an object and
// an element of an array, each by reference or nothing,
// and what a value is, where it is of that kind. They chain as an `Option`
// does: `node.get("kind").flatMap((kind) => kind.asText())`.

extend Json {
	/// The value of the field `name`, by reference, where this is an
	/// object that has one. A name written twice answers the one written
	/// last, as most readers take it.
	pub fn get(name: str): Option<&Json> = {
		val .Object(fields) = self else {
			return .None
		}
		var i = fields.len()
		while i > 0 {
			i -= 1
			if fields[i].0 == name then return .Some(&fields[i].1)
		}
		return .None
	}

	/// Element `index` of an array, by reference, where this is an array
	/// that long.
	pub fn item(index: i64): Option<&Json> = {
		val .Array(items) = self else {
			return .None
		}
		if index < 0 || index >= items.len() then return .None
		return .Some(&items[index])
	}

	/// The elements, where this is an array.
	pub fn asArray(): Option<&Vec<Json>> = match self {
		.Array(items) => .Some(&items)
		_ => .None
	}

	/// The text, where this is a string.
	pub fn asText(): Option<str> = match self {
		.Text(text) => .Some(text.toStr())
		_ => .None
	}

	/// The number, where this is one written without a fraction or an
	/// exponent that fits an `i64`.
	pub fn asInt(): Option<i64> = match self {
		.Int(value) => .Some(value)
		_ => .None
	}

	/// The number, where this is one: an `Int` as the nearest `f64`.
	pub fn asFloat(): Option<f64> = match self {
		.Int(value) => .Some(value as f64)
		.Float(value) => .Some(value)
		_ => .None
	}

	/// The value, where this is `true` or `false`.
	pub fn asBool(): Option<bool> = match self {
		.Bool(value) => .Some(value)
		_ => .None
	}

	/// Whether this is `null`.
	pub fn isNull(): bool = self is .Null
}
