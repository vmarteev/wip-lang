// Files. A `File` owns its descriptor and closes it where it ends, which is
// what `Destroy` is for, and holds the reader that `std::io` gives it — the
// bytes read and not yet given out, which somebody has to keep. No program
// this one starts is given the descriptor.
//
// What each call asks the system is each family's: POSIX's on a Unix
// (`fs.unix.wip`), Windows' own on Windows (`fs.windows.wip`), whose
// descriptor is the C library's over a handle of Windows'.

import std::io
import std::libc
import std::path
import std::process

/// An open file, closed where it ends.
pub struct File {
	reader: io::Reader
}

extend File: Destroy {
	var fn destroy() = {
		libc::close(io::descriptorOf(&self.reader))
	}
}

// Bytes as they come, from the same buffer lines are read from.
extend File: io::Read {
	var fn read(into: &var [u8]): Result<i64, io::IoError> = self.reader.read(&var into)
}

extend File: io::Write {
	var fn writeAll(bytes: &[u8]): Result<void, io::IoError> = {
		val fd = io::descriptorOf(&self.reader)
		var start = 0
		while start < bytes.len() {
			val put = libc::write(fd, &bytes[start..bytes.len()])
			if put < 0 {
				// Cut short by a signal, which is tried again.
				if io::lastError() == .Interrupted then
					continue

				return .Err(io::lastError())
			}
			start += put
		}
	}
}

/// How a file is opened.
enum Opening {
	/// An existing file, to read.
	Read
	/// A file to write, made if it is not there and emptied if it is.
	Create
	/// A file to write at the end of, made if it is not there.
	Append
	/// A file to write, made, where nothing may be there yet.
	CreateNew
}

extend File {
	/// An existing file, to read.
	pub static fn open(path: str): Result<File, io::IoError> = opened(path, .Read)

	/// A file to write, made if it is not there and emptied if it is.
	pub static fn create(path: str): Result<File, io::IoError> = opened(path, .Create)

	/// A file to write at the end of, made if it is not there.
	pub static fn append(path: str): Result<File, io::IoError> = opened(path, .Append)

	/// A new file to write, which fails with `.AlreadyExists` where
	/// anything is there already, so that nothing is emptied by mistake.
	pub static fn createNew(path: str): Result<File, io::IoError> = opened(path, .CreateNew)

	/// The next line, appended to `into` without its line break. `false` at
	/// the end of the file.
	pub var fn readLine(into: &var String): Result<bool, io::IoError> = self.reader.readLine(
		&var into,
	)

	/// The next `count` bytes, appended; fewer only at the end of the file.
	/// What comes back is how many.
	pub var fn readExact(
		count: i64,
		into: &var String,
	): Result<i64, io::IoError> = self.reader.readExact(count, &var into)

	/// The rest of the file, appended. What comes back is how many bytes.
	pub var fn readAll(into: &var String): Result<i64, io::IoError> = self.reader.readAll(&var into)

	/// The text, all of it, as `writeAll` writes bytes.
	pub var fn write(text: str): Result<void, io::IoError> = self.writeAll(&text)
}

/// The whole file, as text. It opens, reads and closes: the `File` ends
/// here, and its `destroy` is what closes it.
pub fn readFile(path: str): Result<String, io::IoError> = {
	var file = File::open(path)?
	var text = String()
	file.readAll(&var text)?
	return text
}

/// The whole file, as bytes, which need not be text: a picture, a sound.
pub fn readBytes(path: str): Result<Vec<u8>, io::IoError> = {
	val file = File::open(path)?
	var bytes: Vec<u8> = Vec()
	var chunk = [0 as u8; 65536]
	while true {
		val got = file.readAt(bytes.len(), &var chunk)?
		if got == 0 then
			break

		bytes.pushAll(&chunk[0..got])
	}
	return bytes
}

/// The text, as the whole of a file that is made or emptied first.
pub fn writeFile(path: str, text: str): Result<void, io::IoError> = writeBytes(path, &text)

/// The bytes, as the whole of a file that is made or emptied first: a
/// picture, a sound.
pub fn writeBytes(path: str, bytes: &[u8]): Result<void, io::IoError> = {
	var file = File::create(path)?
	file.writeAll(&bytes)?
}

/// The file at `path` replaced by one holding `text`, whole or not at all:
/// whoever opens it, and a program started after a crash, finds the old
/// file or the new one, never part of either. The new one is written
/// beside it, handed to the disk and renamed into its place, with the old
/// one's permission bits; a link at `path` is followed, and the file it
/// names replaced. Where it fails, nothing has changed.
pub fn replaceFile(path: str, text: str): Result<void, io::IoError> = replaceBytes(path, &text)

/// The same, for bytes that are not text.
pub fn replaceBytes(path: str, bytes: &[u8]): Result<void, io::IoError> = {
	// The file a link names, which is what an editor's save replaces.
	val target = match linkMeta(path) {
		.Ok(about) if about.kind == .Link => realPath(path)?
		_ => path
	}
	val mode = match meta(target) {
		.Ok(about) => Option::Some(about.mode)
		.Err(..) => .None
	}
	// Beside it, so that a rename moves it, hidden, and new: two writers
	// never share one.
	var attempt = 0
	while true {
		attempt += 1
		val name = ".\(path::name(target)).replacing-\(process::id())-\(attempt)"
		val beside = path::join(path::parent(target), name)
		match File::createNew(beside) {
			.Ok(file) => return placed(file, beside, target, &bytes, mode)
			.Err(.AlreadyExists) => {}
			.Err(why) => return .Err(why)
		}
	}
}

/// `file`, new at `beside`, given `bytes` and renamed to `target`, or
/// removed wherever that fails.
fn placed(
	file: File,
	beside: str,
	target: str,
	bytes: &[u8],
	mode: Option<i64>,
): Result<void, io::IoError> = {
	var done = filled(file, beside, &bytes, mode)
	if done.isOk() then
		done = rename(beside, target)

	if done.isErr() then
		removeFile(beside)

	return done
}

/// `file`, at `path`, given `bytes`, handed to the disk, closed, and given
/// `mode` where there is one.
fn filled(file: File, path: str, bytes: &[u8], mode: Option<i64>): Result<void, io::IoError> = {
	var open = file
	open.writeAll(&bytes)?
	open.sync()?
	if mode is .Some(bits) then
		setMode(path, bits)?

	return
}

/// What a path is: the three kinds a program acts on differently, and the
/// special files a filesystem holds besides, which a file manager shows
/// and does not open.
@derive(Text)
pub enum Kind {
	File
	Directory
	Link
	/// A named pipe, a FIFO.
	Pipe
	/// A Unix-domain socket.
	Socket
	/// A device read a character at a time: a terminal, `/dev/null`.
	CharDevice
	/// A device read in blocks: a disk.
	BlockDevice
	/// Anything else a filesystem may hold.
	Other
}

extend Kind {
	/// Whether it is none of a file, a directory and a link: what a copy or
	/// a listing passes over or shows apart.
	pub fn isSpecial(): bool = self !is .File | .Directory | .Link
}

/// What a filesystem says about a path: the part of `stat` a program acts
/// on, read from the struct each system lays out its own way.
@derive(Eq)
pub struct Meta {
	/// A file, a directory, a link or something else.
	pub kind: Kind
	/// In bytes, and for a directory whatever the filesystem says.
	pub size: i64
	/// When it last changed, in seconds since 1970.
	pub modified: i64
	/// The nanoseconds past `modified`'s second, where the filesystem keeps
	/// them: what tells apart two writes within one second.
	pub modifiedNanos: i64
	/// The permission bits, as `chmod` writes them: `0o755`.
	pub mode: i64
	/// The number of the user who owns it, as `users::User` has it.
	pub user: u32
	/// The number of its group.
	pub group: u32
	/// The filesystem it is on, as the system numbers it.
	pub device: i64
	/// Its number on that filesystem. `device` and `inode` together are
	/// which file it is, whatever its name: what was listed as `a` is still
	/// that file after a rename, and a new `a` is another.
	pub inode: i64
}

/// One entry of a directory: what `readDir` answers, and `walk`.
@derive(Eq, Clone)
pub struct Entry {
	/// The entry's name from the directory read: for `readDir` its own
	/// name in it, and for `walk` the names from the directory walked,
	/// `lang/main.wip`. `path::join` of that directory and this is where it
	/// is.
	pub name: String
	/// What the directory says it is; where the filesystem does not say,
	/// what `lstat` does.
	pub kind: Kind
}

extend Meta {
	/// Whether the path is a directory, a link to one not followed.
	pub fn isDirectory(): bool = self.kind == .Directory

	/// Whether the path is a file, a link to one not followed.
	pub fn isFile(): bool = self.kind == .File
}

extend Entry {
	/// Whether this is a directory, which is what a listing sorts by.
	pub fn isDirectory(): bool = self.kind == .Directory
}

/// What the filesystem says about `path`, following a symbolic link to
/// what it points at.
pub fn meta(path: str): Result<Meta, io::IoError> = metaOf(path, true)

/// The same, about the link itself rather than what it points at.
pub fn linkMeta(path: str): Result<Meta, io::IoError> = metaOf(path, false)

/// Whether there is anything at `path`.
pub fn exists(path: str): bool = meta(path).isOk()

/// Every entry under `dir`, each named by its path from `dir`, depth
/// first and a directory before what it holds, each directory in the order
/// the filesystem gives it. A link is an entry, and is not followed. A
/// directory is entered where `enter` says, asked before its entries are
/// read; one not entered is still an entry. It fails only where `dir`
/// cannot be read: a directory under it that cannot be is an entry with
/// nothing under it. Sorting is the caller's, as it is for `readDir`.
pub fn walk(
	dir: str,
	enter: &(entry: &Entry) => bool = (_) => true,
): Result<Vec<Entry>, io::IoError> = {
	var found: Vec<Entry> = Vec()
	walkInto(dir, "", readDir(dir)?, enter, &var found)
	return found
}

/// What `entries`, read from `within` under `dir`, hold, each named from
/// `dir` and pushed to `found` before what it holds.
fn walkInto(
	dir: str,
	within: str,
	entries: Vec<Entry>,
	enter: &(entry: &Entry) => bool,
	found: &var Vec<Entry>,
) = {
	for entry in move entries {
		val name = if within.isEmpty() then entry.name else path::join(within, entry.name)
		val walked = Entry(name:, kind: entry.kind)
		val inside: Option<String> =
			if walked.kind == .Directory && enter(&walked) then walked.name.clone() else .None
		found.push(walked)
		if inside is .Some(at) && readDir(path::join(dir, at)) is .Ok(held) then
			walkInto(dir, at, held, enter, &var found)
	}
}

/// Makes a directory and every one above it that is not there yet; one
/// that is there already is no error: `fs::makeDirs("build/cache/objects")`.
pub fn makeDirs(path: str): Result<void, io::IoError> = {
	// The root is there, and is no directory to make.
	var at = path::root(path).len()
	while at <= path.len() {
		// Each prefix that ends where a `/` is, and then the whole.
		var end = at
		while end < path.len() && !path::isSeparator(path[end]) do
			end += 1

		if end > 0 {
			match makeDir(path[0..end]) {
				.Ok(..) => {}
				// A file in the way is the error; a directory is what was
				// asked for.
				.Err(.AlreadyExists) => {
					if !(meta(path[0..end]) is .Ok(about) && about.kind == .Directory) then
						return .Err(.AlreadyExists)
				}
				.Err(error) => return .Err(error)
			}
		}
		at = end + 1
	}
}

/// Removes what is at `path`, and where it is a directory everything in it
/// first; a link is removed, not what it names.
pub fn removeAll(path: str): Result<void, io::IoError> = {
	val about = linkMeta(path)?
	if about.kind != .Directory then
		return removeFile(path)

	for entry in readDir(path)? do
		removeAll(path::join(path, entry.name))?

	return removeDir(path)
}

/// The bytes of the file at `from` written to `to`, made or emptied, with
/// its permission bits; answers how many bytes.
pub fn copy(from: str, to: str): Result<i64, io::IoError> = {
	val about = meta(from)?
	val source = File::open(from)?
	var target = File::create(to)?
	var block: Vec<u8> = .filled(65536, 0)
	var copied = 0
	while true {
		val got = source.readAt(copied, &var block.items())?
		if got == 0 then
			break

		target.writeAll(&block[0..got])?
		copied += got
	}
	setMode(to, about.mode)?
	return copied
}

/// A directory of the system's temporary files, made new for a while and
/// removed, with all it holds, where the value ends: what a build, a test
/// or an unpacking works in.
pub struct TempDir {
	/// Where it is.
	pub path: String
}

extend TempDir {
	/// A path in it.
	pub fn join(name: str): String = path::join(self.path, name)
}

extend TempDir: Destroy {
	var fn destroy() = {
		// A cleanup has no one to answer: what cannot be removed is left.
		removeAll(self.path)
	}
}
