// A Mac and iOS: a file's numbers through `stat`, and a directory's
// entries as their C library lays them out.

import std::io
import std::libc

// A Mac's, the same on arm64 and x86-64, where the names with 64-bit inode
// numbers are the ones with `$INODE64` after them.
extern struct Stat {
	device: i32
	mode: u16
	links: u16
	inode: u64
	user: u32
	group: u32
	rdev: i32
	accessed: [i64; 2]
	modified: [i64; 2]
	changed: [i64; 2]
	born: [i64; 2]
	size: i64
}

extern struct Dirent {
	inode: u64
	seekOffset: u64
	recordLength: u16
	nameLength: u16
	kind: u8
	name: [u8; 1024]
}

@target(arch = "arm64")
extern "C" {
	fn stat(path: cstring, info: ptr<Stat>): c_int
	fn lstat(path: cstring, info: ptr<Stat>): c_int
	fn fstat(fd: c_int, info: ptr<Stat>): c_int
	fn opendir(path: cstring): ptr<u8>
	fn readdir(dir: ptr<u8>): ptr<Dirent>
}

@target(arch = "x86_64")
extern "C" {
	@symbol("stat$INODE64")
	fn stat(path: cstring, info: ptr<Stat>): c_int
	@symbol("lstat$INODE64")
	fn lstat(path: cstring, info: ptr<Stat>): c_int
	@symbol("fstat$INODE64")
	fn fstat(fd: c_int, info: ptr<Stat>): c_int
	@symbol("opendir$INODE64")
	fn opendir(path: cstring): ptr<u8>
	@symbol("readdir$INODE64")
	fn readdir(dir: ptr<u8>): ptr<Dirent>
}

fn statNumbers(path: cstring, following: bool): Result<Stated, io::IoError> = statInto((info) => {
	return if following then stat(path, info) else lstat(path, info)
})

/// What the filesystem says about an open file.
fn descriptorNumbers(fd: c_int): Result<Stated, io::IoError> = statInto((info) => fstat(fd, info))

/// What `call` fills in, into room it is given.
fn statInto(call: &(info: ptr<Stat>) => c_int): Result<Stated, io::IoError> = {
	val info = libc::calloc(1, ROOM as size_t) as ptr<Stat>
	if info.isNull then return .Err(io::lastError())
	val got = call(info)
	val answer: Result<Stated, io::IoError> =
		if got == 0 then
			.Ok(Stated(
				mode: info.mode,
				user: info.user,
				group: info.group,
				size: info.size,
				modified: info.modified[0],
				modifiedNanos: info.modified[1],
				device: info.device,
				inode: info.inode as% i64,
			))
		else .Err(io::lastError())
	libc::free(info as ptr<u8>)
	return answer
}
