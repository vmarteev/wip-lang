// A Unix's paths: names between `/`s, and a root that is `/`.

/// What a path is written with between its names.
val SEPARATOR: str = "/"

/// Whether `byte` is between a path's names: `/`, and on Windows `\` too.
pub fn isSeparator(byte: u8): bool = byte == b'/'

/// How much of `path` is its root: the `/` it begins with, or nothing.
fn rootLength(path: str): i64 = if path.startsWith("/") then 1 else 0
