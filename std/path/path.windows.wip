// Windows' paths: names between `\`s, a `/` read as one too, and a root
// that is a drive's, `C:\` — `C:` alone is that drive's current
// directory — a share's, `\\server\share\`, or a `\` alone, the
// current drive's.

/// What a path is written with between its names.
val SEPARATOR: str = "\\"

/// Whether `byte` is between a path's names: `/`, and on Windows `\` too.
pub fn isSeparator(byte: u8): bool = byte == b'\\' || byte == b'/'

/// How much of `path` is its root: a drive's letter and `:`, and the
/// separator after it; two separators, the server's name and the share's,
/// and the separator after them; or a separator alone. Nothing where the
/// path is relative.
fn rootLength(path: str): i64 = {
	if path.len() >= 2 && path[0].isAsciiLetter() && path[1] == b':' then
		return if path.len() >= 3 && isSeparator(path[2]) then 3 else 2

	if path.len() >= 2 && isSeparator(path[0]) && isSeparator(path[1]) {
		var at = 2
		for _ in 0..2 {
			while at < path.len() && !isSeparator(path[at]) do
				at += 1

			if at < path.len() then
				at += 1
		}
		return at
	}
	return if path.len() >= 1 && isSeparator(path[0]) then 1 else 0
}
