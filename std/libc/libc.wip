// The C library, as the standard library calls it: what printing, files, the
// allocator, threads and processes are written over. A program may import it as
// well; it is C's, and promises nothing C does not. Each function is C's own,
// documented by C's manual pages; what is written here is where Wip's types
// cross in a way worth saying.
//
// A name that is a macro in C's headers — `stdout`, `errno` — is bound to
// what each C library defines it as, per target.

// Streams: standard output and error, buffered by C.

extern "C" {
	pub type FILE

	/// `fwrite` takes a pointer, a size and a count. A `str` crosses as its
	/// bytes and their length, so it is the pointer and the size, and one
	/// of those is written.
	pub fn fwrite(bytes: str, count: size_t, stream: ptr<FILE>): size_t
	/// `fwrite`, for bytes that are not text.
	@symbol("fwrite")
	pub fn fwriteBytes(bytes: &[u8], count: size_t, stream: ptr<FILE>): size_t
	pub fn fputc(byte: c_int, stream: ptr<FILE>): c_int
	pub fn fflush(stream: ptr<FILE>): c_int
	pub fn puts(text: cstring): c_int
	pub fn printf(format: cstring, ...): c_int
	pub fn fprintf(stream: ptr<FILE>, format: cstring, ...): c_int
	/// `snprintf` takes where to write and how much room there is, which is
	/// what a `&var [u8]` crosses as.
	pub fn snprintf(out: &var [u8], format: cstring, ...): c_int
}

@target(vendor = "apple")
extern "C" {
	/// Standard output.
	@symbol("__stdoutp")
	pub val stdout: ptr<FILE>
	/// Standard error.
	@symbol("__stderrp")
	pub val stderr: ptr<FILE>
}

@target(os = "linux")
extern "C" {
	/// Standard output.
	pub val stdout: ptr<FILE>
	/// Standard error.
	pub val stderr: ptr<FILE>
}

// glibc's `snprintf` for one double, with no `...`: C23's, there since
// glibc 2.25. A Mac's libc has none.
@target(os = "linux")
extern "C" {
	pub fn strfromd(out: &var [u8], format: cstring, value: f64): c_int
}

/// A double as `format` writes it — one conversion, `%.17g`, which is
/// what `strfromd` takes — into `out`, with a NUL after it: how many bytes
/// of `out` the text is, which is at most one less than there is room for.
pub fn formatDouble(value: f64, format: cstring, out: &var [u8]): i64 = {
	// How long the whole would have been, as `snprintf` answers.
	val wanted = formatted(value, format, &var out) as i64
	if wanted < 0 then return 0
	return wanted.min(out.len() - 1)
}

// On Linux it is `strfromd`, which takes the double as a named argument: a
// variadic call that passes a double is the one x86-64 cannot make without
// C of the compiler's writing, since the callee reads `%al`, which
// Cranelift cannot set. Elsewhere every variadic call is
// made directly.
@target(os = "linux")
fn formatted(value: f64, format: cstring, out: &var [u8]): c_int = strfromd(&var out, format, value)

@target(vendor = "apple")
@target(os = "windows")
fn formatted(value: f64, format: cstring, out: &var [u8]): c_int = snprintf(&var out, format, value)

// Numbers read from text, the nearest one to what is written. Where the
// number ends is written through `end`, which may be null.

extern "C" {
	pub fn strtod(text: cstring, end: ptr<cstring>): f64
	pub fn strtof(text: cstring, end: ptr<cstring>): f32
}

// Files and descriptors.

extern "C" {
	pub fn read(fd: c_int, bytes: &var [u8]): ssize_t
	/// `read` from `offset`, which moves nothing a later `read` starts from.
	pub fn pread(fd: c_int, bytes: &var [u8], offset: i64): ssize_t
	pub fn write(fd: c_int, bytes: &[u8]): ssize_t
	/// `write`, for text.
	@symbol("write")
	pub fn writeText(fd: c_int, text: str): ssize_t
	pub fn open(path: cstring, flags: c_int, ...): c_int
	pub fn close(fd: c_int): c_int
	/// `fcntl` with `F_SETFL` and the flags, as the processes use it.
	pub fn fcntl(fd: c_int, command: c_int, ...): c_int
	/// `mode_t` is 16 bits on a Mac and 32 on Linux; an argument narrower
	/// than 32 bits arrives extended to 32 either way.
	pub fn mkdir(path: cstring, mode: c_uint): c_int
	pub fn unlink(path: cstring): c_int
	/// An empty directory removed.
	pub fn rmdir(path: cstring): c_int
	/// A path moved to another, in place of anything there but a
	/// directory with something in it.
	pub fn rename(from: cstring, to: cstring): c_int
	/// The permission bits set, as `chmod` writes them.
	pub fn chmod(path: cstring, mode: c_uint): c_int
	/// Whether the descriptor is a terminal: 1 where it is.
	pub fn isatty(fd: c_int): c_int
}

/// `open`: for reading only.
pub val O_RDONLY: c_int = 0
/// `open`: for writing only.
pub val O_WRONLY: c_int = 1
/// `fcntl`: set a descriptor's flags.
pub val F_SETFL: c_int = 4

/// `sysconf`: how many processors are working.
@target(vendor = "apple")
pub val SC_NPROCESSORS_ONLN: c_int = 58
@target(os = "linux")
pub val SC_NPROCESSORS_ONLN: c_int = 84

// The rest of `open`'s flags, which each system numbers its own way.

/// `open`: every write goes at the end.
@target(vendor = "apple")
pub val O_APPEND: c_int = 8
/// `open`: made where it is not there.
@target(vendor = "apple")
pub val O_CREAT: c_int = 512
/// `open`: emptied where it is there.
@target(vendor = "apple")
pub val O_TRUNC: c_int = 1024
/// `open`, with `O_CREAT`: fails where it is there already.
@target(vendor = "apple")
pub val O_EXCL: c_int = 2048
/// `open` and `fcntl`: a read or a write that would wait answers `EAGAIN`.
@target(vendor = "apple")
pub val O_NONBLOCK: c_int = 4

/// `open`: every write goes at the end.
@target(os = "linux")
pub val O_APPEND: c_int = 1024
/// `open`: made where it is not there.
@target(os = "linux")
pub val O_CREAT: c_int = 64
/// `open`: emptied where it is there.
@target(os = "linux")
pub val O_TRUNC: c_int = 512
/// `open`, with `O_CREAT`: fails where it is there already.
@target(os = "linux")
pub val O_EXCL: c_int = 128
/// `open` and `fcntl`: a read or a write that would wait answers `EAGAIN`.
@target(os = "linux")
pub val O_NONBLOCK: c_int = 2048

// Errors: `errno`, which is a macro over a function each C library names
// its own way, and the numbers `std::io` tells apart, which are the same
// on every system Wip targets.

@target(vendor = "apple")
extern "C" {
	/// Where this thread's `errno` is.
	@symbol("__error")
	pub fn errnoAt(): ptr<c_int>
}

@target(os = "linux")
extern "C" {
	/// Where this thread's `errno` is.
	@symbol("__errno_location")
	pub fn errnoAt(): ptr<c_int>
}

extern "C" {
	pub fn strerror(code: c_int): cstring

	/// `bytes`, 256 at most, filled from the system's source of
	/// randomness: 0 where they were, -1 where they were not, as `errno`
	/// says. Linux's C library has it, and so has Apple's.
	pub fn getentropy(bytes: &var [u8]): c_int
}

/// This thread's `errno`: what the last call that failed said.
pub fn errno(): c_int = errnoAt()[0]

/// No such file or directory.
pub val ENOENT: c_int = 2
/// A call cut short by a signal.
pub val EINTR: c_int = 4
/// No memory.
pub val ENOMEM: c_int = 12
/// Permission denied.
pub val EACCES: c_int = 13
/// Already exists.
pub val EEXIST: c_int = 17
/// A pipe whose reading end is closed.
pub val EPIPE: c_int = 32

/// Nothing can be done now without waiting, on a descriptor that does not
/// wait: each system numbers it its own way.
@target(vendor = "apple")
pub val EAGAIN: c_int = 35
@target(os = "linux")
pub val EAGAIN: c_int = 11

// What a connection fails with, each system numbering its
// own.
@target(vendor = "apple")
pub val EADDRINUSE: c_int = 48
@target(os = "linux")
pub val EADDRINUSE: c_int = 98
@target(vendor = "apple")
pub val ECONNREFUSED: c_int = 61
@target(os = "linux")
pub val ECONNREFUSED: c_int = 111
@target(vendor = "apple")
pub val ECONNRESET: c_int = 54
@target(os = "linux")
pub val ECONNRESET: c_int = 104
@target(vendor = "apple")
pub val ENOTCONN: c_int = 57
@target(os = "linux")
pub val ENOTCONN: c_int = 107
@target(vendor = "apple")
pub val ENAMETOOLONG: c_int = 63
@target(os = "linux")
pub val ENAMETOOLONG: c_int = 36

// Memory, and the bytes in it.

extern "C" {
	pub fn malloc(size: size_t): ptr<u8>
	pub fn calloc(count: size_t, size: size_t): ptr<u8>
	pub fn free(block: ptr<u8>)
	/// Two runs of bytes, compared: negative where the first comes first.
	/// A `cstring` is how a pointer to bytes crosses without their length.
	pub fn memcmp(first: cstring, second: cstring, count: size_t): c_int
	/// `count` bytes from `source` to `destination`, where the two may
	/// overlap. C answers `destination`, which is not taken.
	pub fn memmove(destination: ptr<u8>, source: ptr<u8>, count: size_t)
	pub fn strlen(text: ptr<u8>): size_t
	/// `strlen`, of a `cstring`.
	@symbol("strlen")
	pub fn cstringLength(text: cstring): size_t
}

// The program: its environment, and how it ends.

extern "C" {
	pub fn getenv(name: cstring): ptr<u8>
	/// With a null for where to write, answers a block `malloc` gave,
	/// which `free` gives back.
	pub fn realpath(path: cstring, resolved: ptr<u8>): ptr<u8>
	/// The current directory. With a null for where to write and no
	/// size, answers a block `malloc` gave, on a Mac and with glibc alike.
	pub fn getcwd(into: ptr<u8>, size: size_t): ptr<u8>
	/// This process's number.
	pub fn getpid(): c_int
	/// This program's environment: `NAME=value` strings, ended by a null.
	pub val environ: ptr<cstring>
	pub fn exit(status: c_int): never
	/// Ends the program with nothing run at its exit and nothing flushed.
	@symbol("_Exit")
	pub fn exitAtOnce(status: c_int): never
	pub fn abort(): never
	/// What runs when the program ends by `exit` or by returning from
	/// `main`, last registered first.
	pub fn atexit(callback: () => void): c_int
}

/// Room for a C type each system lays out its own way, and that Wip only
/// ever passes the address of: a `pthread_mutex_t`, a `pthread_cond_t`, a
/// `pthread_attr_t` or a `posix_spawn_file_actions_t`. The
/// largest of them on a system Wip targets is glibc's file actions, 80
/// bytes; this is 128, aligned as a pointer is.
pub extern struct Hidden {
	/// What C keeps there, which Wip never reads.
	pub words: [u64; 16]
}

/// A `Hidden` for C to initialize.
pub fn hidden(): Hidden = Hidden([0; 16])

// The stack, walked by the C toolchain's unwinder — `libgcc_s` where glibc
// is, Apple's `libunwind` on a Mac — by the unwind information each
// function has, Wip's and C's alike. A panic asks it for
// each frame's return address.

extern "C" {
	/// Calls `trace` with each frame, innermost first, until it answers
	/// other than 0 (`_URC_NO_REASON`) or the frames end.
	pub fn _Unwind_Backtrace(
		trace: (context: ptr<void>, state: ptr<void>) => c_int,
		state: ptr<void>,
	): c_int
	/// Where a frame's code is: for each frame but the innermost, the
	/// address its call returns to.
	pub fn _Unwind_GetIP(context: ptr<void>): u64
}

// Threads. A `pthread_t` is a pointer on a Mac and a
// number on Linux: a word either way.

extern "C" {
	pub fn pthread_create(
		thread: &var u64,
		attributes: &Hidden,
		entry: (argument: ptr<u8>) => ptr<u8>,
		argument: ptr<u8>,
	): c_int
	pub fn pthread_join(thread: u64, answer: ptr<u8>): c_int
	/// What the system says of itself: `SC_NPROCESSORS_ONLN`, how many
	/// processors are working.
	pub fn sysconf(name: c_int): i64
	pub fn pthread_detach(thread: u64): c_int
	pub fn pthread_attr_init(attributes: &var Hidden): c_int
	pub fn pthread_attr_setstacksize(attributes: &var Hidden, size: size_t): c_int
	pub fn pthread_attr_destroy(attributes: &var Hidden): c_int
	pub fn pthread_mutex_init(lock: &var Hidden, attributes: ptr<u8>): c_int
	pub fn pthread_mutex_lock(lock: &var Hidden): c_int
	pub fn pthread_mutex_unlock(lock: &var Hidden): c_int
	pub fn pthread_mutex_destroy(lock: &var Hidden): c_int
	pub fn pthread_cond_init(ready: &var Hidden, attributes: ptr<u8>): c_int
	pub fn pthread_cond_wait(ready: &var Hidden, lock: &var Hidden): c_int
	pub fn pthread_cond_signal(ready: &var Hidden): c_int
	pub fn pthread_cond_broadcast(ready: &var Hidden): c_int
	pub fn pthread_cond_destroy(ready: &var Hidden): c_int
}

// Processes. A `pid_t` is an `int`, and `mode_t`, 16 bits
// on a Mac, arrives extended to 32.

extern "C" {
	pub fn posix_spawnp(
		pid: &var c_int,
		program: cstring,
		actions: &Hidden,
		attributes: ptr<u8>,
		arguments: ptr<cstring>,
		environment: ptr<cstring>,
	): c_int
	pub fn posix_spawn_file_actions_init(actions: &var Hidden): c_int
	pub fn posix_spawn_file_actions_destroy(actions: &var Hidden): c_int
	pub fn posix_spawn_file_actions_addopen(
		actions: &var Hidden,
		fd: c_int,
		path: cstring,
		flags: c_int,
		mode: c_uint,
	): c_int
	pub fn posix_spawn_file_actions_adddup2(actions: &var Hidden, fd: c_int, to: c_int): c_int
	pub fn posix_spawn_file_actions_addclose(actions: &var Hidden, fd: c_int): c_int
	pub fn posix_spawn_file_actions_addchdir_np(actions: &var Hidden, path: cstring): c_int
	pub fn pipe(ends: &var Pipe): c_int
	pub fn waitpid(pid: c_int, status: &var c_int, options: c_int): c_int
	pub fn kill(pid: c_int, signal: c_int): c_int
	/// The files, and how many: what a slice crosses as. `nfds_t` is 32
	/// bits on a Mac and 64 on Linux; a Mac reads the low 32.
	pub fn poll(watched: &var [PollFd], timeout: c_int): c_int
}

/// The two ends of a pipe, as `pipe` fills them in.
pub extern struct Pipe {
	/// The end that is read from.
	pub reading: c_int
	/// The end that is written to.
	pub writing: c_int
}

/// A file `poll` watches: what to wait for, and what came.
pub extern struct PollFd {
	/// The descriptor.
	pub fd: c_int
	/// What to wait for: `POLLIN`.
	pub events: i16
	/// What came, which `poll` fills in.
	pub answered: i16
}

/// `poll`: there is something to read, or the other end has closed.
pub val POLLIN: i16 = 1
/// `poll`: there is room to write.
pub val POLLOUT: i16 = 4
/// `poll`: the other end of a pipe written to has closed.
pub val POLLERR: i16 = 8
/// `poll`: the other end has hung up.
pub val POLLHUP: i16 = 16
/// `waitpid`: answer at once where the child has not ended.
pub val WNOHANG: c_int = 1
/// The signal that ends a program, which it cannot catch.
pub val SIGKILL: c_int = 9
/// The signal a write to a pipe no one reads raises, which ends a program
/// that has not said otherwise.
pub val SIGPIPE: c_int = 13

// Signals a thread holds back: a `sigset_t`, 4 bytes on a Mac and 128 on
// Linux, is room in a `Hidden`.

extern "C" {
	pub fn sigemptyset(set: &var Hidden): c_int
	pub fn sigaddset(set: &var Hidden, signal: c_int): c_int
	pub fn sigismember(set: &Hidden, signal: c_int): c_int
	pub fn sigpending(set: &var Hidden): c_int
	pub fn sigwait(set: &Hidden, signal: &var c_int): c_int
	pub fn pthread_sigmask(how: c_int, set: &Hidden, old: &var Hidden): c_int
}

/// `pthread_sigmask`: hold back the signals given as well.
@target(vendor = "apple")
pub val SIG_BLOCK: c_int = 1
/// `pthread_sigmask`: hold back exactly the signals given.
@target(vendor = "apple")
pub val SIG_SETMASK: c_int = 3
/// `pthread_sigmask`: hold back the signals given as well.
@target(os = "linux")
pub val SIG_BLOCK: c_int = 0
/// `pthread_sigmask`: hold back exactly the signals given.
@target(os = "linux")
pub val SIG_SETMASK: c_int = 2
