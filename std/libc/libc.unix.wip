// POSIX: what every Unix's C library has beyond C's own — descriptors and
// files, randomness, the environment changed, the stack's unwinder, time
// on a clock the call names, threads, processes, signals and users —
// which a Mac, iOS and Linux share, each system's own numbers in its file.

// Streams: what each system names standard output and error, in its own
// file, as C's `stdout` and `stderr` are.

/// Standard output, buffered by C.
pub fn stdout(): ptr<FILE> = standardOutput

/// Standard error, which C does not buffer.
pub fn stderr(): ptr<FILE> = standardError

// Files and descriptors.

extern "C" {
	pub fn read(fd: c_int, bytes: &var [u8]): ssize_t
	/// `read` from `offset`, which moves nothing a later `read` starts from.
	pub fn pread(fd: c_int, bytes: &var [u8], offset: i64): ssize_t
	pub fn write(fd: c_int, bytes: &[u8]): ssize_t
	/// `write`, for text.
	@symbol("write")
	pub fn writeText(fd: c_int, text: str): ssize_t
	pub fn open(path: cstring, flags: c_int, ...): c_int
	pub fn close(fd: c_int): c_int
	/// `fcntl` with `F_SETFL` or `F_SETFD` and the flags.
	pub fn fcntl(fd: c_int, command: c_int, ...): c_int
	/// `mode_t` is 16 bits on a Mac and 32 on Linux; an argument narrower
	/// than 32 bits arrives extended to 32 either way.
	pub fn mkdir(path: cstring, mode: c_uint): c_int
	pub fn unlink(path: cstring): c_int
	/// An empty directory removed.
	pub fn rmdir(path: cstring): c_int
	/// A path moved to another, in place of anything there but a
	/// directory with something in it.
	pub fn rename(from: cstring, to: cstring): c_int
	/// A symbolic link made at `at`, naming `target`.
	pub fn symlink(target: cstring, at: cstring): c_int
	/// The permission bits set, as `chmod` writes them.
	pub fn chmod(path: cstring, mode: c_uint): c_int
	/// What was written to the descriptor's file handed to the disk.
	pub fn fsync(fd: c_int): c_int
	/// A new directory, readable by its owner alone, named by `template`
	/// with its last six `X`s chosen where nothing is, written into it;
	/// answers `template`, or null.
	pub fn mkdtemp(template: cstring): cstring
	/// Whether the descriptor is a terminal: 1 where it is.
	pub fn isatty(fd: c_int): c_int
}

/// `open`: for reading only.
pub val O_RDONLY: c_int = 0
/// `open`: for writing only.
pub val O_WRONLY: c_int = 1
/// `fcntl`: set a descriptor's flags.
pub val F_SETFL: c_int = 4
/// `fcntl`: set what becomes of a descriptor when a program is started.
pub val F_SETFD: c_int = 2
/// `F_SETFD`'s flag: closed in the program started.
pub val FD_CLOEXEC: c_int = 1

/// Marks a descriptor closed in any program this one starts, as every
/// descriptor the library opens is: a program started is given its
/// standard streams and what its command says, not whatever this one has
/// open — a file it would keep from being removed, or the end of a pipe
/// another program waits to see closed.
pub fn closeOnExec(fd: c_int) = {
	fcntl(fd, F_SETFD, FD_CLOEXEC)
}

// Randomness, from the system.

extern "C" {
	/// `bytes`, 256 at most, filled from the system's source of
	/// randomness: 0 where they were, -1 where they were not, as `errno`
	/// says. Linux's C library has it, and so has Apple's.
	pub fn getentropy(bytes: &var [u8]): c_int
}

// The environment changed, and where the program runs.

extern "C" {
	/// Sets the variable, in place of what it held where `overwrite` is
	/// not 0. Not safe beside a `getenv` on another thread.
	pub fn setenv(name: cstring, value: cstring, overwrite: c_int): c_int
	/// Takes the variable out, with `setenv`'s danger.
	pub fn unsetenv(name: cstring): c_int
	/// With a null for where to write, answers a block `malloc` gave,
	/// which `free` gives back.
	pub fn realpath(path: cstring, resolved: ptr<u8>): ptr<u8>
	/// The current directory. With a null for where to write and no
	/// size, answers a block `malloc` gave, on a Mac and with glibc alike.
	pub fn getcwd(into: ptr<u8>, size: size_t): ptr<u8>
	/// This process's number.
	pub fn getpid(): c_int
	/// This program's environment: `NAME=value` strings, ended by a null.
	pub val environ: ptr<cstring>
}

// The stack, walked by the C toolchain's unwinder — `libgcc_s` where glibc
// is, Apple's `libunwind` on a Mac — by the unwind information each
// function has, Wip's and C's alike. A panic asks it for
// each frame's return address.

extern "C" {
	/// Calls `trace` with each frame, innermost first, until it answers
	/// other than 0 (`_URC_NO_REASON`) or the frames end.
	pub fn _Unwind_Backtrace(
		trace: (context: ptr<void>, state: ptr<void>) => c_int,
		state: ptr<void>,
	): c_int
	/// Where a frame's code is: for each frame but the innermost, the
	/// address its call returns to.
	pub fn _Unwind_GetIP(context: ptr<void>): u64
}

// Time: a moment as C counts it, on a clock the call names, and a sleep.

/// A `struct timespec`: seconds, and the nanoseconds past them.
pub extern struct TimeSpec {
	pub seconds: i64 = 0
	pub nanos: c_long = 0
}

/// `CLOCK_REALTIME`, the time of day, the same on both systems.
pub val CLOCK_REALTIME: c_int = 0

extern "C" {
	/// Now, on `clock`.
	pub fn clock_gettime(clock: c_int, time: &var TimeSpec): c_int
	/// Waits for `wanted`, leaving in `left` what a signal cut short.
	pub fn nanosleep(wanted: &TimeSpec, left: &var TimeSpec): c_int
}

// Threads. A `pthread_t` is a pointer on a Mac and a
// number on Linux: a word either way.

extern "C" {
	pub fn pthread_create(
		thread: &var u64,
		attributes: &Hidden,
		entry: (argument: ptr<u8>) => ptr<u8>,
		argument: ptr<u8>,
	): c_int
	pub fn pthread_join(thread: u64, answer: ptr<u8>): c_int
	/// What the system says of itself: `SC_NPROCESSORS_ONLN`, how many
	/// processors are working.
	pub fn sysconf(name: c_int): i64
	pub fn pthread_detach(thread: u64): c_int
	/// The thread that calls it.
	pub fn pthread_self(): u64
	pub fn pthread_attr_init(attributes: &var Hidden): c_int
	pub fn pthread_attr_setstacksize(attributes: &var Hidden, size: size_t): c_int
	pub fn pthread_attr_destroy(attributes: &var Hidden): c_int
	pub fn pthread_mutex_init(lock: &var Hidden, attributes: ptr<u8>): c_int
	pub fn pthread_mutex_lock(lock: &var Hidden): c_int
	/// Locks where no thread holds the lock: 0 where it did.
	pub fn pthread_mutex_trylock(lock: &var Hidden): c_int
	pub fn pthread_mutex_unlock(lock: &var Hidden): c_int
	pub fn pthread_mutex_destroy(lock: &var Hidden): c_int
	pub fn pthread_cond_init(ready: &var Hidden, attributes: ptr<u8>): c_int
	pub fn pthread_cond_wait(ready: &var Hidden, lock: &var Hidden): c_int
	pub fn pthread_cond_signal(ready: &var Hidden): c_int
	pub fn pthread_cond_broadcast(ready: &var Hidden): c_int
	pub fn pthread_cond_destroy(ready: &var Hidden): c_int
}

// Processes. A `pid_t` is an `int`, and `mode_t`, 16 bits
// on a Mac, arrives extended to 32.

extern "C" {
	pub fn posix_spawnp(
		pid: &var c_int,
		program: cstring,
		actions: &Hidden,
		attributes: ptr<u8>,
		arguments: ptr<cstring>,
		environment: ptr<cstring>,
	): c_int
	pub fn posix_spawn_file_actions_init(actions: &var Hidden): c_int
	pub fn posix_spawn_file_actions_destroy(actions: &var Hidden): c_int
	pub fn posix_spawn_file_actions_addopen(
		actions: &var Hidden,
		fd: c_int,
		path: cstring,
		flags: c_int,
		mode: c_uint,
	): c_int
	pub fn posix_spawn_file_actions_adddup2(actions: &var Hidden, fd: c_int, to: c_int): c_int
	pub fn posix_spawn_file_actions_addclose(actions: &var Hidden, fd: c_int): c_int
	pub fn posix_spawn_file_actions_addchdir_np(actions: &var Hidden, path: cstring): c_int
	pub fn pipe(ends: &var Pipe): c_int
	pub fn waitpid(pid: c_int, status: &var c_int, options: c_int): c_int
	/// A signal sent to a process, or with 0 to every process of this
	/// one's group.
	pub fn kill(pid: c_int, signal: c_int): c_int
	/// This process copied: 0 in the copy, the copy's number in this one.
	pub fn fork(): c_int
	/// The process's group set; `setpgid(0, 0)` makes it a group of its own.
	pub fn setpgid(pid: c_int, group: c_int): c_int
	/// The files, and how many: what a slice crosses as. `nfds_t` is 32
	/// bits on a Mac and 64 on Linux; a Mac reads the low 32.
	pub fn poll(watched: &var [PollFd], timeout: c_int): c_int
}

// What keeps a program started from being given a descriptor this one
// opened, without a moment between making one and marking it in which
// another thread could start a program that takes it. A Mac starts a
// program with every descriptor closed but those its file actions name;
// Linux makes a pipe already marked.

/// A `posix_spawnattr_t`: a pointer on a Mac, and 336 bytes on Linux,
/// which this has room for.
pub extern struct SpawnAttributes {
	/// What C keeps there, which Wip never reads.
	pub words: [u64; 48]
}

/// A `SpawnAttributes` for C to initialize.
pub fn spawnAttributes(): SpawnAttributes = SpawnAttributes([0; 48])

extern "C" {
	/// `posix_spawnp` with its attributes.
	@symbol("posix_spawnp")
	pub fn posix_spawnpWith(
		pid: &var c_int,
		program: cstring,
		actions: &Hidden,
		attributes: &SpawnAttributes,
		arguments: ptr<cstring>,
		environment: ptr<cstring>,
	): c_int
	pub fn posix_spawnattr_init(attributes: &var SpawnAttributes): c_int
	pub fn posix_spawnattr_setflags(attributes: &var SpawnAttributes, flags: i16): c_int
	pub fn posix_spawnattr_destroy(attributes: &var SpawnAttributes): c_int
	/// The signals the program started holds back, a `sigset_t`.
	pub fn posix_spawnattr_setsigmask(attributes: &var SpawnAttributes, set: &Hidden): c_int
	/// The signals the program started handles as a program does that has
	/// said nothing of them.
	pub fn posix_spawnattr_setsigdefault(attributes: &var SpawnAttributes, set: &Hidden): c_int
}

/// `posix_spawnattr_setflags`: the signals `setsigdefault` gives handled as
/// a program does that has said nothing of them.
pub val POSIX_SPAWN_SETSIGDEF: i16 = 4
/// `posix_spawnattr_setflags`: the signals held back as `setsigmask` says.
pub val POSIX_SPAWN_SETSIGMASK: i16 = 8

/// The two ends of a pipe, as `pipe` fills them in.
pub extern struct Pipe {
	/// The end that is read from.
	pub reading: c_int
	/// The end that is written to.
	pub writing: c_int
}

/// A file `poll` watches: what to wait for, and what came.
pub extern struct PollFd {
	/// The descriptor.
	pub fd: c_int
	/// What to wait for: `POLLIN`.
	pub events: i16
	/// What came, which `poll` fills in.
	pub answered: i16
}

/// `poll`: there is something to read, or the other end has closed.
pub val POLLIN: i16 = 1
/// `poll`: there is room to write.
pub val POLLOUT: i16 = 4
/// `poll`: the other end of a pipe written to has closed.
pub val POLLERR: i16 = 8
/// `poll`: the other end has hung up.
pub val POLLHUP: i16 = 16
/// `waitpid`: answer at once where the child has not ended.
pub val WNOHANG: c_int = 1
/// The signal that ends a program, which it cannot catch.
pub val SIGKILL: c_int = 9
/// The signal a write to a pipe no one reads raises, which ends a program
/// that has not said otherwise.
pub val SIGPIPE: c_int = 13

// Signals a thread holds back: a `sigset_t`, 4 bytes on a Mac and 128 on
// Linux, is room in a `Hidden`.

extern "C" {
	pub fn sigemptyset(set: &var Hidden): c_int
	pub fn sigaddset(set: &var Hidden, signal: c_int): c_int
	pub fn sigismember(set: &Hidden, signal: c_int): c_int
	pub fn sigpending(set: &var Hidden): c_int
	pub fn sigwait(set: &Hidden, signal: &var c_int): c_int
	pub fn pthread_sigmask(how: c_int, set: &Hidden, old: &var Hidden): c_int
}

extern "C" {
	/// What a signal does from now on: `SIG_DFL`, `SIG_IGN`, or a handler;
	/// answers what it did.
	pub fn signal(signal: c_int, handler: i64): i64
}

/// `signal`: what a program does that has said nothing of the signal.
pub val SIG_DFL: i64 = 0
/// `signal`: nothing.
pub val SIG_IGN: i64 = 1

/// Signals numbered alike on every system Wip targets.
pub val SIGHUP: c_int = 1
pub val SIGINT: c_int = 2
pub val SIGQUIT: c_int = 3
pub val SIGTERM: c_int = 15

/// Holds back `SIGPIPE` on this thread while it writes to a pipe or a
/// socket no one may read, so that the write answers `EPIPE` rather than
/// end the program. Linux raises it in the thread that wrote; a Mac raises
/// it for the whole process, where a descriptor is told not to raise it at
/// all. Answers the signals held back before, for `releasePipeSignal`.
pub fn holdPipeSignal(): Hidden = {
	var pipeSignal = hidden()
	sigemptyset(&var pipeSignal)
	sigaddset(&var pipeSignal, SIGPIPE)
	var before = hidden()
	pthread_sigmask(SIG_BLOCK, &pipeSignal, &var before)
	return before
}

/// Puts back the signals held back `before`, having taken a `SIGPIPE` the
/// writing raised, so that it is not let through afterwards.
pub fn releasePipeSignal(before: &Hidden) = {
	var pending = hidden()
	sigemptyset(&var pending)
	sigpending(&var pending)
	if sigismember(&pending, SIGPIPE) == 1 && sigismember(&before, SIGPIPE) != 1 {
		var pipeSignal = hidden()
		sigemptyset(&var pipeSignal)
		sigaddset(&var pipeSignal, SIGPIPE)
		var taken = 0
		sigwait(&pipeSignal, &var taken)
	}
	var ignored = hidden()
	pthread_sigmask(SIG_SETMASK, &before, &var ignored)
}

// Users and groups, and what this process may do: whom it acts as, where
// its root is, and how much it may hold.

extern "C" {
	/// The user and group this process acts as, for what it may touch.
	pub fn geteuid(): u32
	pub fn getegid(): u32
	pub fn setuid(user: u32): c_int
	pub fn setgid(group: u32): c_int
	pub fn chdir(path: cstring): c_int
	pub fn chroot(path: cstring): c_int
	/// A path's owner set, each id `0xFFFFFFFF` to leave it as it is.
	pub fn chown(path: cstring, user: u32, group: u32): c_int
	/// A user or a group found by name or number, its strings written into
	/// `room`: 0 where it was looked for, and `found` null where there is
	/// none, `ERANGE` where the room is too small.
	pub fn getpwnam_r(
		name: cstring,
		into: ptr<u8>,
		room: ptr<u8>,
		size: size_t,
		found: &var ptr<u8>,
	): c_int
	pub fn getpwuid_r(
		id: u32,
		into: ptr<u8>,
		room: ptr<u8>,
		size: size_t,
		found: &var ptr<u8>,
	): c_int
	pub fn getgrnam_r(
		name: cstring,
		into: ptr<u8>,
		room: ptr<u8>,
		size: size_t,
		found: &var ptr<u8>,
	): c_int
	pub fn getgrgid_r(
		id: u32,
		into: ptr<u8>,
		room: ptr<u8>,
		size: size_t,
		found: &var ptr<u8>,
	): c_int
	pub fn getrlimit(resource: c_int, limit: &var Rlimit): c_int
	pub fn setrlimit(resource: c_int, limit: &Rlimit): c_int
}

/// How much of a resource a process may hold: what it may hold now, and
/// the most it may raise that to. Each system says "no limit" its own way.
pub extern struct Rlimit {
	pub current: u64 = 0
	pub most: u64 = 0
}

// The resources a limit is set on, each system numbering its own.
pub val RLIMIT_STACK: c_int = 3
pub val RLIMIT_CORE: c_int = 4
