// A Mac's and iOS's C library: the names it gives what is a macro in C's
// headers, and the numbers it gives what each system numbers its own way.

// Streams: standard output and error, buffered by C.

extern "C" {
	/// Standard output.
	@symbol("__stdoutp")
	pub val stdout: ptr<FILE>
	/// Standard error.
	@symbol("__stderrp")
	pub val stderr: ptr<FILE>
}

// Files and descriptors.

/// `fcntl`, on a Mac: whether a write to a pipe no one reads answers
/// `EPIPE` alone, without raising `SIGPIPE`.
pub val F_SETNOSIGPIPE: c_int = 73

/// `sysconf`: how many processors are working.
pub val SC_NPROCESSORS_ONLN: c_int = 58

// The rest of `open`'s flags, which each system numbers its own way.

/// `open`: every write goes at the end.
pub val O_APPEND: c_int = 8
/// `open`: made where it is not there.
pub val O_CREAT: c_int = 512
/// `open`: emptied where it is there.
pub val O_TRUNC: c_int = 1024
/// `open`, with `O_CREAT`: fails where it is there already.
pub val O_EXCL: c_int = 2048
/// `open` and `fcntl`: a read or a write that would wait answers `EAGAIN`.
pub val O_NONBLOCK: c_int = 4
/// `open`: closed in a program started, as `closeOnExec` makes it.
pub val O_CLOEXEC: c_int = 16777216

// Errors: `errno`, which is a macro over a function each C library names
// its own way, and the numbers this system gives its own.

extern "C" {
	/// Where this thread's `errno` is.
	@symbol("__error")
	pub fn errnoAt(): ptr<c_int>
}

/// Nothing can be done now without waiting, on a descriptor that does not
/// wait: each system numbers it its own way.
pub val EAGAIN: c_int = 35

// What a connection fails with, each system numbering its
// own.
pub val EADDRINUSE: c_int = 48
pub val ECONNREFUSED: c_int = 61
pub val ECONNRESET: c_int = 54
pub val ENOTCONN: c_int = 57
pub val ETIMEDOUT: c_int = 60
pub val ENAMETOOLONG: c_int = 63

// What keeps a program started from being given a descriptor this one
// opened, without a moment between making one and marking it in which
// another thread could start a program that takes it: a Mac starts a
// program with every descriptor closed but those its file actions name.

extern "C" {
	/// A descriptor kept open in the program started, as it is in this one.
	pub fn posix_spawn_file_actions_addinherit_np(actions: &var Hidden, fd: c_int): c_int
}

/// `posix_spawnattr_setflags`: every descriptor closed in the program
/// started but those its file actions name.
pub val POSIX_SPAWN_CLOEXEC_DEFAULT: i16 = 16384

// Signals a thread holds back.

/// A program this one started ended or stopped.
pub val SIGCHLD: c_int = 20

/// `pthread_sigmask`: hold back the signals given no longer.
pub val SIG_UNBLOCK: c_int = 2

/// `pthread_sigmask`: hold back the signals given as well.
pub val SIG_BLOCK: c_int = 1
/// `pthread_sigmask`: hold back exactly the signals given.
pub val SIG_SETMASK: c_int = 3

// Users and groups, and what this process may do: whom it acts as, where
// its root is, and how much it may hold.

/// The groups beyond its own a process belongs to, set: the count is an
/// `int` on a Mac and a `size_t` on Linux.
extern "C" {
	pub fn setgroups(count: c_int, groups: &[u32]): c_int
}

pub val RLIM_INFINITY: u64 = 0x7FFFFFFFFFFFFFFF

pub val RLIMIT_NPROC: c_int = 7
pub val RLIMIT_NOFILE: c_int = 8

// The process, as the system counts it.

/// What `proc_pidinfo` answers with `PROC_PIDTASKINFO`: a task's memory,
/// its times, and its threads. `<libproc.h>` declares it on a Mac, and iOS
/// has the function without the header, so it is laid out here as C lays
/// it out.
pub extern struct ProcTaskInfo {
	virtualSize: u64 = 0
	residentSize: u64 = 0
	totalUser: u64 = 0
	totalSystem: u64 = 0
	threadsUser: u64 = 0
	threadsSystem: u64 = 0
	policy: i32 = 0
	faults: i32 = 0
	pageins: i32 = 0
	cowFaults: i32 = 0
	messagesSent: i32 = 0
	messagesReceived: i32 = 0
	syscallsMach: i32 = 0
	syscallsUnix: i32 = 0
	contextSwitches: i32 = 0
	pub threads: i32 = 0
	running: i32 = 0
	priority: i32 = 0
}

/// `proc_pidinfo`'s flavor for a `ProcTaskInfo`.
pub val PROC_PIDTASKINFO: c_int = 4

extern "C" {
	/// What the system knows of process `pid`, of the kind `flavor` names,
	/// written to `into`: the bytes written, or 0 where it failed.
	@symbol("proc_pidinfo")
	pub fn procTaskInfo(
		pid: c_int,
		flavor: c_int,
		arg: u64,
		into: &var ProcTaskInfo,
		size: c_int,
	): c_int
}
