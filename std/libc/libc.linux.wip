// Linux's C library, glibc: the names it gives what is a macro in C's
// headers, and the numbers it gives what each system numbers its own way.

// Streams: standard output and error, buffered by C.

extern "C" {
	/// Standard output.
	pub val stdout: ptr<FILE>
	/// Standard error.
	pub val stderr: ptr<FILE>
}

// Files and descriptors.

/// `sysconf`: how many processors are working.
pub val SC_NPROCESSORS_ONLN: c_int = 84

// The rest of `open`'s flags, which each system numbers its own way.

/// `open`: every write goes at the end.
pub val O_APPEND: c_int = 1024
/// `open`: made where it is not there.
pub val O_CREAT: c_int = 64
/// `open`: emptied where it is there.
pub val O_TRUNC: c_int = 512
/// `open`, with `O_CREAT`: fails where it is there already.
pub val O_EXCL: c_int = 128
/// `open` and `fcntl`: a read or a write that would wait answers `EAGAIN`.
pub val O_NONBLOCK: c_int = 2048
/// `open`: closed in a program started, as `closeOnExec` makes it.
pub val O_CLOEXEC: c_int = 524288

// Errors: `errno`, which is a macro over a function each C library names
// its own way, and the numbers this system gives its own.

extern "C" {
	/// Where this thread's `errno` is.
	@symbol("__errno_location")
	pub fn errnoAt(): ptr<c_int>
}

/// Nothing can be done now without waiting, on a descriptor that does not
/// wait: each system numbers it its own way.
pub val EAGAIN: c_int = 11

pub val EADDRINUSE: c_int = 98
pub val ECONNREFUSED: c_int = 111
pub val ECONNRESET: c_int = 104
pub val ENOTCONN: c_int = 107
pub val ETIMEDOUT: c_int = 110
pub val ENAMETOOLONG: c_int = 36

// What keeps a program started from being given a descriptor this one
// opened, without a moment between making one and marking it in which
// another thread could start a program that takes it: Linux makes a
// pipe already marked.

extern "C" {
	/// `pipe`, with flags: `O_CLOEXEC` makes both ends already marked.
	pub fn pipe2(ends: &var Pipe, flags: c_int): c_int
}

// Signals a thread holds back.

/// A program this one started ended or stopped.
pub val SIGCHLD: c_int = 17

/// `pthread_sigmask`: hold back the signals given no longer.
pub val SIG_UNBLOCK: c_int = 1

/// `pthread_sigmask`: hold back the signals given as well.
pub val SIG_BLOCK: c_int = 0
/// `pthread_sigmask`: hold back exactly the signals given.
pub val SIG_SETMASK: c_int = 2

// Users and groups, and what this process may do: whom it acts as, where
// its root is, and how much it may hold.

/// The groups beyond its own a process belongs to, set: the count is an
/// `int` on a Mac and a `size_t` on Linux.
extern "C" {
	pub fn setgroups(count: size_t, groups: &[u32]): c_int
}

pub val RLIM_INFINITY: u64 = 0xFFFFFFFFFFFFFFFF

pub val RLIMIT_NPROC: c_int = 6
pub val RLIMIT_NOFILE: c_int = 7
