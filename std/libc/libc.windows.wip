// Windows: Microsoft's C library, the UCRT, under the names its headers make
// of C's — `stdout` is a call, `errno` another — and the numbers it gives
// what each C library numbers its own way; then the calls of Windows itself
// the library is written over, by the system library that holds each.
//
// A program's code page is UTF-8, which its manifest says, so the C
// library's text — a path, an argument, a variable — is UTF-8, as Wip's is.

// `printf` and the rest of its family are functions the UCRT's headers
// define, and its library has none of: what C compiled against no header
// calls is in `legacy_stdio_definitions`, which Microsoft keeps for it.

@link("legacy_stdio_definitions")
extern "C" {}

// Streams: standard input, output and error are the UCRT's first three.

extern "C" {
	@symbol("__acrt_iob_func")
	fn standardStream(index: c_uint): ptr<FILE>
}

/// Standard output, buffered by C.
pub fn stdout(): ptr<FILE> = standardStream(1)

/// Standard error, which C does not buffer.
pub fn stderr(): ptr<FILE> = standardStream(2)

// Descriptors: the UCRT's, which a stream and a console are read and
// written through, as POSIX's are. A count is an `int` here, answered as
// POSIX's `ssize_t` is, so that the library's code is one on both.

/// Reads into `bytes`: how many, 0 at the end, -1 where it failed.
pub fn read(fd: c_int, bytes: &var [u8]): ssize_t = readInt(fd, &var bytes) as ssize_t

/// Writes `bytes`: how many, -1 where it failed.
pub fn write(fd: c_int, bytes: &[u8]): ssize_t = writeInt(fd, &bytes) as ssize_t

extern "C" {
	@symbol("_read")
	fn readInt(fd: c_int, bytes: &var [u8]): c_int
	@symbol("_write")
	fn writeInt(fd: c_int, bytes: &[u8]): c_int
	@symbol("_isatty")
	pub fn isatty(fd: c_int): c_int
	/// Whether a descriptor's bytes are changed as they pass: `\n` and
	/// `\r\n` in text mode, as they are not in binary.
	@symbol("_setmode")
	pub fn setmode(fd: c_int, mode: c_int): c_int
	/// The handle of Windows' own a descriptor is over.
	@symbol("_get_osfhandle")
	pub fn handleOf(fd: c_int): i64
	/// A descriptor over a handle of Windows' own, which closing it closes.
	@symbol("_open_osfhandle")
	pub fn descriptorOf(handle: i64, flags: c_int): c_int
	@symbol("_close")
	pub fn close(fd: c_int): c_int
}

/// `descriptorOf`: for reading only, or writing only, or written at the
/// end.
pub val O_RDONLY: c_int = 0
pub val O_WRONLY: c_int = 1
pub val O_APPEND: c_int = 8

/// `setmode`: bytes as they are.
pub val O_BINARY: c_int = 0x8000

// Errors: `errno`, a call, and the UCRT's numbers for what `std::io` tells
// apart.

extern "C" {
	/// Where this thread's `errno` is.
	@symbol("_errno")
	pub fn errnoAt(): ptr<c_int>
}

pub val EAGAIN: c_int = 11
pub val EADDRINUSE: c_int = 100
pub val ECONNREFUSED: c_int = 107
pub val ECONNRESET: c_int = 108
pub val ENOTCONN: c_int = 126
pub val ETIMEDOUT: c_int = 138
pub val ENAMETOOLONG: c_int = 38

// The environment: the UCRT's copy, which `_putenv_s` changes in place.

extern "C" {
	/// Sets `name` to `value`, or takes it out where `value` is empty.
	@symbol("_putenv_s")
	pub fn putenv(name: cstring, value: cstring): c_int
}

// Sockets waited on: `poll` as Winsock has it, for sockets alone.

@link("ws2_32")
extern "C" {
	/// Waits for `millis`, -1 as long as it takes, until one of `sockets` is
	/// ready: how many are, or -1.
	pub fn WSAPoll(sockets: &var [PollSocket], millis: c_int): c_int
}

/// `WSAPOLLFD`: a socket, what it is waited for, and what it is ready for.
pub extern struct PollSocket {
	pub socket: u64 = 0
	pub events: i16 = 0
	pub answered: i16 = 0
}

/// What a socket is waited for and answers: bytes, or a connection, to
/// take; room to write; and that it failed, was hung up on, or is no
/// socket.
pub val POLLRDNORM: i16 = 0x100
pub val POLLWRNORM: i16 = 0x10
pub val POLLERR: i16 = 0x1
pub val POLLHUP: i16 = 0x2
pub val POLLNVAL: i16 = 0x4

// Randomness: the system's generator for secrets, as `getentropy` gives
// a Unix's.

@link("bcrypt")
extern "C" {
	fn BCryptGenRandom(algorithm: i64, into: ptr<u8>, size: u32, flags: u32): i32
}

/// `BCryptGenRandom`: the system's own generator, no algorithm named.
val BCRYPT_USE_SYSTEM_PREFERRED_RNG: u32 = 2

/// `bytes` filled from the system's generator for secrets: 0 where they
/// were and -1 where they were not, as a Unix's `getentropy` answers.
pub fn getentropy(bytes: &var [u8]): c_int =
	if BCryptGenRandom(0, &var bytes, bytes.len() as u32, BCRYPT_USE_SYSTEM_PREFERRED_RNG) == 0 then
		0
	else -1

// The environment Windows keeps, which a program started is given.

@link("kernel32")
extern "C" {
	/// What `name` holds, into `into`: how many bytes, or how many are
	/// needed with the NUL where there is too little room; 0 where there is
	/// no such variable.
	pub fn GetEnvironmentVariableA(name: cstring, into: ptr<u8>, size: u32): u32
	/// Sets `name` to `value`, or takes it out where `value` is null.
	pub fn SetEnvironmentVariableA(name: cstring, value: cstring): c_int
	/// Every `NAME=value`, one after another, ended by an empty one.
	pub fn GetEnvironmentStringsA(): ptr<u8>
	pub fn FreeEnvironmentStringsA(block: ptr<u8>): c_int
}

// Windows itself: the console, the clock, the stack, and the last error,
// in `kernel32`, which every program links.

@link("kernel32")
extern "C" {
	/// The processor's registers here, into a `CONTEXT`: where a walk of
	/// the calls that led here begins.
	pub fn RtlCaptureContext(context: ptr<u8>)
	/// Where the calling thread's stack is: the lowest address it may grow
	/// to and the one above its top, the whole of what it reserved.
	pub fn GetCurrentThreadStackLimits(low: &var u64, high: &var u64)
	/// The unwind information of the function at `pc`, and the base of the
	/// image it is in; null for a leaf, which has none.
	pub fn RtlLookupFunctionEntry(pc: u64, base: &var u64, history: ptr<u8>): ptr<u8>
	/// `context` taken back one call, by `function`'s unwind information:
	/// its registers as the caller had them.
	pub fn RtlVirtualUnwind(
		kind: u32,
		base: u64,
		pc: u64,
		function: ptr<u8>,
		context: ptr<u8>,
		handler: &var ptr<u8>,
		frame: &var u64,
		pointers: ptr<u8>,
	): ptr<u8>
	/// A count on the clock that only goes forward, and how many it counts
	/// a second: the same from the system's start to its end.
	pub fn QueryPerformanceCounter(count: &var i64): c_int
	pub fn QueryPerformanceFrequency(frequency: &var i64): c_int
	/// The time of day, as hundreds of nanoseconds since 1601, in UTC.
	pub fn GetSystemTimePreciseAsFileTime(time: &var u64)
	/// Sleeps for `milliseconds`.
	pub fn Sleep(milliseconds: u32)
	/// What the last call of Windows' own that failed said.
	pub fn GetLastError(): u32
	/// Which code page a console writes text in.
	pub fn SetConsoleOutputCP(page: u32): c_int
	pub fn CloseHandle(handle: i64): c_int
	pub fn GetCurrentProcessId(): u32
	/// Waits for a handle — a process to end — for `millis`, `INFINITE`
	/// for as long as it takes: 0 where it did.
	pub fn WaitForSingleObject(handle: i64, millis: u32): u32
	/// What a pipe holds to be read, without reading it: 0 where its
	/// writer has gone.
	pub fn PeekNamedPipe(
		pipe: i64,
		buffer: ptr<u8>,
		size: u32,
		read: ptr<u32>,
		available: &var u32,
		left: ptr<u32>,
	): c_int
}

/// `WaitForSingleObject`: as long as it takes.
pub val INFINITE: u32 = 0xFFFFFFFF

/// The code page that is UTF-8.
pub val CP_UTF8: u32 = 65001
