// A `Mutex`'s lock on Windows: a slim reader-writer lock, taken by one
// thread at a time, and a condition variable that waits for a change. Both
// are a pointer's room, made by zeroing it, and nothing is freed.

import std::libc::{Hidden}
import std::time::{Duration}

@link("kernel32")
extern "C" {
	fn AcquireSRWLockExclusive(lock: &var Hidden)
	fn TryAcquireSRWLockExclusive(lock: &var Hidden): u8
	fn ReleaseSRWLockExclusive(lock: &var Hidden)
	fn WakeAllConditionVariable(changed: &var Hidden)
	fn SleepConditionVariableSRW(
		changed: &var Hidden,
		lock: &var Hidden,
		millis: u32,
		flags: u32,
	): c_int
}

/// `SleepConditionVariableSRW`: as long as it takes.
val INFINITE: u32 = 0xFFFFFFFF

/// The lock and its condition, made in place: `hidden()` is already both.
fn madeState(_: ptr<MutexState>) = {}

fn acquire(state: ptr<MutexState>) = {
	AcquireSRWLockExclusive(&var state.lock)
}

/// Whether the lock was taken, where no other thread held it.
fn tryAcquire(state: ptr<MutexState>): bool = TryAcquireSRWLockExclusive(&var state.lock) != 0

/// The lock let go, and every thread that waits for a change woken.
fn release(state: ptr<MutexState>) = {
	WakeAllConditionVariable(&var state.changed)
	ReleaseSRWLockExclusive(&var state.lock)
}

/// The lock let go, waking nobody.
fn unlock(state: ptr<MutexState>) = {
	ReleaseSRWLockExclusive(&var state.lock)
}

/// Waits for a change, the lock held: let go while it waits, and held
/// again when it answers.
fn waitFor(state: ptr<MutexState>) = {
	SleepConditionVariableSRW(&var state.changed, &var state.lock, INFINITE, 0)
}

/// Waits for a change, the lock held, for at most `left`, in whole
/// milliseconds, rounded up so that a wait is never shorter than asked: on
/// the clock that only goes forward, as Windows waits.
fn waitAtMost(state: ptr<MutexState>, left: Duration) = {
	val millis = ((left.asNanos() + 999999) / 1000000).max(0).min(0xFFFFFFFE) as u32
	SleepConditionVariableSRW(&var state.changed, &var state.lock, millis, 0)
}

fn freedState(_: ptr<MutexState>) = {}
