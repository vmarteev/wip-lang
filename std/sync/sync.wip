// What several threads may change at once: `Atomic<T>`,
// changed in one step that no thread sees half of, and `Mutex<T>`, reached
// by one thread at a time. They are the two ways to change a place through
// a `&`, which is what makes them safe to borrow from threads that
// `future::both` and `future::each` run.
//
// Every atomic operation is sequentially consistent unless it is given
// another order: all threads agree on one order of every such operation,
// which is what a counter or a flag needs and the easiest to get right. A
// lock-free queue names the weaker orders it is written with, which cost
// less where the processor orders less by itself. What adds and takes away
// wraps for integers, as `+%` and `-%` do.

import std::libc::{
	Hidden,
	hidden,
	pthread_cond_broadcast,
	pthread_cond_destroy,
	pthread_cond_init,
	pthread_cond_wait,
	pthread_mutex_destroy,
	pthread_mutex_init,
	pthread_mutex_lock,
	pthread_mutex_unlock
}

/// What an `Atomic` may hold: `bool`, the integers and floats of up to 64
/// bits, and C pointers.
pub interface AtomicValue {}

/// What an `Atomic` may add to and take from: the integers and floats of up
/// to 64 bits.
pub interface AtomicNumber {}

extend bool: AtomicValue {}

extend i8: AtomicValue {}

extend i8: AtomicNumber {}

extend i16: AtomicValue {}

extend i16: AtomicNumber {}

extend i32: AtomicValue {}

extend i32: AtomicNumber {}

extend i64: AtomicValue {}

extend i64: AtomicNumber {}

extend isize: AtomicValue {}

extend isize: AtomicNumber {}

extend u8: AtomicValue {}

extend u8: AtomicNumber {}

extend u16: AtomicValue {}

extend u16: AtomicNumber {}

extend u32: AtomicValue {}

extend u32: AtomicNumber {}

extend u64: AtomicValue {}

extend u64: AtomicNumber {}

extend usize: AtomicValue {}

extend usize: AtomicNumber {}

extend f32: AtomicValue {}

extend f32: AtomicNumber {}

extend f64: AtomicValue {}

extend f64: AtomicNumber {}

extend ptr<T>: AtomicValue {}

/// How an atomic operation is ordered against what other threads read and
/// write, as C's memory orders are. `Relaxed` orders nothing but the
/// operation itself; `Acquire`, on what reads, keeps what this thread does
/// after it from being seen before it; `Release`, on what writes, keeps
/// what this thread did before it from being seen after it; `AcqRel` is
/// both; `SeqCst` is both, and every thread agrees on one order of every
/// such operation.
pub enum Order {
	Relaxed
	Acquire
	Release
	AcqRel
	SeqCst
}

/// The orders a load may take: what reads cannot release.
pub enum LoadOrder {
	Relaxed
	Acquire
	SeqCst
}

/// The orders a store may take: what writes cannot acquire.
pub enum StoreOrder {
	Relaxed
	Release
	SeqCst
}

/// A value several threads may read and change at once, each change one
/// step that no thread sees half of. It is moved, never copied: a copy
/// would be a read that is not one step.
@intrinsic
pub struct Atomic<T> {
	value: T
}

extend Atomic<T: AtomicValue + copy> {
	/// An atomic holding `value`.
	pub static fn of(value: T): Atomic<T> = Atomic(value)

	/// What it holds.
	pub fn load(order: LoadOrder = .SeqCst): T = atomicLoad(&self.value, order)

	/// Makes it hold `value`.
	pub fn store(value: T, order: StoreOrder = .SeqCst) = atomicStore(&self.value, value, order)

	/// Makes it hold `value`, and answers what it held.
	pub fn swap(value: T, order: Order = .SeqCst): T = atomicSwap(&self.value, value, order)

	/// Makes it hold `value` where it holds `expected`, and answers whether
	/// it did: no other thread changed it in between. What it holds is
	/// compared bit for bit, so a float's NaN is the NaN it was, and `-0.0`
	/// is not `0.0`. Where it finds another value it writes nothing, and its
	/// read is ordered as the strongest load `order` allows.
	pub fn replaceIf(expected: T, value: T, order: Order = .SeqCst): bool = atomicCompareSwap(
		&self.value,
		expected,
		value,
		order,
	)
}

extend Atomic<T: AtomicNumber + copy> {
	/// Adds `amount` to it, an integer wrapping, and answers what it held.
	pub fn add(amount: T, order: Order = .SeqCst): T = atomicAdd(&self.value, amount, order)

	/// Takes `amount` from it, an integer wrapping, and answers what it
	/// held.
	pub fn subtract(amount: T, order: Order = .SeqCst): T = atomicSubtract(
		&self.value,
		amount,
		order,
	)
}

/// Orders this thread's reads and writes against other threads' atomic
/// operations, with nothing read or written: a `.Release` fence before a
/// relaxed store publishes what came before it, as a release store would,
/// and an `.Acquire` fence after a relaxed load sees what was published. A
/// `.Relaxed` fence orders nothing.
pub fn fence(order: Order) = atomicFence(order)

@intrinsic
fn atomicFence(order: Order)

@intrinsic
fn atomicLoad<T>(at: &T, order: LoadOrder): T

@intrinsic
fn atomicStore<T>(at: &T, value: T, order: StoreOrder)

@intrinsic
fn atomicSwap<T>(at: &T, value: T, order: Order): T

@intrinsic
fn atomicCompareSwap<T>(at: &T, expected: T, value: T, order: Order): bool

@intrinsic
fn atomicAdd<T>(at: &T, amount: T, order: Order): T

@intrinsic
fn atomicSubtract<T>(at: &T, amount: T, order: Order): T

/// A value one thread at a time may reach. A `&` to the mutex is enough to
/// lock it, so threads that `future::both` runs share one by borrowing
/// it; what is inside is lent to one of them at a time, as a `&var`, for as
/// long as a call.
pub struct Mutex<T> {
	state: ptr<MutexState>
	/// The value, boxed; nothing once `take` has it.
	value: ptr<T>
}

// The lock and what waits for a change, boxed: a pthread mutex must not move
// once made, and a `Mutex` may.
extern struct MutexState {
	lock: Hidden
	changed: Hidden
}

extend Mutex<T> {
	/// A mutex holding `value`.
	pub static fn of(value: T): Mutex<T> = {
		val made = own MutexState(lock: hidden(), changed: hidden())
		val state = intoAddress(made) as ptr<MutexState>
		pthread_mutex_init(&var state.lock, null)
		pthread_cond_init(&var state.changed, null)
		return Mutex(state: state, value: intoAddress(own (value)) as ptr<T>)
	}

	/// Runs `body` with what is inside, which no other thread reaches until
	/// it answers; what `body` answers, this answers. The threads waiting in
	/// `lockWhen` are told it may have changed.
	pub fn lock<R>(body: &var (value: &var T) => R): R = {
		pthread_mutex_lock(&var self.state.lock)
		val answer = body(&var referenceAt<T>(self.value as ptr<void>))
		pthread_cond_broadcast(&var self.state.changed)
		pthread_mutex_unlock(&var self.state.lock)
		return answer
	}

	/// Waits until `ready` says what is inside is ready — asking again each
	/// time another thread's `lock` or `lockWhen` ends — and then runs `body`
	/// with it, as `lock` does.
	pub fn lockWhen<R>(ready: &(value: &T) => bool, body: &var (value: &var T) => R): R = {
		pthread_mutex_lock(&var self.state.lock)
		while !ready(&referenceAt<T>(self.value as ptr<void>)) {
			pthread_cond_wait(&var self.state.changed, &var self.state.lock)
		}
		val answer = body(&var referenceAt<T>(self.value as ptr<void>))
		pthread_cond_broadcast(&var self.state.changed)
		pthread_mutex_unlock(&var self.state.lock)
		return answer
	}

	/// What is inside, taken out: the mutex is used up.
	pub move fn take(): T = {
		var mutex = self
		val boxed: own<T> = fromAddress(mutex.value as ptr<u8>)
		mutex.value = null
		return unbox(boxed)
	}
}

extend Mutex<T>: Destroy {
	var fn destroy() = {
		if self.value != null {
			val gone: own<T> = fromAddress(self.value as ptr<u8>)
		}
		pthread_cond_destroy(&var self.state.changed)
		pthread_mutex_destroy(&var self.state.lock)
		val freed: own<MutexState> = fromAddress(self.state as ptr<u8>)
	}
}

/// The box an `own` points to, as an address C can hold.
@intrinsic
fn intoAddress<T>(value: own<T>): ptr<u8>

/// The box at an address `intoAddress` gave, owned again.
@intrinsic
fn fromAddress<T>(address: ptr<u8>): own<T>

/// What a box holds, taken out; the box is freed.
@intrinsic
fn unbox<T>(boxed: own<T>): T

/// What is at an address, lent for writing.
@intrinsic
fn referenceAt<T>(data: ptr<void>): &var T
