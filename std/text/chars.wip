// A text's characters, one at a time: what `text.chars()` answers. The method
// is the prelude's; the type is here, to be imported where a program keeps one.

/// The characters of a text, one at a time: what `text.chars()` answers.
pub view struct Chars {
	text: str
	at: i64
}

extend Chars {
	/// What `text.chars()` makes: the characters from the start.
	pub static fn of(text: str): Chars = Chars(text: text, at: 0)
}

extend Chars: Iterator<char> {
	var fn next(): Option<char> = {
		if self.at >= self.text.len() then return .None
		val (c, width) = self.text.charAt(self.at)
		self.at += width
		return .Some(c)
	}
}
