// A text's characters, one at a time: what `text.chars()` answers. The method
// is the prelude's; the generator is here, and its type with it, to be
// imported where a program keeps one.

/// The characters of `text`, one at a time, read as UTF-8: what
/// `text.chars()` answers.
pub fn chars(text: str): Iterator<char> as Chars = {
	var at = 0
	while at < text.len() {
		val (c, width) = text.charAt(at)
		at += width
		yield c
	}
}
