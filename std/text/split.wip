// A text taken apart: what `text.split(",")` and
// `text.lines()` answer. Each piece is a `str` into the text. The methods
// are the prelude's; the types are here, to be imported where a program
// keeps one.

/// The pieces of a text between separators: what `text.split(",")`
/// answers.
pub view struct Split {
	text: str
	separator: str
	at: i64
	done: bool
}

extend Split {
	/// What `text.split(separator)` makes.
	pub static fn of(text: str, separator: str): Split = Split(
		text: text,
		separator: separator,
		at: 0,
		done: false,
	)
}

extend Split: Iterator<str> {
	var fn next(): Option<str> = {
		if self.done then return .None
		val rest = self.text[self.at..self.text.len()]
		if self.separator.isEmpty() {
			self.done = true
			return .Some(rest)
		}
		val .Some(offset) = rest.find(self.separator) else {
			self.done = true
			return .Some(rest)
		}
		self.at += offset + self.separator.len()
		return .Some(rest[0..offset])
	}
}

/// The lines of a text: what `text.lines()` answers.
pub view struct Lines {
	text: str
	at: i64
}

extend Lines {
	/// What `text.lines()` makes.
	pub static fn of(text: str): Lines = Lines(text: text, at: 0)
}

extend Lines: Iterator<str> {
	var fn next(): Option<str> = {
		if self.at >= self.text.len() then return .None
		val rest = self.text[self.at..self.text.len()]
		var end = rest.len()
		match rest.find("\n") {
			.Some(offset) => {
				end = offset
				self.at += offset + 1
			}
			.None => self.at = self.text.len()
		}
		// A line ended by `\r\n` is the line without either.
		if end > 0 && rest[end - 1] == '\r' as u8 then end -= 1
		return .Some(rest[0..end])
	}
}

/// The pieces of a text between separators, from the last: what
/// `text.rsplit("/")` answers.
pub view struct RSplit {
	text: str
	separator: str
	/// Where the text not taken apart yet ends.
	end: i64
	done: bool
}

extend RSplit {
	/// What `text.rsplit(separator)` makes.
	pub static fn of(text: str, separator: str): RSplit = RSplit(
		text: text,
		separator: separator,
		end: text.len(),
		done: false,
	)
}

extend RSplit: Iterator<str> {
	var fn next(): Option<str> = {
		if self.done then return .None
		val rest = self.text[0..self.end]
		if self.separator.isEmpty() {
			self.done = true
			return .Some(rest)
		}
		val .Some(at) = rest.findLast(self.separator) else {
			self.done = true
			return .Some(rest)
		}
		self.end = at
		return .Some(rest[at + self.separator.len()..rest.len()])
	}
}

/// At most so many pieces of a text: those between the first separators,
/// and then the rest, separators and all: what `text.splitn(2, "=")`
/// answers.
pub view struct SplitN {
	pieces: Split
	left: i64
}

extend SplitN {
	/// What `text.splitn(count, separator)` makes.
	pub static fn of(text: str, count: i64, separator: str): SplitN = SplitN(
		pieces: Split::of(text, separator),
		left: count,
	)
}

extend SplitN: Iterator<str> {
	var fn next(): Option<str> = {
		if self.left <= 0 || self.pieces.done then return .None
		self.left -= 1
		if self.left > 0 then return self.pieces.next()
		// The last piece is what is left, whatever separators it holds.
		self.pieces.done = true
		return .Some(self.pieces.text[self.pieces.at..self.pieces.text.len()])
	}
}

/// The words of a text: the pieces between runs of white space, none of
/// them empty: what `text.splitWhitespace()` answers.
pub view struct SplitWhitespace {
	text: str
	at: i64
}

extend SplitWhitespace {
	/// What `text.splitWhitespace()` makes.
	pub static fn of(text: str): SplitWhitespace = SplitWhitespace(text: text, at: 0)
}

extend SplitWhitespace: Iterator<str> {
	var fn next(): Option<str> = {
		while self.at < self.text.len() {
			val (c, width) = self.text.charAt(self.at)
			if !c.isWhitespace() then break
			self.at += width
		}
		if self.at >= self.text.len() then return .None
		val start = self.at
		while self.at < self.text.len() {
			val (c, width) = self.text.charAt(self.at)
			if c.isWhitespace() then break
			self.at += width
		}
		return .Some(self.text[start..self.at])
	}
}
