// A text taken apart: what `text.split(",")` and `text.lines()` answer. Each
// piece is a `str` into the text. The methods are the prelude's; the
// generators that make the pieces are here, and their types with them, to
// be imported where a program keeps one.

/// The pieces of `text` between each `separator`: what
/// `text.split(separator)` answers.
pub fn split(text: str, separator: str): Iterator<str> as Split = {
	if separator.isEmpty() {
		yield text
		return
	}
	var at = 0
	while true {
		val rest = text[at..text.len()]
		val .Some(offset) = rest.indexOf(separator) else {
			yield rest
			return
		}
		at += offset + separator.len()
		yield rest[0..offset]
	}
}

/// The lines of `text`: what `text.lines()` answers.
pub fn lines(text: str): Iterator<str> as Lines = {
	var at = 0
	while at < text.len() {
		val rest = text[at..text.len()]
		var end = rest.len()
		match rest.indexOf("\n") {
			.Some(offset) => {
				end = offset
				at += offset + 1
			}
			.None => at = text.len()
		}
		// A line ended by `\r\n` is the line without either.
		if end > 0 && rest[end - 1] == b'\r' then end -= 1
		yield rest[0..end]
	}
}

/// The pieces of `text` between each `separator`, from the last: what
/// `text.rsplit(separator)` answers.
pub fn rsplit(text: str, separator: str): Iterator<str> as RSplit = {
	if separator.isEmpty() {
		yield text
		return
	}
	var end = text.len()
	while true {
		val rest = text[0..end]
		val .Some(at) = rest.lastIndexOf(separator) else {
			yield rest
			return
		}
		end = at
		yield rest[at + separator.len()..rest.len()]
	}
}

/// At most `count` pieces of `text`: those between the first separators,
/// and then the rest, separators and all: what `text.splitn(count,
/// separator)` answers.
pub fn splitn(text: str, count: i64, separator: str): Iterator<str> as SplitN = {
	if count <= 0 then return
	var left = count
	var at = 0
	while true {
		val rest = text[at..text.len()]
		// The last piece is what is left, whatever separators it holds.
		if left == 1 || separator.isEmpty() {
			yield rest
			return
		}
		val .Some(offset) = rest.indexOf(separator) else {
			yield rest
			return
		}
		at += offset + separator.len()
		left -= 1
		yield rest[0..offset]
	}
}

/// The words of `text`: the pieces between runs of white space, none of
/// them empty: what `text.splitWhitespace()` answers.
pub fn splitWhitespace(text: str): Iterator<str> as SplitWhitespace = {
	var at = 0
	while true {
		while at < text.len() {
			val (c, width) = text.charAt(at)
			if !c.isWhitespace() then break
			at += width
		}
		if at >= text.len() then return
		val start = at
		while at < text.len() {
			val (c, width) = text.charAt(at)
			if c.isWhitespace() then break
			at += width
		}
		yield text[start..at]
	}
}
