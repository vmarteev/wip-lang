// What was wrong with text that should have been a number: what `"42".toInt()`
// and `toFloat()` answer when it is not one.

@derive(Eq)
pub enum ParseError {
	/// There were no digits at all.
	Empty
	/// The byte at this position, counted from the start, is not one the
	/// number could hold.
	BadDigit(at: i64)
	/// The digits are a number the type cannot hold.
	TooLarge
	/// The radix asked for is not one `toInt` reads: it takes 2 to 36.
	BadRadix(radix: i64)
}

extend ParseError: Text {
	fn toString(): String = match self {
		.Empty => "no digits"
		.BadDigit(at) => "not a digit at \(at)"
		.TooLarge => "too large for the type"
		.BadRadix(radix) => "a radix is 2 to 36, not \(radix)"
	}
}
