// A text read from the front, by byte position: what a parser reads its
// input through. The parser stays a program's own; the reader under it, the
// position and what is done with it, is here.

/// A text read from the front, a byte at a time, and a character where one
/// is asked for. `Scanner::of(source)` is one at the start.
///
/// What it answers of the text borrows the text, not the scanner: a token
/// cut out with `since` is kept while reading goes on.
///
///     var s = Scanner::of("width = 640")
///     val name = s.takeWhile((b) => b.isAsciiLetter())
///     s.skipWhile((b) => b == b' ')
///     assert(name == "width" && s.take(b'='))
pub view struct Scanner {
	/// What is read.
	pub text: str
	/// The byte offset of what is read next, from 0 to the text's length.
	/// Set back to where it has been, it reads again from there.
	pub var at: i64 = 0
}

/// Where a byte of a text is: its line, and its column in characters, each
/// counted from 1.
@derive(Eq, Text)
pub struct Position {
	pub line: i64
	pub column: i64
}

extend Scanner {
	/// One at the start of `text`.
	pub static fn of(text: str): Scanner = Scanner(text:)

	/// Whether everything is read.
	@inline
	pub fn isAtEnd(): bool = self.at >= self.text.len()

	/// The byte read next, or nothing at the end.
	@inline
	pub fn peek(): Option<u8> = if self.at < self.text.len() then self.text[self.at] else .None

	/// The byte `ahead` past the one read next, or nothing past the end:
	/// `peekAt(0)` is `peek()`.
	@inline
	pub fn peekAt(ahead: i64): Option<u8> = {
		val at = self.at + ahead
		return if at >= 0 && at < self.text.len() then self.text[at] else .None
	}

	/// The byte read next, taken, or nothing at the end.
	@inline
	pub var fn next(): Option<u8> = {
		if self.at >= self.text.len() then
			return .None

		self.at += 1
		return self.text[self.at - 1]
	}

	/// Takes the byte read next where it is `byte`, and says whether it did.
	@inline
	pub var fn take(byte: u8): bool = {
		if self.at >= self.text.len() || self.text[self.at] != byte then
			return false

		self.at += 1
		return true
	}

	/// Takes the bytes of `text` where they come next, and says whether it
	/// did: `"=="`, `"true"`.
	pub var fn takeText(text: str): bool = {
		if !self.rest().startsWith(text) then
			return false

		self.at += text.len()
		return true
	}

	/// Takes what comes next where it is `text` in any case, and says
	/// whether it did: `"newline"` takes `Newline` and `NEWLINE`. Characters
	/// are compared folded, as `startsWithAnyCase` compares them, and what
	/// it moves past is what matched here, which may be more bytes or fewer
	/// than `text` has: the Kelvin sign is three bytes, and folds as `k`.
	pub var fn takeTextAnyCase(text: str): bool = {
		var at = self.at
		for c in text.chars() {
			if at >= self.text.len() then
				return false

			val (d, width) = self.text.charAt(at)
			if c.folded() != d.folded() then
				return false

			at += width
		}
		self.at = at
		return true
	}

	/// Past every byte from here that `test` answers true for.
	@inline
	pub var fn skipWhile(test: &(byte: u8) => bool) = {
		while self.at < self.text.len() && test(self.text[self.at]) do
			self.at += 1
	}

	/// Past every byte from here that `test` answers true for, answering
	/// what it passed over, which may be nothing.
	@inline
	pub var fn takeWhile(test: &(byte: u8) => bool): str from self.text = {
		val start = self.at
		while self.at < self.text.len() && test(self.text[self.at]) do
			self.at += 1

		return self.text[start..self.at]
	}

	/// The text from byte `start` to here: the token just read.
	@inline
	pub fn since(start: i64): str from self.text = self.text[start..self.at]

	/// The text not read yet.
	@inline
	pub fn rest(): str from self.text = self.text[self.at..self.text.len()]

	/// The character that begins here, or nothing at the end. Bytes that are
	/// not UTF-8 are U+FFFD, one byte each, as `charAt` reads them.
	pub fn peekChar(): Option<char> =
		if self.at < self.text.len() then self.text.charAt(self.at).0 else .None

	/// The character that begins here, taken, or nothing at the end.
	pub var fn nextChar(): Option<char> = {
		if self.at >= self.text.len() then
			return .None

		val (c, width) = self.text.charAt(self.at)
		self.at += width
		return c
	}

	/// The character `ahead` characters past the one that begins here, or
	/// nothing past the end: `peekCharAt(0)` is `peekChar()`. It reads the
	/// characters before it to find it, and only forward: before the start
	/// it answers nothing, since bytes that are not UTF-8 may read as other
	/// characters backward than forward.
	pub fn peekCharAt(ahead: i64): Option<char> = {
		if ahead < 0 then
			return .None

		var at = self.at
		for _ in 0..ahead {
			if at >= self.text.len() then
				return .None

			at += self.text.charAt(at).1
		}
		return if at < self.text.len() then self.text.charAt(at).0 else .None
	}

	/// Takes the character that begins here where it is `c`, and says
	/// whether it did.
	@inline
	pub var fn takeChar(c: char): bool = {
		if self.at >= self.text.len() then
			return false

		val (d, width) = self.text.charAt(self.at)
		if d != c then
			return false

		self.at += width
		return true
	}

	/// Past every character from here that `test` answers true for.
	@inline
	pub var fn skipWhileChar(test: &(c: char) => bool) = {
		while self.at < self.text.len() {
			val (c, width) = self.text.charAt(self.at)
			if !test(c) then
				return

			self.at += width
		}
	}

	/// Past every character from here that `test` answers true for,
	/// answering what it passed over, which may be nothing.
	@inline
	pub var fn takeWhileChar(test: &(c: char) => bool): str from self.text = {
		val start = self.at
		self.skipWhileChar(test)
		return self.text[start..self.at]
	}

	/// The line and the column of what is read next: `positionAt(self.at)`.
	pub fn position(): Position = self.positionAt(self.at)

	/// The line and the column of byte `at`, worked out from the start of
	/// the text: what an error says, asked once, where reading counts
	/// nothing. A column counts characters, the first bytes of each.
	pub fn positionAt(at: i64): Position = {
		var line = 1
		var column = 1
		for i in 0..at.min(self.text.len()) {
			val byte = self.text[i]
			if byte == b'\n' {
				line += 1
				column = 1
			} else if byte & 0xC0 != 0x80 {
				// A character's first byte: the bytes after it in UTF-8 are
				// `10xxxxxx`.
				column += 1
			}
		}
		return Position(line:, column:)
	}
}
