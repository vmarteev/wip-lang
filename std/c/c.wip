// A value lent to C for as long as C may call back, and had back in the
// callback. A C library that calls a program back gives
// the callback a `void *` the program chose — sokol's `user_data`,
// `qsort_r`'s `arg`, SQLite's first argument — and that pointer is how a
// callback reaches the program's state.

/// `value`'s address as a `ptr<void>` for C to hold, given to `run`; the
/// value is lent, as a `&var` is, until `run` returns, so nothing else in
/// the program touches it while C may call back. `run` is called once, and
/// may change what it captures: the program's state, lent to it.
pub fn lending<T, R>(value: &var T, run: &var (data: ptr<void>) => R): R = run(
	addressOf<T>(&var value),
)

/// The address of the first of `values`, as a value, for C to read while
/// they are lent. C may not write through it, and may not keep it past
/// the call. Nothing checks it: a call's argument, and a C struct's field
/// in its literal, take `&values` where C takes a pointer, which is.
@intrinsic
pub fn pointerTo<T>(values: &[T]): ptr<T>

/// In a callback, the value `lending` gave C the address of, as the `&var T`
/// `use` is given for the callback's own time. `T` is the one thing the
/// checker cannot see: it must be the type that was lent.
pub fn lentBack<T, R>(data: ptr<void>, use: &(value: &var T) => R): R = use(
	&var referenceAt<T>(data),
)

/// A value C may hold the address of for longer than a call: from where a
/// C library is given it — a callback's `void *`, a stream's `info` — until
/// the library is told to let go. It is on the heap, so the
/// address holds wherever the `Pinned` is moved, and it ends with the
/// `Pinned`: the program makes C let go before that, which only it can
/// know. C may call back on a thread of its own while the program reads,
/// so both read it through a `&`, and what changes is an `Atomic` or a
/// `Mutex` inside it.
pub struct Pinned<T> {
	value: own<T>
}

extend Pinned<T> {
	/// `value`, on the heap, where it stays.
	pub static fn of(value: T): Pinned<T> = Pinned(own (value))

	/// Its address, for C to hold.
	pub fn address(): ptr<void> = boxAddress(&self.value)

	/// The value, to read.
	pub fn value(): &T = lend self.value
}

/// In a callback, the value a `Pinned` gave C the address of, as the `&T`
/// `use` is given for the callback's own time: to read, and to change
/// through what in it is an `Atomic` or a `Mutex`. `T` is the one thing the
/// checker cannot see: it must be the type that was pinned.
pub fn pinnedAt<T, R>(data: ptr<void>, use: &(value: &T) => R): R = use(&referenceAt<T>(data))

/// How many bytes a `T` takes in C, as C's `sizeof` answers: the distance
/// from one to the next in an array, padding and all. It
/// is what C is told the size of a buffer is, `count * c::sizeOf<Vertex>()`.
@intrinsic
pub fn sizeOf<T>(): size_t

/// The alignment of a `T` in C, as `_Alignof` answers.
@intrinsic
pub fn alignOf<T>(): size_t

/// The bytes of `value`, as C sees them at its address: `sizeOf<T>()` of
/// them, borrowing `value`. What a GPU's constants or a C file's header is
/// given: `T` is numbers, and what holds only numbers, with no padding
/// between or after them and no address — a padded struct says its padding,
/// with a field where it is or `@packed`.
@intrinsic
pub fn bytesOf<T: copy>(value: &T): &[u8]

/// Where the field named `field` lies in a `T`, in bytes from its start, as
/// C's `offsetof` answers: what a GPU is told of a vertex's attributes,
/// `c::offsetOf<Vertex>("color")`. The name is written as a string and
/// checked against `T`'s fields.
@intrinsic
pub fn offsetOf<T>(field: str): size_t

/// The reference's address.
@intrinsic
fn addressOf<T>(value: &var T): ptr<void>

/// The `&var` at an address `addressOf` gave.
@intrinsic
fn referenceAt<T>(data: ptr<void>): &var T

/// The address of the box an `own` points to; the `own` keeps it.
@intrinsic
fn boxAddress<T>(value: &own<T>): ptr<void>
