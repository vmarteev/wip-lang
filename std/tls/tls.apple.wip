// A Mac and iOS: TLS through Network.framework. A connection is made with
// TLS's default options — the system's roots, the host's name checked and
// told — and run on a dispatch queue of its own. Network.framework says
// what happens by calling blocks, each a `c::Block` of a closure that
// calls this module's function with the connection's `Link`; the queue
// calls it, and a call of this module's that waits, waits on a semaphore
// that function signals.

import std::c
import std::io
import std::libc
import std::time::{Duration}

pub struct TlsStream {
	connection: ptr<u8>
	/// What the blocks and the calls share.
	link: ptr<Link>
	/// What was received and not yet read.
	held: Vec<u8> = Vec()
	given: i64 = 0
	/// How many milliseconds a read waits; -1 waits as long as it takes.
	timeout: i64 = -1
	/// Whether a read gave up waiting, which leaves a receive outstanding
	/// that no other may follow.
	broken: bool = false
}

@framework("Network")
extern "C" {
	fn nw_endpoint_create_host(host: cstring, port: cstring): ptr<u8>
	fn nw_parameters_create_secure_tcp(configureTls: ptr<u8>, configureTcp: ptr<u8>): ptr<u8>
	fn nw_connection_create(endpoint: ptr<u8>, parameters: ptr<u8>): ptr<u8>
	fn nw_connection_set_queue(connection: ptr<u8>, queue: ptr<u8>)
	fn nw_connection_set_state_changed_handler(
		connection: ptr<u8>,
		handler: &c::Block<(state: u32, error: ptr<u8>) => void>,
	)
	fn nw_connection_start(connection: ptr<u8>)
	fn nw_connection_receive(
		connection: ptr<u8>,
		minimum: u32,
		maximum: u32,
		completion: &c::Block<(content: ptr<u8>, context: ptr<u8>, complete: bool, error: ptr<u8>) => void>,
	)
	fn nw_connection_send(
		connection: ptr<u8>,
		content: ptr<u8>,
		context: ptr<u8>,
		complete: bool,
		completion: &c::Block<(error: ptr<u8>) => void>,
	)
	fn nw_connection_cancel(connection: ptr<u8>)
	fn nw_release(object: ptr<u8>)
	fn nw_error_get_error_domain(error: ptr<u8>): c_int
	fn nw_error_get_error_code(error: ptr<u8>): c_int
	/// TLS's and TCP's options as the system chooses them.
	val _nw_parameters_configure_protocol_default_configuration: ptr<u8>
	/// The context of a send that is no message of its own.
	val _nw_content_context_default_message: ptr<u8>
}

extern "C" {
	fn dispatch_queue_create(label: cstring, attributes: ptr<u8>): ptr<u8>
	fn dispatch_semaphore_create(value: i64): ptr<u8>
	fn dispatch_semaphore_signal(semaphore: ptr<u8>): i64
	fn dispatch_semaphore_wait(semaphore: ptr<u8>, until: u64): i64
	fn dispatch_time(from: u64, nanos: i64): u64
	fn dispatch_data_create(
		bytes: ptr<u8>,
		size: size_t,
		queue: ptr<u8>,
		destructor: Option<&c::Block<() => void>>,
	): ptr<u8>
	fn dispatch_data_create_map(data: ptr<u8>, bytes: &var ptr<u8>, size: &var size_t): ptr<u8>
	fn dispatch_release(object: ptr<u8>)
}

/// A connection's states, as Network.framework numbers them.
val WAITING: u32 = 1
val READY: u32 = 3
val FAILED: u32 = 4
val CANCELLED: u32 = 5

/// Where an error comes from: the system's calls, a host's name, TLS.
val DOMAIN_POSIX: c_int = 1
val DOMAIN_DNS: c_int = 2
val DOMAIN_TLS: c_int = 3

/// The most a receive takes at once.
val RECEIVE_MOST: i64 = 65536

/// What the handlers and the calls share: two semaphores, one for the
/// connection's state and one for each receive or send, and what each
/// handler last said. The handlers write before they signal, and the calls
/// read after they wait.
extern struct Link {
	stateSignal: ptr<u8>
	ioSignal: ptr<u8>
	state: u32
	errorDomain: c_int
	errorCode: c_int
	/// Room for what a receive brings, and how much it brought.
	room: ptr<u8>
	received: i64
	/// Whether the receive found the end, and whether it or a send failed.
	ended: bool
	failed: bool
}

fn toldState(
	/// What the connection's state handler is told.
	link: ptr<Link>,
	state: u32,
	error: ptr<u8>,
) = {
	link.state = state
	if !error.isNull {
		link.errorDomain = nw_error_get_error_domain(error)
		link.errorCode = nw_error_get_error_code(error)
	}
	if state == WAITING || state == READY || state == FAILED || state == CANCELLED then
		dispatch_semaphore_signal(link.stateSignal)
}

fn toldReceived(
	/// What a receive is answered with.
	link: ptr<Link>,
	content: ptr<u8>,
	_: ptr<u8>,
	complete: bool,
	error: ptr<u8>,
) = {
	link.received = 0
	if !content.isNull {
		var bytes: ptr<u8> = null
		var size: size_t = 0
		val map = dispatch_data_create_map(content, &var bytes, &var size)
		val count = (size as i64).min(RECEIVE_MOST)
		libc::memmove(link.room, bytes, count as size_t)
		link.received = count
		dispatch_release(map)
	}
	if complete && link.received == 0 then
		link.ended = true

	if !error.isNull {
		link.failed = true
		link.errorDomain = nw_error_get_error_domain(error)
		link.errorCode = nw_error_get_error_code(error)
	}
	dispatch_semaphore_signal(link.ioSignal)
}

fn toldSent(
	/// What a send is answered with.
	link: ptr<Link>,
	error: ptr<u8>,
) = {
	if !error.isNull {
		link.failed = true
		link.errorDomain = nw_error_get_error_domain(error)
		link.errorCode = nw_error_get_error_code(error)
	}
	dispatch_semaphore_signal(link.ioSignal)
}

/// A link, its semaphores and its room.
fn newLink(): ptr<Link> = {
	val link = libc::calloc(1, 128) as ptr<Link>
	link.stateSignal = dispatch_semaphore_create(0)
	link.ioSignal = dispatch_semaphore_create(0)
	link.room = libc::malloc(RECEIVE_MOST as size_t)
	return link
}

/// The link and its room given back, once no handler can be called: the
/// connection has said it is cancelled.
fn freeLink(link: ptr<Link>) = {
	dispatch_release(link.stateSignal)
	dispatch_release(link.ioSignal)
	libc::free(link.room)
	libc::free(link as ptr<u8>)
}

/// When a wait of `millis` ends, as dispatch says it: never, for -1.
fn deadline(millis: i64): u64 =
	if millis < 0 then 0xFFFFFFFFFFFFFFFF else dispatch_time(0, millis * 1000000)

fn connected(host: str, port: u16, within: Option<Duration>): Result<TlsStream, TlsError> = {
	var named = String::of(host)
	var service = port.toString()
	val endpoint = nw_endpoint_create_host(named.toCstring(), service.toCstring())
	val parameters = nw_parameters_create_secure_tcp(
		_nw_parameters_configure_protocol_default_configuration,
		_nw_parameters_configure_protocol_default_configuration,
	)
	val connection = nw_connection_create(endpoint, parameters)
	nw_release(endpoint)
	nw_release(parameters)
	val link = newLink()
	var label = String::of("std.tls")
	val queue = dispatch_queue_create(label.toCstring(), null)
	nw_connection_set_queue(connection, queue)
	dispatch_release(queue)
	nw_connection_set_state_changed_handler(
		connection,
		c::Block::of(own (state, error) => toldState(link, state, error)),
	)
	nw_connection_start(connection)
	val millis = millisOf(within)
	val timedOut = dispatch_semaphore_wait(link.stateSignal, deadline(millis)) != 0
	val state = link.state
	val stream = TlsStream(connection: connection, link: link, timeout: millis)
	if !timedOut && state == READY then
		return stream

	val failed: TlsError =
		if timedOut then .Io(.TimedOut)
		else if link.errorDomain == DOMAIN_TLS then tlsErrorOf(link.errorCode)
		else .Io(ioErrorOf(link.errorDomain, link.errorCode))
	// The stream ends here, which cancels the connection and waits for it to
	// say so.
	destroy(stream)
	return .Err(failed)
}

/// A TLS error by its `OSStatus`: those that say the certificate is not to
/// be trusted, and the rest.
fn tlsErrorOf(code: c_int): TlsError = match code {
	-9807 => .Certificate(String::of("its chain is not valid"))
	-9808 => .Certificate(String::of("it is not a valid certificate"))
	-9812 => .Certificate(String::of("its root is not known"))
	-9813 => .Certificate(String::of("it has no root the system trusts"))
	-9814 => .Certificate(String::of("it has expired"))
	-9815 => .Certificate(String::of("it is not valid yet"))
	-9843 => .Certificate(String::of("it is not for this host"))
	-67843 | -67901 | -67818 => .Certificate(String::of("the system does not trust it"))
	_ => .Handshake("TLS error \(code)")
}

/// An error of the system's calls, or of finding a host, as `std::io`
/// says it.
fn ioErrorOf(domain: c_int, code: c_int): io::IoError = {
	if domain == DOMAIN_DNS then
		return .NotFound

	if domain == DOMAIN_POSIX {
		libc::errnoAt()[0] = code
		return io::lastError()
	}
	return .Other(code)
}

extend TlsStream: io::Read {
	var fn read(into: &var [u8]): Result<i64, io::IoError> = {
		if into.isEmpty() then
			return 0

		if self.given == self.held.len() {
			if self.broken then
				return .Err(.TimedOut)

			if self.link.ended then
				return 0

			self.held.clear()
			self.given = 0
			val link = self.link
			nw_connection_receive(
				self.connection,
				1,
				RECEIVE_MOST as u32,
				c::Block::of(own (content, context, complete, error) => toldReceived(
					link,
					content,
					context,
					complete,
					error,
				)),
			)
			if dispatch_semaphore_wait(self.link.ioSignal, deadline(self.timeout)) != 0 {
				self.broken = true
				return .Err(.TimedOut)
			}
			if self.link.received == 0 {
				if self.link.failed then
					return .Err(.ConnectionReset)

				return 0
			}
			self.held.pushAll(&self.link.room[0..self.link.received])
		}
		val count = (self.held.len() - self.given).min(into.len())
		into[0..count].copyFrom(&self.held.items()[self.given..self.given + count])
		self.given += count
		return count
	}
}

extend TlsStream: io::Write {
	var fn writeAll(bytes: &[u8]): Result<void, io::IoError> = {
		if bytes.isEmpty() then
			return

		if self.broken then
			return .Err(.BrokenPipe)

		// Copied by dispatch, which no destructor given says.
		val content = dispatch_data_create(
			c::pointerTo<u8>(&bytes) as ptr<u8>,
			bytes.len() as size_t,
			null,
			.None,
		)
		val link = self.link
		nw_connection_send(
			self.connection,
			content,
			_nw_content_context_default_message,
			false,
			c::Block::of(own (error) => toldSent(link, error)),
		)
		dispatch_release(content)
		dispatch_semaphore_wait(self.link.ioSignal, deadline(-1))
		if self.link.failed then
			return .Err(.BrokenPipe)

		return
	}
}

extend TlsStream: Destroy {
	var fn destroy() = {
		nw_connection_cancel(self.connection)
		// Once it says it is cancelled, no handler is called again, and the
		// link may go; a receive left waiting is answered first.
		while self.link.state != CANCELLED do
			dispatch_semaphore_wait(self.link.stateSignal, deadline(-1))

		nw_release(self.connection)
		freeLink(self.link)
	}
}
