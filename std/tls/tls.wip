// TLS: a connection whose bytes no one between its ends can read or
// change, to a server whose certificate the system trusts for the name
// asked for. It is the system's own: OpenSSL on Linux, as every
// distribution ships and updates it, and Network.framework on a Mac and
// iOS. Nothing is left unchecked — a server's certificate that the system
// does not trust, or that is not for the host, is refused — and a program
// that must trust one adds it to the system, as any other program would.
//
// It is a module of its own because each system's TLS is a library of its
// own, which a program that never makes a TLS connection does not link.

import std::io
import std::time::{Duration}

/// What kept a TLS connection from being made.
@derive(Eq, Clone)
pub enum TlsError {
	/// The connection under it failed, or the host was not found.
	Io(error: io::IoError)
	/// The server's certificate is not one the system trusts, or not for
	/// the host asked for.
	Certificate(reason: String)
	/// The two ends could not agree, or the server broke off.
	Handshake(reason: String)
}

extend TlsError: Text {
	fn toString(): String = match self {
		.Io(error) => "\(error)"
		.Certificate(reason) => "the server's certificate is refused: \(reason)"
		.Handshake(reason) => "TLS failed: \(reason)"
	}
}

extend TlsStream {
	/// A TCP connection to `port` of `host`, and a TLS handshake over it.
	pub static fn connect(host: str, port: u16): Result<TlsStream, TlsError> = connected(
		host,
		port,
		.None,
	)

	/// The same, waiting at most `within` for the connection and its
	/// handshake both; longer answers `.Io(.TimedOut)`.
	pub static fn connectWithin(
		host: str,
		port: u16,
		within: Duration,
	): Result<TlsStream, TlsError> = connected(host, port, within)

	/// How long a read waits for something to come before it answers
	/// `.TimedOut`; nothing waits as long as it takes.
	pub var fn setTimeout(length: Option<Duration>) = {
		self.timeout = millisOf(length)
	}
}

/// How many milliseconds `length` is, -1 for none.
fn millisOf(length: Option<Duration>): i64 = match length {
	.Some(length) => length.asMillis().max(0)
	.None => -1
}
