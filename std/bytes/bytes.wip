// Numbers read from bytes and written to them in a known order: a model's
// file, a texture's header, a save and a packet are integers and floats
// laid out little-endian (`le`) or big-endian (`be`). `u32le(&header, 4)`
// reads the number at a place, and `putU32le(&var header, 4, size)` writes
// one there, each panicking where its bytes are not all there, as an index
// past the end does. A `Reader` reads them from a slice in turn, each
// answering nothing past its end; a `Writer` appends them to a `Vec<u8>`.

import std::c
import std::libc

/// The two bytes from `at`, the first the lowest.
pub fn u16le(bytes: &[u8], at: i64): u16 = load(&bytes, at, 2) as u16

/// The two bytes from `at`, the first the highest.
pub fn u16be(bytes: &[u8], at: i64): u16 = (load(&bytes, at, 2) as u16).swapBytes()

pub fn i16le(bytes: &[u8], at: i64): i16 = load(&bytes, at, 2) as u16 as i16

pub fn i16be(bytes: &[u8], at: i64): i16 = (load(&bytes, at, 2) as u16).swapBytes() as i16

pub fn u32le(bytes: &[u8], at: i64): u32 = load(&bytes, at, 4) as u32

pub fn u32be(bytes: &[u8], at: i64): u32 = (load(&bytes, at, 4) as u32).swapBytes()

pub fn i32le(bytes: &[u8], at: i64): i32 = load(&bytes, at, 4) as u32 as i32

pub fn i32be(bytes: &[u8], at: i64): i32 = (load(&bytes, at, 4) as u32).swapBytes() as i32

pub fn u64le(bytes: &[u8], at: i64): u64 = load(&bytes, at, 8)

pub fn u64be(bytes: &[u8], at: i64): u64 = load(&bytes, at, 8).swapBytes()

pub fn i64le(bytes: &[u8], at: i64): i64 = load(&bytes, at, 8) as i64

pub fn i64be(bytes: &[u8], at: i64): i64 = load(&bytes, at, 8).swapBytes() as i64

pub fn f32le(bytes: &[u8], at: i64): f32 = f32::fromBits(load(&bytes, at, 4) as u32)

pub fn f32be(bytes: &[u8], at: i64): f32 = f32::fromBits((load(&bytes, at, 4) as u32).swapBytes())

pub fn f64le(bytes: &[u8], at: i64): f64 = f64::fromBits(load(&bytes, at, 8))

pub fn f64be(bytes: &[u8], at: i64): f64 = f64::fromBits(load(&bytes, at, 8).swapBytes())

/// `value` in the two bytes from `at`, the lowest first.
pub fn putU16le(bytes: &var [u8], at: i64, value: u16) = store(&var bytes, at, 2, value)

/// `value` in the two bytes from `at`, the highest first.
pub fn putU16be(bytes: &var [u8], at: i64, value: u16) = store(&var bytes, at, 2, value.swapBytes())

pub fn putI16le(bytes: &var [u8], at: i64, value: i16) = store(&var bytes, at, 2, value as u16)

pub fn putI16be(bytes: &var [u8], at: i64, value: i16) = store(
	&var bytes,
	at,
	2,
	(value as u16).swapBytes(),
)

pub fn putU32le(bytes: &var [u8], at: i64, value: u32) = store(&var bytes, at, 4, value)

pub fn putU32be(bytes: &var [u8], at: i64, value: u32) = store(&var bytes, at, 4, value.swapBytes())

pub fn putI32le(bytes: &var [u8], at: i64, value: i32) = store(&var bytes, at, 4, value as u32)

pub fn putI32be(bytes: &var [u8], at: i64, value: i32) = store(
	&var bytes,
	at,
	4,
	(value as u32).swapBytes(),
)

pub fn putU64le(bytes: &var [u8], at: i64, value: u64) = store(&var bytes, at, 8, value)

pub fn putU64be(bytes: &var [u8], at: i64, value: u64) = store(&var bytes, at, 8, value.swapBytes())

pub fn putI64le(bytes: &var [u8], at: i64, value: i64) = store(&var bytes, at, 8, value as u64)

pub fn putI64be(bytes: &var [u8], at: i64, value: i64) = store(
	&var bytes,
	at,
	8,
	(value as u64).swapBytes(),
)

pub fn putF32le(bytes: &var [u8], at: i64, value: f32) = store(&var bytes, at, 4, value.toBits())

pub fn putF32be(bytes: &var [u8], at: i64, value: f32) = store(
	&var bytes,
	at,
	4,
	value.toBits().swapBytes(),
)

pub fn putF64le(bytes: &var [u8], at: i64, value: f64) = store(&var bytes, at, 8, value.toBits())

pub fn putF64be(bytes: &var [u8], at: i64, value: f64) = store(
	&var bytes,
	at,
	8,
	value.toBits().swapBytes(),
)

/// The `count` bytes from `at`, the first the lowest, which must all be
/// there. One check, and then the bytes read where they lie, which LLVM
/// makes one load: an index for each would check each.
@inline
fn load(bytes: &[u8], at: i64, count: i64): u64 = {
	within(bytes.len(), at, count)
	return gather(c::pointerTo<u8>(&bytes), at, count)
}

/// `value`'s lowest `count` bytes, the lowest first, from `at`, where they
/// must all fit: one store, as `load` is one load. The slice is lent
/// `&var`, so its bytes are this call's to write.
@inline
fn store(bytes: &var [u8], at: i64, count: i64, value: u64) = {
	within(bytes.len(), at, count)
	var word = value
	libc::memmove(
		offsetBytes(c::pointerTo<u8>(&bytes), at),
		addressOf<u64>(&var word) as ptr<u8>,
		count as size_t,
	)
}

/// Panics where the `count` bytes from `at` are not all within `length`.
@inline
fn within(length: i64, at: i64, count: i64) = {
	if at < 0 || at > length - count then outside(length, at, count)
}

/// The panic of `within`, apart, so that the message is made only where it
/// is said and not before each read.
fn outside(
	length: i64,
	at: i64,
	count: i64,
) = panic("\(count) bytes at \(at) are out of bounds for length \(length)")

/// The `count` bytes from `at`, the first the lowest, which are there:
/// copied into a number's own low bytes, as Wip's targets are all
/// little-endian, in a copy LLVM makes one load.
@inline
fn gather(first: ptr<u8>, at: i64, count: i64): u64 = {
	var value: u64 = 0
	libc::memmove(addressOf<u64>(&var value) as ptr<u8>, offsetBytes(first, at), count as size_t)
	return value
}

@intrinsic
fn addressOf<T>(value: &var T): ptr<void>

@intrinsic
fn offsetBytes(pointer: ptr<u8>, bytes: i64): ptr<u8>

/// Reads numbers from `bytes`, from the start on.
pub view struct Reader {
	bytes: &[u8]
	at: i64 = 0
}

extend Reader {
	/// A reader of `bytes`, at their start.
	pub static fn of(bytes: &[u8]): Reader = Reader(bytes: bytes)

	/// How many bytes it has read.
	pub fn position(): i64 = self.at

	/// How many are left.
	pub fn remaining(): i64 = self.bytes.len() - self.at

	/// Moves to `at`, nothing where that is past the end.
	pub var fn seek(at: i64): Option<void> = {
		if at < 0 || at > self.bytes.len() then return .None
		self.at = at
		return .Some()
	}

	/// The next `count` bytes, the first the lowest.
	var fn next(count: i64): Option<u64> = {
		if count > self.remaining() then return .None
		val value = gather(c::pointerTo<u8>(self.bytes), self.at, count)
		self.at += count
		return .Some(value)
	}

	pub var fn u8(): Option<u8> = .Some(self.next(1)? as u8)

	pub var fn i8(): Option<i8> = .Some(self.next(1)? as u8 as i8)

	pub var fn u16le(): Option<u16> = .Some(self.next(2)? as u16)

	pub var fn u16be(): Option<u16> = .Some((self.next(2)? as u16).swapBytes())

	pub var fn i16le(): Option<i16> = .Some(self.next(2)? as u16 as i16)

	pub var fn i16be(): Option<i16> = .Some((self.next(2)? as u16).swapBytes() as i16)

	pub var fn u32le(): Option<u32> = .Some(self.next(4)? as u32)

	pub var fn u32be(): Option<u32> = .Some((self.next(4)? as u32).swapBytes())

	pub var fn i32le(): Option<i32> = .Some(self.next(4)? as u32 as i32)

	pub var fn i32be(): Option<i32> = .Some((self.next(4)? as u32).swapBytes() as i32)

	pub var fn u64le(): Option<u64> = self.next(8)

	pub var fn u64be(): Option<u64> = .Some(self.next(8)?.swapBytes())

	pub var fn i64le(): Option<i64> = .Some(self.next(8)? as i64)

	pub var fn i64be(): Option<i64> = .Some(self.next(8)?.swapBytes() as i64)

	pub var fn f32le(): Option<f32> = .Some(f32::fromBits(self.next(4)? as u32))

	pub var fn f32be(): Option<f32> = .Some(f32::fromBits((self.next(4)? as u32).swapBytes()))

	pub var fn f64le(): Option<f64> = .Some(f64::fromBits(self.next(8)?))

	pub var fn f64be(): Option<f64> = .Some(f64::fromBits(self.next(8)?.swapBytes()))

	/// The next `count` bytes, copied.
	pub var fn bytes(count: i64): Option<Vec<u8>> = {
		if count < 0 || count > self.remaining() then return .None
		val taken = self.bytes[self.at..self.at + count].toVec()
		self.at += count
		return .Some(taken)
	}
}

/// Appends numbers to its bytes, in the order each says.
pub struct Writer {
	out: Vec<u8> = Vec()
}

extend Writer {
	/// What it has written.
	pub fn written(): &[u8] = lend self.out.items()

	/// How many bytes it has written.
	pub fn len(): i64 = self.out.len()

	/// Its bytes, handed over.
	pub move fn take(): Vec<u8> = self.out

	/// `value`'s lowest `count` bytes, the lowest first.
	var fn unsigned(value: u64, count: i64) = {
		for i in 0..count {
			self.out.push((value >> (8 * i) as u64) as u8)
		}
	}

	pub var fn u8(value: u8) = self.out.push(value)

	pub var fn i8(value: i8) = self.out.push(value as u8)

	pub var fn u16le(value: u16) = self.unsigned(value, 2)

	pub var fn u16be(value: u16) = self.unsigned(value.swapBytes(), 2)

	pub var fn i16le(value: i16) = self.unsigned(value as u16, 2)

	pub var fn i16be(value: i16) = self.unsigned((value as u16).swapBytes(), 2)

	pub var fn u32le(value: u32) = self.unsigned(value, 4)

	pub var fn u32be(value: u32) = self.unsigned(value.swapBytes(), 4)

	pub var fn i32le(value: i32) = self.unsigned(value as u32, 4)

	pub var fn i32be(value: i32) = self.unsigned((value as u32).swapBytes(), 4)

	pub var fn u64le(value: u64) = self.unsigned(value, 8)

	pub var fn u64be(value: u64) = self.unsigned(value.swapBytes(), 8)

	pub var fn i64le(value: i64) = self.unsigned(value as u64, 8)

	pub var fn i64be(value: i64) = self.unsigned((value as u64).swapBytes(), 8)

	pub var fn f32le(value: f32) = self.unsigned(value.toBits(), 4)

	pub var fn f32be(value: f32) = self.unsigned(value.toBits().swapBytes(), 4)

	pub var fn f64le(value: f64) = self.unsigned(value.toBits(), 8)

	pub var fn f64be(value: f64) = self.unsigned(value.toBits().swapBytes(), 8)

	/// `bytes`, as they are.
	pub var fn bytes(bytes: &[u8]) = self.out.pushAll(&bytes)
}
