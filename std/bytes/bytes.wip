// Numbers read from bytes and written to them in a known order: a model's
// file, a texture's header, a save and a packet are integers and floats
// laid out little-endian (`le`) or big-endian (`be`). A `Reader` reads them
// from a slice, each answering nothing past its end; a `Writer` appends
// them to a `Vec<u8>`.

/// Reads numbers from `bytes`, from the start on.
pub view struct Reader {
	bytes: &[u8]
	at: i64 = 0
}

extend Reader {
	/// A reader of `bytes`, at their start.
	pub static fn of(bytes: &[u8]): Reader = Reader(bytes: bytes)

	/// How many bytes it has read.
	pub fn position(): i64 = self.at

	/// How many are left.
	pub fn remaining(): i64 = self.bytes.len() - self.at

	/// Moves to `at`, nothing where that is past the end.
	pub var fn seek(at: i64): Option<void> = {
		if at < 0 || at > self.bytes.len() then return .None
		self.at = at
		return .Some()
	}

	/// The next `count` bytes, as an unsigned number in the order given:
	/// the first byte least where `little`.
	var fn unsigned(count: i64, little: bool): Option<u64> = {
		if count > self.remaining() then return .None
		var value: u64 = 0
		for i in 0..count {
			val byte = self.bytes[self.at + (if little then count - 1 - i else i)] as u64
			value = (value << 8) | byte
		}
		self.at += count
		return .Some(value)
	}

	pub var fn u8(): Option<u8> = .Some(self.unsigned(1, true)? as u8)

	pub var fn i8(): Option<i8> = .Some(self.unsigned(1, true)? as u8 as i8)

	pub var fn u16le(): Option<u16> = .Some(self.unsigned(2, true)? as u16)

	pub var fn u16be(): Option<u16> = .Some(self.unsigned(2, false)? as u16)

	pub var fn i16le(): Option<i16> = .Some(self.unsigned(2, true)? as u16 as i16)

	pub var fn i16be(): Option<i16> = .Some(self.unsigned(2, false)? as u16 as i16)

	pub var fn u32le(): Option<u32> = .Some(self.unsigned(4, true)? as u32)

	pub var fn u32be(): Option<u32> = .Some(self.unsigned(4, false)? as u32)

	pub var fn i32le(): Option<i32> = .Some(self.unsigned(4, true)? as u32 as i32)

	pub var fn i32be(): Option<i32> = .Some(self.unsigned(4, false)? as u32 as i32)

	pub var fn u64le(): Option<u64> = self.unsigned(8, true)

	pub var fn u64be(): Option<u64> = self.unsigned(8, false)

	pub var fn i64le(): Option<i64> = .Some(self.unsigned(8, true)? as i64)

	pub var fn i64be(): Option<i64> = .Some(self.unsigned(8, false)? as i64)

	pub var fn f32le(): Option<f32> = .Some(f32::fromBits(self.unsigned(4, true)? as u32))

	pub var fn f32be(): Option<f32> = .Some(f32::fromBits(self.unsigned(4, false)? as u32))

	pub var fn f64le(): Option<f64> = .Some(f64::fromBits(self.unsigned(8, true)?))

	pub var fn f64be(): Option<f64> = .Some(f64::fromBits(self.unsigned(8, false)?))

	/// The next `count` bytes, copied.
	pub var fn bytes(count: i64): Option<Vec<u8>> = {
		if count < 0 || count > self.remaining() then return .None
		val taken = self.bytes[self.at..self.at + count].toVec()
		self.at += count
		return .Some(move taken)
	}
}

/// Appends numbers to its bytes, in the order each says.
pub struct Writer {
	out: Vec<u8> = Vec()
}

extend Writer {
	/// What it has written.
	pub fn written(): &[u8] = lend self.out.items()

	/// How many bytes it has written.
	pub fn len(): i64 = self.out.len()

	/// Its bytes, handed over.
	pub move fn take(): Vec<u8> = move self.out

	/// `count` bytes of `value`, least first where `little`.
	var fn unsigned(value: u64, count: i64, little: bool) = {
		for i in 0..count {
			val shift = (if little then i else count - 1 - i) * 8
			self.out.push((value >> shift as u64) as u8)
		}
	}

	pub var fn u8(value: u8) = self.out.push(value)

	pub var fn i8(value: i8) = self.out.push(value as u8)

	pub var fn u16le(value: u16) = self.unsigned(value as u64, 2, true)

	pub var fn u16be(value: u16) = self.unsigned(value as u64, 2, false)

	pub var fn i16le(value: i16) = self.unsigned(value as u16 as u64, 2, true)

	pub var fn i16be(value: i16) = self.unsigned(value as u16 as u64, 2, false)

	pub var fn u32le(value: u32) = self.unsigned(value as u64, 4, true)

	pub var fn u32be(value: u32) = self.unsigned(value as u64, 4, false)

	pub var fn i32le(value: i32) = self.unsigned(value as u32 as u64, 4, true)

	pub var fn i32be(value: i32) = self.unsigned(value as u32 as u64, 4, false)

	pub var fn u64le(value: u64) = self.unsigned(value, 8, true)

	pub var fn u64be(value: u64) = self.unsigned(value, 8, false)

	pub var fn i64le(value: i64) = self.unsigned(value as u64, 8, true)

	pub var fn i64be(value: i64) = self.unsigned(value as u64, 8, false)

	pub var fn f32le(value: f32) = self.unsigned(value.toBits() as u64, 4, true)

	pub var fn f32be(value: f32) = self.unsigned(value.toBits() as u64, 4, false)

	pub var fn f64le(value: f64) = self.unsigned(value.toBits(), 8, true)

	pub var fn f64be(value: f64) = self.unsigned(value.toBits(), 8, false)

	/// `bytes`, as they are.
	pub var fn bytes(bytes: &[u8]) = self.out.pushAll(&bytes)
}
