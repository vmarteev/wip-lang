// Windows' system log: the Event Log, which the Event Viewer shows under
// Windows Logs, Application, each record under the program's name as its
// source. A program registers no messages of its own there, so the viewer
// says it has no description for the event, and then gives the record's
// text. Text is UTF-8, which a program's manifest makes the `A` calls'.

import std::path
import std::process

@link("advapi32")
extern "C" {
	fn RegisterEventSourceA(server: ptr<u8>, source: cstring): i64
	fn ReportEventA(
		log: i64,
		kind: u16,
		category: u16,
		event: u32,
		user: ptr<u8>,
		count: u16,
		size: u32,
		strings: &cstring,
		data: ptr<u8>,
	): c_int
	fn DeregisterEventSource(log: i64): c_int
}

// The kinds of record the Event Log keeps, by how much each matters; it
// has none below information, which a debug record is.
val EVENTLOG_ERROR_TYPE: u16 = 1
val EVENTLOG_WARNING_TYPE: u16 = 2
val EVENTLOG_INFORMATION_TYPE: u16 = 4

/// The program's source in the Event Log: registered when the log is
/// made, and let go with it.
struct EventSource {
	handle: i64
}

extend EventSource: Destroy {
	var fn destroy() = {
		if self.handle != 0 then
			DeregisterEventSource(self.handle)
	}
}

/// Where `Log::toSystem` gives its records.
fn systemLog(): own<(record: &Record) => void> = {
	var named: String = match process::executable() {
		.Ok(file) => path::stem(&file)
		.Err(_) => "program"
	}
	val source = EventSource(handle: RegisterEventSourceA(null, named.toCstring()))
	return own (record) => {
		if source.handle == 0 then
			return

		var text = String::of(record.text)
		val strings = text.toCstring()
		ReportEventA(source.handle, kindOf(record.level), 0, 0, null, 1, 0, &strings, null)
	}
}

/// A level as the Event Log keeps it.
fn kindOf(level: Level): u16 = match level {
	.Debug | .Info => EVENTLOG_INFORMATION_TYPE
	.Warn => EVENTLOG_WARNING_TYPE
	.Error => EVENTLOG_ERROR_TYPE
}
