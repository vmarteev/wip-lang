// A Unix's system log: `syslog`, which names each record by the program.

@header("<syslog.h>")
extern "C" {
	fn syslog(priority: c_int, format: cstring, ...)
}

// `syslog`'s priorities, the same on every system Wip runs on.
val LOG_ERR: c_int = 3
val LOG_WARNING: c_int = 4
val LOG_INFO: c_int = 6
val LOG_DEBUG: c_int = 7

/// Where `Log::toSystem` gives its records.
fn systemLog(): own<(record: &Record) => void> = own (record) => {
	// `syslog` reads its text to a NUL, which a `str` need not end with.
	var text = String::of(record.text)
	syslog(priorityOf(record.level), "%s", text.toCstring())
}

/// A level as `syslog` takes it.
fn priorityOf(level: Level): c_int = match level {
	.Debug => LOG_DEBUG
	.Info => LOG_INFO
	.Warn => LOG_WARNING
	.Error => LOG_ERR
}
