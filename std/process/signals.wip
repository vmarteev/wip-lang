// Signals a program catches: Ctrl-C at its terminal, a request to end, its
// terminal gone. A program asks for the ones it wants with `Signals::catch`,
// and is told of each as it is asked, the way an event queue tells of a
// connection, with no handler running at a moment of the system's choosing:
// the system holds each signal back and keeps it, and the program reads
// what it kept. That is a kqueue on a Mac and on iOS, where a signal caught
// is otherwise ignored, so that it ends nothing, and a `signalfd` on Linux,
// where it is held back. Where the `Signals` ends, each is as it was
// before.

import std::io
import std::libc

/// A signal a program may be sent, and catch.
@derive(Text)
pub enum Signal {
	/// Ctrl-C at its terminal: `SIGINT`.
	Interrupt
	/// Asked to end, as `kill` asks: `SIGTERM`.
	Terminate
	/// Its terminal gone: `SIGHUP`.
	Hangup
	/// Ctrl-\ at its terminal: `SIGQUIT`.
	Quit
	/// A program it started ended or stopped: `SIGCHLD`.
	Child
}

extend Signal {
	/// What the system numbers it: what `libc::kill` sends, to pass a
	/// signal on.
	pub fn number(): c_int = match self {
		.Interrupt => libc::SIGINT
		.Terminate => libc::SIGTERM
		.Hangup => libc::SIGHUP
		.Quit => libc::SIGQUIT
		.Child => libc::SIGCHLD
	}

	/// The signal the system numbers `number`, of those a program catches.
	static fn numbered(number: i64): Option<Signal> = {
		for signal in [Signal::Interrupt, .Terminate, .Hangup, .Quit, .Child] do
			if signal.number() as i64 == number then
				return signal

		return .None
	}
}

/// The signals a program catches, which the system keeps for it until it
/// asks; as each was before where this ends.
pub struct Signals {
	fd: c_int
	caught: Vec<Signal>
}

extend Signals {
	/// Catches `signals`: from now on each ends nothing and is kept until
	/// asked for. On Linux they are held back in this thread and the ones it
	/// starts after this, so a program catches them as it begins, before it
	/// starts a thread. A program it starts handles them as it would have.
	pub static fn catch(signals: &[Signal]): Result<Signals, io::IoError> = {
		val fd = caughtBy(&signals)?
		return Signals(fd: fd, caught: signals.toVec())
	}

	/// The signals that came since it was last asked, without waiting; one
	/// that came several times is told of at least once.
	pub var fn received(): Vec<Signal> = taken(self.fd, false)

	/// The next signal, waiting for it.
	pub var fn wait(): Signal = {
		while true {
			val came = taken(self.fd, true)
			if !came.isEmpty() then
				return came[0]
		}
		return .Interrupt
	}

	/// A descriptor that is ready to read while a signal waits, for an
	/// event queue; `received` takes what it holds.
	pub fn descriptor(): i32 = self.fd
}

extend Signals: Destroy {
	var fn destroy() = {
		released(self.fd, &self.caught.items())
	}
}
