// What this program may do: the user it acts as, the root its paths start
// from, and how much it may hold. A server started as root takes what it
// needs of root's — a port below 1024, a socket's owner, more files —
// then makes a directory its root and goes on as a user who may do
// little, for good.

import std::io
import std::libc

/// The user this program acts as: whose files it may read and write, as
/// the system checks. 0 is root.
pub fn userId(): u32 = libc::geteuid()

/// The group this program acts as.
pub fn groupId(): u32 = libc::getegid()

/// Goes on as `user` of `group`, and of no other group, for good: the
/// groups, then the group, then the user, the order in which each step
/// still has root's leave to take the next. It checks that it acts as them
/// after. Only root may; any other is refused.
pub fn becomeUser(user: u32, group: u32): Result<void, io::IoError> = {
	val groups = [group]
	if libc::setgroups(1, &groups) != 0 then return .Err(io::lastError())
	if libc::setgid(group) != 0 then return .Err(io::lastError())
	if libc::setuid(user) != 0 then return .Err(io::lastError())
	if libc::geteuid() != user || libc::getegid() != group then return .Err(.Denied)
	return .Ok()
}

/// Makes `path` this program's root, `/`, which no path it opens after can
/// leave, and moves the program into it, so that the directory it was in
/// is not a way out. Only root may.
pub fn changeRoot(path: str): Result<void, io::IoError> = {
	var named = String::of(path)
	if libc::chroot(named.toCstring()) != 0 then return .Err(io::lastError())
	var root = String::of("/")
	if libc::chdir(root.toCstring()) != 0 then return .Err(io::lastError())
	return .Ok()
}

/// What a limit is set on.
@derive(Eq, Clone, Text)
pub enum Resource {
	/// Descriptors open at once: files, sockets, pipes.
	OpenFiles
	/// Processes and threads the program's user runs at once.
	Processes
	/// The size of the core file a crash leaves, in bytes.
	CoreFile
	/// The size of the main thread's stack, in bytes.
	Stack
}

/// How much of a resource this program may hold: what it holds to now,
/// and the most it may raise that to. Nothing is no limit.
@derive(Eq, Clone)
pub struct Limit {
	pub var current: Option<u64>
	pub var most: Option<u64>
}

/// How much of `resource` this program may hold.
pub fn limit(resource: Resource): Result<Limit, io::IoError> = {
	var raw = libc::Rlimit()
	if libc::getrlimit(numberOf(resource), &var raw) != 0 then return .Err(io::lastError())
	return .Ok(Limit(current: fromRaw(raw.current), most: fromRaw(raw.most)))
}

/// Sets how much of `resource` this program may hold. Any program may
/// lower either, and raise what it holds to as far as the most; only root
/// may raise the most.
pub fn setLimit(resource: Resource, limit: Limit): Result<void, io::IoError> = {
	val raw = libc::Rlimit(current: toRaw(limit.current), most: toRaw(limit.most))
	if libc::setrlimit(numberOf(resource), &raw) != 0 then return .Err(io::lastError())
	return .Ok()
}

fn numberOf(resource: Resource): c_int = match resource {
	.OpenFiles => libc::RLIMIT_NOFILE
	.Processes => libc::RLIMIT_NPROC
	.CoreFile => libc::RLIMIT_CORE
	.Stack => libc::RLIMIT_STACK
}

fn fromRaw(value: u64): Option<u64> = if value == libc::RLIM_INFINITY then .None else .Some(value)

fn toRaw(value: Option<u64>): u64 = value.unwrapOr(libc::RLIM_INFINITY)
