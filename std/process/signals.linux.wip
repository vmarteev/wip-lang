// Linux: the signals held back in this thread, and read from a
// `signalfd`, a record of 128 bytes a signal, its number first.

import std::bytes
import std::io
import std::libc

extern "C" {
	fn signalfd(fd: c_int, mask: &libc::Hidden, flags: c_int): c_int
}

val SFD_NONBLOCK: c_int = 0o4000
val SFD_CLOEXEC: c_int = 0o2000000
/// How long a `signalfd_siginfo` is.
val RECORD: i64 = 128

fn maskOf(signals: &[Signal]): libc::Hidden = {
	var mask = libc::hidden()
	libc::sigemptyset(&var mask)
	for signal in signals do
		libc::sigaddset(&var mask, signal.number())

	return mask
}

fn caughtBy(signals: &[Signal]): Result<c_int, io::IoError> = {
	val mask = maskOf(&signals)
	var before = libc::hidden()
	libc::pthread_sigmask(libc::SIG_BLOCK, &mask, &var before)
	val fd = signalfd(-1, &mask, SFD_NONBLOCK | SFD_CLOEXEC)
	if fd < 0 {
		val why = io::lastError()
		libc::pthread_sigmask(libc::SIG_UNBLOCK, &mask, &var before)
		return .Err(why)
	}
	return fd
}

fn taken(fd: c_int, waiting: bool): Vec<Signal> = {
	if waiting {
		var fds = [libc::PollFd(fd:, events: libc::POLLIN, answered: 0)]
		libc::poll(&var fds, -1)
	}
	var came: Vec<Signal> = Vec()
	var record = [0 as u8; 128]
	while libc::read(fd, &var record) as i64 == RECORD {
		val number = bytes::u32le(&record, 0) as i64
		if Signal::numbered(number) is .Some(signal) then
			came.push(signal)
	}
	return came
}

fn released(fd: c_int, signals: &[Signal]) = {
	libc::close(fd)
	val mask = maskOf(&signals)
	var before = libc::hidden()
	libc::pthread_sigmask(libc::SIG_UNBLOCK, &mask, &var before)
}
