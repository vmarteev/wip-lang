// This program copied, and the group its processes are: what a server
// does that keeps one process as root, to clean up after, while a copy of
// it serves as a user who may do little, and passes a signal it is sent on
// to every process it started.

import std::io
import std::libc

/// Which of the two processes `fork` answers in.
pub enum Forked {
	/// This one, which goes on, with the copy as a child it waits for.
	Parent(child: Child)
	/// The copy, which goes on from the same place.
	Child
}

/// This program copied: the copy goes on from here as this one does, with
/// the same memory, descriptors and signals, and is told it is the copy;
/// this one is given it as a `Child`. Only the thread that asks goes on in
/// the copy, so a program forks before it starts a thread: another
/// thread's lock is held in the copy by no one, for good. What this one
/// has buffered to write is written first, so that the copy does not
/// write it again.
pub fn fork(): Result<Forked, io::IoError> = {
	libc::fflush(null)
	val got = libc::fork()
	if got < 0 then return .Err(io::lastError())
	return .Ok(if got == 0 then .Child else .Parent(child: Child(id: got as i64)))
}

/// Makes this process a group of its own, which the processes it starts
/// from here belong to, and which `sendToGroup` reaches together.
pub fn newGroup(): Result<void, io::IoError> = {
	if libc::setpgid(0, 0) != 0 then return .Err(io::lastError())
	return .Ok()
}

/// Sends `signal` to every process of this one's group, this one among
/// them: how a signal a server is sent is passed on to what it started.
pub fn sendToGroup(signal: Signal): Result<void, io::IoError> = {
	if libc::kill(0, signal.number()) != 0 then return .Err(io::lastError())
	return .Ok()
}
