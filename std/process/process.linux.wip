// Linux: how a program is started with only the descriptors it is given,
// and how this one finds its own file.

import std::io
import std::libc

import std::libc::{Hidden, Pipe}

/// A pipe, both ends closed in every program started unless a file action
/// gives it one: Linux makes it so marked.
fn openedPipe(ends: &var Pipe): c_int = libc::pipe2(&var ends, libc::O_CLOEXEC)

/// The writing end of the pipe to a program's input, which needs nothing
/// to answer `EPIPE` once the program stops reading: Linux raises `SIGPIPE`
/// in the thread that wrote, which holds it back while it writes.
fn quietEnd(_: c_int) = {}

/// Starts the program: on Linux, as `posix_spawnp` does, each descriptor
/// this program opened marked to be closed in it.
fn started(
	child: &var c_int,
	program: cstring,
	actions: &var Hidden,
	_: &[c_int],
	arguments: ptr<cstring>,
	environment: ptr<cstring>,
): c_int = {
	var attributes = libc::spawnAttributes()
	libc::posix_spawnattr_init(&var attributes)
	libc::posix_spawnattr_setflags(
		&var attributes,
		libc::POSIX_SPAWN_SETSIGMASK | libc::POSIX_SPAWN_SETSIGDEF,
	)
	freshSignals(&var attributes)
	val failed = libc::posix_spawnpWith(
		&var child,
		program,
		&actions,
		&attributes,
		arguments,
		environment,
	)
	libc::posix_spawnattr_destroy(&var attributes)
	return failed
}

// This program: where it runs, which file it is, and its number.

/// The path the system has for this program's file: Linux's link to it.
fn executableName(): Result<String, io::IoError> = .Ok("/proc/self/exe")
