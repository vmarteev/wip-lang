// Places: the value taken out of one with another left in its place, and
// the values of two exchanged. Each is what a `move` and an assignment
// written out say, for a value that owns memory: a field moved out of is
// given a value again before anything can see it empty. A module of its
// own, since `replace` and `swap` are names a program wants for itself.

/// The value at `place`, with `value` left there in its place:
/// `mem::replace(&var self.state, .Idle)`.
pub fn replace<T>(place: &var T, value: T): T keeps value = {
	val taken = move place
	place = move value
	return move taken
}

/// The values at `a` and `b` exchanged: `mem::swap(&var self.front,
/// &var self.back)`. The two places are not one, which a call that lends
/// both as `&var` already says.
pub fn swap<T>(a: &var T, b: &var T) = {
	val first = move a
	a = move b
	b = move first
}
