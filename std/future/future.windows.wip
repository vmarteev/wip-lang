// Threads on Windows: the C library's, `_beginthreadex`, which a thread
// that calls the C library starts with, kept by their handles.

import std::libc

extern "C" {
	/// A thread's entry answers its exit code, 32 bits, where Wip's answers
	/// a pointer: the same register on Windows' processors, its low bits
	/// the code, which no one reads.
	fn _beginthreadex(
		security: ptr<u8>,
		stack: u32,
		entry: (argument: ptr<u8>) => ptr<u8>,
		argument: ptr<u8>,
		flags: u32,
		id: ptr<u32>,
	): u64
}

@link("kernel32")
extern "C" {
	fn GetActiveProcessorCount(group: u16): u32
}

/// `GetActiveProcessorCount`: every group's processors, past the first 64.
val ALL_PROCESSOR_GROUPS: u16 = 0xFFFF

/// `thread` started at `entry`, given it, with `stack` bytes of stack:
/// 0, or the error number that says why it was not.
fn begun(thread: ptr<Thread>, entry: (argument: ptr<u8>) => ptr<u8>, stack: i64): c_int = {
	val handle = _beginthreadex(null, stack as u32, entry, thread as ptr<u8>, 0, null)
	if handle == 0 then
		return libc::errno()

	thread.id = handle
	return 0
}

/// Waits for `thread` to end, and lets its handle go.
fn joined(thread: ptr<Thread>) = {
	libc::WaitForSingleObject(thread.id as i64, libc::INFINITE)
	libc::CloseHandle(thread.id as i64)
}

/// How many processors are working: how many threads `each` and `map` use,
/// and how many parts a program that splits its own work makes of it. At
/// least one.
pub fn cores(): i64 = {
	val working = GetActiveProcessorCount(ALL_PROCESSOR_GROUPS) as i64
	return if working < 1 then 1 else working
}
