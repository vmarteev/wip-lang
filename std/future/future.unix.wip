// Threads on a Unix: pthreads.

import std::libc::{
	SC_NPROCESSORS_ONLN,
	hidden,
	pthread_attr_destroy,
	pthread_attr_init,
	pthread_attr_setstacksize,
	pthread_create,
	pthread_join,
	sysconf
}

/// `thread` started at `entry`, given it, with `stack` bytes of stack:
/// 0, or the error number that says why it was not.
fn begun(thread: ptr<Thread>, entry: (argument: ptr<u8>) => ptr<u8>, stack: i64): c_int = {
	var attributes = hidden()
	pthread_attr_init(&var attributes)
	pthread_attr_setstacksize(&var attributes, stack as size_t)
	val failed = pthread_create(&var thread.id, &attributes, entry, thread as ptr<u8>)
	pthread_attr_destroy(&var attributes)
	return failed
}

/// Waits for `thread` to end.
fn joined(thread: ptr<Thread>) = {
	pthread_join(thread.id, null)
}

/// How many processors are working: how many threads `each` and `map` use,
/// and how many parts a program that splits its own work makes of it. At
/// least one.
pub fn cores(): i64 = {
	val working = sysconf(SC_NPROCESSORS_ONLN)
	return if working < 1 then 1 else working
}
