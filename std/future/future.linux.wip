// How much stack a thread has, on Linux.

import std::libc::{
	hidden,
	pthread_attr_destroy,
	pthread_attr_getstacksize,
	pthread_getattr_np,
	pthread_self
}

/// How many bytes of stack the thread that asks has: 0 where the system
/// does not say.
fn currentStack(): i64 = {
	var attributes = hidden()
	if pthread_getattr_np(pthread_self(), &var attributes) != 0 then
		return 0

	var size: size_t = 0
	pthread_attr_getstacksize(&attributes, &var size)
	pthread_attr_destroy(&var attributes)
	// A stack's size is far from the top of an `i64`.
	return size as% i64
}
