// A Mac and iOS: the threads the process runs, as the kernel counts its
// task's.

import std::libc

/// How many threads the process runs, a C library's among them, or nothing
/// where the system does not say.
fn threadCount(): Option<i64> = {
	var info = libc::ProcTaskInfo()
	val size = sizeOf<libc::ProcTaskInfo>() as c_int
	val wrote = libc::procTaskInfo(libc::getpid(), libc::PROC_PIDTASKINFO, 0, &var info, size)
	return if wrote == size then info.threads as i64 else .None
}
