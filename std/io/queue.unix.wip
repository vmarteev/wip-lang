// A Unix's event queue: kqueue on a Mac and on iOS, epoll on Linux, each
// told of a descriptor while it is ready.

import std::collections::{Map}
import std::libc
import std::shared::{Shared}
import std::time::{Duration}

/// A descriptor, closed where its last holder lets it go.
struct Closing {
	fd: c_int
}

extend Closing: Destroy {
	var fn destroy() = {
		libc::close(self.fd)
	}
}

/// The descriptors a program waits on, closed where it ends and where its
/// wakers do.
pub struct EventQueue {
	fd: Shared<Closing>
	/// Room for what one wait answers, as the system lays it out.
	raw: Vec<RawEvent>
	/// What it waits on each descriptor for: what kqueue's filters are
	/// added and taken away by.
	interests: Map<i32, Interest> = Map()
	/// Each waker's token and its end, which a wait that tells of it reads
	/// back where the system asks.
	wakers: Vec<(u64, Shared<WakeEnd>)> = Vec()
}

extend EventQueue {
	/// A queue waiting on nothing.
	pub static fn new(): Result<EventQueue, IoError> = {
		val fd = created()
		if fd < 0 then
			return .Err(lastError())

		return EventQueue(fd: Shared::of(Closing(fd:)), raw: Vec())
	}

	/// Waits on `descriptor` for `interest`, and tells of it by `token`.
	pub var fn add(descriptor: i32, interest: Interest, token: u64): Result<void, IoError> = {
		added(self.fd.value().fd, descriptor, interest, token)?
		self.interests.put(descriptor, interest)
	}

	/// Waits on `descriptor`, added already, for `interest` instead.
	pub var fn change(descriptor: i32, interest: Interest, token: u64): Result<void, IoError> = {
		val was: Interest = match self.interests.get(&descriptor) {
			.Some(known) => known
			.None => interest
		}
		changed(self.fd.value().fd, descriptor, was, interest, token)?
		self.interests.put(descriptor, interest)
	}

	/// No longer waits on `descriptor`.
	pub var fn remove(descriptor: i32): Result<void, IoError> = {
		val was: Interest = match self.interests.get(&descriptor) {
			.Some(known) => known
			.None => Interest::Both
		}
		removed(self.fd.value().fd, descriptor, was)?
		self.interests.remove(&descriptor)
		return
	}

	/// Sleeps until a descriptor is ready, or `timeout` has passed — `.None`
	/// waits as long as it takes, and no time only looks — and puts what is
	/// ready into `into`, emptied first, one event a descriptor. A wait a
	/// signal cuts short answers nothing.
	pub var fn wait(timeout: Option<Duration>, into: &var Vec<Event>): Result<void, IoError> = {
		into.clear()
		val room = (self.interests.len() * 2 + self.wakers.len()).max(16)
		while self.raw.len() < room do
			self.raw.push(blank())

		val count = waited(self.fd.value().fd, &var self.raw.items(), timeout)
		if count < 0 {
			if lastError() == .Interrupted then
				return

			return .Err(lastError())
		}
		for i in 0..count {
			val event = eventOf(&self.raw[i])
			// kqueue tells of reading and writing apart: one event a
			// descriptor.
			match into.items().indexWhere((seen) => seen.token == event.token) {
				.Some(at) => {
					into[at].readable = into[at].readable || event.readable
					into[at].writable = into[at].writable || event.writable
					into[at].closed = into[at].closed || event.closed
				}
				.None => into.push(event)
			}
		}
		// A waker told of is ready again for the next wake.
		for (token, end) in self.wakers do
			if into.any((event) => event.token == token) then
				drained(&end.value())
	}

	/// A waker for the queue, which tells of it by `token`.
	pub var fn waker(token: u64): Result<Waker, IoError> = {
		val made = wakeEndOf(&self.fd, self.wakers.len() as u64 + 1, token)?
		val end = Shared::of(made)
		self.wakers.push((token, end.share()))
		return Waker(end:)
	}
}
