// An event queue: the descriptors a program waits on, each with what it
// waits for and a number of the program's own, and a wait that answers
// which are ready. kqueue on a Mac and on iOS, epoll on Linux, each told of
// a descriptor while it is ready, as `poll` is, so that a program that
// does not read everything at once is told again.

import std::collections::{Map}
import std::libc
import std::time::{Duration}

/// What a descriptor is waited for.
pub enum Interest {
	Read
	Write
	Both
}

extend Interest {
	fn reads(): bool = self != Interest::Write
	fn writes(): bool = self != Interest::Read
}

/// A descriptor that is ready: the token it was added with, what it is
/// ready for, and whether the other end hung up or it failed — what is
/// left is read, and it is let go.
@derive(Eq, Text)
pub struct Event {
	pub token: u64
	pub readable: bool
	pub writable: bool
	pub closed: bool
}

/// The descriptors a program waits on, closed where it ends.
pub struct EventQueue {
	fd: c_int
	/// Room for what one wait answers, as the system lays it out.
	raw: Vec<RawEvent>
	/// What it waits on each descriptor for: what kqueue's filters are
	/// added and taken away by.
	interests: Map<i32, Interest> = Map()
}

extend EventQueue: Destroy {
	var fn destroy() = {
		libc::close(self.fd)
	}
}

extend EventQueue {
	/// A queue waiting on nothing.
	pub static fn new(): Result<EventQueue, IoError> = {
		val fd = created()
		if fd < 0 then return .Err(lastError())
		return EventQueue(fd: fd, raw: Vec())
	}

	/// Waits on `descriptor` for `interest`, and tells of it by `token`.
	pub var fn add(descriptor: i32, interest: Interest, token: u64): Result<void, IoError> = {
		added(self.fd, descriptor, interest, token)?
		self.interests.put(descriptor, interest)
	}

	/// Waits on `descriptor`, added already, for `interest` instead.
	pub var fn change(descriptor: i32, interest: Interest, token: u64): Result<void, IoError> = {
		val was: Interest = match self.interests.get(&descriptor) {
			.Some(known) => known
			.None => interest
		}
		changed(self.fd, descriptor, was, interest, token)?
		self.interests.put(descriptor, interest)
	}

	/// No longer waits on `descriptor`.
	pub var fn remove(descriptor: i32): Result<void, IoError> = {
		val was: Interest = match self.interests.get(&descriptor) {
			.Some(known) => known
			.None => Interest::Both
		}
		removed(self.fd, descriptor, was)?
		self.interests.remove(&descriptor)
		return
	}

	/// Sleeps until a descriptor is ready, or `timeout` has passed — `.None`
	/// waits as long as it takes, and no time only looks — and puts what is
	/// ready into `into`, emptied first, one event a descriptor. A wait a
	/// signal cuts short answers nothing.
	pub var fn wait(timeout: Option<Duration>, into: &var Vec<Event>): Result<void, IoError> = {
		into.clear()
		val room = (self.interests.len() * 2).max(16)
		while self.raw.len() < room {
			self.raw.push(blank())
		}
		val count = waited(self.fd, &var self.raw.items(), timeout)
		if count < 0 {
			if lastError() == .Interrupted then return
			return .Err(lastError())
		}
		for i in 0..count {
			val event = eventOf(&self.raw[i])
			// kqueue tells of reading and writing apart: one event a
			// descriptor.
			match into.items().indexWhere((seen) => seen.token == event.token) {
				.Some(at) => {
					into[at].readable = into[at].readable || event.readable
					into[at].writable = into[at].writable || event.writable
					into[at].closed = into[at].closed || event.closed
				}
				.None => into.push(event)
			}
		}
	}
}
