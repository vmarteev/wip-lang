// An event queue: the descriptors a program waits on, each with what it
// waits for and a number of the program's own, and a wait that answers
// which are ready, told of a descriptor while it is ready, as `poll` is,
// so that a program that does not read everything at once is told again.
// Each family has its `EventQueue` (`queue.unix.wip`, `queue.windows.wip`),
// with the same calls.
//
// A `Waker` wakes a queue from another thread. What it wakes through is
// each system's — a kqueue's user filter, an `eventfd`, a socket pair —
// and is shared by the queue and every clone of the waker, so that it
// stays open while any holds it: a waker woken after its queue has ended
// writes to what nothing waits on, and wakes nothing that took its place.

import std::shared::{Shared}

/// What a descriptor is waited for.
pub enum Interest {
	Read
	Write
	Both
}

extend Interest {
	fn reads(): bool = self != Interest::Write
	fn writes(): bool = self != Interest::Read
}

/// A descriptor that is ready: the token it was added with, what it is
/// ready for, and whether the other end hung up or it failed — what is
/// left is read, and it is let go.
@derive(Eq, Text)
pub struct Event {
	pub token: u64
	pub readable: bool
	pub writable: bool
	pub closed: bool
}

/// What wakes a queue from any thread: `wake()` makes the queue's next
/// wait, or the one it is in, answer an event with the waker's token,
/// readable. Wakes before the queue waits again are one event, and one
/// after it is answered is another. It is given to another thread in what
/// runs there, cloned for each; one whose queue has ended wakes nothing.
pub struct Waker {
	end: Shared<WakeEnd>
}

extend Waker {
	/// Wakes the queue.
	pub fn wake() = woken(&self.end.value())
}

extend Waker: Clone {
	fn clone(): Waker = Waker(end: self.end.share())
}
