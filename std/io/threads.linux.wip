// Linux: the threads the process runs, as `/proc/self/stat` says.

import std::libc

/// How many threads the process runs, a C library's among them, or nothing
/// where the system does not say: where `/proc` is not mounted.
fn threadCount(): Option<i64> = {
	val fd = libc::open("/proc/self/stat", libc::O_RDONLY | libc::O_CLOEXEC)
	if fd < 0 then
		return .None

	var line = [0 as u8; 1024]
	val got = libc::read(fd, &var line) as i64
	libc::close(fd)
	// The name in parentheses may hold spaces, so the fields are counted
	// from the last `)`: the state is the third field, and the threads the
	// twentieth.
	var at = got - 1
	while at >= 0 && line[at] != b')' do
		at -= 1

	if at < 0 then
		return .None

	var field = 2
	while at < got && field < 20 {
		at += 1
		if line[at] == b' ' then
			field += 1
	}
	var count = 0
	at += 1
	while at < got && line[at] is b'0'..=b'9' {
		count = count * 10 + ((line[at] - b'0') as i64)
		at += 1
	}
	return if count > 0 then count else .None
}
