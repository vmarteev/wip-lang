// Printing, reading and the environment, over C's library.
// Standard output is C's, and buffered, so everything written to it goes
// through `stdout`, in order.

import std::libc
import std::time::{Duration}

/// Text as it is, with nothing added. A `String` may stand
/// here too: it lends its bytes for the call. A
/// NUL in it is written like any other byte.
pub fn print(text: str) = {
	libc::fwrite(text, 1, libc::stdout)
}

/// Text, and a line break after it.
pub fn println(text: str) = {
	libc::fwrite(text, 1, libc::stdout)
	libc::fputc('\n' as c_int, libc::stdout)
}

/// A number on a line of its own. These build no text, so they cost no
/// memory: `println("\(value)")` is the way to write one inside a sentence.
pub fn printInt(value: i64) = {
	libc::printf("%lld\n", value)
}

/// A number with no sign on a line of its own.
pub fn printUnsigned(value: u64) = {
	libc::printf("%llu\n", value)
}

/// A float, as `"\(value)"` writes it, on a line of its own. Unlike the
/// two above, it builds the text, since what the digits are is worked out
/// by reading them back.
pub fn printFloat(value: f64) = println("\(value)")

/// C's bytes, which end with a NUL, on a line of their own.
pub fn printCstring(text: cstring) = {
	libc::puts(text)
}

/// Standard error, which is not buffered: what the program printed goes out
/// first, so a report arrives after the output it is about.
pub fn eprint(text: str) = {
	libc::fflush(libc::stdout)
	libc::fwrite(text, 1, libc::stderr)
}

/// Text on standard error, and a line break after it.
pub fn eprintln(text: str) = {
	libc::fflush(libc::stdout)
	libc::fwrite(text, 1, libc::stderr)
	libc::fputc('\n' as c_int, libc::stderr)
}

/// Standard output, emptied. The buffer Wip prints through is C's, so this
/// is its flush.
pub fn flush(): Result<void, IoError> =
	if libc::fflush(libc::stdout) == 0 then .Ok() else .Err(lastError())

/// Why a read or a write could not be done. The names are
/// the families a program acts on; `Other` keeps the number for the rest,
/// and says it.
@derive(Eq)
pub enum IoError {
	NotFound
	Denied
	AlreadyExists
	Interrupted
	/// A descriptor that does not block had nothing to give, or no room to
	/// take more.
	WouldBlock
	/// The address a socket was to listen on is in use.
	AddressInUse
	/// Nothing was listening where a connection was made to.
	ConnectionRefused
	/// The other end broke the connection off.
	ConnectionReset
	/// The other end had closed what was written to.
	BrokenPipe
	/// A socket was used that is not connected.
	NotConnected
	/// What was asked is not something this system does.
	Unsupported
	/// What was read is not what it should be: a part of a format that is
	/// not the format.
	InvalidData
	/// Nothing came within the time given.
	TimedOut
	Other(code: i32)
}

extend IoError: Text {
	fn toString(): String = match self {
		.NotFound => "no such file or directory"
		.Denied => "permission denied"
		.AlreadyExists => "already exists"
		.Interrupted => "interrupted"
		.WouldBlock => "would block"
		.AddressInUse => "address in use"
		.ConnectionRefused => "connection refused"
		.ConnectionReset => "connection reset"
		.BrokenPipe => "broken pipe"
		.NotConnected => "not connected"
		.Unsupported => "not supported on this system"
		.InvalidData => "invalid data"
		.TimedOut => "timed out"
		.Other(code) => "input or output failed, error \(code)"
	}
}

/// What C last failed with, as one of the above. It is `pub` for the
/// modules that call C themselves — `std::fs` opens the descriptors it
/// reads from.
pub fn lastError(): IoError = {
	val code = libc::errno()
	if code == libc::ENOENT then return .NotFound
	if code == libc::EACCES || code == libc::EPERM then return .Denied
	if code == libc::EEXIST then return .AlreadyExists
	if code == libc::EINTR then return .Interrupted
	if code == libc::EAGAIN then return .WouldBlock
	if code == libc::EADDRINUSE then return .AddressInUse
	if code == libc::ECONNREFUSED then return .ConnectionRefused
	if code == libc::ECONNRESET then return .ConnectionReset
	if code == libc::EPIPE then return .BrokenPipe
	if code == libc::ENOTCONN then return .NotConnected
	if code == libc::ETIMEDOUT then return .TimedOut
	return .Other(code)
}

/// What bytes are read from, whichever it is: a file, standard input, a
/// connection, a response's body. A program that reads without knowing
/// which takes a `&var dyn Read`.
pub interface Read {
	/// What comes next, put from the start of `into`: how many bytes, at
	/// most its length, and 0 only at the end, or where `into` holds none.
	var fn read(into: &var [u8]): Result<i64, IoError>
}

/// What bytes are written to, whichever it is: a file, a connection, a
/// program's input.
pub interface Write {
	/// All of `bytes`: a write cut short is carried on with, since a caller
	/// that has to loop for itself will one day forget.
	var fn writeAll(bytes: &[u8]): Result<void, IoError>
}

/// Everything `from` reads, written to `to` as it comes, through a buffer
/// of its own, until `from` ends; and how many bytes. What either fails
/// with ends it.
pub fn copy(from: &var dyn Read, to: &var dyn Write): Result<i64, IoError> = {
	var room = [0 as u8; 65536]
	var total = 0
	while true {
		val got = from.read(&var room)?
		if got == 0 then break
		to.writeAll(&room[0..got])?
		total += got
	}
	return .Ok(total)
}

/// Standard output or standard error, written to as a `Write`: through the
/// buffer `print` writes through, or as `eprint` writes, standard output
/// emptied first, so that what is written arrives in order with what is
/// printed. It owns nothing, so nothing is closed where it ends.
pub struct Printer {
	errors: bool
}

/// Standard output, as a `Write`, which `io::copy` writes a body to as it
/// comes, or a function that takes any `&var dyn Write`.
pub fn stdout(): Printer = Printer(errors: false)

/// Standard error, as a `Write`.
pub fn stderr(): Printer = Printer(errors: true)

extend Printer: Write {
	var fn writeAll(bytes: &[u8]): Result<void, IoError> = {
		if bytes.isEmpty() then return .Ok()
		if self.errors then libc::fflush(libc::stdout)
		val stream = if self.errors then libc::stderr else libc::stdout
		// The bytes cross as their pointer and their length: one of them.
		val wrote = libc::fwriteBytes(bytes, 1, stream)
		return if wrote == 1 then .Ok() else .Err(lastError())
	}
}

/// A descriptor, and the bytes read from it but not yet given out.
/// A reader has to remember them between calls, and the
/// library has nowhere to keep them, so the program holds one of these:
/// `io::stdin()` for standard input, a `File` for a file, which holds
/// one of these and closes its descriptor where it ends, and a program
/// talked to for what it writes.
pub struct Reader {
	fd: i32
	held: Vec<u8>
	// How many of `held` have been given out.
	given: i64
	ended: bool
	// How many milliseconds a read waits for something to come; -1 waits
	// as long as it takes.
	timeout: i64
}

/// Standard input. It closes nothing: descriptor 0 is not a program's to
/// close.
pub fn stdin(): Reader = reader(0)

/// A reader over a descriptor, for the module that opened it.
pub fn reader(fd: i32): Reader = Reader(fd: fd, held: Vec(), given: 0, ended: false, timeout: -1)

/// The descriptor a reader reads from, for the module that owns it.
pub fn descriptorOf(reader: &Reader): i32 = reader.fd

// Bytes as they come: what is held first, then straight from the
// descriptor into what the caller lends, so that a large read is not
// copied twice. Bytes and lines may be read one after the other.
extend Reader: Read {
	var fn read(into: &var [u8]): Result<i64, IoError> = {
		if into.isEmpty() then return .Ok(0)
		if self.given < self.held.len() {
			val count = (self.held.len() - self.given).min(into.len())
			into[0..count].copyFrom(&self.held.items()[self.given..self.given + count])
			self.given += count
			return .Ok(count)
		}
		if self.ended then return .Ok(0)
		if self.timeout >= 0 && !self.ready()? then return .Err(.WouldBlock)
		var got = libc::read(self.fd, &var into)
		while got < 0 && lastError() == .Interrupted {
			got = libc::read(self.fd, &var into)
		}
		if got < 0 then return .Err(lastError())
		if got == 0 then self.ended = true
		return .Ok(got as i64)
	}
}

extend Reader {
	/// How long a read waits for something to come before it answers
	/// `.WouldBlock`, which is what a read that would wait longer is called;
	/// `.None`, as a reader begins, waits as long as it takes. What a read
	/// that gave up had read is appended where it was asked for, so that
	/// asking again with the same `String` goes on from there: a line comes
	/// whole to a `readLine` that was given the start of it before.
	pub var fn setTimeout(length: Option<Duration>) = {
		self.timeout = match length {
			.Some(length) => length.asMillis().max(0)
			.None => -1
		}
	}

	/// The next line, appended to `into` without its line break. `false` at
	/// the end of the input, where nothing was appended.
	pub var fn readLine(into: &var String): Result<bool, IoError> = {
		var any = false
		while true {
			val .Some(end) = self.lineEnd() else {
				any = self.handOver(&var into) > 0 || any
				if self.ended then return .Ok(any)
				self.fill()?
				continue
			}
			into.pushBytes(&self.held.items()[self.given..end])
			self.given = end + 1
			return .Ok(true)
		}
		return .Ok(any)
	}

	/// Everything that is left, appended. What comes back is how many bytes.
	pub var fn readAll(into: &var String): Result<i64, IoError> = {
		var total = self.handOver(&var into)
		while !self.ended {
			self.fill()?
			total += self.handOver(&var into)
		}
		return .Ok(total)
	}

	/// The next `count` bytes, appended to `into`, from what is held first
	/// and then read: what a message whose header said its length is read
	/// by. What comes back is how many, fewer than `count` only where the
	/// input ended first.
	pub var fn readExact(count: i64, into: &var String): Result<i64, IoError> = {
		var taken = 0
		while taken < count {
			if self.given == self.held.len() {
				if self.ended then return .Ok(taken)
				self.fill()?
				continue
			}
			val end = (self.given + count - taken).min(self.held.len())
			into.pushBytes(&self.held.items()[self.given..end])
			taken += end - self.given
			self.given = end
		}
		return .Ok(taken)
	}

	/// The bytes held and not yet given out, appended, and how many.
	var fn handOver(into: &var String): i64 = {
		val count = self.held.len() - self.given
		into.pushBytes(&self.held.items()[self.given..self.held.len()])
		self.held.clear()
		self.given = 0
		return count
	}

	/// Where the next line break is, or nothing when the bytes held have
	/// none.
	fn lineEnd(): Option<i64> = {
		for i in self.given..self.held.len() {
			if self.held.items()[i] == '\n' as u8 then return .Some(i)
		}
		return .None
	}

	/// More bytes, or the end of the input. What was given out already is
	/// let go of first, so that a reader that runs as long as its input does
	/// holds what is not read yet, not everything it ever read.
	var fn fill(): Result<void, IoError> = {
		if self.given > 0 {
			var kept: Vec<u8> = Vec()
			kept.pushAll(&self.held.items()[self.given..self.held.len()])
			self.held = kept
			self.given = 0
		}
		if self.timeout >= 0 && !self.ready()? then return .Err(.WouldBlock)
		var chunk = [0 as u8; 4096]
		// A read cut short by a signal is tried again, so that no program
		// has to.
		var got = libc::read(self.fd, &var chunk)
		while got < 0 && lastError() == .Interrupted {
			got = libc::read(self.fd, &var chunk)
		}
		if got < 0 then return .Err(lastError())
		if got == 0 {
			self.ended = true
			return .Ok()
		}
		for byte in chunk[0..got as i64] {
			self.held.push(byte)
		}
		return .Ok()
	}

	/// Whether something comes to be read, or the input ends, within the
	/// timeout. A wait cut short by a signal is waited again.
	fn ready(): Result<bool, IoError> = {
		var watched = [libc::PollFd(fd: self.fd, events: libc::POLLIN, answered: 0)]
		var answered = libc::poll(&var watched, self.timeout as c_int)
		while answered < 0 && lastError() == .Interrupted {
			answered = libc::poll(&var watched, self.timeout as c_int)
		}
		if answered < 0 then return .Err(lastError())
		return .Ok(answered > 0)
	}
}

/// What the environment holds for `name`, copied, or nothing. It copies
/// because what C points at is not a program's to keep: a later change to
/// the environment may free it.
pub fn env(name: str): Option<String> = {
	var key = String::of(name)
	val found = libc::getenv(key.toCstring())
	return if found.isNull then .None else .Some(String::of(found.toStr()))
}

/// One of the three streams every program starts with.
pub enum StandardStream {
	Input
	Output
	Errors
}

/// Whether the stream is a terminal a person reads or types at, rather
/// than a file or a pipe: whether to colour what is written, or to ask.
/// `io::isTerminal(.Output)`.
pub fn isTerminal(stream: StandardStream): bool = {
	val fd: c_int = match stream {
		.Input => 0
		.Output => 1
		.Errors => 2
	}
	return libc::isatty(fd) == 1
}
