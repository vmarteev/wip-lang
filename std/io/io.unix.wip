// A Unix's environment and waits: `setenv`, `environ`, and `poll` on a
// descriptor.

import std::libc

/// Sets the variable `key` to `value`: whether it could be.
fn setVariable(key: &var String, value: &var String): bool =
	libc::setenv(key.toCstring(), value.toCstring(), 1) == 0

/// Takes the variable `key` out: whether it could be.
fn unsetVariable(key: &var String): bool = libc::unsetenv(key.toCstring()) == 0

/// What the variable `key` holds, copied, or nothing.
fn variable(key: &var String): Option<String> = {
	val found = libc::getenv(key.toCstring())
	return if found.isNull then .None else String::of(found.toStr())
}

/// Every variable, as `environ` holds them.
fn variables(): Vec<(String, String)> = {
	// `environ` is read as the strings it is, and as the pointers they
	// are, to find the null at its end.
	val entries = libc::environ
	val words = entries as ptr<ptr<u8>>
	var all: Vec<(String, String)> = Vec()
	var at = 0
	while !words[at].isNull {
		if entries[at].toStr().splitOnce("=") is .Some((name, value)) then
			all.push((name, value))

		at += 1
	}
	return all
}

/// Whether something comes to be read on `fd`, or its input ends, within
/// `millis`, -1 waiting as long as it takes. A wait cut short by a signal
/// is waited again.
fn readyWithin(fd: i32, millis: i64): Result<bool, IoError> = {
	var watched = [libc::PollFd(fd:, events: libc::POLLIN, answered: 0)]
	var answered = libc::poll(&var watched, millis as c_int)
	while answered < 0 && lastError() == .Interrupted do
		answered = libc::poll(&var watched, millis as c_int)

	if answered < 0 then
		return .Err(lastError())

	return answered > 0
}
