// The table a map and a set find their keys by:
// for each slot, found by a key's hash, the position of the key in the
// container's own packed list, which keeps the order keys went in. The
// table holds no keys: where it must know whether the key at a position is
// the one looked for, the container says, through `holds`.
//
// Open addressing with linear probing. A slot is `EMPTY` where nothing has
// ever used it, `GONE` where its key was removed, and otherwise holds a
// position. A removed key's slot stays taken, so that a key found by
// probing past it is still found; the table is rebuilt, without them, when
// three quarters of it is taken.

/// A slot nothing has ever used.
val EMPTY: i64 = -1

/// A slot whose key was removed.
val GONE: i64 = -2

/// The fewest slots a table that holds anything has.
val FEWEST_TABLE_SLOTS: i64 = 8

/// Where each key of a map or a set is.
struct Table {
	// The position each slot points at, or `EMPTY` or `GONE`. Its length
	// is a power of two, so that a hash is cut down to a slot by masking.
	slots: Vec<i64> = Vec()
	// The slots that are not `EMPTY`, live and removed alike: what decides
	// when the table is rebuilt.
	used: i64 = 0
}

extend Table {
	/// The slot the key with this hash sits in, or the one it would go in:
	/// probing from where the hash points, one slot at a time, until the
	/// key or an empty slot. A removed key's slot is taken where the key is
	/// new, so that removing and putting back does not fill the table.
	fn slotOf(hash: u64, holds: &(position: i64) => bool): i64 = {
		val mask = self.slots.len() - 1
		var at = (hash & (mask as u64)) as i64
		var free = -1
		while true {
			val position = self.slots[at]
			if position == EMPTY then return if free >= 0 then free else at
			if position == GONE {
				if free < 0 then free = at
			} else if holds(position) {
				return at
			}
			at = (at + 1) & mask
		}
	}

	/// Where the key with this hash is in the container, or nothing where
	/// it holds no such key.
	fn find(hash: u64, holds: &(position: i64) => bool): Option<i64> = {
		if self.slots.isEmpty() then return .None
		val position = self.slots[self.slotOf(hash, holds)]
		if position < 0 then return .None
		return .Some(position)
	}

	/// What a slot holds: a position, `EMPTY` or `GONE`.
	fn at(slot: i64): i64 = self.slots[slot]

	/// Points a slot at a position.
	var fn point(slot: i64, position: i64) = {
		if self.slots[slot] == EMPTY then self.used += 1
		self.slots[slot] = position
	}

	/// The key a slot pointed at is gone; the slot stays taken.
	var fn forget(slot: i64) = {
		self.slots[slot] = GONE
	}

	/// Every position after `removed` is one less: the container closed
	/// the gap the key at `removed` left.
	var fn closeGap(removed: i64) = {
		for slot in 0..self.slots.len() {
			if self.slots[slot] > removed then self.slots[slot] -= 1
		}
	}

	/// Every slot empty, keeping the memory.
	var fn clear() = {
		for slot in 0..self.slots.len() {
			self.slots[slot] = EMPTY
		}
		self.used = 0
	}

	/// Whether one more key would take more than three quarters of the
	/// table, so that it is rebuilt first.
	fn full(): bool = (self.used + 1) * 4 > self.slots.len() * 3

	/// A table twice the size, or of `FEWEST_TABLE_SLOTS`, with the key at each
	/// position put back by its hash. Removed slots are not carried over,
	/// which is what makes room.
	var fn rebuild(hashes: &[u64]) = {
		val count = (self.slots.len() * 2).max(FEWEST_TABLE_SLOTS)
		self.slots = Vec::filled(count, EMPTY)
		self.used = 0
		val mask = count - 1
		for position in 0..hashes.len() {
			var at = (hashes[position] & (mask as u64)) as i64
			while self.slots[at] != EMPTY {
				at = (at + 1) & mask
			}
			self.point(at, position)
		}
	}
}

/// What the hasher makes of a key.
fn hashOf<K: Hash>(key: &K): u64 = {
	var hasher = Hasher()
	key.hashInto(&var hasher)
	return hasher.finish()
}
