// A set of keys, written in Wip over `Vec<T>` and `Hash`.
//
// It is `Map` without the values: its keys lie one after
// another, in the order they were added, and a table of positions
// (table.wip) says where each one is. That is what lets a set be walked as
// a slice: `for key in set` visits the keys themselves. The
// order holds through `remove` too; `swapRemove` trades it for speed.

import std::iter::{Taking}

/// Keys, each held once, in the order they went in.
/// `Set()` is an empty one, which takes no memory until a key goes in.
pub struct Set<K: Hash + Eq> {
	// Where each key is.
	table: Table = Table()
	// The keys themselves, packed, in the order they were added.
	keys: Vec<K> = Vec()
}

extend Set<K>: Items<K> {
	// The keys, lent as a slice, which is what `for key in set` walks.
	fn items(): &[K] = lend self.keys.items()
}

// `for key in move set`: each key, the loop's to keep, in the order they
// went in.
extend Set<K>: IntoIterator<Taking<K>> {
	move fn intoIterator(): Taking<K> = {
		var all = move self
		return (move all.keys).intoIterator()
	}
}

// A set is a sequence of its keys, in the order they went in: `set.len()`, and
// `set[i]` or `set.at(i)` for the key at position `i`. It is read only: a key
// written in place would leave the table pointing at the wrong one.
extend Set<K>: Sequence<K> {
	/// How many keys the set holds.
	fn len(): i64 = self.keys.len()

	/// The key at position `i`, counted from 0.
	fn at(i: i64): &K = lend self.keys.at(i)
}

extend Set<K> {
	/// Whether the set holds no keys.
	pub fn isEmpty(): bool = self.keys.isEmpty()

	/// Whether the set holds `key`.
	pub fn contains(key: &K): bool = self.find(&key).isSome()

	/// Where `key` is, or nothing where the set does not hold it:
	/// one lookup, which `at` takes from there. The
	/// position holds until a key before it is removed.
	pub fn find(key: &K): Option<i64> = self.table.find(
		hashOf(&key),
		(position) => self.keys.at(position) == key,
	)

	/// Puts `key` in, and answers whether it was not there before.
	pub var fn add(key: K): bool keeps key = {
		if self.table.full() {
			var hashes: Vec<u64> = Vec::withCapacity(self.keys.len())
			for kept in self.keys {
				hashes.push(hashOf(&kept))
			}
			self.table.rebuild(&hashes)
		}
		val slot = self.slotOf(&key)
		if self.table.at(slot) >= 0 then return false
		self.table.point(slot, self.keys.len())
		self.keys.push(move key)
		return true
	}

	/// Takes `key` out, and answers whether it was there. The keys after
	/// it keep their order, each one place further forward, so this costs
	/// the keys after it, as `Vec::remove` does.
	pub var fn remove(key: &K): bool = {
		val .Some(position) = self.vacate(&key) else {
			return false
		}
		destroy(self.keys.remove(position))
		self.table.closeGap(position)
		return true
	}

	/// Takes `key` out, and answers whether it was there, moving the last
	/// key into the gap: quick whatever the size, and the order is lost, as
	/// with `Vec::swapRemove`.
	pub var fn swapRemove(key: &K): bool = {
		val .Some(position) = self.vacate(&key) else {
			return false
		}
		// The last key moves into the gap, so the table is told where it
		// went; its slot is still found by its key, since only the removed
		// key's slot has changed.
		val last = self.keys.len() - 1
		if position != last {
			val moved = self.slotOf(&self.keys.at(last))
			self.table.point(moved, position)
		}
		destroy(self.keys.swapRemove(position))
		return true
	}

	/// Ends every key, keeping the memory.
	pub var fn clear() = {
		self.keys.clear()
		self.table.clear()
	}

	// The slot `key` sits in, or would go in; the table holds some slots.
	fn slotOf(key: &K): i64 = self.table.slotOf(
		hashOf(&key),
		(position) => self.keys.at(position) == key,
	)

	// Where `key` is, with its slot marked removed, or nothing where the
	// set does not hold it.
	var fn vacate(key: &K): Option<i64> = {
		val .Some(position) = self.find(&key) else {
			return .None
		}
		self.table.forget(self.slotOf(&key))
		return .Some(position)
	}
}

// A set's keys, each cloned, in the order they went in.
extend Set<K: Clone>: Clone {
	fn clone(): Set<K> = {
		var copy: Set<K> = Set()
		for key in self {
			copy.add(key.clone())
		}
		return move copy
	}
}

// Two sets are equal where they hold the same keys, whatever order they
// went in.
extend Set<K>: Eq {
	fn equals(other: &Set<K>): bool = {
		if self.len() != other.len() then return false
		for key in self {
			if !other.contains(&key) then return false
		}
		return true
	}
}
