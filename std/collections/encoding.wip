// A map and a set, written to a format and read back: a map as a map of
// its entries, in the order the keys went in, and a set as a sequence.

extend Map<K: Encode, V: Encode>: Encode {
	fn encode<E: Encoder>(into: &var E) = {
		into.beginMap(self.len())
		for entry in self {
			entry.key.encode(&var into)
			entry.value.encode(&var into)
		}
		into.endMap()
	}
}

extend Map<K: Decode + Hash + Eq, V: Decode>: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<Map<K, V>, D::Error> = {
		from.beginMap()?
		var map: Map<K, V> = Map()
		while from.more()? {
			val key = K::decode(&var from)?
			val value = V::decode(&var from)?
			map.put(move key, move value)
		}
		from.endMap()?
		return .Ok(move map)
	}
}

extend Set<K: Encode>: Encode {
	fn encode<E: Encoder>(into: &var E) = {
		into.beginSequence(self.len())
		for key in self {
			key.encode(&var into)
		}
		into.endSequence()
	}
}

extend Set<K: Decode + Hash + Eq>: Decode {
	static fn decode<D: Decoder>(from: &var D): Result<Set<K>, D::Error> = {
		from.beginSequence()?
		var set: Set<K> = Set()
		while from.more()? {
			set.add(K::decode(&var from)?)
		}
		from.endSequence()?
		return .Ok(move set)
	}
}
