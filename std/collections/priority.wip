// A priority queue, written in Wip over `Vec<T>`: values pushed each with a
// priority, and taken the smallest priority first.
//
// It is a binary heap: the entries lie in a `Vec`, each before the two
// whose positions are twice its own and one or two more, so the first is
// the least. A push goes at the end and moves up past each that comes
// after it; a pop takes the first, puts the last in its place, and moves
// that down past the lesser of its two. Each entry is numbered as it is
// pushed, and two of equal priority come out in the order of their
// numbers, so a queue gives the same order on every run.

/// Values each with a priority, taken the smallest priority first, and
/// those of equal priority in the order they were pushed.
/// `PriorityQueue()` is an empty one.
pub struct PriorityQueue<T, P: Ord> {
	waiting: Vec<Waiting<T, P>> = Vec()
	/// How many have ever been pushed: the number the next one is given.
	pushed: i64 = 0
}

/// A value in the queue, with its priority and the number it was pushed
/// as.
struct Waiting<T, P> {
	priority: P
	order: i64
	value: T
}

extend PriorityQueue<T, P> {
	/// The pairs, each a value and its priority, pushed in the order they
	/// come.
	pub static fn fromPairs<I: Iterator<(T, P)>>(pairs: I): PriorityQueue<T, P> = {
		var queue: PriorityQueue<T, P> = PriorityQueue()
		for (value, priority) in move pairs {
			queue.push(value, priority)
		}
		return queue
	}

	/// How many values it holds.
	pub fn len(): i64 = self.waiting.len()

	/// Whether it holds none.
	pub fn isEmpty(): bool = self.waiting.isEmpty()

	/// Ends every value; the numbering goes on.
	pub var fn clear() = self.waiting.clear()

	/// `value`, with `priority`.
	pub var fn push(value: T, priority: P) keeps value, priority = {
		self.waiting.push(Waiting(priority: priority, order: self.pushed, value: value))
		self.pushed += 1
		var at = self.waiting.len() - 1
		while at > 0 {
			val above = (at - 1) / 2
			if !self.before(at, above) then break
			self.waiting.items().swap(at, above)
			at = above
		}
	}

	/// The value of the smallest priority, with it, taken out; nothing where
	/// there is none.
	pub var fn pop(): Option<(T, P)> = {
		if self.waiting.isEmpty() then return .None
		val last = self.waiting.len() - 1
		self.waiting.items().swap(0, last)
		val .Some(taken) = self.waiting.pop() else return .None
		var at = 0
		while true {
			val left = at * 2 + 1
			if left >= self.waiting.len() then break
			val right = left + 1
			val lesser =
				if right < self.waiting.len() && self.before(right, left) then right else left
			if !self.before(lesser, at) then break
			self.waiting.items().swap(at, lesser)
			at = lesser
		}
		return .Some((taken.value, taken.priority))
	}

	/// The value `pop` would take, where it lies.
	pub fn first(): Option<&T> =
		if self.waiting.isEmpty() then .None else .Some(&self.waiting[0].value)

	/// Its priority.
	pub fn firstPriority(): Option<&P> =
		if self.waiting.isEmpty() then .None else .Some(&self.waiting[0].priority)

	/// Whether the entry at `a` comes out before the one at `b`: its
	/// priority is less, or the same and it was pushed first.
	fn before(a: i64, b: i64): bool = match self.waiting[a].priority.compare(
		&self.waiting[b].priority,
	) {
		.Less => true
		.More => false
		.Same => self.waiting[a].order < self.waiting[b].order
	}
}
