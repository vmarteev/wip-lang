// A double-ended queue: values in order, pushed and taken
// at either end in the same constant time, where a `Vec` is quick at its
// back alone. It is the queue, the stack and the list pushed at its front
// that a program might have written a linked list for, kept in one block
// of memory.
//
// It is a ring: its values are the `length` slots from `head`, wrapping at
// the end of the block, and every other slot holds nothing. When the ring
// is full it is laid out again, from its first slot, in a block twice the
// size. It is a sequence — `d[i]`, `d.len()`, and
// `for x in d` — since the value at any position is found as quickly as
// at any other, but it lends no slice: its values do not lie in one run.

/// The fewest slots a deque that holds anything has.
val FEWEST_RING_SLOTS: i64 = 4

/// Values in order, pushed and taken at either end.
pub struct Deque<T> {
	// The ring: a value or nothing in each slot.
	slots: Vec<Option<T>> = Vec()
	// The slot the first value is in.
	head: i64 = 0
	// How many values there are.
	length: i64 = 0
}

extend Deque<T>: Sequence<T> {
	/// How many values it holds.
	fn len(): i64 = self.length

	/// The value at position `i`, counted from the front, to read or to
	/// write. A position outside the values panics, as a vector's does.
	lend fn at(i: i64): &T = {
		if i < 0 || i >= self.length then panic("index out of bounds for a deque")
		lend self.slots[self.slotOf(i)].get()
	}
}

// `for x in move deque`: each value, from the front, the loop's to keep.
extend Deque<T>: IntoIterator<DequeTaking<T>> {
	move fn intoIterator(): DequeTaking<T> = DequeTaking(move self)
}

/// A deque's values, taken from the front one at a time: what `for x in
/// move deque` walks. What is not taken when it ends is dropped with the
/// deque it holds.
pub struct DequeTaking<T> {
	deque: Deque<T>
}

extend DequeTaking<T>: Iterator<T> {
	var fn next(): Option<T> = self.deque.popFront()
}

extend Deque<T> {
	/// Whether it holds nothing.
	pub fn isEmpty(): bool = self.length == 0

	/// The value, at the back.
	pub var fn pushBack(value: T) = {
		self.makeRoom()
		val slot = self.slotOf(self.length)
		self.slots[slot] = .Some(move value)
		self.length += 1
	}

	/// The value, at the front: what `popFront` takes next.
	pub var fn pushFront(value: T) = {
		self.makeRoom()
		self.head = (self.head - 1 + self.slots.len()) % self.slots.len()
		self.slots[self.head] = .Some(move value)
		self.length += 1
	}

	/// The value at the front, taken out, or nothing where there is none.
	pub var fn popFront(): Option<T> = {
		if self.length == 0 then return .None
		val taken = self.slots[self.head].take()
		self.head = (self.head + 1) % self.slots.len()
		self.length -= 1
		return move taken
	}

	/// The value at the back, taken out, or nothing where there is none.
	pub var fn popBack(): Option<T> = {
		if self.length == 0 then return .None
		val slot = self.slotOf(self.length - 1)
		self.length -= 1
		return self.slots[slot].take()
	}

	/// Ends every value, keeping the memory.
	pub var fn clear() = {
		while self.length > 0 {
			destroy(self.popBack())
		}
		self.head = 0
	}

	/// The slot position `i` is in.
	fn slotOf(i: i64): i64 = (self.head + i) % self.slots.len()

	/// Room for one more value: where the ring is full, a block twice the
	/// size, with the values moved into it from its first slot.
	var fn makeRoom() = {
		if self.length < self.slots.len() then return
		val count = (self.slots.len() * 2).max(FEWEST_RING_SLOTS)
		var bigger: Vec<Option<T>> = Vec::withCapacity(count)
		for i in 0..self.length {
			bigger.push(self.slots[self.slotOf(i)].take())
		}
		for i in self.length..count {
			bigger.push(.None)
		}
		self.slots = move bigger
		self.head = 0
	}
}

// Plain data can be copied in and out.
extend Deque<T: copy> {
	/// The values, front to back, in a new deque: `Deque::of([1, 2, 3])`.
	pub static fn of(values: &[T]): Deque<T> = {
		var made: Deque<T> = Deque()
		for value in values {
			made.pushBack(value)
		}
		return move made
	}

	/// The value at the front, or nothing where there is none.
	pub fn first(): Option<T> = if self.length == 0 then .None else .Some(self[0])

	/// The value at the back, or nothing where there is none.
	pub fn last(): Option<T> = if self.length == 0 then .None else .Some(self[self.length - 1])
}

// A deque is written as its values, front to back, between brackets, as a
// vector is.
extend Deque<T: Text>: Text {
	fn appendTo(out: &var String) = {
		out.push("[")
		self.joinToBy(&var out, ", ", (x, out) => x.appendTo(&var out))
		out.push("]")
	}
}

// Two deques are equal where they hold equal values in the same order,
// wherever each one's ring begins.
extend Deque<T: Eq>: Eq {
	fn equals(other: &Deque<T>): bool = {
		if self.length != other.length then return false
		for i in 0..self.length {
			if self[i] != other[i] then return false
		}
		return true
	}
}

// A deque's elements, each cloned, front to back.
extend Deque<T: Clone>: Clone {
	fn clone(): Deque<T> = {
		var copy: Deque<T> = Deque()
		for i in 0..self.length {
			copy.pushBack(self[i].clone())
		}
		return move copy
	}
}
