// Percent-encoding: text made fit to stand in a part of a URL — a query's
// value, a path's segment — each byte that may not stand there as `%` and
// two hexadecimal digits, as RFC 3986 has it. What may stand anywhere is
// its unreserved characters, letters, digits, `-`, `.`, `_` and `~`;
// every other byte is encoded, a character beyond ASCII as each byte of
// its UTF-8, unless the caller keeps it.

/// Why text could not be decoded: the `%` at `at` is not followed by two
/// hexadecimal digits.
@derive(Eq, Clone)
pub enum UrlError {
	BadEscape(at: i64)
}

extend UrlError: Text {
	fn toString(): String = match self {
		.BadEscape(at) =>
			"not percent-encoded: the `%` at \(at) is not followed by two hexadecimal digits"
	}
}

/// `text` with every byte but the unreserved characters, and those in
/// `keep`, as `%` and two digits: `url::encode("a b&c")` is `a%20b%26c`,
/// and `url::encode(path, keep: "/")` leaves a path's slashes.
pub fn encode(text: str, keep: str = ""): String = {
	val digits = "0123456789ABCDEF"
	var out = String::withCapacity(text.len())
	for at in 0..text.len() {
		val byte = text[at]
		if isUnreserved(byte) || holds(keep, byte) then out.pushByte(byte) else {
			out.pushByte(b'%')
			out.pushByte(digits[(byte >> 4) as i64])
			out.pushByte(digits[(byte & 15) as i64])
		}
	}
	return out
}

/// `text` with each `%` and two hexadecimal digits, in either case, made
/// the byte they stand for; every other byte, `+` among them, is as it is.
pub fn decode(text: str): Result<String, UrlError> = {
	var out = String::withCapacity(text.len())
	var at = 0
	while at < text.len() {
		val byte = text[at]
		if byte != b'%' {
			out.pushByte(byte)
			at += 1
			continue
		}
		if at + 2 >= text.len() then return .Err(.BadEscape(at))
		val .Some(high) = text[at + 1].digitValue(16) else return .Err(.BadEscape(at))
		val .Some(low) = text[at + 2].digitValue(16) else return .Err(.BadEscape(at))
		out.pushByte((high * 16 + low) as u8)
		at += 3
	}
	return .Ok(out)
}

/// Whether `byte` stands in any part of a URL as it is.
fn isUnreserved(byte: u8): bool =
	byte.isAsciiLetter() || byte.isDigit() || byte is b'-' | b'.' | b'_' | b'~'

/// Whether `text` holds `byte`.
fn holds(text: str, byte: u8): bool = {
	for at in 0..text.len() {
		if text[at] == byte then return true
	}
	return false
}
