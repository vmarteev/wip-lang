// Timers: values kept by the moment each is due, which a loop sleeps until
// the first of, and takes out once they are due. It keeps no thread and
// reads no clock but the moments it is given, so a loop that waits on an
// event queue, SDL or a display link uses it as its timeout, and a test
// gives it moments made up.
//
// The values are kept in an arena, named by a handle that goes stale once
// a value is taken out, and their moments in a priority queue. A value
// cancelled leaves the arena at once and the queue once it is at its
// front, which `cancel` and `due` see to: so the queue's first moment is
// always a value's that is kept.

import std::collections::{Arena, Handle, PriorityQueue}

/// What a timer's handle names: a value kept, waiting to be due.
struct Kept<T> {
	value: T
}

/// What a timer's handles name, which a program does not name itself.
struct Pending

/// A timer: the name `add` answers for a value, which `cancel` takes it out
/// by. One that has fired or been cancelled names nothing, never another
/// timer.
@derive(Eq, Hash)
pub struct Timer {
	handle: Handle<Pending>
}

/// Values, each with the `Instant` it is due at: `due` takes out those due
/// by a moment, in the order they are due, and those due at the same moment
/// in the order they were added. `untilNext` is how long a loop may sleep.
pub struct Timers<T> {
	kept: Arena<Kept<T>, Pending> = Arena()
	waiting: PriorityQueue<Handle<Pending>, Instant> = PriorityQueue()
}

extend Timers<T> {
	/// Keeps `value` until `at`, and answers its name.
	pub var fn add(at: Instant, value: T): Timer keeps value = {
		val handle = self.kept.add(Kept(value:))
		self.waiting.push(handle, at)
		return Timer(handle:)
	}

	/// Takes `timer` out before it is due, and answers its value; nothing
	/// where it has fired or been cancelled already.
	pub var fn cancel(timer: Timer): Option<T> = {
		val .Some(kept) = self.kept.remove(timer.handle) else return .None
		self.dropCancelled()
		return kept.value
	}

	/// Takes out every value due at or before `now`, in the order they are
	/// due, and those due at the same moment in the order they were added.
	pub var fn due(now: Instant): Vec<T> = {
		var out: Vec<T> = Vec()
		while self.waiting.firstPriority() is .Some(at) && at <= now {
			val .Some((handle, _)) = self.waiting.pop() else break
			if self.kept.remove(handle) is .Some(kept) then
				out.push(kept.value)
		}
		self.dropCancelled()
		return out
	}

	/// When the earliest is due; nothing where none is kept.
	pub fn next(): Option<Instant> = match self.waiting.firstPriority() {
		.Some(at) => at.clone()
		.None => .None
	}

	/// How long until the earliest is due, from `now`, and no less than
	/// nothing where it is due already: what a wait's timeout is. Nothing
	/// where none is kept, which is a wait as long as it takes.
	pub fn untilNext(now: Instant): Option<Duration> = match self.next() {
		.Some(at) => if at <= now then Duration::nanos(0) else at.since(&now)
		.None => .None
	}

	/// How many are kept.
	pub fn len(): i64 = self.kept.len()

	/// Whether none is kept.
	pub fn isEmpty(): bool = self.kept.isEmpty()

	// Takes out of the queue's front the moments of values cancelled, so
	// that its first is always a kept value's.
	var fn dropCancelled() = {
		while self.waiting.first() is .Some(handle) && !self.kept.contains(handle) do
			self.waiting.pop()
	}
}
