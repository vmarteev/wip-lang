// A Unix's clocks: `CLOCK_MONOTONIC` and `CLOCK_REALTIME`, `nanosleep`, and
// C's calendar with BSD's two fields for the zone, which every Unix's C
// library has.

import std::libc

@header("<time.h>")
extern "C" {
	/// A moment as C's calendar has it. The last two, the zone's offset and
	/// its name, are BSD's, which both systems' C libraries have.
	struct tm {
		tm_sec: c_int
		tm_min: c_int
		tm_hour: c_int
		tm_mday: c_int
		tm_mon: c_int
		tm_year: c_int
		tm_wday: c_int
		tm_yday: c_int
		tm_isdst: c_int
		tm_gmtoff: c_long
		tm_zone: cstring
	}

	fn localtime_r(clock: &i64, result: &var tm): ptr<tm>
	fn tzset()
}

/// `nanosleep` was woken by a signal before its time was up, the same on
/// every Unix.
val EINTR: c_int = 4

/// Nanoseconds on the clock that only goes forward.
fn monotonicNanos(): i64 = {
	var time = libc::TimeSpec()
	libc::clock_gettime(libc::CLOCK_MONOTONIC, &var time)
	return time.seconds * NANOS_PER_SECOND + (time.nanos as i64)
}

/// Sleeps for `nanos`, more than none: a signal that wakes it early does not
/// end it.
fn sleepNanos(nanos: i64) = {
	var wanted = libc::TimeSpec(
		seconds: nanos / NANOS_PER_SECOND,
		nanos: (nanos % NANOS_PER_SECOND) as c_long,
	)
	var left = libc::TimeSpec()
	while libc::nanosleep(&wanted, &var left) != 0 && libc::errno() == EINTR do
		wanted = left
}

/// The seconds since the start of 1970, as the system's clock says.
fn secondsNow(): i64 = {
	var time = libc::TimeSpec()
	libc::clock_gettime(libc::CLOCK_REALTIME, &var time)
	return time.seconds
}

/// The offset from UTC the zone the program runs in has at `seconds`, and
/// the zone's name then; nothing where C cannot place the moment. `TZ` is
/// read again each time.
fn zoneAt(seconds: i64): Option<(i64, String)> = {
	tzset()
	var parts = tm(
		tm_sec: 0,
		tm_min: 0,
		tm_hour: 0,
		tm_mday: 0,
		tm_mon: 0,
		tm_year: 0,
		tm_wday: 0,
		tm_yday: 0,
		tm_isdst: 0,
		tm_gmtoff: 0,
		tm_zone: null,
	)
	if localtime_r(&seconds, &var parts).isNull then
		return .None

	val zone = if parts.tm_zone.isNull then String() else parts.tm_zone.toStr()
	return (parts.tm_gmtoff as i64, zone)
}
