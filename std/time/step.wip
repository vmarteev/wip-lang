// A fixed time step: a game updates its world at a steady rate, whatever
// rate it draws at, so that its physics is the same on a fast machine and a
// slow one. Real time is added up as it passes, as many fixed updates run
// as fit in it, a frame too slow to keep up runs no more than a few, and
// the drawing goes between the last two updates by how far the frame is
// into the next.

/// A fixed time step: `advance()` once a frame, then `while step.due()`
/// one update of `seconds()` each, then the frame drawn `alpha()` of the way
/// from the update before to the last.
pub struct FixedStep {
	/// The length of one update.
	step: Duration
	/// The real time added up and not yet updated through.
	owed: Duration = Duration::nanos(0)
	/// Most real time a frame adds, so that a frame that stalled — a
	/// breakpoint, a window dragged — does not then run a long catch-up.
	most: Duration
	/// When `advance` was last called.
	last: Option<Instant> = .None
}

extend FixedStep {
	/// Updates `perSecond` times a second; a frame adds at most a quarter
	/// of a second.
	pub static fn of(perSecond: i64): FixedStep = FixedStep(
		step: Duration::nanos(1000000000 / perSecond.max(1)),
		most: Duration::millis(250),
	)

	/// Adds the real time since the last call, the first call adding none.
	pub var fn advance() = {
		val now = Instant::now()
		val elapsed = match self.last {
			.Some(before) => now.since(&before)
			.None => Duration::nanos(0)
		}
		self.last = .Some(now)
		self.advanceBy(elapsed)
	}

	/// Adds `elapsed`, at most the most a frame adds: what a test or a
	/// replay drives the step with.
	pub var fn advanceBy(elapsed: Duration) = {
		val added = if elapsed.asNanos() > self.most.asNanos() then self.most else elapsed
		self.owed = Duration::nanos(self.owed.asNanos() + added.asNanos().max(0))
	}

	/// Whether another update fits in the time added up, which it then
	/// takes.
	pub var fn due(): bool = {
		if self.owed.asNanos() < self.step.asNanos() then return false
		self.owed = Duration::nanos(self.owed.asNanos() - self.step.asNanos())
		return true
	}

	/// How far the frame is from the last update to the next, from 0 up to
	/// 1: what a frame draws the world between the two updates by.
	pub fn alpha(): f64 = (self.owed.asNanos() as f64) / (self.step.asNanos() as f64)

	/// The length of one update, in seconds: what an update moves the world
	/// by.
	pub fn seconds(): f64 = self.step.asSeconds()
}
